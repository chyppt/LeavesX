@@ -1815,9 +1816,67 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
 
         private boolean containsPlayer(final ServerPlayer player) {
             for (int index = 0; index < this.playerCount; index++) {
-                if (this.players[index] == player) return true;
+                if (this.playerFrame.players[this.playerIndices[index]] == player) return true;
