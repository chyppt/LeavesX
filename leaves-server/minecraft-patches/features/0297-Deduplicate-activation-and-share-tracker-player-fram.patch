diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index c1d33001..972eb064 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -148,6 +148,11 @@ public final class ActivationRange {
         final int worldHeight = world.getHeight();
         final boolean tickMarkers = world.paperConfig().entities.markers.tick;
         final List<? extends Player> players = world.players();
+        // Overlapping player ranges can return the same entity several times in one tick. Paper's activation loop
+        // already ignores those later visits; rejecting them in the spatial query avoids repeated list insertion,
+        // snapshotting and AABB checks without changing which entities become active.
+        final java.util.function.Predicate<Entity> activationCandidate = entity ->
+            currentTick > entity.activatedTick && (tickMarkers || !(entity instanceof Marker));
         // The activation query is read-only and runs once per player. Reusing its list avoids repeated ArrayList
         // growth in dense farms while retaining a nested-query fallback for unusual plugin re-entry. The dedicated
         // switch keeps Paper's original allocating query available for troubleshooting and compatibility checks.
@@ -174,8 +179,8 @@ public final class ActivationRange {
                 ActivationType.VILLAGER.boundingBox = playerBoundingBox.inflate(villagerActivationRange, worldHeight, villagerActivationRange);
 
                 final List<Entity> entities = queryBuffer == null
-                    ? world.getEntities((Entity)null, ActivationRange.maxBB, e -> true)
-                    : queryBuffer.query(world, null, ActivationRange.maxBB, e -> true);
+                    ? world.getEntities((Entity)null, ActivationRange.maxBB, activationCandidate)
+                    : queryBuffer.query(world, null, ActivationRange.maxBB, activationCandidate);
                 if (ActivationRangeSnapshot.activateEntities(entities, tickMarkers, currentTick)) {
                     continue;
                 }
