+        private ServerPlayer player(final int index) {
+            return this.playerFrame.players[this.playerIndices[index]];
+        }
+    }
+
+    /** One immutable player-coordinate frame shared by all entity snapshots in a tracker tick. */
+    private final class LeavesXTrackerPlayerFrame {
+
+        private static final int COMPONENTS = 3;
+        private ServerPlayer[] players = new ServerPlayer[0];
+        private double[] positionData = new double[0];
+        private double[] viewDistanceBlocks = new double[0];
+        private int size;
+
+        private void prepare(final List<ServerPlayer> currentPlayers) {
+            final int previousSize = this.size;
+            this.size = 0;
+            this.ensureCapacity(currentPlayers.size());
+            for (int index = 0, count = currentPlayers.size(); index < count; index++) {
+                final ServerPlayer player = currentPlayers.get(index);
+                this.capture(this.size++, player, ChunkMap.this.getPlayerViewDistance(player) * 16.0D);
+            }
+            if (previousSize > this.size) {
+                java.util.Arrays.fill(this.players, this.size, previousSize, null);
+            }
+        }
+
+        private int indexOfOrAdd(final ServerPlayer player, final double viewDistance) {
+            for (int index = 0; index < this.size; index++) {
+                if (this.players[index] == player) {
+                    return index;
+                }
+            }
+            this.ensureCapacity(this.size + 1);
+            final int index = this.size++;
+            this.capture(index, player, viewDistance);
+            return index;
+        }
+
+        private void capture(final int index, final ServerPlayer player, final double viewDistance) {
+            this.players[index] = player;
+            final int offset = index * COMPONENTS;
+            this.positionData[offset] = player.getX();
+            this.positionData[offset + 1] = player.getY();
+            this.positionData[offset + 2] = player.getZ();
+            this.viewDistanceBlocks[index] = viewDistance;
+        }
+
+        private void ensureCapacity(final int required) {
+            if (this.players.length >= required) {
+                return;
+            }
+            final int capacity = Math.max(required, Math.max(4, this.players.length << 1));
+            this.players = java.util.Arrays.copyOf(this.players, capacity);
+            this.positionData = java.util.Arrays.copyOf(this.positionData, capacity * COMPONENTS);
+            this.viewDistanceBlocks = java.util.Arrays.copyOf(this.viewDistanceBlocks, capacity);
+        }
     }
 }
