     // Paper start - rewrite chunk system
+    // LeavesX - one reusable result slot per calling thread; nested calls allocate a private fallback.
+    private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_FIRST_ENTITY_QUERY_BUFFER =
+        ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
     private ca.spottedleaf.moonrise.patches.chunk_system.level.entity.EntityLookup entityLookup;
     private final ca.spottedleaf.concurrentutil.map.concurrent.longs.ConcurrentChainedLong2ReferenceHashTable<ca.spottedleaf.moonrise.patches.chunk_system.level.chunk.ChunkData> chunkData = new ca.spottedleaf.concurrentutil.map.concurrent.longs.ConcurrentChainedLong2ReferenceHashTable<>();
 
@@ -232,7 +235,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         return ret;
     }
 
-    // LeavesX start - allow fixed block-entity queries to retain their private result storage
+    // LeavesX start - reusable and bounded entity query fast paths
     public final <T extends Entity> void leavesX$getEntitiesOfClass(
         final Class<T> entityClass,
         final AABB boundingBox,
@@ -243,7 +246,47 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
             .moonrise$getEntityLookup().getEntities(entityClass, null, boundingBox, into, predicate);
     }
-    // LeavesX end - allow fixed block-entity queries to retain their private result storage
+
+    /** Returns the first entity in the same deterministic order as {@link #getEntitiesOfClass}. */
+    public final <T extends Entity> @Nullable T leavesX$getFirstEntityOfClass(
+        final Class<T> entityClass,
+        final AABB boundingBox,
+        final Predicate<? super T> predicate
+    ) {
+        Profiler.get().incrementCounter("getEntities");
+        final LeavesXFirstEntityQueryBuffer buffer = LEAVESX_FIRST_ENTITY_QUERY_BUFFER.get();
+        if (!buffer.acquire()) {
+            // Entity predicates are normally non-reentrant. Keep nested or unusual plugin-driven queries correct.
+            final List<T> nestedResults = new java.util.ArrayList<>(1);
+            ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
+                .moonrise$getEntityLookup().getEntities(entityClass, null, boundingBox, nestedResults, predicate, 1);
+            return nestedResults.isEmpty() ? null : nestedResults.get(0);
+        }
+
+        try {
+            final List<Entity> results = buffer.results;
+            ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
+                .moonrise$getEntityLookup().getEntities(entityClass, null, boundingBox, (List)results, (Predicate)predicate, 1);
+            return results.isEmpty() ? null : (T)results.get(0);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    public final <T extends Entity> @Nullable T leavesX$getFirstEntityOfClass(
+        final Class<T> entityClass,
+        final AABB boundingBox
+    ) {
+        return this.leavesX$getFirstEntityOfClass(entityClass, boundingBox, EntitySelector.NO_SPECTATORS);
+    }
+
+    public final <T extends Entity> boolean leavesX$hasEntityOfClass(
+        final Class<T> entityClass,
+        final AABB boundingBox
+    ) {
+        return this.leavesX$getFirstEntityOfClass(entityClass, boundingBox) != null;
+    }
+    // LeavesX end - reusable and bounded entity query fast paths
 
     @Override
     public final List<Entity> moonrise$getHardCollidingEntities(final Entity entity, final AABB box, final Predicate<? super Entity> predicate) {
@@ -2215,6 +2258,27 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
 
     public abstract LevelEntityGetter<Entity> getEntities();
 
+    /** Reusable one-result storage with an allocation fallback for nested queries on the same thread. */
+    private static final class LeavesXFirstEntityQueryBuffer {
+
+        private final List<Entity> results = new java.util.ArrayList<>(1);
+        private boolean inUse;
+
+        private boolean acquire() {
+            if (this.inUse) {
+                return false;
+            }
+            this.inUse = true;
+            this.results.clear();
+            return true;
+        }
+
+        private void release() {
+            this.results.clear();
+            this.inUse = false;
+        }
+    }
+
     @Override
     public long nextSubTickCount() {
         return this.subTickCount++;
