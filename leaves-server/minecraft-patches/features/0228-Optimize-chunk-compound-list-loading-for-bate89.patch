         CompoundTag structureData = chunkData.getCompoundOrEmpty("structures");
         ListTag sectionTags = chunkData.getListOrEmpty("sections");
         List<SerializableChunkData.SectionData> sectionData = new ArrayList<>(sectionTags.size());
@@ -804,6 +806,29 @@ public record SerializableChunkData(
         return listTag;
     }
 
+    private static List<CompoundTag> readCompoundList(
+        final CompoundTag chunkData,
+        final String key,
+        final boolean optimizeCompoundLists
+    ) {
+        if (!optimizeCompoundLists) {
+            return chunkData.getList(key).stream().flatMap(ListTag::compoundStream).toList();
+        }
+
+        final ListTag values = chunkData.getListOrEmpty(key);
+        if (values.isEmpty()) {
+            return List.of();
+        }
+
+        final ImmutableList.Builder<CompoundTag> compounds = ImmutableList.builderWithExpectedSize(values.size());
+        for (int index = 0; index < values.size(); index++) {
+            if (values.get(index) instanceof CompoundTag compound) {
+                compounds.add(compound);
+            }
+        }
+        return compounds.build();
+    }
+
     private static ListTag createListTag(final int expectedSize, final boolean optimizeNbtListCapacity) {
         return optimizeNbtListCapacity && expectedSize > 0
             ? new ListTag(new ArrayList<>(expectedSize))
