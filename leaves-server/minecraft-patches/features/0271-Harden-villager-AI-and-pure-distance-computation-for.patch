diff --git a/net/minecraft/world/entity/ai/sensing/TemptingSensor.java b/net/minecraft/world/entity/ai/sensing/TemptingSensor.java
index c31c44de..7a1ec3c1 100644
--- a/net/minecraft/world/entity/ai/sensing/TemptingSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/TemptingSensor.java
@@ -1,6 +1,7 @@
 package net.minecraft.world.entity.ai.sensing;
 
 import com.google.common.collect.ImmutableSet;
+import java.util.ArrayList;
 import java.util.Comparator;
 import java.util.List;
 import java.util.Set;
@@ -77,6 +78,30 @@ public class TemptingSensor extends Sensor<PathfinderMob> {
         final TargetingConditions targeting,
         final List<? extends Player> players
     ) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.parallelAiPureComputation()
+            && players.size() >= org.leavesx.leavesx.config.LeavesXRuntime.aiTargetSearchMinimumCandidates()) {
+            // All predicates remain on the tick thread. Only the final coordinate-distance reduction is delegated,
+            // and the returned index keeps the original player order for equal distances.
+            final List<Player> eligiblePlayers = new ArrayList<>(players.size());
+            for (final Player player : players) {
+                if (
+                    EntitySelector.NO_SPECTATORS.test(player)
+                        && targeting.test(level, body, player)
+                        && this.playerHoldingTemptation(body, player)
+                        && !body.hasPassenger(player)
+                ) {
+                    eligiblePlayers.add(player);
+                }
+            }
+            final int nearestIndex = org.leavesx.leavesx.performance.StableDistanceSorter.findNearestIndex(
+                eligiblePlayers,
+                body,
+                true,
+                org.leavesx.leavesx.config.LeavesXRuntime.aiTargetSearchMinimumCandidates()
+            );
+            return nearestIndex < 0 ? null : eligiblePlayers.get(nearestIndex);
+        }
+
         Player nearestPlayer = null;
         double nearestDistance = 0.0;
         for (final Player player : players) {
