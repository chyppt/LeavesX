+    private EquipmentSlot findRandomGliderSlotDirect() {
+        int eligibleSlotMask = 0;
+        for (int index = 0; index < EquipmentSlot.VALUES.size(); index++) {
+            final EquipmentSlot slot = EquipmentSlot.VALUES.get(index);
+            if (canGlideUsing(this.getItemBySlot(slot), slot)) {
+                eligibleSlotMask |= 1 << index;
+            }
+        }
+        return selectGliderSlotDirect(eligibleSlotMask, this.random);
+    }
+
+    private static EquipmentSlot selectGliderSlotDirect(final int eligibleSlotMask, final RandomSource random) {
+        // Keep vanilla's single nextInt(size) call and EquipmentSlot.VALUES encounter order.
+        int selectedIndex = random.nextInt(Integer.bitCount(eligibleSlotMask));
+        for (int index = 0; index < EquipmentSlot.VALUES.size(); index++) {
+            if ((eligibleSlotMask & (1 << index)) != 0 && selectedIndex-- == 0) {
+                return EquipmentSlot.VALUES.get(index);
+            }
+        }
+        throw new IllegalStateException("Eligible equipment slot mask did not contain a selectable slot");
+    }
