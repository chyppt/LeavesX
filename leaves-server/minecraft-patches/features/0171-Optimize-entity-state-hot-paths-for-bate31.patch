+    private static List<ParticleOptions> collectVisibleEffectParticlesDirect(final Collection<MobEffectInstance> effects) {
+        if (effects.isEmpty()) {
+            return List.of();
+        }
+
+        final List<ParticleOptions> particles = new ArrayList<>(effects.size());
+        for (final MobEffectInstance effect : effects) {
+            if (effect.isVisible()) {
+                particles.add(effect.getParticleOptions());
+            }
+        }
+        // Stream.toList() is unmodifiable; preserve that API contract for synchronized entity data.
+        return Collections.unmodifiableList(particles);
+    }
