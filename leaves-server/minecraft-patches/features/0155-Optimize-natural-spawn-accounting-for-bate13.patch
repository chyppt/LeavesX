@@ -0,0 +1,89 @@
+package net.minecraft.world.level;
+
+import it.unimi.dsi.fastutil.longs.Long2ObjectMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.util.Objects;
+import net.minecraft.world.entity.MobCategory;
+
+/** Aggregates immutable chunk/category snapshots without exposing live world state to worker threads. */
+final class MobSpawnCountAccumulator {
+
+    private static final int CATEGORY_COUNT = MobCategory.values().length;
+
+    private MobSpawnCountAccumulator() {
+    }
+
+    static Long2ObjectOpenHashMap<int[]> count(
+        final Inputs inputs,
+        final boolean parallel,
+        final int minimumParallelSize
+    ) {
+        if (inputs.size() == 0) {
+            return new Long2ObjectOpenHashMap<>(0);
+        }
+        if (!parallel) {
+            return countRange(inputs, 0, inputs.size());
+        }
+
+        @SuppressWarnings("unchecked") final Long2ObjectOpenHashMap<int[]>[] partialCounts =
+            new Long2ObjectOpenHashMap[org.leavesx.leavesx.runtime.LeavesXComputeExecutor.computeLaneCount()];
+        final int completedPartitions = org.leavesx.leavesx.runtime.LeavesXComputeExecutor.invokeRangesWithCount(
+            inputs.size(),
+            minimumParallelSize,
+            (taskIndex, start, end) -> partialCounts[taskIndex] = countRange(inputs, start, end)
+        );
+        if (completedPartitions == 0) {
+            return countRange(inputs, 0, inputs.size());
+        }
+        return merge(partialCounts, completedPartitions);
+    }
+
+    private static Long2ObjectOpenHashMap<int[]> countRange(final Inputs inputs, final int start, final int end) {
+        final Long2ObjectOpenHashMap<int[]> counts = new Long2ObjectOpenHashMap<>();
+        for (int index = start; index < end; index++) {
+            final long chunkKey = inputs.chunkKeys()[index];
+            int[] categoryCounts = counts.get(chunkKey);
+            if (categoryCounts == null) {
+                categoryCounts = new int[CATEGORY_COUNT];
+                counts.put(chunkKey, categoryCounts);
+            }
+            categoryCounts[Byte.toUnsignedInt(inputs.categoryOrdinals()[index])]++;
+        }
+        return counts;
+    }
+
+    private static Long2ObjectOpenHashMap<int[]> merge(
+        final Long2ObjectOpenHashMap<int[]>[] partialCounts,
+        final int completedPartitions
+    ) {
+        final Long2ObjectOpenHashMap<int[]> merged = partialCounts[0];
+        for (int partition = 1; partition < completedPartitions; partition++) {
+            for (final Long2ObjectMap.Entry<int[]> entry : partialCounts[partition].long2ObjectEntrySet()) {
+                final long chunkKey = entry.getLongKey();
+                final int[] additions = entry.getValue();
+                int[] totals = merged.get(chunkKey);
+                if (totals == null) {
+                    merged.put(chunkKey, additions);
+                    continue;
+                }
+                for (int category = 0; category < CATEGORY_COUNT; category++) {
+                    totals[category] += additions[category];
+                }
+            }
+        }
+        return merged;
+    }
+
+    /** Read-only array view whose live range is restricted to {@code size}. */
+    record Inputs(long[] chunkKeys, byte[] categoryOrdinals, int size) {
+        static final Inputs EMPTY = new Inputs(new long[0], new byte[0], 0);
+
+        Inputs {
+            Objects.requireNonNull(chunkKeys, "chunkKeys");
+            Objects.requireNonNull(categoryOrdinals, "categoryOrdinals");
+            if (size < 0 || size > chunkKeys.length || size > categoryOrdinals.length) {
+                throw new IllegalArgumentException("Mob-spawn count input size exceeds its backing arrays");
+            }
+        }
+    }
+}
