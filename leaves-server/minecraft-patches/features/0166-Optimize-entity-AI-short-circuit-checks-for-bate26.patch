     private static boolean areOtherMobsComingThroughDoor(final LivingEntity body, final BlockPos doorPos, final Optional<List<LivingEntity>> nearestEntities) {
-        return !nearestEntities.isEmpty()
-            && nearestEntities.get()
-                .stream()
-                .filter(otherMob -> otherMob.getType() == body.getType())
-                .filter(otherMob -> doorPos.closerToCenterThan(otherMob.position(), MAX_DISTANCE_TO_HOLD_DOOR_OPEN_FOR_OTHER_MOBS))
-                .anyMatch(otherMob -> isMobComingThroughDoor(otherMob.getBrain(), doorPos));
+        if (nearestEntities.isEmpty()) {
+            return false;
+        }
+        if (org.leavesx.leavesx.config.LeavesXRuntime.aiOptimizations()) {
+            return hasOtherMobComingThroughDoorDirect(body, doorPos, nearestEntities.get());
+        }
+        return nearestEntities.get()
+            .stream()
+            .filter(otherMob -> otherMob.getType() == body.getType())
+            .filter(otherMob -> doorPos.closerToCenterThan(otherMob.position(), MAX_DISTANCE_TO_HOLD_DOOR_OPEN_FOR_OTHER_MOBS))
+            .anyMatch(otherMob -> isMobComingThroughDoor(otherMob.getBrain(), doorPos));
+    }
+
+    // LeavesX start - allocation-free equivalent of the ordered filter/anyMatch door check
+    private static boolean hasOtherMobComingThroughDoorDirect(
+        final LivingEntity body,
+        final BlockPos doorPos,
+        final List<LivingEntity> nearestEntities
+    ) {
+        final EntityType<?> bodyType = body.getType();
+        for (final LivingEntity otherMob : nearestEntities) {
+            if (otherMob.getType() == bodyType
+                && doorPos.closerToCenterThan(otherMob.position(), MAX_DISTANCE_TO_HOLD_DOOR_OPEN_FOR_OTHER_MOBS)
+                && isMobComingThroughDoor(otherMob.getBrain(), doorPos)) {
+                return true;
+            }
+        }
+        return false;
     }
+    // LeavesX end - allocation-free equivalent of the ordered filter/anyMatch door check
 
