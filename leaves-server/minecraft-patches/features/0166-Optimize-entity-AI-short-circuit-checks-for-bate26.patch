+    // LeavesX start - direct, order-preserving helpers for the villager play behavior
+    private static @Nullable LivingEntity findFriendChasingMeDirect(
+        final LivingEntity me,
+        final List<LivingEntity> friendsNearby
+    ) {
+        for (final LivingEntity friend : friendsNearby) {
+            final Optional<LivingEntity> interactionTarget = friend.getBrain().getMemory(MemoryModuleType.INTERACTION_TARGET);
+            if (interactionTarget.isPresent() && interactionTarget.get() == me) {
+                return friend;
+            }
+        }
+        return null;
+    }
+
+    private static @Nullable LivingEntity findSomeoneBeingChasedDirect(final List<LivingEntity> friendsNearby) {
+        final Map<LivingEntity, Integer> chasedKids = checkHowManyChasersEachFriendHasDirect(friendsNearby);
+        LivingEntity selectedKid = null;
+        int selectedChaserCount = Integer.MAX_VALUE;
+        for (final Entry<LivingEntity, Integer> entry : chasedKids.entrySet()) {
+            final int chaserCount = entry.getValue();
+            if (chaserCount > 0 && chaserCount <= MAX_CHASERS_PER_TARGET && chaserCount < selectedChaserCount) {
+                selectedKid = entry.getKey();
+                selectedChaserCount = chaserCount;
+            }
+        }
+        return selectedKid;
+    }
+
+    private static Map<LivingEntity, Integer> checkHowManyChasersEachFriendHasDirect(final List<LivingEntity> friendsNearby) {
+        final Map<LivingEntity, Integer> chasedKids = Maps.newHashMap();
+        for (final LivingEntity friend : friendsNearby) {
+            final Optional<LivingEntity> interactionTarget = friend.getBrain().getMemory(MemoryModuleType.INTERACTION_TARGET);
+            if (interactionTarget.isPresent()) {
+                chasedKids.compute(interactionTarget.get(), (key, count) -> count == null ? 1 : count + 1);
+            }
+        }
+        return chasedKids;
+    }
+    // LeavesX end - direct, order-preserving helpers for the villager play behavior
+
