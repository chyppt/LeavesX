From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Sun, 16 Aug 2026 21:11:36 +0800
Subject: [PATCH] Reduce villager hostile sensor lookups for bate61


diff --git a/net/minecraft/world/entity/ai/sensing/VillagerHostilesSensor.java b/net/minecraft/world/entity/ai/sensing/VillagerHostilesSensor.java
index d5829df7..4cd257f0 100644
--- a/net/minecraft/world/entity/ai/sensing/VillagerHostilesSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/VillagerHostilesSensor.java
@@ -24,6 +24,10 @@ public class VillagerHostilesSensor extends NearestVisibleLivingEntitySensor {
 
     @Override
     protected boolean isMatchingEntity(final ServerLevel level, final LivingEntity body, final LivingEntity mob) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.aiOptimizations()) {
+            final Float distance = ACCEPTABLE_DISTANCE_FROM_HOSTILES.get(mob.getType());
+            return distance != null && mob.distanceToSqr(body) <= distance * distance;
+        }
         return this.isHostile(mob) && this.isClose(body, mob);
     }
 
