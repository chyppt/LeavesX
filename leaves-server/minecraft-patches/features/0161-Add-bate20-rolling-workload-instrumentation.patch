+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.SERVER_TASKS,
+            leavesXPhaseStarted
+        );
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
