         for (ServerLevel level : this.getAllLevels()) {
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
@@ -1854,12 +1875,27 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             level.explosionDensityCache.clear(); // Paper - Optimize explosions
         }
         this.isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.WORLDS,
+            leavesXPhaseStarted
+        );
 
         profiler.popPush("connection");
+        leavesXPhaseStarted = org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.beginPhase();
         this.tickConnection();
+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.NETWORK,
+            leavesXPhaseStarted
+        );
         profiler.popPush("players");
+        leavesXPhaseStarted = org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.beginPhase();
         this.playerList.tick();
+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.PLAYERS,
+            leavesXPhaseStarted
+        );
         profiler.popPush("debugSubscribers");
+        leavesXPhaseStarted = org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.beginPhase();
         this.debugSubscribers.tick();
         if (this.tickRateManager.runsNormally()) {
             profiler.popPush("gameTests");
@@ -1875,13 +1911,22 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         for (Runnable tickable : this.tickables) {
             tickable.run();
         }
+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.MISCELLANEOUS,
+            leavesXPhaseStarted
+        );
 
         profiler.popPush("send chunks");
 
+        leavesXPhaseStarted = org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.beginPhase();
         for (ServerPlayer player : this.playerList.getPlayers()) {
             player.connection.chunkSender.sendNextChunks(player);
             player.connection.resumeFlushing();
         }
+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.CHUNK_SEND,
+            leavesXPhaseStarted
+        );
 
         profiler.pop();
         this.serverActivityMonitor.tick();
