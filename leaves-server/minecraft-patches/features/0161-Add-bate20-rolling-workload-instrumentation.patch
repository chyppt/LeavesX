+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.TICK_START_TASKS,
+            leavesXTickStartTasks
+        );
         this.tickServer(sprinting ? () -> false : this::haveTime);
         // Paper start - rewrite chunk system
         final Throwable crash = this.chunkSystemCrash;
@@ -1777,6 +1787,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     protected void tickChildren(final BooleanSupplier haveTime) {
         ProfilerFiller profiler = Profiler.get();
         this.getPlayerList().getPlayers().forEach(playerx -> playerx.connection.suspendFlushing());
+        long leavesXPhaseStarted = org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.beginPhase();
         this.server.getScheduler().mainThreadHeartbeat(); // CraftBukkit
         // Paper start - optimise Folia entity scheduler
         ((io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler)org.bukkit.Bukkit.getGlobalRegionScheduler()).tick();
@@ -1789,6 +1800,11 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
         // Paper end - optimise Folia entity scheduler
         // Paper end - Folia scheduler API
+        org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.endPhase(
+            org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.TickPhase.BUKKIT_SCHEDULER,
+            leavesXPhaseStarted
+        );
+        leavesXPhaseStarted = org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics.beginPhase();
