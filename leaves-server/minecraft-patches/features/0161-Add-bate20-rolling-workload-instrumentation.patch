diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
index 2d146a36..ba498ceb 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
@@ -82,6 +82,7 @@ public final class ChunkHolderManager {
     private final ConcurrentChainedLong2ReferenceHashTable<NewChunkHolder> chunkHolders = ConcurrentChainedLong2ReferenceHashTable.createWithCapacity(16384, 0.25f);
     private final ServerLevel world;
     private final ChunkTaskScheduler taskScheduler;
+    private final org.leavesx.leavesx.diagnostics.LeavesXChunkDiagnostics.WorldMetrics leavesXDiagnostics;
     private long currentTick;
 
     private final ArrayDeque<NewChunkHolder> pendingFullLoadUpdate = new ArrayDeque<>();
@@ -115,6 +116,9 @@ public final class ChunkHolderManager {
         this.taskScheduler = taskScheduler;
         this.ticketLockArea = new ReentrantAreaLock(taskScheduler.getChunkSystemLockShift());
         this.unloadQueue = new ChunkUnloadQueue(((ChunkSystemServerLevel)world).moonrise$getRegionChunkShift());
+        this.leavesXDiagnostics = new org.leavesx.leavesx.diagnostics.LeavesXChunkDiagnostics.WorldMetrics(
+            world.dimension().identifier().toString()
+        );
     }
 
     /** Returns the exact pending unload count for the main-thread LeavesX diagnostic command. */
@@ -122,6 +126,11 @@ public final class ChunkHolderManager {
         return this.unloadQueue.pendingChunkCount();
     }
 
+    /** Returns the bounded, read-only lifecycle counters owned by this world. */
+    public org.leavesx.leavesx.diagnostics.LeavesXChunkDiagnostics.WorldMetrics leavesX$getDiagnostics() {
+        return this.leavesXDiagnostics;
+    }
+
     public boolean processTicketUpdates(final int chunkX, final int chunkZ) {
         final int ticketShift = ThreadedTicketLevelPropagator.SECTION_SHIFT;
         final int ticketMask = (1 << ticketShift) - 1;
@@ -639,6 +648,7 @@ public final class ChunkHolderManager {
                     this.addExpireCount(chunkX, chunkZ);
                 }
                 this.addTicketCounter(type, chunk);
+                this.leavesXDiagnostics.recordTicketAdded(type);
             }
 
             if (levelBefore != levelAfter) {
@@ -725,6 +735,7 @@ public final class ChunkHolderManager {
             }
 
             this.removeTicketCounter(type, chunk);
+            this.leavesXDiagnostics.recordTicketRemoved(type);
 
             return true;
         } finally {
