+    // LeavesX start - allocation-free equivalent of the original ordered stream/findFirst pipeline
+    private static @Nullable Villager findNearbyVillagerWantingJobsite(
+        final List<LivingEntity> nearestEntities,
+        final Villager body,
+        final Holder<PoiType> poiType,
+        final BlockPos poiPos
+    ) {
+        for (final LivingEntity entity : nearestEntities) {
+            if (entity instanceof Villager nearbyVillager
+                && nearbyVillager != body
+                && nearbyVillager.isAlive()
+                && nearbyWantsJobsite(poiType, nearbyVillager, poiPos)) {
+                return nearbyVillager;
+            }
+        }
+        return null;
+    }
+    // LeavesX end - allocation-free equivalent of the original ordered stream/findFirst pipeline
