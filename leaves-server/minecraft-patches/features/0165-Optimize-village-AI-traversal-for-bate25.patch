+    // LeavesX start - avoid the stream and repeated village-distance reads while preserving Cursor3D order
+    private static SectionPos findSectionClosestToVillageDirect(
+        final ServerLevel level,
+        final SectionPos center,
+        final int radius
+    ) {
+        SectionPos closestSection = center;
+        int closestDistance = level.sectionsToVillage(center);
+        final int minX = center.getX() - radius;
+        final int minY = center.getY() - radius;
+        final int minZ = center.getZ() - radius;
+        final int maxX = center.getX() + radius;
+        final int maxY = center.getY() + radius;
+        final int maxZ = center.getZ() + radius;
+
+        // Cursor3D advances X first, then Y, then Z. Keeping that order preserves ties exactly.
+        for (int z = minZ; z <= maxZ; ++z) {
+            for (int y = minY; y <= maxY; ++y) {
+                for (int x = minX; x <= maxX; ++x) {
+                    final SectionPos candidate = SectionPos.of(x, y, z);
+                    final int candidateDistance = level.sectionsToVillage(candidate);
+                    if (candidateDistance < closestDistance) {
+                        closestDistance = candidateDistance;
+                        closestSection = candidate;
+                    }
+                }
+            }
+        }
+        return closestSection;
+    }
+    // LeavesX end - avoid the stream and repeated village-distance reads while preserving Cursor3D order
+
