From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Mon, 17 Aug 2026 03:17:22 +0800
Subject: [PATCH] Optimize recursive entity loading for bate90


diff --git a/net/minecraft/world/entity/EntityType.java b/net/minecraft/world/entity/EntityType.java
index a23e4b5e..9be40a90 100644
--- a/net/minecraft/world/entity/EntityType.java
+++ b/net/minecraft/world/entity/EntityType.java
@@ -462,6 +462,16 @@ public class EntityType<T extends Entity> implements EntityTypeTest<Entity, T>,
     public static @Nullable Entity loadEntityRecursive(
         final ValueInput input, final Level level, final EntitySpawnRequest request, final EntityProcessor postLoad
     ) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.entityLoadOptionalChainsOptimization()) {
+            final Entity entity = loadStaticEntity(input, level, request).orElse(null);
+            if (entity == null) {
+                return null;
+            }
+
+            final Entity processedEntity = postLoad.process(entity);
+            return processedEntity == null ? null : loadPassengersRecursive(processedEntity, input, level, request, postLoad);
+        }
+
         return loadStaticEntity(input, level, request)
             .map(postLoad::process)
             .map(entity -> loadPassengersRecursive(entity, input, level, request, postLoad))
@@ -471,6 +481,16 @@ public class EntityType<T extends Entity> implements EntityTypeTest<Entity, T>,
     public static @Nullable Entity loadEntityRecursive(
         final EntityType<?> type, final ValueInput input, final Level level, final EntitySpawnReason reason, final EntityProcessor postLoad
     ) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.entityLoadOptionalChainsOptimization()) {
+            final Entity entity = loadStaticEntity(type, input, level, reason).orElse(null);
+            if (entity == null) {
+                return null;
+            }
+
+            final Entity processedEntity = postLoad.process(entity);
+            return processedEntity == null ? null : loadPassengersRecursive(processedEntity, input, level, new EntitySpawnRequest(reason, false), postLoad);
+        }
+
         return loadStaticEntity(type, input, level, reason)
             .map(postLoad::process)
             .map(entity -> loadPassengersRecursive(entity, input, level, new EntitySpawnRequest(reason, false), postLoad))
