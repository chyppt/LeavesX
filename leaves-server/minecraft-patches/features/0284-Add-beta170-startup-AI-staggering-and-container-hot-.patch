+    private boolean leavesXTrySuckInItemEntities(final Level level) {
+        final AABB searchBox = this.leavesXGetEntityContainerQueryCache().itemEntitySearchBox;
+        try (Level.LeavesXEntityQueryBuffer scan = Level.leavesX$acquireEntityQueryBuffer()) {
+            final List<ItemEntity> entities = scan.queryOfClass(
+                level,
+                ItemEntity.class,
+                null,
+                searchBox,
+                EntitySelector.ENTITY_STILL_ALIVE
+            );
+            for (int index = 0, size = entities.size(); index < size; index++) {
+                if (addItem(this, entities.get(index))) {
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+
     private static final class LeavesXEntityContainerQueryCache {
 
         private final BlockPos sourceContainerPos;
         private BlockPos attachedContainerPos;
         private final AABB sourceContainerSearchBox;
+        private final AABB itemEntitySearchBox;
         private AABB attachedContainerSearchBox;
         private final List<Entity> queryResults = new java.util.ArrayList<>(1);
 
         private LeavesXEntityContainerQueryCache(final BlockPos hopperPos, final Direction facing) {
             this.sourceContainerPos = hopperPos.above();
             this.sourceContainerSearchBox = new AABB(this.sourceContainerPos);
+            this.itemEntitySearchBox = Hopper.SUCK_AABB.move(hopperPos.getX(), hopperPos.getY(), hopperPos.getZ());
             this.updateAttachedContainer(hopperPos, facing);
         }
 
