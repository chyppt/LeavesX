@@ -862,13 +877,27 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
             profiler.push("goalSelector");
             this.goalSelector.tickRunningGoals(false);
             profiler.pop();
-        } else {
+        } else if (!denseMonsterAi
+            || org.leavesx.leavesx.performance.DenseMonsterAiPolicy.fullGoalSelectionDue(
+                this.tickCount,
+                this.getId(),
+                org.leavesx.leavesx.config.LeavesXRuntime.denseMonsterAiGoalIntervalTicks()
