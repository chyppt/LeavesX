     private static final int CHECK_TICK_DELAY = 5;
     private int openCount;
     private double maxInteractionRange;
+    // Rechecks happen every five ticks while a container is open. Keep the immutable geometry and only rebuild it
+    // when the block position or effective interaction range changes.
+    private BlockPos leavesXSearchBoxPosition;
+    private double leavesXSearchBoxRange = Double.NaN;
+    private AABB leavesXSearchBox;
     // CraftBukkit start
     public boolean opened;
     public void onOpenAPI(Level level, BlockPos pos, BlockState blockState) {
@@ -108,12 +113,17 @@ public abstract class ContainerOpenersCounter {
     }
 
     public List<ContainerUser> getEntitiesWithContainerOpen(final Level level, final BlockPos pos) {
-        double range = this.maxInteractionRange + 4.0;
-        AABB searchBox = new AABB(pos).inflate(range);
-        return level.getEntities((Entity)null, searchBox, entity -> this.hasContainerOpen(entity, pos))
-            .stream()
-            .map(entity -> (ContainerUser)entity)
-            .collect(Collectors.toList());
+        final double range = this.maxInteractionRange + 4.0;
+        final AABB searchBox = org.leavesx.leavesx.config.LeavesXRuntime.containerOpenerSearchBoxCacheOptimization()
+            ? this.leavesXGetSearchBox(pos, range)
+            : new AABB(pos).inflate(range);
+        final List<Entity> entities = level.getEntities((Entity)null, searchBox, entity -> this.hasContainerOpen(entity, pos));
+        if (org.leavesx.leavesx.config.LeavesXRuntime.containerUserListScanOptimization()) {
+            // The query predicate admits only ContainerUser instances. The returned Level list is already independent,
+            // mutable and in the same order as the stream-collected list used by the original implementation.
+            return (List<ContainerUser>)(List<?>)entities;
+        }
+        return entities.stream().map(entity -> (ContainerUser)entity).collect(Collectors.toList());
     }
 
     private boolean hasContainerOpen(final Entity entity, final BlockPos blockPos) {
@@ -171,7 +181,9 @@ public abstract class ContainerOpenersCounter {
 
     private int leavesXCountOpeners(final Level level, final BlockPos pos) {
         final double range = this.maxInteractionRange + 4.0;
-        final AABB searchBox = new AABB(pos).inflate(range);
+        final AABB searchBox = org.leavesx.leavesx.config.LeavesXRuntime.containerOpenerSearchBoxCacheOptimization()
+            ? this.leavesXGetSearchBox(pos, range)
+            : new AABB(pos).inflate(range);
         try (Level.LeavesXEntityQueryBuffer scan = Level.leavesX$acquireEntityQueryBuffer()) {
             final List<Entity> entities = scan.query(level, null, searchBox, entity -> this.hasContainerOpen(entity, pos));
             this.maxInteractionRange = 0.0;
@@ -183,6 +195,17 @@ public abstract class ContainerOpenersCounter {
         }
     }
 
+    private AABB leavesXGetSearchBox(final BlockPos pos, final double range) {
+        if (this.leavesXSearchBox == null
+            || !pos.equals(this.leavesXSearchBoxPosition)
+            || Double.compare(range, this.leavesXSearchBoxRange) != 0) {
+            this.leavesXSearchBoxPosition = pos.immutable();
+            this.leavesXSearchBoxRange = range;
+            this.leavesXSearchBox = new AABB(pos).inflate(range);
+        }
+        return this.leavesXSearchBox;
+    }
+
     public int getOpenerCount() {
         return this.openCount;
     }
