@@ -888,6 +917,41 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         profiler.pop();
     }
 
+    /**
+     * Refreshes the local monster-density snapshot at a low cadence and returns the cached decision for this tick.
+     *
+     * <p>Only {@link Monster} instances without a current target are eligible. The bounded query stops as soon as
+     * the configured threshold is reached, and the pooled buffer avoids an allocation for every monster tick.</p>
+     */
+    private boolean leavesXDenseMonsterAiActive() {
+        if (!(this instanceof Monster)
+            || !org.leavesx.leavesx.config.LeavesXRuntime.denseMonsterAiThrottling()
+            || this.getTarget() != null) {
+            return false;
+        }
+
+        final long currentTick = this.level().getGameTime();
+        if (currentTick < this.leavesXDenseMonsterAiNextCheckTick) {
+            return this.leavesXDenseMonsterAiActive;
+        }
+
+        final int checkInterval = org.leavesx.leavesx.config.LeavesXRuntime.denseMonsterAiCheckIntervalTicks();
+        this.leavesXDenseMonsterAiNextCheckTick = currentTick + checkInterval;
+        final int radius = org.leavesx.leavesx.config.LeavesXRuntime.denseMonsterAiNearbyRadius();
+        final int threshold = org.leavesx.leavesx.config.LeavesXRuntime.denseMonsterAiMinimumEntities();
+        final AABB searchBox = this.getBoundingBox().inflate(radius, radius, radius);
+        try (Level.LeavesXEntityQueryBuffer scan = Level.leavesX$acquireEntityQueryBuffer()) {
+            this.leavesXDenseMonsterAiActive = scan.countUpTo(
+                this.level(),
+                LEAVESX_MONSTER_ENTITY_TYPE,
+                searchBox,
+                EntitySelector.NO_SPECTATORS,
+                threshold
+            ) >= threshold;
+        }
+        return this.leavesXDenseMonsterAiActive;
+    }
+
     protected void customServerAiStep(final ServerLevel level) {
     }
 
