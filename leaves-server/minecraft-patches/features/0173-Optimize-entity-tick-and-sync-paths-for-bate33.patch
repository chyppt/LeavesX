diff --git a/net/minecraft/network/syncher/SynchedEntityData.java b/net/minecraft/network/syncher/SynchedEntityData.java
index 0075164bf057271d63a8b97473aa5c41c03eac91..9e019e1e0ed8dc4cb773e45de5124af2675d460b 100644
--- a/net/minecraft/network/syncher/SynchedEntityData.java
+++ b/net/minecraft/network/syncher/SynchedEntityData.java
@@ -20,6 +20,7 @@ public class SynchedEntityData {
     private final SyncedDataHolder entity;
     private final SynchedEntityData.DataItem<?>[] itemsById;
     private boolean isDirty;
+    private int dirtyCount;
 
     private SynchedEntityData(final SyncedDataHolder entity, final SynchedEntityData.DataItem<?>[] itemsById) {
         this.entity = entity;
@@ -62,14 +63,21 @@ public class SynchedEntityData {
         if (forceDirty || ObjectUtils.notEqual(value, dataItem.getValue())) {
             dataItem.setValue(value);
             this.entity.onSyncedDataUpdated(accessor);
-            dataItem.setDirty(true);
-            this.isDirty = true;
+            this.markItemDirty(dataItem);
         }
     }
 
     // CraftBukkit start - add method from above
     public <T> void markDirty(final EntityDataAccessor<T> accessor) {
-        this.getItem(accessor).setDirty(true);
+        this.markItemDirty(this.getItem(accessor));
+    }
+
+    private void markItemDirty(final SynchedEntityData.DataItem<?> dataItem) {
+        // Count each item once so packDirty can stay single-pass and allocate exactly when enabled.
+        if (!dataItem.isDirty()) {
+            dataItem.setDirty(true);
+            this.dirtyCount++;
+        }
         this.isDirty = true;
     }
     // CraftBukkit end
@@ -84,7 +92,10 @@ public class SynchedEntityData {
         }
 
         this.isDirty = false;
-        List<SynchedEntityData.DataValue<?>> result = new ArrayList<>();
+        List<SynchedEntityData.DataValue<?>> result = org.leavesx.leavesx.config.LeavesXRuntime.entityStateOptimizations()
+            ? new ArrayList<>(this.dirtyCount)
+            : new ArrayList<>();
+        this.dirtyCount = 0;
 
         for (SynchedEntityData.DataItem<?> dataItem : this.itemsById) {
             if (dataItem.isDirty()) {
