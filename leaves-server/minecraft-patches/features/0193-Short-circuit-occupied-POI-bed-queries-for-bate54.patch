From: LeavesX Build <build@leavesx.local>
Date: Sun, 16 Aug 2026 20:03:27 +0800
Subject: [PATCH] Short-circuit occupied POI bed queries for bate54


diff --git a/net/minecraft/world/entity/ai/behavior/ValidateNearbyPoi.java b/net/minecraft/world/entity/ai/behavior/ValidateNearbyPoi.java
index bd4fab6ad4404a758c7dbb690c32390038c8fb32..f147b8c5362ec90a89c49f2da9869d175c7c08ee 100644
--- a/net/minecraft/world/entity/ai/behavior/ValidateNearbyPoi.java
+++ b/net/minecraft/world/entity/ai/behavior/ValidateNearbyPoi.java
@@ -48,6 +48,9 @@ public class ValidateNearbyPoi {
     }
 
     private static boolean bedIsOccupiedByVillager(final ServerLevel poiLevel, final BlockPos poiPos) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()) {
+            return poiLevel.leavesX$getFirstEntityOfClass(Villager.class, new AABB(poiPos), LivingEntity::isSleeping) != null;
+        }
         List<Villager> villagers = poiLevel.getEntitiesOfClass(Villager.class, new AABB(poiPos), LivingEntity::isSleeping);
         return !villagers.isEmpty();
     }
