diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
index e3568d68..a2dc8bab 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
@@ -700,8 +700,16 @@ public final class ChunkHolderManager {
 
         final int chunkX = CoordinateUtils.getChunkX(chunk);
         final int chunkZ = CoordinateUtils.getChunkZ(chunk);
-        final Ticket probe = new Ticket(type, level, 0L);
-        ((ChunkSystemTicket<T>)(Object)probe).moonrise$setIdentifier(identifier);
+        final boolean optimizeRemovalProbe = org.leavesx.leavesx.config.LeavesXRuntime.ticketRemovalProbeOptimization();
+        final Ticket probe;
+        if (optimizeRemovalProbe) {
+            // Preserve the fallback constructor's identifier validation before touching the ticket table.
+            Ticket.leavesX$validateIdentifier(type, identifier);
+            probe = null;
+        } else {
+            probe = new Ticket(type, level, 0L);
+            ((ChunkSystemTicket<T>)(Object)probe).moonrise$setIdentifier(identifier);
+        }
 
         final ReentrantAreaLock.Node ticketLock = lock ? this.ticketLockArea.lock(chunkX, chunkZ) : null;
         try {
@@ -711,7 +719,9 @@ public final class ChunkHolderManager {
             }
 
             final int oldLevel = getTicketLevelAt(ticketsAtChunk);
-            final Ticket ticket = ticketsAtChunk.removeAndGet(probe);
+            final Ticket ticket = optimizeRemovalProbe
+                ? ticketsAtChunk.leavesX$removeAndGet(type, level, identifier)
+                : ticketsAtChunk.removeAndGet(probe);
 
             if (ticket == null) {
                 return false;
diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/util/stream/TicketSet.java b/ca/spottedleaf/moonrise/patches/chunk_system/util/stream/TicketSet.java
index d8db8894..8649713c 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/util/stream/TicketSet.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/util/stream/TicketSet.java
@@ -53,6 +53,33 @@ public final class TicketSet extends AbstractSet<Ticket> {
         return ~start;
     }
 
+    // Returns ~<insertion index> when not found, matching the Ticket-based lookup above.
+    private static <T> int leavesX$binarySearch(
+        final Ticket[] tickets,
+        int start,
+        int end,
+        final net.minecraft.server.level.TicketType<T> type,
+        final int ticketLevel,
+        final T identifier
+    ) {
+        Objects.checkFromToIndex(start, end, tickets.length);
+        --end;
+
+        while (start <= end) {
+            final int middle = (start + end) >>> 1;
+            final int comparison = tickets[middle].leavesX$compareToKey(type, ticketLevel, identifier);
+            if (comparison < 0) {
+                start = middle + 1;
+            } else if (comparison > 0) {
+                end = middle - 1;
+            } else {
+                return middle;
+            }
+        }
+
+        return ~start;
+    }
+
     private void expand() {
         int newSize = this.tickets.length + (this.tickets.length >> 1);
         if (newSize < 0) {
@@ -126,6 +153,22 @@ public final class TicketSet extends AbstractSet<Ticket> {
         return ret;
     }
 
+    /** Removes a ticket by its sorted key without allocating the throwaway probe used by the fallback path. */
+    public <T> Ticket leavesX$removeAndGet(
+        final net.minecraft.server.level.TicketType<T> type,
+        final int ticketLevel,
+        final T identifier
+    ) {
+        final int index = leavesX$binarySearch(this.tickets, 0, this.size, type, ticketLevel, identifier);
+        if (index < 0) {
+            return null;
+        }
+
+        final Ticket result = this.tickets[index];
+        this.removeAt(index);
+        return result;
+    }
+
     public Ticket first() {
         Objects.checkIndex(0, this.size);
         return this.tickets[0];
