@@ -5,7 +5,7 @@ import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
 import java.util.Objects;
 import net.minecraft.world.entity.MobCategory;
 
-/** Aggregates immutable chunk/category snapshots without exposing live world state to worker threads. */
+/** Aggregates chunk/category counts for both direct tick-thread and immutable worker-snapshot paths. */
 final class MobSpawnCountAccumulator {
 
     private static final int CATEGORY_COUNT = MobCategory.values().length;
@@ -13,6 +13,14 @@ final class MobSpawnCountAccumulator {
     private MobSpawnCountAccumulator() {
     }
 
+    static void add(
+        final Long2ObjectOpenHashMap<int[]> counts,
+        final long chunkKey,
+        final MobCategory category
+    ) {
+        add(counts, chunkKey, category.ordinal());
+    }
+
     static Long2ObjectOpenHashMap<int[]> count(
         final Inputs inputs,
         final boolean parallel,
@@ -41,17 +49,20 @@ final class MobSpawnCountAccumulator {
     private static Long2ObjectOpenHashMap<int[]> countRange(final Inputs inputs, final int start, final int end) {
         final Long2ObjectOpenHashMap<int[]> counts = new Long2ObjectOpenHashMap<>();
         for (int index = start; index < end; index++) {
-            final long chunkKey = inputs.chunkKeys()[index];
-            int[] categoryCounts = counts.get(chunkKey);
-            if (categoryCounts == null) {
-                categoryCounts = new int[CATEGORY_COUNT];
-                counts.put(chunkKey, categoryCounts);
-            }
-            categoryCounts[Byte.toUnsignedInt(inputs.categoryOrdinals()[index])]++;
+            add(counts, inputs.chunkKeys()[index], Byte.toUnsignedInt(inputs.categoryOrdinals()[index]));
         }
         return counts;
     }
 
+    private static void add(final Long2ObjectOpenHashMap<int[]> counts, final long chunkKey, final int categoryOrdinal) {
+        int[] categoryCounts = counts.get(chunkKey);
+        if (categoryCounts == null) {
+            categoryCounts = new int[CATEGORY_COUNT];
+            counts.put(chunkKey, categoryCounts);
+        }
+        categoryCounts[categoryOrdinal]++;
+    }
+
     private static Long2ObjectOpenHashMap<int[]> merge(
         final Long2ObjectOpenHashMap<int[]>[] partialCounts,
         final int completedPartitions
diff --git a/net/minecraft/world/level/MobSpawnCounting.java b/net/minecraft/world/level/MobSpawnCounting.java
index 4804185d0ad37b12865e5858ea08b46c94f13bb5..7d7641bb6d0152e63cfc3ff97fdfeb55d3e78456 100644
--- a/net/minecraft/world/level/MobSpawnCounting.java
