diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index 9f2260b0d1a49bbd865498d8305cc74727fac3cc..667677de2ec3e071565d6f4266ee09eca5a236bb 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -593,8 +593,10 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             // Paper end - chunk tick iteration optimisation
             profiler.popPush("tickSpawningChunks");
 
-            for (LevelChunk chunk : spawningChunks) {
-                this.tickSpawningChunk(chunk, timeDiff, spawningCategories, spawnCookie);
+            // LeavesX - ObjectArrayList supports stable indexed traversal without allocating an iterator each tick.
+            final int spawningChunkCount = spawningChunks.size();
+            for (int chunkIndex = 0; chunkIndex < spawningChunkCount; chunkIndex++) {
+                this.tickSpawningChunk(spawningChunks.get(chunkIndex), timeDiff, spawningCategories, spawnCookie);
             }
         } finally {
             spawningChunks.clear();
diff --git a/net/minecraft/world/level/MobSpawnCountAccumulator.java b/net/minecraft/world/level/MobSpawnCountAccumulator.java
