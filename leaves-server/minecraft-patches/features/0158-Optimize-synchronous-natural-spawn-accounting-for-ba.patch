@@ -16,10 +16,11 @@ import net.minecraft.world.level.chunk.ChunkAccess;
 import org.jspecify.annotations.Nullable;
 
 /**
- * Builds natural-spawn counters from a tick-thread snapshot.
+ * Builds natural-spawn counters while keeping all live world access on the tick thread.
  *
- * <p>Workers receive only packed chunk positions and category ordinals. Entity, chunk, player, plugin, and world
- * objects remain on the tick thread, and every result is applied before spawning continues in the same tick.</p>
+ * <p>The normal synchronous path aggregates directly. When parallel counting is profitable, workers receive only
+ * packed chunk positions and category ordinals. Entity, chunk, player, plugin, and world objects remain on the tick
+ * thread, and every result is applied before spawning continues in the same tick.</p>
  */
 final class MobSpawnCounting {
 
@@ -36,6 +37,10 @@ final class MobSpawnCounting {
         final boolean parallelCounting,
         final int expectedEntityCount
     ) {
+        if (!parallelCounting) {
+            return countSequentially(entities, chunkGetter, localMobCapCalculator, countMobs);
+        }
+
         final Snapshot snapshot = freezeInputs(
             entities,
             chunkGetter,
@@ -56,6 +61,74 @@ final class MobSpawnCounting {
         return new Result(snapshot.mobCounts(), snapshot.spawnPotential());
     }
 
+    /**
+     * Aggregates directly on the tick thread when worker execution is not profitable.
+     *
+     * <p>This retains the batched write-back semantics while avoiding worker snapshot arrays and their second scan.</p>
+     */
+    private static Result countSequentially(
+        final Iterable<Entity> entities,
+        final NaturalSpawner.ChunkGetter chunkGetter,
+        final @Nullable LocalMobCapCalculator localMobCapCalculator,
+        final boolean countMobs
+    ) {
+        final PotentialCalculator spawnPotential = new PotentialCalculator();
+        final Object2IntOpenHashMap<MobCategory> mobCounts = new Object2IntOpenHashMap<>();
+        final @Nullable Long2ObjectOpenHashMap<int[]> localCounts = localMobCapCalculator == null
+            ? null
+            : new Long2ObjectOpenHashMap<>();
+        final @Nullable Long2ObjectOpenHashMap<int[]> playerCounts = countMobs ? new Long2ObjectOpenHashMap<>() : null;
+        final ChunkMap[] playerMobCounter = countMobs ? new ChunkMap[1] : null;
+
+        for (final Entity entity : entities) {
+            final boolean isMob = entity instanceof Mob;
+            if (isMob && (((Mob)entity).isPersistenceRequired() || ((Mob)entity).requiresCustomPersistence())) {
+                continue;
+            }
+            final EntityType<?> entityType = entity.getType();
+            final MobCategory category = entityType.getCategory();
+            if (category == MobCategory.MISC) {
+                continue;
+            }
+            if (!org.leavesmc.leaves.LeavesConfig.modify.mcTechnicalMode
+                && !entity.level().paperConfig().entities.spawning.countAllMobsForSpawning
+                && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL
+                && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CHUNK_GEN) {
+                continue;
+            }
+
+            final BlockPos position = entity.blockPosition();
+            final long playerChunkKey = entity.chunkPosition().pack();
+            chunkGetter.query(ChunkPos.pack(position), chunk -> {
+                if (playerMobCounter != null && playerMobCounter[0] == null) {
+                    playerMobCounter[0] = chunk.level.getChunkSource().chunkMap;
+                }
+
+                final MobSpawnSettings.MobSpawnCost cost = getRoughBiome(position, chunk)
+                    .getMobSettings()
+                    .getMobSpawnCost(entityType);
+                if (cost != null) {
+                    spawnPotential.addCharge(position, cost.charge());
+                }
+                mobCounts.addTo(category, 1);
+                if (isMob && localCounts != null) {
+                    MobSpawnCountAccumulator.add(localCounts, chunk.getPos().pack(), category);
+                }
+                if (playerCounts != null) {
+                    MobSpawnCountAccumulator.add(playerCounts, playerChunkKey, category);
+                }
+            });
+        }
+
+        if (localCounts != null) {
+            applyLocalCounts(localCounts, localMobCapCalculator);
+        }
+        if (playerCounts != null) {
+            applyPlayerCounts(playerCounts, playerMobCounter[0]);
+        }
+        return new Result(mobCounts, spawnPotential);
+    }
+
     private static Snapshot freezeInputs(
         final Iterable<Entity> entities,
         final NaturalSpawner.ChunkGetter chunkGetter,
