From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MC_XiaoHei <xor7xiaohei@gmail.com>
Date: Sat, 26 Sep 2026 13:23:41 +0800
Subject: [PATCH] Fix block place desync due to update suppression


diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index c0a12129..5af157d7 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -395,8 +395,17 @@ public final class ItemStack implements DataComponentHolder, ItemInstance {
         List<net.minecraft.world.level.block.entity.BlockEntity> capturedBlockEntities;
         org.bukkit.TreeType treeType;
         InteractionResult result;
+        // Leaves - finish captured placement before propagating update suppression.
+        org.leavesmc.leaves.util.UpdateSuppressionException updateSuppression = null;
         try {
             result = usedItem.useOn(context);
+        } catch (org.leavesmc.leaves.util.UpdateSuppressionException ex) {
+            result = InteractionResult.SUCCESS.configurePaper(e -> e.placedBlockAt(pos.immutable()));
+            updateSuppression = ex;
+            ex.provideBlock(context.getLevel(), context.getClickedPos(), level.getBlockState(context.getClickedPos()).getBlock());
+            if (player instanceof net.minecraft.server.level.ServerPlayer serverPlayer) {
+                ex.providePlayer(serverPlayer);
+            }
         } finally {
             level.captureBlockStates = false;
             level.captureTreeGeneration = false;
@@ -513,6 +522,9 @@ public final class ItemStack implements DataComponentHolder, ItemInstance {
         }
         // CraftBukkit end
 
+        if (updateSuppression != null) {
+            throw updateSuppression;
+        }
         return result;
     }
 
diff --git a/net/minecraft/world/level/block/entity/BarrelBlockEntity.java b/net/minecraft/world/level/block/entity/BarrelBlockEntity.java
index 118af4e3..9b9920d8 100644
--- a/net/minecraft/world/level/block/entity/BarrelBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BarrelBlockEntity.java
@@ -107,6 +107,16 @@ public class BarrelBlockEntity extends RandomizableContainerBlockEntity {
         }
     }
 
+    // Leaves start - pca
+    @Override
+    public void setChanged() {
+        super.setChanged();
+        if (org.leavesmc.leaves.LeavesConfig.protocol.pca.enable) {
+            org.leavesmc.leaves.protocol.PcaSyncProtocol.syncBlockEntityToClient(this);
+        }
+    }
+    // Leaves end - pca
+
     @Override
     protected void loadAdditional(final ValueInput input) {
         super.loadAdditional(input);
