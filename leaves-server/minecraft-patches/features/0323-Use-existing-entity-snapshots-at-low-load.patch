+        private int leavesX$nearbyPlayerCount() {
+            final ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity chunkEntity =
+                (ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)this.entity;
+            final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.TrackedChunk chunk =
+                chunkEntity.moonrise$getChunkData().nearbyPlayers;
+            if (chunk == null) return 0;
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> players =
+                chunk.getPlayers(ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.VIEW_DISTANCE);
+            return players == null ? 0 : players.size();
+        }
+
+        /** 在原线程核验前面实体的提交是否改变本行输入；工作线程从不访问这些引用。 */
+        private boolean leavesX$matchesSnapshot(
+            final LeavesXTrackerSnapshot snapshot,
+            final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.@Nullable TrackedChunk currentChunk
+        ) {
+            if (currentChunk != snapshot.chunk || this.entity.getX() != snapshot.entityX
+                || this.entity.getY() != snapshot.entityY || this.entity.getZ() != snapshot.entityZ) {
+                return false;
+            }
+            if (currentChunk == null) return snapshot.playerCount == 0;
+            final var players = currentChunk.getPlayers(ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.VIEW_DISTANCE);
+            if (currentChunk.getUpdateCount() != snapshot.chunkUpdate) return false;
+            if (players == null) return snapshot.playerCount == 0;
+            if (players.size() != snapshot.playerCount) return false;
+            if (snapshot.playerCount == 0) return true;
+            if (this.getEffectiveRange() != snapshot.effectiveRange) return false;
+            final double rangeY = ChunkMap.this.level.paperConfig().entities.trackingRangeY.enabled
+                ? ChunkMap.this.level.paperConfig().entities.trackingRangeY.get(this.entity, -1) : -1.0;
+            if (rangeY != snapshot.rangeY) return false;
+            final ServerPlayer[] raw = players.getRawDataUnchecked();
+            for (int index = 0; index < snapshot.playerCount; index++) {
+                final int playerIndex = snapshot.playerIndices[index];
+                final ServerPlayer player = snapshot.playerFrame.players[playerIndex];
+                final int offset = playerIndex * LeavesXTrackerPlayerFrame.COMPONENTS;
+                if (raw[index] != player || player.getX() != snapshot.playerFrame.positionData[offset]
+                    || player.getY() != snapshot.playerFrame.positionData[offset + 1]
+                    || player.getZ() != snapshot.playerFrame.positionData[offset + 2]
+                    || ChunkMap.this.getPlayerViewDistance(player) * 16.0D != snapshot.playerFrame.viewDistanceBlocks[playerIndex]) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
         private int scaledRange(final int range) {
             return ChunkMap.this.level.getServer().getScaledTrackingDistance(range);
         }
