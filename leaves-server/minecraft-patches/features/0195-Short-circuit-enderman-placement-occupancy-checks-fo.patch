diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index e2817f0b..ae750eb0 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -210,6 +210,8 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     // LeavesX - one reusable result slot per calling thread; nested calls allocate a private fallback.
     private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_FIRST_ENTITY_QUERY_BUFFER =
         ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
+    private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_FIRST_UNTYPED_ENTITY_QUERY_BUFFER =
+        ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
     private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_UNIQUE_ENTITY_QUERY_BUFFER =
         ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
     private static final ThreadLocal<LeavesXEntityQueryBuffer> LEAVESX_ENTITY_QUERY_BUFFER =
@@ -334,6 +336,50 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         return this.leavesX$getFirstEntityOfClass(entityClass, boundingBox, EntitySelector.NO_SPECTATORS);
     }
 
+    /** Returns the first matching entity while preserving Paper's supplemental entity lookup. */
+    public final @Nullable Entity leavesX$getFirstEntity(
+        final @Nullable Entity except,
+        final AABB boundingBox,
+        final Predicate<? super Entity> predicate
+    ) {
+        Profiler.get().incrementCounter("getEntities");
+        final LeavesXFirstEntityQueryBuffer buffer = LEAVESX_FIRST_UNTYPED_ENTITY_QUERY_BUFFER.get();
+        if (!buffer.acquire()) {
+            final List<Entity> nestedResults = new java.util.ArrayList<>(1);
+            this.leavesX$collectFirstEntity(except, boundingBox, predicate, nestedResults);
+            return nestedResults.isEmpty() ? null : nestedResults.getFirst();
+        }
+
+        try {
+            this.leavesX$collectFirstEntity(except, boundingBox, predicate, buffer.results);
+            return buffer.results.isEmpty() ? null : buffer.results.getFirst();
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private void leavesX$collectFirstEntity(
+        final @Nullable Entity except,
+        final AABB boundingBox,
+        final Predicate<? super Entity> predicate,
+        final List<Entity> results
+    ) {
+        ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
+            .moonrise$getEntityLookup().getEntities(except, boundingBox, results, predicate, 1);
+        if (results.isEmpty()) {
+            ca.spottedleaf.moonrise.common.PlatformHooks.get()
+                .addToGetEntities((Level)(Object)this, except, boundingBox, predicate, results);
+        }
+    }
+
+    public final boolean leavesX$hasEntity(
+        final @Nullable Entity except,
+        final AABB boundingBox,
+        final Predicate<? super Entity> predicate
+    ) {
+        return this.leavesX$getFirstEntity(except, boundingBox, predicate) != null;
+    }
+
     public final <T extends Entity> boolean leavesX$hasEntityOfClass(
         final Class<T> entityClass,
         final AABB boundingBox
