@@ -85,6 +71,32 @@ public class TemptingSensor extends Sensor<PathfinderMob> {
         }
     }
 
+    private Player findNearestTemptingPlayerDirect(
+        final ServerLevel level,
+        final PathfinderMob body,
+        final TargetingConditions targeting,
+        final List<? extends Player> players
+    ) {
+        Player nearestPlayer = null;
+        double nearestDistance = 0.0;
+        for (final Player player : players) {
+            if (
+                EntitySelector.NO_SPECTATORS.test(player)
+                    && targeting.test(level, body, player)
+                    && this.playerHoldingTemptation(body, player)
+                    && !body.hasPassenger(player)
+            ) {
+                final double distance = body.distanceToSqr(player);
+                // Comparator sorting is stable, so equal distances must retain the first player's position.
+                if (nearestPlayer == null || Double.compare(distance, nearestDistance) < 0) {
+                    nearestPlayer = player;
+                    nearestDistance = distance;
+                }
+            }
+        }
+        return nearestPlayer;
+    }
+
     private boolean playerHoldingTemptation(final PathfinderMob mob, final Player player) {
         return this.isTemptation(mob, player.getMainHandItem()) || this.isTemptation(mob, player.getOffhandItem());
     }
