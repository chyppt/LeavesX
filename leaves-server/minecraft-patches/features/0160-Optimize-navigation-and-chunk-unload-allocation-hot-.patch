+        if (org.leavesx.leavesx.config.LeavesXRuntime.pathfindingOptimizations()) {
+            // LeavesX start - preserve Vec3's arithmetic while avoiding up to eight short-lived path-following objects.
+            final Node currentNode = this.path.getNextNode();
+            final double currentX = currentNode.x + 0.5;
+            final double currentY = currentNode.y;
+            final double currentZ = currentNode.z + 0.5;
+            final double mobToCurrentSqr = mobPosition.distanceToSqr(currentX, currentY, currentZ);
+            if (!(mobToCurrentSqr < 4.0)) {
+                return false;
+            }
+
+            if (this.canMoveDirectly(mobPosition, this.path.getNextEntityPos(this.mob))) {
+                return true;
+            }
+
+            final Node nextNode = this.path.getNode(this.path.getNextNodeIndex() + 1);
+            final double mobToCurrentX = currentX - mobPosition.x;
+            final double mobToCurrentY = currentY - mobPosition.y;
+            final double mobToCurrentZ = currentZ - mobPosition.z;
+            final double mobToNextX = nextNode.x + 0.5 - mobPosition.x;
+            final double mobToNextY = nextNode.y - mobPosition.y;
+            final double mobToNextZ = nextNode.z + 0.5 - mobPosition.z;
+            final double mobToNextSqr = mobToNextX * mobToNextX + mobToNextY * mobToNextY + mobToNextZ * mobToNextZ;
+            final boolean closerToNextThanCurrent = mobToNextSqr < mobToCurrentSqr;
+            final boolean withinCurrentBlock = mobToCurrentSqr < 0.5;
+            if (!closerToNextThanCurrent && !withinCurrentBlock) {
+                return false;
+            }
+
+            final double mobToCurrentLength = Math.sqrt(mobToCurrentSqr);
+            final double mobDirectionX;
+            final double mobDirectionY;
+            final double mobDirectionZ;
+            if (mobToCurrentLength < 1.0E-5F) {
+                mobDirectionX = 0.0;
+                mobDirectionY = 0.0;
+                mobDirectionZ = 0.0;
+            } else {
+                mobDirectionX = mobToCurrentX / mobToCurrentLength;
+                mobDirectionY = mobToCurrentY / mobToCurrentLength;
+                mobDirectionZ = mobToCurrentZ / mobToCurrentLength;
+            }
+
+            final double mobToNextLength = Math.sqrt(mobToNextSqr);
+            final double pathDirectionX;
+            final double pathDirectionY;
+            final double pathDirectionZ;
+            if (mobToNextLength < 1.0E-5F) {
+                pathDirectionX = 0.0;
+                pathDirectionY = 0.0;
+                pathDirectionZ = 0.0;
+            } else {
+                pathDirectionX = mobToNextX / mobToNextLength;
+                pathDirectionY = mobToNextY / mobToNextLength;
+                pathDirectionZ = mobToNextZ / mobToNextLength;
+            }
+            return pathDirectionX * mobDirectionX + pathDirectionY * mobDirectionY + pathDirectionZ * mobDirectionZ < 0.0;
+            // LeavesX end - preserve Vec3's arithmetic while avoiding up to eight short-lived path-following objects.
+        }
+
         Vec3 currentNode = Vec3.atBottomCenterOf(this.path.getNextNodePos());
         if (!mobPosition.closerThan(currentNode, 2.0)) {
             return false;
