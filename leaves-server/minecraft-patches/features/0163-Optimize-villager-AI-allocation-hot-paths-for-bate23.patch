+    /** Returns the same visible matches as {@link #findAll(Predicate)} without an intermediate filtered iterable. */
+    public List<LivingEntity> findAllToList(final Predicate<LivingEntity> filter) {
+        ImmutableList.Builder<LivingEntity> matches = null;
+        for (final LivingEntity nearbyEntity : this.nearbyEntities) {
+            if (filter.test(nearbyEntity) && this.lineOfSightTest.test(nearbyEntity)) {
+                if (matches == null) {
+                    matches = ImmutableList.builder();
+                }
+                matches.add(nearbyEntity);
+            }
+        }
+        return matches == null ? List.of() : matches.build();
+    }
+
     public Stream<LivingEntity> find(final Predicate<LivingEntity> filter) {
         return this.nearbyEntities.stream().filter(entity -> filter.test(entity) && this.lineOfSightTest.test(entity));
     }
