+    // LeavesX start - direct, allocation-conscious implementation of the original declarative behavior
+    private static final class AcquirePoiBehavior extends OneShot<PathfinderMob> {
+
+        private final Predicate<Holder<PoiType>> poiType;
+        private final MemoryModuleType<GlobalPos> memoryToValidate;
+        private final MemoryModuleType<GlobalPos> memoryToAcquire;
+        private final boolean onlyIfAdult;
+        private final Optional<Byte> onPoiAcquisitionEvent;
+        private final BiPredicate<ServerLevel, BlockPos> validPoi;
+        private final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> batchCache = new Long2ObjectOpenHashMap<>();
+        private final List<Pair<Holder<PoiType>, BlockPos>> reusableRawPoiPositions = new ArrayList<>(BATCH_SIZE);
+        private final RetryPredicate reusableRetryPredicate = new RetryPredicate(this.batchCache);
+        private long nextScheduledStart;
+
+        private AcquirePoiBehavior(
+            final Predicate<Holder<PoiType>> poiType,
+            final MemoryModuleType<GlobalPos> memoryToValidate,
+            final MemoryModuleType<GlobalPos> memoryToAcquire,
+            final boolean onlyIfAdult,
+            final Optional<Byte> onPoiAcquisitionEvent,
+            final BiPredicate<ServerLevel, BlockPos> validPoi
+        ) {
+            this.poiType = poiType;
+            this.memoryToValidate = memoryToValidate;
+            this.memoryToAcquire = memoryToAcquire;
+            this.onlyIfAdult = onlyIfAdult;
+            this.onPoiAcquisitionEvent = onPoiAcquisitionEvent;
+            this.validPoi = validPoi;
+        }
+
+        @Override
+        public boolean trigger(final ServerLevel level, final PathfinderMob body, final long timestamp) {
+            final Brain<?> brain = body.getBrain();
+            // Match the nested BehaviorBuilder checks exactly: validation memory first, acquisition memory second.
+            if (!brain.checkMemory(this.memoryToValidate, MemoryStatus.VALUE_ABSENT)
+                || (this.memoryToAcquire != this.memoryToValidate
+                    && !brain.checkMemory(this.memoryToAcquire, MemoryStatus.VALUE_ABSENT))) {
+                return false;
+            }
+            if (this.onlyIfAdult && body.isBaby()) {
+                return false;
+            }
+
+            final RandomSource random = level.getRandom();
+            if (this.nextScheduledStart == 0L) {
+                this.nextScheduledStart = level.getGameTime() + random.nextInt(RATE);
+                return false;
+            }
+            if (level.getGameTime() < this.nextScheduledStart) {
+                return false;
+            }
+
+            this.nextScheduledStart = timestamp + RATE + random.nextInt(RATE);
+            if (!org.leavesmc.leaves.LeavesConfig.modify.mcTechnicalMode
+                && level.paperConfig().entities.behavior.stuckEntityPoiRetryDelay.enabled()
+                && body.getNavigation().isStuck()) {
+                this.nextScheduledStart += level.paperConfig().entities.behavior.stuckEntityPoiRetryDelay.intValue();
+            }
+
+            final PoiManager poiManager = level.getPoiManager();
+            this.removeExpiredRetries(timestamp);
+            final boolean optimizeAllocations = org.leavesx.leavesx.config.LeavesXRuntime.aiOptimizations();
+            final Predicate<BlockPos> cacheTest;
+            final List<Pair<Holder<PoiType>, BlockPos>> rawPoiPositions;
+            if (optimizeAllocations) {
+                // This scratch list never escapes the synchronous POI attempt, so retaining its capacity is safe.
+                this.reusableRawPoiPositions.clear();
+                rawPoiPositions = this.reusableRawPoiPositions;
+                this.reusableRetryPredicate.prepare(timestamp);
+                cacheTest = this.reusableRetryPredicate;
+            } else {
+                rawPoiPositions = new ArrayList<>();
+                cacheTest = pos -> testRetry(this.batchCache, pos, timestamp);
+            }
+
+            ca.spottedleaf.moonrise.patches.poi_lookup.PoiAccess.findNearestPoiPositions(
+                poiManager,
+                this.poiType,
+                cacheTest,
+                body.blockPosition(),
+                SCAN_RANGE,
+                Double.MAX_VALUE,
+                PoiManager.Occupancy.HAS_SPACE,
+                ca.spottedleaf.moonrise.patches.poi_lookup.PoiAccess.LOAD_FOR_SEARCHING,
+                BATCH_SIZE,
+                rawPoiPositions
+            );
+            // Keep fresh HashSet instances: their capacity affects iteration order and pathfinding tie resolution.
+            final Set<Pair<Holder<PoiType>, BlockPos>> poiPositions = new HashSet<>(rawPoiPositions.size());
+            for (final Pair<Holder<PoiType>, BlockPos> pair : rawPoiPositions) {
+                if (this.validPoi.test(level, pair.getSecond())) {
+                    poiPositions.add(pair);
+                }
+            }
+
+            final Path path = findPathToPois(body, poiPositions);
+            if (path != null && path.canReach()) {
+                final BlockPos targetPos = path.getTarget();
+                if (poiManager.getType(targetPos).isPresent()) {
+                    poiManager.take(this.poiType, (type, poiPos) -> poiPos.equals(targetPos), targetPos, 1);
+                    brain.setMemory(this.memoryToAcquire, GlobalPos.of(level.dimension(), targetPos));
+                    if (this.onPoiAcquisitionEvent.isPresent()) {
+                        level.broadcastEntityEvent(body, this.onPoiAcquisitionEvent.get());
+                    }
+                    this.batchCache.clear();
+                    level.debugSynchronizers().updatePoi(targetPos);
+                }
+            } else {
+                for (final Pair<Holder<PoiType>, BlockPos> poi : poiPositions) {
+                    final long key = poi.getSecond().asLong();
+                    if (this.batchCache.get(key) == null) {
+                        this.batchCache.put(key, new AcquirePoi.JitteredLinearRetry(random, timestamp));
+                    }
+                }
+            }
+            return true;
+        }
+
+        @Override
+        public Set<MemoryModuleType<?>> getRequiredMemories() {
+            // The original outer declarative wrapper reports only the validation memory when the two differ.
+            return Set.of(this.memoryToValidate);
+        }
+
+        private void removeExpiredRetries(final long timestamp) {
+            final ObjectIterator<Long2ObjectMap.Entry<AcquirePoi.JitteredLinearRetry>> iterator =
+                Long2ObjectMaps.fastIterator(this.batchCache);
+            while (iterator.hasNext()) {
+                if (!iterator.next().getValue().isStillValid(timestamp)) {
+                    iterator.remove();
+                }
+            }
+        }
+    }
+
+    private static final class RetryPredicate implements Predicate<BlockPos> {
+
+        private final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> batchCache;
+        private long timestamp;
+
+        private RetryPredicate(final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> batchCache) {
+            this.batchCache = batchCache;
+        }
+
+        private void prepare(final long timestamp) {
+            this.timestamp = timestamp;
+        }
+
+        @Override
+        public boolean test(final BlockPos pos) {
+            return testRetry(this.batchCache, pos, this.timestamp);
+        }
+    }
+
+    private static boolean testRetry(
+        final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> batchCache,
+        final BlockPos pos,
+        final long timestamp
+    ) {
+        final AcquirePoi.JitteredLinearRetry retryMarker = batchCache.get(pos.asLong());
+        if (retryMarker == null) {
+            return true;
+        }
+        if (!retryMarker.shouldRetry(timestamp)) {
+            return false;
+        }
+        retryMarker.markAttempt(timestamp);
+        return true;
+    }
+    // LeavesX end - direct, allocation-conscious implementation of the original declarative behavior
+
     private static class JitteredLinearRetry {
         private static final int MIN_INTERVAL_INCREASE = 40;
         private static final int MAX_INTERVAL_INCREASE = 80;
