@@ -367,6 +380,53 @@ public class FriendlyByteBuf extends ByteBuf {
         }
     }
 
+    /**
+     * Writes sufficiently large arrays with one capacity check and one writer-index update.
+     *
+     * <p>Heap buffers use endian-aware VarHandles. Direct buffers use Netty's reusable internal NIO view, which avoids
+     * the per-element bounds checks without allocating a temporary byte array. Unsupported buffers and insufficient
+     * maximum capacity retain the original element-by-element path.</p>
+     */
+    @SuppressWarnings("deprecation")
+    private boolean leavesX$writeFixedSizeLongArrayBulk(final long[] longs) {
+        if (longs.length < LEAVESX_MINIMUM_BULK_LONG_ARRAY_LENGTH
+            || !LeavesXRuntime.bulkLongArrayWritesOptimization()
+            || longs.length > Integer.MAX_VALUE / Long.BYTES) {
+            return false;
+        }
+
+        final ByteBuf output = this.source;
+        final int byteCount = longs.length * Long.BYTES;
+        if (!output.isContiguous() || output.maxWritableBytes() < byteCount) {
+            return false;
+        }
+
+        final boolean heapBuffer = output.hasArray();
+        if (!heapBuffer && output.nioBufferCount() != 1) {
+            return false;
+        }
+
+        output.ensureWritable(byteCount);
+        final int writerIndex = output.writerIndex();
+        final ByteOrder order = output.order();
+        if (heapBuffer) {
+            final VarHandle longView = order == ByteOrder.BIG_ENDIAN
+                ? LEAVESX_BIG_ENDIAN_LONGS
+                : LEAVESX_LITTLE_ENDIAN_LONGS;
+            final byte[] array = output.array();
+            int offset = output.arrayOffset() + writerIndex;
+            for (final long value : longs) {
+                longView.set(array, offset, value);
+                offset += Long.BYTES;
+            }
+        } else {
+            final ByteBuffer view = output.internalNioBuffer(writerIndex, byteCount).order(order);
+            view.asLongBuffer().put(longs);
+        }
+        output.writerIndex(writerIndex + byteCount);
+        return true;
+    }
+
     public long[] readLongArray() {
         return readLongArray(this);
     }
