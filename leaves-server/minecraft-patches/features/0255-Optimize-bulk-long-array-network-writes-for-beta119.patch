         return this;
     }
 
@@ -357,7 +368,9 @@ public class FriendlyByteBuf extends ByteBuf {
     }
 
     public FriendlyByteBuf writeFixedSizeLongArray(final long[] longs) {
-        writeFixedSizeLongArray(this, longs);
+        if (!this.leavesX$writeFixedSizeLongArrayBulk(longs)) {
