From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Sat, 29 Aug 2026 13:06:00 +0800
Subject: [PATCH] Restore villager hostile sensor cadence


diff --git a/net/minecraft/world/entity/ai/sensing/Sensor.java b/net/minecraft/world/entity/ai/sensing/Sensor.java
index a2f64976..2b0fdac7 100644
--- a/net/minecraft/world/entity/ai/sensing/Sensor.java
+++ b/net/minecraft/world/entity/ai/sensing/Sensor.java
@@ -53,12 +53,19 @@ public abstract class Sensor<E extends LivingEntity> {
     }
 
     public final void tick(final ServerLevel level, final E body) {
+        final boolean villager = body instanceof net.minecraft.world.entity.npc.villager.Villager;
+        // A previous Paper interval or a live configuration reload may have left a much larger countdown in this
+        // sensor instance. Clamp it before decrementing so hostile detection recovers within one vanilla interval.
+        if (villager && this.timeToTick > this.scanRate) {
+            this.timeToTick = this.scanRate;
+        }
         if (--this.timeToTick <= 0L) {
             final int paperInterval = java.util.Objects.requireNonNullElse(
                 level.paperConfig().tickRates.sensor.get(body.getType(), this.configKey),
                 this.scanRate
             ); // Paper - configurable sensor tick rate and timings
             this.timeToTick = org.leavesx.leavesx.config.LeavesXRuntime.villagerSensorTickInterval(
+                villager,
                 paperInterval,
                 this.scanRate
             );
