+    private static Map<Heightmap.Types, long[]> collectHeightmaps(
+        final Collection<Entry<Heightmap.Types, Heightmap>> heightmaps,
+        final boolean optimizeAssembly
+    ) {
+        if (!optimizeAssembly) {
+            return heightmaps.stream()
+                .filter(entry -> entry.getKey().sendToClient())
+                .collect(Collectors.toMap(Entry::getKey, entry -> (long[])entry.getValue().getRawData().clone()));
+        }
+
+        // HashMap matches the Paper collector result, including its packet-entry iteration behavior.
+        final Map<Heightmap.Types, long[]> result = new HashMap<>();
+        for (final Entry<Heightmap.Types, Heightmap> entry : heightmaps) {
+            final Heightmap.Types type = entry.getKey();
+            if (type.sendToClient()) {
+                result.put(type, (long[])entry.getValue().getRawData().clone());
+            }
+        }
+        return result;
+    }
+
