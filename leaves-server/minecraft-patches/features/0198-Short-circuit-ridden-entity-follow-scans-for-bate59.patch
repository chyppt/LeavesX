From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Sun, 16 Aug 2026 20:50:57 +0800
Subject: [PATCH] Short-circuit ridden entity follow scans for bate59


diff --git a/net/minecraft/world/entity/ai/goal/FollowPlayerRiddenEntityGoal.java b/net/minecraft/world/entity/ai/goal/FollowPlayerRiddenEntityGoal.java
index 4618602a..e8f3fabb 100644
--- a/net/minecraft/world/entity/ai/goal/FollowPlayerRiddenEntityGoal.java
+++ b/net/minecraft/world/entity/ai/goal/FollowPlayerRiddenEntityGoal.java
@@ -1,5 +1,6 @@
 package net.minecraft.world.entity.ai.goal;
 
+import java.util.function.Predicate;
 import net.minecraft.core.BlockPos;
 import net.minecraft.core.Direction;
 import net.minecraft.world.entity.Entity;
@@ -10,6 +11,9 @@ import net.minecraft.world.phys.Vec3;
 import org.jspecify.annotations.Nullable;
 
 public class FollowPlayerRiddenEntityGoal extends Goal {
+    private static final Predicate<Entity> LEAVESX_MOVING_RIDDEN_ENTITY = entity ->
+        entity.getControllingPassenger() instanceof Player player && player.hasMovedHorizontallyRecently();
+    private static final Predicate<Entity> LEAVESX_PLAYER_RIDDEN_ENTITY = entity -> entity.getControllingPassenger() instanceof Player;
     private int timeToRecalcPath;
     private final PathfinderMob mob;
     private final Class<? extends Entity> entityTypeToFollow;
@@ -27,6 +31,11 @@ public class FollowPlayerRiddenEntityGoal extends Goal {
             return true;
         }
 
+        if (org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()) {
+            return this.mob.level().leavesX$getFirstEntityOfClass(
+                this.entityTypeToFollow, this.mob.getBoundingBox().inflate(5.0), LEAVESX_MOVING_RIDDEN_ENTITY
+            ) != null;
+        }
         for (Entity entity : this.mob.level().getEntitiesOfClass(this.entityTypeToFollow, this.mob.getBoundingBox().inflate(5.0))) {
             if (entity.getControllingPassenger() instanceof Player controllingPlayer && controllingPlayer.hasMovedHorizontallyRecently()) {
                 return true;
@@ -48,10 +57,19 @@ public class FollowPlayerRiddenEntityGoal extends Goal {
 
     @Override
     public void start() {
-        for (Entity entity : this.mob.level().getEntitiesOfClass(this.entityTypeToFollow, this.mob.getBoundingBox().inflate(5.0))) {
-            if (entity.getControllingPassenger() instanceof Player player) {
-                this.following = player;
-                break;
+        if (org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()) {
+            final Entity riddenEntity = this.mob.level().leavesX$getFirstEntityOfClass(
+                this.entityTypeToFollow, this.mob.getBoundingBox().inflate(5.0), LEAVESX_PLAYER_RIDDEN_ENTITY
+            );
+            if (riddenEntity != null) {
+                this.following = (Player)riddenEntity.getControllingPassenger();
+            }
+        } else {
+            for (Entity entity : this.mob.level().getEntitiesOfClass(this.entityTypeToFollow, this.mob.getBoundingBox().inflate(5.0))) {
+                if (entity.getControllingPassenger() instanceof Player player) {
+                    this.following = player;
+                    break;
+                }
             }
         }
 
