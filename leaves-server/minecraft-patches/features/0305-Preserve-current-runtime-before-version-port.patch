diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/poi/PoiChunk.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/poi/PoiChunk.java
index 5adbeecd..f5d863ce 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/poi/PoiChunk.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/poi/PoiChunk.java
@@ -148,6 +148,63 @@ public final class PoiChunk {
         return sections.isEmpty() ? null : ret;
     }
 
+    // LeavesX start - regionized saving: split POI save into a cheap snapshot (tick thread) and
+    // an immutable pure-codec encode (save executor). The packed snapshot holds only immutable
+    // records, so encoding off-thread cannot observe live POI mutation.
+    public record PackedSection(int sectionY, PoiSection.Packed packed) {}
+
+    /** Must be called on the tick thread; freezes every non-empty section into immutable form. */
+    public @org.jetbrains.annotations.Nullable java.util.List<PackedSection> snapshotPacked() {
+        java.util.List<PackedSection> snapshot = null;
+        for (int sectionY = this.minSection; sectionY <= this.maxSection; ++sectionY) {
+            final PoiSection section = this.sections[sectionY - this.minSection];
+            if (section == null || ((ChunkSystemPoiSection)section).moonrise$isEmpty()) {
+                continue;
+            }
+            if (snapshot == null) {
+                snapshot = new java.util.ArrayList<>(this.maxSection - this.minSection + 1);
+            }
+            snapshot.add(new PackedSection(sectionY, section.pack()));
+        }
+        return snapshot;
+    }
+
+    /**
+     * Pure encoder over an immutable {@link #snapshotPacked()} result; safe on any thread.
+     * Returns {@code null} when the snapshot holds no sections.
+     */
+    public static @org.jetbrains.annotations.Nullable CompoundTag savePacked(
+        final ServerLevel world, final int chunkX, final int chunkZ, final java.util.List<PackedSection> snapshot
+    ) {
+        if (snapshot == null || snapshot.isEmpty()) {
+            return null;
+        }
+        final RegistryOps<Tag> registryOps = RegistryOps.create(NbtOps.INSTANCE, world.registryAccess());
+
+        final CompoundTag ret = new CompoundTag();
+        final CompoundTag sections = new CompoundTag();
+        ret.put("Sections", sections);
+
+        ret.putInt("DataVersion", SharedConstants.getCurrentVersion().dataVersion().version());
+
+        for (final PackedSection entry : snapshot) {
+            final DataResult<Tag> serializedResult = PoiSection.Packed.CODEC.encodeStart(registryOps, entry.packed());
+            final int finalSectionY = entry.sectionY();
+            final Tag serialized = serializedResult.resultOrPartial((final String description) -> {
+                LOGGER.error("Failed to serialize poi chunk for world: " + WorldUtil.getWorldName(world) + ", chunk: (" + chunkX + "," + finalSectionY + "," + chunkZ + "); description: " + description);
+            }).orElse(null);
+            if (serialized == null) {
+                // failed, should be logged from the resultOrPartial
+                continue;
+            }
+
+            sections.put(Integer.toString(finalSectionY), serialized);
+        }
+
+        return sections.isEmpty() ? null : ret;
+    }
+    // LeavesX end - regionized saving
+
     public static PoiChunk empty(final ServerLevel world, final int chunkX, final int chunkZ) {
         final PoiChunk ret = new PoiChunk(world, chunkX, chunkZ, WorldUtil.getMinSection(world), WorldUtil.getMaxSection(world));
         ret.loaded = true;
