From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Sun, 16 Aug 2026 21:52:43 +0800
Subject: [PATCH] Short-circuit cat sleeping player scans for bate65


diff --git a/net/minecraft/world/entity/animal/feline/Cat.java b/net/minecraft/world/entity/animal/feline/Cat.java
index 17c5608e74c29f4e800bc7a66713d4926008568b..40a9072b0cabc43dd247336d754c6d9953116c03 100644
--- a/net/minecraft/world/entity/animal/feline/Cat.java
+++ b/net/minecraft/world/entity/animal/feline/Cat.java
@@ -308,11 +308,16 @@ public class Cat extends TamableAnimal {
         this.isLyingOnTopOfSleepingPlayer = false;
         if (this.isLying()) {
             BlockPos catPos = this.blockPosition();
-
-            for (Player player : this.level().getEntitiesOfClass(Player.class, new AABB(catPos).inflate(2.0, 2.0, 2.0))) {
-                if (player.isSleeping()) {
-                    this.isLyingOnTopOfSleepingPlayer = true;
-                    break;
+            final AABB sleepingPlayerArea = new AABB(catPos).inflate(2.0, 2.0, 2.0);
+            if (org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()) {
+                this.isLyingOnTopOfSleepingPlayer = this.level()
+                    .leavesX$getFirstEntityOfClass(Player.class, sleepingPlayerArea, Player::isSleeping) != null;
+            } else {
+                for (Player player : this.level().getEntitiesOfClass(Player.class, sleepingPlayerArea)) {
+                    if (player.isSleeping()) {
+                        this.isLyingOnTopOfSleepingPlayer = true;
+                        break;
+                    }
                 }
             }
         }
