Subject: [PATCH] Bound experience orb merge lookups for bate71


diff --git a/net/minecraft/world/entity/ExperienceOrb.java b/net/minecraft/world/entity/ExperienceOrb.java
index 5f964761..e8f02caf 100644
--- a/net/minecraft/world/entity/ExperienceOrb.java
+++ b/net/minecraft/world/entity/ExperienceOrb.java
@@ -276,15 +276,25 @@ public class ExperienceOrb extends Entity {
         // Paper - TODO some other event for this kind of merge
         AABB box = AABB.ofSize(pos, 1.0, 1.0, 1.0);
         int id = level.getRandom().nextInt(io.papermc.paper.configuration.GlobalConfiguration.get().misc.xpOrbGroupsPerArea.or(ORB_GROUPS_PER_AREA)); // Paper - Configure how many orb groups per area
-        List<ExperienceOrb> orbs = level.getEntities(EntityTypeTest.forClass(ExperienceOrb.class), box, orbx -> canMerge(orbx, id, value));
-        if (!orbs.isEmpty()) {
-            ExperienceOrb orb = orbs.get(0);
-            orb.count++;
-            orb.age = 0;
-            return true;
+        final ExperienceOrb orb;
+        if (org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()) {
+            orb = level.leavesX$getFirstEntity(
+                EntityTypeTest.forClass(ExperienceOrb.class), box, orbx -> canMerge(orbx, id, value)
+            );
         } else {
+            final List<ExperienceOrb> orbs = level.getEntities(
+                EntityTypeTest.forClass(ExperienceOrb.class), box, orbx -> canMerge(orbx, id, value)
+            );
+            orb = orbs.isEmpty() ? null : orbs.getFirst();
+        }
+
+        if (orb == null) {
             return false;
         }
+
+        orb.count++;
+        orb.age = 0;
+        return true;
     }
 
     private boolean canMerge(final ExperienceOrb orb) {
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index ae750eb0..95d1ddba 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -212,6 +212,8 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
     private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_FIRST_UNTYPED_ENTITY_QUERY_BUFFER =
         ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
+    private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_FIRST_TYPED_ENTITY_QUERY_BUFFER =
+        ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
     private static final ThreadLocal<LeavesXFirstEntityQueryBuffer> LEAVESX_UNIQUE_ENTITY_QUERY_BUFFER =
         ThreadLocal.withInitial(LeavesXFirstEntityQueryBuffer::new);
     private static final ThreadLocal<LeavesXEntityQueryBuffer> LEAVESX_ENTITY_QUERY_BUFFER =
@@ -358,6 +360,28 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         }
     }
 
+    /** Returns the first typed match while preserving Paper's supplemental entity lookup. */
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    public final <T extends Entity> @Nullable T leavesX$getFirstEntity(
+        final EntityTypeTest<Entity, T> entityTypeTest,
+        final AABB boundingBox,
+        final Predicate<? super T> predicate
+    ) {
+        final LeavesXFirstEntityQueryBuffer buffer = LEAVESX_FIRST_TYPED_ENTITY_QUERY_BUFFER.get();
+        if (!buffer.acquire()) {
+            final List<T> nestedResults = new java.util.ArrayList<>(1);
+            this.getEntities(entityTypeTest, boundingBox, predicate, nestedResults, 1);
+            return nestedResults.isEmpty() ? null : nestedResults.getFirst();
+        }
+
+        try {
+            this.getEntities(entityTypeTest, boundingBox, predicate, (List)buffer.results, 1);
+            return buffer.results.isEmpty() ? null : (T)buffer.results.getFirst();
+        } finally {
+            buffer.release();
+        }
+    }
+
     private void leavesX$collectFirstEntity(
         final @Nullable Entity except,
         final AABB boundingBox,
