From 19893e063f21f2f9cd97d53babfd02ab091d069c Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Date: Sat, 14 Nov 2026 16:00:00 +0800
Subject: [PATCH] Observe bounded experience drop diagnostics

---
 net/minecraft/world/entity/ExperienceOrb.java | 29 +++++++++++++++----
 net/minecraft/world/entity/LivingEntity.java  |  1 +
 2 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/net/minecraft/world/entity/ExperienceOrb.java b/net/minecraft/world/entity/ExperienceOrb.java
index 71e7f19c..e178bb73 100644
--- a/net/minecraft/world/entity/ExperienceOrb.java
+++ b/net/minecraft/world/entity/ExperienceOrb.java
@@ -278,11 +278,16 @@ public class ExperienceOrb extends Entity {
     }
     public static void awardWithDirection(final ServerLevel level, final Vec3 pos, final Vec3 roughDirection, int amount, org.bukkit.entity.ExperienceOrb.@Nullable SpawnReason reason, final @Nullable Entity triggerId, final @Nullable Entity sourceId) {
     // Paper end - add reason to orbs
+        final var leavesXExperienceTrace = org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.capture(level, pos);
         while (amount > 0) {
             int newCount = getExperienceValue(amount);
             amount -= newCount;
             if (!tryMergeToExisting(level, pos, newCount)) {
-                level.addFreshEntity(new ExperienceOrb(level, pos, roughDirection, newCount, reason, triggerId, sourceId)); // Paper - add reason to orbs
+                final ExperienceOrb orb = new ExperienceOrb(level, pos, roughDirection, newCount, reason, triggerId, sourceId);
+                final boolean added = level.addFreshEntity(orb); // Paper - add reason to orbs
+                org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.awarded(leavesXExperienceTrace, sourceId, newCount, orb, added);
+            } else {
+                org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.awarded(leavesXExperienceTrace, sourceId, newCount, null, true);
             }
         }
     }
@@ -395,15 +400,23 @@ public class ExperienceOrb extends Entity {
     @Override
     public void playerTouch(final Player player) {
         if (player instanceof ServerPlayer serverPlayer) {
-            if (player.takeXpDelay == 0 && new com.destroystokyo.paper.event.player.PlayerPickupExperienceEvent(serverPlayer.getBukkitEntity(), (org.bukkit.entity.ExperienceOrb) this.getBukkitEntity()).callEvent()) { // Paper - PlayerPickupExperienceEvent
+            if (player.takeXpDelay == 0) {
+                if (!new com.destroystokyo.paper.event.player.PlayerPickupExperienceEvent(serverPlayer.getBukkitEntity(), (org.bukkit.entity.ExperienceOrb) this.getBukkitEntity()).callEvent()) {
+                    org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.pickupCancelled(this);
+                    return;
+                }
                 if (org.leavesmc.leaves.LeavesConfig.modify.fastAbsorbPredicate.test(serverPlayer)) {
                     player.takeXpDelay = org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerXpCooldownEvent(player, 0, org.bukkit.event.player.PlayerExpCooldownChangeEvent.ChangeReason.PICKUP_ORB).getNewCooldown(); // CraftBukkit - entity.takeXpDelay = 2;
                     while (this.count > 0) {
                         player.take(this, 1);
-                        int i = this.repairPlayerItems(serverPlayer, this.getValue());
+                        final int beforeMending = this.getValue();
+                        int i = this.repairPlayerItems(serverPlayer, beforeMending);
+                        int granted = 0;
                         if (i > 0) {
-                            player.giveExperiencePoints(org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerExpChangeEvent(player, this, i).getAmount()); // CraftBukkit - this.value -> event.getAmount() // Paper - supply experience orb object
+                            granted = org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerExpChangeEvent(player, this, i).getAmount();
+                            player.giveExperiencePoints(granted);
                         }
+                        org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.pickedUp(this, player, beforeMending, i, granted);
                         this.count--;
                     }
                     this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.PICKUP); // CraftBukkit - add Bukkit remove cause
@@ -412,10 +425,14 @@ public class ExperienceOrb extends Entity {
 
                 player.takeXpDelay = org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerXpCooldownEvent(player, 2, org.bukkit.event.player.PlayerExpCooldownChangeEvent.ChangeReason.PICKUP_ORB).getNewCooldown(); // CraftBukkit - entity.takeXpDelay = 2;
                 player.take(this, 1);
-                int remaining = this.repairPlayerItems(serverPlayer, this.getValue());
+                final int beforeMending = this.getValue();
+                int remaining = this.repairPlayerItems(serverPlayer, beforeMending);
+                int granted = 0;
                 if (remaining > 0) {
-                    player.giveExperiencePoints(org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerExpChangeEvent(player, this, remaining).getAmount()); // CraftBukkit - remaining -> event.getAmount() // Paper - supply experience orb
+                    granted = org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerExpChangeEvent(player, this, remaining).getAmount();
+                    player.giveExperiencePoints(granted);
                 }
+                org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.pickedUp(this, player, beforeMending, remaining, granted);
 
                 this.count--;
                 if (this.count == 0) {
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 01c50a50..c439d2cd 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1958,6 +1958,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         this.postDeathEventTasks.add(() -> {
             // Leaves - the catalyst may consume experience during ENTITY_DIE before deferred drops run.
             if (!this.wasExperienceConsumed()) {
+                org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.beforeDrop(this);
                 this.dropExperience(level, source.getEntity());
             }
         }); // Paper
-- 
