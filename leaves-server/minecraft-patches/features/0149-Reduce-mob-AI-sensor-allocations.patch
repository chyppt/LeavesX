Subject: [PATCH] Reduce mob AI sensor allocations


diff --git a/net/minecraft/world/entity/ai/behavior/GateBehavior.java b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
index 3adfb334..8104fffc 100644
--- a/net/minecraft/world/entity/ai/behavior/GateBehavior.java
+++ b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
@@ -85,9 +85,24 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
             }
         }
         // Paper end - Perf: Remove streams from hot code
-        if (this.behaviors.stream().noneMatch(behavior -> behavior.getStatus() == Behavior.Status.RUNNING)) {
+        // LeavesX start - avoid a stream pipeline in the per-entity behavior gate
+        final boolean hasRunningBehavior;
+        if (org.leavesx.leavesx.config.LeavesXRuntime.aiOptimizations()) {
+            boolean found = false;
+            for (final BehaviorControl<? super E> behavior : this.behaviors) {
+                if (behavior.getStatus() == Behavior.Status.RUNNING) {
+                    found = true;
+                    break;
+                }
+            }
+            hasRunningBehavior = found;
+        } else {
+            hasRunningBehavior = this.behaviors.stream().anyMatch(behavior -> behavior.getStatus() == Behavior.Status.RUNNING);
+        }
+        if (!hasRunningBehavior) {
             this.doStop(level, body, timestamp);
         }
+        // LeavesX end - avoid a stream pipeline in the per-entity behavior gate
     }
 
     @Override
