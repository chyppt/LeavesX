+            }
+        }
+        return this.getSignalStrength(level, pos, getEntities(level, searchBox, entityClass));
+    }
+
+    private int getSignalStrength(final Level level, final BlockPos pos, final java.util.List<? extends Entity> entities) {
         // CraftBukkit start - Call interact event when turning on a pressure plate
-        for (Entity entity : getEntities(level, PressurePlateBlock.TOUCH_AABB.move(pos), entityClass)) {
+        for (final Entity entity : entities) {
             if (this.getSignalForState(level.getBlockState(pos)) == 0) {
                 org.bukkit.event.Cancellable cancellable;
 
