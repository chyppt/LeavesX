From 28640ea2c147fecad470a7fe436257511ea28b0d Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Date: Sat, 3 Oct 2026 01:00:00 +0800
Subject: [PATCH] Observe experience orb visibility and lifetime

---
 net/minecraft/server/level/ChunkMap.java      | 2 ++
 net/minecraft/server/level/ServerEntity.java  | 1 +
 net/minecraft/server/level/ServerLevel.java   | 1 +
 net/minecraft/world/entity/Entity.java        | 3 +++
 net/minecraft/world/entity/ExperienceOrb.java | 1 +
 5 files changed, 8 insertions(+)

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index dd8cf6af..753a9c4f 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1683,6 +1683,8 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                         }
 
                         ChunkMap.this.level.debugSynchronizers().startTrackingEntity(player, this.entity);
+                        } else {
+                            org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.trackingCancelled(this.entity, player);
                         }
                         // Paper end - entity tracking events
                         this.serverEntity.onPlayerAdd(); // Paper - fix desync when a player is added to the tracker
diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
index 8467b035..4ac392d6 100644
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -355,6 +355,7 @@ public class ServerEntity {
         List<Packet<? super ClientGamePacketListener>> packets = new ArrayList<>();
         this.sendPairingData(player, packets::add);
         player.connection.send(new ClientboundBundlePacket(packets));
+        org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.pairingSubmitted(this.entity, player, packets);
         this.entity.startSeenByPlayer(player);
     }
 
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 35c169cd..a6626315 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -975,6 +975,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
         this.debugSynchronizers.tick(this.server.debugSubscribers());
         profiler.pop();
+        org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.sampleWorld(this);
     }
 
     @Override
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index c1148679..07ad3123 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -5286,6 +5286,9 @@ public abstract class Entity
         if (this.removalReason == null) {
             this.removalReason = reason;
             this.removeEventCause = cause; // Paper
+            if (this instanceof ExperienceOrb orb) {
+                org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.removed(orb, reason, cause);
+            }
         }
 
         if (this.removalReason.shouldDestroy()) {
diff --git a/net/minecraft/world/entity/ExperienceOrb.java b/net/minecraft/world/entity/ExperienceOrb.java
index e178bb73..a6fdf16f 100644
--- a/net/minecraft/world/entity/ExperienceOrb.java
+++ b/net/minecraft/world/entity/ExperienceOrb.java
@@ -399,6 +399,7 @@ public class ExperienceOrb extends Entity {
 
     @Override
     public void playerTouch(final Player player) {
+        org.leavesx.leavesx.diagnostics.ExperienceDiagnostics.touched(this, player);
         if (player instanceof ServerPlayer serverPlayer) {
             if (player.takeXpDelay == 0) {
                 if (!new com.destroystokyo.paper.event.player.PlayerPickupExperienceEvent(serverPlayer.getBukkitEntity(), (org.bukkit.entity.ExperienceOrb) this.getBukkitEntity()).callEvent()) {
-- 
