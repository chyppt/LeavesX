Subject: [PATCH] Random flatten triangular distribution

This patch is Powered by Carpet-TIS-Addition(https://github.com/plusls/Carpet-TIS-Addition)

diff --git a/net/minecraft/util/RandomSource.java b/net/minecraft/util/RandomSource.java
index 664c1b30..2b78e411 100644
--- a/net/minecraft/util/RandomSource.java
+++ b/net/minecraft/util/RandomSource.java
@@ -56,13 +56,25 @@ public interface RandomSource {
 
     double nextGaussian();
 
-    default double triangle(final double mean, final double spread) {
-        return mean + spread * (this.nextDouble() - this.nextDouble());
+    // Leaves start - flattenTriangularDistribution
+    default double triangle(double mean, double spread) {
+        if (org.leavesmc.leaves.LeavesConfig.modify.flattenTriangularDistribution) {
+            this.nextDouble();
+            return mean + spread * (-1 + this.nextDouble() * 2);
+        } else {
+            return mean + spread * (this.nextDouble() - this.nextDouble());
+        }
     }
 
-    default float triangle(final float mean, final float spread) {
-        return mean + spread * (this.nextFloat() - this.nextFloat());
+    default float triangle(float mean, float spread) {
+        if (org.leavesmc.leaves.LeavesConfig.modify.flattenTriangularDistribution) {
+            this.nextFloat();
+            return mean + spread * (-1 + this.nextFloat() * 2);
+        } else {
+            return mean + spread * (this.nextFloat() - this.nextFloat());
+        }
     }
+    // Leaves end - flattenTriangularDistribution
 
     default void consumeCount(final int rounds) {
         for (int i = 0; i < rounds; i++) {
