From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Mon, 17 Aug 2026 09:27:05 +0800
Subject: [PATCH] Optimize block entity type validation for beta108


diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 115bda02..7e69b54a 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -239,6 +239,12 @@ public class Brain<E extends LivingEntity> {
         return this.getMemorySlot(type).value();
     }
 
+    /** Returns null when the memory is unregistered or empty, matching {@link #isMemoryValue} lookup semantics. */
+    public <U> @Nullable U leavesX$getMemoryValueIfRegistered(final MemoryModuleType<U> type) {
+        final MemorySlot<U> slot = this.getMemorySlotIfPresent(type);
+        return slot == null ? null : slot.value();
+    }
+
     public <U> @Nullable Optional<U> getMemoryInternal(final MemoryModuleType<U> type) {
         MemorySlot<U> slot = this.getMemorySlotIfPresent(type);
         return slot == null ? null : Optional.ofNullable(slot.value());
diff --git a/net/minecraft/world/entity/ai/sensing/PlayerSensor.java b/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
index 1b9ad07d..63a5eb93 100644
--- a/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
@@ -55,7 +55,7 @@ public class PlayerSensor extends Sensor<LivingEntity> {
         }
         brain.setMemory(MemoryModuleType.NEAREST_PLAYERS, players);
         final LivingEntity attackTarget = optimizeAllocations
-            ? brain.leavesX$getMemoryValue(MemoryModuleType.ATTACK_TARGET)
+            ? brain.leavesX$getMemoryValueIfRegistered(MemoryModuleType.ATTACK_TARGET)
             : null;
         final List<Player> visiblePlayers;
         if (optimizeAllocations) {
diff --git a/net/minecraft/world/level/block/Block.java b/net/minecraft/world/level/block/Block.java
index bdb42ce6..a427a467 100644
--- a/net/minecraft/world/level/block/Block.java
+++ b/net/minecraft/world/level/block/Block.java
@@ -57,6 +57,7 @@ import net.minecraft.world.level.LevelAccessor;
 import net.minecraft.world.level.LevelReader;
 import net.minecraft.world.level.biome.Biome;
 import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.entity.BlockEntityType;
 import net.minecraft.world.level.block.state.BlockBehaviour;
 import net.minecraft.world.level.block.state.BlockState;
 import net.minecraft.world.level.block.state.StateDefinition;
@@ -112,6 +113,9 @@ public class Block extends BlockBehaviour implements ItemLike {
     public static final int UPDATE_LIMIT = 512;
     protected final StateDefinition<Block, BlockState> stateDefinition;
     private BlockState defaultBlockState;
+    // LeavesX - cache the common one-type mapping while marking duplicate mappings for an exact fallback.
+    public @Nullable BlockEntityType<?> leavesX$blockEntityType;
+    public boolean leavesX$multipleBlockEntityTypes;
     // Paper start - Protect Bedrock and End Portal/Frames from being destroyed
     public final boolean isDestroyable() {
         return io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.allowPermanentBlockBreakExploits ||
diff --git a/net/minecraft/world/level/block/entity/BlockEntityType.java b/net/minecraft/world/level/block/entity/BlockEntityType.java
index 960dca72..546235eb 100644
--- a/net/minecraft/world/level/block/entity/BlockEntityType.java
+++ b/net/minecraft/world/level/block/entity/BlockEntityType.java
@@ -17,6 +17,15 @@ public class BlockEntityType<T extends BlockEntity> {
     public BlockEntityType(final BlockEntityType.BlockEntitySupplier<? extends T> factory, final Set<Block> validBlocks) {
         this.factory = factory;
         this.validBlocks = validBlocks;
+        // LeavesX - populate immutable registry metadata once instead of hashing the valid-block set on every check.
+        for (final Block validBlock : validBlocks) {
+            final BlockEntityType<?> cachedType = validBlock.leavesX$blockEntityType;
+            if (cachedType == null) {
+                validBlock.leavesX$blockEntityType = this;
+            } else if (cachedType != this) {
+                validBlock.leavesX$multipleBlockEntityTypes = true;
+            }
+        }
     }
 
     public T create(final BlockPos worldPosition, final BlockState blockState) {
@@ -24,7 +33,15 @@ public class BlockEntityType<T extends BlockEntity> {
     }
 
     public boolean isValid(final BlockState state) {
-        return org.leavesmc.leaves.LeavesConfig.modify.oldMC.updater.oldBlockRemoveBehaviour || this.validBlocks.contains(state.getBlock()); // Leaves - behaviour 1.21.1-
+        if (org.leavesmc.leaves.LeavesConfig.modify.oldMC.updater.oldBlockRemoveBehaviour) { // Leaves - behaviour 1.21.1-
+            return true;
+        }
+        final Block block = state.getBlock();
+        if (!org.leavesx.leavesx.config.LeavesXRuntime.blockEntityTypeValidationOptimization()
+            || block.leavesX$multipleBlockEntityTypes) {
+            return this.validBlocks.contains(block);
+        }
+        return block.leavesX$blockEntityType == this;
     }
 
     @Deprecated
