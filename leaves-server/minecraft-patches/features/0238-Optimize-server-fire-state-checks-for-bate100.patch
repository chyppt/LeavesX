From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Mon, 17 Aug 2026 06:31:00 +0800
Subject: [PATCH] Optimize server fire state checks for bate100


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index f27499d1..64549881 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -3710,7 +3710,12 @@ public abstract class Entity
     }
 
     public boolean isOnFire() {
-        boolean isClientSide = this.level() != null && this.level().isClientSide();
+        final Level currentLevel = this.level();
+        if (org.leavesx.leavesx.config.LeavesXRuntime.serverFireStateOptimization()
+            && (currentLevel == null || !currentLevel.isClientSide())) {
+            return this.remainingFireTicks > 0 && !this.fireImmune();
+        }
+        boolean isClientSide = currentLevel != null && currentLevel.isClientSide();
         return !this.fireImmune() && (this.remainingFireTicks > 0 || isClientSide && this.getSharedFlag(FLAG_ONFIRE));
     }
 
