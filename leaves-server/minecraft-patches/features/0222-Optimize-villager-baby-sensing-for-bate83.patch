@@ -1,5 +1,6 @@
 package net.minecraft.world.entity.ai.sensing;
 
+import com.google.common.collect.ImmutableList;
 import com.google.common.collect.ImmutableSet;
 import java.util.List;
 import java.util.Set;
@@ -24,8 +25,18 @@ public class VillagerBabiesSensor extends Sensor<LivingEntity> {
     }
 
     private List<LivingEntity> getNearestVillagerBabies(final LivingEntity myBody) {
-        // LeavesX - retain vanilla order and visibility checks without Guava's filtered-iterable wrapper.
-        return this.getVisibleEntities(myBody).findAllToList(IS_VILLAGER_BABY);
+        if (org.leavesx.leavesx.config.LeavesXRuntime.villagerBabiesSensorOptimization()) {
+            final NearestVisibleLivingEntities visibleEntities = myBody.getBrain().leavesX$getMemoryValue(
+                MemoryModuleType.NEAREST_VISIBLE_LIVING_ENTITIES
+            );
+            return visibleEntities == null ? List.of() : visibleEntities.findAllToList(IS_VILLAGER_BABY);
+        }
+
+        return ImmutableList.copyOf(this.getVisibleEntities(myBody).findAll(this::isVillagerBaby));
+    }
+
+    private boolean isVillagerBaby(final LivingEntity entity) {
+        return entity.is(EntityType.VILLAGER) && entity.isBaby();
     }
 
     private NearestVisibleLivingEntities getVisibleEntities(final LivingEntity myBody) {
