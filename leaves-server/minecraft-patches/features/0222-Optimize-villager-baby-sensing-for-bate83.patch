From: LeavesX Build <build@leavesx.local>
Date: Mon, 17 Aug 2026 01:53:51 +0800
Subject: [PATCH] Optimize villager baby sensing for bate83


diff --git a/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java b/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java
index 618f60bb..57dc90db 100644
--- a/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java
@@ -1,5 +1,6 @@
 package net.minecraft.world.entity.ai.sensing;
 
+import com.google.common.collect.ImmutableList;
 import com.google.common.collect.ImmutableSet;
 import java.util.List;
 import java.util.Set;
@@ -24,6 +25,12 @@ public class VillagerBabiesSensor extends Sensor<LivingEntity> {
     }
 
     private List<LivingEntity> getNearestVillagerBabies(final LivingEntity myBody) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.villagerBabiesSensorOptimization()) {
+            final NearestVisibleLivingEntities visibleEntities = myBody.getBrain().leavesX$getMemoryValue(
+                MemoryModuleType.NEAREST_VISIBLE_LIVING_ENTITIES
+            );
+            return visibleEntities == null ? List.of() : visibleEntities.findAllToList(IS_VILLAGER_BABY);
+        }
         if (org.leavesx.leavesx.config.LeavesXRuntime.aiOptimizations()) {
             return this.getVisibleEntities(myBody).findAllToList(entity -> entity.is(EntityTypes.VILLAGER) && entity.isBaby());
         }
