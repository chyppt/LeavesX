+    private static boolean playerIsCloseEnoughForSpawningFast(
+        final ServerPlayer player, final double chunkCenterX, final double chunkCenterZ, final double range
+    ) {
+        if (player.isSpectator()) {
+            return false;
+        }
+
+        final double deltaX = chunkCenterX - player.getX();
+        final double deltaZ = chunkCenterZ - player.getZ();
+        return deltaX * deltaX + deltaZ * deltaZ < range;
+    }
+
