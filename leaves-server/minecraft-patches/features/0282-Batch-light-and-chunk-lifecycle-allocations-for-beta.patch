diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index 6e79eaca..0976e16b 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -74,6 +74,13 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
     private final @Nullable ChunkAccess[] lastChunk = new ChunkAccess[4];
     private final List<LevelChunk> spawningChunks = new ObjectArrayList<>();
     private final Set<ChunkHolder> chunkHoldersToBroadcast = new ReferenceOpenHashSet<>();
+    // Starlight can publish many section notifications during one light pass. Keep those notifications in a
+    // primitive double buffer and submit one main-thread drain instead of one Runnable per section.
+    private final Object leavesX$lightUpdateLock = new Object();
+    private LeavesXLightUpdateBuffer leavesX$pendingLightUpdates = new LeavesXLightUpdateBuffer();
+    private LeavesXLightUpdateBuffer leavesX$drainLightUpdates = new LeavesXLightUpdateBuffer();
+    private boolean leavesX$lightDrainScheduled;
+    private final Runnable leavesX$lightDrainTask = this::leavesX$drainLightUpdateBatch;
     @VisibleForDebug
     private NaturalSpawner.@Nullable SpawnState lastSpawnState;
     // Paper start
@@ -706,25 +713,98 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
 
     @Override
     public void onLightUpdate(final LightLayer layer, final SectionPos pos) {
-        this.mainThreadProcessor.execute(() -> {
-            ChunkHolder chunk = this.getVisibleChunkIfPresent(pos.chunk().pack());
-            if (chunk != null && chunk.sectionLightChanged(layer, pos.y())) {
-                this.chunkHoldersToBroadcast.add(chunk);
-            }
-        });
+        this.leavesX$enqueueLightUpdate(layer, pos.asLong());
     }
 
     /** Handles the light-worker callback without constructing a SectionPos on the worker thread. */
     @Override
     public void onLightUpdate(final LightLayer layer, final long sectionNode) {
-        final long chunkKey = ChunkPos.pack(SectionPos.x(sectionNode), SectionPos.z(sectionNode));
-        final int sectionY = SectionPos.y(sectionNode);
-        this.mainThreadProcessor.execute(() -> {
+        this.leavesX$enqueueLightUpdate(layer, sectionNode);
+    }
+
+    private void leavesX$enqueueLightUpdate(final LightLayer layer, final long sectionNode) {
+        if (!org.leavesx.leavesx.config.LeavesXRuntime.lightUpdateNotificationBatchingOptimization()) {
+            final long chunkKey = ChunkPos.pack(SectionPos.x(sectionNode), SectionPos.z(sectionNode));
+            final int sectionY = SectionPos.y(sectionNode);
+            this.mainThreadProcessor.execute(() -> {
+                final ChunkHolder chunk = this.getVisibleChunkIfPresent(chunkKey);
+                if (chunk != null && chunk.sectionLightChanged(layer, sectionY)) {
+                    this.chunkHoldersToBroadcast.add(chunk);
+                }
+            });
+            return;
+        }
+
+        final boolean submitDrain;
+        synchronized (this.leavesX$lightUpdateLock) {
+            this.leavesX$pendingLightUpdates.add(layer == LightLayer.SKY, sectionNode);
+            submitDrain = !this.leavesX$lightDrainScheduled;
+            this.leavesX$lightDrainScheduled = true;
+        }
+        if (submitDrain) {
+            this.mainThreadProcessor.execute(this.leavesX$lightDrainTask);
+        }
+    }
+
+    private void leavesX$drainLightUpdateBatch() {
+        final LeavesXLightUpdateBuffer batch;
+        synchronized (this.leavesX$lightUpdateLock) {
+            if (this.leavesX$pendingLightUpdates.isEmpty()) {
+                this.leavesX$lightDrainScheduled = false;
+                return;
+            }
+            batch = this.leavesX$pendingLightUpdates;
+            this.leavesX$pendingLightUpdates = this.leavesX$drainLightUpdates;
+            this.leavesX$drainLightUpdates = batch;
+        }
+
+        for (int index = 0; index < batch.size; ++index) {
+            final long sectionNode = batch.sectionNodes[index];
+            final long chunkKey = ChunkPos.pack(SectionPos.x(sectionNode), SectionPos.z(sectionNode));
             final ChunkHolder chunk = this.getVisibleChunkIfPresent(chunkKey);
-            if (chunk != null && chunk.sectionLightChanged(layer, sectionY)) {
+            final LightLayer layer = batch.skyLight[index] ? LightLayer.SKY : LightLayer.BLOCK;
+            if (chunk != null && chunk.sectionLightChanged(layer, SectionPos.y(sectionNode))) {
                 this.chunkHoldersToBroadcast.add(chunk);
             }
-        });
+        }
+        batch.clear();
+
+        synchronized (this.leavesX$lightUpdateLock) {
+            if (this.leavesX$pendingLightUpdates.isEmpty()) {
+                this.leavesX$lightDrainScheduled = false;
+                return;
+            }
+        }
+        // Keep one task per captured batch. New notifications remain ordered behind other main-thread work already
+        // queued after this task instead of being drained in an unbounded loop.
+        this.mainThreadProcessor.execute(this.leavesX$lightDrainTask);
+    }
+
+    /** Reusable primitive storage for one world light-update batch. Only the main thread drains a detached buffer. */
+    private static final class LeavesXLightUpdateBuffer {
+
+        private static final int INITIAL_CAPACITY = 1024;
+        private long[] sectionNodes = new long[INITIAL_CAPACITY];
+        private boolean[] skyLight = new boolean[INITIAL_CAPACITY];
+        private int size;
+
+        private void add(final boolean sky, final long sectionNode) {
+            if (this.size == this.sectionNodes.length) {
+                final int nextCapacity = this.sectionNodes.length + (this.sectionNodes.length >> 1);
+                this.sectionNodes = Arrays.copyOf(this.sectionNodes, nextCapacity);
+                this.skyLight = Arrays.copyOf(this.skyLight, nextCapacity);
+            }
+            this.sectionNodes[this.size] = sectionNode;
+            this.skyLight[this.size++] = sky;
+        }
+
+        private boolean isEmpty() {
+            return this.size == 0;
+        }
+
+        private void clear() {
+            this.size = 0;
+        }
     }
 
     public boolean hasActiveTickets() {
