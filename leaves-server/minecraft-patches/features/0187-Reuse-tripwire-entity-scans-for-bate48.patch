+    /** Reusable full-query storage with an isolated fallback for nested scans on the same thread. */
+    public static final class LeavesXEntityQueryBuffer implements AutoCloseable {
+
+        private final List<Entity> results = new java.util.ArrayList<>();
+        private final boolean pooled;
+        private boolean inUse;
+
+        private LeavesXEntityQueryBuffer(final boolean pooled) {
+            this.pooled = pooled;
+        }
+
+        private boolean acquire() {
+            if (this.inUse) {
+                return false;
+            }
+            this.inUse = true;
+            this.results.clear();
+            return true;
+        }
+
+        public List<Entity> query(
+            final Level level,
+            final @Nullable Entity except,
+            final AABB boundingBox,
+            final Predicate<? super Entity> predicate
+        ) {
+            this.results.clear();
+            level.leavesX$getEntities(except, boundingBox, predicate, this.results);
+            return this.results;
+        }
+
+        @Override
+        public void close() {
+            this.results.clear();
+            if (this.pooled) {
+                this.inUse = false;
+            }
+        }
+    }
+
     @Override
     public long nextSubTickCount() {
         return this.subTickCount++;
