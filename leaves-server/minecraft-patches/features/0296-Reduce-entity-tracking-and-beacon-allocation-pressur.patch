+    /**
+     * Applies the immutable distance bound before testing held items and visibility.
+     *
+     * <p>The generic nearest-entity helper intentionally evaluates its predicate first. TemptGoal's selector is
+     * substantially more expensive than squared distance and has no observable side effects, so a player that is
+     * already outside the configured range or farther than a valid candidate cannot affect the result.</p>
+     */
+    private @Nullable Player leavesX$findNearestTemptingPlayer(final ServerLevel level, final double range) {
+        final List<? extends Player> players = level.players();
+        final double mobX = this.mob.getX();
+        final double mobY = this.mob.getY();
+        final double mobZ = this.mob.getZ();
+        // TargetingConditions keeps a two-block visibility floor even when an attribute supplies a smaller range.
+        final double maximumVisibilityDistance = Math.max(range, 2.0D);
+        final double maximumDistance = maximumVisibilityDistance * maximumVisibilityDistance;
+        double bestDistance = -1.0D;
+        Player nearest = null;
+
+        for (int index = 0, size = players.size(); index < size; index++) {
+            final Player candidate = players.get(index);
+            final double distance = candidate.distanceToSqr(mobX, mobY, mobZ);
+            if (distance > maximumDistance || bestDistance >= 0.0D && distance >= bestDistance) {
+                continue;
+            }
+            if (this.targetingConditions.test(level, this.mob, candidate)) {
+                bestDistance = distance;
+                nearest = candidate;
+            }
+        }
+        return nearest;
+    }
+
     private boolean shouldFollow(final LivingEntity player) {
         return this.items.test(player.getMainHandItem()) || this.items.test(player.getOffhandItem());
     }
