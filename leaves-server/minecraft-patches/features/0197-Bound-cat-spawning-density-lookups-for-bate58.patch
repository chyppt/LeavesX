 import net.minecraft.world.phys.AABB;
 
 public class CatSpawner implements CustomSpawner {
     private static final int TICK_DELAY = 1200;
+    private static final int VILLAGE_RADIUS = 48;
+    private static final int REQUIRED_OCCUPIED_HOMES = 5;
+    private static final int VILLAGE_CAT_LIMIT = 5;
+    private static final int HUT_RADIUS = 16;
     private int nextTick;
 
     @Override
@@ -45,19 +53,42 @@ public class CatSpawner implements CustomSpawner {
     }
 
     private void spawnInVillage(final ServerLevel serverLevel, final BlockPos spawnPos) {
-        int radius = 48;
-        if (serverLevel.getPoiManager().getCountInRange(p -> p.is(PoiTypes.HOME), spawnPos, 48, PoiManager.Occupancy.IS_OCCUPIED) > 4L) {
-            List<Cat> cats = serverLevel.getEntitiesOfClass(Cat.class, new AABB(spawnPos).inflate(48.0, 8.0, 48.0));
-            if (cats.size() < 5) {
+        final boolean enoughOccupiedHomes = org.leavesx.leavesx.config.LeavesXRuntime.mobSpawningOptimizations()
+            ? serverLevel.getPoiManager().leavesX$hasAtLeastInRange(
+                poi -> poi.is(PoiTypes.HOME), spawnPos, VILLAGE_RADIUS, PoiManager.Occupancy.IS_OCCUPIED, REQUIRED_OCCUPIED_HOMES
+            )
+            : serverLevel.getPoiManager()
+                .getCountInRange(poi -> poi.is(PoiTypes.HOME), spawnPos, VILLAGE_RADIUS, PoiManager.Occupancy.IS_OCCUPIED)
+                >= REQUIRED_OCCUPIED_HOMES;
+        if (enoughOccupiedHomes) {
+            final AABB catArea = new AABB(spawnPos).inflate(VILLAGE_RADIUS, 8.0, VILLAGE_RADIUS);
+            final int catCount;
+            if (org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()) {
+                try (Level.LeavesXEntityQueryBuffer scan = Level.leavesX$acquireEntityQueryBuffer()) {
+                    catCount = scan.countUpTo(
+                        serverLevel,
+                        EntityTypeTest.forClass(Cat.class),
+                        catArea,
+                        EntitySelector.NO_SPECTATORS,
+                        VILLAGE_CAT_LIMIT
+                    );
+                }
+            } else {
+                List<Cat> cats = serverLevel.getEntitiesOfClass(Cat.class, catArea);
+                catCount = cats.size();
+            }
+            if (catCount < VILLAGE_CAT_LIMIT) {
                 this.spawnCat(spawnPos, serverLevel, false);
             }
         }
     }
 
     private void spawnInHut(final ServerLevel level, final BlockPos spawnPos) {
-        int radius = 16;
-        List<Cat> cats = level.getEntitiesOfClass(Cat.class, new AABB(spawnPos).inflate(16.0, 8.0, 16.0));
-        if (cats.isEmpty()) {
+        final AABB catArea = new AABB(spawnPos).inflate(HUT_RADIUS, 8.0, HUT_RADIUS);
+        final boolean hasCat = org.leavesx.leavesx.config.LeavesXRuntime.entityQueryOptimizations()
+            ? level.leavesX$hasEntityOfClass(Cat.class, catArea)
+            : !level.getEntitiesOfClass(Cat.class, catArea).isEmpty();
+        if (!hasCat) {
             this.spawnCat(spawnPos, level, true);
         }
     }
