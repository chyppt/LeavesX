+        private LeavesXTrackerSnapshot leavesX$createTrackerSnapshot(
+            final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.TrackedChunk chunk
+        ) {
+            if (chunk == null) {
+                return LeavesXTrackerSnapshot.empty(this, this.entity, null, -1L);
