+            final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> playerList =
+                chunk.getPlayers(ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.VIEW_DISTANCE);
+            if (playerList == null || playerList.size() == 0) {
+                return LeavesXTrackerSnapshot.empty(this, this.entity, chunk, chunk.getUpdateCount());
+            }
+
+            final int count = playerList.size();
