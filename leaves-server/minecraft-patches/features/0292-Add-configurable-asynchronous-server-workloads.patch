+                final ServerPlayer player = snapshot.players[index];
+                if (player != this.entity) {
+                    this.leavesX$commitPlayerVisibility(player, snapshot.inRange[index]);
+                }
+            }
+            if (previousUpdate != snapshot.chunkUpdate || previousChunk != snapshot.chunk) {
+                for (final ServerPlayerConnection connection : new java.util.ArrayList<>(this.seenBy)) {
+                    final ServerPlayer player = connection.getPlayer();
+                    if (!snapshot.containsPlayer(player)) {
+                        this.removePlayer(player);
+                    }
+                }
             }
         }
 
