+    /**
+     * Parallelizes primitive range checks, then commits every tracking mutation in the original entity order.
+     * Workers read only primitive fields captured in the snapshots; world, entity, player, connection, plugin, and
+     * mutable tracking state are touched only while preparing or committing on the tick thread.
+     */
+    private boolean leavesX$parallelTrackerTick(
+        final ca.spottedleaf.moonrise.common.list.ReferenceList<Entity> trackerEntities
+    ) {
+        final int entityCount = trackerEntities.size();
+        final Entity[] entities = trackerEntities.getRawDataUnchecked();
+        final LeavesXTrackerSnapshot[] snapshots = new LeavesXTrackerSnapshot[entityCount];
+        for (int index = 0; index < entityCount; index++) {
+            final Entity entity = entities[index];
+            final ChunkMap.TrackedEntity tracker =
+                ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity();
+            if (tracker != null) {
+                snapshots[index] = tracker.leavesX$createTrackerSnapshot(
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkData().nearbyPlayers
+                );
+            }
+        }
+
+        final int workers = Math.max(1, Math.min(4, Runtime.getRuntime().availableProcessors() / 4));
+        final int rangeSize = Math.max(64, (entityCount + workers - 1) / workers);
+        final java.util.ArrayList<java.util.concurrent.CompletableFuture<Void>> futures = new java.util.ArrayList<>(workers);
+        for (int start = 0; start < entityCount; start += rangeSize) {
+            final int from = start;
+            final int to = Math.min(entityCount, start + rangeSize);
+            futures.add(org.leavesx.leavesx.runtime.LeavesXAsyncRuntime.submitOrRun(
+                org.leavesx.leavesx.runtime.LeavesXAsyncRuntime.Workload.ENTITY_TRACKER,
+                () -> {
+                    for (int index = from; index < to; index++) {
+                        final LeavesXTrackerSnapshot snapshot = snapshots[index];
+                        if (snapshot != null) snapshot.computeRanges();
+                    }
+                }
+            ));
+        }
+
+        try {
+            java.util.concurrent.CompletableFuture.allOf(futures.toArray(java.util.concurrent.CompletableFuture[]::new)).join();
+        } catch (final Throwable failure) {
+            LOGGER.error("LeavesX async entity-tracker range computation failed; rerunning the full Moonrise tracker path", failure);
+            return false;
+        }
+
+        for (int index = 0; index < entityCount; index++) {
+            final LeavesXTrackerSnapshot snapshot = snapshots[index];
+            if (snapshot == null) {
+                continue;
+            }
+            final ChunkMap.TrackedEntity tracker = snapshot.tracker;
+            final Entity entity = snapshot.entity;
+            if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity() != tracker) {
+                continue;
+            }
+            tracker.leavesX$applyTrackerSnapshot(snapshot);
+            if (tracker.moonrise$hasPlayers()
+                || ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
+                tracker.serverEntity.sendChanges();
+            }
+        }
+        return true;
+    }
