+            final int chunkZ,
+            final LevelChunk chunk,
+            final ClientboundLevelChunkWithLightPacket packet
+        ) {
+            final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+            if (!this.sentChunks.add(chunkKey)) {
+                return;
+            }
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder holder =
+                ((ChunkSystemServerLevel)this.world).moonrise$getChunkTaskScheduler().chunkHolderManager
+                    .getChunkHolder(chunkX, chunkZ);
+            if (holder == null || holder.vanillaChunkHolder.getChunkToSend() != chunk) {
+                this.sentChunks.remove(chunkKey);
+                if (this.wantChunkSent(chunkX, chunkZ)) {
+                    this.sendQueue.enqueue(chunkKey);
+                }
+                return;
+            }
+            ((ChunkSystemChunkHolder)holder.vanillaChunkHolder).moonrise$addReceivedChunk(this.player);
+            PlatformHooks.get().onChunkWatch(this.world, chunk, this.player);
+            PlayerChunkSender.sendPreparedChunk(this.player.connection, this.world, chunk, packet);
+        }
