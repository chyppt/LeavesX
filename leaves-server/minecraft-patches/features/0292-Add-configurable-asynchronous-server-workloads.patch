+    private static final class LeavesXTrackerSnapshot {
+
+        private final ChunkMap.TrackedEntity tracker;
+        private final Entity entity;
+        private final double entityX;
+        private final double entityY;
+        private final double entityZ;
+        private final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.@Nullable TrackedChunk chunk;
+        private final long chunkUpdate;
+        private final ServerPlayer[] players;
+        private final double[] playerX;
+        private final double[] playerY;
+        private final double[] playerZ;
+        private final double[] horizontalRangeSquared;
+        private final double rangeY;
+        private final boolean[] inRange;
+
+        private LeavesXTrackerSnapshot(
+            final ChunkMap.TrackedEntity tracker,
+            final Entity entity,
+            final double entityX,
+            final double entityY,
+            final double entityZ,
+            final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.@Nullable TrackedChunk chunk,
+            final long chunkUpdate,
+            final ServerPlayer[] players,
+            final double[] playerX,
+            final double[] playerY,
+            final double[] playerZ,
+            final double[] horizontalRangeSquared,
+            final double rangeY
+        ) {
+            this.tracker = tracker;
+            this.entity = entity;
+            this.entityX = entityX;
+            this.entityY = entityY;
+            this.entityZ = entityZ;
+            this.chunk = chunk;
+            this.chunkUpdate = chunkUpdate;
+            this.players = players;
+            this.playerX = playerX;
+            this.playerY = playerY;
+            this.playerZ = playerZ;
+            this.horizontalRangeSquared = horizontalRangeSquared;
+            this.rangeY = rangeY;
+            this.inRange = new boolean[players.length];
+        }
+
+        private static LeavesXTrackerSnapshot empty(
+            final ChunkMap.TrackedEntity tracker,
+            final Entity entity,
+            final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.@Nullable TrackedChunk chunk,
+            final long chunkUpdate
+        ) {
+            return new LeavesXTrackerSnapshot(
+                tracker, entity, entity.getX(), entity.getY(), entity.getZ(), chunk, chunkUpdate,
+                new ServerPlayer[0], new double[0], new double[0], new double[0], new double[0], -1.0
+            );
+        }
+
+        private void computeRanges() {
+            for (int index = 0; index < this.players.length; index++) {
+                final double deltaX = this.playerX[index] - this.entityX;
+                final double deltaZ = this.playerZ[index] - this.entityZ;
+                boolean visible = deltaX * deltaX + deltaZ * deltaZ <= this.horizontalRangeSquared[index];
+                if (visible && this.rangeY >= 0.0) {
+                    final double deltaY = this.playerY[index] - this.entityY;
+                    visible = deltaY * deltaY <= this.rangeY * this.rangeY;
+                }
+                this.inRange[index] = visible;
+            }
+        }
+
+        private boolean containsPlayer(final ServerPlayer player) {
+            for (final ServerPlayer candidate : this.players) {
+                if (candidate == player) return true;
+            }
+            return false;
+        }
+    }
 }
