+        private boolean leavesX$scheduleAsyncChunk(final int chunkX, final int chunkZ, final LevelChunk chunk) {
+            if (this.leavesX$pendingAsyncChunkPackets.size() >= MAX_ASYNC_CHUNK_SENDS_PER_PLAYER) {
+                return false;
+            }
+            final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+            if (!this.leavesX$pendingAsyncChunkKeys.add(chunkKey)) {
+                return true;
+            }
+
+            final boolean shouldModify = this.world.chunkPacketBlockController.shouldModify(this.player, chunk);
+            final CompletableFuture<ClientboundLevelChunkWithLightPacket> packet =
+                org.leavesx.leavesx.runtime.LeavesXAsyncRuntime.submitValueOrRun(
+                    org.leavesx.leavesx.runtime.LeavesXAsyncRuntime.Workload.CHUNK_SEND,
+                    () -> PlayerChunkSender.prepareChunkPacket(this.world, chunk, shouldModify)
+                );
+            this.leavesX$pendingAsyncChunkPackets.addLast(new LeavesXAsyncChunkPacket(chunkKey, chunk, packet));
