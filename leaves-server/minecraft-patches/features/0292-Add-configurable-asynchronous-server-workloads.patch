+        private void leavesX$drainAsyncChunks() {
+            while (!this.leavesX$pendingAsyncChunkPackets.isEmpty()) {
+                final LeavesXAsyncChunkPacket pending = this.leavesX$pendingAsyncChunkPackets.peekFirst();
+                if (!pending.packet().isDone()) {
+                    return;
+                }
+                this.leavesX$pendingAsyncChunkPackets.removeFirst();
+                this.leavesX$pendingAsyncChunkKeys.remove(pending.chunkKey());
+
+                final int chunkX = CoordinateUtils.getChunkX(pending.chunkKey());
+                final int chunkZ = CoordinateUtils.getChunkZ(pending.chunkKey());
+                final LevelChunk current = ((ChunkSystemLevel)this.world).moonrise$getFullChunkIfLoaded(chunkX, chunkZ);
+                if (this.removed || !this.wantChunkSent(chunkX, chunkZ) || current != pending.chunk()) {
+                    if (!this.removed && this.wantChunkSent(chunkX, chunkZ) && current != null) {
+                        this.sendQueue.enqueue(pending.chunkKey());
+                    }
+                    continue;
+                }
+
+                final ClientboundLevelChunkWithLightPacket packet;
+                try {
+                    packet = pending.packet().join();
+                } catch (final Throwable failure) {
+                    LOGGER.error(
+                        "LeavesX async chunk packet preparation failed for player {} at [{}, {}]; rebuilding on the tick thread",
+                        this.player.getScoreboardName(),
+                        chunkX,
+                        chunkZ,
+                        failure
+                    );
+                    this.leavesX$sendPreparedChunk(chunkX, chunkZ, current,
+                        PlayerChunkSender.prepareChunkPacket(
+                            this.world,
+                            current,
+                            this.world.chunkPacketBlockController.shouldModify(this.player, current)
+                        ));
+                    continue;
+                }
+                this.leavesX$sendPreparedChunk(chunkX, chunkZ, current, packet);
+            }
+        }
