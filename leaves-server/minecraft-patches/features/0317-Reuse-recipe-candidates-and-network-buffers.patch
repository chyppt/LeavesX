-    // LeavesX beta9 fix start: special crafting recipes (tool repair, dyeing, book cloning, map
-    // extending, banner duplication, firework rockets/stars, decorated pots) accept flexible
-    // ingredient counts, so they cannot live in a single count bucket. The index now returns the
-    // count bucket MERGED with every unbucketed (special) recipe, both pre-sorted in registration
-    // order at build time, so "last match wins" stays identical to the vanilla scan. The caller
-    // in RecipeManager runs matches() over the merged stream exactly as it did over byType().
     public java.util.List<RecipeHolder<?>> leavesX$countBucketWithSpecials(final RecipeType<?> type, final int ingredientCount) {
-        final java.util.Map<CountKey, java.util.List<RecipeHolder<?>>> index = this.leavesX$countIndex();
-        final java.util.List<RecipeHolder<?>> bucket = index.get(new CountKey(type, ingredientCount));
-        final java.util.List<RecipeHolder<?>> specials = index.get(new CountKey(type, -1));
-        if (bucket == null) {
-            return specials == null ? java.util.List.of() : specials;
-        }
-        if (specials == null) {
-            return bucket;
-        }
-        // Both lists are pre-sorted by registration rank at build time; merge linearly.
+        final CountIndex index = this.leavesX$countIndex();
+        final var candidates = index.merged().get(new CountKey(type, ingredientCount));
+        return candidates != null ? candidates : index.exact().getOrDefault(new CountKey(type, -1), java.util.List.of());
+    }
