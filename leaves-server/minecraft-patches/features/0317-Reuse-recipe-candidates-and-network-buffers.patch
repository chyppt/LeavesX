+    private static java.util.List<RecipeHolder<?>> leavesX$mergeCandidates(
+        final java.util.List<RecipeHolder<?>> bucket,
+        final java.util.List<RecipeHolder<?>> specials,
+        final java.util.Map<RecipeHolder<?>, Integer> ranks
+    ) {
+        // 两个桶都按类型视图的遍历顺序构建；线性合并保持 Bukkit 最后匹配优先。
         final java.util.List<RecipeHolder<?>> merged = new java.util.ArrayList<>(bucket.size() + specials.size());
         int i = 0;
         int j = 0;
         while (i < bucket.size() && j < specials.size()) {
-            // Interleave by original registration order using a stable rank stored at build time;
-            // since both lists are individually sorted, take the smaller-ranked head first.
-            merged.add(rankOf(bucket.get(i)) <= rankOf(specials.get(j)) ? bucket.get(i++) : specials.get(j++));
+            merged.add(ranks.get(bucket.get(i)) <= ranks.get(specials.get(j)) ? bucket.get(i++) : specials.get(j++));
         }
         while (i < bucket.size()) {
             merged.add(bucket.get(i++));
@@ -178,12 +174,7 @@
         while (j < specials.size()) {
