diff --git a/net/minecraft/network/Utf8String.java b/net/minecraft/network/Utf8String.java
--- a/net/minecraft/network/Utf8String.java
+++ b/net/minecraft/network/Utf8String.java
@@ -37,6 +37,19 @@
             throw new EncoderException("String too big (was " + value.length() + " characters, max " + maxLength + ")");
         }
 
+        // 仅对不可变字符串预计算长度，防止可变 CharSequence 两次读取不一致。
+        if (value instanceof String string && org.leavesx.leavesx.config.LeavesXRuntime.networkBufferOptimizations()) {
+            final int encodedLength = ByteBufUtil.utf8Bytes(string);
+            final int maximumLength = ByteBufUtil.utf8MaxBytes(maxLength);
+            if (encodedLength > maximumLength) {
+                throw new EncoderException("String too big (was " + encodedLength + " bytes encoded, max " + maximumLength + ")");
+            }
+            output.ensureWritable(VarInt.getByteSize(encodedLength) + encodedLength);
+            VarInt.write(output, encodedLength);
+            ByteBufUtil.reserveAndWriteUtf8(output, string, encodedLength);
+            return;
+        }
+
         int maxEncodedValueLength = ByteBufUtil.utf8MaxBytes(value);
         ByteBuf tmp = output.alloc().buffer(maxEncodedValueLength);
 
diff --git a/net/minecraft/network/CompressionEncoder.java b/net/minecraft/network/CompressionEncoder.java
--- a/net/minecraft/network/CompressionEncoder.java
+++ b/net/minecraft/network/CompressionEncoder.java
@@ -40,6 +40,33 @@
             out.writeBytes(uncompressed);
         } else {
             if (this.deflater != null) { // Paper - Use Velocity cipher
+                if (org.leavesx.leavesx.config.LeavesXRuntime.networkBufferOptimizations()) {
+                    // 压缩在连接的事件循环内完成；借用输入缓冲区只持续到 finally 中的 reset。
+                    VarInt.write(out, uncompressedLength);
+                    try {
+                        if (uncompressed.hasArray()) {
+                            this.deflater.setInput(uncompressed.array(),
+                                uncompressed.arrayOffset() + uncompressed.readerIndex(), uncompressedLength);
+                        } else if (uncompressed.nioBufferCount() == 1) {
+                            this.deflater.setInput(uncompressed.nioBuffer(uncompressed.readerIndex(), uncompressedLength));
+                        } else {
+                            // 非连续缓冲区保持一次完整复制，不切片压缩以免改变压缩字节流。
+                            final byte[] input = new byte[uncompressedLength];
+                            uncompressed.getBytes(uncompressed.readerIndex(), input);
+                            this.deflater.setInput(input);
+                        }
+                        uncompressed.skipBytes(uncompressedLength);
+                        this.deflater.finish();
+                        while (!this.deflater.finished()) {
+                            final int written = this.deflater.deflate(this.encodeBuf);
+                            out.writeBytes(this.encodeBuf, 0, written);
+                        }
+                    } finally {
+                        // 编码异常也必须释放对输入的引用，不能带入下一包或持有池化缓冲区。
+                        this.deflater.reset();
+                    }
+                    return;
+                }
             byte[] input = new byte[uncompressedLength];
             uncompressed.readBytes(input);
             VarInt.write(out, input.length);
@@ -96,6 +123,9 @@
 
     @Override
     public void handlerRemoved(final ChannelHandlerContext ctx) {
+        if (this.deflater != null) {
+            this.deflater.end();
+        }
         if (this.compressor != null) {
             this.compressor.close();
         }
