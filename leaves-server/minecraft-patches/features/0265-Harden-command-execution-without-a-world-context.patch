+    /**
+     * Resolves command-chain limits even for sources created without a current world.
+     *
+     * <p>The console and function-loading paths can legitimately carry a null level. Runtime commands should still
+     * use the overworld rules, while early bootstrap falls back to vanilla feature defaults instead of failing before
+     * the command itself is dispatched.</p>
+     */
+    private static GameRules leavesX$getCommandGameRules(final CommandSourceStack context) {
+        final ServerLevel level = context.getLevel();
+        if (level != null) {
+            return level.getGameRules();
+        }
+
+        final MinecraftServer server = context.getServer();
+        if (server != null) {
+            final ServerLevel overworld = server.overworld();
+            if (overworld != null) {
+                return overworld.getGameRules();
+            }
+        }
+
+        return new GameRules(FeatureFlags.DEFAULT_FLAGS);
+    }
+
