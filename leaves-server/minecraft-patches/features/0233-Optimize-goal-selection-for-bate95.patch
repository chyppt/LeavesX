+    // LeavesX start - preserve Paper's replacement checks while avoiding repeated EnumMap lookups
+    private static boolean leavesX$goalCanBeReplacedForAllFlags(
+        final WrappedGoal goal,
+        long flagIterator,
+        final WrappedGoal[] lockedGoals
+    ) {
+        while (flagIterator != 0L) {
+            final int flagIndex = Long.numberOfTrailingZeros(flagIterator);
+            final WrappedGoal lockedGoal = lockedGoals[flagIndex];
+            if (!(lockedGoal == null ? NO_GOAL : lockedGoal).canBeReplacedBy(goal)) {
+                return false;
+            }
+            flagIterator ^= ca.spottedleaf.concurrentutil.util.IntegerUtil.getTrailingBit(flagIterator);
+        }
+        return true;
+    }
+    // LeavesX end - preserve Paper's replacement checks while avoiding repeated EnumMap lookups
