         final int completedPartitions = org.leavesx.leavesx.runtime.LeavesXComputeExecutor.invokeRangesWithCount(
             org.leavesx.leavesx.runtime.LeavesXComputeExecutor.Workload.MOB_SPAWN_COUNTING,
             inputs.size(),
