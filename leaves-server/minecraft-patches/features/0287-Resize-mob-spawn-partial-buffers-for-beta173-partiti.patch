+++ b/net/minecraft/world/level/MobSpawnCountAccumulator.java
@@ -34,7 +34,9 @@ final class MobSpawnCountAccumulator {
         }
 
         @SuppressWarnings("unchecked") final Long2ObjectOpenHashMap<int[]>[] partialCounts =
