+    private ObjectArrayList<BehaviorControl<? super E>> leavesX$getActiveBehaviorTraversal() {
+        final ObjectArrayList<Brain.BehaviorGroup<E>> behaviorGroups = this.leavesX$getBehaviorGroups();
+        // getActiveActivities() exposes the mutable set for debugging, so equality protects compatibility with
+        // external mutations that bypass setActiveActivity(). The set normally contains only CORE plus one activity.
+        if (!this.leavesXActiveBehaviorTraversalDirty && this.leavesXCachedActiveActivities.equals(this.activeActivities)) {
+            return this.leavesXActiveBehaviorTraversal;
+        }
+
+        this.leavesXActiveBehaviorTraversal.clear();
+        for (int groupIndex = 0, groupCount = behaviorGroups.size(); groupIndex < groupCount; groupIndex++) {
+            final Brain.BehaviorGroup<E> behaviorGroup = behaviorGroups.get(groupIndex);
+            if (this.activeActivities.contains(behaviorGroup.activity)) {
+                this.leavesXActiveBehaviorTraversal.addAll(behaviorGroup.behaviors);
+            }
+        }
+        this.leavesXCachedActiveActivities.clear();
+        this.leavesXCachedActiveActivities.addAll(this.activeActivities);
+        this.leavesXActiveBehaviorTraversalDirty = false;
+        return this.leavesXActiveBehaviorTraversal;
+    }
+
