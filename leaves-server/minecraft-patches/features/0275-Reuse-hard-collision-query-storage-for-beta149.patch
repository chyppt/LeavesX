+                entities = queryBuffer == null
+                    ? ((ChunkSystemEntityGetter)world).moonrise$getHardCollidingEntities(entity, aabb, predicate)
+                    : queryBuffer.queryHardColliding(world, entity, aabb, predicate);
+            }
 
-        for (int i = 0, len = entities.size(); i < len; ++i) {
