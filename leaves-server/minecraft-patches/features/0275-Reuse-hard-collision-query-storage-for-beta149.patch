+    /**
+     * Fills a caller-owned list with hard-colliding entities without changing the public query allocation contract.
+     * The caller must keep the list private until the collision calculation has completed.
+     */
+    public final void leavesX$getHardCollidingEntities(
+        final Entity entity,
+        final AABB box,
+        final Predicate<? super Entity> predicate,
+        final List<Entity> into
+    ) {
+        Profiler.get().incrementCounter("getEntities");
+        ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
+            .moonrise$getEntityLookup().getHardCollidingEntities(entity, box, into, predicate);
+    }
+
     @Override
     public LevelChunk moonrise$getFullChunkIfLoaded(final int chunkX, final int chunkZ) {
         return (LevelChunk)this.getChunkSource().getChunk(chunkX, chunkZ, ChunkStatus.FULL, false);
@@ -2444,6 +2459,18 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
             return this.results;
         }
 
+        /** Collects hard-colliding entities directly into the reusable storage. */
+        public List<Entity> queryHardColliding(
+            final Level level,
+            final @Nullable Entity except,
+            final AABB boundingBox,
+            final Predicate<? super Entity> predicate
+        ) {
+            this.results.clear();
+            level.leavesX$getHardCollidingEntities(except, boundingBox, predicate, this.results);
+            return this.results;
+        }
+
