@@ -16,7 +16,15 @@ public class RandomLookAroundGoal extends Goal {
 
     @Override
     public boolean canUse() {
-        return this.mob.getRandom().nextFloat() < 0.02F;
+        float chance = 0.02F;
+        if (org.leavesx.leavesx.config.LeavesXRuntime.animalIdleGoalThrottling()
+            && this.mob instanceof net.minecraft.world.entity.animal.Animal) {
+            chance = org.leavesx.leavesx.performance.AnimalIdleGoalPolicy.scaleChance(
+                chance,
+                org.leavesx.leavesx.config.LeavesXRuntime.animalIdleGoalIntervalMultiplier()
+            );
+        }
+        return this.mob.getRandom().nextFloat() < chance;
     }
 
     @Override
