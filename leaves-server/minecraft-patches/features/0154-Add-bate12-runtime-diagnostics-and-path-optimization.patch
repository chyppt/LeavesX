diff --git a/net/minecraft/world/level/pathfinder/PathFinder.java b/net/minecraft/world/level/pathfinder/PathFinder.java
index 253074a0..3ade59d4 100644
--- a/net/minecraft/world/level/pathfinder/PathFinder.java
+++ b/net/minecraft/world/level/pathfinder/PathFinder.java
@@ -137,13 +137,24 @@ public class PathFinder {
         // Paper start - Perf: remove streams and optimize collection
         Path best = null;
         boolean entryListIsEmpty = reachedTargets.isEmpty();
-        Comparator<Path> comparator = entryListIsEmpty
-            ? Comparator.comparingInt(Path::getNodeCount)
-            : Comparator.comparingDouble(Path::getDistToTarget).thenComparingInt(Path::getNodeCount);
-        for (Map.Entry<Target, BlockPos> entry : entryListIsEmpty ? targets : reachedTargets) {
-            Path path = this.reconstructPath(entry.getKey().getBestNode(), entry.getValue(), !entryListIsEmpty);
-            if (best == null || comparator.compare(path, best) < 0) {
-                best = path;
+        if (org.leavesx.leavesx.config.LeavesXRuntime.pathfindingOptimizations()) {
+            // LeavesX start - compare candidates directly and avoid allocating a comparator for every path search
+            for (Map.Entry<Target, BlockPos> entry : entryListIsEmpty ? targets : reachedTargets) {
+                Path path = this.reconstructPath(entry.getKey().getBestNode(), entry.getValue(), !entryListIsEmpty);
+                if (best == null || isBetterPath(path, best, entryListIsEmpty)) {
+                    best = path;
+                }
+            }
+            // LeavesX end - compare candidates directly and avoid allocating a comparator for every path search
+        } else {
+            Comparator<Path> comparator = entryListIsEmpty
+                ? Comparator.comparingInt(Path::getNodeCount)
+                : Comparator.comparingDouble(Path::getDistToTarget).thenComparingInt(Path::getNodeCount);
+            for (Map.Entry<Target, BlockPos> entry : entryListIsEmpty ? targets : reachedTargets) {
+                Path path = this.reconstructPath(entry.getKey().getBestNode(), entry.getValue(), !entryListIsEmpty);
+                if (best == null || comparator.compare(path, best) < 0) {
+                    best = path;
+                }
             }
         }
         profiler.pop();
@@ -162,6 +173,18 @@ public class PathFinder {
         return from.distanceTo(to);
     }
 
+    // LeavesX start - preserve Comparator ordering without constructing comparator objects
+    private static boolean isBetterPath(final Path candidate, final Path current, final boolean compareNodeCountOnly) {
+        if (!compareNodeCountOnly) {
+            final int distanceComparison = Double.compare(candidate.getDistToTarget(), current.getDistToTarget());
+            if (distanceComparison != 0) {
+                return distanceComparison < 0;
+            }
+        }
+        return candidate.getNodeCount() < current.getNodeCount();
+    }
+    // LeavesX end - preserve Comparator ordering without constructing comparator objects
+
     private float getBestH(final Node from, final List<Map.Entry<Target, BlockPos>> targets) { // Paper - Perf: remove streams and optimize collection; Set<Target> -> List<Map.Entry<Target, BlockPos>>
         float bestH = Float.MAX_VALUE;
 
@@ -178,6 +201,10 @@ public class PathFinder {
     }
 
     private Path reconstructPath(final Node closest, final BlockPos target, final boolean reached) {
+        if (org.leavesx.leavesx.config.LeavesXRuntime.pathfindingOptimizations()) {
+            // LeavesX - vanilla inserted at index zero repeatedly, making long path reconstruction quadratic
+            return new Path(org.leavesx.leavesx.performance.PathNodeListBuilder.build(closest), target, reached);
+        }
         List<Node> nodes = Lists.newArrayList();
         Node node = closest;
         nodes.add(0, node);
