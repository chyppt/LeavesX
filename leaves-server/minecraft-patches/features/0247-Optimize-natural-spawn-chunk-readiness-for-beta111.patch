From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Mon, 17 Aug 2026 12:15:12 +0800
Subject: [PATCH] Optimize natural spawn chunk readiness for beta111


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 95357091..103a9fff 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2798,6 +2798,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         // Paper end - rewrite chunk system
     }
 
+    /** Checks entity readiness from coordinates so natural spawning need not allocate a ChunkPos. */
+    public boolean canSpawnEntitiesInChunk(final int chunkX, final int chunkZ) {
+        final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder chunkHolder =
+            this.moonrise$getChunkTaskScheduler().chunkHolderManager.getChunkHolder(ChunkPos.pack(chunkX, chunkZ));
+        return chunkHolder != null && chunkHolder.isEntityTickingReady() && this.getWorldBorder().isChunkWithinBounds(chunkX, chunkZ);
+    }
+
     @Override
     public FeatureFlagSet enabledFeatures() {
         return this.server.getWorldData().enabledFeatures();
diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index 69449010..855ea17f 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -402,6 +402,9 @@ public final class NaturalSpawner {
             if (leavesX$isInChunk(candidateX, candidateZ, currentChunkPos)) {
                 return true;
             }
+            if (org.leavesx.leavesx.config.LeavesXRuntime.naturalSpawnChunkReadinessOptimization()) {
+                return level.canSpawnEntitiesInChunk(candidateX >> 4, candidateZ >> 4);
+            }
             return level.canSpawnEntitiesInChunk(new ChunkPos(candidateX >> 4, candidateZ >> 4));
         }
 
diff --git a/net/minecraft/world/level/border/WorldBorder.java b/net/minecraft/world/level/border/WorldBorder.java
index a211de15..1b25f271 100644
--- a/net/minecraft/world/level/border/WorldBorder.java
+++ b/net/minecraft/world/level/border/WorldBorder.java
@@ -59,6 +59,14 @@ public class WorldBorder extends SavedData {
         return this.isWithinBounds(pos.getMinBlockX(), pos.getMinBlockZ()) && this.isWithinBounds(pos.getMaxBlockX(), pos.getMaxBlockZ());
     }
 
+    /** Checks both corners of a chunk without allocating a ChunkPos wrapper. */
+    public boolean isChunkWithinBounds(final int chunkX, final int chunkZ) {
+        final int minBlockX = chunkX << 4;
+        final int minBlockZ = chunkZ << 4;
+        return this.isWithinBounds(minBlockX, minBlockZ)
+            && this.isWithinBounds(minBlockX + 15, minBlockZ + 15);
+    }
+
     // Paper start - Bound treasure maps to world border
     private final BlockPos.MutableBlockPos mutPos = new BlockPos.MutableBlockPos();
 
