+        private void updateObserverQueues(final long time) {
+            // Cover the complete view once per second. This discovers chunks loaded or released by other ticket
+            // sources without an O(view-area) scan on every tick.
+            final long[] scanOrder = ParallelSearchRadiusIteration.getEuclideanIteration(this.lastSendDistance + 1);
+            final int scanBudget = Math.min(
+                scanOrder.length,
+                Math.max(
+                    OBSERVER_MIN_SCAN_BUDGET,
+                    (scanOrder.length + OBSERVER_SCAN_TARGET_TICKS - 1) / OBSERVER_SCAN_TARGET_TICKS
+                )
+            );
+            for (int scanned = 0; scanned < scanBudget; ++scanned) {
+                if (this.observerScanCursor >= scanOrder.length) {
+                    this.observerScanCursor = 0;
+                }
+                final long delta = scanOrder[this.observerScanCursor++];
+                final int chunkX = this.lastChunkX + CoordinateUtils.getChunkX(delta);
+                final int chunkZ = this.lastChunkZ + CoordinateUtils.getChunkZ(delta);
+                if (!this.wantChunkSent(chunkX, chunkZ)) {
+                    continue;
+                }
+
+                final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+                if (this.getObserverChunkToSend(chunkX, chunkZ) == null) {
+                    this.sendUnloadChunk(chunkX, chunkZ);
+                    if (this.removed) {
+                        return;
+                    }
+                } else if (!this.sentChunks.contains(chunkKey) && this.observerPendingChunks.add(chunkKey)) {
+                    this.sendQueue.enqueue(chunkKey);
+                }
+            }
+
+            this.chunkSendLimiter.tick(time, this.getMaxChunkSendRate(), INITIAL_ALLOCATION_FACTOR);
+            final long maxSends = Math.max(0L, Math.min(MAX_RATE, this.sendQueue.size()));
+            final long maxSendsThisTick = this.chunkSendLimiter.takeAllocation(maxSends);
+            for (long sent = 0; sent < maxSendsThisTick && !this.sendQueue.isEmpty(); ++sent) {
+                final long chunkKey = this.sendQueue.dequeueLong();
+                this.observerPendingChunks.remove(chunkKey);
+                this.trySendObserverChunk(CoordinateUtils.getChunkX(chunkKey), CoordinateUtils.getChunkZ(chunkKey));
+                if (this.removed) {
+                    return;
+                }
+            }
+        }
