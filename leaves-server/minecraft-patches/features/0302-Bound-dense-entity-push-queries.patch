From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Sat, 29 Aug 2026 18:48:11 +0800
Subject: [PATCH] Bound dense entity push queries


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 3610642b..01c50a50 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -3996,14 +3996,18 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             return;
         }
 
-        int maxCramming = ((ServerLevel) this.level()).getGameRules().get(GameRules.MAX_ENTITY_CRAMMING);
-        if (maxCramming <= 0 && this.level().paperConfig().collisions.maxEntityCollisions <= 0) {
+        final int maxCramming = ((ServerLevel) this.level()).getGameRules().get(GameRules.MAX_ENTITY_CRAMMING);
+        final int maxEntityCollisions = this.level().paperConfig().collisions.maxEntityCollisions;
+        if (maxCramming <= 0 && maxEntityCollisions <= 0) {
             return;
         }
         // Paper end - don't run getEntities if we're not going to use its result
         try (Level.LeavesXEntityQueryBuffer queryBuffer = Level.leavesX$acquireEntityQueryBuffer()) {
+            final int queryLimit = Math.max(maxCramming, maxEntityCollisions);
+            final AABB queryBox = this.getBoundingBox();
+            final Predicate<Entity> pushable = EntitySelector.pushableBy(this);
             List<Entity> pushableEntities = queryBuffer.query(
-                this.level(), this, this.getBoundingBox(), EntitySelector.pushableBy(this)
+                this.level(), this, queryBox, pushable, queryLimit
             );
             if (!pushableEntities.isEmpty()) {
                 if (this.level() instanceof ServerLevel serverLevel) {
@@ -4017,6 +4021,18 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                             }
                         }
 
+                        // A bounded prefix is sufficient unless passengers occupy part of that prefix. Only the
+                        // already-selected one-in-four cramming check needs the complete deterministic result then.
+                        if (count <= maxCramming - 1 && pushableEntities.size() == queryLimit) {
+                            pushableEntities = queryBuffer.query(this.level(), this, queryBox, pushable);
+                            count = 0;
+                            for (Entity entity : pushableEntities) {
+                                if (!entity.isPassenger()) {
+                                    count++;
+                                }
+                            }
+                        }
+
                         if (count > maxCramming - 1) {
                             this.hurtServer(serverLevel, this.damageSources().cramming(), 6.0F);
                         }
@@ -4024,9 +4040,9 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 }
 
                 // Paper start - Cap entity collisions
-                this.numCollisions = Math.max(0, this.numCollisions - this.level().paperConfig().collisions.maxEntityCollisions);
+                this.numCollisions = Math.max(0, this.numCollisions - maxEntityCollisions);
                 for (Entity entity : pushableEntities) {
-                    if (this.numCollisions >= this.level().paperConfig().collisions.maxEntityCollisions) {
+                    if (this.numCollisions >= maxEntityCollisions) {
                         break;
                     }
 
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 14b1e122..2858ab7b 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -280,6 +280,25 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
             .addToGetEntities((Level)(Object)this, except, boundingBox, predicate, into);
     }
 
+    public final void leavesX$getEntities(
+        final @Nullable Entity except,
+        final AABB boundingBox,
+        final Predicate<? super Entity> predicate,
+        final List<Entity> into,
+        final int maxCount
+    ) {
+        Profiler.get().incrementCounter("getEntities");
+        ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
+            .moonrise$getEntityLookup().getEntities(except, boundingBox, into, predicate, maxCount);
+        if (into.size() < maxCount) {
+            ca.spottedleaf.moonrise.common.PlatformHooks.get()
+                .addToGetEntities((Level)(Object)this, except, boundingBox, predicate, into);
+            if (into.size() > maxCount) {
+                into.subList(maxCount, into.size()).clear();
+            }
+        }
+    }
+
     public static LeavesXEntityQueryBuffer leavesX$acquireEntityQueryBuffer() {
         final LeavesXEntityQueryBuffer pooledBuffer = LEAVESX_ENTITY_QUERY_BUFFER.get();
         if (pooledBuffer.acquire()) {
@@ -2452,6 +2471,21 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
             return this.results;
         }
 
+        /** Collects at most {@code maxCount} matches in the normal deterministic entity-query order. */
+        public List<Entity> query(
+            final Level level,
+            final @Nullable Entity except,
+            final AABB boundingBox,
+            final Predicate<? super Entity> predicate,
+            final int maxCount
+        ) {
+            this.results.clear();
+            if (maxCount > 0) {
+                level.leavesX$getEntities(except, boundingBox, predicate, this.results, maxCount);
+            }
+            return this.results;
+        }
+
         /** Collects one entity class into the reusable storage while preserving the typed Level query order. */
         @SuppressWarnings({"rawtypes", "unchecked"})
         public <T extends Entity> List<T> queryOfClass(
