+    // LeavesX start - fixed block hoppers reuse immutable coordinates and a private result buffer
+    private static @Nullable Container getContainerAt(
+        final Level level,
+        final BlockPos pos,
+        final BlockState state,
+        final AABB entitySearchBox,
+        final boolean optimizeEntities,
+        final List<Entity> queryResults
