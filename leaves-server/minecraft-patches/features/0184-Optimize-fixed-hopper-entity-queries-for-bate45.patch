+    // LeavesX start - allocation-free entity-container query for fixed block hoppers
+    private static @Nullable Container getEntityContainer(final Level level, final AABB searchBox, final List<Entity> queryResults) {
+        queryResults.clear();
+        level.leavesX$getEntitiesOfClass((Class)Container.class, searchBox, EntitySelector.CONTAINER_ENTITY_SELECTOR, queryResults);
+        final Container result = !queryResults.isEmpty()
+            ? (Container)queryResults.get(level.getRandom().nextInt(queryResults.size()))
+            : null;
+        // Do not retain minecart references between hopper ticks; only the small backing array is reused.
+        queryResults.clear();
+        return result;
+    }
+
+    private LeavesXEntityContainerQueryCache leavesXGetEntityContainerQueryCache() {
+        LeavesXEntityContainerQueryCache queryCache = this.leavesXEntityContainerQueryCache;
+        if (queryCache == null) {
+            queryCache = new LeavesXEntityContainerQueryCache(this.worldPosition, this.facing);
+            this.leavesXEntityContainerQueryCache = queryCache;
+        }
+        return queryCache;
+    }
+
+    private void leavesXUpdateAttachedContainerCache() {
+        final LeavesXEntityContainerQueryCache queryCache = this.leavesXEntityContainerQueryCache;
+        if (queryCache != null) {
+            queryCache.updateAttachedContainer(this.worldPosition, this.facing);
+        }
+    }
+
+    private static final class LeavesXEntityContainerQueryCache {
+
+        private final BlockPos sourceContainerPos;
+        private BlockPos attachedContainerPos;
+        private final AABB sourceContainerSearchBox;
+        private AABB attachedContainerSearchBox;
+        private final List<Entity> queryResults = new java.util.ArrayList<>(1);
+
+        private LeavesXEntityContainerQueryCache(final BlockPos hopperPos, final Direction facing) {
+            this.sourceContainerPos = hopperPos.above();
+            this.sourceContainerSearchBox = new AABB(this.sourceContainerPos);
+            this.updateAttachedContainer(hopperPos, facing);
+        }
+
+        private void updateAttachedContainer(final BlockPos hopperPos, final Direction facing) {
+            this.attachedContainerPos = hopperPos.relative(facing);
+            this.attachedContainerSearchBox = new AABB(this.attachedContainerPos);
+        }
+    }
+    // LeavesX end - allocation-free entity-container query for fixed block hoppers
+
     private static boolean canMergeItems(final ItemStack a, final ItemStack b) {
         return a.getCount() < a.getMaxStackSize() && ItemStack.isSameItemSameComponents(a, b); // Paper - Perf: Optimize Hoppers; used to return true for full itemstacks?!
     }
