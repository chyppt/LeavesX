@@ -242,8 +243,22 @@ public class ExperienceOrb extends Entity {
 
     private void scanForMerges() {
         if (this.level() instanceof ServerLevel) {
-            for (ExperienceOrb orb : this.level().getEntities(EntityTypeTest.forClass(ExperienceOrb.class), this.getBoundingBox().inflate(0.5), this::canMerge)) {
-                this.merge(orb);
+            if (org.leavesx.leavesx.config.LeavesXRuntime.experienceOrbMergeParametersOptimization()) {
+                // These values cannot change while the synchronous entity query is running.
+                final int groupsPerArea = io.papermc.paper.configuration.GlobalConfiguration.get().misc.xpOrbGroupsPerArea.or(ORB_GROUPS_PER_AREA);
+                final int id = this.getId();
+                final int value = this.getValue();
+                for (ExperienceOrb orb : this.level().getEntities(
+                    EntityTypeTest.forClass(ExperienceOrb.class),
+                    this.getBoundingBox().inflate(0.5),
+                    candidate -> candidate != this && canMerge(candidate, id, value, groupsPerArea)
+                )) {
+                    this.merge(orb);
+                }
+            } else {
+                for (ExperienceOrb orb : this.level().getEntities(EntityTypeTest.forClass(ExperienceOrb.class), this.getBoundingBox().inflate(0.5), this::canMerge)) {
+                    this.merge(orb);
+                }
             }
         }
     }
