From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesX Build <build@leavesx.local>
Date: Wed, 12 Aug 2026 21:47:27 +0800
Subject: [PATCH] Add safe identifier and empty-event optimizations


diff --git a/net/minecraft/resources/Identifier.java b/net/minecraft/resources/Identifier.java
index 29013261..02a32375 100644
--- a/net/minecraft/resources/Identifier.java
+++ b/net/minecraft/resources/Identifier.java
@@ -13,6 +13,7 @@ import net.minecraft.IdentifierException;
 import net.minecraft.network.chat.Component;
 import net.minecraft.network.codec.ByteBufCodecs;
 import net.minecraft.network.codec.StreamCodec;
+import org.leavesx.leavesx.config.LeavesXRuntime;
 import org.jspecify.annotations.Nullable;
 
 public final class Identifier implements Comparable<Identifier> {
@@ -26,6 +27,10 @@ public final class Identifier implements Comparable<Identifier> {
     public static final String PAPER_NAMESPACE = "paper"; // Paper
     private final String namespace;
     private final String path;
+    // LeavesX start - benign races can only repeat the same immutable computation
+    private @Nullable String cachedString;
+    private int cachedHash;
+    // LeavesX end - lazy immutable caches
 
     private Identifier(final String namespace, final String path) {
         assert isValidNamespace(namespace);
@@ -131,7 +136,15 @@ public final class Identifier implements Comparable<Identifier> {
 
     @Override
     public String toString() {
-        return this.namespace + ":" + this.path;
+        if (!LeavesXRuntime.resourceIdentifierCache()) {
+            return this.namespace + ":" + this.path;
+        }
+        String value = this.cachedString;
+        if (value == null) {
+            value = this.namespace + ":" + this.path;
+            this.cachedString = value;
+        }
+        return value;
     }
 
     @Override
@@ -141,7 +154,15 @@ public final class Identifier implements Comparable<Identifier> {
 
     @Override
     public int hashCode() {
-        return 31 * this.namespace.hashCode() + this.path.hashCode();
+        if (!LeavesXRuntime.resourceIdentifierCache()) {
+            return 31 * this.namespace.hashCode() + this.path.hashCode();
+        }
+        int value = this.cachedHash;
+        if (value == 0) {
+            value = 31 * this.namespace.hashCode() + this.path.hashCode();
+            this.cachedHash = value;
+        }
+        return value;
     }
 
     @Override
diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index b5d172c2..bd142cb8 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -391,15 +391,18 @@ public final class NaturalSpawner {
     ) {
         // Paper start - PreCreatureSpawnEvent
         EntityType<?> type = currentSpawnData.type();
-        com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent event = new com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent(
+        if (!org.leavesx.leavesx.config.LeavesXRuntime.skipEmptyEvents()
+            || com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent.getHandlerList().getRegisteredListeners().length != 0) {
+            com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent event = new com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent(
                 org.bukkit.craftbukkit.util.CraftLocation.toBukkit(pos, level),
                 org.bukkit.craftbukkit.entity.CraftEntityType.minecraftToBukkit(type), org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL
-        );
-        if (!event.callEvent()) {
-            if (event.shouldAbortSpawn()) {
-                return PreSpawnStatus.ABORT;
+            );
+            if (!event.callEvent()) {
+                if (event.shouldAbortSpawn()) {
+                    return PreSpawnStatus.ABORT;
+                }
+                return PreSpawnStatus.CANCELLED;
             }
-            return PreSpawnStatus.CANCELLED;
         }
         final boolean success = type.getCategory() != MobCategory.MISC
         // Paper end - PreCreatureSpawnEvent
diff --git a/net/minecraft/world/level/gameevent/GameEventDispatcher.java b/net/minecraft/world/level/gameevent/GameEventDispatcher.java
index f8c4b24e..a099f7f0 100644
--- a/net/minecraft/world/level/gameevent/GameEventDispatcher.java
+++ b/net/minecraft/world/level/gameevent/GameEventDispatcher.java
@@ -23,13 +23,16 @@ public class GameEventDispatcher {
         int radius = gameEvent.value().notificationRadius();
         BlockPos center = BlockPos.containing(position);
         // CraftBukkit start
-        org.bukkit.event.world.GenericGameEvent apiEvent = new org.bukkit.event.world.GenericGameEvent(
-            org.bukkit.craftbukkit.CraftGameEvent.minecraftHolderToBukkit(gameEvent), org.bukkit.craftbukkit.util.CraftLocation.toBukkit(center, this.level),
-            (context.sourceEntity() == null) ? null : context.sourceEntity().getBukkitEntity(), radius, !org.bukkit.Bukkit.isPrimaryThread());
-        if (!apiEvent.callEvent()) {
-            return;
+        if (!org.leavesx.leavesx.config.LeavesXRuntime.skipEmptyEvents()
+            || org.bukkit.event.world.GenericGameEvent.getHandlerList().getRegisteredListeners().length != 0) {
+            org.bukkit.event.world.GenericGameEvent apiEvent = new org.bukkit.event.world.GenericGameEvent(
+                org.bukkit.craftbukkit.CraftGameEvent.minecraftHolderToBukkit(gameEvent), org.bukkit.craftbukkit.util.CraftLocation.toBukkit(center, this.level),
+                (context.sourceEntity() == null) ? null : context.sourceEntity().getBukkitEntity(), radius, !org.bukkit.Bukkit.isPrimaryThread());
+            if (!apiEvent.callEvent()) {
+                return;
+            }
+            radius = apiEvent.getRadius();
         }
-        radius = apiEvent.getRadius();
         // CraftBukkit end
         int sectionMinX = SectionPos.blockToSectionCoord(center.getX() - radius);
         int sectionMinY = SectionPos.blockToSectionCoord(center.getY() - radius);
