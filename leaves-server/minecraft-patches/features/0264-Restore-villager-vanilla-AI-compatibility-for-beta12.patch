+            super.inactiveTick();
+        } finally {
+            org.leavesx.leavesx.config.LeavesXRuntime.exitVillagerCompatibilityContext(previousCompatibilityContext);
         }
-        this.maybeDecayGossip();
-        super.inactiveTick();
     }
     // Paper end - EAR 2
 
@@ -304,12 +311,17 @@ public class Villager extends AbstractVillager implements VillagerDataHolder, Re
 
