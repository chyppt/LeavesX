     public static final TicketType UNLOAD_COOLDOWN = ChunkSystemTicketType.create("chunk_system:unload_cooldown", null, 5L * 20L);
 
     private static final long NO_TIMEOUT_MARKER = Long.MIN_VALUE;
+    private static final ThreadLocal<LeavesXTicketUpdateBuffers> LEAVESX_TICKET_UPDATE_BUFFERS =
+        ThreadLocal.withInitial(LeavesXTicketUpdateBuffers::new);
     public final ReentrantAreaLock ticketLockArea;
 
