+        /** Owns one queue scan's conflict coordinates without retaining the linked update nodes after release. */
+        private static final class LeavesXBlockingNodeBuffer {
+            private int[] sectionX = new int[8];
+            private int[] sectionZ = new int[8];
+            private UpdateQueueNode firstNode;
+            private int size;
+            private boolean inUse;
+
+            private boolean tryAcquire() {
+                if (this.inUse) {
+                    return false;
+                }
+                this.inUse = true;
+                return true;
+            }
+
+            private void add(final UpdateQueueNode node) {
+                if (this.size == this.sectionX.length) {
+                    final int newLength = this.size + (this.size >>> 1);
+                    this.sectionX = Arrays.copyOf(this.sectionX, newLength);
+                    this.sectionZ = Arrays.copyOf(this.sectionZ, newLength);
+                }
+                if (this.size == 0) {
+                    this.firstNode = node;
+                }
+                this.sectionX[this.size] = node.sectionX;
+                this.sectionZ[this.size] = node.sectionZ;
+                ++this.size;
+            }
+
+            private boolean intersects(final UpdateQueueNode other) {
+                for (int i = 0; i < this.size; ++i) {
+                    final int distance = Math.max(
+                        Math.abs(this.sectionX[i] - other.sectionX),
+                        Math.abs(this.sectionZ[i] - other.sectionZ)
+                    );
+                    if (distance <= MAX_INTERSECTION_DISTANCE) {
+                        return true;
+                    }
+                }
+                return false;
+            }
+
+            private void release() {
+                this.firstNode = null;
+                this.size = 0;
+                this.inUse = false;
+            }
+        }
+
