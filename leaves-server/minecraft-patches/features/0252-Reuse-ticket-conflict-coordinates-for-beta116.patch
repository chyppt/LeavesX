+        private static LeavesXBlockingNodeBuffer leavesX$acquireBlockingNodeBuffer() {
+            final LeavesXBlockingNodeBuffer buffer = LEAVESX_BLOCKING_NODE_BUFFER.get();
+            return buffer.tryAcquire() ? buffer : null;
+        }
