diff --git a/net/minecraft/world/level/levelgen/structure/placement/RandomSpreadStructurePlacement.java b/net/minecraft/world/level/levelgen/structure/placement/RandomSpreadStructurePlacement.java
--- a/net/minecraft/world/level/levelgen/structure/placement/RandomSpreadStructurePlacement.java
+++ b/net/minecraft/world/level/levelgen/structure/placement/RandomSpreadStructurePlacement.java
@@ -12,6 +12,10 @@
 import net.minecraft.world.level.levelgen.WorldgenRandom;
 
 public class RandomSpreadStructurePlacement extends StructurePlacement {
+    // 每个生成线程独占随机源；每次查询完整重置种子，不持有区块、世界或插件对象。
+    // 这里只调用原版枚举的 nextInt，没有回调或重入，不与装饰阶段的随机序列共享状态。
+    private static final ThreadLocal<WorldgenRandom> LEAVESX_PLACEMENT_RANDOM =
+        ThreadLocal.withInitial(() -> new WorldgenRandom(new LegacyRandomSource(0L)));
     public static final MapCodec<RandomSpreadStructurePlacement> CODEC = RecordCodecBuilder.<RandomSpreadStructurePlacement>mapCodec(
             i -> placementCodec(i)
                 .and(
@@ -72,7 +76,7 @@
         final org.leavesx.leavesx.worldgen.SecureFeatureSeed.@org.jspecify.annotations.Nullable Context secureSeed) {
         int spacedGridX = Math.floorDiv(sourceX, this.spacing);
         int spacedGridZ = Math.floorDiv(sourceZ, this.spacing);
-        WorldgenRandom random = secureSeed == null ? new WorldgenRandom(new LegacyRandomSource(0L))
+        WorldgenRandom random = secureSeed == null ? LEAVESX_PLACEMENT_RANDOM.get()
             : secureSeed.random("structure-placement", spacedGridX, spacedGridZ, this.salt());
         random.setLargeFeatureWithSalt(seed, spacedGridX, spacedGridZ, this.salt());
         int limit = this.spacing - this.separation;
