-                                if (event.isCancelled()) {
-                                    return;
+                        if (org.leavesx.leavesx.config.LeavesXRuntime.villagerProfessionAssignmentOptimization()) {
+                            final ServerLevel jobSiteLevel = server.getLevel(pos.dimension());
+                            if (jobSiteLevel != null) {
+                                final Holder<PoiType> poiType = jobSiteLevel.getPoiManager().getType(pos.pos()).orElse(null);
+                                if (poiType != null) {
