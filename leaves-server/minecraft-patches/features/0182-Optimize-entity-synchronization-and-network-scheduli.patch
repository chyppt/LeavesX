From: LeavesX Build <build@leavesx.local>
Date: Sun, 16 Aug 2026 16:34:34 +0800
Subject: [PATCH] Optimize entity synchronization and network scheduling


diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 7de18731..d121789a 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -128,6 +128,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     public boolean isPending = true;
     public boolean queueImmunity;
     // Paper end - Optimize network
+    private volatile io.netty.channel.@Nullable SingleThreadEventLoop lazyWriteEventLoop;
 
     public Connection(final PacketFlow receiving) {
         this.receiving = receiving;
@@ -137,6 +138,10 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     public void channelActive(final ChannelHandlerContext ctx) throws Exception {
         super.channelActive(ctx);
         this.channel = ctx.channel();
+        final io.netty.channel.EventLoop eventLoop = this.channel.eventLoop();
+        this.lazyWriteEventLoop = eventLoop instanceof io.netty.channel.SingleThreadEventLoop singleThreadEventLoop
+            ? singleThreadEventLoop
+            : null;
         this.address = this.channel.remoteAddress();
         this.preparing = false; // Spigot
         if (this.delayedDisconnect != null) {
@@ -484,10 +489,17 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
 
     private void sendPacket(final Packet<?> packet, final @Nullable ChannelFutureListener listener, final boolean flush) {
         this.sentPackets++;
-        if (this.channel.eventLoop().inEventLoop()) {
+        final io.netty.channel.EventLoop eventLoop = this.channel.eventLoop();
+        if (eventLoop.inEventLoop()) {
             this.doSendPacket(packet, listener, flush);
         } else {
-            this.channel.eventLoop().execute(() -> this.doSendPacket(packet, listener, flush));
+            final io.netty.channel.SingleThreadEventLoop lazyEventLoop = this.lazyWriteEventLoop;
+            if (!flush && org.leavesx.leavesx.config.LeavesXRuntime.networkFlushConsolidation() && lazyEventLoop != null) {
+                // The regular flush task wakes this loop later in the same tick, preserving FIFO packet order.
+                lazyEventLoop.lazyExecute(() -> this.doSendPacket(packet, listener, false));
+            } else {
+                eventLoop.execute(() -> this.doSendPacket(packet, listener, flush));
+            }
         }
     }
 
