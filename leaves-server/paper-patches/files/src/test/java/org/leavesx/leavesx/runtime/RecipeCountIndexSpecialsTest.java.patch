+package org.leavesx.leavesx.runtime;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import net.minecraft.world.item.crafting.RecipeMap;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Beta9 regression guards for the recipe count index: special crafting recipes with flexible
+ * ingredient counts (tool repair, dyeing, book cloning…) must remain reachable through the
+ * merged bucket — the beta8 index dropped them entirely, breaking every repair/dye crafting.
+ */
+@Normal
+public class RecipeCountIndexSpecialsTest {
+
+    @Test
+    void specialRecipesLandInTheSentinelBucket() {
+        final RecipeMap map = RecipeMap.create(List.of());
+        // Warm the index on an empty map, then verify the merged accessor handles a null bucket.
+        assertTrue(map.leavesX$countBucketWithSpecials(
+            net.minecraft.world.item.crafting.RecipeType.CRAFTING, 2).isEmpty());
+    }
+
+    @Test
+    void mergedAccessorNeverReturnsNullBuckets() {
+        final RecipeMap map = RecipeMap.create(List.of());
+        for (int count = 0; count <= 9; count++) {
+            final var bucket = map.leavesX$countBucketWithSpecials(
+                net.minecraft.world.item.crafting.RecipeType.CRAFTING, count);
+            assertEquals(0, bucket.size(), "empty map must yield empty buckets");
+        }
+    }
+
+    @Test
+    void invalidationKeepsMergedAccessorConsistent() {
+        final RecipeMap map = RecipeMap.create(List.of());
+        map.leavesX$countBucketWithSpecials(net.minecraft.world.item.crafting.RecipeType.CRAFTING, 3);
+        map.leavesX$invalidateCountIndex();
+        assertEquals(0, map.leavesX$countBucketWithSpecials(
+            net.minecraft.world.item.crafting.RecipeType.CRAFTING, 3).size());
+        map.leavesX$invalidateCountIndex();
+        assertEquals(0, map.leavesX$countBucketWithSpecials(
+            net.minecraft.world.item.crafting.RecipeType.CRAFTING, 3).size());
+    }
+
+    @Test
+    void recipeManagerHotPathSurvivesSpecialRecipeQueries() throws Exception {
+        // Structural guard: RecipeManager must consult the MERGED bucket accessor, not the raw
+        // count-only accessor, so special recipes stay in the candidate set.
+        final byte[] bytes = classBytes(net.minecraft.world.item.crafting.RecipeManager.class);
+        final String text = new String(bytes, java.nio.charset.StandardCharsets.ISO_8859_1);
+        assertTrue(text.contains("leavesX$countBucketWithSpecials"),
+            "RecipeManager must call the merged accessor");
+    }
+
+    private static byte[] classBytes(final Class<?> type) throws Exception {
+        final String resource = type.getName().replace('.', '/') + ".class";
+        try (var in = type.getClassLoader().getResourceAsStream(resource)) {
+            assertTrue(in != null, "class resource missing: " + resource);
+            return in.readAllBytes();
+        }
+    }
+}
