diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkPacketAssemblyHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkPacketAssemblyHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ac54552bae40117f0887a7c112f0218c59adfe3e
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkPacketAssemblyHotPathTest.java
@@ -0,0 +1,118 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData;
+import net.minecraft.world.level.levelgen.Heightmap;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies chunk packet assembly retains cloned data and the Paper allocation path. */
+@Normal
+class ChunkPacketAssemblyHotPathTest {
+
+    @Test
+    void optimizedHeightmapsMatchPaperFilteringAndCloning() throws ReflectiveOperationException {
+        final long[] clientData = {3L, 7L, 11L};
+        final Heightmap clientHeightmap = mock(Heightmap.class);
+        when(clientHeightmap.getRawData()).thenReturn(clientData);
+
+        final Heightmap serverHeightmap = mock(Heightmap.class);
+        when(serverHeightmap.getRawData()).thenReturn(new long[] {13L});
+
+        final Collection<Map.Entry<Heightmap.Types, Heightmap>> entries = List.of(
+            Map.entry(Heightmap.Types.WORLD_SURFACE, clientHeightmap),
+            Map.entry(Heightmap.Types.OCEAN_FLOOR, serverHeightmap)
+        );
+        final Map<Heightmap.Types, long[]> optimized = collectHeightmaps(entries, true);
+        final Map<Heightmap.Types, long[]> fallback = collectHeightmaps(entries, false);
+
+        assertEquals(fallback.keySet(), optimized.keySet());
+        assertFalse(optimized.containsKey(Heightmap.Types.OCEAN_FLOOR));
+        assertArrayEquals(clientData, optimized.get(Heightmap.Types.WORLD_SURFACE));
+        assertNotSame(clientData, optimized.get(Heightmap.Types.WORLD_SURFACE));
+        assertNotSame(fallback.get(Heightmap.Types.WORLD_SURFACE), optimized.get(Heightmap.Types.WORLD_SURFACE));
+    }
+
+    @Test
+    void constructorKeepsOptimizedAndPaperAllocationBranches() throws IOException {
+        final MethodNode constructor = constructorNode();
+        final List<MethodInsnNode> constructorCalls = invocations(constructor);
+
+        assertTrue(hasCall(constructorCalls, "org/leavesx/leavesx/config/LeavesXRuntime", "chunkPacketAssemblyOptimization"));
+        assertTrue(hasCall(constructorCalls, "net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData", "collectHeightmaps"));
+        assertTrue(hasCall(constructorCalls, "java/lang/Math", "min"));
+        assertTrue(constructorCalls.stream().anyMatch(call -> call.owner.equals("java/util/ArrayList")
+            && call.name.equals("<init>") && call.desc.equals("(I)V")));
+        assertTrue(hasCall(constructorCalls, "com/google/common/collect/Lists", "newArrayList"));
+
+        final List<MethodInsnNode> helperCalls = invocations(methodNode("collectHeightmaps"));
+        assertTrue(hasCall(helperCalls, "java/util/Collection", "stream"));
+        assertTrue(hasCall(helperCalls, "java/util/stream/Collectors", "toMap"));
+        assertTrue(hasCall(helperCalls, "java/util/HashMap", "<init>"));
+        assertTrue(hasCall(helperCalls, "java/util/Map", "put"));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<Heightmap.Types, long[]> collectHeightmaps(
+        final Collection<Map.Entry<Heightmap.Types, Heightmap>> entries,
+        final boolean optimize
+    ) throws ReflectiveOperationException {
+        final Method method = ClientboundLevelChunkPacketData.class.getDeclaredMethod("collectHeightmaps", Collection.class, boolean.class);
+        method.setAccessible(true);
+        return (Map<Heightmap.Types, long[]>)method.invoke(null, entries, optimize);
+    }
+
+    private static boolean hasCall(final List<MethodInsnNode> calls, final String owner, final String name) {
+        return calls.stream().anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static MethodNode constructorNode() throws IOException {
+        return classNode().methods.stream()
+            .filter(method -> method.name.equals("<init>"))
+            .filter(method -> method.desc.contains("Lnet/minecraft/world/level/chunk/LevelChunk;"))
+            .filter(method -> method.desc.contains("Lio/papermc/paper/antixray/ChunkPacketInfo;"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing chunk packet data constructor"));
+    }
+
+    private static MethodNode methodNode(final String methodName) throws IOException {
+        return classNode().methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing ClientboundLevelChunkPacketData#" + methodName));
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(ClientboundLevelChunkPacketData.class.getName()).accept(
+            classNode,
+            ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES
+        );
+        return classNode;
+    }
+}
