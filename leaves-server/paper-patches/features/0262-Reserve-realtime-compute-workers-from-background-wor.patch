+    /** 只控制低优先级计算的准入，不改变实时实体任务和任何世界状态的执行线程。 */
+    public record ComputeSchedulingSettings(int realtimeReservedWorkers, int lowPriorityQueueLimit) {
+        public ComputeSchedulingSettings {
+            if (realtimeReservedWorkers < -1 || realtimeReservedWorkers > 15) {
+                throw new IllegalArgumentException("parallelism.scheduling.realtime-reserved-workers must be between -1 and 15");
+            }
+            if (lowPriorityQueueLimit < 0 || lowPriorityQueueLimit > 4_096) {
+                throw new IllegalArgumentException("parallelism.scheduling.low-priority-queue-limit must be between 0 and 4096");
+            }
+        }
+
+        public static ComputeSchedulingSettings defaults() {
+            return new ComputeSchedulingSettings(-1, 0);
+        }
+    }
