diff --git a/src/test/java/org/leavesx/leavesx/performance/SyncableAttributeCollectionHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/SyncableAttributeCollectionHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d9c875b13bdd00c39f862f59e5361f7483259f7f
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/SyncableAttributeCollectionHotPathTest.java
@@ -0,0 +1,127 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Set;
+import net.minecraft.core.Holder;
+import net.minecraft.world.entity.ai.attributes.Attribute;
+import net.minecraft.world.entity.ai.attributes.AttributeInstance;
+import net.minecraft.world.entity.ai.attributes.AttributeMap;
+import net.minecraft.world.entity.ai.attributes.AttributeSupplier;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies direct syncable-attribute traversal preserves the original collection contract and values. */
+@Normal
+class SyncableAttributeCollectionHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void optimizedTraversalMatchesTheStreamFallbackAndReturnsMutableList() throws IOException {
+        final AttributeMap map = createAttributeMap();
+        final List<AttributeInstance> optimized;
+        final List<AttributeInstance> fallback;
+        try {
+            publish(LeavesXConfig.safeDefaults());
+            optimized = new ArrayList<>(map.getSyncableAttributes());
+
+            final Path fallbackConfig = this.temporaryDirectory.resolve("fallback.yml");
+            Files.writeString(fallbackConfig, """
+                config-version: 51
+                performance:
+                  entity-sync:
+                    syncable-attribute-collection: false
+                """, StandardCharsets.UTF_8);
+            publish(LeavesXConfigLoader.load(fallbackConfig));
+            fallback = new ArrayList<>(map.getSyncableAttributes());
+
+            assertFalse(LeavesXRuntime.syncableAttributeCollectionOptimization());
+            assertEquals(fallback, optimized);
+            assertEquals(2, optimized.size());
+            assertEquals(2, Set.copyOf(optimized).size());
+            assertTrue(optimized.stream().allMatch(instance -> instance.getAttribute().value().isClientSyncable()));
+            assertInstanceOf(ArrayList.class, map.getSyncableAttributes());
+
+            final Collection<AttributeInstance> mutable = map.getSyncableAttributes();
+            mutable.clear();
+            assertTrue(mutable.isEmpty());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void version51ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-51.yml");
+        Files.writeString(path, """
+            config-version: 51
+            performance:
+              entity-sync:
+                syncable-attribute-collection: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.syncableAttributeCollectionOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("syncable-attribute-collection: false"));
+        assertTrue(upgraded.contains("# 属性同步直接遍历可同步属性，关闭后使用原版流。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private static AttributeMap createAttributeMap() {
+        final Holder<Attribute> syncableOne = Holder.direct(new TestAttribute("syncable-one", true));
+        final Holder<Attribute> nonSyncable = Holder.direct(new TestAttribute("non-syncable", false));
+        final Holder<Attribute> syncableTwo = Holder.direct(new TestAttribute("syncable-two", true));
+        final AttributeSupplier supplier = AttributeSupplier.builder()
+            .add(syncableOne, 1.0D)
+            .add(nonSyncable, 2.0D)
+            .add(syncableTwo, 3.0D)
+            .build();
+        final AttributeMap map = new AttributeMap(supplier);
+        map.getInstance(syncableOne);
+        map.getInstance(nonSyncable);
+        map.getInstance(syncableTwo);
+        return map;
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final var method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+
+    private static final class TestAttribute extends Attribute {
+        private TestAttribute(final String descriptionId, final boolean syncable) {
+            super(descriptionId, 0.0D);
+            this.setSyncable(syncable);
+        }
+    }
+}
