+    @Test
+    void reusableConflictBufferRejectsReentryAndClearsBeforeReuse() throws ReflectiveOperationException {
+        final Class<?> updateQueue = Class.forName(UPDATE_QUEUE_CLASS);
+        final Class<?> bufferType = Arrays.stream(updateQueue.getDeclaredClasses())
+            .filter(type -> type.getSimpleName().equals("LeavesXBlockingNodeBuffer"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing LeavesX blocking-node buffer"));
+        final var constructor = bufferType.getDeclaredConstructor();
+        final Method tryAcquire = bufferType.getDeclaredMethod("tryAcquire");
+        final Class<?> nodeType = Arrays.stream(updateQueue.getDeclaredClasses())
+            .filter(type -> type.getSimpleName().equals("UpdateQueueNode"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing ticket update queue node"));
+        final Class<?> sectionType = Class.forName(
+            "ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ThreadedTicketLevelPropagator$Section"
+        );
+        final var nodeConstructor = nodeType.getDeclaredConstructor(sectionType, nodeType);
+        final Method add = bufferType.getDeclaredMethod("add", nodeType);
+        final Method intersects = bufferType.getDeclaredMethod("intersects", nodeType);
+        final Method release = bufferType.getDeclaredMethod("release");
+        final var firstNodeField = bufferType.getDeclaredField("firstNode");
+        final var sizeField = bufferType.getDeclaredField("size");
+        constructor.setAccessible(true);
+        nodeConstructor.setAccessible(true);
+        tryAcquire.setAccessible(true);
+        add.setAccessible(true);
+        intersects.setAccessible(true);
+        release.setAccessible(true);
+        firstNodeField.setAccessible(true);
+        sizeField.setAccessible(true);
+
+        final Object buffer = constructor.newInstance();
+        final Object node = nodeConstructor.newInstance(null, null);
+
+        assertTrue((boolean)tryAcquire.invoke(buffer));
+        assertFalse((boolean)tryAcquire.invoke(buffer), "Same-thread reentry must allocate a private fallback list");
+        add.invoke(buffer, node);
+        assertTrue((boolean)intersects.invoke(buffer, node));
+        assertEquals(1, sizeField.getInt(buffer));
+        assertSame(node, firstNodeField.get(buffer));
+        release.invoke(buffer);
+
+        assertEquals(0, sizeField.getInt(buffer));
+        assertNull(firstNodeField.get(buffer));
+        assertTrue((boolean)tryAcquire.invoke(buffer), "Released conflict buffers must be reusable");
+        release.invoke(buffer);
+    }
+
     private static ClassNode classNode(final String binaryName) throws IOException {
         final ClassNode classNode = new ClassNode(Opcodes.ASM9);
         new ClassReader(binaryName).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
