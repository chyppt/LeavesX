diff --git a/src/test/java/org/leavesx/leavesx/config/GoalSelectorOptimizationTest.java b/src/test/java/org/leavesx/leavesx/config/GoalSelectorOptimizationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e53415fbd4d3be3916086a3f807f8900f35e85d4
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/GoalSelectorOptimizationTest.java
@@ -0,0 +1,195 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.List;
+import net.minecraft.world.entity.ai.goal.Goal;
+import net.minecraft.world.entity.ai.goal.GoalSelector;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/** Verifies the indexed goal-lock path preserves Paper's observable goal ordering and replacement rules. */
+@Normal
+class GoalSelectorOptimizationTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedAndPaperPathsKeepPriorityAndTickOrder() throws IOException {
+        final List<String> paperCalls = runPriorityScenario(false);
+        assertEquals(
+            List.of(
+                "canUse:low",
+                "start:low",
+                "interruptible:low",
+                "canUse:high",
+                "stop:low",
+                "start:high",
+                "canUse:look",
+                "start:look",
+                "tick:high",
+                "tick:look"
+            ),
+            paperCalls
+        );
+        assertEquals(paperCalls, runPriorityScenario(true));
+    }
+
+    @Test
+    void optimizedAndPaperPathsKeepNonInterruptibleLocks() throws IOException {
+        final List<String> paperCalls = runNonInterruptibleScenario(false);
+        assertEquals(
+            List.of("canUse:locked", "start:locked", "interruptible:locked", "tick:locked"),
+            paperCalls
+        );
+        assertEquals(paperCalls, runNonInterruptibleScenario(true));
+    }
+
+    @Test
+    void optimizedAndPaperPathsReadFlagsAgainAfterCanUse() throws IOException {
+        final List<String> paperCalls = runDynamicFlagScenario(false);
+        assertEquals(
+            List.of("canUse:look", "start:look", "canUse:dynamic", "stop:look", "start:dynamic", "tick:dynamic"),
+            paperCalls
+        );
+        assertEquals(paperCalls, runDynamicFlagScenario(true));
+    }
+
+    @Test
+    void optimizedAndPaperPathsSkipDisabledFlagsBeforeCanUse() throws IOException {
+        final List<String> paperCalls = runDisabledFlagScenario(false);
+        assertEquals(List.of(), paperCalls);
+        assertEquals(paperCalls, runDisabledFlagScenario(true));
+    }
+
+    private List<String> runPriorityScenario(final boolean optimized) throws IOException {
+        final List<String> calls = new ArrayList<>();
+        final GoalSelector selector = new GoalSelector();
+        selector.addGoal(5, new RecordingGoal("low", calls, true, true, true, Goal.Flag.MOVE));
+        selector.addGoal(1, new RecordingGoal("high", calls, true, true, true, Goal.Flag.MOVE));
+        selector.addGoal(2, new RecordingGoal("look", calls, true, true, true, Goal.Flag.LOOK));
+        return tickWithConfiguration(selector, calls, optimized);
+    }
+
+    private List<String> runNonInterruptibleScenario(final boolean optimized) throws IOException {
+        final List<String> calls = new ArrayList<>();
+        final GoalSelector selector = new GoalSelector();
+        selector.addGoal(5, new RecordingGoal("locked", calls, true, true, false, Goal.Flag.MOVE));
+        selector.addGoal(1, new RecordingGoal("candidate", calls, true, true, true, Goal.Flag.MOVE));
+        return tickWithConfiguration(selector, calls, optimized);
+    }
+
+    private List<String> runDynamicFlagScenario(final boolean optimized) throws IOException {
+        final List<String> calls = new ArrayList<>();
+        final GoalSelector selector = new GoalSelector();
+        selector.addGoal(5, new RecordingGoal("look", calls, true, true, true, Goal.Flag.LOOK));
+        final RecordingGoal dynamic = new RecordingGoal("dynamic", calls, true, true, true, Goal.Flag.MOVE);
+        dynamic.beforeCanUse(() -> dynamic.setFlags(EnumSet.of(Goal.Flag.LOOK)));
+        selector.addGoal(1, dynamic);
+        return tickWithConfiguration(selector, calls, optimized);
+    }
+
+    private List<String> runDisabledFlagScenario(final boolean optimized) throws IOException {
+        final List<String> calls = new ArrayList<>();
+        final GoalSelector selector = new GoalSelector();
+        selector.disableControlFlag(Goal.Flag.MOVE);
+        selector.addGoal(1, new RecordingGoal("disabled", calls, true, true, true, Goal.Flag.MOVE));
+        return tickWithConfiguration(selector, calls, optimized);
+    }
+
+    private List<String> tickWithConfiguration(
+        final GoalSelector selector,
+        final List<String> calls,
+        final boolean optimized
+    ) throws IOException {
+        try {
+            LeavesXRuntime.publish(this.configuration(optimized));
+            selector.tick();
+            return List.copyOf(calls);
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    private LeavesXConfig configuration(final boolean optimized) throws IOException {
+        final Path path = this.tempDir.resolve("goal-selector-" + optimized + ".yml");
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              ai:
+                goal-selector: %s
+            """.formatted(optimized));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static final class RecordingGoal extends Goal {
+
+        private final String name;
+        private final List<String> calls;
+        private final boolean canUse;
+        private final boolean canContinue;
+        private final boolean interruptible;
+        private Runnable beforeCanUse = () -> { };
+
+        private RecordingGoal(
+            final String name,
+            final List<String> calls,
+            final boolean canUse,
+            final boolean canContinue,
+            final boolean interruptible,
+            final Goal.Flag... flags
+        ) {
+            this.name = name;
+            this.calls = calls;
+            this.canUse = canUse;
+            this.canContinue = canContinue;
+            this.interruptible = interruptible;
+            this.setFlags(EnumSet.copyOf(List.of(flags)));
+        }
+
+        private void beforeCanUse(final Runnable callback) {
+            this.beforeCanUse = callback;
+        }
+
+        @Override
+        public boolean canUse() {
+            this.calls.add("canUse:" + this.name);
+            this.beforeCanUse.run();
+            return this.canUse;
+        }
+
+        @Override
+        public boolean canContinueToUse() {
+            this.calls.add("canContinue:" + this.name);
+            return this.canContinue;
+        }
+
+        @Override
+        public boolean isInterruptable() {
+            this.calls.add("interruptible:" + this.name);
+            return this.interruptible;
+        }
+
+        @Override
+        public void start() {
+            this.calls.add("start:" + this.name);
+        }
+
+        @Override
+        public void stop() {
+            this.calls.add("stop:" + this.name);
+        }
+
+        @Override
+        public void tick() {
+            this.calls.add("tick:" + this.name);
+        }
+    }
+}
