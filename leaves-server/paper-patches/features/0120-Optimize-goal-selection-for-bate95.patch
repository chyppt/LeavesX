@@ -3,7 +3,7 @@ package org.leavesx.leavesx.config;
 /**
  * Fine-grained switches for independently disabling LeavesX optimizations.
  *
- * <p>The runtime stores these values in one primitive bit mask. Configuration stays detailed without adding map
+ * <p>The runtime stores these values in two primitive bit masks. Configuration stays detailed without adding map
  * lookups or object traversal to entity, AI, and block-entity hot paths.</p>
  */
 enum LeavesXOptimization {
@@ -183,27 +183,43 @@ enum LeavesXOptimization {
     CHUNK_PACKET_ASSEMBLY(
         "performance.network.chunk-packet-assembly",
         "减少区块数据包组装时的临时对象，关闭后使用 Paper 原版流程。默认：true。"
+    ),
+    GOAL_SELECTOR(
+        "performance.ai.goal-selector",
+        "减少生物目标选择时的映射查询，关闭后使用 Paper 原版流程。默认：true。"
     );
 
     private static final LeavesXOptimization[] VALUES = values();
-    private static final long ALL_ENABLED_MASK = (1L << VALUES.length) - 1L;
+    private static final int MASK_WORD_BITS = Long.SIZE;
+    private static final int MASK_WORD_COUNT = 2;
+    private static final long ALL_ENABLED_MASK_LOW = allEnabledMaskForWord(0);
+    private static final long ALL_ENABLED_MASK_HIGH = allEnabledMaskForWord(1);
 
     private final String path;
     private final String comment;
+    private final int wordIndex;
     private final long mask;
 
     LeavesXOptimization(final String path, final String comment) {
         this.path = path;
         this.comment = comment;
-        this.mask = 1L << this.ordinal();
+        this.wordIndex = this.ordinal() / MASK_WORD_BITS;
+        if (this.wordIndex >= MASK_WORD_COUNT) {
+            throw new IllegalStateException("LeavesX optimization mask capacity exceeded");
+        }
+        this.mask = 1L << (this.ordinal() % MASK_WORD_BITS);
     }
 
     static LeavesXOptimization[] cachedValues() {
         return VALUES;
     }
 
-    static long allEnabledMask() {
-        return ALL_ENABLED_MASK;
+    static long allEnabledMaskLow() {
+        return ALL_ENABLED_MASK_LOW;
+    }
+
+    static long allEnabledMaskHigh() {
+        return ALL_ENABLED_MASK_HIGH;
     }
 
     static int count() {
@@ -222,11 +238,21 @@ enum LeavesXOptimization {
         return this.comment;
     }
 
+    int wordIndex() {
+        return this.wordIndex;
+    }
+
     long mask() {
         return this.mask;
     }
 
-    boolean enabledIn(final long enabledMask) {
+    boolean enabledIn(final long enabledMaskLow, final long enabledMaskHigh) {
+        final long enabledMask = this.wordIndex == 0 ? enabledMaskLow : enabledMaskHigh;
         return (enabledMask & this.mask) != 0L;
     }
+
+    private static long allEnabledMaskForWord(final int wordIndex) {
+        final int bits = Math.clamp(VALUES.length - wordIndex * MASK_WORD_BITS, 0, MASK_WORD_BITS);
+        return bits == MASK_WORD_BITS ? -1L : (1L << bits) - 1L;
+    }
 }
