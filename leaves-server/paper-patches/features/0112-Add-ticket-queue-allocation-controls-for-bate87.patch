diff --git a/src/test/java/org/leavesx/leavesx/performance/TicketUpdateQueueAllocationHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/TicketUpdateQueueAllocationHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..8e5ed6519ea4631f8e2afdaf5067b432aaae05ef
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/TicketUpdateQueueAllocationHotPathTest.java
@@ -0,0 +1,53 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Verifies ticket queue scans retain lazy and vanilla conflict-list allocation paths. */
+@Normal
+class TicketUpdateQueueAllocationHotPathTest {
+
+    private static final String UPDATE_QUEUE_CLASS =
+        "ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ThreadedTicketLevelPropagator$UpdateQueue";
+
+    @Test
+    void queueScanDefersAllocationWithoutChangingWaitSemantics() throws IOException {
+        final MethodNode method = method(classNode(UPDATE_QUEUE_CLASS), "acquireNextOrWait");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertTrue(Arrays.stream(calls).anyMatch(call -> call.name.equals("ticketQueueAllocationOptimization")));
+        assertTrue(Arrays.stream(calls).anyMatch(call -> call.name.equals("getAndSetUpdatingVolatile")));
+        assertTrue(Arrays.stream(calls).anyMatch(call -> call.name.equals("await")));
+        assertTrue(Arrays.stream(method.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .filter(instruction -> instruction.getOpcode() == Opcodes.NEW)
+            .anyMatch(instruction -> instruction.desc.equals("java/util/ArrayList")));
+    }
+
+    private static ClassNode classNode(final String binaryName) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(binaryName).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
