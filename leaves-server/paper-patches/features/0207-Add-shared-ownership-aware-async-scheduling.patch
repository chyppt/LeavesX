+    /** Startup-only asynchronous execution settings. */
+    public record AsyncSettings(
+        boolean chunkSendEnabled,
+        int chunkSendQueueSize,
+        boolean mobSpawningEnabled,
+        boolean pathfindingEnabled,
+        int pathfindingThreads,
+        int pathfindingQueueSize,
+        int pathfindingKeepaliveSeconds,
+        boolean playerDataSaveEnabled,
+        int playerDataSaveQueueSize,
+        boolean entityTrackerEnabled,
+        int entityTrackerThreads,
+        int entityTrackerQueueSize
+    ) {
+
+        public AsyncSettings {
+            validateThreadCount(pathfindingThreads, "async.async-pathfinding.threads");
+            validateThreadCount(entityTrackerThreads, "async.async-entity-tracker.threads");
+            validateQueueSize(chunkSendQueueSize, "async.async-chunk-send.queue-size");
+            validateQueueSize(pathfindingQueueSize, "async.async-pathfinding.queue-size");
+            validateQueueSize(playerDataSaveQueueSize, "async.async-playerdata-save.queue-size");
+            validateQueueSize(entityTrackerQueueSize, "async.async-entity-tracker.queue-size");
+            if (pathfindingKeepaliveSeconds < 1 || pathfindingKeepaliveSeconds > 600) {
+                throw new IllegalArgumentException(
+                    "async.async-pathfinding.keepalive-seconds must be between 1 and 600"
+                );
+            }
+        }
+
+        public static AsyncSettings safeDefaults() {
+            return new AsyncSettings(
+                false,
+                256,
+                true,
+                false,
+                0,
+                1_024,
+                60,
+                false,
+                1_024,
+                false,
+                0,
+                1_024
+            );
+        }
+
+        private static void validateThreadCount(final int value, final String path) {
+            if (value < 0 || value > 16) {
+                throw new IllegalArgumentException(path + " must be between 0 and 16");
+            }
+        }
+
+        private static void validateQueueSize(final int value, final String path) {
+            if (value < 64 || value > 65_536) {
+                throw new IllegalArgumentException(path + " must be between 64 and 65536");
+            }
+        }
+    }
+
     private static String requireBoundedText(final String value, final String path, final int maximumLength) {
         if (value == null) {
             throw new IllegalArgumentException(path + " must not be null");
