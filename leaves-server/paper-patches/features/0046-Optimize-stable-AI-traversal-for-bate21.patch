+    /** Runs one bounded diagnostic section per tick so console rendering cannot create a long tick. */
+    private static final class AllReport {
+
+        private final CommandSender sender;
+        private final Selection selection;
+        private final AllReportTiming timing = new AllReportTiming(System.nanoTime());
+        private EntitySnapshot entities;
+        private BlockEntitySnapshot blockEntities;
+
+        private AllReport(final CommandSender sender, final Selection selection) {
+            this.sender = sender;
+            this.selection = selection;
+        }
+
+        private void start() {
+            this.sender.sendMessage(Component.text("完整诊断分 12 个 Tick 采样，避免命令本身造成长 Tick。", NamedTextColor.GRAY));
+            this.runStage("世界与状态", () -> {
+                this.entities = collectEntities(this.selection.worlds());
+                sendStatus(this.sender);
+                sendWorlds(this.sender, this.selection.worlds(), this.entities);
+                sendActivity(this.sender, this.selection.worlds());
+            }, this::sendEntityDetails);
+        }
+
+        private void sendEntityDetails() {
+            this.runStage("实体明细", () -> {
+                sendEntities(this.sender, this.selection, this.entities);
+                sendHotspots(this.sender, this.selection, this.entities);
+                this.entities = null;
+            }, this::sendBlockEntityDetails);
+        }
+
+        private void sendBlockEntityDetails() {
+            this.runStage("方块实体统计", () -> {
+                this.blockEntities = collectBlockEntities(this.selection.worlds());
+                sendBlockEntities(this.sender, this.selection, this.blockEntities);
+            }, this::sendBlockEntityHotspots);
+        }
+
+        private void sendBlockEntityHotspots() {
+            this.runStage("方块实体热点", () -> {
+                sendBlockHotspots(this.sender, this.selection, this.blockEntities);
+                this.blockEntities = null;
+            }, this::sendTickets);
+        }
+
+        private void sendTickets() {
+            this.runStage("区块票据", () -> LeavesXCommand.sendTickets(this.sender, this.selection), this::sendPlugins);
+        }
+
+        private void sendPlugins() {
+            this.runStage("插件任务", () -> LeavesXCommand.sendPlugins(this.sender), this::sendMemory);
+        }
+
+        private void sendMemory() {
+            this.runStage("内存", () -> LeavesXCommand.sendMemory(this.sender), this::sendNetwork);
+        }
+
+        private void sendNetwork() {
+            this.runStage("网络", () -> LeavesXCommand.sendNetwork(this.sender), this::sendThreads);
+        }
+
+        private void sendThreads() {
+            this.runStage("线程", () -> LeavesXCommand.sendThreads(this.sender), this::sendSystem);
+        }
+
+        private void sendSystem() {
+            this.runStage("系统", () -> LeavesXCommand.sendSystem(this.sender), this::sendStalls);
+        }
+
+        private void sendStalls() {
+            this.runStage(
+                "慢 Tick",
+                () -> LeavesXCommand.sendStalls(this.sender, Math.min(5, this.selection.limit())),
+                this::finish
+            );
+        }
+
+        private void finish() {
+            final long stageStartedAt = System.nanoTime();
+            sendConfig(this.sender);
+            this.timing.finishStage("配置", stageStartedAt);
+
+            final double activeMilliseconds = this.timing.activeNanos / 1_000_000.0D;
+            final double maximumStageMilliseconds = this.timing.maximumStageNanos / 1_000_000.0D;
+            final double wallMilliseconds = (System.nanoTime() - this.timing.startedAtNanos) / 1_000_000.0D;
+            this.sender.sendMessage(line(
+                "诊断计算耗时",
+                oneDecimal(activeMilliseconds) + " ms / 最慢阶段 " + this.timing.maximumStageName + ' '
+                    + oneDecimal(maximumStageMilliseconds)
+                    + " ms / 总跨度 " + oneDecimal(wallMilliseconds) + " ms",
+                msptColor(maximumStageMilliseconds)
+            ));
+        }
+
+        private void runStage(final String stageName, final Runnable work, final Runnable nextStage) {
+            final long stageStartedAt = System.nanoTime();
+            work.run();
+            this.timing.finishStage(stageName, stageStartedAt);
+            MinecraftServer.getServer().scheduleOnMain(nextStage);
+        }
+    }
+
+    private static final class AllReportTiming {
+
+        private final long startedAtNanos;
+        private long activeNanos;
+        private long maximumStageNanos;
+        private String maximumStageName = "未知";
+
+        private AllReportTiming(final long startedAtNanos) {
+            this.startedAtNanos = startedAtNanos;
+        }
+
+        private void finishStage(final String stageName, final long stageStartedAtNanos) {
+            final long elapsedNanos = Math.max(0L, System.nanoTime() - stageStartedAtNanos);
+            this.activeNanos += elapsedNanos;
+            if (elapsedNanos > this.maximumStageNanos) {
+                this.maximumStageNanos = elapsedNanos;
+                this.maximumStageName = stageName;
+            }
+        }
+    }
+
     private record Selection(List<World> worlds, int limit) {
     }
 
