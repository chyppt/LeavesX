diff --git a/src/test/java/org/leavesx/leavesx/config/BrainTickTraversalTest.java b/src/test/java/org/leavesx/leavesx/config/BrainTickTraversalTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c17741e6609a3c2428f429b63df44e57d98198f4
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/BrainTickTraversalTest.java
@@ -0,0 +1,177 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.Mockito.doReturn;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import io.papermc.paper.configuration.WorldConfiguration;
+import java.io.IOException;
+import java.lang.reflect.Constructor;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Supplier;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.ai.Brain;
+import net.minecraft.world.entity.ai.memory.MemoryMap;
+import net.minecraft.world.entity.ai.memory.MemoryModuleType;
+import net.minecraft.world.entity.ai.sensing.Sensor;
+import net.minecraft.world.entity.ai.sensing.SensorType;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+@Normal
+class BrainTickTraversalTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedAndPaperPathsKeepDuplicateSensorReplacementOrder() throws Exception {
+        final List<String> paperCalls = this.runDuplicateSensorScenario(false);
+
+        assertEquals(List.of("first-2", "second-1"), paperCalls);
+        assertEquals(paperCalls, this.runDuplicateSensorScenario(true));
+    }
+
+    @Test
+    void optimizedAndPaperPathsTickDuplicateMemoryRegistrationOnce() throws Exception {
+        final long paperTimeToLive = this.runDuplicateMemoryScenario(false);
+
+        assertEquals(4L, paperTimeToLive);
+        assertEquals(paperTimeToLive, this.runDuplicateMemoryScenario(true));
+    }
+
+    private List<String> runDuplicateSensorScenario(final boolean optimized) throws Exception {
+        final ArrayList<String> calls = new ArrayList<>();
+        final AtomicInteger firstInstances = new AtomicInteger();
+        final AtomicInteger secondInstances = new AtomicInteger();
+        final SensorType<RecordingSensor> firstType = sensorType(
+            () -> new RecordingSensor("first-" + firstInstances.incrementAndGet(), calls)
+        );
+        final SensorType<RecordingSensor> secondType = sensorType(
+            () -> new RecordingSensor("second-" + secondInstances.incrementAndGet(), calls)
+        );
+
+        try {
+            LeavesXRuntime.publish(this.configuration(optimized));
+            final TestBrain brain = new TestBrain(
+                List.of(),
+                List.of(firstType, secondType, firstType),
+                zeroDelayRandom()
+            );
+            brain.tick(configuredLevel(), configuredEntity());
+            return List.copyOf(calls);
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    private long runDuplicateMemoryScenario(final boolean optimized) throws Exception {
+        final MemoryModuleType<String> memoryType = new MemoryModuleType<>(Optional.empty());
+
+        try {
+            LeavesXRuntime.publish(this.configuration(optimized));
+            final TestBrain brain = new TestBrain(
+                List.of(memoryType, memoryType),
+                List.of(),
+                zeroDelayRandom()
+            );
+            brain.setMemoryWithExpiry(memoryType, "value", 5L);
+            brain.tick(mock(ServerLevel.class), mock(LivingEntity.class));
+            return brain.getTimeUntilExpiry(memoryType);
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    private LeavesXConfig configuration(final boolean optimized) throws IOException {
+        final Path path = this.tempDir.resolve("brain-tick-traversal-" + optimized + ".yml");
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              ai:
+                brain-tick-traversal: %s
+            """.formatted(optimized));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static RandomSource zeroDelayRandom() {
+        final RandomSource random = mock(RandomSource.class);
+        when(random.nextInt(anyInt())).thenReturn(0);
+        return random;
+    }
+
+    private static ServerLevel configuredLevel() throws ReflectiveOperationException {
+        final Constructor<WorldConfiguration> constructor = WorldConfiguration.class.getDeclaredConstructor(
+            org.spigotmc.SpigotWorldConfig.class,
+            net.minecraft.resources.Identifier.class
+        );
+        constructor.setAccessible(true);
+        final WorldConfiguration configuration = constructor.newInstance(null, null);
+        configuration.tickRates = configuration.new TickRates();
+
+        final ServerLevel level = mock(ServerLevel.class);
+        when(level.paperConfig()).thenReturn(configuration);
+        return level;
+    }
+
+    private static LivingEntity configuredEntity() {
+        final LivingEntity entity = mock(LivingEntity.class);
+        doReturn(EntityType.VILLAGER).when(entity).getType();
+        when(entity.getAttributeValue(net.minecraft.world.entity.ai.attributes.Attributes.FOLLOW_RANGE)).thenReturn(16.0D);
+        return entity;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <S extends Sensor<?>> SensorType<S> sensorType(final Supplier<S> factory)
+        throws ReflectiveOperationException {
+        final Constructor<SensorType> constructor = SensorType.class.getDeclaredConstructor(Supplier.class);
+        constructor.setAccessible(true);
+        return (SensorType<S>)constructor.newInstance(factory);
+    }
+
+    private static final class TestBrain extends Brain<LivingEntity> {
+
+        private TestBrain(
+            final Collection<? extends MemoryModuleType<?>> memoryTypes,
+            final Collection<? extends SensorType<? extends Sensor<? super LivingEntity>>> sensorTypes,
+            final RandomSource random
+        ) {
+            super(memoryTypes, sensorTypes, List.of(), MemoryMap.EMPTY, random);
+        }
+    }
+
+    private static final class RecordingSensor extends Sensor<LivingEntity> {
+
+        private final String name;
+        private final List<String> calls;
+
+        private RecordingSensor(final String name, final List<String> calls) {
+            super(20);
+            this.name = name;
+            this.calls = calls;
+        }
+
+        @Override
+        protected void doTick(final ServerLevel level, final LivingEntity body) {
+            this.calls.add(this.name);
+        }
+
+        @Override
+        public Set<MemoryModuleType<?>> requires() {
+            return Set.of();
+        }
+    }
+}
