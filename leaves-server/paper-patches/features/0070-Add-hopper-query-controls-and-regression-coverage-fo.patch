diff --git a/src/test/java/org/leavesx/leavesx/performance/HopperEntityQueryHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/HopperEntityQueryHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..de1d9d9edc45cb32b4a90512b8988fd105e0846f
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/HopperEntityQueryHotPathTest.java
@@ -0,0 +1,172 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.HopperBlock;
+import net.minecraft.world.level.block.entity.HopperBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.AABB;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Locks down the allocation-free hopper entity-container lookup used by fixed block hoppers. */
+@Normal
+class HopperEntityQueryHotPathTest {
+
+    @Test
+    void blockHopperRetainsFixedQueryCoordinatesAndScratchStorage() throws IOException {
+        final ClassNode hopper = classNode(HopperBlockEntity.class);
+        final String cacheName = hopper.name + "$LeavesXEntityContainerQueryCache";
+
+        assertField(hopper, "leavesXEntityContainerQueryCache", 'L' + cacheName + ';');
+
+        final ClassNode cache = classNode(cacheName.replace('/', '.'));
+        assertField(cache, "sourceContainerPos", "Lnet/minecraft/core/BlockPos;");
+        assertField(cache, "attachedContainerPos", "Lnet/minecraft/core/BlockPos;");
+        assertField(cache, "sourceContainerSearchBox", "Lnet/minecraft/world/phys/AABB;");
+        assertField(cache, "attachedContainerSearchBox", "Lnet/minecraft/world/phys/AABB;");
+        assertField(cache, "queryResults", "Ljava/util/List;");
+
+        assertTrue(
+            invocations(method(hopper, "setBlockState")).stream()
+                .anyMatch(call -> call.owner.equals(hopper.name) && call.name.equals("leavesXUpdateAttachedContainerCache")),
+            "Changing hopper facing must refresh the destination lookup coordinates"
+        );
+    }
+
+    @Test
+    void retainedGeometryMatchesTheLegacyCenterBasedSearchBoxes()
+        throws NoSuchMethodException, InvocationTargetException, IllegalAccessException, NoSuchFieldException {
+        final BlockPos hopperPos = new BlockPos(10, 64, -3);
+        final BlockState downState = Blocks.HOPPER.defaultBlockState().setValue(HopperBlock.FACING, Direction.DOWN);
+        final HopperBlockEntity hopper = new HopperBlockEntity(hopperPos, downState);
+        final Method getCache = HopperBlockEntity.class.getDeclaredMethod("leavesXGetEntityContainerQueryCache");
+        getCache.setAccessible(true);
+        final Object cache = getCache.invoke(hopper);
+
+        assertEquals(hopperPos.above(), field(cache, "sourceContainerPos"));
+        assertEquals(hopperPos.below(), field(cache, "attachedContainerPos"));
+        assertEquals(new AABB(hopperPos.above()), field(cache, "sourceContainerSearchBox"));
+        assertEquals(new AABB(hopperPos.below()), field(cache, "attachedContainerSearchBox"));
+
+        final BlockState eastState = downState.setValue(HopperBlock.FACING, Direction.EAST);
+        hopper.setBlockState(eastState);
+        assertSame(cache, getCache.invoke(hopper), "Changing facing should update, not replace, the retained buffer");
+        assertEquals(hopperPos.east(), field(cache, "attachedContainerPos"));
+        assertEquals(new AABB(hopperPos.east()), field(cache, "attachedContainerSearchBox"));
+        assertTrue(((List<?>)field(cache, "queryResults")).isEmpty());
+    }
+
+    @Test
+    void fixedHopperQueryFillsTheRetainedListWithoutAllocatingAnotherListOrBox() throws IOException {
+        final ClassNode hopper = classNode(HopperBlockEntity.class);
+        final MethodNode query = method(
+            hopper,
+            "getEntityContainer",
+            "(Lnet/minecraft/world/level/Level;Lnet/minecraft/world/phys/AABB;Ljava/util/List;)Lnet/minecraft/world/Container;"
+        );
+
+        assertTrue(
+            invocations(query).stream().anyMatch(call ->
+                call.owner.equals("net/minecraft/world/level/Level") && call.name.equals("leavesX$getEntitiesOfClass")
+            ),
+            "The retained query buffer must be filled by the world's class-indexed entity lookup"
+        );
+        assertEquals(0L, allocations(query, "java/util/ArrayList"));
+        assertEquals(0L, allocations(query, "net/minecraft/world/phys/AABB"));
+        assertTrue(
+            invocations(method(hopper, "suckInItems")).stream().anyMatch(call ->
+                call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                    && call.name.equals("blockEntityOptimizations")
+            ),
+            "The fixed-coordinate fast path must remain configurable"
+        );
+    }
+
+    @Test
+    void levelFillOverloadDoesNotAllocateItsOwnResultList() throws IOException {
+        final MethodNode fill = method(
+            classNode(Level.class),
+            "leavesX$getEntitiesOfClass",
+            "(Ljava/lang/Class;Lnet/minecraft/world/phys/AABB;Ljava/util/function/Predicate;Ljava/util/List;)V"
+        );
+
+        assertEquals(0L, allocations(fill, "java/util/ArrayList"));
+        assertFalse(
+            invocations(fill).stream().anyMatch(call -> call.name.equals("getEntitiesOfClass")),
+            "The fill overload should enter Moonrise directly instead of allocating through the list-returning API"
+        );
+    }
+
+    private static void assertField(final ClassNode owner, final String name, final String descriptor) {
+        final List<FieldNode> matches = owner.fields.stream()
+            .filter(field -> field.name.equals(name) && field.desc.equals(descriptor))
+            .toList();
+        assertEquals(1, matches.size(), "Missing retained hopper field " + name);
+    }
+
+    private static Object field(final Object owner, final String name) throws NoSuchFieldException, IllegalAccessException {
+        final Field field = owner.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        return field.get(owner);
+    }
+
+    private static long allocations(final MethodNode method, final String internalName) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .filter(instruction -> instruction.getOpcode() == Opcodes.NEW && instruction.desc.equals(internalName))
+            .count();
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        return classNode(owner.getName());
+    }
+
+    private static ClassNode classNode(final String className) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName + descriptor));
+    }
+}
