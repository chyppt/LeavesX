+        final int taskCount = taskCountFor(size, computeLaneCount(), minimumItemsPerTask);
         if (taskCount <= 1) {
             insufficientPartitionFallbackCount.incrementAndGet();
             workloadCounters.insufficientPartitionFallbacks.incrementAndGet();
