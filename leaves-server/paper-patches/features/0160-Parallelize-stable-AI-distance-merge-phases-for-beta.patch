+    @Test
+    void preservesStableOrderAcrossParallelRadixMergeBoundaries() {
+        final Random random = new Random(0x42657461313339L);
+        LeavesXComputeExecutor.configure(4, 16);
+
+        // These sizes cross radix partition and merge-width boundaries. Repeated coordinates make equal-distance
+        // ordering observable, while the fixed seed keeps the regression deterministic.
+        for (final int size : new int[] {64, 65, 127, 128, 129, 191, 255, 256, 257, 511, 512, 513, 1_027, 2_049}) {
+            final double[] x = new double[size];
+            final double[] y = new double[size];
+            final double[] z = new double[size];
+            for (int index = 0; index < size; index++) {
+                x[index] = random.nextInt(33) - 16;
+                y[index] = random.nextInt(9) - 4;
+                z[index] = random.nextInt(33) - 16;
+            }
+
+            final int[] expected = referenceOrder(x, y, z, 1.25, -2.5, 3.75);
+            assertArrayEquals(
+                expected,
+                StableDistanceSorter.sort(x, y, z, 1.25, -2.5, 3.75, true, 64),
+                "parallel stable order changed at size " + size
+            );
+        }
+    }
