diff --git a/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
index 8b2f2b5c46925b1aabc92b825a5c3a8c6813162f..7eb3d5ec98531855ebcb98ec6a04b5559355334c 100644
--- a/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
+++ b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
@@ -17,6 +17,8 @@ public final class StableDistanceSorter {
     /** Below this size the vanilla TimSort path is consistently competitive and avoids workspace setup. */
     public static final int MINIMUM_OPTIMIZED_ENTITY_COUNT = 64;
     private static final int RADIX_BUCKETS = 256;
+    /** Avoids dispatching a worker task for the final one or two merge pairs. */
+    private static final int MIN_PARALLEL_MERGE_PAIRS = 4;
     private static final int INITIAL_WORKSPACE_CAPACITY = 64;
     private static final ThreadLocal<Workspace> WORKSPACE = ThreadLocal.withInitial(() -> new Workspace(true));
 
@@ -133,11 +135,57 @@ public final class StableDistanceSorter {
         final int rangeSize = divideCeil(size, completedPartitions);
         for (int width = rangeSize; width < size; width = nextMergeWidth(width, size)) {
             final int step = width >= size - width ? size : width << 1;
-            for (int start = 0; start < size - width; start += step) {
-                final int middle = start + width;
-                final int end = Math.min(size, start + step);
-                mergeByKey(workspace.order, workspace.scratch, workspace.keys, start, middle, end);
+            final int pairCount = divideCeil(size, step);
+            if (pairCount >= MIN_PARALLEL_MERGE_PAIRS) {
+                final int mergeWidth = width;
+                final int mergeStep = step;
+                final int mergedPartitions = LeavesXComputeExecutor.invokeRangesWithCount(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                    pairCount,
+                    2,
+                    1,
+                    (taskIndex, startPair, endPair) -> mergePairs(
+                        workspace.order,
+                        workspace.scratch,
+                        workspace.keys,
+                        size,
+                        mergeWidth,
+                        mergeStep,
+                        startPair,
+                        endPair
+                    )
+                );
+                if (mergedPartitions == 0) {
+                    // A failed merge can leave individual disjoint ranges completed. Rebuild from identity so the
+                    // fallback never consumes a mixture of pre-merge and post-merge ranges.
+                    initializeOrder(workspace.order, size);
+                    stableRadixRange(workspace.order, workspace.scratch, workspace.keys, 0, size, workspace.offsets, 0);
+                    return;
+                }
+            } else {
+                mergePairs(workspace.order, workspace.scratch, workspace.keys, size, width, step, 0, pairCount);
+            }
+        }
+    }
+
+    /** Merges independent ordered range pairs; callers may safely assign disjoint pair indexes to workers. */
+    private static void mergePairs(
+        final int[] order,
+        final int[] scratch,
+        final long[] keys,
+        final int size,
+        final int width,
+        final int step,
+        final int startPair,
+        final int endPair
+    ) {
+        for (int pair = startPair; pair < endPair; pair++) {
+            final int start = pair * step;
+            final int middle = start + width;
+            if (middle >= size) {
+                continue;
             }
+            mergeByKey(order, scratch, keys, start, middle, Math.min(size, start + step));
         }
     }
 
