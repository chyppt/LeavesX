@@ -0,0 +1,80 @@
+package org.leavesx.leavesx.runtime;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.concurrent.atomic.AtomicReference;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class GlobalCoordinatorTest {
+
+    private final GlobalCoordinator coordinator = GlobalCoordinator.getInstance();
+
+    @BeforeEach
+    void resetCoordinator() {
+        this.coordinator.resetForTests();
+    }
+
+    @AfterEach
+    void cleanUpCoordinator() {
+        this.coordinator.resetForTests();
+    }
+
+    @Test
+    void advancesByTheNumberOfRepresentedSchedulerPeriods() {
+        final long first = this.coordinator.beginEpoch(1L);
+        this.coordinator.completeEpoch(first);
+        final long second = this.coordinator.beginEpoch(3L);
+        this.coordinator.completeEpoch(second);
+
+        assertEquals(1L, first);
+        assertEquals(4L, second);
+        assertEquals(second, this.coordinator.completedEpoch());
+        assertFalse(this.coordinator.isEpochActive());
+    }
+
+    @Test
+    void rejectsReentryAndMismatchedCompletion() {
+        final long epoch = this.coordinator.beginEpoch(1L);
+
+        assertThrows(IllegalStateException.class, () -> this.coordinator.beginEpoch(1L));
+        assertThrows(IllegalStateException.class, () -> this.coordinator.completeEpoch(epoch + 1L));
+
+        this.coordinator.abortEpoch(epoch);
+        assertEquals(0L, this.coordinator.completedEpoch());
+        assertFalse(this.coordinator.isEpochActive());
+    }
+
+    @Test
+    void rejectsNonPositiveUpstreamPeriodCount() {
+        assertThrows(IllegalArgumentException.class, () -> this.coordinator.beginEpoch(0L));
+        assertFalse(this.coordinator.isEpochActive());
+    }
+
+    @Test
+    void rejectsCompletionFromAnotherThread() throws InterruptedException {
+        final long epoch = this.coordinator.beginEpoch(1L);
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread foreignThread = new Thread(() -> {
+            try {
+                this.coordinator.completeEpoch(epoch);
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "leavesx-foreign-test-thread");
+
+        foreignThread.start();
+        foreignThread.join();
+
+        assertTrue(failure.get() instanceof IllegalStateException);
+        assertTrue(failure.get().getMessage().contains("owner"));
+        assertTrue(this.coordinator.isEpochActive());
+        this.coordinator.abortEpoch(epoch);
+    }
+}
