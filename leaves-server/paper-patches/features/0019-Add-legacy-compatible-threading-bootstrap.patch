@@ -0,0 +1,58 @@
+package org.leavesx.leavesx.config;
+
+import org.spongepowered.configurate.CommentedConfigurationNode;
+
+/** Writes the supported LeavesX runtime tree into a Configurate document. */
+public final class LeavesXConfigWriter {
+
+    private LeavesXConfigWriter() {
+    }
+
+    /**
+     * Writes every supported runtime key, overriding colliding imported keys with validated LeavesX values.
+     *
+     * <p>This method is shared by default-file creation and Leaves migration so both paths publish the same safe
+     * compatibility contract.</p>
+     *
+     * @param node target document root
+     * @param config validated runtime values
+     */
+    public static void write(final CommentedConfigurationNode node, final LeavesXConfig config) {
+        node.node("config-version")
+            .comment("LeavesX schema version. Newer versions are rejected to prevent destructive downgrades.")
+            .raw(config.configVersion());
+        node.node("threading", "mode")
+            .comment("Safe default. technical-strict remains unavailable until ownership and epoch barriers are complete.")
+            .raw(config.threadingMode().serializedName());
+        node.node("threading", "legacy-plugin-policy")
+            .comment("How unmarked Bukkit plugins will be handled once strict multi-domain mode is enabled.")
+            .raw(config.legacyPluginPolicy().serializedName());
+        node.node("threading", "workers", "tick-threads")
+            .comment("Future strict-mode worker request. legacy-compatible always uses one tick worker.")
+            .raw(config.tickThreads() == 0 ? "auto" : config.tickThreads());
+        node.node("threading", "workers", "reserve-cores")
+            .comment("Future strict-mode capacity reserved for networking, chunk I/O and the JVM.")
+            .raw(config.reserveCores());
+        node.node("threading", "workers", "max-physical-core-utilization")
+            .comment("Future strict-mode upper bound for automatically selected tick workers.")
+            .raw(config.maxPhysicalCoreUtilization());
+        node.node("threading", "epoch", "target-tps")
+            .comment("Behavior-compatible modes require the vanilla 20 TPS logical clock.")
+            .raw(config.targetTps());
+        node.node("threading", "epoch", "warn-after-ms")
+            .comment("Log a rate-limited warning when a completed global epoch exceeds this duration.")
+            .raw(config.epochWarnAfterMillis());
+        node.node("threading", "epoch", "watchdog-after-ms")
+            .comment("Reserved fail-stop threshold for the future unified-epoch watchdog.")
+            .raw(config.epochWatchdogAfterMillis());
+        node.node("technical-strict", "unified-epochs")
+            .comment("Mandatory for the future technical-strict mode.")
+            .raw(config.unifiedEpochs());
+        node.node("determinism", "stable-task-ordering")
+            .comment("Mandatory compatibility invariant; wall-clock worker completion never decides game order.")
+            .raw(config.deterministicTaskOrdering());
+        node.node("determinism", "preserve-vanilla-rng")
+            .comment("Mandatory compatibility invariant; RNG types, seeds and consumption order remain unchanged.")
+            .raw(config.preserveVanillaRng());
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java b/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
new file mode 100644
index 0000000000000000000000000000000000000000..2f5e6a8f15eabe446443163196d3af50d32ab17f
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
@@ -0,0 +1,35 @@
+package org.leavesx.leavesx.config;
+
+import java.util.Objects;
+
+/**
+ * Lock-free access point for the immutable configuration snapshot.
+ *
+ * <p>The configuration is published once during bootstrap, before the scheduler starts. The volatile reference keeps
+ * publication safe while leaving tick-path reads allocation-free and lock-free.</p>
+ */
+public final class LeavesXRuntime {
+
+    private static volatile LeavesXConfig configuration = LeavesXConfig.safeDefaults();
+
+    private LeavesXRuntime() {
+    }
+
+    /**
+     * Returns the currently published immutable snapshot.
+     *
+     * @return current LeavesX configuration
+     */
+    public static LeavesXConfig configuration() {
+        return configuration;
+    }
+
+    /**
+     * Publishes a fully validated bootstrap snapshot.
+     *
+     * @param next validated immutable configuration
+     */
+    static void publish(final LeavesXConfig next) {
+        configuration = Objects.requireNonNull(next, "next");
+    }
+}
