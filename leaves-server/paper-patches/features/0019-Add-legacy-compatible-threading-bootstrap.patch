@@ -0,0 +1,44 @@
+package org.leavesx.leavesx.config;
+
+/**
+ * Selects the compatibility contract used by the LeavesX runtime.
+ */
+public enum LeavesXThreadingMode {
+    /** Keep all live game state on the traditional single simulation domain. */
+    LEGACY_COMPATIBLE("legacy-compatible"),
+    /** Allow only explicitly region-safe domains after all ownership checks pass. */
+    TECHNICAL_STRICT("technical-strict"),
+    /** Experimental Folia-style throughput mode; never selected implicitly. */
+    THROUGHPUT("throughput");
+
+    private final String serializedName;
+
+    LeavesXThreadingMode(final String serializedName) {
+        this.serializedName = serializedName;
+    }
+
+    /**
+     * Returns the stable YAML representation.
+     *
+     * @return serialized mode name
+     */
+    public String serializedName() {
+        return this.serializedName;
+    }
+
+    /**
+     * Parses a mode without accepting ambiguous aliases.
+     *
+     * @param value configured value
+     * @return parsed mode
+     * @throws IllegalArgumentException when the value is unknown
+     */
+    public static LeavesXThreadingMode parse(final String value) {
+        for (final LeavesXThreadingMode mode : values()) {
+            if (mode.serializedName.equals(value)) {
+                return mode;
+            }
+        }
+        throw new IllegalArgumentException("Unknown LeavesX threading mode: " + value);
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrator.java b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrator.java
