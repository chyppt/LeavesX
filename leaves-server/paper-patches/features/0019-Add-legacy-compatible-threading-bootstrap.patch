@@ -0,0 +1,13 @@
+package org.leavesx.leavesx.config;
+
+/** Fails bootstrap when LeavesX configuration cannot be safely interpreted. */
+public final class LeavesXConfigException extends RuntimeException {
+
+    public LeavesXConfigException(final String message) {
+        super(message);
+    }
+
+    public LeavesXConfigException(final String message, final Throwable cause) {
+        super(message, cause);
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
new file mode 100644
index 0000000000000000000000000000000000000000..c74344e6eeaf992681660df34065f6cb92b16653
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
@@ -0,0 +1,203 @@
+package org.leavesx.leavesx.config;
+
+import io.papermc.paper.configuration.ConfigurationLoaders;
+import io.papermc.paper.util.AtomicFiles;
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.loader.HeaderMode;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+/** Loads and validates the LeavesX global configuration at bootstrap. */
+public final class LeavesXConfigLoader {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXConfigLoader.class);
+    private static final String HEADER = "LeavesX global configuration. Defaults preserve legacy-compatible behavior.";
+
+    private LeavesXConfigLoader() {
+    }
+
+    /**
+     * Loads a configuration, creating a documented safe default atomically when absent.
+     *
+     * @param path target configuration path
+     * @return immutable runtime snapshot
+     * @throws LeavesXConfigException when YAML is invalid or a value violates the runtime contract
+     */
+    public static LeavesXConfig load(final Path path) {
+        final Path normalized = path.toAbsolutePath().normalize();
+        try {
+            if (Files.notExists(normalized)) {
+                final LeavesXConfig defaults = LeavesXConfig.safeDefaults();
+                save(normalized, defaults);
+                LOGGER.info("Created LeavesX configuration at {} using legacy-compatible defaults", normalized);
+                return defaults;
+            }
+            if (!Files.isRegularFile(normalized)) {
+                throw new LeavesXConfigException("LeavesX configuration is not a regular file: " + normalized);
+            }
+            return fromNode(ConfigurationLoaders.naturallySortedWithoutHeader(normalized).load(), normalized);
+        } catch (final LeavesXConfigException ex) {
+            throw ex;
+        } catch (final Exception ex) {
+            throw new LeavesXConfigException("Unable to load LeavesX configuration: " + normalized, ex);
+        }
+    }
+
+    static LeavesXConfig fromNode(final ConfigurationNode node, final Path path) {
+        try {
+            if (node.virtual() || !node.isMap()) {
+                throw new IllegalArgumentException("the document root must be a YAML mapping");
+            }
+            final int version = readInt(
+                node.node("config-version"), "config-version", LeavesXConfig.CURRENT_CONFIG_VERSION
+            );
+            if (version > LeavesXConfig.CURRENT_CONFIG_VERSION) {
+                throw new IllegalArgumentException(
+                    "config-version " + version + " is newer than supported version "
+                        + LeavesXConfig.CURRENT_CONFIG_VERSION
+                );
+            }
+
+            final String modeValue = readString(
+                node.node("threading", "mode"), "threading.mode", "legacy-compatible"
+            );
+            final String policyValue = readString(
+                node.node("threading", "legacy-plugin-policy"), "threading.legacy-plugin-policy", "single-domain"
+            );
+            final LeavesXThreadingMode mode = LeavesXThreadingMode.parse(modeValue);
+            if (mode != LeavesXThreadingMode.LEGACY_COMPATIBLE) {
+                throw new IllegalArgumentException(
+                    "threading.mode " + mode.serializedName()
+                        + " is not available until LeavesX ownership and unified-epoch barriers are complete"
+                );
+            }
+            return new LeavesXConfig(
+                version,
+                mode,
+                LeavesXConfig.LegacyPluginPolicy.parse(policyValue),
+                readTickThreads(node.node("threading", "workers", "tick-threads")),
+                readInt(node.node("threading", "workers", "reserve-cores"), "threading.workers.reserve-cores", 2),
+                readDouble(
+                    node.node("threading", "workers", "max-physical-core-utilization"),
+                    "threading.workers.max-physical-core-utilization",
+                    0.80
+                ),
+                readInt(node.node("threading", "epoch", "target-tps"), "threading.epoch.target-tps", 20),
+                readInt(node.node("threading", "epoch", "warn-after-ms"), "threading.epoch.warn-after-ms", 50),
+                readInt(
+                    node.node("threading", "epoch", "watchdog-after-ms"),
+                    "threading.epoch.watchdog-after-ms",
+                    10_000
+                ),
+                readBoolean(node.node("technical-strict", "unified-epochs"), "technical-strict.unified-epochs", true),
+                readBoolean(
+                    node.node("determinism", "stable-task-ordering"), "determinism.stable-task-ordering", true
+                ),
+                readBoolean(node.node("determinism", "preserve-vanilla-rng"), "determinism.preserve-vanilla-rng", true)
+            );
+        } catch (final IllegalArgumentException ex) {
+            throw new LeavesXConfigException("Invalid LeavesX configuration at " + path + ": " + ex.getMessage(), ex);
+        }
+    }
+
+    private static void save(final Path path, final LeavesXConfig config) throws IOException, ConfigurateException {
+        final Path parent = path.getParent();
+        if (parent != null) {
+            Files.createDirectories(parent);
+        }
+        AtomicFiles.atomicWrite(path, temporary -> {
+            final CommentedConfigurationNode node = CommentedConfigurationNode.root(
+                ConfigurationLoaders.naturallySorted().build().defaultOptions().header(HEADER)
+            );
+            LeavesXConfigWriter.write(node, config);
+            final YamlConfigurationLoader loader = ConfigurationLoaders.naturallySorted()
+                .headerMode(HeaderMode.PRESET)
+                .path(temporary)
+                .build();
+            loader.save(node);
+            try (FileChannel channel = FileChannel.open(temporary, StandardOpenOption.WRITE)) {
+                channel.force(true);
+            }
+        });
+    }
+
+    private static int readTickThreads(final ConfigurationNode node) {
+        if (node.virtual()) {
+            return 0;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof String value) {
+            if (value.equals("auto")) {
+                return 0;
+            }
+            throw invalidType("threading.workers.tick-threads", "'auto' or an integer", raw);
+        }
+        return readInt(node, "threading.workers.tick-threads", 0);
+    }
+
+    private static String readString(final ConfigurationNode node, final String path, final String defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof String value) {
+            return value;
+        }
+        throw invalidType(path, "a string", raw);
+    }
+
+    private static int readInt(final ConfigurationNode node, final String path, final int defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (!(raw instanceof Byte || raw instanceof Short || raw instanceof Integer || raw instanceof Long)) {
+            throw invalidType(path, "an integer", raw);
+        }
+        final long longValue = ((Number) raw).longValue();
+        if (longValue < Integer.MIN_VALUE || longValue > Integer.MAX_VALUE) {
+            throw new IllegalArgumentException(path + " is outside the supported integer range");
+        }
+        return (int) longValue;
+    }
+
+    private static double readDouble(final ConfigurationNode node, final String path, final double defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof Number number) {
+            return number.doubleValue();
+        }
+        throw invalidType(path, "a number", raw);
+    }
+
+    private static boolean readBoolean(final ConfigurationNode node, final String path, final boolean defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof Boolean value) {
+            return value;
+        }
+        throw invalidType(path, "a boolean", raw);
+    }
+
+    private static IllegalArgumentException invalidType(
+        final String path,
+        final String expected,
+        final Object actual
+    ) {
+        return new IllegalArgumentException(
+            path + " must be " + expected + ", but was " + (actual == null ? "null" : actual.getClass().getSimpleName())
+        );
+    }
+}
