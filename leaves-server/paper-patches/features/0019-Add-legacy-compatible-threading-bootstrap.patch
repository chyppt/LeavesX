diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..c995d68fb9a9be27e2839523b46f4a5aad6cce25
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
@@ -0,0 +1,123 @@
+package org.leavesx.leavesx.config;
+
+import java.util.Objects;
+
+/**
+ * Immutable LeavesX runtime configuration.
+ *
+ * <p>The first runtime slice intentionally exposes only controls that can be enforced without changing game logic.
+ * Keeping the snapshot immutable lets tick threads read it without locks while configuration reload remains a future
+ * quiescent-point operation.</p>
+ */
+public record LeavesXConfig(
+    int configVersion,
+    LeavesXThreadingMode threadingMode,
+    LegacyPluginPolicy legacyPluginPolicy,
+    int tickThreads,
+    int reserveCores,
+    double maxPhysicalCoreUtilization,
+    int targetTps,
+    int epochWarnAfterMillis,
+    int epochWatchdogAfterMillis,
+    boolean unifiedEpochs,
+    boolean deterministicTaskOrdering,
+    boolean preserveVanillaRng
+) {
+
+    public static final int CURRENT_CONFIG_VERSION = 1;
+    public static final int DEFAULT_TARGET_TPS = 20;
+
+    /**
+     * Validates all values at the publication boundary.
+     */
+    public LeavesXConfig {
+        Objects.requireNonNull(threadingMode, "threadingMode");
+        Objects.requireNonNull(legacyPluginPolicy, "legacyPluginPolicy");
+        if (configVersion != CURRENT_CONFIG_VERSION) {
+            throw new IllegalArgumentException(
+                "LeavesX config-version must be " + CURRENT_CONFIG_VERSION + ", but was " + configVersion
+            );
+        }
+        if (tickThreads < 0) {
+            throw new IllegalArgumentException("threading.workers.tick-threads must be zero (auto) or positive");
+        }
+        if (reserveCores < 0) {
+            throw new IllegalArgumentException("threading.workers.reserve-cores must not be negative");
+        }
+        if (!Double.isFinite(maxPhysicalCoreUtilization) || maxPhysicalCoreUtilization <= 0.0
+            || maxPhysicalCoreUtilization > 1.0) {
+            throw new IllegalArgumentException("threading.workers.max-physical-core-utilization must be in (0, 1]");
+        }
+        if (targetTps != DEFAULT_TARGET_TPS) {
+            throw new IllegalArgumentException("threading.epoch.target-tps must remain 20 in behavior-compatible modes");
+        }
+        if (epochWarnAfterMillis < 1 || epochWatchdogAfterMillis < epochWarnAfterMillis) {
+            throw new IllegalArgumentException("Epoch warning/watchdog thresholds are invalid");
+        }
+        if (!unifiedEpochs) {
+            throw new IllegalArgumentException("technical-strict.unified-epochs must remain true");
+        }
+        if (!deterministicTaskOrdering) {
+            throw new IllegalArgumentException("determinism.stable-task-ordering must remain true");
+        }
+        if (!preserveVanillaRng) {
+            throw new IllegalArgumentException("determinism.preserve-vanilla-rng must remain true");
+        }
+    }
+
+    /**
+     * Returns the safe default used when no LeavesX file exists.
+     *
+     * @return immutable legacy-compatible defaults
+     */
+    public static LeavesXConfig safeDefaults() {
+        return new LeavesXConfig(
+            CURRENT_CONFIG_VERSION,
+            LeavesXThreadingMode.LEGACY_COMPATIBLE,
+            LegacyPluginPolicy.SINGLE_DOMAIN,
+            0,
+            2,
+            0.80,
+            DEFAULT_TARGET_TPS,
+            50,
+            10_000,
+            true,
+            true,
+            true
+        );
+    }
+
+    /**
+     * Whether the selected contract eventually permits multiple simulation domains.
+     *
+     * @return {@code true} for strict or throughput contracts
+     */
+    public boolean allowsMultipleDomains() {
+        return this.threadingMode != LeavesXThreadingMode.LEGACY_COMPATIBLE;
+    }
+
+    /** Policy for plugins without an explicit region-safe declaration. */
+    public enum LegacyPluginPolicy {
+        SINGLE_DOMAIN("single-domain"),
+        REJECT("reject");
+
+        private final String serializedName;
+
+        LegacyPluginPolicy(final String serializedName) {
+            this.serializedName = serializedName;
+        }
+
+        public String serializedName() {
+            return this.serializedName;
+        }
+
+        public static LegacyPluginPolicy parse(final String value) {
+            for (final LegacyPluginPolicy policy : values()) {
+                if (policy.serializedName.equals(value)) {
+                    return policy;
+                }
+            }
+            throw new IllegalArgumentException("Unknown LeavesX legacy-plugin-policy: " + value);
+        }
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java
new file mode 100644
index 0000000000000000000000000000000000000000..977e787b06d419d2cf8bfb184b135772f40f1d71
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java
@@ -0,0 +1,53 @@
+package org.leavesx.leavesx.config;
+
+import java.io.File;
+import java.nio.file.Path;
+import joptsimple.OptionSet;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Initializes the immutable LeavesX runtime configuration before world creation. */
+public final class LeavesXConfigBootstrap {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXConfigBootstrap.class);
+
+    private LeavesXConfigBootstrap() {
+    }
+
+    /**
+     * Loads the configured file and publishes it to the runtime.
+     *
+     * @param options parsed server command-line options
+     */
+    public static void load(final OptionSet options) {
+        final Path path = ((File) options.valueOf("leavesx-settings")).toPath();
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        LeavesXRuntime.publish(config);
+        LOGGER.info(
+            "LeavesX threading mode: {} (legacy plugin policy: {}, requested strict workers: {})",
+            config.threadingMode().serializedName(),
+            config.legacyPluginPolicy().serializedName(),
+            config.tickThreads() == 0 ? "auto" : config.tickThreads()
+        );
+        LOGGER.info(
+            "LeavesX worker limits: reserve cores {}, max physical core utilization {}",
+            config.reserveCores(),
+            config.maxPhysicalCoreUtilization()
+        );
+        LOGGER.info(
+            "LeavesX epoch settings: {} TPS, warn after {} ms, future watchdog threshold {} ms",
+            config.targetTps(),
+            config.epochWarnAfterMillis(),
+            config.epochWatchdogAfterMillis()
+        );
+        LOGGER.info(
+            "LeavesX compatibility invariants: unified epochs {}, stable task ordering {}, preserve vanilla RNG {}",
+            config.unifiedEpochs(),
+            config.deterministicTaskOrdering(),
+            config.preserveVanillaRng()
+        );
+        LOGGER.info(
+            "LeavesX compatibility baseline is active: one tick worker; Folia region ownership checks remain enabled"
+        );
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigException.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigException.java
