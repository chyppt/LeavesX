@@ -0,0 +1,138 @@
+package org.leavesx.leavesx.runtime;
+
+import java.util.concurrent.TimeUnit;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Coordinates the first LeavesX logical epoch boundary.
+ *
+ * <p>This coordinator deliberately does not schedule game work. It records one global epoch around Folia's existing
+ * global tick, giving later domain barriers a stable protocol without changing entity, block or event ordering today.</p>
+ */
+public final class GlobalCoordinator {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(GlobalCoordinator.class);
+    private static final GlobalCoordinator INSTANCE = new GlobalCoordinator();
+    private static final long SLOW_EPOCH_LOG_INTERVAL_NANOS = TimeUnit.SECONDS.toNanos(5L);
+
+    private volatile long completedEpoch;
+    private volatile long activeEpoch = -1L;
+    private volatile long activeEpochStartNanos;
+    private volatile Thread activeEpochThread;
+    private long lastSlowEpochLogNanos;
+
+    private GlobalCoordinator() {
+    }
+
+    public static GlobalCoordinator getInstance() {
+        return INSTANCE;
+    }
+
+    /**
+     * Begins one globally ordered logical epoch on the current global tick thread.
+     *
+     * @param upstreamPeriods number of Folia periods represented by this invocation
+     * @return new LeavesX epoch identifier
+     */
+    public long beginEpoch(final long upstreamPeriods) {
+        if (this.activeEpoch >= 0L) {
+            throw new IllegalStateException("LeavesX logical epoch re-entered before completion: " + this.activeEpoch);
+        }
+        if (upstreamPeriods < 1L) {
+            throw new IllegalArgumentException("Folia tick periods must be positive");
+        }
+        final long epoch;
+        try {
+            epoch = Math.addExact(this.completedEpoch, upstreamPeriods);
+        } catch (final ArithmeticException ex) {
+            throw new IllegalStateException("LeavesX logical epoch counter overflowed", ex);
+        }
+        this.activeEpochThread = Thread.currentThread();
+        this.activeEpochStartNanos = System.nanoTime();
+        // Publish the epoch last so observers cannot see an active epoch without its ownership metadata.
+        this.activeEpoch = epoch;
+        return epoch;
+    }
+
+    /**
+     * Completes the active epoch and emits bounded diagnostics for slow epochs.
+     *
+     * @param epoch active epoch identifier returned by {@link #beginEpoch(long)}
+     */
+    public void completeEpoch(final long epoch) {
+        this.requireActiveEpoch(epoch, "completed");
+        this.requireOwnerThread(epoch, "completed");
+        final long now = System.nanoTime();
+        final long elapsedNanos = now - this.activeEpochStartNanos;
+
+        final LeavesXConfig config = LeavesXRuntime.configuration();
+        final long warnNanos = config.epochWarnAfterMillis() * 1_000_000L;
+        if (elapsedNanos >= warnNanos && (this.lastSlowEpochLogNanos == 0L
+            || now - this.lastSlowEpochLogNanos >= SLOW_EPOCH_LOG_INTERVAL_NANOS)) {
+            this.lastSlowEpochLogNanos = now;
+            LOGGER.warn("LeavesX logical epoch {} completed in {} ms", epoch, elapsedNanos / 1_000_000.0);
+        }
+        this.completedEpoch = epoch;
+        this.activeEpochThread = null;
+        this.activeEpoch = -1L;
+    }
+
+    /**
+     * Clears a failed epoch without publishing it as completed.
+     *
+     * @param epoch active epoch identifier returned by {@link #beginEpoch(long)}
+     */
+    public void abortEpoch(final long epoch) {
+        this.requireActiveEpoch(epoch, "aborted");
+        this.requireOwnerThread(epoch, "aborted");
+        this.activeEpochThread = null;
+        this.activeEpoch = -1L;
+    }
+
+    /**
+     * Returns the last successfully completed logical epoch.
+     *
+     * @return completed epoch, or zero before the first global tick
+     */
+    public long completedEpoch() {
+        return this.completedEpoch;
+    }
+
+    /**
+     * Returns whether any epoch is currently active.
+     *
+     * @return {@code true} between begin and complete/abort
+     */
+    public boolean isEpochActive() {
+        return this.activeEpoch >= 0L;
+    }
+
+    void resetForTests() {
+        this.activeEpoch = -1L;
+        this.activeEpochStartNanos = 0L;
+        this.activeEpochThread = null;
+        this.completedEpoch = 0L;
+        this.lastSlowEpochLogNanos = 0L;
+    }
+
+    private void requireActiveEpoch(final long epoch, final String action) {
+        if (this.activeEpoch != epoch) {
+            throw new IllegalStateException(
+                "LeavesX logical epoch " + epoch + " cannot be " + action + "; active epoch is " + this.activeEpoch
+            );
+        }
+    }
+
+    private void requireOwnerThread(final long epoch, final String action) {
+        final Thread owner = this.activeEpochThread;
+        if (owner != Thread.currentThread()) {
+            throw new IllegalStateException(
+                "LeavesX logical epoch " + epoch + " cannot be " + action + " by thread '"
+                    + Thread.currentThread().getName() + "'; owner is '" + (owner == null ? "none" : owner.getName()) + "'"
+            );
+        }
+    }
+}
