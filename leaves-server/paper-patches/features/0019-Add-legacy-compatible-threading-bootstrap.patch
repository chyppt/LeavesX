+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+@Normal
+class LeavesXConfigLoaderTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void createsAndReloadsSafeDefaults() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("config").resolve("leavesx.yml");
+
+        final LeavesXConfig created = LeavesXConfigLoader.load(path);
+        final LeavesXConfig reloaded = LeavesXConfigLoader.load(path);
+
+        assertEquals(LeavesXConfig.safeDefaults(), created);
+        assertEquals(created, reloaded);
+        assertTrue(Files.isRegularFile(path));
+        assertTrue(Files.readString(path).contains("mode: legacy-compatible"));
+        assertFalse(Files.readString(path).contains("mode: technical-strict"));
+    }
+
+    @Test
+    void loadsMigratedLeavesTreeWhileIgnoringPreservedKeys() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              mode: legacy-compatible
+            settings:
+              modify:
+                fakeplayer:
+                  enable: true
+            migration:
+              id: leaves-26.1.2-to-leavesx-26.1.2-v1
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+
+        assertEquals(LeavesXConfig.safeDefaults(), config);
+    }
+
+    @Test
+    void loadsExplicitWorkerAndEpochSettings() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              mode: legacy-compatible
+              legacy-plugin-policy: reject
+              workers:
+                tick-threads: 6
+                reserve-cores: 3
+                max-physical-core-utilization: 0.75
+              epoch:
+                target-tps: 20
+                warn-after-ms: 80
+                watchdog-after-ms: 12000
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+
+        assertEquals(LeavesXConfig.LegacyPluginPolicy.REJECT, config.legacyPluginPolicy());
+        assertEquals(6, config.tickThreads());
+        assertEquals(3, config.reserveCores());
+        assertEquals(0.75, config.maxPhysicalCoreUtilization());
+        assertEquals(80, config.epochWarnAfterMillis());
+        assertEquals(12_000, config.epochWatchdogAfterMillis());
+    }
+
+    @Test
+    void rejectsUnavailableMultiDomainMode() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              mode: technical-strict
+            """);
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("not available"));
+    }
+
+    @Test
+    void rejectsWrongScalarTypeWithConfigurationPath() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              mode: legacy-compatible
+              epoch:
+                warn-after-ms: fifty
+            """);
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("threading.epoch.warn-after-ms"));
+        assertTrue(exception.getMessage().contains(path.toAbsolutePath().toString()));
+    }
+
+    @Test
+    void rejectsDecimalForIntegerSetting() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              workers:
+                reserve-cores: 2.0
+            """);
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("threading.workers.reserve-cores must be an integer"));
+    }
+
+    @Test
+    void rejectsUnsupportedOlderSchema() throws IOException {
+        final Path path = write("config-version: 0\n");
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("config-version must be 1"));
+    }
+
+    @Test
+    void rejectsNonVanillaTargetTps() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              epoch:
+                target-tps: 30
+            """);
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("must remain 20"));
+    }
+
+    @Test
+    void rejectsWatchdogThresholdBelowWarningThreshold() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            threading:
+              epoch:
+                warn-after-ms: 100
+                watchdog-after-ms: 99
+            """);
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("thresholds are invalid"));
+    }
+
+    @Test
+    void rejectsDisabledCompatibilityInvariant() throws IOException {
+        final Path path = write("""
+            config-version: 1
+            determinism:
+              preserve-vanilla-rng: false
+            """);
+
+        final LeavesXConfigException exception = assertThrows(
+            LeavesXConfigException.class,
+            () -> LeavesXConfigLoader.load(path)
+        );
+
+        assertTrue(exception.getMessage().contains("preserve-vanilla-rng must remain true"));
+    }
+
+    private Path write(final String content) throws IOException {
+        final Path path = this.temporaryDirectory.resolve("leavesx.yml");
+        Files.writeString(path, content, StandardCharsets.UTF_8);
+        return path;
+    }
+}
