Subject: [PATCH] Test console command context fallback


diff --git a/src/test/java/org/leavesx/leavesx/command/CommandsContextSafetyTest.java b/src/test/java/org/leavesx/leavesx/command/CommandsContextSafetyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e11966982065a2955123aa0e1d1000499d1bb8a3
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/command/CommandsContextSafetyTest.java
@@ -0,0 +1,66 @@
+package org.leavesx.leavesx.command;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.lang.reflect.Method;
+import java.util.concurrent.atomic.AtomicBoolean;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.Commands;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.gamerules.GameRules;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/** Verifies command execution remains safe for console and bootstrap sources without a current world. */
+@Normal
+final class CommandsContextSafetyTest {
+
+    @Test
+    void fallsBackToVanillaRulesWhenSourceHasNoLevelOrServer() throws ReflectiveOperationException {
+        final CommandSourceStack source = mock(CommandSourceStack.class);
+        when(source.getLevel()).thenReturn(null);
+        when(source.getServer()).thenReturn(null);
+
+        final GameRules rules = resolveRules(source);
+
+        assertEquals(65_536, rules.get(GameRules.MAX_COMMAND_SEQUENCE_LENGTH));
+        assertEquals(65_536, rules.get(GameRules.MAX_COMMAND_FORKS));
+    }
+
+    @Test
+    void usesTheOverworldRulesWhenOnlyTheLevelIsMissing() throws ReflectiveOperationException {
+        final CommandSourceStack source = mock(CommandSourceStack.class);
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerLevel overworld = mock(ServerLevel.class);
+        final GameRules rules = mock(GameRules.class);
+        when(source.getLevel()).thenReturn(null);
+        when(source.getServer()).thenReturn(server);
+        when(server.overworld()).thenReturn(overworld);
+        when(overworld.getGameRules()).thenReturn(rules);
+
+        assertSame(rules, resolveRules(source));
+    }
+
+    @Test
+    void topLevelExecutionStillDispatchesWithoutAWorld() {
+        final CommandSourceStack source = mock(CommandSourceStack.class);
+        when(source.getLevel()).thenReturn(null);
+        when(source.getServer()).thenReturn(null);
+        final AtomicBoolean dispatched = new AtomicBoolean();
+
+        Commands.executeCommandInContext(source, ignored -> dispatched.set(true));
+
+        assertTrue(dispatched.get());
+    }
+
+    private static GameRules resolveRules(final CommandSourceStack source) throws ReflectiveOperationException {
+        final Method method = Commands.class.getDeclaredMethod("leavesX$getCommandGameRules", CommandSourceStack.class);
+        method.setAccessible(true);
+        return (GameRules) method.invoke(null, source);
+    }
+}
