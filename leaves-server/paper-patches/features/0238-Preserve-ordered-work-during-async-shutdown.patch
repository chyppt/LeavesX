-                        SHUTDOWN_TIMEOUT.toSeconds(),
-                        executor.getQueue().size()
-                    );
-                    executor.shutdownNow();
+        final long deadline = System.nanoTime() + timeout.toNanos();
+        try {
+            for (final ThreadPoolExecutor executor : uniqueExecutors) {
+                if (!executor.awaitTermination(Math.max(0L, deadline - System.nanoTime()), TimeUnit.NANOSECONDS)) {
+                    LOGGER.error("LeavesX async shutdown timed out; admitted tasks are still draining. "
