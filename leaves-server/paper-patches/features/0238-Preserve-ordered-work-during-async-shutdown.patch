+        shutdown(SHUTDOWN_TIMEOUT);
+    }
+
+    /** Package-private deadline seam for deterministic shutdown regression tests. */
+    static synchronized void shutdown(final Duration timeout) {
+        if (timeout.isNegative()) throw new IllegalArgumentException("Negative shutdown timeout");
         final Map<Workload, ExecutorState> previous = executors;
-        executors = Map.of();
+        configured = false;
         if (previous.isEmpty()) {
-            configured = false;
             return;
         }
 
+        // Keep the closing generation visible until all admitted work is done. Removing it early
+        // makes late saves look like a disabled workload and lets them bypass the old UUID lane.
         final Set<ThreadPoolExecutor> uniqueExecutors = java.util.Collections.newSetFromMap(new IdentityHashMap<>());
         for (final ExecutorState state : previous.values()) {
+            state.closeOwnedAdmission();
             uniqueExecutors.add(state.executor);
         }
         for (final ThreadPoolExecutor executor : uniqueExecutors) {
             executor.shutdown();
         }
 
-        boolean interrupted = false;
-        for (final ThreadPoolExecutor executor : uniqueExecutors) {
-            try {
-                if (!executor.awaitTermination(SHUTDOWN_TIMEOUT.toSeconds(), TimeUnit.SECONDS)) {
