+                    return;
                 }
-            } catch (final InterruptedException interruption) {
-                interrupted = true;
-                executor.shutdownNow();
             }
-        }
-        configured = false;
-        if (interrupted) {
+            // A submission admitted just before closure may still be draining on its caller
+            // after the executor rejects it. Executor termination alone does not cover it.
+            for (final ExecutorState state : previous.values()) {
+                if (!state.awaitDrained(deadline)) {
+                    LOGGER.error("LeavesX caller-thread tasks are still draining; executor replacement remains disabled");
+                    return;
+                }
+            }
+            executors = Map.of();
+        } catch (final InterruptedException interruption) {
+            // Never discard queued saves or leave their completion futures permanently pending.
+            // The old generation remains observable and continues its normal FIFO drain.
+            LOGGER.warn("LeavesX async shutdown interrupted; admitted tasks will continue draining");
             Thread.currentThread().interrupt();
         }
     }
