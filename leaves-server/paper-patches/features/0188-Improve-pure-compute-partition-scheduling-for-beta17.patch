diff --git a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
index b2eff1841eadf663778f56863eb84c511638c716..4ab16d1581c46ec1e108f7f89be2a1e5e45f8769 100644
--- a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
+++ b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
@@ -147,7 +147,26 @@ class LeavesXComputeExecutorTest {
     void automaticWorkerSelectionLeavesHeadroomAndUsesLargeMachines() {
         assertEquals(1, LeavesXComputeExecutor.automaticWorkerCount(2));
         assertEquals(6, LeavesXComputeExecutor.automaticWorkerCount(8));
-        assertEquals(12, LeavesXComputeExecutor.automaticWorkerCount(32));
+        assertEquals(16, LeavesXComputeExecutor.automaticWorkerCount(32));
+    }
+
+    @Test
+    void overPartitionsOnlyWhenTheInputCanFillTheExtraRanges() {
+        assertEquals(1, LeavesXComputeExecutor.partitionCountFor(127, 8, 64));
+        assertEquals(2, LeavesXComputeExecutor.partitionCountFor(128, 8, 64));
+        assertEquals(8, LeavesXComputeExecutor.partitionCountFor(512, 8, 64));
+        assertEquals(16, LeavesXComputeExecutor.partitionCountFor(1_024, 8, 64));
+        assertEquals(16, LeavesXComputeExecutor.partitionCountFor(8_192, 8, 64));
+        assertEquals(1, LeavesXComputeExecutor.partitionCountFor(1_024, 1, 64));
+    }
+
+    @Test
+    void exposesEnoughResultSlotsForOverPartitionedCallers() {
+        LeavesXComputeExecutor.configure(4, 64);
+        assertEquals(10, LeavesXComputeExecutor.computePartitionCapacity());
+
+        LeavesXComputeExecutor.configure(1, 64);
+        assertEquals(1, LeavesXComputeExecutor.computePartitionCapacity());
     }
 
     @Test
@@ -234,7 +253,10 @@ class LeavesXComputeExecutorTest {
 
         final LeavesXComputeExecutor.Metrics metrics = LeavesXComputeExecutor.metrics();
         assertEquals(1L, metrics.callerRanges());
-        assertEquals(4L, metrics.workerRanges());
+        assertEquals(
+            LeavesXComputeExecutor.partitionCountFor(1_024, LeavesXComputeExecutor.computeLaneCount(), 64) - 1L,
+            metrics.workerRanges()
+        );
         assertEquals(1_024L, metrics.callerItems() + metrics.workerItems());
         assertTrue(metrics.maximumConcurrentWorkers() > 0);
 
