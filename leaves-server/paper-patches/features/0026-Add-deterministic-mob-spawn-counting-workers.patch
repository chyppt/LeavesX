diff --git a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..496e7c57e8d60ae7fae54bd502089f84687ea9ac
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
@@ -0,0 +1,48 @@
+package org.leavesx.leavesx.runtime;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.concurrent.atomic.AtomicIntegerArray;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class LeavesXComputeExecutorTest {
+
+    @AfterEach
+    void shutdownExecutor() {
+        LeavesXComputeExecutor.shutdown();
+    }
+
+    @Test
+    void processesEveryIndexExactlyOnce() {
+        LeavesXComputeExecutor.configure(4);
+        final AtomicIntegerArray counts = new AtomicIntegerArray(1024);
+
+        final boolean parallel = LeavesXComputeExecutor.invokeRanges(1024, 128, (taskIndex, start, end) -> {
+            for (int index = start; index < end; index++) {
+                counts.incrementAndGet(index);
+            }
+        });
+
+        assertTrue(parallel);
+        final int[] actual = new int[1024];
+        final int[] expected = new int[1024];
+        for (int index = 0; index < actual.length; index++) {
+            actual[index] = counts.get(index);
+            expected[index] = 1;
+        }
+        assertArrayEquals(expected, actual);
+    }
+
+    @Test
+    void requestsSynchronousFallbackForSmallInputs() {
+        LeavesXComputeExecutor.configure(4);
+        assertFalse(LeavesXComputeExecutor.invokeRanges(127, 128, (taskIndex, start, end) -> {
+            throw new AssertionError("small input must not be submitted");
+        }));
+    }
+}
