diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
new file mode 100644
index 0000000000000000000000000000000000000000..025ef20441d1b4b9a9efc5c8f8af1cd43574ac4b
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
@@ -0,0 +1,114 @@
+package org.leavesx.leavesx.runtime;
+
+import com.google.common.util.concurrent.ThreadFactoryBuilder;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Runs LeavesX pure-computation work that never reads or writes live world state. */
+public final class LeavesXComputeExecutor {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXComputeExecutor.class);
+    private static final int MAX_QUEUED_TASKS = 128;
+    private static volatile ThreadPoolExecutor executor;
+    private static volatile int workerCount = 1;
+
+    private LeavesXComputeExecutor() {
+    }
+
+    /** Creates the bounded worker pool during bootstrap. A configured value of zero selects a conservative default. */
+    public static synchronized void configure(final int configuredWorkers) {
+        shutdown();
+        final int availableProcessors = Runtime.getRuntime().availableProcessors();
+        final int automaticWorkers = Math.max(1, Math.min(4, availableProcessors - 2));
+        workerCount = configuredWorkers == 0 ? automaticWorkers : configuredWorkers;
+        executor = new ThreadPoolExecutor(
+            workerCount,
+            workerCount,
+            30L,
+            TimeUnit.SECONDS,
+            new ArrayBlockingQueue<>(MAX_QUEUED_TASKS),
+            new ThreadFactoryBuilder()
+                .setDaemon(true)
+                .setNameFormat("LeavesX Compute Worker - %d")
+                .setUncaughtExceptionHandler((thread, throwable) ->
+                    LOGGER.error("Uncaught exception in {}", thread.getName(), throwable))
+                .build(),
+            new ThreadPoolExecutor.AbortPolicy()
+        );
+        executor.allowCoreThreadTimeOut(true);
+    }
+
+    public static int workerCount() {
+        return workerCount;
+    }
+
+    /**
+     * Processes contiguous ranges and waits for every range before returning.
+     *
+     * @return {@code false} when submission or execution failed, allowing the caller to recompute synchronously
+     */
+    public static boolean invokeRanges(final int size, final int minimumSize, final RangeTask task) {
+        final ThreadPoolExecutor current = executor;
+        if (current == null || workerCount <= 1 || size < minimumSize) {
+            return false;
+        }
+
+        final int taskCount = Math.min(workerCount, size);
+        final int rangeSize = (size + taskCount - 1) / taskCount;
+        final List<Future<?>> futures = new ArrayList<>(taskCount);
+        boolean succeeded = true;
+        try {
+            for (int start = 0; start < size; start += rangeSize) {
+                final int rangeStart = start;
+                final int rangeEnd = Math.min(size, start + rangeSize);
+                final int taskIndex = futures.size();
+                futures.add(current.submit(() -> task.run(taskIndex, rangeStart, rangeEnd)));
+            }
+        } catch (final RuntimeException submissionFailure) {
+            succeeded = false;
+            LOGGER.error("LeavesX parallel computation could not be submitted; recomputing on the main thread", submissionFailure);
+        }
+
+        boolean interrupted = false;
+        for (final Future<?> future : futures) {
+            boolean completed = false;
+            while (!completed) {
+                try {
+                    future.get();
+                    completed = true;
+                } catch (final InterruptedException interruption) {
+                    interrupted = true;
+                    succeeded = false;
+                } catch (final java.util.concurrent.ExecutionException executionFailure) {
+                    succeeded = false;
+                    completed = true;
+                    LOGGER.error("LeavesX parallel computation failed; recomputing on the main thread", executionFailure);
+                }
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+        return succeeded && futures.size() == taskCount;
+    }
+
+    /** Stops all LeavesX computation workers during normal server shutdown. */
+    public static synchronized void shutdown() {
+        final ThreadPoolExecutor current = executor;
+        executor = null;
+        if (current != null) {
+            current.shutdownNow();
+        }
+    }
+
+    @FunctionalInterface
+    public interface RangeTask {
+        void run(int taskIndex, int startInclusive, int endExclusive);
+    }
+}
