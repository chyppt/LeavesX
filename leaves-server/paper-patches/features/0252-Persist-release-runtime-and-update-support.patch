@@ -0,0 +1,207 @@
+package org.leavesx.leavesx.update;
+
+import com.google.gson.JsonParser;
+import io.papermc.paper.ServerBuildInfo;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.security.MessageDigest;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** 独立更新器：网络和校验不占用 Tick 线程，校验成功才交给启动器。 */
+public final class LeavesXUpdateService {
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXUpdateService.class);
+    private static final HttpClient CLIENT = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(8))
+        .followRedirects(HttpClient.Redirect.NORMAL).build();
+    private static final java.util.concurrent.ScheduledExecutorService EXECUTOR =
+        Executors.newSingleThreadScheduledExecutor(task -> {
+            Thread thread = new Thread(task, "LeavesX-Update");
+            thread.setDaemon(true);
+            return thread;
+        });
+    private static final AtomicBoolean BUSY = new AtomicBoolean();
+    private static ScheduledFuture<?> scheduled;
+    private static volatile boolean automaticDownload;
+    private static final long MAX_SIZE = 512L * 1024 * 1024;
+
+    private LeavesXUpdateService() {}
+
+    public static synchronized void configure(LeavesXConfig.ExtensionSettings settings) {
+        automaticDownload = settings.updateDownload();
+        if (scheduled != null) scheduled.cancel(false);
+        scheduled = settings.updateCheck() ? EXECUTOR.scheduleWithFixedDelay(
+            () -> run(automaticDownload), 30, 3600, TimeUnit.SECONDS) : null;
+    }
+
+    public static boolean request(boolean download) {
+        if (!BUSY.compareAndSet(false, true)) return false;
+        EXECUTOR.execute(() -> execute(download));
+        return true;
+    }
+
+    private static void run(boolean download) {
+        if (BUSY.compareAndSet(false, true)) execute(download);
+    }
+
+    private static void execute(boolean download) {
+        try {
+            check(download);
+        } catch (Exception error) {
+            LOGGER.warn("LeavesX 更新失败：{}", error.toString());
+        } finally {
+            BUSY.set(false);
+        }
+    }
+
+    private static HttpRequest request(URI uri) {
+        if (!"https".equals(uri.getScheme())) throw new IllegalArgumentException("更新地址必须使用 HTTPS");
+        return HttpRequest.newBuilder(uri).timeout(Duration.ofSeconds(60))
+            .header("User-Agent", "LeavesX-Updater").GET().build();
+    }
+
+    private static void check(boolean download) throws Exception {
+        var response = CLIENT.send(request(URI.create("https://api.github.com/repos/chyppt/LeavesX/releases/latest")),
+            HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() != 200) throw new IOException("GitHub HTTP " + response.statusCode());
+        var release = JsonParser.parseString(response.body()).getAsJsonObject();
+        String tag = release.get("tag_name").getAsString();
+        String current = System.getProperty("leavesx.version", "");
+        // 读取构建清单，不用 MC 的构建编号冒充 LeavesX 版本。
+        Path runningJar = Path.of(LeavesXUpdateService.class.getProtectionDomain().getCodeSource().getLocation().toURI());
+        if (Files.isRegularFile(runningJar)) {
+            try (var jar = new java.util.jar.JarFile(runningJar.toFile())) {
+                if (jar.getManifest() != null) current = jar.getManifest().getMainAttributes().getValue("LeavesX-Version");
+            }
+        }
+        String version = tag.replaceFirst("(?i)^(leavesx[-_]?|v)", "");
+        if (current == null || !newer(version, current)) {
+            LOGGER.info("当前没有适用的 LeavesX 正式版更新。");
+            return;
+        }
+        String mc = ServerBuildInfo.buildInfo().minecraftVersionId();
+        for (var element : release.getAsJsonArray("assets")) {
+            var asset = element.getAsJsonObject();
+            String name = asset.get("name").getAsString();
+            if (!name.equalsIgnoreCase("LeavesX-" + version + "-" + mc + ".jar")) continue;
+            LOGGER.info("发现 LeavesX {} 更新（Minecraft {}）。", version, mc);
+            if (!download) return;
+            String digest = asset.has("digest") && !asset.get("digest").isJsonNull() ? asset.get("digest").getAsString() : "";
+            if (!digest.matches("sha256:[0-9a-fA-F]{64}")) throw new IOException("发布文件没有 SHA-256 摘要，已停止自动下载");
+            long size = asset.get("size").getAsLong();
+            if (size <= 0 || size > MAX_SIZE) throw new IOException("发布文件大小不合法");
+            URI url = URI.create(asset.get("browser_download_url").getAsString());
+            if (!"github.com".equals(url.getHost()) || !url.getPath().startsWith("/chyppt/LeavesX/releases/download/")) {
+                throw new IOException("发布文件不属于 LeavesX 仓库");
+            }
+            download(url, name, size, digest.substring(7));
+            return;
+        }
+        LOGGER.info("最新发布中没有 Minecraft {} 的 LeavesX 构建。", mc);
+    }
+
+    static boolean newer(String candidate, String current) {
+        if (!candidate.matches("[0-9]+\\.[0-9]+\\.[0-9]+") || !current.matches("[0-9]+\\.[0-9]+\\.[0-9]+")) return false;
+        String[] next = candidate.split("\\."), old = current.split("\\.");
+        for (int i = 0; i < 3; i++) {
+            int compared = new java.math.BigInteger(next[i]).compareTo(new java.math.BigInteger(old[i]));
+            if (compared != 0) return compared > 0;
+        }
+        return false;
+    }
+
+    private record Endpoint(URI uri, long latency) {}
+
+    private static void download(URI official, String name, long size, String hash) throws Exception {
+        List<Endpoint> endpoints = new ArrayList<>();
+        // 首选站可用时优先；其余镜像按探测延迟排序，官方始终作为最终回退。
+        for (String mirror : List.of("https://gh-proxy.com/", "https://ghfast.top/")) {
+            URI uri = URI.create(mirror + official);
+            long start = System.nanoTime();
+            try {
+                var probe = CLIENT.send(HttpRequest.newBuilder(uri).timeout(Duration.ofSeconds(5))
+                    .method("HEAD", HttpRequest.BodyPublishers.noBody()).build(), HttpResponse.BodyHandlers.discarding());
+                if (probe.statusCode() == 200) endpoints.add(new Endpoint(uri,
+                    mirror.contains("gh-proxy.com") ? -1 : System.nanoTime() - start));
+            } catch (IOException ignored) {
+                // 镜像不可用不会阻止官方回退。
+            }
+        }
+        endpoints.sort(Comparator.comparingLong(Endpoint::latency));
+        endpoints.add(new Endpoint(official, Long.MAX_VALUE));
+        Path directory = Path.of("auto_update", "leavesx");
+        Files.createDirectories(directory);
+        IOException failure = null;
+        for (Endpoint endpoint : endpoints) {
+            Path temporary = Files.createTempFile(directory, "download-", ".part");
+            try {
+                var connection = (java.net.HttpURLConnection) endpoint.uri().toURL().openConnection();
+                connection.setConnectTimeout(8000);
+                connection.setReadTimeout(15000);
+                connection.setRequestProperty("User-Agent", "LeavesX-Updater");
+                long deadline = System.nanoTime() + TimeUnit.MINUTES.toNanos(5);
+                try (var input = connection.getInputStream(); var output = Files.newOutputStream(temporary)) {
+                    if (connection.getResponseCode() != 200) throw new IOException("下载 HTTP " + connection.getResponseCode());
+                    MessageDigest digest = MessageDigest.getInstance("SHA-256");
+                    byte[] buffer = new byte[65536];
+                    long count = 0;
+                    for (int read; (read = input.read(buffer)) != -1;) {
+                        if (System.nanoTime() > deadline) throw new IOException("下载超时");
+                        count += read;
+                        if (count > size) throw new IOException("下载文件超出声明大小");
+                        digest.update(buffer, 0, read);
+                        output.write(buffer, 0, read);
+                    }
+                    if (count != size || !HexFormat.of().formatHex(digest.digest()).equalsIgnoreCase(hash)) {
+                        throw new IOException("文件大小或 SHA-256 校验失败");
+                    }
+                } finally {
+                    connection.disconnect();
+                }
+                try (var jar = new java.util.jar.JarFile(temporary.toFile())) {
+                    if (jar.getManifest() == null || jar.getEntry("META-INF/leavesclip-version") == null) {
+                        throw new IOException("发布文件不是 Leavesclip 核心 JAR");
+                    }
+                    // 启动器拒绝不一致的版本；发布指针前校验，避免下一次启动直接退出。
+                    try (var expected = LeavesXUpdateService.class.getResourceAsStream("/META-INF/leavesclip-version");
+                         var actual = jar.getInputStream(jar.getEntry("META-INF/leavesclip-version"))) {
+                        if (expected == null || !java.util.Arrays.equals(expected.readAllBytes(), actual.readAllBytes())) {
+                            throw new IOException("更新需要更换启动器，请手动下载新核心");
+                        }
+                    }
+                }
+                Path target = directory.resolve(name).toAbsolutePath();
+                Files.move(temporary, target, StandardCopyOption.REPLACE_EXISTING);
+                Path marker = Files.createTempFile(Path.of("auto_update"), "core-", ".path");
+                try {
+                    Files.writeString(marker, target.toString());
+                    Files.move(marker, Path.of("auto_update", "core.path"), StandardCopyOption.REPLACE_EXISTING);
+                } finally {
+                    Files.deleteIfExists(marker);
+                }
+                LOGGER.info("LeavesX {} 已下载并校验，重启后生效。", name);
+                return;
+            } catch (IOException error) {
+                failure = error;
+            } finally {
+                Files.deleteIfExists(temporary);
+            }
+        }
+        throw failure == null ? new IOException("没有可用下载地址") : failure;
+    }
+}
