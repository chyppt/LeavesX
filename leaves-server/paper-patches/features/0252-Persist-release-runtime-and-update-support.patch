+package org.leavesx.leavesx.update;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LeavesXUpdateServiceTest {
+    @Test
+    void onlyNewerStableVersionsAreAccepted() {
+        assertTrue(LeavesXUpdateService.newer("1.2.10", "1.2.9"));
+        assertTrue(LeavesXUpdateService.newer("2.0.0", "1.9.9"));
+        assertFalse(LeavesXUpdateService.newer("1.2.1", "1.2.1"));
+        assertFalse(LeavesXUpdateService.newer("1.1.9", "1.2.1"));
+        assertFalse(LeavesXUpdateService.newer("1.3.0-beta1", "1.2.1"));
+        assertFalse(LeavesXUpdateService.newer("1.3.0", "local"));
+    }
+
+    @Test
+    void updateSettingsAreDocumentedAndIndependent() throws Exception {
+        var defaults = org.leavesx.leavesx.config.LeavesXConfig.safeDefaults();
+        assertTrue(defaults.extensions().updateCheck());
+        assertFalse(defaults.extensions().updateDownload());
+        String yaml = org.leavesx.leavesx.config.LeavesXConfigWriter.render(defaults, "");
+        assertTrue(yaml.contains("updates:"));
+        assertTrue(yaml.contains("auto-download: false"));
+        assertFalse(yaml.contains("download-source"));
+    }
+}
