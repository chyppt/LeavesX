diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityLoadOptionalHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityLoadOptionalHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ee9b30afb0cadd767ea9129e1bb4085c5a490836
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityLoadOptionalHotPathTest.java
@@ -0,0 +1,53 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.EntityType;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies recursive entity loading retains both the allocation-light and vanilla Optional paths. */
+@Normal
+class EntityLoadOptionalHotPathTest {
+
+    @Test
+    void valueInputOverloadsKeepOptimizedAndVanillaPaths() throws IOException {
+        final ClassNode owner = classNode(EntityType.class);
+        final List<MethodNode> overloads = owner.methods.stream()
+            .filter(method -> method.name.equals("loadEntityRecursive"))
+            .filter(method -> method.desc.contains("Lnet/minecraft/world/level/storage/ValueInput;"))
+            .filter(method -> method.desc.contains("Lnet/minecraft/world/entity/EntityProcessor;"))
+            .toList();
+
+        assertEquals(2, overloads.size());
+        for (final MethodNode overload : overloads) {
+            final List<MethodInsnNode> calls = invocations(overload);
+            assertTrue(calls.stream().anyMatch(call -> call.name.equals("entityLoadOptionalChainsOptimization")));
+            assertTrue(calls.stream().anyMatch(call -> call.name.equals("process")));
+            assertTrue(calls.stream().anyMatch(call -> call.name.equals("loadPassengersRecursive")));
+            assertTrue(calls.stream().anyMatch(call -> call.owner.equals("java/util/Optional") && call.name.equals("map")));
+        }
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+}
