diff --git a/src/test/java/org/leavesx/leavesx/performance/FineGrainedOptimizationWiringTest.java b/src/test/java/org/leavesx/leavesx/performance/FineGrainedOptimizationWiringTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a4e61550a024f55c26ad0400acf84b5dbb22b015
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/FineGrainedOptimizationWiringTest.java
@@ -0,0 +1,117 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies coarse compatibility masters are paired with independently configurable hot-path switches. */
+@Normal
+class FineGrainedOptimizationWiringTest {
+
+    private static final String RUNTIME_OWNER = "org/leavesx/leavesx/config/LeavesXRuntime";
+    private static final Set<String> COARSE_RUNTIME_CALLS = Set.of(
+        "aiOptimizations",
+        "entityStateOptimizations",
+        "mobSpawningOptimizations",
+        "pathfindingOptimizations",
+        "skipEmptyEvents"
+    );
+
+    @Test
+    void optimizedMinecraftClassesUseDedicatedRuntimeSwitches() throws IOException, ClassNotFoundException {
+        for (final Wiring wiring : wirings()) {
+            final Set<String> runtimeCalls = runtimeCalls(wiring.className());
+            for (final String expected : wiring.expectedRuntimeCalls()) {
+                assertTrue(runtimeCalls.contains(expected), wiring.className() + " must call " + expected);
+            }
+            for (final String coarse : COARSE_RUNTIME_CALLS) {
+                assertFalse(runtimeCalls.contains(coarse), wiring.className() + " must not call coarse switch " + coarse);
+            }
+        }
+    }
+
+    private static List<Wiring> wirings() {
+        return List.of(
+            new Wiring("ca.spottedleaf.moonrise.patches.poi_lookup.PoiAccess", "poiBoundedTraversalOptimization"),
+            new Wiring("net.minecraft.world.entity.npc.villager.Villager", "villagerGolemAgreementOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.targeting.TargetingConditions", "targetingRangeChecksOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.sensing.TemptingSensor", "temptingPlayerSearchOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.sensing.Sensor", "sensorFollowRangeCacheOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.sensing.NearestLivingEntitySensor", "nearestEntityDistanceSortOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.sensing.NearestItemSensor", "nearestEntityDistanceSortOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.memory.NearestVisibleLivingEntities", "visibleEntityTargetCacheOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.gossip.GossipContainer", "villagerGossipScansOptimization"),
+            new Wiring("net.minecraft.world.level.EntityGetter", "playerDistanceQueriesOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.goal.FollowFlockLeaderGoal", "schoolingFishLeaderOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.Brain", "brainBehaviorSchedulingOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.AcquirePoi", "acquirePoiCandidatesOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.BehaviorUtils", "villageSectionSearchOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.InsideBrownianWalk", "insideBrownianWalkOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.InteractWithDoor", "doorMemoryScanOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.GateBehavior", "gateBehaviorTraversalOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.PlayTagWithOtherKids", "villagerPlayTagOptimization"),
+            new Wiring("net.minecraft.world.entity.ai.behavior.YieldJobSite", "yieldJobSiteOptimization"),
+            new Wiring(
+                "net.minecraft.world.level.pathfinder.PathFinder",
+                "pathCandidateComparisonOptimization",
+                "pathNodeListBuildingOptimization"
+            ),
+            new Wiring(
+                "net.minecraft.world.entity.ai.navigation.PathNavigation",
+                "navigationNodePositionOptimization",
+                "navigationDirectionVectorOptimization",
+                "navigationTimeoutNodeOptimization",
+                "navigationRecomputeDistanceOptimization"
+            ),
+            new Wiring("net.minecraft.network.syncher.SynchedEntityData", "syncedDataPackingOptimization"),
+            new Wiring("net.minecraft.server.level.ServerEntity", "entityMotionIdentityOptimization"),
+            new Wiring(
+                "net.minecraft.world.entity.LivingEntity",
+                "livingEffectTickOptimization",
+                "effectParticleCollectionOptimization",
+                "freezeTickUpdateOptimization",
+                "gliderSlotSelectionOptimization"
+            ),
+            new Wiring("net.minecraft.world.entity.AreaEffectCloud", "areaEffectCloudScanOptimization"),
+            new Wiring("net.minecraft.world.item.enchantment.Enchantment", "enchantmentSlotMatchingOptimization"),
+            new Wiring("net.minecraft.world.level.NaturalSpawner", "naturalSpawnEventListenerOptimization"),
+            new Wiring("net.minecraft.world.level.gameevent.GameEventDispatcher", "gameEventListenerOptimization"),
+            new Wiring("net.minecraft.server.level.ServerChunkCache", "naturalSpawnStateOptimization")
+        );
+    }
+
+    private static Set<String> runtimeCalls(final String className) throws IOException, ClassNotFoundException {
+        final Set<String> calls = new HashSet<>();
+        collectRuntimeCalls(Class.forName(className, false, FineGrainedOptimizationWiringTest.class.getClassLoader()), calls);
+        return calls;
+    }
+
+    private static void collectRuntimeCalls(final Class<?> type, final Set<String> calls) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(type.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        for (final MethodNode method : classNode.methods) {
+            for (final org.objectweb.asm.tree.AbstractInsnNode instruction : method.instructions) {
+                if (instruction instanceof MethodInsnNode call && call.owner.equals(RUNTIME_OWNER)) {
+                    calls.add(call.name);
+                }
+            }
+        }
+        for (final Class<?> nested : type.getDeclaredClasses()) {
+            collectRuntimeCalls(nested, calls);
+        }
+    }
+
+    private record Wiring(String className, String... expectedRuntimeCalls) {
+    }
+}
