+package org.leavesx.leavesx.diagnostics;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.Set;
+import java.util.stream.Collectors;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Locks down the low-overhead phase boundaries used to attribute slow world ticks. */
+@Normal
+class WorldTickPhaseAttributionTest {
+
+    private static final String DIAGNOSTICS_OWNER = "org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics";
+    private static final String PHASE_OWNER = DIAGNOSTICS_OWNER + "$TickPhase";
+
+    @Test
+    void exposesDetailedWorldPhases() {
+        final Set<String> names = Arrays.stream(LeavesXTickDiagnostics.TickPhase.values())
+            .map(Enum::name)
+            .collect(Collectors.toSet());
+
+        assertTrue(names.contains("WORLD_CHUNKS"));
+        assertTrue(names.contains("WORLD_ENTITIES"));
+        assertTrue(names.contains("WORLD_BLOCK_ENTITIES"));
+    }
+
+    @Test
+    void serverLevelTickWrapsTheThreeDominantWorldWorkloads() throws IOException {
+        final AbstractInsnNode[] instructions = methodNode(ServerLevel.class, "tick").instructions.toArray();
+
+        assertPhaseWrapsInvocation(
+            instructions,
+            "net/minecraft/server/level/ServerChunkCache",
+            "tick",
+            "WORLD_CHUNKS",
+            "chunk source tick"
+        );
+        assertPhaseWrapsInvocation(
+            instructions,
+            "net/minecraft/world/level/entity/EntityTickList",
+            "forEach",
+            "WORLD_ENTITIES",
+            "entity tick list"
+        );
+        assertPhaseWrapsInvocation(
+            instructions,
+            "net/minecraft/server/level/ServerLevel",
+            "tickBlockEntities",
+            "WORLD_BLOCK_ENTITIES",
+            "block entity tick list"
+        );
+    }
+
+    private static void assertPhaseWrapsInvocation(
+        final AbstractInsnNode[] instructions,
+        final String invocationOwner,
+        final String invocationName,
+        final String phaseName,
+        final String description
+    ) {
+        final int invocation = findInvocation(instructions, invocationOwner, invocationName);
+        final int phaseStart = findPreviousInvocation(instructions, invocation, DIAGNOSTICS_OWNER, "beginPhase");
+        final int phaseEnd = findNextInvocation(instructions, invocation, DIAGNOSTICS_OWNER, "endPhase");
+        final int phaseAccess = findFieldAccess(instructions, invocation, phaseEnd, PHASE_OWNER, phaseName);
+
+        assertTrue(phaseStart >= 0, description + " must start a LeavesX phase timer");
+        assertTrue(phaseEnd > invocation, description + " must stop its LeavesX phase timer");
+        assertTrue(phaseAccess > invocation && phaseAccess < phaseEnd, description + " must report " + phaseName);
+    }
+
+    private static int findInvocation(
+        final AbstractInsnNode[] instructions,
+        final String owner,
+        final String name
+    ) {
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing invocation " + owner + '#' + name);
+    }
+
+    private static int findPreviousInvocation(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final String owner,
+        final String name
+    ) {
+        for (int index = startIndex - 1; index >= 0; index--) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static int findNextInvocation(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final String owner,
+        final String name
+    ) {
+        for (int index = startIndex + 1; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static int findFieldAccess(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final int endIndex,
+        final String owner,
+        final String name
+    ) {
+        if (endIndex < 0) {
+            return -1;
+        }
+        for (int index = startIndex + 1; index < endIndex; index++) {
+            if (instructions[index] instanceof FieldInsnNode field
+                && field.getOpcode() == Opcodes.GETSTATIC
+                && field.owner.equals(owner)
+                && field.name.equals(name)) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static MethodNode methodNode(final Class<?> owner, final String methodName) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.getName() + '#' + methodName));
+    }
+}
