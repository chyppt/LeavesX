+    @Test
+    void unchangedMovementSkipsSquaredDistanceOnlyOnTheOptimizedPath() throws IOException {
+        final AbstractInsnNode[] instructions = methodNode(ServerEntity.class, "sendChanges").instructions.toArray();
+        final int movementRead = invocationIndex(instructions, "net/minecraft/world/entity/Entity", "getDeltaMovement");
+        final int distanceCalculation = invocationIndexAfter(
+            instructions,
+            movementRead,
+            "net/minecraft/world/phys/Vec3",
+            "distanceToSqr"
+        );
+
+        assertTrue(
+            hasInvocationBetween(
+                instructions,
+                movementRead,
+                distanceCalculation,
+                "org/leavesx/leavesx/config/LeavesXRuntime",
+                "entityStateOptimizations"
+            ),
+            "The identity fast path must remain controlled by entity-state-optimizations"
+        );
+        assertTrue(
+            hasReferenceComparisonBetween(instructions, movementRead, distanceCalculation),
+            "An unchanged immutable Vec3 should bypass the redundant squared-distance calculation"
+        );
+    }
+
+    @Test
+    void zeroFrozenTicksAvoidRedundantSynchronizedDataWrites() throws IOException {
+        final AbstractInsnNode[] instructions = methodNode(LivingEntity.class, "aiStep").instructions.toArray();
+        final int frozenTicksRead = invocationIndex(instructions, "getTicksFrozen");
+        final int frozenTicksWrite = invocationIndexAfter(
+            instructions,
+            frozenTicksRead,
+            "setTicksFrozen"
+        );
+
+        assertTrue(
+            hasInvocationBetween(
+                instructions,
+                frozenTicksRead,
+                frozenTicksWrite,
+                "org/leavesx/leavesx/config/LeavesXRuntime",
+                "entityStateOptimizations"
+            ),
+            "The frozen-tick fast path must remain controlled by entity-state-optimizations"
+        );
+        assertTrue(
+            hasConditionalJumpBetween(instructions, frozenTicksRead, frozenTicksWrite),
+            "A zero frozen-tick value should branch around setTicksFrozen"
+        );
+    }
+
