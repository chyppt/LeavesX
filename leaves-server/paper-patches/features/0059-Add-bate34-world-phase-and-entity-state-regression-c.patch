     }
 
+    private static int invocationIndex(final AbstractInsnNode[] instructions, final String name) {
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing invocation " + name);
+    }
+
+    private static int invocationIndexAfter(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final String owner,
+        final String name
+    ) {
+        for (int index = startIndex + 1; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing invocation " + owner + '#' + name + " after instruction " + startIndex);
+    }
+
+    private static int invocationIndexAfter(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final String name
+    ) {
+        for (int index = startIndex + 1; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing invocation " + name + " after instruction " + startIndex);
+    }
+
+    private static boolean hasInvocationBetween(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final int endIndex,
+        final String owner,
+        final String name
+    ) {
+        for (int index = startIndex + 1; index < endIndex; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasReferenceComparisonBetween(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final int endIndex
+    ) {
+        for (int index = startIndex + 1; index < endIndex; index++) {
+            final int opcode = instructions[index].getOpcode();
+            if (opcode == Opcodes.IF_ACMPEQ || opcode == Opcodes.IF_ACMPNE) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasConditionalJumpBetween(
+        final AbstractInsnNode[] instructions,
+        final int startIndex,
+        final int endIndex
+    ) {
+        for (int index = startIndex + 1; index < endIndex; index++) {
+            if (instructions[index] instanceof JumpInsnNode) {
+                return true;
+            }
+        }
+        return false;
+    }
+
     private static int fieldIndex(final AbstractInsnNode[] instructions, final String owner, final String name) {
