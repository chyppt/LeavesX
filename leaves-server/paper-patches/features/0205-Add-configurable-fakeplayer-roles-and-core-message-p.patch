+
+    /** Builds the display identity with an optional role while keeping the account name unchanged. */
+    public static Component fakeplayerDisplayName(final String accountName, final String role) {
         final String prefix = LeavesXRuntime.fakeplayerDisplayPrefix();
-        if (prefix.isEmpty()) {
-            return Component.text(accountName);
+        Component display = prefix.isEmpty() ? Component.empty() : deserializeConfigured(prefix);
+        if (LeavesXRuntime.fakeplayerRoleEnabled() && role != null && !role.isEmpty()) {
+            final String left = LeavesXRuntime.fakeplayerRoleWrapperEnabled()
+                ? LeavesXRuntime.fakeplayerRoleWrapperLeft() : "";
+            final String right = LeavesXRuntime.fakeplayerRoleWrapperEnabled()
+                ? LeavesXRuntime.fakeplayerRoleWrapperRight() : "";
+            final String roleText = left + role + right;
+            display = display.append(LeavesXRuntime.fakeplayerRoleColorCodes()
+                ? deserializeConfigured(roleText)
+                : Component.text(roleText));
         }
-        return deserializeConfigured(prefix).append(Component.text(accountName));
+        return display.append(Component.text(accountName));
     }
 
