                 .error("Failed to reload LeavesX configuration", exception);
-            sender.sendMessage(Component.text("LeavesX 配置重载失败，请查看控制台日志。", NamedTextColor.RED));
+            sender.sendMessage(org.leavesx.leavesx.presentation.LeavesXPlayerPresentation.withCorePrefix(
+                Component.text("LeavesX 配置重载失败，请查看控制台日志。", NamedTextColor.RED)
+            ));
