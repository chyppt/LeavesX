+    private List<List<String>> runGeneratedScenarios(final boolean optimized) throws IOException {
+        final List<List<String>> results = new ArrayList<>();
+        try {
+            LeavesXRuntime.publish(this.configuration(optimized));
+            for (int scenario = 0; scenario < 64; ++scenario) {
+                final Random random = new Random(0x4C656176657358L + scenario);
+                final List<String> calls = new ArrayList<>();
+                final GoalSelector selector = new GoalSelector();
+                final int goalCount = 4 + random.nextInt(9);
+                for (int index = 0; index < goalCount; ++index) {
+                    final EnumSet<Goal.Flag> flags = EnumSet.noneOf(Goal.Flag.class);
+                    for (final Goal.Flag flag : Goal.Flag.values()) {
+                        if (random.nextBoolean()) {
+                            flags.add(flag);
+                        }
+                    }
+                    if (flags.isEmpty()) {
+                        flags.add(Goal.Flag.values()[random.nextInt(Goal.Flag.values().length)]);
+                    }
+                    selector.addGoal(
+                        random.nextInt(8),
+                        new RecordingGoal(
+                            "scenario-" + scenario + "-goal-" + index,
+                            calls,
+                            random.nextBoolean(),
+                            random.nextBoolean(),
+                            random.nextBoolean(),
+                            flags.toArray(Goal.Flag[]::new)
+                        )
+                    );
+                }
+                for (int tick = 0; tick < 4; ++tick) {
+                    selector.tick();
+                }
+                results.add(List.copyOf(calls));
+            }
+            return List.copyOf(results);
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
     private List<String> tickWithConfiguration(
         final GoalSelector selector,
         final List<String> calls,
