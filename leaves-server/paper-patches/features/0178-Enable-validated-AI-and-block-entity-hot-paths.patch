+    @Test
+    void identityCacheMatchesPaperForEveryRegisteredBlockMapping() throws Exception {
+        final boolean previousOldBlockRemoval = LeavesConfig.modify.oldMC.updater.oldBlockRemoveBehaviour;
+        try {
+            LeavesConfig.modify.oldMC.updater.oldBlockRemoveBehaviour = false;
+            final List<BlockEntityType<?>> types = BuiltInRegistries.BLOCK_ENTITY_TYPE.stream().toList();
+            final List<Block> blocks = BuiltInRegistries.BLOCK.stream().toList();
+            final boolean[][] paperResults = new boolean[types.size()][blocks.size()];
+
+            publish(this.configuration(true, false, "registry-paper.yml"));
+            for (int typeIndex = 0; typeIndex < types.size(); ++typeIndex) {
+                final BlockEntityType<?> type = types.get(typeIndex);
+                for (int blockIndex = 0; blockIndex < blocks.size(); ++blockIndex) {
+                    paperResults[typeIndex][blockIndex] = type.isValid(blocks.get(blockIndex).defaultBlockState());
+                }
+            }
+
+            publish(this.configuration(true, true, "registry-optimized.yml"));
+            for (int typeIndex = 0; typeIndex < types.size(); ++typeIndex) {
+                final BlockEntityType<?> type = types.get(typeIndex);
+                for (int blockIndex = 0; blockIndex < blocks.size(); ++blockIndex) {
+                    final Block block = blocks.get(blockIndex);
+                    assertEquals(
+                        paperResults[typeIndex][blockIndex],
+                        type.isValid(block.defaultBlockState()),
+                        () -> "Block-entity mapping changed for "
+                            + BuiltInRegistries.BLOCK_ENTITY_TYPE.getKey(type)
+                            + " and " + BuiltInRegistries.BLOCK.getKey(block)
+                    );
+                }
+            }
+        } finally {
+            LeavesConfig.modify.oldMC.updater.oldBlockRemoveBehaviour = previousOldBlockRemoval;
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
