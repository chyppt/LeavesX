diff --git a/src/test/java/org/leavesx/leavesx/performance/FrogTongueTargetLookupHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/FrogTongueTargetLookupHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..81ede3f867cddc4daf7739be0cd236c782401b16
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/FrogTongueTargetLookupHotPathTest.java
@@ -0,0 +1,97 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.anyInt;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Optional;
+import java.util.OptionalInt;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.animal.frog.Frog;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies frog tongue-target lookup preserves empty, present, and missing-entity results. */
+@Normal
+class FrogTongueTargetLookupHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void directLookupMatchesOptionalIntStreamSemantics() throws ReflectiveOperationException {
+        final Level emptyLevel = mock(Level.class);
+        assertEquals(Optional.empty(), resolve(OptionalInt.empty(), emptyLevel));
+        verify(emptyLevel, never()).getEntity(anyInt());
+
+        final Level presentLevel = mock(Level.class);
+        final Entity target = mock(Entity.class);
+        when(presentLevel.getEntity(42)).thenReturn(target);
+        assertSame(target, resolve(OptionalInt.of(42), presentLevel).orElseThrow());
+        verify(presentLevel).getEntity(42);
+
+        final Level missingLevel = mock(Level.class);
+        assertTrue(resolve(OptionalInt.of(73), missingLevel).isEmpty());
+        verify(missingLevel).getEntity(73);
+    }
+
+    @Test
+    void version53ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-53.yml");
+        Files.writeString(path, """
+            config-version: 53
+            performance:
+              ai:
+                frog-tongue-target-lookup: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.frogTongueTargetLookupOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("frog-tongue-target-lookup: false"));
+        assertTrue(upgraded.contains("# 青蛙舌头目标直接读取实体，关闭后使用原版流。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Optional<Entity> resolve(final OptionalInt targetId, final Level level)
+        throws ReflectiveOperationException {
+        final Method method = Frog.class.getDeclaredMethod("leavesX$resolveTongueTarget", OptionalInt.class, Level.class);
+        method.setAccessible(true);
+        return (Optional<Entity>)method.invoke(null, targetId, level);
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+}
