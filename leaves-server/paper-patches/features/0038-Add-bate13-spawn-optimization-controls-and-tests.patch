--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/PotentialCalculatorTest.java
@@ -0,0 +1,60 @@
+package net.minecraft.world.level;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.Random;
+import net.minecraft.core.BlockPos;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+public final class PotentialCalculatorTest {
+
+    @Test
+    void primitiveStoragePreservesSequentialFloatingPointOrder() {
+        final int pointCount = 4_096;
+        final BlockPos[] positions = new BlockPos[pointCount];
+        final double[] charges = new double[pointCount];
+        final PotentialCalculator calculator = new PotentialCalculator();
+        final Random random = new Random(0x4C656176657358L);
+
+        for (int index = 0; index < pointCount; index++) {
+            final BlockPos position = new BlockPos(
+                random.nextInt(4_096) - 2_048,
+                random.nextInt(384) - 64,
+                random.nextInt(4_096) - 2_048
+            );
+            final double pointCharge = 0.125D + random.nextDouble() * 3.0D;
+            positions[index] = position;
+            charges[index] = pointCharge;
+            calculator.addCharge(position, pointCharge);
+        }
+
+        final BlockPos target = new BlockPos(127, 73, -311);
+        final double requestedCharge = 1.75D;
+        double expected = 0.0D;
+        for (int index = 0; index < pointCount; index++) {
+            final double distanceSquared = positions[index].distSqr(target);
+            expected += distanceSquared == 0.0D
+                ? Double.POSITIVE_INFINITY
+                : charges[index] / Math.sqrt(distanceSquared);
+        }
+        expected *= requestedCharge;
+
+        final double actual = calculator.getPotentialEnergyChange(target, requestedCharge);
+
+        assertEquals(Double.doubleToRawLongBits(expected), Double.doubleToRawLongBits(actual));
+    }
+
+    @Test
+    void zeroAndCoincidentChargesRetainVanillaResults() {
+        final PotentialCalculator calculator = new PotentialCalculator();
+        final BlockPos position = new BlockPos(10, 64, -20);
+        calculator.addCharge(position, 0.0D);
+        assertEquals(0.0D, calculator.getPotentialEnergyChange(position, 2.0D));
+
+        calculator.addCharge(position, 1.0D);
+        assertEquals(Double.POSITIVE_INFINITY, calculator.getPotentialEnergyChange(position, 2.0D));
+        assertEquals(0.0D, calculator.getPotentialEnergyChange(position, 0.0D));
+    }
+}
