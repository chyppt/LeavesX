diff --git a/src/test/java/net/minecraft/world/level/MobSpawnCountAccumulatorTest.java b/src/test/java/net/minecraft/world/level/MobSpawnCountAccumulatorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a239e44d09e20470fa52e884031071b67ddf7e4b
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/MobSpawnCountAccumulatorTest.java
@@ -0,0 +1,75 @@
+package net.minecraft.world.level;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import it.unimi.dsi.fastutil.longs.Long2ObjectMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import net.minecraft.world.entity.MobCategory;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+@Normal
+public final class MobSpawnCountAccumulatorTest {
+
+    @AfterEach
+    void stopWorkers() {
+        LeavesXComputeExecutor.shutdown();
+    }
+
+    @Test
+    void parallelAggregationMatchesInsertionOrderedReference() {
+        final int size = 8_192;
+        final long[] chunkKeys = new long[size];
+        final byte[] categories = new byte[size];
+        final Long2ObjectOpenHashMap<int[]> expected = new Long2ObjectOpenHashMap<>();
+        final int categoryCount = MobCategory.values().length;
+
+        for (int index = 0; index < size; index++) {
+            final int chunkX = Math.floorMod(index * 31, 257) - 128;
+            final int chunkZ = Math.floorMod(index * 17, 193) - 96;
+            final long chunkKey = ChunkPos.pack(chunkX, chunkZ);
+            final int category = Math.floorMod(index * 5, categoryCount);
+            chunkKeys[index] = chunkKey;
+            categories[index] = (byte)category;
+            expected.computeIfAbsent(chunkKey, ignored -> new int[categoryCount])[category]++;
+        }
+
+        LeavesXComputeExecutor.configure(4, 64);
+        final MobSpawnCountAccumulator.Inputs inputs = new MobSpawnCountAccumulator.Inputs(chunkKeys, categories, size);
+        final Long2ObjectOpenHashMap<int[]> actual = MobSpawnCountAccumulator.count(inputs, true, 128);
+
+        assertEquals(expected.size(), actual.size());
+        for (final Long2ObjectMap.Entry<int[]> entry : expected.long2ObjectEntrySet()) {
+            assertArrayEquals(entry.getValue(), actual.get(entry.getLongKey()));
+        }
+        assertTrue(LeavesXComputeExecutor.metrics().parallelInvocations() > 0L);
+    }
+
+    @Test
+    void synchronousAndParallelPathsProduceTheSameCounts() {
+        final long[] chunkKeys = new long[2_048];
+        final byte[] categories = new byte[chunkKeys.length];
+        for (int index = 0; index < chunkKeys.length; index++) {
+            chunkKeys[index] = ChunkPos.pack(index & 31, (index >>> 5) & 31);
+            categories[index] = (byte)(index % MobCategory.values().length);
+        }
+
+        final MobSpawnCountAccumulator.Inputs inputs = new MobSpawnCountAccumulator.Inputs(
+            chunkKeys,
+            categories,
+            chunkKeys.length
+        );
+        final Long2ObjectOpenHashMap<int[]> synchronous = MobSpawnCountAccumulator.count(inputs, false, 128);
+        LeavesXComputeExecutor.configure(3, 32);
+        final Long2ObjectOpenHashMap<int[]> parallel = MobSpawnCountAccumulator.count(inputs, true, 128);
+
+        assertEquals(synchronous.size(), parallel.size());
+        for (final Long2ObjectMap.Entry<int[]> entry : synchronous.long2ObjectEntrySet()) {
+            assertArrayEquals(entry.getValue(), parallel.get(entry.getLongKey()));
+        }
+    }
+}
