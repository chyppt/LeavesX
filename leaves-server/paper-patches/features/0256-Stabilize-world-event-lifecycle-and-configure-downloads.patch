@@ -161,6 +162,37 @@ public class LeavesXEventGateTest {
         LeavesXEventGate.reopen();
     }
 
+    @Test
+    void interruptingQueuedEventCancelsItBeforeDispatch() throws Exception {
+        LeavesXEventGate.setEnabled(true);
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread worker = new Thread(() -> {
+            LeavesXEventGate.enterWorldThread();
+            try {
+                LeavesXEventGate.deferFromWorldThread(new MarkerEvent());
+            } catch (final Throwable thrown) {
+                failure.set(thrown);
+            } finally {
+                LeavesXEventGate.exitWorldThread();
+            }
+        }, "gate-worker-interrupt");
+        worker.start();
+
+        final long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (LeavesXEventGate.pendingCount() == 0 && System.nanoTime() < deadline) {
+            Thread.yield();
+        }
+        assertEquals(1, LeavesXEventGate.pendingCount(), "worker must enqueue before interruption");
+
+        worker.interrupt();
+        worker.join(5_000L);
+
+        assertFalse(worker.isAlive(), "interrupted worker must not remain blocked");
+        assertTrue(failure.get() instanceof IllegalStateException, "interruption must fail the synchronous event call");
+        assertEquals(0, LeavesXEventGate.pendingCount(), "abandoned event must be removed from the queue");
+        assertEquals(0, LeavesXEventGate.pump(), "cancelled event must never be dispatched later");
+    }
