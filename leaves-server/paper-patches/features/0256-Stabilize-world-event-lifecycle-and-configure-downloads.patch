                     dispatchOnServerThread(pending.event);
                 } catch (final Throwable failure) {
@@ -167,6 +175,7 @@ public final class LeavesXEventGate {
                                 waiting.done = true;
                             }
                         }
+                        activeBatch = null;
                         PUMPED.signalAll();
                     } finally {
                         LOCK.unlock();
@@ -176,6 +185,7 @@ public final class LeavesXEventGate {
                 LOCK.lock();
                 try {
                     pending.done = true;
+                    PUMPED.signalAll();
                 } finally {
                     LOCK.unlock();
                 }
@@ -184,7 +194,7 @@ public final class LeavesXEventGate {
             }
             LOCK.lock();
             try {
-                PUMPED.signalAll();
+                activeBatch = null;
             } finally {
                 LOCK.unlock();
             }
@@ -214,7 +224,16 @@ public final class LeavesXEventGate {
                 pending.done = true;
             }
             QUEUE.clear();
-            ENQUEUED.signalAll();
+            // 正在执行的插件回调不可提前宣布完成；其余批次成员立即失败并唤醒。
+            if (activeBatch != null) {
+                for (final Pending pending : activeBatch) {
+                    if (!pending.done && !pending.dispatching) {
+                        pending.failure = new IllegalStateException(
+                            pending.event.getEventName() + " was not dispatched before shutdown");
+                        pending.done = true;
+                    }
+                }
+            }
             PUMPED.signalAll();
         } finally {
             LOCK.unlock();
@@ -260,4 +279,4 @@ public final class LeavesXEventGate {
             LOCK.unlock();
         }
     }
-}
