diff --git a/src/test/java/org/leavesx/leavesx/performance/MobPresenceSensorHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/MobPresenceSensorHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..63b5756510a91642ba0b6ff1060ff8bc5ce2865e
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/MobPresenceSensorHotPathTest.java
@@ -0,0 +1,61 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ai.sensing.GolemSensor;
+import net.minecraft.world.entity.ai.sensing.MobSensor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies nearby-mob sensors keep direct loops and vanilla Optional/stream fallbacks. */
+@Normal
+class MobPresenceSensorHotPathTest {
+
+    @Test
+    void genericMobSensorKeepsBothPaths() throws IOException {
+        assertDirectAndVanillaPaths(method(classNode(MobSensor.class), "checkForMobsNearby"));
+    }
+
+    @Test
+    void golemSensorKeepsBothPaths() throws IOException {
+        assertDirectAndVanillaPaths(method(classNode(GolemSensor.class), "checkForNearbyGolem"));
+    }
+
+    private static void assertDirectAndVanillaPaths(final MethodNode method) {
+        final List<MethodInsnNode> calls = invocations(method);
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("mobPresenceSensorOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValue")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("getMemory")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("stream")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("anyMatch")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
