+                entityTrackerEnabled, entityTrackerThreads, entityTrackerQueueSize, sharedComputeWorkers,
+                trackerComparisonSharding, lowLoadWorkers, true, true);
+        }
+
+        /** 动物开关不创建线程；比较启动设置时排除这两个可即时生效的字段。 */
+        public boolean sameExecutionSettings(final AsyncSettings other) {
+            return chunkSendEnabled == other.chunkSendEnabled && chunkSendQueueSize == other.chunkSendQueueSize
+                && mobSpawningEnabled == other.mobSpawningEnabled && pathfindingEnabled == other.pathfindingEnabled
+                && pathfindingThreads == other.pathfindingThreads && pathfindingQueueSize == other.pathfindingQueueSize
+                && pathfindingKeepaliveSeconds == other.pathfindingKeepaliveSeconds
+                && playerDataSaveEnabled == other.playerDataSaveEnabled && playerDataSaveQueueSize == other.playerDataSaveQueueSize
+                && entityTrackerEnabled == other.entityTrackerEnabled && entityTrackerThreads == other.entityTrackerThreads
+                && entityTrackerQueueSize == other.entityTrackerQueueSize && sharedComputeWorkers == other.sharedComputeWorkers
+                && trackerComparisonSharding == other.trackerComparisonSharding && lowLoadWorkers == other.lowLoadWorkers;
         }
 
