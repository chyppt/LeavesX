diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
index 6ef5faf162..9b33f09c45 100644
--- a/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
@@ -36,8 +36,8 @@ public final class LeavesXAsyncRuntime {
     private static final Duration SHUTDOWN_TIMEOUT = Duration.ofSeconds(60L);
     private static final int MAX_GENERAL_THREADS = 16;
     private static final int MAX_OWNED_TASKS_PER_DRAIN = 8;
-    // Live chunk state is not a detached packet snapshot yet.
-    private static final boolean CHUNK_SEND_EXPERIMENTAL = false;
+    // CHUNK_SEND accepts detached section palettes only; live packet construction stays on the owner.
+    private static final boolean CHUNK_SEND_EXPERIMENTAL = true;
     private static final Object GLOBAL_ORDER_OWNER = new Object();
     private static volatile Map<Workload, ExecutorState> executors = Map.of();
     private static volatile boolean configured;
diff --git a/src/test/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntimeTest.java b/src/test/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntimeTest.java
index 0cb6302dd9..1f632c1c96 100644
--- a/src/test/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntimeTest.java
+++ b/src/test/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntimeTest.java
@@ -3,6 +3,7 @@ package org.leavesx.leavesx.runtime;
 import static org.junit.jupiter.api.Assertions.assertEquals;
 import static org.junit.jupiter.api.Assertions.assertFalse;
 import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
 import static org.junit.jupiter.api.Assertions.assertTrue;
 
 import java.util.ArrayList;
@@ -114,27 +115,21 @@ class LeavesXAsyncRuntimeTest {
     }
 
     @Test
-    void liveChunkPacketWorkloadStaysOnCallerEvenWithOldEnabledConfig() {
+    void detachedChunkWorkloadUsesWorkerWhenEnabled() {
         final LeavesXConfig.AsyncSettings chunkSettings = new LeavesXConfig.AsyncSettings(
             true, 64, false, false, 0, 64, 30, false, 64, false, 0, 64
         );
         LeavesXAsyncRuntime.configure(chunkSettings);
-        assertFalse(LeavesXAsyncRuntime.enabled(LeavesXAsyncRuntime.Workload.CHUNK_SEND));
-        assertEquals(0, LeavesXAsyncRuntime.generalThreadCount(chunkSettings));
+        assertTrue(LeavesXAsyncRuntime.enabled(LeavesXAsyncRuntime.Workload.CHUNK_SEND));
+        assertTrue(LeavesXAsyncRuntime.generalThreadCount(chunkSettings) > 0);
         final Thread caller = Thread.currentThread();
         final List<Thread> execution = new ArrayList<>();
         LeavesXAsyncRuntime.submitOrRun(LeavesXAsyncRuntime.Workload.CHUNK_SEND,
             () -> execution.add(Thread.currentThread())).join();
-        assertEquals(List.of(caller), execution);
-        final AtomicBoolean ranOnCaller = new AtomicBoolean();
-        assertNull(LeavesXAsyncRuntime.trySubmitValue(
-            LeavesXAsyncRuntime.Workload.CHUNK_SEND,
-            () -> {
-                ranOnCaller.set(true);
-                return null;
-            }
-        ));
-        assertFalse(ranOnCaller.get());
+        assertEquals(1, execution.size());
+        assertNotEquals(caller, execution.getFirst());
+        assertNotEquals(caller, LeavesXAsyncRuntime.trySubmitValue(
+            LeavesXAsyncRuntime.Workload.CHUNK_SEND, Thread::currentThread).join());
     }
 
     @Test
