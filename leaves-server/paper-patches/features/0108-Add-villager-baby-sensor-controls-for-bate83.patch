index 0000000000000000000000000000000000000000..88f1b68c0e7d965157712e8c418ccf652cc2ab77
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/VillagerBabiesSensorHotPathTest.java
@@ -0,0 +1,54 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ai.sensing.VillagerBabiesSensor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies villager-baby sensing keeps direct list construction and the vanilla Guava fallback. */
+@Normal
+class VillagerBabiesSensorHotPathTest {
+
+    @Test
+    void sensorKeepsDirectAndVanillaListPaths() throws IOException {
+        final ClassNode sensor = classNode(VillagerBabiesSensor.class);
+        final List<MethodInsnNode> calls = invocations(method(sensor, "getNearestVillagerBabies"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("villagerBabiesSensorOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValue")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("findAllToList")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("findAll")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("copyOf")));
+        assertTrue(invocations(method(sensor, "getVisibleEntities")).stream()
+            .anyMatch(call -> call.name.equals("getMemory")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
