diff --git a/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java b/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java
index fdc0afb73a331e3abdf6cddfdb0dcacf68a6187a..086e7b42dae33b033f47093c7ed33bb5691ed8af 100644
--- a/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java
+++ b/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java
@@ -3,6 +3,9 @@ package org.leavesx.leavesx.performance;
 /** Calculates a bounded chunk-unload budget from an exact queue backlog. */
 public final class ChunkUnloadBudget {
 
+    private static final double FULL_PRESSURE_TICK_RATIO = 0.60D;
+    private static final double NO_PRESSURE_TICK_RATIO = 0.80D;
+
     private ChunkUnloadBudget() {
     }
 
@@ -19,7 +22,9 @@ public final class ChunkUnloadBudget {
         final boolean adaptive,
         final int backlogThreshold,
         final int minimumPerTick,
-        final int maximumPerTick
+        final int maximumPerTick,
+        final long averageTickTimeNanos,
+        final long targetTickTimeNanos
     ) {
         if (pendingChunkCount <= 0L) {
             return 0;
@@ -30,21 +35,47 @@ public final class ChunkUnloadBudget {
             return (int)Math.min(Integer.MAX_VALUE, Math.min(pendingChunkCount, boundedBase));
         }
 
+        final int minimum = Math.max(1, minimumPerTick);
+        final int maximum = Math.max(minimum, maximumPerTick);
+        final long cappedBase = Math.min(boundedBase, (long)maximum);
         final long threshold = Math.max(1L, backlogThreshold);
         if (pendingChunkCount <= threshold) {
-            return (int)Math.min(Integer.MAX_VALUE, Math.min(pendingChunkCount, boundedBase));
+            return (int)Math.min(pendingChunkCount, cappedBase);
         }
 
-        final int minimum = Math.max(1, minimumPerTick);
-        final int maximum = Math.max(minimum, maximumPerTick);
         final double fraction = Math.clamp(unloadFraction, 0.0, 1.0);
         final long availableIncrease = (long)maximum - minimum;
         final long pressure = Math.min(
             availableIncrease,
             (long)Math.ceil((pendingChunkCount - threshold) * fraction)
         );
-        final long target = Math.max(boundedBase, minimum + pressure);
+        final long fullPressureTarget = Math.min((long)maximum, Math.max(cappedBase, minimum + pressure));
+        final double headroomScale = tickHeadroomScale(averageTickTimeNanos, targetTickTimeNanos);
+        final long scaledIncrease = (long)Math.ceil((fullPressureTarget - cappedBase) * headroomScale);
+        final long target = cappedBase + scaledIncrease;
+
+        return (int)Math.min(pendingChunkCount, target);
+    }
 
-        return (int)Math.min(pendingChunkCount, Math.min((long)maximum, target));
+    /**
+     * Converts recent tick cost into a stable unload-pressure multiplier.
+     *
+     * <p>Full pressure is allowed below 60% of the target tick time. It then fades to zero at 80%, retaining enough
+     * headroom for entity, plugin, and chunk-load spikes instead of reacting only after TPS has already fallen.</p>
+     */
+    private static double tickHeadroomScale(final long averageTickTimeNanos, final long targetTickTimeNanos) {
+        if (averageTickTimeNanos <= 0L || targetTickTimeNanos <= 0L) {
+            return 1.0D;
+        }
+
+        final double tickRatio = (double)averageTickTimeNanos / (double)targetTickTimeNanos;
+        if (tickRatio <= FULL_PRESSURE_TICK_RATIO) {
+            return 1.0D;
+        }
+        if (tickRatio >= NO_PRESSURE_TICK_RATIO) {
+            return 0.0D;
+        }
+        return (NO_PRESSURE_TICK_RATIO - tickRatio)
+            / (NO_PRESSURE_TICK_RATIO - FULL_PRESSURE_TICK_RATIO);
     }
 }
diff --git a/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
index 1d5b5458429e61560f01bfdbfcf52edcff2bb79b..cd8b62d2c67d243c983e45d4012cb1415617407e 100644
--- a/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
+++ b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
@@ -47,8 +47,8 @@ public final class StableDistanceSorter {
 
         final double[] distances = new double[size];
         final int[] scratch = new int[size];
-        final int workerLimit = Math.min(LeavesXComputeExecutor.workerCount(), size);
-        final int rangeSize = divideCeil(size, Math.max(1, workerLimit));
+        final int laneLimit = Math.min(LeavesXComputeExecutor.computeLaneCount(), size);
+        final int rangeSize = divideCeil(size, Math.max(1, laneLimit));
         final boolean completedInParallel = parallel && LeavesXComputeExecutor.invokeRanges(
             size,
             parallelThreshold,
diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
index 53b52735f7bcde7c8048623a0a083c0ffc7edf48..a12413ab0588b9ecfc2ed214a5866c3fc677fd9b 100644
--- a/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
@@ -49,6 +49,16 @@ public final class LeavesXComputeExecutor {
         return workerCount;
     }
 
+    /**
+     * Returns the maximum number of ranges that can make progress concurrently.
+     *
+     * <p>The calling tick thread owns one lane so it continues doing useful pure computation instead of waiting for
+     * every worker range. A single configured worker retains the historical synchronous fallback.</p>
+     */
+    public static int computeLaneCount() {
+        return executor != null && workerCount > 1 ? workerCount + 1 : 1;
+    }
+
     /**
      * Processes contiguous ranges and waits for every range before returning.
      *
@@ -60,23 +70,36 @@ public final class LeavesXComputeExecutor {
             return false;
         }
 
-        final int taskCount = Math.min(workerCount, size);
+        final int taskCount = Math.min(computeLaneCount(), size);
         final int rangeSize = (size + taskCount - 1) / taskCount;
         final int expectedTaskCount = (size + rangeSize - 1) / rangeSize;
-        final List<Future<?>> futures = new ArrayList<>(expectedTaskCount);
+        final int callerTaskIndex = expectedTaskCount - 1;
+        final List<Future<?>> futures = new ArrayList<>(callerTaskIndex);
         boolean succeeded = true;
         try {
-            for (int start = 0; start < size; start += rangeSize) {
-                final int rangeStart = start;
-                final int rangeEnd = Math.min(size, start + rangeSize);
-                final int taskIndex = futures.size();
-                futures.add(current.submit(() -> task.run(taskIndex, rangeStart, rangeEnd)));
+            for (int taskIndex = 0; taskIndex < callerTaskIndex; taskIndex++) {
+                final int rangeTaskIndex = taskIndex;
+                final int rangeStart = taskIndex * rangeSize;
+                final int rangeEnd = Math.min(size, rangeStart + rangeSize);
+                futures.add(current.submit(() -> task.run(rangeTaskIndex, rangeStart, rangeEnd)));
             }
         } catch (final RuntimeException submissionFailure) {
             succeeded = false;
             LOGGER.error("LeavesX parallel computation could not be submitted; recomputing on the main thread", submissionFailure);
         }
 
+        boolean callerRangeCompleted = false;
+        if (futures.size() == callerTaskIndex) {
+            final int callerRangeStart = callerTaskIndex * rangeSize;
+            try {
+                task.run(callerTaskIndex, callerRangeStart, size);
+                callerRangeCompleted = true;
+            } catch (final RuntimeException | Error computationFailure) {
+                succeeded = false;
+                LOGGER.error("LeavesX caller-side computation failed; recomputing on the main thread", computationFailure);
+            }
+        }
+
         boolean interrupted = false;
         for (final Future<?> future : futures) {
             boolean completed = false;
@@ -100,7 +123,7 @@ public final class LeavesXComputeExecutor {
         if (interrupted) {
             Thread.currentThread().interrupt();
         }
-        return succeeded && futures.size() == expectedTaskCount;
+        return succeeded && callerRangeCompleted && futures.size() + 1 == expectedTaskCount;
     }
 
     /** Stops all LeavesX computation workers during normal server shutdown. */
