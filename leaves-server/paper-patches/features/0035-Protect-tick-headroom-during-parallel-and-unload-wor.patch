+    }
+
+    @Test
+    void retainsTheConfiguredSafetyCapWhileTheServerIsLagging() {
+        assertEquals(500, ChunkUnloadBudget.calculate(20_000, 1_000, 0.05, true, 1_000, 100, 500, 80_000_000L, TARGET_TICK_NANOS));
