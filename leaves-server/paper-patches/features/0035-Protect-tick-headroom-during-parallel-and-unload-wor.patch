diff --git a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
index 7d50a306f2b646db8f6d4e9f0b45cdcaa3304df8..a926dfe7caba93bb18cacd48340214b0b168dc22 100644
--- a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
+++ b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
@@ -1,12 +1,14 @@
 package org.leavesx.leavesx.runtime;
 
 import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
 import static org.junit.jupiter.api.Assertions.assertFalse;
 import static org.junit.jupiter.api.Assertions.assertTrue;
 
 import java.util.concurrent.CountDownLatch;
 import java.util.concurrent.TimeUnit;
 import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
 import java.util.concurrent.atomic.AtomicIntegerArray;
 import org.bukkit.support.environment.Normal;
 import org.junit.jupiter.api.AfterEach;
@@ -66,6 +68,26 @@ class LeavesXComputeExecutorTest {
         }
     }
 
+    @Test
+    void keepsTheCallingThreadProductiveWhileWorkersRun() {
+        LeavesXComputeExecutor.configure(4);
+        final Thread callingThread = Thread.currentThread();
+        final AtomicInteger callerRanges = new AtomicInteger();
+        final AtomicInteger workerRanges = new AtomicInteger();
+
+        final boolean parallel = LeavesXComputeExecutor.invokeRanges(1_024, 128, (taskIndex, start, end) -> {
+            if (Thread.currentThread() == callingThread) {
+                callerRanges.incrementAndGet();
+            } else {
+                workerRanges.incrementAndGet();
+            }
+        });
+
+        assertTrue(parallel);
+        assertEquals(1, callerRanges.get(), "the tick thread should compute exactly one partition instead of only waiting");
+        assertTrue(workerRanges.get() > 0, "at least one partition should still execute on a worker");
+    }
+
     @Test
     void waitsForSubmittedRangesBeforeReportingFailure() throws Exception {
         LeavesXComputeExecutor.configure(2);
