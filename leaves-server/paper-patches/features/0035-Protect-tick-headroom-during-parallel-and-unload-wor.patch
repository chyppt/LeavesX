     }
 
     @Test
     void raisesBudgetGraduallyAndCapsLargeBacklogs() {
-        assertEquals(150, ChunkUnloadBudget.calculate(2_000, 100, 0.05, true, 1_000, 100, 500));
-        assertEquals(500, ChunkUnloadBudget.calculate(20_000, 1_000, 0.05, true, 1_000, 100, 500));
+        assertEquals(150, ChunkUnloadBudget.calculate(2_000, 100, 0.05, true, 1_000, 100, 500, 20_000_000L, TARGET_TICK_NANOS));
