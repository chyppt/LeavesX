diff --git a/src/test/java/org/leavesx/leavesx/config/SensingCacheOptimizationTest.java b/src/test/java/org/leavesx/leavesx/config/SensingCacheOptimizationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..9d0a1d7b6a8672127421e4ac8345458a9c0dc3d0
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/SensingCacheOptimizationTest.java
@@ -0,0 +1,102 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.sensing.Sensing;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+@Normal
+class SensingCacheOptimizationTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedAndPaperCachesKeepPerTickVisibilitySemantics() throws IOException {
+        final List<Boolean> paperResults = this.runPerTickScenario(false);
+
+        assertEquals(List.of(true, true, false, false, false, true), paperResults);
+        assertEquals(paperResults, this.runPerTickScenario(true));
+    }
+
+    @Test
+    void switchingCacheModeDoesNotReuseEntriesFromThePreviousMode() throws IOException {
+        final Mob mob = mock(Mob.class);
+        final Entity target = targetWithId(31);
+        when(mob.hasLineOfSight(target)).thenReturn(true, false, true);
+        final Sensing sensing;
+
+        try {
+            LeavesXRuntime.publish(this.configuration(true, "mode-enabled-first.yml"));
+            sensing = new Sensing(mob);
+            assertTrue(sensing.hasLineOfSight(target));
+            assertTrue(sensing.hasLineOfSight(target));
+
+            LeavesXRuntime.publish(this.configuration(false, "mode-disabled.yml"));
+            assertFalse(sensing.hasLineOfSight(target));
+
+            LeavesXRuntime.publish(this.configuration(true, "mode-enabled-again.yml"));
+            assertTrue(sensing.hasLineOfSight(target));
+            verify(mob, times(3)).hasLineOfSight(target);
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    private List<Boolean> runPerTickScenario(final boolean optimized) throws IOException {
+        final Mob mob = mock(Mob.class);
+        final Entity visible = targetWithId(11);
+        final Entity hidden = targetWithId(12);
+        when(mob.hasLineOfSight(visible)).thenReturn(true, false);
+        when(mob.hasLineOfSight(hidden)).thenReturn(false, true);
+
+        try {
+            LeavesXRuntime.publish(this.configuration(optimized, "per-tick-" + optimized + ".yml"));
+            final Sensing sensing = new Sensing(mob);
+            final boolean firstVisible = sensing.hasLineOfSight(visible);
+            final boolean cachedVisible = sensing.hasLineOfSight(visible);
+            final boolean firstHidden = sensing.hasLineOfSight(hidden);
+            final boolean cachedHidden = sensing.hasLineOfSight(hidden);
+            sensing.tick();
+            final boolean nextTickVisible = sensing.hasLineOfSight(visible);
+            final boolean nextTickHidden = sensing.hasLineOfSight(hidden);
+
+            verify(mob, times(2)).hasLineOfSight(visible);
+            verify(mob, times(2)).hasLineOfSight(hidden);
+            return List.of(firstVisible, cachedVisible, firstHidden, cachedHidden, nextTickVisible, nextTickHidden);
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    private LeavesXConfig configuration(final boolean optimized, final String fileName) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              ai:
+                sensing-cache: %s
+            """.formatted(optimized));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static Entity targetWithId(final int id) {
+        final Entity target = mock(Entity.class);
+        when(target.getId()).thenReturn(id);
+        return target;
+    }
+}
