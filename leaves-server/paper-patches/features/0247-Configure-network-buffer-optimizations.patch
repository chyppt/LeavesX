diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
@@ -295,11 +295,11 @@
         boolean parallelMobCollisions, boolean asyncWaterPathfinding,
         boolean poiAsyncSerialization, boolean poiCompetitorScanNoLoad,
         boolean sensorListReuse, boolean recipeIndex,
-        boolean jeiRecipeSync, boolean jeiRecipeTransfer
+        boolean jeiRecipeSync, boolean jeiRecipeTransfer, boolean networkBufferOptimizations
     ) {
         public static ExtensionSettings defaults() {
             return new ExtensionSettings(true, true, false, false, true, false, true, true, true, true, false, true, false,
-                true, true, false, false, false, false, true, true, false, false);
+                true, true, false, false, false, false, true, true, false, false, true);
         }
     }
 
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
