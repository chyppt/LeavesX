 import java.util.concurrent.CountDownLatch;
 import java.util.concurrent.TimeUnit;
 import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicBoolean;
 import org.junit.jupiter.api.AfterEach;
 import org.junit.jupiter.api.Test;
 import org.leavesx.leavesx.config.LeavesXConfig;
@@ -111,6 +113,53 @@ class LeavesXAsyncRuntimeTest {
         assertEquals(0L, metrics.failedTasks());
     }
 
+    @Test
+    void retryableSubmissionNeverRunsRejectedChunkWorkOnCaller() throws Exception {
+        final LeavesXConfig.AsyncSettings chunkSettings = new LeavesXConfig.AsyncSettings(
+            true, 64, false, false, 0, 64, 30, false, 64, false, 0, 64
+        );
+        LeavesXAsyncRuntime.configure(chunkSettings);
+        final int workers = LeavesXAsyncRuntime.generalThreadCount(chunkSettings);
+        final CountDownLatch workersStarted = new CountDownLatch(workers);
+        final CountDownLatch releaseWorkers = new CountDownLatch(1);
+        final List<CompletableFuture<Void>> blockers = new ArrayList<>(workers);
+        for (int index = 0; index < workers; index++) {
+            blockers.add(LeavesXAsyncRuntime.submitOrRun(
+                LeavesXAsyncRuntime.Workload.CHUNK_SEND,
+                () -> {
+                    workersStarted.countDown();
+                    try {
+                        releaseWorkers.await();
+                    } catch (final InterruptedException interruption) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+            ));
+        }
+        assertTrue(workersStarted.await(5L, TimeUnit.SECONDS));
+        for (int index = 0; index < 64; index++) {
+            LeavesXAsyncRuntime.submitOrRun(LeavesXAsyncRuntime.Workload.CHUNK_SEND, () -> { });
+        }
+
+        final AtomicBoolean ranOnCaller = new AtomicBoolean();
+        assertNull(LeavesXAsyncRuntime.trySubmitValue(
+            LeavesXAsyncRuntime.Workload.CHUNK_SEND,
+            () -> {
+                ranOnCaller.set(true);
+                return null;
+            }
+        ));
+        assertFalse(ranOnCaller.get());
+
+        releaseWorkers.countDown();
+        CompletableFuture.allOf(blockers.toArray(CompletableFuture[]::new)).join();
+        final LeavesXAsyncRuntime.Metrics metrics = LeavesXAsyncRuntime.metrics(
+            LeavesXAsyncRuntime.Workload.CHUNK_SEND
+        );
+        assertTrue(metrics.rejectedTasks() >= 1L);
+        assertEquals(0L, metrics.callerRuns());
+    }
+
