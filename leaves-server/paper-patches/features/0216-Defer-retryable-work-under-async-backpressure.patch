Subject: [PATCH] Defer retryable work under async backpressure


diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
index a8e77300ff02d3cad493f29c1663613f7c4aedaa..4502f3cdf0884126341391b5ff1b68b54fbbb152 100644
--- a/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
@@ -160,6 +160,37 @@ public final class LeavesXAsyncRuntime {
         }
     }
 
+    /**
+     * Attempts asynchronous submission without moving rejected work onto the caller.
+     *
+     * <p>This is intended for retryable producers such as chunk sending, where leaving the item in its existing
+     * queue is safer for tick latency than performing an expensive complete fallback immediately.</p>
+     *
+     * @return a completion future, or {@code null} when the producer should retry later
+     */
+    public static <T> CompletableFuture<T> trySubmitValue(final Workload workload, final Supplier<T> task) {
+        Objects.requireNonNull(workload, "workload");
+        Objects.requireNonNull(task, "task");
+        final ExecutorState state = executors.get(workload);
+        if (state == null || !state.reserve()) {
+            if (state != null) {
+                state.rejected.incrementAndGet();
+            }
+            return null;
+        }
+
+        final CompletableFuture<T> completion = new CompletableFuture<>();
+        try {
+            state.executor.execute(() -> runValueTask(state, task, completion));
+            state.submitted.incrementAndGet();
+            return completion;
+        } catch (final RejectedExecutionException rejected) {
+            state.release();
+            state.rejected.incrementAndGet();
+            return null;
+        }
+    }
+
     /**
      * Submits work to an identity-owned lane.
      *
