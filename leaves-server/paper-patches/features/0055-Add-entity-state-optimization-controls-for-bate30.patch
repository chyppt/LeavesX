+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.AbstractList;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.entity.EquipmentSlotGroup;
+import net.minecraft.world.item.enchantment.Enchantment;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+
+/** Verifies the behavior-equivalent equipment-slot scan used by enchantments. */
+@Normal
+class EnchantmentSlotMatchingTest {
+
+    @Test
+    void directScanMatchesVanillaAnyMatchForEverySlot() throws ReflectiveOperationException {
+        final Method method = directScanMethod();
+        final List<List<EquipmentSlotGroup>> groupSets = List.of(
+            List.of(),
+            List.of(EquipmentSlotGroup.ANY),
+            List.of(EquipmentSlotGroup.MAINHAND),
+            List.of(EquipmentSlotGroup.ARMOR),
+            List.of(EquipmentSlotGroup.OFFHAND, EquipmentSlotGroup.HAND),
+            List.of(EquipmentSlotGroup.FEET, EquipmentSlotGroup.LEGS, EquipmentSlotGroup.CHEST),
+            List.of(EquipmentSlotGroup.BODY, EquipmentSlotGroup.SADDLE, EquipmentSlotGroup.ANY)
+        );
+
+        for (final List<EquipmentSlotGroup> groups : groupSets) {
+            for (final EquipmentSlot slot : EquipmentSlot.VALUES) {
+                final boolean vanilla = groups.stream().anyMatch(group -> group.test(slot));
+                final boolean optimized = (boolean)method.invoke(null, groups, slot);
+                assertEquals(vanilla, optimized, () -> "groups=" + groups + ", slot=" + slot);
+            }
+        }
+    }
+
+    @Test
+    void directScanStopsAfterTheFirstMatchingGroup() throws ReflectiveOperationException {
+        final List<EquipmentSlotGroup> guardedGroups = new AbstractList<>() {
+            @Override
+            public EquipmentSlotGroup get(final int index) {
+                if (index == 0) {
+                    return EquipmentSlotGroup.FEET;
+                }
+                if (index == 1) {
+                    return EquipmentSlotGroup.MAINHAND;
+                }
+                throw new AssertionError("Scan continued after the first matching group");
+            }
+
+            @Override
+            public int size() {
+                return 3;
+            }
+        };
+
+        assertTrue((boolean)directScanMethod().invoke(null, guardedGroups, EquipmentSlot.MAINHAND));
+    }
+
+    @Test
+    void directSlotHelperDoesNotCreateStreams() throws IOException {
+        final List<Invocation> calls = new ArrayList<>();
+        final boolean[] found = {false};
+        new ClassReader(Enchantment.class.getName()).accept(
+            new ClassVisitor(Opcodes.ASM9) {
+                @Override
+                public MethodVisitor visitMethod(
+                    final int access,
+                    final String name,
+                    final String descriptor,
+                    final String signature,
+                    final String[] exceptions
+                ) {
+                    if (!name.equals("matchesSlotDirect")) {
+                        return null;
+                    }
+                    found[0] = true;
+                    return new MethodVisitor(Opcodes.ASM9) {
+                        @Override
+                        public void visitMethodInsn(
+                            final int opcode,
+                            final String owner,
+                            final String calledName,
+                            final String calledDescriptor,
+                            final boolean isInterface
+                        ) {
+                            calls.add(new Invocation(owner, calledName));
+                        }
+                    };
+                }
+            },
+            ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES
+        );
+
+        assertTrue(found[0], "Missing Enchantment#matchesSlotDirect");
+        assertFalse(calls.stream().anyMatch(call -> call.name().equals("stream")));
+        assertFalse(calls.stream().anyMatch(call -> call.owner().startsWith("java/util/stream/")));
+    }
+
+    private static Method directScanMethod() throws NoSuchMethodException {
+        final Method method = Enchantment.class.getDeclaredMethod(
+            "matchesSlotDirect",
+            List.class,
+            EquipmentSlot.class
+        );
+        method.setAccessible(true);
+        return method;
+    }
+
+    private record Invocation(String owner, String name) {
+    }
+}
