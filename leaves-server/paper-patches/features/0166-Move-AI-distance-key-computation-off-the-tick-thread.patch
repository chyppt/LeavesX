+    /**
+     * Computes immutable distance keys and sorts each disjoint range in the same worker invocation.
+     *
+     * <p>Fusing these stages moves all distance arithmetic off the tick thread without adding another dispatch or
+     * exposing live entities to workers. A failed invocation recomputes every key from the private snapshot before
+     * taking the synchronous path, so partially completed ranges can never leak into the result.</p>
+     */
+    private static void sortCoordinateSnapshot(
+        final Workspace workspace,
+        final int size,
+        final double originX,
+        final double originY,
+        final double originZ,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        final int completedPartitions = parallel
+            ? LeavesXComputeExecutor.invokeRangesWithCount(
+                LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                size,
+                parallelThreshold,
+                LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker(),
+                (taskIndex, start, end) -> {
+                    computeDistanceKeysAndInitializeOrder(
+                        workspace,
+                        start,
+                        end,
+                        originX,
+                        originY,
+                        originZ
+                    );
+                    stableRadixRange(
+                        workspace.order,
+                        workspace.scratch,
+                        workspace.keys,
+                        start,
+                        end,
+                        workspace.laneOffsets,
+                        taskIndex * RADIX_BUCKETS
+                    );
+                }
+            )
+            : 0;
+
+        if (completedPartitions == 0) {
+            computeDistanceKeysAndInitializeOrder(workspace, 0, size, originX, originY, originZ);
+            stableRadixRange(workspace.order, workspace.scratch, workspace.keys, 0, size, workspace.offsets, 0);
+            return;
+        }
+
+        mergeSortedPartitions(workspace, size, completedPartitions);
+    }
+
+    /** Completes the stable merge tree after independently sorted contiguous ranges. */
+    private static void mergeSortedPartitions(
+        final Workspace workspace,
+        final int size,
+        final int completedPartitions
+    ) {
         final int rangeSize = divideCeil(size, completedPartitions);
         for (int width = rangeSize; width < size; width = nextMergeWidth(width, size)) {
             final int step = width >= size - width ? size : width << 1;
@@ -242,6 +304,78 @@ public final class StableDistanceSorter {
         }
     }
 
+    /** Captures every live coordinate on the calling tick thread before any worker is scheduled. */
+    private static <T extends Entity> void snapshotEntityCoordinates(
+        final List<T> entities,
+        final Workspace workspace,
+        final int size
+    ) {
+        workspace.ensureCoordinateCapacity(size);
+        for (int index = 0; index < size; index++) {
+            final Entity entity = entities.get(index);
+            workspace.x[index] = entity.getX();
+            workspace.y[index] = entity.getY();
+            workspace.z[index] = entity.getZ();
+        }
+    }
+
+    /** Keeps small synchronous lists on the allocation-free single-pass path. */
+    private static <T extends Entity> void snapshotEntityDistanceKeys(
+        final List<T> entities,
+        final Workspace workspace,
+        final int size,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        for (int index = 0; index < size; index++) {
+            final Entity entity = entities.get(index);
+            workspace.keys[index] = sortableDistanceKey(
+                squaredDistance(originX, originY, originZ, entity.getX(), entity.getY(), entity.getZ())
+            );
+            workspace.order[index] = index;
+        }
+    }
+
+    /** Calculates one primitive snapshot range and initializes the matching stable identity order. */
+    private static void computeDistanceKeysAndInitializeOrder(
+        final Workspace workspace,
+        final int start,
+        final int end,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        for (int index = start; index < end; index++) {
+            workspace.keys[index] = sortableDistanceKey(
+                squaredDistance(originX, originY, originZ, workspace.x[index], workspace.y[index], workspace.z[index])
+            );
+            workspace.order[index] = index;
+        }
+    }
+
+    /** Calculates keys and returns the first nearest index inside one disjoint primitive snapshot range. */
+    private static int computeDistanceKeysAndFindNearest(
+        final Workspace workspace,
+        final int start,
+        final int end,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        int nearest = -1;
+        for (int index = start; index < end; index++) {
+            final long key = sortableDistanceKey(
+                squaredDistance(originX, originY, originZ, workspace.x[index], workspace.y[index], workspace.z[index])
+            );
+            workspace.keys[index] = key;
+            if (nearest < 0 || Long.compareUnsigned(key, workspace.keys[nearest]) < 0) {
+                nearest = index;
+            }
+        }
+        return nearest;
+    }
+
     /** Merges independent ordered range pairs; callers may safely assign disjoint pair indexes to workers. */
     private static void mergePairs(
         final int[] order,
@@ -440,6 +574,9 @@ public final class StableDistanceSorter {
 
         private final boolean pooled;
         private final int[] offsets = new int[RADIX_BUCKETS];
