Subject: [PATCH] Add POI bed entity query coverage for bate54


diff --git a/src/test/java/org/leavesx/leavesx/performance/ValidateNearbyPoiEntityQueryHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ValidateNearbyPoiEntityQueryHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2318b00d705c0923481440236f5a34e4d3a6e567
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ValidateNearbyPoiEntityQueryHotPathTest.java
@@ -0,0 +1,53 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ai.behavior.ValidateNearbyPoi;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies villager POI validation can stop after finding one sleeping villager. */
+@Normal
+class ValidateNearbyPoiEntityQueryHotPathTest {
+
+    @Test
+    void occupiedBedValidationKeepsOptimizedAndVanillaPaths() throws IOException {
+        final ClassNode validation = classNode(ValidateNearbyPoi.class);
+        final MethodNode occupiedByVillager = method(validation, "bedIsOccupiedByVillager");
+        final List<MethodInsnNode> calls = invocations(occupiedByVillager);
+
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime") && call.name.equals("entityQueryOptimizations")
+        ));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getFirstEntityOfClass")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("getEntitiesOfClass")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
