+package org.leavesx.leavesx.config;
+
+/**
+ * Fine-grained switches for independently disabling LeavesX optimizations.
+ *
+ * <p>The runtime stores these values in one primitive bit mask. Configuration stays detailed without adding map
+ * lookups or object traversal to entity, AI, and block-entity hot paths.</p>
+ */
+enum LeavesXOptimization {
+
+    HOPPER_ENTITY_QUERIES(
+        "performance.block-entity.hopper-entity-queries",
+        "优化漏斗实体查询，关闭后使用原版查询。默认：true。"
+    ),
+    FIRST_MATCH_ENTITY_QUERIES(
+        "performance.entity-queries.first-match-queries",
+        "只需要一个实体时提前停止搜索，关闭后构建完整列表。默认：true。"
+    ),
+    PRESSURE_PLATE_ENTITY_SCANS(
+        "performance.entity-queries.pressure-plate-scans",
+        "复用压力板实体扫描结果，关闭后使用原版扫描。默认：true。"
+    ),
+    TRIPWIRE_ENTITY_SCANS(
+        "performance.entity-queries.tripwire-scans",
+        "复用绊线实体扫描结果，关闭后使用原版扫描。默认：true。"
+    ),
+    DETECTOR_RAIL_ENTITY_QUERIES(
+        "performance.entity-queries.detector-rail-queries",
+        "限制探测铁轨只查需要的矿车，关闭后查询完整列表。默认：true。"
+    ),
+    COMPARATOR_ITEM_FRAME_QUERIES(
+        "performance.entity-queries.comparator-item-frame-queries",
+        "限制比较器物品展示框查询数量，关闭后查询完整列表。默认：true。"
+    ),
+    CHEST_CAT_DETECTION(
+        "performance.entity-queries.chest-cat-detection",
+        "找到阻挡箱子的猫后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    CONTAINER_OPENER_RECOUNT(
+        "performance.block-entity.container-opener-recount",
+        "复用容器开关人数扫描结果，关闭后使用原版扫描。默认：true。"
+    ),
+    OCCUPIED_BED_VILLAGER_QUERIES(
+        "performance.entity-queries.occupied-bed-villager-queries",
+        "找到占床村民后停止搜索，关闭后查询完整列表。默认：true。"
