+    SPAWNER_NEARBY_ENTITY_SCANS(
+        "performance.entity-queries.spawner-nearby-entity-scans",
+        "刷怪笼达到实体上限后停止计数，关闭后查询完整列表。默认：true。"
+    ),
+    ENDERMAN_PLACEMENT_CHECKS(
+        "performance.entity-queries.enderman-placement-checks",
+        "末影人放置方块时找到占位实体后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    SHULKER_DUPLICATION_DENSITY(
+        "performance.entity-queries.shulker-duplication-density",
+        "潜影贝复制达到密度上限后停止计数，关闭后查询完整列表。默认：true。"
