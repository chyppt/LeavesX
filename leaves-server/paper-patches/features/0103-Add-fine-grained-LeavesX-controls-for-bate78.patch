+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
@@ -232,13 +232,24 @@ public final class LeavesXConfigLoader {
                     node.node("performance", "chunk-unloading", "maximum-per-tick"),
                     "performance.chunk-unloading.maximum-per-tick",
                     500
-                )
+                ),
+                readFineGrainedOptimizationMask(node)
             );
         } catch (final IllegalArgumentException ex) {
             throw new LeavesXConfigException("Invalid LeavesX configuration at " + path + ": " + ex.getMessage(), ex);
         }
     }
 
+    private static long readFineGrainedOptimizationMask(final ConfigurationNode node) {
+        long enabledMask = 0L;
+        for (final LeavesXOptimization optimization : LeavesXOptimization.cachedValues()) {
+            if (readBoolean(node.node(optimization.nodePath()), optimization.path(), true)) {
+                enabledMask |= optimization.mask();
+            }
+        }
+        return enabledMask;
+    }
+
     private static void save(final Path path, final LeavesXConfig config) throws IOException, ConfigurateException {
         save(path, LeavesXConfigWriter.render(config, HEADER));
     }
