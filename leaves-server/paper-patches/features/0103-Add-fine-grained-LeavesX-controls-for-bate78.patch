+    ),
+    EQUIPMENT_DISPENSER(
+        "performance.entity-queries.equipment-dispenser",
+        "发射器装备物品时找到目标后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    CAT_SLEEPING_PLAYER(
+        "performance.entity-queries.cat-sleeping-player",
+        "猫寻找睡眠玩家时找到目标后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    CAT_RELAX_OCCUPANCY(
+        "performance.entity-queries.cat-relax-occupancy",
+        "猫检查床和箱子占用时找到实体后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    PANDA_EDIBLE_ITEMS(
+        "performance.entity-queries.panda-edible-items",
+        "熊猫找到可食用物品后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    DOLPHIN_ITEM_PLAY(
+        "performance.entity-queries.dolphin-item-play",
+        "海豚找到可玩的物品后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    FOX_ITEM_SEARCH(
+        "performance.entity-queries.fox-item-search",
+        "狐狸找到可拾取物品后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    PUFFERFISH_DANGER_SCANS(
+        "performance.entity-queries.pufferfish-danger-scans",
+        "河豚找到危险生物后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    EXPERIENCE_ORB_MERGE(
+        "performance.entity-queries.experience-orb-merge",
+        "经验球合并达到需要数量后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    CHICKEN_JOCKEY_MOUNT(
+        "performance.entity-queries.chicken-jockey-mount",
+        "鸡骑士找到可用鸡后停止搜索，关闭后查询完整列表。默认：true。"
+    ),
+    BREEZE_ATTACK_SENSOR(
+        "performance.ai.breeze-attack-sensor",
+        "减少旋风人攻击传感器的临时对象，关闭后使用原版流程。默认：true。"
+    ),
+    WARDEN_TARGET_SENSOR(
+        "performance.ai.warden-target-sensor",
+        "减少监守者目标传感器的临时对象，关闭后使用原版流程。默认：true。"
+    );
+
+    private static final LeavesXOptimization[] VALUES = values();
+    private static final long ALL_ENABLED_MASK = (1L << VALUES.length) - 1L;
+
+    private final String path;
+    private final String comment;
+    private final long mask;
+
+    LeavesXOptimization(final String path, final String comment) {
+        this.path = path;
+        this.comment = comment;
+        this.mask = 1L << this.ordinal();
+    }
+
+    static LeavesXOptimization[] cachedValues() {
+        return VALUES;
+    }
+
+    static long allEnabledMask() {
+        return ALL_ENABLED_MASK;
+    }
+
+    static int count() {
+        return VALUES.length;
+    }
+
+    String path() {
+        return this.path;
+    }
+
+    Object[] nodePath() {
+        return this.path.split("\\.");
+    }
+
+    String comment() {
+        return this.comment;
+    }
+
+    long mask() {
+        return this.mask;
+    }
+
+    boolean enabledIn(final long enabledMask) {
+        return (enabledMask & this.mask) != 0L;
+    }
+}
