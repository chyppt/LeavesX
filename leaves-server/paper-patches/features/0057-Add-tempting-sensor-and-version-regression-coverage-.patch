-/** Verifies that custom LeavesX builds never query the upstream Leaves release service. */
+/** Verifies that custom LeavesX builds never query upstream Paper or Leaves release services. */
 @Normal
 class LeavesVersionFetcherTest {
 
@@ -39,4 +42,32 @@ class LeavesVersionFetcherTest {
         verify(build).buildNumber();
         verifyNoMoreInteractions(build);
     }
+
+    @Test
+    void leavesXBuildSkipsPaperStartupUpdateLookup() throws ReflectiveOperationException {
+        final ServerBuildInfo build = mock();
+        when(build.brandName()).thenReturn("LeavesX");
+
+        assertFalse((boolean)paperStartupUpdateMethod().invoke(null, build));
+
+        verify(build).brandName();
+        verifyNoMoreInteractions(build);
+    }
+
+    @Test
+    void upstreamBuildKeepsPaperStartupUpdateLookup() throws ReflectiveOperationException {
+        final ServerBuildInfo build = mock();
+        when(build.brandName()).thenReturn("Paper");
+
+        assertTrue((boolean)paperStartupUpdateMethod().invoke(null, build));
+
+        verify(build).brandName();
+        verifyNoMoreInteractions(build);
+    }
+
+    private static Method paperStartupUpdateMethod() throws NoSuchMethodException {
+        final Method method = PaperVersionFetcher.class.getDeclaredMethod("shouldCheckPaperUpdates", ServerBuildInfo.class);
+        method.setAccessible(true);
+        return method;
+    }
 }
