diff --git a/src/test/java/org/leavesx/leavesx/performance/MinecartMotionSyncHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/MinecartMotionSyncHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..47a5b42201d17df35ddbdfc159fdcbf3a81846e5
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/MinecartMotionSyncHotPathTest.java
@@ -0,0 +1,115 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.server.level.ServerEntity;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.JumpInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies minecart synchronization skips only a provably zero movement-distance calculation. */
+@Normal
+class MinecartMotionSyncHotPathTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void identityShortcutMatchesVanillaDistanceForRepresentativeVectors() {
+        final Vec3 shared = new Vec3(1.25D, -0.5D, 8.0D);
+        final Vec3 equalCopy = new Vec3(1.25D, -0.5D, 8.0D);
+        final Vec3 changed = new Vec3(1.5D, -0.25D, 7.5D);
+
+        assertDistanceEquivalent(shared, shared);
+        assertDistanceEquivalent(shared, equalCopy);
+        assertDistanceEquivalent(changed, shared);
+        assertDistanceEquivalent(Vec3.ZERO, shared);
+    }
+
+    @Test
+    void dedicatedSwitchCanDisableTheIdentityShortcut() throws Exception {
+        try {
+            publish(this.configuration(true, "enabled.yml"));
+            assertTrue(LeavesXRuntime.minecartMotionDistanceOptimization());
+
+            publish(this.configuration(false, "disabled.yml"));
+            assertFalse(LeavesXRuntime.minecartMotionDistanceOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void minecartSyncKeepsIdentityAndDistancePaths() throws IOException {
+        final MethodNode method = method(classNode(), "handleMinecartPosRot");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+        final boolean hasIdentityBranch = Arrays.stream(method.instructions.toArray())
+            .filter(JumpInsnNode.class::isInstance)
+            .map(JumpInsnNode.class::cast)
+            .anyMatch(instruction -> instruction.getOpcode() == Opcodes.IF_ACMPNE || instruction.getOpcode() == Opcodes.IF_ACMPEQ);
+
+        assertEquals(1L, countCall(calls, "org/leavesx/leavesx/config/LeavesXRuntime", "minecartMotionDistanceOptimization"));
+        assertEquals(1L, countCall(calls, "net/minecraft/world/phys/Vec3", "distanceToSqr"));
+        assertTrue(hasIdentityBranch);
+    }
+
+    private static void assertDistanceEquivalent(final Vec3 movement, final Vec3 lastSentMovement) {
+        final double vanilla = movement.distanceToSqr(lastSentMovement);
+        final double optimized = movement == lastSentMovement ? 0.0D : movement.distanceToSqr(lastSentMovement);
+        assertEquals(vanilla, optimized);
+    }
+
+    private LeavesXConfig configuration(final boolean enabled, final String fileName) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-sync:
+                minecart-motion-distance: %s
+            """.formatted(enabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(ServerEntity.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static long countCall(final MethodInsnNode[] calls, final String owner, final String name) {
+        return Arrays.stream(calls).filter(call -> call.owner.equals(owner) && call.name.equals(name)).count();
+    }
+}
