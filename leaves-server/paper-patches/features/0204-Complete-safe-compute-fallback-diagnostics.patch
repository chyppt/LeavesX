+    private static void reloadConfiguration(final CommandSender sender) {
+        if (!sender.isOp() && !sender.hasPermission("leavesx.command.reload")) {
+            sender.sendMessage(Component.text("你没有权限重载 LeavesX 配置。", NamedTextColor.RED));
+            return;
+        }
+        try {
+            final LeavesXConfigBootstrap.ReloadResult result = LeavesXConfigBootstrap.reloadWithStatus();
+            sender.sendMessage(Component.text("LeavesX 配置重载完成。", NamedTextColor.GREEN));
+            if (result.restartRequired()) {
+                sender.sendMessage(Component.text(
+                    "以下配置需要重启服务器才会完全生效：" + String.join("、", result.restartRequiredChanges()),
+                    NamedTextColor.YELLOW
+                ));
+            } else {
+                sender.sendMessage(Component.text("本次修改无需重启。", NamedTextColor.GRAY));
+            }
+            Bukkit.getOnlinePlayers().stream()
+                .filter(player -> player.hasPermission("leaves.command.config.notify") && player != sender)
+                .forEach(player -> player.sendMessage(Component.text("LeavesX 配置已重载。", NamedTextColor.GREEN)));
+        } catch (final RuntimeException exception) {
+            org.slf4j.LoggerFactory.getLogger(LeavesXCommand.class)
+                .error("Failed to reload LeavesX configuration", exception);
+            sender.sendMessage(Component.text("LeavesX 配置重载失败，请查看控制台日志。", NamedTextColor.RED));
+        }
+    }
