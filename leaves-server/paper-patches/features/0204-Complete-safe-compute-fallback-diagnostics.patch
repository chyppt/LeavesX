+        final int limit = 3;
+        final List<World> worlds = Bukkit.getWorlds();
+        final EntitySnapshot entities = collectEntities(worlds);
+        final BlockEntitySnapshot blockEntities = collectBlockEntities(worlds);
+        final Map<String, List<String>> lore = new HashMap<>();
+
+        final List<String> worldLines = new ArrayList<>();
+        for (int index = 0; index < Math.min(limit, worlds.size()); index++) {
+            final World world = worlds.get(index);
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            worldLines.add(shortWorld(world.getKey().toString()) + "：区块 "
+                + level.getChunkSource().getFullChunksCount() + " / 实体 " + level.getEntityCount());
+        }
+        lore.put("worlds", List.copyOf(worldLines));
+
+        final List<Map.Entry<Identifier, MutableEntityCount>> entityTypes = new ArrayList<>(entities.counts().entrySet());
+        entityTypes.sort(Comparator.<Map.Entry<Identifier, MutableEntityCount>>comparingInt(entry -> entry.getValue().total)
+            .reversed().thenComparing(entry -> entry.getKey().toString()));
+        final List<String> entityLines = new ArrayList<>();
+        entityLines.add("总数 " + entities.total() + " / 活跃 " + entities.ticking());
+        for (int index = 0; index < Math.min(limit, entityTypes.size()); index++) {
+            final Map.Entry<Identifier, MutableEntityCount> entry = entityTypes.get(index);
+            entityLines.add((index + 1) + ". " + shortId(entry.getKey().toString()) + " " + entry.getValue().total
+                + "（活跃 " + entry.getValue().ticking + "）");
+        }
+        lore.put("entities", List.copyOf(entityLines));
+
+        final List<EntityHotspot> entityHotspots = new ArrayList<>(entities.hotspots());
+        entityHotspots.sort(Comparator.comparingInt(EntityHotspot::total).reversed()
+            .thenComparing(EntityHotspot::world).thenComparingInt(EntityHotspot::chunkX).thenComparingInt(EntityHotspot::chunkZ));
+        final List<String> hotspotLines = new ArrayList<>();
+        for (int index = 0; index < Math.min(limit, entityHotspots.size()); index++) {
+            final EntityHotspot hotspot = entityHotspots.get(index);
+            hotspotLines.add((index + 1) + ". " + shortWorld(hotspot.world()) + " 区块[" + hotspot.chunkX() + ','
+                + hotspot.chunkZ() + "] " + hotspot.total() + "（活跃 " + hotspot.ticking() + "）");
+        }
+        lore.put("hotspots", hotspotLines.isEmpty() ? List.of("当前没有实体热点") : List.copyOf(hotspotLines));
+
+        final List<Map.Entry<Identifier, MutableBlockEntityCount>> blockTypes = new ArrayList<>(blockEntities.counts().entrySet());
+        blockTypes.sort(Comparator.<Map.Entry<Identifier, MutableBlockEntityCount>>comparingInt(entry -> entry.getValue().total)
+            .reversed().thenComparing(entry -> entry.getKey().toString()));
+        final List<String> blockEntityLines = new ArrayList<>();
+        blockEntityLines.add("总数 " + blockEntities.total() + " / 更新 " + blockEntities.ticking());
+        for (int index = 0; index < Math.min(limit, blockTypes.size()); index++) {
+            final Map.Entry<Identifier, MutableBlockEntityCount> entry = blockTypes.get(index);
+            blockEntityLines.add((index + 1) + ". " + shortId(entry.getKey().toString()) + " " + entry.getValue().total
