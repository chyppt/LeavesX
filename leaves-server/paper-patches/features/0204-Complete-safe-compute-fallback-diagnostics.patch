+    private static List<String> collectGuiNetworkLore() {
+        final List<Connection> connections = MinecraftServer.getServer().getConnection().getConnections();
+        double inboundPackets = 0.0D;
+        double outboundPackets = 0.0D;
+        int pendingActions = 0;
+        int nonWritable = 0;
+        int connectionCount;
+        synchronized (connections) {
+            connectionCount = connections.size();
+            for (final Connection connection : connections) {
+                inboundPackets += connection.getAverageReceivedPackets();
+                outboundPackets += connection.getAverageSentPackets();
+                pendingActions += connection.leavesX$getPendingActionCount();
+                if (connection.channel != null && !connection.channel.isWritable()) {
+                    nonWritable++;
+                }
+            }
+        }
+        return List.of(
+            "连接 " + connectionCount + " / 玩家 " + Bukkit.getOnlinePlayers().size(),
+            "包/秒 收 " + oneDecimal(inboundPackets) + " / 发 " + oneDecimal(outboundPackets),
+            "发送待处理 " + pendingActions + " / 不可写 " + nonWritable
+        );
+    }
