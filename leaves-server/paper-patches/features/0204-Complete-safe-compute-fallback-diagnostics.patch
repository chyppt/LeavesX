+    /** Prints bounded recent-window counters for diagnosing unexpected single-thread execution. */
+    private static void sendParallel(final CommandSender sender, final String[] args) {
+        int requestedSeconds = 60;
+        if (args.length >= 2) {
+            try {
+                requestedSeconds = Math.clamp(Integer.parseInt(args[1]), 10, 300);
+            } catch (final NumberFormatException exception) {
+                sender.sendMessage(Component.text("时间必须是 10 到 300 秒的整数。", NamedTextColor.RED));
+                return;
+            }
+        }
+
+        final LeavesXComputeExecutor.WindowMetrics window = LeavesXComputeExecutor.recentMetrics(requestedSeconds);
+        sendHeader(sender, "LeavesX 并行回退诊断");
+        sender.sendMessage(Component.text(
+            "窗口 " + oneDecimal(window.elapsedNanos() / 1_000_000_000.0D) + " 秒（约 " + requestedSeconds + " 秒）",
+            NamedTextColor.GRAY
+        ));
+        sender.sendMessage(line(
+            "总体调用",
+            window.invocations() + " 次 / 并行 " + window.parallelInvocations() + " 次 / 主线程完整回退 "
+                + window.mainThreadFallbacks() + " 次 / 仅主线程执行 " + window.callerOnlyInvocations() + " 次",
+            window.mainThreadFallbacks() == 0L ? NamedTextColor.GREEN : NamedTextColor.YELLOW
+        ));
+        sender.sendMessage(line(
+            "正常未并行",
+            "低于阈值 " + window.belowThresholdFallbacks() + " / 分区不足 "
+                + window.insufficientPartitionFallbacks() + " / 线程池不可用 " + window.unavailableParallelismFallbacks(),
+            NamedTextColor.GRAY
+        ));
+        sender.sendMessage(line(
+            "异常与提交",
+            "计算异常 " + window.failedInvocations() + " / 提交回退 " + window.submissionFallbacks()
+                + " / 队列拥堵 " + window.queueContentionFallbacks() + " / 拒绝任务 " + window.rejectedTasks(),
+            window.failedInvocations() == 0L && window.submissionFallbacks() == 0L
+                ? NamedTextColor.GREEN
+                : NamedTextColor.RED
+        ));
+        sender.sendMessage(line(
+            "工作量分布",
+            "主线程 " + window.callerItems() + " 项 / 工作线程 " + window.workerItems() + " 项",
+            window.workerItems() == 0L && window.invocations() > 0L ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+        ));
+        for (final LeavesXComputeExecutor.WorkloadWindowMetrics workload : window.workloads()) {
+            sender.sendMessage(line(
+                workload.workload().displayName(),
+                workload.invocations() + " 调用 / 并行 " + workload.parallelInvocations()
+                    + " / 主线程回退 " + workload.mainThreadFallbacks()
+                    + " / 仅主线程 " + workload.callerOnlyInvocations()
+                    + " / 异常 " + workload.failedInvocations()
+                    + " / 工作量 主 " + workload.callerItems() + "、工 " + workload.workerItems(),
+                workload.failedInvocations() == 0L ? NamedTextColor.GRAY : NamedTextColor.RED
+            ));
+        }
+        final LeavesXComputeExecutor.Metrics lifetime = LeavesXComputeExecutor.metrics();
+        sender.sendMessage(Component.text(
+            "最近一次原因：" + lifetime.lastFallbackReason()
+                + (lifetime.lastFallbackWorkload() == null ? "" : " / " + lifetime.lastFallbackWorkload().displayName()),
+            NamedTextColor.GRAY
+        ));
+        sender.sendMessage(Component.text(
+            "说明：阈值回退表示任务太小；完整主线程回退才表示一次并行尝试没有使用工作线程或需要重算。",
+            NamedTextColor.DARK_GRAY
+        ));
+    }
