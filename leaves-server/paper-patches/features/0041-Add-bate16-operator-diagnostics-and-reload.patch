@@ -0,0 +1,46 @@
+package org.leavesx.leavesx.diagnostics;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.concurrent.TimeUnit;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class LeavesXTickDiagnosticsTest {
+
+    private static final long HUNDRED_MILLISECONDS = TimeUnit.MILLISECONDS.toNanos(100L);
+
+    @Test
+    void classifiesCpuBoundTicks() {
+        assertEquals(
+            LeavesXTickDiagnostics.StallType.COMPUTE,
+            LeavesXTickDiagnostics.classify(HUNDRED_MILLISECONDS, TimeUnit.MILLISECONDS.toNanos(90L), true)
+        );
+    }
+
+    @Test
+    void distinguishesWaitsFromHostPausesUsingSamplerEvidence() {
+        final long lowCpuTime = TimeUnit.MILLISECONDS.toNanos(10L);
+        assertEquals(
+            LeavesXTickDiagnostics.StallType.WAIT_OR_SCHEDULING,
+            LeavesXTickDiagnostics.classify(HUNDRED_MILLISECONDS, lowCpuTime, true)
+        );
+        assertEquals(
+            LeavesXTickDiagnostics.StallType.JVM_OR_HOST_PAUSE,
+            LeavesXTickDiagnostics.classify(HUNDRED_MILLISECONDS, lowCpuTime, false)
+        );
+    }
+
+    @Test
+    void classifiesMixedAndUnavailableCpuSamples() {
+        assertEquals(
+            LeavesXTickDiagnostics.StallType.MIXED,
+            LeavesXTickDiagnostics.classify(HUNDRED_MILLISECONDS, TimeUnit.MILLISECONDS.toNanos(50L), true)
+        );
+        assertEquals(
+            LeavesXTickDiagnostics.StallType.UNKNOWN,
+            LeavesXTickDiagnostics.classify(HUNDRED_MILLISECONDS, -1L, true)
+        );
+    }
+}
