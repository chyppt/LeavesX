@@ -0,0 +1,31 @@
+package org.leavesx.leavesx.diagnostics;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class LeavesXSystemDiagnosticsTest {
+
+    @Test
+    void parsesBoundedCpuQuota() {
+        final LeavesXSystemDiagnostics.CpuQuota quota = LeavesXSystemDiagnostics.parseCpuQuota("800000 100000");
+
+        assertTrue(quota.known());
+        assertFalse(quota.unlimited());
+        assertEquals(8.0D, quota.processors());
+    }
+
+    @Test
+    void parsesUnlimitedAndInvalidCpuQuota() {
+        final LeavesXSystemDiagnostics.CpuQuota unlimited = LeavesXSystemDiagnostics.parseCpuQuota("max 100000");
+        final LeavesXSystemDiagnostics.CpuQuota invalid = LeavesXSystemDiagnostics.parseCpuQuota("invalid");
+
+        assertTrue(unlimited.known());
+        assertTrue(unlimited.unlimited());
+        assertFalse(invalid.known());
+    }
+}
