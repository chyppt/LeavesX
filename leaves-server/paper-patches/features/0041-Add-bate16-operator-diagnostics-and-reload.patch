+    private static void sendSystem(final CommandSender sender) {
+        final LeavesXSystemDiagnostics.Snapshot snapshot = LeavesXSystemDiagnostics.capture();
+        final LeavesXSystemDiagnostics.CpuQuota quota = snapshot.cpuQuota();
+        final String quotaDescription;
+        if (!quota.known()) {
+            quotaDescription = "未知";
+        } else if (quota.unlimited()) {
+            quotaDescription = "无限制";
+        } else {
+            quotaDescription = oneDecimal(quota.processors()) + " 核（" + quota.quotaMicros() + "/"
+                + quota.periodMicros() + " 微秒）";
+        }
+
+        final String throttleDescription;
+        if (snapshot.throttledPeriods() < 0L) {
+            throttleDescription = "未知";
+        } else {
+            final double throttledRatio = snapshot.cpuPeriods() <= 0L
+                ? 0.0D
+                : snapshot.throttledPeriods() * 100.0D / snapshot.cpuPeriods();
+            throttleDescription = snapshot.throttledPeriods() + " 次 / "
+                + (snapshot.throttledMicros() < 0L
+                    ? "时长未知"
+                    : oneDecimal(snapshot.throttledMicros() / 1_000_000.0D) + " 秒") + " / "
+                + oneDecimal(throttledRatio) + "% 周期";
+        }
+
+        sendHeader(sender, "系统与配额");
+        sender.sendMessage(line("JVM 可用处理器", Integer.toString(snapshot.jvmProcessors()), NamedTextColor.AQUA));
+        sender.sendMessage(line("进程允许 CPU", valueOrUnknown(snapshot.allowedCpuList()), NamedTextColor.AQUA));
+        sender.sendMessage(line("cgroup CPU 集", valueOrUnknown(snapshot.effectiveCpuSet()), NamedTextColor.AQUA));
+        sender.sendMessage(line("cgroup CPU 配额", quotaDescription, quota.known() ? NamedTextColor.AQUA : NamedTextColor.YELLOW));
+        sender.sendMessage(line("CPU 节流累计", throttleDescription, snapshot.throttledPeriods() > 0L ? NamedTextColor.YELLOW : NamedTextColor.GREEN));
+        sender.sendMessage(line(
+            "CPU 负载",
+            "进程 " + formatPercent(snapshot.processCpuLoad()) + " / 系统 " + formatPercent(snapshot.systemCpuLoad()),
+            NamedTextColor.AQUA
+        ));
+        sender.sendMessage(line(
+            "物理内存",
+            formatUsedTotal(snapshot.physicalTotal(), snapshot.physicalFree()),
+            memoryPressureColor(snapshot.physicalTotal(), snapshot.physicalFree())
+        ));
+        sender.sendMessage(line(
+            "交换区",
+            formatUsedTotal(snapshot.swapTotal(), snapshot.swapFree()),
+            snapshot.swapTotal() > 0L && snapshot.swapFree() < snapshot.swapTotal() ? NamedTextColor.YELLOW : NamedTextColor.GREEN
+        ));
+        sender.sendMessage(line(
+            "cgroup 内存",
+            snapshot.cgroupMemoryCurrent() < 0L || snapshot.cgroupMemoryMaximum() < 0L
+                ? "未知"
+                : snapshot.cgroupMemoryMaximum() == Long.MAX_VALUE
+                ? formatBytes(snapshot.cgroupMemoryCurrent()) + " / 无限制"
+                : formatBytes(snapshot.cgroupMemoryCurrent()) + " / " + formatBytes(snapshot.cgroupMemoryMaximum()),
+            NamedTextColor.AQUA
+        ));
+    }
