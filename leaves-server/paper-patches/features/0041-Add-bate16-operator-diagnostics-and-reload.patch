+package org.leavesx.leavesx.command;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.format.TextDecoration;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.World;
+import org.bukkit.command.CommandSender;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.Listener;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryDragEvent;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.InventoryHolder;
+import org.bukkit.inventory.ItemStack;
+import org.leavesmc.leaves.plugin.MinecraftInternalPlugin;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+/** Read-only inventory entry point for LeavesX diagnostics. */
+final class LeavesXDiagnosticsGui implements Listener {
+
+    private static final int INVENTORY_SIZE = 45;
+    private static final LeavesXDiagnosticsGui INSTANCE = new LeavesXDiagnosticsGui();
+    private static final Map<Integer, GuiAction> ACTIONS = Map.ofEntries(
+        Map.entry(10, GuiAction.WORLDS),
+        Map.entry(11, GuiAction.ENTITIES),
+        Map.entry(12, GuiAction.ENTITY_HOTSPOTS),
+        Map.entry(13, GuiAction.BLOCK_ENTITIES),
+        Map.entry(14, GuiAction.BLOCK_HOTSPOTS),
+        Map.entry(15, GuiAction.TICKETS),
+        Map.entry(16, GuiAction.ALL),
+        Map.entry(28, GuiAction.MEMORY),
+        Map.entry(29, GuiAction.STALLS),
+        Map.entry(30, GuiAction.NETWORK),
+        Map.entry(31, GuiAction.SYSTEM),
+        Map.entry(32, GuiAction.THREADS),
+        Map.entry(34, GuiAction.CONFIG),
+        Map.entry(40, GuiAction.REFRESH),
+        Map.entry(44, GuiAction.CLOSE)
+    );
+    private static boolean listenerRegistered;
+
+    private LeavesXDiagnosticsGui() {
+    }
+
+    static void open(final CommandSender sender) {
+        if (!(sender instanceof Player player)) {
+            sender.sendMessage(Component.text("此界面只能由游戏内玩家打开，请使用 /leavesx all。", NamedTextColor.RED));
+            return;
+        }
+
+        ensureListenerRegistered();
+        final GuiHolder holder = new GuiHolder(player.getUniqueId());
+        final Inventory inventory = Bukkit.createInventory(
+            holder,
+            INVENTORY_SIZE,
+            plain("LeavesX 性能诊断", NamedTextColor.DARK_GREEN)
+        );
+        holder.bind(inventory);
+        populate(inventory);
+        player.openInventory(inventory);
+    }
+
+    private static void ensureListenerRegistered() {
+        // Commands and inventory events run on the server thread, so a plain one-time guard is sufficient here.
+        if (!listenerRegistered) {
+            Bukkit.getPluginManager().registerEvents(INSTANCE, MinecraftInternalPlugin.INSTANCE);
+            listenerRegistered = true;
+        }
+    }
+
+    private static void populate(final Inventory inventory) {
+        final Overview overview = collectOverview();
+        final ItemStack filler = item(Material.GRAY_STAINED_GLASS_PANE, " ", NamedTextColor.DARK_GRAY, List.of());
+        for (int slot = 0; slot < inventory.getSize(); slot++) {
+            inventory.setItem(slot, filler);
+        }
+
+        inventory.setItem(4, item(
+            Material.CLOCK,
+            "性能概览",
+            NamedTextColor.GOLD,
+            List.of(
+                "TPS " + oneDecimal(overview.tps()) + " / MSPT " + oneDecimal(overview.mspt()),
+                "区块 " + overview.chunks() + " / 待卸载 " + overview.pendingUnloads(),
+                "实体 " + overview.entities() + " / 方块实体 " + overview.blockEntities(),
+                "堆内存 " + oneDecimal(overview.usedHeapGiB()) + " / " + oneDecimal(overview.maximumHeapGiB()) + " GiB"
+            )
+        ));
+        inventory.setItem(10, actionItem(Material.FILLED_MAP, "世界负载", "区块、持有器、实体和卸载队列"));
+        inventory.setItem(11, actionItem(Material.ZOMBIE_HEAD, "实体类型", "查看实体数量和活跃数量"));
+        inventory.setItem(12, actionItem(Material.SPYGLASS, "实体热点", "查看实体密集区块坐标"));
+        inventory.setItem(13, actionItem(Material.HOPPER, "方块实体", "查看方块实体类型和更新数量"));
+        inventory.setItem(14, actionItem(Material.OBSERVER, "方块实体热点", "查看方块实体密集区块"));
+        inventory.setItem(15, actionItem(Material.NAME_TAG, "区块票据", "查看区块加载来源和插件票据"));
+        inventory.setItem(16, actionItem(Material.NETHER_STAR, "完整诊断", "一次输出全部诊断信息"));
+        inventory.setItem(28, actionItem(Material.REDSTONE_BLOCK, "内存", "堆、堆外、直接缓冲区和 GC"));
+        inventory.setItem(29, actionItem(Material.LIGHTNING_ROD, "慢 Tick", "查看计算、等待和现场调用栈"));
+        inventory.setItem(30, actionItem(Material.COMPARATOR, "网络", "连接、数据包、延迟和发送队列"));
+        inventory.setItem(31, actionItem(Material.COMPASS, "系统配额", "查看 CPU、cgroup、内存和节流"));
+        inventory.setItem(32, item(
+            Material.REDSTONE_TORCH,
+            "线程",
+            NamedTextColor.AQUA,
+            List.of(
+                "JVM 可用处理器 " + Runtime.getRuntime().availableProcessors(),
+                "LeavesX 工作线程 " + LeavesXComputeExecutor.workerCount(),
+                "点击输出完整线程状态"
+            )
+        ));
+        inventory.setItem(34, actionItem(Material.WRITABLE_BOOK, "配置状态", "查看当前生效的 LeavesX 设置"));
+        inventory.setItem(40, item(Material.RECOVERY_COMPASS, "刷新", NamedTextColor.GREEN, List.of("重新读取当前状态")));
+        inventory.setItem(44, item(Material.BARRIER, "关闭", NamedTextColor.RED, List.of()));
+    }
+
+    private static Overview collectOverview() {
+        int chunks = 0;
+        long pendingUnloads = 0L;
+        int entities = 0;
+        int blockEntities = 0;
+        for (final World world : Bukkit.getWorlds()) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            chunks += level.getChunkSource().getFullChunksCount();
+            pendingUnloads += level.moonrise$getChunkTaskScheduler().chunkHolderManager.leavesX$getPendingUnloadCount();
+            entities += level.getEntityCount();
+            blockEntities += world.getTileEntityCount();
+        }
+
+        final Runtime runtime = Runtime.getRuntime();
+        final long usedHeap = runtime.totalMemory() - runtime.freeMemory();
+        return new Overview(
+            Bukkit.getTPS()[0],
+            Bukkit.getAverageTickTime(),
+            chunks,
+            pendingUnloads,
+            entities,
+            blockEntities,
+            usedHeap / 1_073_741_824.0D,
+            runtime.maxMemory() / 1_073_741_824.0D
+        );
+    }
+
+    private static ItemStack actionItem(final Material material, final String name, final String description) {
+        return item(material, name, NamedTextColor.AQUA, List.of(description, "点击查看"));
+    }
+
+    private static ItemStack item(
+        final Material material,
+        final String name,
+        final NamedTextColor color,
+        final List<String> lore
+    ) {
+        final ItemStack item = ItemStack.of(material);
+        item.editMeta(meta -> {
+            meta.displayName(plain(name, color));
+            meta.lore(lore.stream().map(line -> plain(line, NamedTextColor.GRAY)).toList());
+        });
+        return item;
+    }
+
+    private static Component plain(final String text, final NamedTextColor color) {
+        return Component.text(text, color).decoration(TextDecoration.ITALIC, false);
+    }
+
+    private static String oneDecimal(final double value) {
+        return String.format(java.util.Locale.ROOT, "%.1f", value);
+    }
+
+    @EventHandler(ignoreCancelled = true)
+    public void onInventoryClick(final InventoryClickEvent event) {
+        if (!(event.getView().getTopInventory().getHolder() instanceof GuiHolder holder)) {
+            return;
+        }
+        event.setCancelled(true);
+        if (!(event.getWhoClicked() instanceof Player player) || !holder.viewer().equals(player.getUniqueId())) {
+            return;
+        }
+
+        final GuiAction action = ACTIONS.get(event.getRawSlot());
+        if (action == null) {
+            return;
+        }
+        if (action == GuiAction.CLOSE) {
+            player.closeInventory();
+            return;
+        }
+        if (action == GuiAction.REFRESH) {
+            populate(event.getView().getTopInventory());
+            return;
+        }
+
+        player.closeInventory();
+        Bukkit.getScheduler().runTask(MinecraftInternalPlugin.INSTANCE, () -> {
+            if (player.isOnline()) {
+                player.performCommand("leavesx " + action.command());
+            }
+        });
+    }
+
+    @EventHandler(ignoreCancelled = true)
+    public void onInventoryDrag(final InventoryDragEvent event) {
+        if (event.getView().getTopInventory().getHolder() instanceof GuiHolder) {
+            event.setCancelled(true);
+        }
+    }
+
+    private enum GuiAction {
+        WORLDS("worlds"),
+        ENTITIES("entities"),
+        ENTITY_HOTSPOTS("hotspots"),
+        BLOCK_ENTITIES("blockentities"),
+        BLOCK_HOTSPOTS("blockhotspots"),
+        TICKETS("tickets"),
+        ALL("all"),
+        MEMORY("memory"),
+        STALLS("stalls"),
+        NETWORK("network"),
+        SYSTEM("system"),
+        THREADS("threads"),
+        CONFIG("config"),
+        REFRESH(null),
+        CLOSE(null);
+
+        private final String command;
+
+        GuiAction(final String command) {
+            this.command = command;
+        }
+
+        private String command() {
+            return this.command;
+        }
+    }
+
+    private static final class GuiHolder implements InventoryHolder {
+
+        private final UUID viewer;
+        private Inventory inventory;
+
+        private GuiHolder(final UUID viewer) {
+            this.viewer = viewer;
+        }
+
+        private UUID viewer() {
+            return this.viewer;
+        }
+
+        private void bind(final Inventory inventory) {
+            this.inventory = inventory;
+        }
+
+        @Override
+        public Inventory getInventory() {
+            return Objects.requireNonNull(this.inventory, "LeavesX GUI inventory has not been bound yet");
+        }
+    }
+
+    private record Overview(
+        double tps,
+        double mspt,
+        int chunks,
+        long pendingUnloads,
+        int entities,
+        int blockEntities,
+        double usedHeapGiB,
+        double maximumHeapGiB
+    ) {
+    }
+}
