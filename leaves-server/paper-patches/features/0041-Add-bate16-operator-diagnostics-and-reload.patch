+package org.leavesx.leavesx.diagnostics;
+
+import java.io.IOException;
+import java.lang.management.ManagementFactory;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Reads bounded JVM, operating-system, and Linux cgroup diagnostics on operator request. */
+public final class LeavesXSystemDiagnostics {
+
+    private static final Path PROC_STATUS = Path.of("/proc/self/status");
+    private static final Path CPU_MAX = Path.of("/sys/fs/cgroup/cpu.max");
+    private static final Path CPU_STAT = Path.of("/sys/fs/cgroup/cpu.stat");
+    private static final Path CPUSET_EFFECTIVE = Path.of("/sys/fs/cgroup/cpuset.cpus.effective");
+    private static final Path MEMORY_CURRENT = Path.of("/sys/fs/cgroup/memory.current");
+    private static final Path MEMORY_MAX = Path.of("/sys/fs/cgroup/memory.max");
+    private static final long MAX_DIAGNOSTIC_FILE_BYTES = 64L * 1024L;
+
+    private LeavesXSystemDiagnostics() {
+    }
+
+    /** Captures a point-in-time system snapshot without retaining operating-system state. */
+    public static Snapshot capture() {
+        final java.lang.management.OperatingSystemMXBean baseBean = ManagementFactory.getOperatingSystemMXBean();
+        long physicalTotal = -1L;
+        long physicalFree = -1L;
+        long swapTotal = -1L;
+        long swapFree = -1L;
+        double processCpuLoad = -1.0D;
+        double systemCpuLoad = -1.0D;
+        if (baseBean instanceof com.sun.management.OperatingSystemMXBean bean) {
+            physicalTotal = bean.getTotalMemorySize();
+            physicalFree = bean.getFreeMemorySize();
+            swapTotal = bean.getTotalSwapSpaceSize();
+            swapFree = bean.getFreeSwapSpaceSize();
+            processCpuLoad = bean.getProcessCpuLoad();
+            systemCpuLoad = bean.getCpuLoad();
+        }
+
+        final Map<String, Long> cpuStat = readLongMap(CPU_STAT);
+        return new Snapshot(
+            Runtime.getRuntime().availableProcessors(),
+            readStatusValue("Cpus_allowed_list"),
+            readFirstLine(CPUSET_EFFECTIVE),
+            parseCpuQuota(readFirstLine(CPU_MAX)),
+            cpuStat.getOrDefault("nr_periods", -1L),
+            cpuStat.getOrDefault("nr_throttled", -1L),
+            cpuStat.getOrDefault("throttled_usec", -1L),
+            physicalTotal,
+            physicalFree,
+            swapTotal,
+            swapFree,
+            readLongValue(MEMORY_CURRENT),
+            readLimitValue(MEMORY_MAX),
+            processCpuLoad,
+            systemCpuLoad
+        );
+    }
+
+    static CpuQuota parseCpuQuota(final String raw) {
+        if (raw == null || raw.isBlank()) {
+            return CpuQuota.unknown();
+        }
+        final String[] parts = raw.trim().split("\\s+");
+        if (parts.length < 2) {
+            return CpuQuota.unknown();
+        }
+        try {
+            final long periodMicros = Long.parseLong(parts[1]);
+            if (periodMicros <= 0L) {
+                return CpuQuota.unknown();
+            }
+            if (parts[0].equals("max")) {
+                return new CpuQuota(true, -1L, periodMicros, -1.0D);
+            }
+            final long quotaMicros = Long.parseLong(parts[0]);
+            if (quotaMicros <= 0L) {
+                return CpuQuota.unknown();
+            }
+            return new CpuQuota(false, quotaMicros, periodMicros, (double)quotaMicros / (double)periodMicros);
+        } catch (final NumberFormatException ignored) {
+            return CpuQuota.unknown();
+        }
+    }
+
+    private static String readStatusValue(final String key) {
+        for (final String line : readSmallLines(PROC_STATUS)) {
+            final int separator = line.indexOf(':');
+            if (separator > 0 && line.substring(0, separator).equals(key)) {
+                return line.substring(separator + 1).trim();
+            }
+        }
+        return null;
+    }
+
+    private static Map<String, Long> readLongMap(final Path path) {
+        final Map<String, Long> values = new HashMap<>();
+        for (final String line : readSmallLines(path)) {
+            final String[] parts = line.trim().split("\\s+");
+            if (parts.length != 2) {
+                continue;
+            }
+            try {
+                values.put(parts[0].toLowerCase(Locale.ROOT), Long.parseLong(parts[1]));
+            } catch (final NumberFormatException ignored) {
+                // Ignore unknown future cgroup counters while retaining supported fields.
+            }
+        }
+        return values;
+    }
+
+    private static long readLongValue(final Path path) {
+        final String value = readFirstLine(path);
+        if (value == null) {
+            return -1L;
+        }
+        try {
+            return Long.parseLong(value.trim());
+        } catch (final NumberFormatException ignored) {
+            return -1L;
+        }
+    }
+
+    private static long readLimitValue(final Path path) {
+        final String value = readFirstLine(path);
+        if (value == null) {
+            return -1L;
+        }
+        if (value.equals("max")) {
+            return Long.MAX_VALUE;
+        }
+        try {
+            return Long.parseLong(value.trim());
+        } catch (final NumberFormatException ignored) {
+            return -1L;
+        }
+    }
+
+    private static String readFirstLine(final Path path) {
+        final List<String> lines = readSmallLines(path);
+        return lines.isEmpty() ? null : lines.getFirst().trim();
+    }
+
+    private static List<String> readSmallLines(final Path path) {
+        try {
+            if (!Files.isRegularFile(path) || Files.size(path) > MAX_DIAGNOSTIC_FILE_BYTES) {
+                return List.of();
+            }
+            return Files.readAllLines(path, StandardCharsets.UTF_8);
+        } catch (final IOException | SecurityException ignored) {
+            return List.of();
+        }
+    }
+
+    public record Snapshot(
+        int jvmProcessors,
+        String allowedCpuList,
+        String effectiveCpuSet,
+        CpuQuota cpuQuota,
+        long cpuPeriods,
+        long throttledPeriods,
+        long throttledMicros,
+        long physicalTotal,
+        long physicalFree,
+        long swapTotal,
+        long swapFree,
+        long cgroupMemoryCurrent,
+        long cgroupMemoryMaximum,
+        double processCpuLoad,
+        double systemCpuLoad
+    ) {
+    }
+
+    public record CpuQuota(boolean unlimited, long quotaMicros, long periodMicros, double processors) {
+
+        private static CpuQuota unknown() {
+            return new CpuQuota(false, -1L, -1L, -1.0D);
+        }
+
+        public boolean known() {
+            return this.unlimited || this.processors >= 0.0D;
+        }
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java
new file mode 100644
index 0000000000000000000000000000000000000000..c58ccf5914e416129c7248e30c2a5ad6dffc9765
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java
@@ -0,0 +1,263 @@
+package org.leavesx.leavesx.diagnostics;
+
+import java.lang.management.ManagementFactory;
+import java.lang.management.ThreadInfo;
+import java.lang.management.ThreadMXBean;
+import java.time.Instant;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+
+/**
+ * Captures bounded, read-only evidence for slow server ticks.
+ *
+ * <p>Normal ticks only perform a few primitive reads and writes. Once a tick exceeds the 50 ms budget, a daemon
+ * sampler captures the server thread state and stack without pausing or modifying world execution.</p>
+ */
+public final class LeavesXTickDiagnostics {
+
+    public static final long SLOW_TICK_NANOS = TimeUnit.MILLISECONDS.toNanos(50L);
+    private static final long SAMPLE_PERIOD_MILLIS = 25L;
+    private static final long REPEAT_SAMPLE_NANOS = TimeUnit.MILLISECONDS.toNanos(100L);
+    private static final int MAX_RECORDS = 120;
+    private static final int STACK_DEPTH = 16;
+    private static final ThreadMXBean THREADS = ManagementFactory.getThreadMXBean();
+    private static final Object RECORD_LOCK = new Object();
+    private static final ArrayDeque<SlowTick> RECORDS = new ArrayDeque<>(MAX_RECORDS);
+    private static final AtomicLong TOTAL_SLOW_TICKS = new AtomicLong();
+    private static final ScheduledExecutorService SAMPLER = Executors.newSingleThreadScheduledExecutor(new SamplerThreadFactory());
+    private static final boolean CPU_TIME_AVAILABLE = enableThreadCpuTime();
+
+    private static volatile Thread tickThread;
+    private static volatile long activeTick;
+    private static volatile long activeTickStartedNanos;
+    private static volatile long activeTickCpuStartedNanos;
+    private static volatile StackSample activeSample;
+    private static volatile long lastSampledTick = Long.MIN_VALUE;
+    private static volatile long lastSampleElapsedNanos;
+
+    static {
+        SAMPLER.scheduleAtFixedRate(
+            LeavesXTickDiagnostics::sampleSlowTick,
+            SAMPLE_PERIOD_MILLIS,
+            SAMPLE_PERIOD_MILLIS,
+            TimeUnit.MILLISECONDS
+        );
+    }
+
+    private LeavesXTickDiagnostics() {
+    }
+
+    /** Marks the start of server-thread work for one tick. */
+    public static void beginTick(final long tick, final long startedNanos) {
+        if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+            activeTickStartedNanos = 0L;
+            return;
+        }
+        tickThread = Thread.currentThread();
+        activeTick = tick;
+        activeSample = null;
+        activeTickCpuStartedNanos = currentThreadCpuTime();
+        // Publish the start last so the sampler sees the rest of the tick state consistently.
+        activeTickStartedNanos = startedNanos;
+    }
+
+    /** Completes the active tick and stores a bounded record when it exceeded 50 ms. */
+    public static void endTick(final MinecraftServer server, final long endedNanos, final long remainingNanos) {
+        final long startedNanos = activeTickStartedNanos;
+        if (startedNanos == 0L) {
+            return;
+        }
+
+        final long tick = activeTick;
+        activeTickStartedNanos = 0L;
+        final long wallNanos = Math.max(0L, endedNanos - startedNanos);
+        if (wallNanos < SLOW_TICK_NANOS) {
+            return;
+        }
+
+        final long cpuEndedNanos = currentThreadCpuTime();
+        final long cpuStartedNanos = activeTickCpuStartedNanos;
+        final long cpuNanos = cpuEndedNanos < 0L || cpuStartedNanos < 0L
+            ? -1L
+            : Math.clamp(cpuEndedNanos - cpuStartedNanos, 0L, wallNanos);
+        final Workload workload = collectWorkload(server);
+        final StackSample sample = activeSample != null && activeSample.tick() == tick ? activeSample : null;
+        final SlowTick slowTick = new SlowTick(
+            Instant.now(),
+            tick,
+            wallNanos,
+            cpuNanos,
+            Math.max(0L, -remainingNanos),
+            classify(wallNanos, cpuNanos, sample != null),
+            workload,
+            sample
+        );
+
+        TOTAL_SLOW_TICKS.incrementAndGet();
+        synchronized (RECORD_LOCK) {
+            if (RECORDS.size() == MAX_RECORDS) {
+                RECORDS.removeFirst();
+            }
+            RECORDS.addLast(slowTick);
+        }
+    }
+
+    /** Returns newest records first without exposing the mutable ring buffer. */
+    public static List<SlowTick> recent(final int requestedLimit) {
+        final int limit = Math.clamp(requestedLimit, 1, MAX_RECORDS);
+        synchronized (RECORD_LOCK) {
+            final List<SlowTick> result = new ArrayList<>(Math.min(limit, RECORDS.size()));
+            final var iterator = RECORDS.descendingIterator();
+            while (iterator.hasNext() && result.size() < limit) {
+                result.add(iterator.next());
+            }
+            return List.copyOf(result);
+        }
+    }
+
+    /** Returns the number of slow ticks observed since process start. */
+    public static long totalSlowTicks() {
+        return TOTAL_SLOW_TICKS.get();
+    }
+
+    /** Clears retained records while leaving the lifetime counter intact. */
+    public static void clear() {
+        synchronized (RECORD_LOCK) {
+            RECORDS.clear();
+        }
+    }
+
+    static StallType classify(final long wallNanos, final long cpuNanos, final boolean sampled) {
+        if (cpuNanos < 0L || wallNanos <= 0L) {
+            return sampled ? StallType.UNKNOWN : StallType.JVM_OR_HOST_PAUSE;
+        }
+        final double cpuRatio = (double)cpuNanos / (double)wallNanos;
+        if (cpuRatio >= 0.75D) {
+            return StallType.COMPUTE;
+        }
+        if (cpuRatio <= 0.35D) {
+            return sampled ? StallType.WAIT_OR_SCHEDULING : StallType.JVM_OR_HOST_PAUSE;
+        }
+        return StallType.MIXED;
+    }
+
+    private static void sampleSlowTick() {
+        final long startedNanos = activeTickStartedNanos;
+        final Thread serverThread = tickThread;
+        if (startedNanos == 0L || serverThread == null) {
+            return;
+        }
+
+        final long elapsedNanos = System.nanoTime() - startedNanos;
+        if (elapsedNanos < SLOW_TICK_NANOS) {
+            return;
+        }
+        final long tick = activeTick;
+        if (lastSampledTick == tick && elapsedNanos - lastSampleElapsedNanos < REPEAT_SAMPLE_NANOS) {
+            return;
+        }
+
+        final ThreadInfo info = THREADS.getThreadInfo(serverThread.threadId(), STACK_DEPTH);
+        if (info == null) {
+            return;
+        }
+        final StackTraceElement[] trace = info.getStackTrace();
+        final List<String> frames = new ArrayList<>(trace.length);
+        for (final StackTraceElement frame : trace) {
+            frames.add(frame.toString());
+        }
+        activeSample = new StackSample(tick, elapsedNanos, info.getThreadState(), List.copyOf(frames));
+        lastSampledTick = tick;
+        lastSampleElapsedNanos = elapsedNanos;
+    }
+
+    private static Workload collectWorkload(final MinecraftServer server) {
+        int chunks = 0;
+        int holders = 0;
+        long pendingUnloads = 0L;
+        int entities = 0;
+        for (final ServerLevel level : server.getAllLevels()) {
+            chunks += level.getChunkSource().getFullChunksCount();
+            holders += level.getChunkSource().getLoadedChunksCount();
+            pendingUnloads += level.moonrise$getChunkTaskScheduler().chunkHolderManager.leavesX$getPendingUnloadCount();
+            entities += level.getEntityCount();
+        }
+        return new Workload(chunks, holders, pendingUnloads, entities, server.getPlayerList().getPlayerCount());
+    }
+
+    private static boolean enableThreadCpuTime() {
+        if (!THREADS.isCurrentThreadCpuTimeSupported()) {
+            return false;
+        }
+        try {
+            if (!THREADS.isThreadCpuTimeEnabled()) {
+                THREADS.setThreadCpuTimeEnabled(true);
+            }
+            return THREADS.isThreadCpuTimeEnabled();
+        } catch (final SecurityException ignored) {
+            return false;
+        }
+    }
+
+    private static long currentThreadCpuTime() {
+        return CPU_TIME_AVAILABLE ? THREADS.getCurrentThreadCpuTime() : -1L;
+    }
+
+    public enum StallType {
+        COMPUTE("主线程计算"),
+        WAIT_OR_SCHEDULING("等待或调度"),
+        MIXED("计算与等待混合"),
+        JVM_OR_HOST_PAUSE("JVM 或宿主暂停"),
+        UNKNOWN("无法分类");
+
+        private final String displayName;
+
+        StallType(final String displayName) {
+            this.displayName = displayName;
+        }
+
+        public String displayName() {
+            return this.displayName;
+        }
+    }
+
+    public record SlowTick(
+        Instant capturedAt,
+        long tick,
+        long wallNanos,
+        long cpuNanos,
+        long behindNanos,
+        StallType type,
+        Workload workload,
+        StackSample sample
+    ) {
+    }
+
+    public record Workload(int chunks, int holders, long pendingUnloads, int entities, int players) {
+    }
+
+    public record StackSample(long tick, long elapsedNanos, Thread.State state, List<String> frames) {
+    }
+
+    private static final class SamplerThreadFactory implements ThreadFactory {
+
+        @Override
+        public Thread newThread(final Runnable task) {
+            final Thread thread = new Thread(task, "LeavesX Slow Tick Sampler");
+            thread.setDaemon(true);
+            thread.setPriority(Thread.NORM_PRIORITY - 1);
+            thread.setUncaughtExceptionHandler((ignored, throwable) ->
+                org.slf4j.LoggerFactory.getLogger(LeavesXTickDiagnostics.class)
+                    .error("LeavesX slow tick sampler failed", throwable));
+            return thread;
+        }
+    }
+}
