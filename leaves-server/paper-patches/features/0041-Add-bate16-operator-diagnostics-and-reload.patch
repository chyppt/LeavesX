+    private static void sendStalls(final CommandSender sender, final String[] args) {
+        if (args.length >= 2 && args[1].equalsIgnoreCase("clear")) {
+            LeavesXTickDiagnostics.clear();
+            sender.sendMessage(Component.text("已清空保留的慢 Tick 记录。", NamedTextColor.GREEN));
+            return;
+        }
+
+        int limit = Math.min(10, LeavesXRuntime.diagnosticsDefaultResultLimit());
+        if (args.length >= 2) {
+            try {
+                limit = Math.clamp(Integer.parseInt(args[1]), 1, 50);
+            } catch (final NumberFormatException ignored) {
+                sender.sendMessage(Component.text("数量必须是 1 到 50 的整数，或使用 clear。", NamedTextColor.RED));
+                return;
+            }
+        }
+        sendStalls(sender, limit);
+    }
+
+    private static void sendStalls(final CommandSender sender, final int limit) {
+        final List<LeavesXTickDiagnostics.SlowTick> records = LeavesXTickDiagnostics.recent(limit);
+        sendHeader(sender, "最近慢 Tick");
+        sender.sendMessage(Component.text(
+            "进程启动后共记录 " + LeavesXTickDiagnostics.totalSlowTicks() + " 次，本次显示 " + records.size() + " 次。",
+            NamedTextColor.GRAY
+        ));
+        if (records.isEmpty()) {
+            sender.sendMessage(Component.text("尚未记录到超过 50 ms 的 Tick。", NamedTextColor.GREEN));
+            return;
+        }
+
+        for (int index = 0; index < records.size(); index++) {
+            final LeavesXTickDiagnostics.SlowTick record = records.get(index);
+            final double wallMilliseconds = record.wallNanos() / 1_000_000.0D;
+            final String cpuDescription;
+            if (record.cpuNanos() < 0L) {
+                cpuDescription = "CPU 未知";
+            } else {
+                final double cpuMilliseconds = record.cpuNanos() / 1_000_000.0D;
+                final double cpuRatio = record.wallNanos() == 0L ? 0.0D : record.cpuNanos() * 100.0D / record.wallNanos();
+                cpuDescription = "CPU " + oneDecimal(cpuMilliseconds) + " ms（" + oneDecimal(cpuRatio) + "%）";
+            }
+            sender.sendMessage(Component.text(
+                (index + 1) + ". Tick " + record.tick() + "：" + oneDecimal(wallMilliseconds) + " ms / "
+                    + cpuDescription + " / 落后 " + oneDecimal(record.behindNanos() / 1_000_000.0D) + " ms / "
+                    + record.type().displayName(),
+                stallColor(record.type())
+            ));
+
+            final LeavesXTickDiagnostics.Workload workload = record.workload();
+            sender.sendMessage(Component.text(
+                "   区块 " + workload.chunks() + " / 持有器 " + workload.holders() + " / 待卸载 "
+                    + workload.pendingUnloads() + " / 实体 " + workload.entities() + " / 玩家实体 " + workload.players(),
+                NamedTextColor.GRAY
+            ));
+            final LeavesXTickDiagnostics.StackSample sample = record.sample();
+            if (sample == null) {
+                sender.sendMessage(Component.text("   未截获线程栈，可能是 JVM、宿主暂停或调度器未及时运行。", NamedTextColor.YELLOW));
+                continue;
+            }
+            sender.sendMessage(Component.text(
+                "   线程状态 " + sample.state() + "，在 " + oneDecimal(sample.elapsedNanos() / 1_000_000.0D) + " ms 时采样",
+                NamedTextColor.GRAY
+            ));
+            for (int frameIndex = 0; frameIndex < Math.min(3, sample.frames().size()); frameIndex++) {
+                sender.sendMessage(Component.text("   -> " + sample.frames().get(frameIndex), NamedTextColor.DARK_GRAY));
+            }
+        }
+    }
