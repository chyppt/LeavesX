-    /** 线程池设置在启动时应用；动物数值快照开关允许热重载。 */
+    /** 分类暂停仅影响并行准入；单次异常仍请求完整同步重算。 */
+    public record ComputeFailureSettings(boolean enabled, int failureThreshold, int cooldownSeconds) {
+        public ComputeFailureSettings {
+            if (failureThreshold < 1 || failureThreshold > 100) {
+                throw new IllegalArgumentException("parallelism.failure-protection.failure-threshold must be between 1 and 100");
+            }
+            if (cooldownSeconds < 1 || cooldownSeconds > 3_600) {
+                throw new IllegalArgumentException("parallelism.failure-protection.cooldown-seconds must be between 1 and 3600");
+            }
+        }
+
+        public static ComputeFailureSettings defaults() {
+            return new ComputeFailureSettings(true, 3, 30);
+        }
+    }
+
+    /** 线程池设置在启动时应用；动物数值快照与故障保护开关允许热重载。 */
     public record AsyncSettings(
         boolean chunkSendEnabled,
         int chunkSendQueueSize,
@@ -328,10 +344,12 @@ public record LeavesXConfig(
         boolean lowLoadWorkers,
         boolean animalBreeding,
         boolean animalFollowParent,
-        boolean activationBoundsPrefilter
