+            final boolean chunkSendEnabled, final int chunkSendQueueSize, final boolean mobSpawningEnabled,
+            final boolean pathfindingEnabled, final int pathfindingThreads, final int pathfindingQueueSize,
+            final int pathfindingKeepaliveSeconds, final boolean playerDataSaveEnabled, final int playerDataSaveQueueSize,
+            final boolean entityTrackerEnabled, final int entityTrackerThreads, final int entityTrackerQueueSize,
+            final boolean sharedComputeWorkers, final boolean trackerComparisonSharding, final boolean lowLoadWorkers,
+            final boolean animalBreeding, final boolean animalFollowParent, final boolean activationBoundsPrefilter
+        ) {
+            this(chunkSendEnabled, chunkSendQueueSize, mobSpawningEnabled, pathfindingEnabled, pathfindingThreads,
+                pathfindingQueueSize, pathfindingKeepaliveSeconds, playerDataSaveEnabled, playerDataSaveQueueSize,
+                entityTrackerEnabled, entityTrackerThreads, entityTrackerQueueSize, sharedComputeWorkers,
+                trackerComparisonSharding, lowLoadWorkers, animalBreeding, animalFollowParent, activationBoundsPrefilter,
+                ComputeFailureSettings.defaults());
+        }
