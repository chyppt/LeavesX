diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadSerializationHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadSerializationHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f0007bfb5042f608eaa49051b11a72e43cb7a679
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadSerializationHotPathTest.java
@@ -0,0 +1,53 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.level.chunk.storage.SerializableChunkData;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies chunk snapshots keep allocation-light and vanilla serialization paths. */
+@Normal
+class ChunkUnloadSerializationHotPathTest {
+
+    @Test
+    void copyKeepsOptimizedAndVanillaSerializationPaths() throws IOException {
+        final List<MethodInsnNode> calls = invocations(method(classNode(SerializableChunkData.class), "copyOf"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("chunkUnloadSerializationOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("java/util/Arrays") && call.name.equals("stream")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("it/unimi/dsi/fastutil/shorts/ShortArrayList")));
+        assertTrue(calls.stream()
+            .filter(call -> call.owner.equals("java/util/ArrayList"))
+            .filter(call -> call.name.equals("<init>") && call.desc.equals("(I)V"))
+            .count() >= 3L);
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
