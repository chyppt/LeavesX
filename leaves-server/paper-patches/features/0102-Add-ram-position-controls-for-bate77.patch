diff --git a/src/test/java/org/leavesx/leavesx/performance/RamPositionSelectionTest.java b/src/test/java/org/leavesx/leavesx/performance/RamPositionSelectionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1276d4c950f68fbfc2405276a18210d725408967
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/RamPositionSelectionTest.java
@@ -0,0 +1,95 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.ai.behavior.PrepareRamNearestTarget;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies ram-position selection keeps vanilla's stable distance order and fallback path. */
+@Normal
+class RamPositionSelectionTest {
+
+    @Test
+    void insertionSortMatchesVanillaStableComparatorOrder() throws Exception {
+        final Method sort = PrepareRamNearestTarget.class.getDeclaredMethod(
+            "sortRamPositionsByDistance",
+            List.class,
+            BlockPos.class
+        );
+        sort.setAccessible(true);
+
+        final BlockPos origin = new BlockPos(5, 80, -3);
+        final List<BlockPos> original = List.of(
+            origin.offset(3, 0, 0),
+            origin.offset(0, 0, -2),
+            origin.offset(-3, 0, 0),
+            origin.offset(0, 0, 1)
+        );
+        final List<BlockPos> expected = original.stream()
+            .sorted(Comparator.comparingDouble(origin::distSqr))
+            .toList();
+        final List<BlockPos> actual = new ArrayList<>(original);
+
+        sort.invoke(null, actual, origin);
+
+        assertEquals(expected, actual);
+        assertEquals(original.get(0), actual.get(2), "Equal-distance candidates must retain their original order");
+        assertEquals(original.get(2), actual.get(3), "Equal-distance candidates must retain their original order");
+    }
+
+    @Test
+    void optimizedAndVanillaSelectionPathsRemainPresent() throws IOException {
+        final ClassNode behavior = classNode(PrepareRamNearestTarget.class);
+        final List<MethodInsnNode> sortCalls = invocations(method(behavior, "sortRamPositionsByDistance"));
+        final List<MethodInsnNode> selectionCalls = behavior.methods.stream()
+            .filter(method -> method.name.equals("calculateRammingStartPosition")
+                || method.name.startsWith("lambda$calculateRammingStartPosition$"))
+            .flatMap(method -> invocations(method).stream())
+            .toList();
+
+        assertFalse(sortCalls.stream().anyMatch(call -> call.name.equals("stream") || call.name.equals("sorted")));
+        assertTrue(sortCalls.stream().anyMatch(call -> call.name.equals("compare")));
+        assertTrue(sortCalls.stream().anyMatch(call -> call.name.equals("set")));
+        assertTrue(selectionCalls.stream().anyMatch(call -> call.name.equals("ramPositionSelectionOptimization")));
+        assertTrue(selectionCalls.stream().anyMatch(call -> call.name.equals("sortRamPositionsByDistance")));
+        assertTrue(selectionCalls.stream().anyMatch(call -> call.name.equals("createPath")));
+        assertTrue(selectionCalls.stream().anyMatch(call -> call.name.equals("stream")));
+        assertTrue(selectionCalls.stream().anyMatch(call -> call.name.equals("sorted")));
+        assertTrue(selectionCalls.stream().anyMatch(call -> call.name.equals("findFirst")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
