From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Subject: [PATCH] Persist bounded stall diagnostics

diff --git a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java
--- a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXTickDiagnostics.java
@@ -29,1 +29,1 @@
-    private static final int STACK_DEPTH = 16;
+    private static final int STACK_DEPTH = 64;
@@ -229,1 +229,6 @@
         lastSampleElapsedNanos = elapsedNanos;
+        try {
+            StallLog.record(tick, elapsedNanos, info);
+        } catch (final RuntimeException failure) {
+            org.slf4j.LoggerFactory.getLogger(LeavesXTickDiagnostics.class).error("卡顿诊断采样失败", failure);
+        }
