diff --git a/src/test/java/org/leavesx/leavesx/performance/VillagerFoodInventoryHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/VillagerFoodInventoryHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..bfeb597a95e23b894dc69f150a31cb516ed46a65
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/VillagerFoodInventoryHotPathTest.java
@@ -0,0 +1,117 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.doReturn;
+import static org.mockito.Mockito.mock;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.world.SimpleContainer;
+import net.minecraft.world.entity.npc.villager.Villager;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies single-pass villager food accounting preserves Paper's exact result. */
+@Normal
+class VillagerFoodInventoryHotPathTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedAndFallbackPathsReturnTheSameFoodPoints() throws Exception {
+        final SimpleContainer inventory = new SimpleContainer(8);
+        inventory.setItem(0, new ItemStack(Items.BREAD, 3));
+        inventory.setItem(1, new ItemStack(Items.POTATO, 5));
+        inventory.setItem(2, new ItemStack(Items.CARROT, 7));
+        inventory.setItem(3, new ItemStack(Items.BEETROOT, 11));
+        inventory.setItem(4, new ItemStack(Items.WHEAT, 64));
+        final Villager villager = mock(Villager.class, CALLS_REAL_METHODS);
+        doReturn(inventory).when(villager).getInventory();
+
+        try {
+            publish(this.configuration(true, "optimized.yml"));
+            final int optimized = foodPoints(villager);
+            publish(this.configuration(false, "fallback.yml"));
+            final int fallback = foodPoints(villager);
+
+            assertEquals(35, optimized);
+            assertEquals(fallback, optimized);
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void optimizedPathUsesItsOwnSwitchAndScansTheBackingListDirectly() throws IOException {
+        final MethodNode method = method(classNode(), "countFoodPointsInInventory");
+        final AbstractInsnNode[] instructions = method.instructions.toArray();
+
+        assertTrue(Arrays.stream(instructions)
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                && call.name.equals("villagerFoodInventoryOptimization")));
+        assertTrue(Arrays.stream(instructions)
+            .filter(FieldInsnNode.class::isInstance)
+            .map(FieldInsnNode.class::cast)
+            .anyMatch(field -> field.getOpcode() == Opcodes.GETFIELD
+                && field.owner.equals("net/minecraft/world/SimpleContainer")
+                && field.name.equals("items")));
+    }
+
+    private static int foodPoints(final Villager villager) throws ReflectiveOperationException {
+        final Method method = Villager.class.getDeclaredMethod("countFoodPointsInInventory");
+        method.setAccessible(true);
+        return (int)method.invoke(villager);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private LeavesXConfig configuration(final boolean optimized, final String fileName) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              ai-optimizations: true
+              ai:
+                villager-food-inventory: %s
+            """.formatted(optimized));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(Villager.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+}
