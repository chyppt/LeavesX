diff --git a/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java b/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
index 04159565b584bb626c5e6e6d4e4ec36df57d0700..b5c2c0a5ad8e165b5d07a68f1097f64fc49bc993 100644
--- a/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
+++ b/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
@@ -12,6 +12,7 @@ import io.netty.buffer.ByteBuf;
 public final class ProtocolIntegerEncoding {
 
     private static final int[] VARLONG_EXACT_BYTE_LENGTHS = createVarLongByteLengths();
+    private static final int[] VARINT_EXACT_BYTE_LENGTHS = createVarIntByteLengths();
 
     private ProtocolIntegerEncoding() {
     }
@@ -26,6 +27,11 @@ public final class ProtocolIntegerEncoding {
         return VARLONG_EXACT_BYTE_LENGTHS[Long.numberOfLeadingZeros(value)];
     }
 
+    /** Returns the exact encoded size of a VarInt. */
+    public static int getVarIntByteSize(final int value) {
+        return VARINT_EXACT_BYTE_LENGTHS[Integer.numberOfLeadingZeros(value)];
+    }
+
     /**
      * Writes one VarInt using at most two fixed-width buffer operations.
      *
@@ -153,4 +159,13 @@ public final class ProtocolIntegerEncoding {
         lengths[64] = 1;
         return lengths;
     }
+
+    private static int[] createVarIntByteLengths() {
+        final int[] lengths = new int[33];
+        for (int leadingZeros = 0; leadingZeros < 32; ++leadingZeros) {
+            lengths[leadingZeros] = (int)Math.ceil((31.0 - (leadingZeros - 1)) / 7.0);
+        }
+        lengths[32] = 1;
+        return lengths;
+    }
 }
diff --git a/src/main/java/org/leavesx/leavesx/performance/SortedIndexListCompactor.java b/src/main/java/org/leavesx/leavesx/performance/SortedIndexListCompactor.java
