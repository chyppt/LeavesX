+++ b/src/main/java/org/leavesx/leavesx/performance/SortedIndexListCompactor.java
@@ -23,6 +23,16 @@ public final class SortedIndexListCompactor {
 
         final int originalSize = list.size();
         final int firstRemovedIndex = sortedIndices.getInt(0);
+        if (removalCount == originalSize) {
+            list.clear();
+            return;
+        }
+        if (removalCount == originalSize - firstRemovedIndex
+            && sortedIndices.getInt(removalCount - 1) == originalSize - 1) {
+            // A suffix needs no survivor copies. The caller's strict ordering contract makes this range exact.
+            list.subList(firstRemovedIndex, originalSize).clear();
+            return;
+        }
         int writeIndex = firstRemovedIndex;
         int removalCursor = 1;
         int nextRemovedIndex = removalCursor < removalCount ? sortedIndices.getInt(removalCursor) : originalSize;
