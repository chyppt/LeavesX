+    /**
+     * Determines whether an inactive villager must retain Paper's complete server AI step.
+     *
+     * <p>Paper normally allows operators to replace this with a Brain-only update. That saves work, but it omits
+     * navigation and mob-level goal processing which the vanilla villager panic and iron-golem cycle can observe.
+     * LeavesX compatibility mode therefore retains the complete Paper path for villagers only. Other entity types
+     * and an explicitly disabled compatibility mode continue to follow the configured Paper setting.</p>
+     *
+     * @param paperTickInactiveVillagers configured Paper inactive-villager behavior
+     * @return whether to execute the complete inactive-villager AI step
+     */
+    public static boolean shouldRunFullInactiveVillagerAi(final boolean paperTickInactiveVillagers) {
+        return paperTickInactiveVillagers || villagerCompatibilityMode;
+    }
