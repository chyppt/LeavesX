diff --git a/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..b80e3e4ab02423c1f295dcb67188c23ec47d947f
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java
@@ -0,0 +1,56 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ai.sensing.AdultSensor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies adult sensing keeps both the allocation-free path and the vanilla Optional fallback. */
+@Normal
+class AdultSensorHotPathTest {
+
+    @Test
+    void sensorKeepsDirectAndVanillaMemoryPaths() throws IOException {
+        final ClassNode adultSensor = classNode(AdultSensor.class);
+        final MethodNode doTick = method(adultSensor, "doTick");
+        final List<MethodInsnNode> calls = invocations(doTick);
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("adultSensorOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValue")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$findClosestOrNull")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("getMemory")));
+        assertTrue(adultSensor.methods.stream()
+            .filter(method -> method.name.startsWith("lambda$doTick"))
+            .flatMap(method -> invocations(method).stream())
+            .anyMatch(call -> call.name.equals("setNearestVisibleAdult")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
