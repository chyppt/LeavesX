 public final class LeavesXSnapshotBatch implements AutoCloseable {
     private static final int MAX_PENDING_TASKS = 64;
+    private static final ThreadLocal<LeavesXSnapshotBatch[]> REUSABLE = new ThreadLocal<>();
     private final Thread owner = Thread.currentThread();
     private final LeavesXComputeExecutor.Workload workload;
     private final List<Task> pending = new ArrayList<>();
@@ -28,9 +31,48 @@
     private boolean successful = true;
     private Throwable failure;
     private boolean finished;
+    private boolean inUse = true;
+    private boolean cached;
 
     public LeavesXSnapshotBatch(final LeavesXComputeExecutor.Workload workload) {
         this.workload = Objects.requireNonNull(workload, "workload");
+    }
+
+    /** 只复用本线程已经 close 的同类容器；嵌套查询保留自己的屏障和异常。 */
+    public static LeavesXSnapshotBatch acquire(final LeavesXComputeExecutor.Workload workload) {
+        Objects.requireNonNull(workload, "workload");
+        if (!LeavesXRuntime.asyncSettings().kernels().snapshotBatchReuse()) {
+            return new LeavesXSnapshotBatch(workload);
+        }
+        LeavesXSnapshotBatch[] cached = REUSABLE.get();
+        if (cached == null) {
+            cached = new LeavesXSnapshotBatch[LeavesXComputeExecutor.Workload.values().length];
+            REUSABLE.set(cached);
+        }
+        final int slot = workload.ordinal();
+        LeavesXSnapshotBatch batch = cached[slot];
+        if (batch == null) {
+            batch = new LeavesXSnapshotBatch(workload);
+            batch.cached = true;
+            cached[slot] = batch;
+        } else if (batch.inUse) {
+            return new LeavesXSnapshotBatch(workload);
+        } else {
+            // close 的完整屏障之后，任务不再写入这些状态；不能在 finish 之前清零。
+            batch.items = 0;
+            batch.callerItems = 0L;
+            batch.workerItems = 0L;
+            batch.callerTasks = 0L;
+            batch.workerTasks = 0L;
+            batch.callerNanos = 0L;
+            batch.activeWorkers.set(0);
+            batch.maximumWorkers.set(0);
+            batch.successful = true;
+            batch.failure = null;
+            batch.finished = false;
+            batch.inUse = true;
+        }
+        return batch;
     }
 
     /** 控制每批任务数，避免密集场景把数值计算拆成数百次跨线程唤醒。 */
@@ -68,7 +110,7 @@
             final Task task = new Task(size, computation, this.activeWorkers, this.maximumWorkers);
             this.pending.add(task);
             try {
-                if (!LeavesXComputeExecutor.tryExecuteSnapshot(this.workload, task::runOnWorker, task::cancel)) {
+                if (!LeavesXComputeExecutor.tryExecuteSnapshot(this.workload, task, task::cancel)) {
                     task.run(false);
                 }
             } catch (final Throwable submissionFailure) {
@@ -111,6 +153,18 @@
     public void close() {
         // 即使后续采集抛异常，也必须先停止全部写入，再让调用者清理或复用缓冲区。
         this.finish();
+        this.failure = null;
+        this.inUse = false;
+        if (this.cached && !LeavesXRuntime.asyncSettings().kernels().snapshotBatchReuse()) {
+            final LeavesXSnapshotBatch[] cached = REUSABLE.get();
+            if (cached != null && cached[this.workload.ordinal()] == this) {
+                cached[this.workload.ordinal()] = null;
+                boolean empty = true;
+                for (final LeavesXSnapshotBatch batch : cached) empty &= batch == null;
+                if (empty) REUSABLE.remove();
+            }
+            this.cached = false;
+        }
     }
 
     /** 只回收已结束的任务句柄，不等待慢片段；输出缓冲仍保留到 flush 或 finish 的完整屏障之后。 */
@@ -165,12 +219,20 @@
         if (Thread.currentThread() != this.owner) throw new IllegalStateException("Snapshot batch used by a different owner");
     }
 
-    private static final class Task {
+    private static final class Task implements LeavesXComputeExecutor.SnapshotTask {
+        private static final VarHandle CLAIMED;
+        static {
+            try {
+                CLAIMED = MethodHandles.lookup().findVarHandle(Task.class, "claimed", boolean.class);
+            } catch (final ReflectiveOperationException failure) {
+                throw new ExceptionInInitializerError(failure);
+            }
+        }
         private final int size;
         private Runnable computation;
         private final AtomicInteger active;
         private final AtomicInteger maximum;
-        private final AtomicBoolean claimed = new AtomicBoolean();
+        private volatile boolean claimed;
         private final CountDownLatch completed = new CountDownLatch(1);
         private Throwable failure;
         private boolean worker;
@@ -183,12 +245,13 @@
             this.maximum = maximum;
         }
 
-        private void runOnWorker() {
+        @Override
+        public void run() {
             this.run(true);
         }
 
         private void run(final boolean worker) {
-            if (!this.claimed.compareAndSet(false, true)) return;
+            if (!CLAIMED.compareAndSet(this, false, true)) return;
             this.executed = true;
             this.worker = worker;
             if (worker) this.maximum.accumulateAndGet(this.active.incrementAndGet(), Math::max);
@@ -203,8 +266,9 @@
             }
         }
 
-        private void cancel(final Throwable failure) {
-            if (this.claimed.compareAndSet(false, true)) {
+        @Override
+        public void cancel(final Throwable failure) {
+            if (CLAIMED.compareAndSet(this, false, true)) {
                 this.failure = failure;
                 this.computation = null;
                 this.completed.countDown();
