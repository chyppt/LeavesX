+            current.executeReserved(task instanceof SnapshotTask ? task : new SnapshotRunnable(task, cancelled));
             return true;
         } catch (final RejectedExecutionException rejection) {
             return false;
@@ -1180,6 +1181,8 @@
                     small.cancel();
                 } else if (pending instanceof SnapshotRunnable snapshot) {
