diff --git a/src/test/java/org/leavesx/leavesx/performance/TripWireEntityScanHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/TripWireEntityScanHotPathTest.java
index 2713ce23e..da25051f5 100644
--- a/src/test/java/org/leavesx/leavesx/performance/TripWireEntityScanHotPathTest.java
+++ b/src/test/java/org/leavesx/leavesx/performance/TripWireEntityScanHotPathTest.java
@@ -44,7 +44,23 @@ class TripWireEntityScanHotPathTest {
         assertEquals("Z", field(buffer, "inUse").desc);
         assertEquals("Z", field(buffer, "pooled").desc);
         assertTrue(hasInvocation(method(buffer, "query"), level.name, "leavesX$getEntities"));
-        assertTrue(hasInvocation(method(buffer, "close"), "java/util/List", "clear"));
+        assertTrue(hasInvocation(method(buffer, "close"), buffer.name, "clearResults"));
+        assertTrue(hasInvocation(method(buffer, "clearResults"), "java/util/List", "clear"));
+    }
+
+    @Test
+    void closingBufferReleasesEntityReferences() throws ReflectiveOperationException {
+        final Object buffer = Level.class.getDeclaredMethod("leavesX$acquireEntityQueryBuffer").invoke(null);
+        final var resultsField = buffer.getClass().getDeclaredField("results");
+        resultsField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        final List<Object> results = (List<Object>)resultsField.get(buffer);
+        try {
+            results.add(new Object());
+        } finally {
+            buffer.getClass().getDeclaredMethod("close").invoke(buffer);
+        }
+        assertTrue(results.isEmpty(), "归还查询缓冲时必须清除全部实体引用");
     }
 
     @Test
