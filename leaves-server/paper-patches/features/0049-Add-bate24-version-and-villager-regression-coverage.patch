+    @Test
+    void golemAgreementCounterPreservesOrderAndStopsAfterFiveAgreements() throws ReflectiveOperationException {
+        final long timestamp = 1200L;
+        final Villager firstDecline = mock();
+        final Villager firstAgreement = mock();
+        final Villager secondAgreement = mock();
+        final Villager secondDecline = mock();
+        final Villager thirdAgreement = mock();
+        final Villager fourthAgreement = mock();
+        final Villager fifthAgreement = mock();
+        final Villager afterLimit = mock();
+        when(firstDecline.wantsToSpawnGolem(timestamp)).thenReturn(false);
+        when(firstAgreement.wantsToSpawnGolem(timestamp)).thenReturn(true);
+        when(secondAgreement.wantsToSpawnGolem(timestamp)).thenReturn(true);
+        when(secondDecline.wantsToSpawnGolem(timestamp)).thenReturn(false);
+        when(thirdAgreement.wantsToSpawnGolem(timestamp)).thenReturn(true);
+        when(fourthAgreement.wantsToSpawnGolem(timestamp)).thenReturn(true);
+        when(fifthAgreement.wantsToSpawnGolem(timestamp)).thenReturn(true);
+        final Method method = Villager.class.getDeclaredMethod("countVillagersWantingGolem", List.class, long.class);
+        method.setAccessible(true);
+
+        final int agreements = (int)method.invoke(
+            null,
+            List.of(
+                firstDecline,
+                firstAgreement,
+                secondAgreement,
+                secondDecline,
+                thirdAgreement,
+                fourthAgreement,
+                fifthAgreement,
+                afterLimit
+            ),
+            timestamp
+        );
+
+        assertEquals(5, agreements);
+        final InOrder order = inOrder(
+            firstDecline,
+            firstAgreement,
+            secondAgreement,
+            secondDecline,
+            thirdAgreement,
+            fourthAgreement,
+            fifthAgreement
+        );
+        order.verify(firstDecline).wantsToSpawnGolem(timestamp);
+        order.verify(firstAgreement).wantsToSpawnGolem(timestamp);
+        order.verify(secondAgreement).wantsToSpawnGolem(timestamp);
+        order.verify(secondDecline).wantsToSpawnGolem(timestamp);
+        order.verify(thirdAgreement).wantsToSpawnGolem(timestamp);
+        order.verify(fourthAgreement).wantsToSpawnGolem(timestamp);
+        order.verify(fifthAgreement).wantsToSpawnGolem(timestamp);
+        verifyNoInteractions(afterLimit);
+    }
+
