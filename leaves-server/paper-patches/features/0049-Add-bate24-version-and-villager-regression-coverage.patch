diff --git a/src/test/java/org/leavesx/leavesx/version/LeavesVersionFetcherTest.java b/src/test/java/org/leavesx/leavesx/version/LeavesVersionFetcherTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..6f8c870d0996ad3cc49dfafb3e347baefb01e482
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/version/LeavesVersionFetcherTest.java
@@ -0,0 +1,42 @@
+package org.leavesx.leavesx.version;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoMoreInteractions;
+import static org.mockito.Mockito.when;
+
+import io.papermc.paper.ServerBuildInfo;
+import java.lang.reflect.Method;
+import java.util.OptionalInt;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.leavesmc.leaves.util.LeavesVersionFetcher;
+
+/** Verifies that custom LeavesX builds never query the upstream Leaves release service. */
+@Normal
+class LeavesVersionFetcherTest {
+
+    @Test
+    void leavesXBuildUsesLocalVersionInformation() throws ReflectiveOperationException {
+        final ServerBuildInfo build = mock();
+        when(build.brandName()).thenReturn("LeavesX");
+        when(build.minecraftVersionId()).thenReturn("26.1.2");
+        when(build.buildNumber()).thenReturn(OptionalInt.of(24));
+        final Method method = LeavesVersionFetcher.class.getDeclaredMethod("getUpdateStatusMessage", ServerBuildInfo.class);
+        method.setAccessible(true);
+
+        final Component message = (Component)method.invoke(null, build);
+
+        assertEquals(
+            Component.text("You are running LeavesX build 24 for Minecraft 26.1.2", NamedTextColor.GREEN),
+            message
+        );
+        verify(build).brandName();
+        verify(build).minecraftVersionId();
+        verify(build).buildNumber();
+        verifyNoMoreInteractions(build);
+    }
+}
