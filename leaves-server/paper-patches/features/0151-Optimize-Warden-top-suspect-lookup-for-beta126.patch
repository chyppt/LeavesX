diff --git a/src/test/java/org/leavesx/leavesx/performance/WardenTopSuspectLookupHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/WardenTopSuspectLookupHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d67bb928ed7e2380331c140aa9de5eedad06412f
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/WardenTopSuspectLookupHotPathTest.java
@@ -0,0 +1,85 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.function.Predicate;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.monster.warden.AngerManagement;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies direct Warden suspect lookup preserves filtering order and configuration fallback behavior. */
+@Normal
+class WardenTopSuspectLookupHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void directLookupReturnsTheFirstAcceptedSuspectInStableOrder() throws ReflectiveOperationException {
+        final Entity rejected = mock(Entity.class);
+        final Entity accepted = mock(Entity.class);
+        final Entity later = mock(Entity.class);
+        final Predicate<Entity> filter = candidate -> candidate == accepted || candidate == later;
+
+        assertSame(accepted, invokeTopSuspect(List.of(rejected, accepted, later), filter));
+        assertNull(invokeTopSuspect(List.of(rejected), filter));
+    }
+
+    @Test
+    void version54ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-54.yml");
+        Files.writeString(path, """
+            config-version: 54
+            performance:
+              ai:
+                warden-top-suspect-lookup: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.wardenTopSuspectLookupOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("warden-top-suspect-lookup: false"));
+        assertTrue(upgraded.contains("# 监守者仇恨目标直接遍历，关闭后使用原版流。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private static Entity invokeTopSuspect(final List<Entity> suspects, final Predicate<Entity> filter)
+        throws ReflectiveOperationException {
+        final Method method = AngerManagement.class.getDeclaredMethod("leavesX$getTopSuspect", List.class, Predicate.class);
+        method.setAccessible(true);
+        return (Entity)method.invoke(null, suspects, filter);
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+}
