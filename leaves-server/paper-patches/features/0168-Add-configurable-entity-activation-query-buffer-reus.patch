diff --git a/src/test/java/org/leavesx/leavesx/config/EntityActivationQueryBufferConfigTest.java b/src/test/java/org/leavesx/leavesx/config/EntityActivationQueryBufferConfigTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f7373eec6de52b7e4b407a0aa8ddc6a81f96edd7
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/EntityActivationQueryBufferConfigTest.java
@@ -0,0 +1,73 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/** Verifies the independently configurable entity-activation query buffer. */
+@Normal
+class EntityActivationQueryBufferConfigTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @AfterEach
+    void restoreRuntimeDefaults() {
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+    }
+
+    @Test
+    void dedicatedSwitchRespectsTheEntityQueryMasterSwitch() throws IOException {
+        LeavesXRuntime.publish(this.configuration(true, true, "enabled.yml"));
+        assertTrue(LeavesXRuntime.entityActivationQueryBufferReuseOptimization());
+
+        LeavesXRuntime.publish(this.configuration(true, false, "disabled.yml"));
+        assertFalse(LeavesXRuntime.entityActivationQueryBufferReuseOptimization());
+
+        LeavesXRuntime.publish(this.configuration(false, true, "master-disabled.yml"));
+        assertFalse(LeavesXRuntime.entityActivationQueryBufferReuseOptimization());
+    }
+
+    @Test
+    void upgradesVersionSixtyWithoutReplacingOperatorSettings() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-sixty.yml");
+        Files.writeString(path, """
+            # 用户配置。
+            config-version: 60
+            custom-extension:
+              retained: true
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        final String upgraded = Files.readString(path);
+
+        assertTrue(config.optimizationEnabled(LeavesXOptimization.ENTITY_ACTIVATION_BUFFER_REUSE));
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("entity-activation-buffer-reuse: true"));
+        assertTrue(upgraded.contains("retained: true"));
+        assertTrue(upgraded.startsWith("# 用户配置。"));
+    }
+
+    private LeavesXConfig configuration(
+        final boolean entityQueryOptimizations,
+        final boolean bufferReuse,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.temporaryDirectory.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-query-optimizations: %s
+              entity-queries:
+                entity-activation-buffer-reuse: %s
+            """.formatted(entityQueryOptimizations, bufferReuse));
+        return LeavesXConfigLoader.load(path);
+    }
+}
