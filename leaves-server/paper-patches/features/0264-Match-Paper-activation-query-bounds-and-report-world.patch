         sender.sendMessage(line(
             "Tick 关键 intent",
             counters.tickCriticalSubmits() + " 提交 / " + counters.tickCriticalCompleted() + " 完成 / "
diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXWorldTicker.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXWorldTicker.java
index f16818dad5..20e82cbcde 100644
--- a/src/main/java/org/leavesx/leavesx/runtime/LeavesXWorldTicker.java
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXWorldTicker.java
@@ -75,6 +75,7 @@ public final class LeavesXWorldTicker {
     private static volatile boolean initialized;
     private static volatile boolean degradedToSerial;
     private static volatile boolean serialCompatibility;
+    private static volatile String serialReason = "未启用";
     private static volatile boolean terminationFailed;
 
     private static final AtomicLong PARALLEL_TICKS = new AtomicLong();
@@ -96,10 +97,19 @@ public final class LeavesXWorldTicker {
         shutdownExecutors();
         // A plugin can transfer to an otherwise independent custom world. Pinning only the
         // vanilla trio would still race that destination, so preserve the whole list's order.
-        serialCompatibility = levels.stream().anyMatch(level ->
-            Level.OVERWORLD.equals(level.dimension()) || Level.NETHER.equals(level.dimension())
-                || Level.END.equals(level.dimension())
-                || LeavesXRegionTicking.isStrictSerialWorld(level.getWorld().getName()));
+        final List<String> serialWorlds = new ArrayList<>();
+        for (final ServerLevel level : levels) {
+            final String name = level.getWorld().getName();
+            if (Level.OVERWORLD.equals(level.dimension()) || Level.NETHER.equals(level.dimension())
+                || Level.END.equals(level.dimension())) {
+                serialWorlds.add(name + "（原版维度）");
+            } else if (LeavesXRegionTicking.isStrictSerialWorld(name)) {
+                serialWorlds.add(name + "（配置强制串行）");
+            }
+        }
+        serialCompatibility = !serialWorlds.isEmpty();
+        // 跨世界传送会立即修改两个世界；任一受保护世界存在时，不能只让其余世界并行。
+        serialReason = serialCompatibility ? String.join("、", serialWorlds) : "无";
         final List<WorldExecutor> next = new ArrayList<>(levels.size());
         for (final ServerLevel level : levels) {
             next.add(new WorldExecutor(level, serialCompatibility));
@@ -175,6 +185,12 @@ public final class LeavesXWorldTicker {
         return serialCompatibility || degradedToSerial;
     }
 
+    /** 只读诊断：说明为什么当前世界 Tick 回到原串行顺序。 */
+    public static String serialReason() {
+        if (degradedToSerial) return "并行世界 Tick 曾发生异常，已降级到重启";
+        return serialCompatibility ? serialReason : "无";
+    }
+
     /**
      * Runs bounded batches while pumping synchronous events on the calling server thread.
      * Returns false when compatibility requires the original serial world order.
