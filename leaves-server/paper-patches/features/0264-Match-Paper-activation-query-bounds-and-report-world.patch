From a0df451ddbd35caae6a330748835ff7cf047f3ac Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Date: Sun, 18 Oct 2026 10:53:15 +0800
Subject: [PATCH] Match Paper activation query bounds and report world serial
 causes

---
 .../activation/ActivationRangeSnapshot.java   | 23 ++++++++++++++----
 .../leavesx/command/LeavesXCommand.java       | 11 +++++++++
 .../leavesx/runtime/LeavesXWorldTicker.java   | 24 +++++++++++++++----
 .../ActivationRangeSnapshotTest.java          |  7 ++++--
 4 files changed, 55 insertions(+), 10 deletions(-)

diff --git a/src/main/java/io/papermc/paper/entity/activation/ActivationRangeSnapshot.java b/src/main/java/io/papermc/paper/entity/activation/ActivationRangeSnapshot.java
index 92f99f9792..d83dcb1688 100644
--- a/src/main/java/io/papermc/paper/entity/activation/ActivationRangeSnapshot.java
+++ b/src/main/java/io/papermc/paper/entity/activation/ActivationRangeSnapshot.java
@@ -211,8 +211,7 @@ final class ActivationRangeSnapshot {
             boolean intersects = false;
             if (activationGroups == null) {
                 for (int playerIndex = 0; playerIndex < playerCount; playerIndex++) {
-                    final int activationOffset = (playerIndex * PLAYER_BOXES + boxIndex) * AABB_COMPONENTS;
-                    if (intersects(playerBounds, activationOffset, entityBounds, entityOffset)) {
+                    if (playerActivates(playerBounds, playerIndex, boxIndex, entityBounds, entityOffset)) {
                         intersects = true;
                         break;
                     }
@@ -225,8 +224,7 @@ final class ActivationRangeSnapshot {
                     final int firstPlayer = group * PREFILTER_GROUP_SIZE;
                     final int lastPlayer = Math.min(playerCount, firstPlayer + PREFILTER_GROUP_SIZE);
                     for (int playerIndex = firstPlayer; playerIndex < lastPlayer; playerIndex++) {
-                        final int activationOffset = (playerIndex * PLAYER_BOXES + boxIndex) * AABB_COMPONENTS;
-                        if (intersects(playerBounds, activationOffset, entityBounds, entityOffset)) {
+                        if (playerActivates(playerBounds, playerIndex, boxIndex, entityBounds, entityOffset)) {
                             intersects = true;
                             break;
                         }
@@ -237,6 +235,23 @@ final class ActivationRangeSnapshot {
         }
     }
 
+    /**
+     * Paper 先用同一玩家的 maxBB 查询候选，再检查类型激活框；两者都必须相交。
+     * 类型范围可大于按模拟距离截断后的 maxRange，只检查类型框会激活原循环不会访问的实体。
+     */
+    private static boolean playerActivates(
+        final double[] playerBounds,
+        final int playerIndex,
+        final int boxIndex,
+        final double[] entityBounds,
+        final int entityOffset
+    ) {
+        final int playerOffset = playerIndex * PLAYER_BOXES * AABB_COMPONENTS;
+        return intersects(playerBounds, playerOffset, entityBounds, entityOffset)
+            && (boxIndex == 0
+                || intersects(playerBounds, playerOffset + boxIndex * AABB_COMPONENTS, entityBounds, entityOffset));
+    }
+
     /** 合并同类玩家激活框；实体不与并集相交时，可以确定它不与任何单个玩家相交。 */
     static void snapshotActivationUnions(final double[] playerBounds, final double[] unions, final int playerCount) {
         snapshotActivationUnions(playerBounds, 0, unions, 0, playerCount);
diff --git a/src/main/java/org/leavesx/leavesx/command/LeavesXCommand.java b/src/main/java/org/leavesx/leavesx/command/LeavesXCommand.java
