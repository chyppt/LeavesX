diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkPosCachedKeyHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkPosCachedKeyHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2785918a803fc4f72edb3fd6e624019c84cad7dc
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkPosCachedKeyHotPathTest.java
@@ -0,0 +1,124 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.world.level.ChunkPos;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies Moonrise chunk-key lookups can reuse Paper's immutable {@link ChunkPos} key. */
+@Normal
+class ChunkPosCachedKeyHotPathTest {
+
+    private static final int[][] REPRESENTATIVE_COORDINATES = {
+        {0, 0},
+        {1, -1},
+        {-1, 1},
+        {Integer.MAX_VALUE, Integer.MIN_VALUE},
+        {Integer.MIN_VALUE, Integer.MAX_VALUE}
+    };
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedAndFallbackKeysMatchForRepresentativeCoordinates() throws Exception {
+        try {
+            publish(this.configuration(true, "optimized.yml"));
+            for (final int[] coordinates : REPRESENTATIVE_COORDINATES) {
+                assertMatchesVanillaPacking(coordinates);
+            }
+
+            publish(this.configuration(false, "fallback.yml"));
+            for (final int[] coordinates : REPRESENTATIVE_COORDINATES) {
+                assertMatchesVanillaPacking(coordinates);
+            }
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void dedicatedSwitchCanDisableTheCachedKeyPath() throws Exception {
+        try {
+            publish(this.configuration(true, "enabled.yml"));
+            assertTrue(LeavesXRuntime.cachedChunkPosKeyOptimization());
+
+            publish(this.configuration(false, "disabled.yml"));
+            assertFalse(LeavesXRuntime.cachedChunkPosKeyOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void chunkPosOverloadKeepsCachedAndArithmeticPaths() throws IOException {
+        final MethodNode method = method(classNode(), "getChunkKey", "(Lnet/minecraft/world/level/ChunkPos;)J");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertEquals(1L, countCall(calls, "org/leavesx/leavesx/config/LeavesXRuntime", "cachedChunkPosKeyOptimization"));
+        assertEquals(1L, countCall(calls, "net/minecraft/world/level/ChunkPos", "longKey"));
+        assertEquals(1L, countCall(calls, "net/minecraft/world/level/ChunkPos", "x"));
+        assertEquals(1L, countCall(calls, "net/minecraft/world/level/ChunkPos", "z"));
+    }
+
+    private static void assertMatchesVanillaPacking(final int[] coordinates) {
+        final ChunkPos position = new ChunkPos(coordinates[0], coordinates[1]);
+        assertEquals(ChunkPos.pack(coordinates[0], coordinates[1]), CoordinateUtils.getChunkKey(position));
+        assertEquals(position.longKey(), CoordinateUtils.getChunkKey(position));
+    }
+
+    private LeavesXConfig configuration(final boolean enabled, final String fileName) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              chunk:
+                cached-chunk-pos-key: %s
+            """.formatted(enabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(CoordinateUtils.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name + descriptor));
+    }
+
+    private static long countCall(final MethodInsnNode[] calls, final String owner, final String name) {
+        return Arrays.stream(calls).filter(call -> call.owner.equals(owner) && call.name.equals(name)).count();
+    }
+}
