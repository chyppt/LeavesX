     /** Returns whether uncontended ticket-queue scans may defer allocating their conflict list. */
     public static boolean ticketQueueAllocationOptimization() {
         return enabled(LeavesXOptimization.TICKET_QUEUE_ALLOCATION);
@@ -1268,6 +1273,11 @@ public final class LeavesXRuntime {
         return aiOptimizations && enabled(LeavesXOptimization.POI_SECTION_BITSET);
     }
 
+    /** Returns whether villager job-site competitor scans may skip loading unloaded POI sections. */
+    public static boolean poiCompetitorScanNoLoadOptimization() {
+        return false;
+    }
+
     /** Returns whether villager golem agreement counting may stop at the required threshold. */
     public static boolean villagerGolemAgreementOptimization() {
         return false;
@@ -1285,7 +1295,7 @@ public final class LeavesXRuntime {
 
     /** Returns whether unchanged follow ranges may retain their existing targeting conditions. */
     public static boolean sensorFollowRangeCacheOptimization() {
-        return aiOptimizations && enabled(LeavesXOptimization.SENSOR_FOLLOW_RANGE_CACHE);
+        return false;
     }
 
     /** Returns whether nearest-entity sensors may use the stable reusable distance sorter. */
