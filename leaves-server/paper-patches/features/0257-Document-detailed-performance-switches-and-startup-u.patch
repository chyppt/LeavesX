--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/update/LeavesXUpdateNotifier.java
@@ -0,0 +1,25 @@
+package org.leavesx.leavesx.update;
+
+import net.kyori.adventure.text.Component;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.player.PlayerJoinEvent;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.leavesx.leavesx.presentation.LeavesXPlayerPresentation;
+
+/** OP 加入时提示已确认的更新；事件线程只读取缓存，不等待网络。 */
+public final class LeavesXUpdateNotifier implements Listener {
+    @EventHandler(priority = EventPriority.MONITOR)
+    public void onJoin(final PlayerJoinEvent event) {
+        if (!event.getPlayer().isOp() || !LeavesXRuntime.configuration().extensions().updateCheck()) {
+            return;
+        }
+        final String version = LeavesXUpdateService.availableVersion();
+        if (version != null) {
+            event.getPlayer().sendMessage(LeavesXPlayerPresentation.withCorePrefix(
+                Component.text("发现 LeavesX " + version + " 更新，请查看 GitHub 发布页面。")
+            ));
+        }
+    }
+}
