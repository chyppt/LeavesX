From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Subject: [PATCH] Align regression fixtures and interrupt fallback

diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
index ffa6c6ba8..8f151e484 100644
--- a/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutor.java
@@ -2115,6 +2115,10 @@ public final class LeavesXComputeExecutor {
                     this.recordFailure(interruption);
                 }
             }
+            // 工作线程可能在自旋阶段完成；已到达调用线程的中断仍须触发完整回退。
+            if (Thread.currentThread().isInterrupted()) {
+                this.recordFailure(new InterruptedException("Compute caller interrupted before completion"));
+            }
             if (interrupted) Thread.currentThread().interrupt();
         }
 
