diff --git a/src/test/java/org/leavesx/leavesx/performance/DespawnRangeLookupHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/DespawnRangeLookupHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c446c667e055df04a1eceeb3c02d12aede045f5a
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/DespawnRangeLookupHotPathTest.java
@@ -0,0 +1,179 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.mock;
+
+import io.papermc.paper.configuration.WorldConfiguration;
+import io.papermc.paper.configuration.type.DespawnRange;
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.EnumMap;
+import java.util.Map;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies mob despawn range indexing preserves Paper's configured objects and fallback path. */
+@Normal
+class DespawnRangeLookupHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void indexedLookupReturnsTheSameConfiguredRangeAndRetainsFallback() throws Exception {
+        final WorldConfiguration.Entities.Spawning spawning = mock(
+            WorldConfiguration.Entities.Spawning.class,
+            CALLS_REAL_METHODS
+        );
+        final WorldConfiguration.Entities.Spawning.DespawnRangePair monsterRange = rangePair();
+        final Map<MobCategory, WorldConfiguration.Entities.Spawning.DespawnRangePair> ranges =
+            new EnumMap<>(MobCategory.class);
+        ranges.put(MobCategory.MONSTER, monsterRange);
+        spawning.despawnRanges = ranges;
+        setIndex(spawning, new WorldConfiguration.Entities.Spawning.DespawnRangePair[MobCategory.values().length]);
+        spawning.precomputeDespawnDistances();
+
+        try {
+            publish(this.configuration(true, true, "indexed.yml"));
+            assertSame(monsterRange, spawning.leavesX$getDespawnRange(MobCategory.MONSTER));
+
+            final WorldConfiguration.Entities.Spawning.DespawnRangePair replacement = rangePair();
+            ranges.put(MobCategory.MONSTER, replacement);
+            publish(this.configuration(true, false, "fallback.yml"));
+            assertSame(replacement, spawning.leavesX$getDespawnRange(MobCategory.MONSTER));
+
+            publish(this.configuration(false, true, "master-disabled.yml"));
+            assertSame(replacement, spawning.leavesX$getDespawnRange(MobCategory.MONSTER));
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void missingIndexedEntryFallsBackToThePaperMap() throws Exception {
+        final WorldConfiguration.Entities.Spawning spawning = mock(
+            WorldConfiguration.Entities.Spawning.class,
+            CALLS_REAL_METHODS
+        );
+        final WorldConfiguration.Entities.Spawning.DespawnRangePair creatureRange = rangePair();
+        final Map<MobCategory, WorldConfiguration.Entities.Spawning.DespawnRangePair> ranges =
+            new EnumMap<>(MobCategory.class);
+        ranges.put(MobCategory.CREATURE, creatureRange);
+        spawning.despawnRanges = ranges;
+        setIndex(spawning, new WorldConfiguration.Entities.Spawning.DespawnRangePair[MobCategory.values().length]);
+
+        try {
+            publish(this.configuration(true, true, "missing-entry.yml"));
+            assertSame(creatureRange, spawning.leavesX$getDespawnRange(MobCategory.CREATURE));
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void version45ConfigurationAddsTheDocumentedSwitchWithoutBackupNoise() throws Exception {
+        final Path path = this.temporaryDirectory.resolve("leavesx.yml");
+        Files.writeString(path, """
+            config-version: 45
+            performance:
+              entity-state:
+                despawn-range-lookup: false
+            """);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.despawnRangeLookupOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: 46"));
+        assertTrue(upgraded.contains("despawn-range-lookup: false"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    @Test
+    void mobDespawnCheckUsesTheIndexedAccessor() throws IOException {
+        final ClassNode mob = classNode(Mob.class);
+        final MethodNode checkDespawn = method(mob, "checkDespawn");
+
+        assertTrue(Arrays.stream(checkDespawn.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(
+                "io/papermc/paper/configuration/WorldConfiguration$Entities$Spawning"
+            ) && call.name.equals("leavesX$getDespawnRange")));
+    }
+
+    private LeavesXConfig configuration(
+        final boolean masterEnabled,
+        final boolean settingEnabled,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.temporaryDirectory.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-state-optimizations: %s
+              entity-state:
+                despawn-range-lookup: %s
+            """.formatted(masterEnabled, settingEnabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static WorldConfiguration.Entities.Spawning.DespawnRangePair rangePair() {
+        final DespawnRange hard = mock(DespawnRange.class);
+        final DespawnRange soft = mock(DespawnRange.class);
+        return new WorldConfiguration.Entities.Spawning.DespawnRangePair(hard, soft);
+    }
+
+    private static void setIndex(
+        final WorldConfiguration.Entities.Spawning spawning,
+        final WorldConfiguration.Entities.Spawning.DespawnRangePair[] index
+    ) throws ReflectiveOperationException {
+        final Field field = WorldConfiguration.Entities.Spawning.class
+            .getDeclaredField("leavesX$despawnRangesByCategory");
+        field.setAccessible(true);
+        field.set(spawning, index);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode(final Class<?> type) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(type.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(candidate -> candidate.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+}
