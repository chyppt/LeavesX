         changed |= writeValue(node.node("async", "ai-candidates"), "async.ai-candidates", config.extensions().asyncAiCandidates(), missingOnly);
         changed |= writeValue(node.node("async", "playerdata-save", "compression"), "async.playerdata-save.compression", config.extensions().asyncPlayerCompression(), missingOnly);
@@ -549,6 +551,8 @@ public final class LeavesXConfigWriter {
         comments.put("performance.lithium.enabled", "启用 Lithium 的空闲实体和漏斗槽位优化；关闭后走原检查逻辑。默认：true。");
         comments.put("performance.blocks.container-copy-reuse", "复用容器同步的临时副本，减少背包和箱子操作时的内存分配。默认：true。");
