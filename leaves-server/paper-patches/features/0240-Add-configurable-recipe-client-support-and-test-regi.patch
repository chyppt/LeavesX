diff --git a/src/test/java/org/bukkit/support/DummyServerHelper.java b/src/test/java/org/bukkit/support/DummyServerHelper.java
index 5811a3bbde..9583fc6119 100644
--- a/src/test/java/org/bukkit/support/DummyServerHelper.java
+++ b/src/test/java/org/bukkit/support/DummyServerHelper.java
@@ -99,7 +99,14 @@ public final class DummyServerHelper {
         when(instance.getPluginManager()).thenReturn(pluginManager);
         // Paper end - testing additions
 
-        io.papermc.paper.configuration.GlobalConfigTestingBase.setupGlobalConfigForTest(RegistryHelper.registryAccess()); // Paper - configuration files - setup global configuration test base
+        // Item obfuscation binds enchantment components while the global configuration is created.
+        // Supply the same registry snapshot as the test datapack, before its static initializer runs.
+        final var minecraftServer = mock(net.minecraft.server.MinecraftServer.class);
+        when(minecraftServer.registryAccess()).thenReturn(RegistryHelper.registryAccess().freeze());
+        try (var servers = mockStatic(net.minecraft.server.MinecraftServer.class, CALLS_REAL_METHODS)) {
+            servers.when(net.minecraft.server.MinecraftServer::getServer).thenReturn(minecraftServer);
+            io.papermc.paper.configuration.GlobalConfigTestingBase.setupGlobalConfigForTest(RegistryHelper.registryAccess());
+        }
 
         // Paper start - add test for recipe conversion
         when(instance.recipeIterator()).thenAnswer(ignored ->
