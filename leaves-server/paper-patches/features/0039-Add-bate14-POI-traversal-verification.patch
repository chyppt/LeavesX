 import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
 import org.bukkit.support.environment.Normal;
 import org.junit.jupiter.api.Test;
 
@@ -10,9 +17,8 @@ import org.junit.jupiter.api.Test;
 class PoiSearchCapacityTest {
 
     @Test
-    void includesTheVisitedBoxAndItsSixFaceShells() {
-        // 7 * 24 * 7 in-bounds sections plus two faces for each pair of dimensions.
-        assertEquals(1_946, PoiSearchCapacity.forBounds(-3, -4, -3, 3, 19, 3));
+    void includesEverySectionInsideTheVisitedBox() {
+        assertEquals(1_176, PoiSearchCapacity.forBounds(-3, -4, -3, 3, 19, 3));
     }
 
     @Test
@@ -38,6 +44,97 @@ class PoiSearchCapacityTest {
         assertEquals(2_048, PoiSearchCapacity.forBounds(Integer.MIN_VALUE, -64, -64, Integer.MAX_VALUE, 64, 64));
     }
 
+    @Test
+    void testsInclusiveBoundsWithoutPackingCoordinates() {
+        assertTrue(PoiSearchCapacity.contains(-3, -4, -3, -3, -4, -3, 3, 19, 3));
+        assertTrue(PoiSearchCapacity.contains(3, 19, 3, -3, -4, -3, 3, 19, 3));
+        assertFalse(PoiSearchCapacity.contains(4, 0, 0, -3, -4, -3, 3, 19, 3));
+        assertFalse(PoiSearchCapacity.contains(0, -5, 0, -3, -4, -3, 3, 19, 3));
+    }
+
+    @Test
+    void boundedTraversalPreservesReferenceInBoundsOrder() {
+        assertTraversalEquivalent(new Bounds(-3, -4, -3, 3, 19, 3), new SectionPosition(0, 4, 0));
+        assertTraversalEquivalent(new Bounds(10, 2, -8, 14, 7, -2), new SectionPosition(11, 6, -7));
+        assertTraversalEquivalent(new Bounds(5, 5, 5, 5, 5, 5), new SectionPosition(5, 5, 5));
+    }
+
+    private static void assertTraversalEquivalent(final Bounds bounds, final SectionPosition center) {
+        final TraversalResult reference = traverse(bounds, center, false);
+        final TraversalResult bounded = traverse(bounds, center, true);
+
+        assertEquals(reference.inBoundsOrder, bounded.inBoundsOrder);
+        assertEquals(bounds.volume(), bounded.seenCount);
+        assertTrue(bounded.seenCount < reference.seenCount);
+    }
+
+    private static TraversalResult traverse(final Bounds bounds, final SectionPosition center, final boolean boundedNeighbours) {
+        final ArrayDeque<SectionPosition> queue = new ArrayDeque<>();
+        final Set<SectionPosition> seen = new HashSet<>();
+        final List<SectionPosition> inBoundsOrder = new ArrayList<>();
+        seen.add(center);
+        queue.add(center);
+
+        while (!queue.isEmpty()) {
+            final SectionPosition current = queue.removeFirst();
+            if (!bounds.contains(current)) {
+                continue;
+            }
+            inBoundsOrder.add(current);
+
+            for (int dz = -1; dz <= 1; dz++) {
+                for (int dx = -1; dx <= 1; dx++) {
+                    for (int dy = -1; dy <= 1; dy++) {
+                        if ((dx & 1) + (dy & 1) + (dz & 1) != 1) {
+                            continue;
+                        }
+                        final SectionPosition neighbour = new SectionPosition(
+                            current.x + dx,
+                            current.y + dy,
+                            current.z + dz
+                        );
+                        if (boundedNeighbours && !bounds.contains(neighbour)) {
+                            continue;
+                        }
+                        if (seen.add(neighbour)) {
+                            queue.addLast(neighbour);
+                        }
+                    }
+                }
+            }
+        }
+        return new TraversalResult(List.copyOf(inBoundsOrder), seen.size());
+    }
+
+    private record Bounds(int lowerX, int lowerY, int lowerZ, int upperX, int upperY, int upperZ) {
+
+        private boolean contains(final SectionPosition position) {
+            return PoiSearchCapacity.contains(
+                position.x,
+                position.y,
+                position.z,
+                this.lowerX,
+                this.lowerY,
+                this.lowerZ,
+                this.upperX,
+                this.upperY,
+                this.upperZ
+            );
+        }
+
+        private int volume() {
+            return (this.upperX - this.lowerX + 1)
+                * (this.upperY - this.lowerY + 1)
+                * (this.upperZ - this.lowerZ + 1);
+        }
+    }
+
+    private record SectionPosition(int x, int y, int z) {
+    }
+
+    private record TraversalResult(List<SectionPosition> inBoundsOrder, int seenCount) {
+    }
+
     private static final class RehashCountingSet extends LongOpenHashSet {
 
         private int rehashCount;
