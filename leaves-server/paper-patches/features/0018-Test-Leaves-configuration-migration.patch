+package org.leavesx.leavesx.support;
+
+import org.junit.platform.suite.api.ConfigurationParameter;
+import org.junit.platform.suite.api.IncludeTags;
+import org.junit.platform.suite.api.SelectPackages;
+import org.junit.platform.suite.api.Suite;
+import org.junit.platform.suite.api.SuiteDisplayName;
+
+/**
+ * Entry point for LeavesX tests that do not require a live Minecraft registry.
+ *
+ * <p>The Folia build restricts test discovery to classes ending in {@code TestSuite}; keeping this suite narrow
+ * prevents unrelated upstream tests from changing the result of the LeavesX migration checks.</p>
+ */
+@Suite(failIfNoTests = false)
+@SuiteDisplayName("LeavesX compatibility and migration tests")
+@IncludeTags("Normal")
+@SelectPackages("org.leavesx")
+@ConfigurationParameter(key = "TestSuite", value = "Normal")
+public final class LeavesXTestSuite {
+}
