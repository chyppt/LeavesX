@@ -454,8 +454,8 @@ public final class LeavesXConfigWriter {
         comments.put("fakeplayer.role.wrapper.enabled", "是否在作用外显示包裹符号。默认：true。");
         comments.put("fakeplayer.role.wrapper.left", "作用左侧包裹符号。默认：[。");
         comments.put("fakeplayer.role.wrapper.right", "作用右侧包裹符号。默认：]。");
-        comments.put("messages.join", "自定义进入提示，可用 <name> 和 <display_name>，支持 MiniMessage 和 &/§ 颜色代码，空字符串保持默认。默认：空。");
-        comments.put("messages.quit", "自定义退出提示，可用 <name> 和 <display_name>，支持 MiniMessage 和 &/§ 颜色代码，空字符串保持默认。默认：空。");
+        comments.put("messages.join", "自定义进入提示；<player> 是玩家名，<name> 保持兼容，<display_name> 是显示名，也支持 %player_name% 和 &/§ 颜色代码。空字符串保持默认。默认：空。");
+        comments.put("messages.quit", "自定义退出提示；<player> 是玩家名，<name> 保持兼容，<display_name> 是显示名，也支持 %player_name% 和 &/§ 颜色代码。空字符串保持默认。默认：空。");
         comments.put("messages.core-prefix", "服务端核心提示的统一前缀，例如假人创建成功或配置重载提示；支持 MiniMessage 和 &/§ 颜色代码。默认：空。");
         comments.put("diagnostics.command-enabled", "是否启用 /leavesx 性能诊断命令。默认：true。");
         comments.put("diagnostics.default-result-limit", "实体类型和热点默认显示数量。默认：10。");
diff --git a/src/main/java/org/leavesx/leavesx/presentation/LeavesXPlayerPresentation.java b/src/main/java/org/leavesx/leavesx/presentation/LeavesXPlayerPresentation.java
index 2d5ae43610f6309b012e53aca899b68f8cb1c941..1423d1ccd2d4c0eaf007ea3f547e07748f185a9d 100644
--- a/src/main/java/org/leavesx/leavesx/presentation/LeavesXPlayerPresentation.java
+++ b/src/main/java/org/leavesx/leavesx/presentation/LeavesXPlayerPresentation.java
@@ -89,12 +89,21 @@ public final class LeavesXPlayerPresentation {
             return paperDefault;
         }
         return deserializeConfigured(
-            template,
+            normalizePlayerPlaceholders(template),
             Placeholder.unparsed("name", accountName),
+            // <player> is the explicit public placeholder; <name> remains for compatibility with earlier builds.
+            Placeholder.unparsed("player", accountName),
             Placeholder.component("display_name", displayName)
         );
     }
 
+    /** Accepts the percent form commonly used in server configuration files. */
+    private static String normalizePlayerPlaceholders(final String template) {
+        return template
+            .replace("%player%", "<player>")
+            .replace("%player_name%", "<player>");
+    }
+
     /**
      * Parses both the documented MiniMessage syntax and legacy Minecraft color codes.
      *
