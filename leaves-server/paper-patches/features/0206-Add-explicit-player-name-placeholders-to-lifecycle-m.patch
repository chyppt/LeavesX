+    @Test
+    void exposesExplicitPlayerPlaceholderAndPercentAlias() {
+        publishConfig("", "玩家=<player> / 旧变量=<name> / 百分号=%player_name%", "");
+
+        assertEquals("玩家=Alice / 旧变量=Alice / 百分号=Alice", LEGACY.serialize(
+            LeavesXPlayerPresentation.joinMessage("Alice", Component.text("Alice"), Component.text("default"))
+        ));
+    }
+
     @Test
     void defaultLifecycleMessagesExcludeTheDisplayOnlyPrefix() {
         publishConfig("&a[假人]", "", "");
