diff --git a/src/test/java/org/leavesx/leavesx/performance/VillagerProfessionAssignmentHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/VillagerProfessionAssignmentHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d77037ec425eaf3fd8e8dfb0902cf5aa3d1a9470
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/VillagerProfessionAssignmentHotPathTest.java
@@ -0,0 +1,87 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.core.Holder;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.world.entity.ai.behavior.AssignProfessionFromJobSite;
+import net.minecraft.world.entity.ai.village.poi.PoiType;
+import net.minecraft.world.entity.npc.villager.VillagerProfession;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies villager profession lookup keeps registry order and the Bukkit career-change path. */
+@Normal
+class VillagerProfessionAssignmentHotPathTest {
+
+    @Test
+    void directLookupMatchesVanillaRegistryOrderForEveryPoiType() throws Exception {
+        final Method directLookup = AssignProfessionFromJobSite.class.getDeclaredMethod("findProfessionDirect", Holder.class);
+        directLookup.setAccessible(true);
+
+        for (final Holder.Reference<PoiType> poiType : BuiltInRegistries.POINT_OF_INTEREST_TYPE.listElements().toList()) {
+            final Holder<VillagerProfession> expected = BuiltInRegistries.VILLAGER_PROFESSION
+                .listElements()
+                .filter(profession -> profession.value().heldJobSite().test(poiType))
+                .findFirst()
+                .orElse(null);
+            @SuppressWarnings("unchecked")
+            final Holder<VillagerProfession> actual = (Holder<VillagerProfession>)directLookup.invoke(null, poiType);
+
+            assertSame(expected, actual, () -> "Profession order changed for POI " + poiType);
+        }
+    }
+
+    @Test
+    void optimizedAndVanillaPathsRemainSelectable() throws IOException {
+        final ClassNode behavior = classNode(AssignProfessionFromJobSite.class);
+        final MethodNode directLookup = method(behavior, "findProfessionDirect");
+        final List<MethodInsnNode> directCalls = invocations(directLookup);
+        final List<MethodInsnNode> behaviorCalls = behavior.methods.stream()
+            .filter(method -> method.name.equals("create") || method.name.startsWith("lambda$create$"))
+            .flatMap(method -> invocations(method).stream())
+            .toList();
+        final List<MethodInsnNode> assignmentCalls = invocations(method(behavior, "assignProfession"));
+
+        assertFalse(directCalls.stream().anyMatch(call -> call.name.equals("stream") || call.name.equals("listElements")));
+        assertTrue(directCalls.stream().anyMatch(call -> call.name.equals("size")));
+        assertTrue(directCalls.stream().anyMatch(call -> call.name.equals("byId")));
+        assertTrue(directCalls.stream().anyMatch(call -> call.name.equals("wrapAsHolder")));
+        assertTrue(behaviorCalls.stream().anyMatch(call -> call.name.equals("villagerProfessionAssignmentOptimization")));
+        assertTrue(behaviorCalls.stream().anyMatch(call -> call.name.equals("listElements")));
+        assertTrue(behaviorCalls.stream().anyMatch(call -> call.name.equals("findFirst")));
+        assertTrue(assignmentCalls.stream().anyMatch(call -> call.name.equals("callVillagerCareerChangeEvent")));
+        assertTrue(assignmentCalls.stream().anyMatch(call -> call.name.equals("refreshBrain")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
