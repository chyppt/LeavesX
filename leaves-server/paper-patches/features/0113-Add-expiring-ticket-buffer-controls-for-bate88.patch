diff --git a/src/test/java/org/leavesx/leavesx/performance/ExpiringTicketBufferHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ExpiringTicketBufferHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..61ad412ac846d787076df3e6032262952c936c5c
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ExpiringTicketBufferHotPathTest.java
@@ -0,0 +1,57 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Verifies expiring-ticket ticks retain lazy buffers and the original eager allocation fallback. */
+@Normal
+class ExpiringTicketBufferHotPathTest {
+
+    @Test
+    void ticketTickDefersBuffersWithoutChangingProcessingCalls() throws IOException {
+        final MethodNode method = method(classNode(ChunkHolderManager.class), "tick");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertTrue(Arrays.stream(calls).anyMatch(call -> call.name.equals("expiringTicketBuffersOptimization")));
+        assertTrue(Arrays.stream(calls).anyMatch(call -> call.name.equals("processTicketUpdatesNoLock")));
+        assertTrue(Arrays.stream(calls).anyMatch(call -> call.name.equals("processTicketUpdates")));
+        assertTrue(Arrays.stream(method.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .filter(instruction -> instruction.getOpcode() == Opcodes.NEW)
+            .filter(instruction -> instruction.desc.equals("java/util/ArrayList"))
+            .count() >= 2L);
+        assertTrue(Arrays.stream(method.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .anyMatch(instruction -> instruction.getOpcode() == Opcodes.ANEWARRAY
+                && instruction.desc.equals("net/minecraft/server/level/Ticket")));
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
