+    /**
+     * Ensures medium immutable work can use idle cores without queueing behind the occupied half of the pool.
+     * This models overlapping safe snapshot batches while preserving one complete deterministic pass.
+     */
+    @Test
+    void adaptivelyDispatchesWhenHalfThePoolIsAvailable() throws Exception {
+        LeavesXComputeExecutor.configure(4, 64);
+        final ThreadPoolExecutor executor = executor();
+        final CountDownLatch release = new CountDownLatch(1);
+        final CountDownLatch workersStarted = new CountDownLatch(2);
+        final Runnable blocker = () -> {
+            workersStarted.countDown();
+            try {
+                release.await();
+            } catch (final InterruptedException interruption) {
+                Thread.currentThread().interrupt();
+            }
+        };
+        executor.execute(blocker);
+        executor.execute(blocker);
+        assertTrue(workersStarted.await(2L, TimeUnit.SECONDS));
+
+        try {
+            final AtomicIntegerArray counts = new AtomicIntegerArray(192);
+            final int partitions = LeavesXComputeExecutor.invokeRangesWithCount(
+                LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                counts.length(),
+                256,
+                128,
+                (taskIndex, start, end) -> {
+                    for (int index = start; index < end; index++) {
+                        counts.incrementAndGet(index);
+                    }
+                }
+            );
+
+            assertTrue(partitions > 1, "the idle half of the pool should accept a medium pure-AI batch");
+            for (int index = 0; index < counts.length(); index++) {
+                assertEquals(1, counts.get(index), "adaptive dispatch must process index " + index + " exactly once");
+            }
+            assertTrue(
+                LeavesXComputeExecutor.metrics().workerItems() > 0L,
+                "available workers must execute part of the adaptive batch"
+            );
+        } finally {
+            release.countDown();
+        }
+    }
+
     @Test
     void doesNotAdaptivelyDispatchUnspecifiedWorkloads() {
         LeavesXComputeExecutor.configure(4, 64);
