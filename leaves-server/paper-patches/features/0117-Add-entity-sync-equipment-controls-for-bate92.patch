diff --git a/src/test/java/org/leavesx/leavesx/performance/EntitySyncEquipmentListHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntitySyncEquipmentListHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..4247e9ef82892bc0cfcc0fc0bae9170fafde841b
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntitySyncEquipmentListHotPathTest.java
@@ -0,0 +1,101 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.mojang.datafixers.util.Pair;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.server.level.ServerEntity;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.item.ItemStack;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies entity pairing retains lazy equipment allocation and the Paper fallback. */
+@Normal
+class EntitySyncEquipmentListHotPathTest {
+
+    @Test
+    void emptyEquipmentAllocatesOnlyOnThePaperPath() throws ReflectiveOperationException {
+        final LivingEntity entity = mock(LivingEntity.class);
+        when(entity.getItemBySlot(any())).thenReturn(ItemStack.EMPTY);
+
+        assertNull(collectEquipment(entity, true));
+        final List<Pair<EquipmentSlot, ItemStack>> fallback = collectEquipment(entity, false);
+        assertNotNull(fallback);
+        assertTrue(fallback.isEmpty());
+    }
+
+    @Test
+    void equippedItemsKeepSlotOrderAndCopiedStacks() throws ReflectiveOperationException {
+        final LivingEntity entity = mock(LivingEntity.class);
+        final ItemStack equipped = mock(ItemStack.class);
+        final ItemStack copied = mock(ItemStack.class);
+        when(entity.getItemBySlot(any())).thenReturn(ItemStack.EMPTY);
+        when(entity.getItemBySlot(EquipmentSlot.MAINHAND)).thenReturn(equipped);
+        when(equipped.isEmpty()).thenReturn(false);
+        when(equipped.copy()).thenReturn(copied);
+
+        final List<Pair<EquipmentSlot, ItemStack>> equipment = collectEquipment(entity, true);
+        assertNotNull(equipment);
+        assertEquals(1, equipment.size());
+        assertSame(EquipmentSlot.MAINHAND, equipment.getFirst().getFirst());
+        assertSame(copied, equipment.getFirst().getSecond());
+    }
+
+    @Test
+    void pairingDataKeepsLazyAndPaperEquipmentListPaths() throws IOException {
+        final List<MethodInsnNode> calls = invocations(methodNode("sendPairingData"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("entitySyncEquipmentListsOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("collectEquipmentForPairing")));
+        final List<MethodInsnNode> helperCalls = invocations(methodNode("collectEquipmentForPairing"));
+        assertTrue(helperCalls.stream().anyMatch(call -> call.owner.equals("com/google/common/collect/Lists")
+            && call.name.equals("newArrayList")));
+        assertTrue(helperCalls.stream().anyMatch(call -> call.owner.equals("java/util/ArrayList")
+            && call.name.equals("<init>") && call.desc.equals("(I)V")));
+        assertTrue(helperCalls.stream().anyMatch(call -> call.owner.equals("net/minecraft/world/item/ItemStack")
+            && call.name.equals("copy")));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Pair<EquipmentSlot, ItemStack>> collectEquipment(
+        final LivingEntity entity,
+        final boolean optimize
+    ) throws ReflectiveOperationException {
+        final Method method = ServerEntity.class.getDeclaredMethod("collectEquipmentForPairing", LivingEntity.class, boolean.class);
+        method.setAccessible(true);
+        return (List<Pair<EquipmentSlot, ItemStack>>)method.invoke(null, entity, optimize);
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static MethodNode methodNode(final String methodName) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(ServerEntity.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing ServerEntity#" + methodName));
+    }
+}
