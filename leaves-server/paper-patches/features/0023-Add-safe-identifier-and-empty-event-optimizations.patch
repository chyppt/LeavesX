diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
index 64617aa075c3482c0058bbd5c78eaec07a313a75..3ed89e9a92929c26690327ecb8fb7abada292cf7 100644
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
@@ -67,6 +67,12 @@ public final class LeavesXConfigWriter {
         node.node("performance", "immutable-cache-optimizations")
             .comment(COMMENTS.get("performance.immutable-cache-optimizations"))
             .raw(config.immutableCacheOptimizations());
+        node.node("performance", "resource-identifier-cache")
+            .comment(COMMENTS.get("performance.resource-identifier-cache"))
+            .raw(config.resourceIdentifierCache());
+        node.node("performance", "skip-empty-events")
+            .comment(COMMENTS.get("performance.skip-empty-events"))
+            .raw(config.skipEmptyEvents());
     }
 
     /** Returns the same path-keyed comments used for emitted {@code leavesx.yml} files. */
@@ -100,6 +106,8 @@ public final class LeavesXConfigWriter {
         comments.put("determinism.preserve-vanilla-rng", "用途：保持原版 RNG 类型、种子和消耗顺序。默认值：true。兼容性：保护原版及生电行为，不允许关闭。实现状态：已强制校验。");
         comments.put("performance.optimized-varint", "用途：使用等价的定长分支写入 VarInt/VarLong，并缓存 VarLong 字节长度。默认值：true。兼容性：输出字节与原版完全一致，不改变协议或游戏逻辑。实现状态：已实现，可关闭回退原始循环。");
         comments.put("performance.immutable-cache-optimizations", "用途：缓存不可变碰撞形状键的 identity 哈希，减少重复计算。默认值：true。兼容性：只优化纯查询，不改变碰撞结果、顺序或 Bukkit API。实现状态：已实现，可关闭回退按需计算。");
+        comments.put("performance.resource-identifier-cache", "用途：缓存不可变 Minecraft 资源标识符的字符串和哈希值，减少注册表、标签和数据包热点中的重复分配与计算。默认值：true。兼容性：返回字符串、哈希值和相等性与原版完全一致。实现状态：已实现，可关闭回退原始按需计算。");
+        comments.put("performance.skip-empty-events", "用途：当对应 HandlerList 没有任何插件监听器时，跳过 GenericGameEvent 和自然刷怪 PreCreatureSpawnEvent 的对象创建与分发。默认值：true。兼容性：注册任意监听器后完整执行原始事件路径，不改变刷怪判定、RNG 或事件顺序。实现状态：已实现，可关闭强制执行原始事件路径。");
         return Map.copyOf(comments);
     }
 }
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java b/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
index b9cc5c7124eee09ca74fa95dee8770413f19c2b9..f37936d03068e28146099e0785abff002f320001 100644
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
@@ -13,6 +13,9 @@ public final class LeavesXRuntime {
     private static volatile LeavesXConfig configuration = LeavesXConfig.safeDefaults();
     private static volatile boolean optimizedVarInt = true;
     private static volatile boolean immutableCacheOptimizations = true;
+    // Published during bootstrap before scheduler workers start; these hot-path flags are not reloadable.
+    private static boolean resourceIdentifierCache = true;
+    private static boolean skipEmptyEvents = true;
 
     private LeavesXRuntime() {
     }
@@ -35,6 +38,8 @@ public final class LeavesXRuntime {
         final LeavesXConfig validated = Objects.requireNonNull(next, "next");
         optimizedVarInt = validated.optimizedVarInt();
         immutableCacheOptimizations = validated.immutableCacheOptimizations();
+        resourceIdentifierCache = validated.resourceIdentifierCache();
+        skipEmptyEvents = validated.skipEmptyEvents();
         configuration = validated;
     }
 
@@ -58,4 +63,14 @@ public final class LeavesXRuntime {
     public static boolean immutableCacheOptimizations() {
         return immutableCacheOptimizations;
     }
+
+    /** Returns whether immutable Minecraft identifiers cache their string and hash representations. */
+    public static boolean resourceIdentifierCache() {
+        return resourceIdentifierCache;
+    }
+
+    /** Returns whether event allocation may be skipped when the corresponding handler list is empty. */
+    public static boolean skipEmptyEvents() {
+        return skipEmptyEvents;
+    }
 }
