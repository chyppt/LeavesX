diff --git a/src/test/java/org/leavesx/leavesx/performance/ResourceIdentifierCacheTest.java b/src/test/java/org/leavesx/leavesx/performance/ResourceIdentifierCacheTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..11ef8aec76e17ad6052db2e90f43ccf2cb2e44fa
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ResourceIdentifierCacheTest.java
@@ -0,0 +1,46 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import net.minecraft.resources.Identifier;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/** Verifies that identifier caching preserves the vanilla string and hash contracts. */
+@Normal
+class ResourceIdentifierCacheTest {
+
+    @Test
+    void cachesStringRepresentationWithoutChangingContent() {
+        final Identifier identifier = Identifier.fromNamespaceAndPath("leavesx", "performance/cache_test");
+
+        final String first = identifier.toString();
+        final String second = identifier.toString();
+
+        assertEquals("leavesx:performance/cache_test", first);
+        assertSame(first, second, "Enabled identifier caching must reuse the immutable String instance");
+    }
+
+    @Test
+    void preservesVanillaHashFormulaAndEquality() {
+        final String[][] values = {
+            {"minecraft", "stone"},
+            {"leavesx", "performance/cache_test"},
+            {"custom_namespace", "deep/path.with-dots"}
+        };
+
+        for (final String[] value : values) {
+            final Identifier first = Identifier.fromNamespaceAndPath(value[0], value[1]);
+            final Identifier equal = Identifier.fromNamespaceAndPath(value[0], value[1]);
+            final int vanillaHash = 31 * value[0].hashCode() + value[1].hashCode();
+
+            assertEquals(vanillaHash, first.hashCode());
+            assertEquals(vanillaHash, first.hashCode(), "Repeated cached hashes must remain stable");
+            assertEquals(first, equal);
+            assertEquals(first.hashCode(), equal.hashCode());
+            assertNotSame(first.toString(), equal.toString(), "Caches remain owned by each immutable identifier");
+        }
+    }
+}
