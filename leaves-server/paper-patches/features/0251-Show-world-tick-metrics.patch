+    private static void sendWorldTickSummary(final CommandSender sender) {
+        if (!LeavesXWorldTickMetrics.displayWorldMetrics()) return;
+        sender.sendMessage(Component.text("世界 TPS / MSPT（最近 100 次世界 Tick；总体见上方）", NamedTextColor.GOLD));
+        for (final World world : Bukkit.getWorlds()) {
+            final LeavesXWorldTickMetrics.Snapshot snapshot = LeavesXWorldTickMetrics.snapshot(((CraftWorld) world).getHandle());
+            if (snapshot.available()) {
+                sender.sendMessage(Component.text("  " + world.getKey() + "：TPS "
+                    + oneDecimal(snapshot.tps()) + " / MSPT " + oneDecimal(snapshot.mspt()) + " ms", NamedTextColor.GRAY));
+            } else {
+                sender.sendMessage(Component.text("  " + world.getKey() + "：正在收集样本", NamedTextColor.GRAY));
+            }
+        }
+    }
