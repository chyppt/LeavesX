index 0000000000000000000000000000000000000000..acda2c5fe3252618d33519cad8483d17ee3e18a7
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/SortedIndexListCompactor.java
@@ -0,0 +1,41 @@
+package org.leavesx.leavesx.performance;
+
+import it.unimi.dsi.fastutil.ints.IntList;
+import java.util.List;
+
+/** Removes entries from a random-access list using sorted indexes while preserving survivor order. */
+public final class SortedIndexListCompactor {
+
+    private SortedIndexListCompactor() {
+    }
+
+    /**
+     * Removes the supplied indexes with one stable in-place compaction pass.
+     *
+     * <p>The indexes must be unique, strictly increasing, and valid for the list at method entry. Callers that collect
+     * indexes during an indexed forward scan already satisfy this contract without sorting or allocating a set.</p>
+     */
+    public static <T> void removeSortedIndices(final List<T> list, final IntList sortedIndices) {
+        final int removalCount = sortedIndices.size();
+        if (removalCount == 0) {
+            return;
+        }
+
+        final int originalSize = list.size();
+        final int firstRemovedIndex = sortedIndices.getInt(0);
+        int writeIndex = firstRemovedIndex;
+        int removalCursor = 1;
+        int nextRemovedIndex = removalCursor < removalCount ? sortedIndices.getInt(removalCursor) : originalSize;
+
+        for (int readIndex = firstRemovedIndex + 1; readIndex < originalSize; readIndex++) {
+            if (readIndex == nextRemovedIndex) {
+                removalCursor++;
+                nextRemovedIndex = removalCursor < removalCount ? sortedIndices.getInt(removalCursor) : originalSize;
+                continue;
+            }
+            list.set(writeIndex++, list.get(readIndex));
+        }
+
+        list.subList(writeIndex, originalSize).clear();
+    }
+}
