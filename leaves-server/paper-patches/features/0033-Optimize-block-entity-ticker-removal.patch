diff --git a/src/test/java/org/leavesx/leavesx/performance/SortedIndexListCompactorTest.java b/src/test/java/org/leavesx/leavesx/performance/SortedIndexListCompactorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ec885ddf407ed5341c87824e96b919cc7baff59d
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/SortedIndexListCompactorTest.java
@@ -0,0 +1,42 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import it.unimi.dsi.fastutil.ints.IntArrayList;
+import java.util.ArrayList;
+import java.util.List;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class SortedIndexListCompactorTest {
+
+    @Test
+    void removesSparseEntriesWithoutChangingSurvivorOrder() {
+        final List<String> values = new ArrayList<>(List.of("a", "b", "c", "d", "e", "f"));
+
+        SortedIndexListCompactor.removeSortedIndices(values, IntArrayList.of(1, 3, 5));
+
+        assertEquals(List.of("a", "c", "e"), values);
+    }
+
+    @Test
+    void removesLeadingTrailingAndAllEntries() {
+        final List<Integer> edgeValues = new ArrayList<>(List.of(0, 1, 2, 3));
+        SortedIndexListCompactor.removeSortedIndices(edgeValues, IntArrayList.of(0, 3));
+        assertEquals(List.of(1, 2), edgeValues);
+
+        final List<Integer> allValues = new ArrayList<>(List.of(0, 1, 2));
+        SortedIndexListCompactor.removeSortedIndices(allValues, IntArrayList.of(0, 1, 2));
+        assertEquals(List.of(), allValues);
+    }
+
+    @Test
+    void leavesListUntouchedWhenNoIndexesAreMarked() {
+        final List<String> values = new ArrayList<>(List.of("a", "b"));
+
+        SortedIndexListCompactor.removeSortedIndices(values, IntArrayList.of());
+
+        assertEquals(List.of("a", "b"), values);
+    }
+}
