+/** Verifies zombified-piglin alerts preserve vanilla filtering, traversal, and target-read semantics. */
+@Normal
+class ZombifiedPiglinAlertHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void optimizedAlertReadsTheSourceTargetAtBothOriginalCallSites() throws ReflectiveOperationException {
+        final ZombifiedPiglin source = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin candidate = mock(ZombifiedPiglin.class);
+        final LivingEntity targetDuringAllianceCheck = mock(LivingEntity.class);
+        final LivingEntity targetDuringBukkitEvent = mock(LivingEntity.class);
+
+        when(candidate.getTarget()).thenReturn(null);
+        when(source.getTarget()).thenReturn(targetDuringAllianceCheck, targetDuringBukkitEvent);
+        when(candidate.isAlliedTo(targetDuringAllianceCheck)).thenReturn(false);
+        clearInvocations(source, candidate);
+
+        invokeAlert(source, List.of(source, candidate));
+
+        final InOrder callOrder = inOrder(candidate, source);
+        callOrder.verify(candidate).getTarget();
+        callOrder.verify(source).getTarget();
+        callOrder.verify(candidate).isAlliedTo(targetDuringAllianceCheck);
+        callOrder.verify(source).getTarget();
+        callOrder.verify(candidate).setTarget(targetDuringBukkitEvent, TargetReason.TARGET_ATTACKED_NEARBY_ENTITY);
+        verify(source, never()).setTarget(any(), any());
+    }
+
+    @Test
+    void optimizedAlertPreservesFilteringAndNearbyEntityOrder() throws ReflectiveOperationException {
+        final ZombifiedPiglin source = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin alreadyTargeting = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin allied = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin first = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin second = mock(ZombifiedPiglin.class);
+        final LivingEntity target = mock(LivingEntity.class);
+
+        when(source.getTarget()).thenReturn(target);
+        when(alreadyTargeting.getTarget()).thenReturn(mock(LivingEntity.class));
+        when(allied.getTarget()).thenReturn(null);
+        when(allied.isAlliedTo(target)).thenReturn(true);
+        when(first.getTarget()).thenReturn(null);
+        when(first.isAlliedTo(target)).thenReturn(false);
+        when(second.getTarget()).thenReturn(null);
+        when(second.isAlliedTo(target)).thenReturn(false);
+        clearInvocations(source, alreadyTargeting, allied, first, second);
+
+        invokeAlert(source, List.of(source, alreadyTargeting, allied, first, second));
+
+        final InOrder targetOrder = inOrder(first, second);
+        targetOrder.verify(first).setTarget(target, TargetReason.TARGET_ATTACKED_NEARBY_ENTITY);
+        targetOrder.verify(second).setTarget(target, TargetReason.TARGET_ATTACKED_NEARBY_ENTITY);
+        verify(source, never()).setTarget(any(), any());
+        verify(alreadyTargeting, never()).setTarget(any(), any());
+        verify(allied, never()).setTarget(any(), any());
