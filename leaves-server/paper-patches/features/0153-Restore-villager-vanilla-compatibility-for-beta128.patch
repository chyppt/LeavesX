@@ -0,0 +1,89 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/** Verifies that a vanilla-compatibility villager tick disables every relevant LeavesX fast path. */
+@Normal
+class VillagerCompatibilityContextTest {
+
+    @Test
+    void compatibilityContextDisablesVillagerFastPaths() {
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        final boolean previous = LeavesXRuntime.enterVillagerCompatibilityContext();
+        try {
+            assertFalse(LeavesXRuntime.aiOptimizations());
+            assertFalse(LeavesXRuntime.entityQueryOptimizations());
+            assertFalse(LeavesXRuntime.entityStateOptimizations());
+            assertFalse(LeavesXRuntime.pathfindingOptimizations());
+            assertFalse(LeavesXRuntime.villagerHostileSensorOptimization());
+            assertFalse(LeavesXRuntime.brainBehaviorSchedulingOptimization());
+            assertFalse(LeavesXRuntime.targetingRangeChecksOptimization());
+            assertFalse(LeavesXRuntime.nearestEntityDistanceSortOptimization());
+            assertFalse(LeavesXRuntime.parallelAiTargetSearch());
+            assertFalse(LeavesXRuntime.pathNodeListBuildingOptimization());
+            assertFalse(LeavesXRuntime.stationaryEntitySpeedOptimization());
+        } finally {
+            LeavesXRuntime.exitVillagerCompatibilityContext(previous);
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void disabledCompatibilityModeLeavesFastPathsAvailable() {
+        final LeavesXConfig config = new LeavesXConfig(
+            LeavesXConfig.CURRENT_CONFIG_VERSION,
+            true,
+            10,
+            60,
+            2,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            true,
+            false,
+            2,
+            true,
+            262_144,
+            true,
+            0,
+            64,
+            524_288,
+            true,
+            true,
+            true,
+            true,
+            true,
+            1_000,
+            100,
+            500,
+            LeavesXOptimization.allEnabledMaskLow(),
+            LeavesXOptimization.allEnabledMaskHigh(),
+            false
+        );
+
+        LeavesXRuntime.publish(config);
+        final boolean previous = LeavesXRuntime.enterVillagerCompatibilityContext();
+        try {
+            assertTrue(LeavesXRuntime.aiOptimizations());
+            assertTrue(LeavesXRuntime.entityQueryOptimizations());
+            assertTrue(LeavesXRuntime.entityStateOptimizations());
+            assertTrue(LeavesXRuntime.pathfindingOptimizations());
+        } finally {
+            LeavesXRuntime.exitVillagerCompatibilityContext(previous);
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+}
