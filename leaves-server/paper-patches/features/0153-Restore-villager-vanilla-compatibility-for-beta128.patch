+    }
+
+    /** Enters the per-thread vanilla compatibility context used while a villager is ticking. */
+    public static boolean enterVillagerCompatibilityContext() {
+        final boolean previous = villagerCompatibilityContextActive();
+        if (villagerCompatibilityMode) {
+            VILLAGER_COMPATIBILITY_CONTEXT.set(true);
+        }
+        return previous;
+    }
+
+    /** Restores the previous per-thread optimization context after a villager tick. */
+    public static void exitVillagerCompatibilityContext(final boolean previous) {
+        if (previous) {
+            VILLAGER_COMPATIBILITY_CONTEXT.set(true);
+        } else {
+            VILLAGER_COMPATIBILITY_CONTEXT.remove();
+        }
+    }
+
+    private static boolean villagerCompatibilityContextActive() {
