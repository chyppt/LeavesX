diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadBudgetTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadBudgetTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c0a6c5e5d5d6c15a9d99619f4dc34f6279f38b93
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadBudgetTest.java
@@ -0,0 +1,31 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class ChunkUnloadBudgetTest {
+
+    @Test
+    void preservesPaperBaselineBelowBacklogThreshold() {
+        assertEquals(50, ChunkUnloadBudget.calculate(900, 50, 0.05, true, 1_000, 100, 500));
+    }
+
+    @Test
+    void raisesBudgetGraduallyAndCapsLargeBacklogs() {
+        assertEquals(150, ChunkUnloadBudget.calculate(2_000, 100, 0.05, true, 1_000, 100, 500));
+        assertEquals(500, ChunkUnloadBudget.calculate(20_000, 1_000, 0.05, true, 1_000, 100, 500));
+    }
+
+    @Test
+    void preservesBaselineWhenAdaptivePolicyIsDisabled() {
+        assertEquals(1_000, ChunkUnloadBudget.calculate(20_000, 1_000, 0.05, false, 1_000, 100, 500));
+    }
+
+    @Test
+    void neverSchedulesMoreChunksThanRemainQueued() {
+        assertEquals(12, ChunkUnloadBudget.calculate(12, 50, 0.05, true, 1_000, 100, 500));
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadQueueTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadQueueTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a569719b35a8feaf9c469631f9e98d4c34ddc788
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkUnloadQueueTest.java
@@ -0,0 +1,47 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.queue.ChunkUnloadQueue;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class ChunkUnloadQueueTest {
+
+    @Test
+    void tracksDuplicateAddsIndividualRemovesAndPartialDrainsExactly() {
+        final ChunkUnloadQueue queue = new ChunkUnloadQueue(2);
+
+        assertTrue(queue.addChunk(0, 0));
+        assertFalse(queue.addChunk(0, 0));
+        assertTrue(queue.addChunk(1, 1));
+        assertEquals(2L, queue.pendingChunkCount());
+
+        assertFalse(queue.removeChunk(2, 2));
+        assertTrue(queue.removeChunk(0, 0));
+        assertEquals(1L, queue.pendingChunkCount());
+
+        final ChunkUnloadQueue.UnloadSection section = queue.getSectionUnsynchronized(0, 0);
+        assertEquals(net.minecraft.world.level.ChunkPos.pack(1, 1), queue.removeFirstChunk(0, 0, section));
+        assertEquals(0L, queue.pendingChunkCount());
+        assertNull(queue.getSectionUnsynchronized(0, 0));
+    }
+
+    @Test
+    void removingAWholeSectionSubtractsEveryQueuedChunkOnce() {
+        final ChunkUnloadQueue queue = new ChunkUnloadQueue(2);
+        queue.addChunk(0, 0);
+        queue.addChunk(1, 0);
+        queue.addChunk(8, 8);
+
+        assertEquals(3L, queue.pendingChunkCount());
+        queue.removeSection(0, 0);
+        assertEquals(1L, queue.pendingChunkCount());
+        queue.removeSection(0, 0);
+        assertEquals(1L, queue.pendingChunkCount());
+    }
+}
