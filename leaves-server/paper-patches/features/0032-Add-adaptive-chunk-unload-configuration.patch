diff --git a/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java b/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java
new file mode 100644
index 0000000000000000000000000000000000000000..fdc0afb73a331e3abdf6cddfdb0dcacf68a6187a
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java
@@ -0,0 +1,50 @@
+package org.leavesx.leavesx.performance;
+
+/** Calculates a bounded chunk-unload budget from an exact queue backlog. */
+public final class ChunkUnloadBudget {
+
+    private ChunkUnloadBudget() {
+    }
+
+    /**
+     * Returns the number of queued chunks to process during the current world tick.
+     *
+     * <p>Below the configured threshold the Paper baseline is retained. Above it, pressure grows using the same
+     * fraction as the baseline queue policy and is capped so unload recovery cannot monopolize the main thread.</p>
+     */
+    public static int calculate(
+        final long pendingChunkCount,
+        final int baseUnloadCount,
+        final double unloadFraction,
+        final boolean adaptive,
+        final int backlogThreshold,
+        final int minimumPerTick,
+        final int maximumPerTick
+    ) {
+        if (pendingChunkCount <= 0L) {
+            return 0;
+        }
+
+        final long boundedBase = Math.max(1, baseUnloadCount);
+        if (!adaptive) {
+            return (int)Math.min(Integer.MAX_VALUE, Math.min(pendingChunkCount, boundedBase));
+        }
+
+        final long threshold = Math.max(1L, backlogThreshold);
+        if (pendingChunkCount <= threshold) {
+            return (int)Math.min(Integer.MAX_VALUE, Math.min(pendingChunkCount, boundedBase));
+        }
+
+        final int minimum = Math.max(1, minimumPerTick);
+        final int maximum = Math.max(minimum, maximumPerTick);
+        final double fraction = Math.clamp(unloadFraction, 0.0, 1.0);
+        final long availableIncrease = (long)maximum - minimum;
+        final long pressure = Math.min(
+            availableIncrease,
+            (long)Math.ceil((pendingChunkCount - threshold) * fraction)
+        );
+        final long target = Math.max(boundedBase, minimum + pressure);
+
+        return (int)Math.min(pendingChunkCount, Math.min((long)maximum, target));
+    }
+}
