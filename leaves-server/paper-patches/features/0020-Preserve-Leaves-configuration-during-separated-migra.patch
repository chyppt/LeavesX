+    void preservesUnknownKeysQuotingInlineCommentsAndCrLfLineEndings() throws Exception {
+        final String original = "# User header\r\n"
+            + "config-version: 6 # Keep inline version note\r\n"
+            + "settings:\r\n"
+            + "  modify:\r\n"
+            + "    fakeplayer:\r\n"
+            + "      enable: false # Keep inline setting note\r\n"
+            + "  unknown-extension:\r\n"
