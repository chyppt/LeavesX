+    /** Serializes a fully documented LeavesX configuration without relying on Configurate node-comment output. */
+    public static String render(final LeavesXConfig config, final String header) throws ConfigurateException {
+        final CommentedConfigurationNode node = CommentedConfigurationNode.root();
+        write(node, config);
+        final String yaml = ConfigurationLoaders.naturallySorted()
+            .headerMode(HeaderMode.NONE)
+            .buildAndSaveString(node);
+        return YamlCommentInjector.injectGenerated(yaml, header, COMMENTS).text();
+    }
