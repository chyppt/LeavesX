diff --git a/src/main/java/org/leavesx/leavesx/config/YamlCommentInjector.java b/src/main/java/org/leavesx/leavesx/config/YamlCommentInjector.java
new file mode 100644
index 0000000000000000000000000000000000000000..0104eba934287c6b70262f04a7ee846f0558ae4f
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/YamlCommentInjector.java
@@ -0,0 +1,229 @@
+package org.leavesx.leavesx.config;
+
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import org.yaml.snakeyaml.DumperOptions;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.comments.CommentLine;
+import org.yaml.snakeyaml.nodes.AnchorNode;
+import org.yaml.snakeyaml.nodes.MappingNode;
+import org.yaml.snakeyaml.nodes.Node;
+import org.yaml.snakeyaml.nodes.NodeTuple;
+import org.yaml.snakeyaml.nodes.ScalarNode;
+
+/**
+ * Inserts path-keyed comments into block-style YAML without reserializing user data.
+ *
+ * <p>SnakeYAML is used only to locate mapping keys and inspect existing comments. The original text is retained
+ * byte-for-byte apart from inserted UTF-8 comment lines, so key order, quoting, unknown fields, inline comments and
+ * line endings remain under user control.</p>
+ */
+public final class YamlCommentInjector {
+
+    private YamlCommentInjector() {
+    }
+
+    public static Result inject(final String yamlText, final Map<String, String> comments) {
+        Objects.requireNonNull(yamlText, "yamlText");
+        Objects.requireNonNull(comments, "comments");
+
+        final boolean hasByteOrderMark = hasByteOrderMark(yamlText);
+        final String yamlBody = hasByteOrderMark ? yamlText.substring(1) : yamlText;
+        final LoaderOptions options = new LoaderOptions().setProcessComments(true);
+        options.setCodePointLimit(Math.max(options.getCodePointLimit(), yamlBody.length() + 1));
+        final Node root = new Yaml(options).compose(new StringReader(yamlBody));
+        if (root == null) {
+            return new Result(yamlText, 0);
+        }
+
+        final Map<Integer, List<Insertion>> insertions = new HashMap<>();
+        final Counter documentedKeys = new Counter();
+        collectInsertions(unwrap(root), "", comments, insertions, documentedKeys);
+        if (insertions.isEmpty()) {
+            return new Result(yamlText, documentedKeys.value);
+        }
+
+        final String lineSeparator = detectLineSeparator(yamlBody);
+        final List<String> sourceLines = splitLinesPreservingSeparators(yamlBody);
+        final StringBuilder output = new StringBuilder(yamlText.length() + documentedKeys.value * 96);
+        if (hasByteOrderMark) {
+            output.append('\uFEFF');
+        }
+        for (int line = 0; line < sourceLines.size(); line++) {
+            final List<Insertion> lineInsertions = insertions.get(line);
+            if (lineInsertions != null) {
+                for (final Insertion insertion : lineInsertions) {
+                    appendComment(output, insertion.indent(), insertion.description(), lineSeparator);
+                }
+            }
+            output.append(sourceLines.get(line));
+        }
+        return new Result(output.toString(), documentedKeys.value);
+    }
+
+    /** Prefixes a generated YAML document with a header before inserting path-keyed comments. */
+    public static Result injectGenerated(
+        final String yamlText,
+        final String header,
+        final Map<String, String> comments
+    ) {
+        Objects.requireNonNull(header, "header");
+        final boolean hasByteOrderMark = hasByteOrderMark(yamlText);
+        final String yamlBody = hasByteOrderMark ? yamlText.substring(1) : yamlText;
+        final String lineSeparator = detectLineSeparator(yamlBody);
+        final StringBuilder prefixed = new StringBuilder(header.length() + yamlText.length() + 8);
+        if (hasByteOrderMark) {
+            prefixed.append('\uFEFF');
+        }
+        appendComment(prefixed, 0, header, lineSeparator);
+        prefixed.append(lineSeparator).append(yamlBody);
+        return inject(prefixed.toString(), comments);
+    }
+
+    private static boolean hasByteOrderMark(final String text) {
+        return !text.isEmpty() && text.charAt(0) == '\uFEFF';
+    }
+
+    private static void collectInsertions(
+        final Node candidate,
+        final String parentPath,
+        final Map<String, String> comments,
+        final Map<Integer, List<Insertion>> insertions,
+        final Counter documentedKeys
+    ) {
+        final Node node = unwrap(candidate);
+        if (!(node instanceof MappingNode mapping) || mapping.getFlowStyle() == DumperOptions.FlowStyle.FLOW) {
+            return;
+        }
+
+        for (final NodeTuple tuple : mapping.getValue()) {
+            final Node keyNode = unwrap(tuple.getKeyNode());
+            if (!(keyNode instanceof ScalarNode scalarKey)) {
+                continue;
+            }
+            final String key = scalarKey.getValue();
+            final String path = parentPath.isEmpty() ? key : parentPath + '.' + key;
+            final String description = comments.get(path);
+            if (description != null && !description.isBlank()) {
+                documentedKeys.value++;
+                if (!containsEquivalentComment(tuple, description)) {
+                    final int line = scalarKey.getStartMark().getLine();
+                    final int indent = scalarKey.getStartMark().getColumn();
+                    insertions.computeIfAbsent(line, ignored -> new ArrayList<>(1))
+                        .add(new Insertion(indent, description));
+                }
+            }
+            collectInsertions(tuple.getValueNode(), path, comments, insertions, documentedKeys);
+        }
+    }
+
+    private static boolean containsEquivalentComment(final NodeTuple tuple, final String description) {
+        final List<String> existingLines = new ArrayList<>();
+        collectCommentLines(tuple.getKeyNode(), existingLines);
+        collectCommentLines(tuple.getValueNode(), existingLines);
+        if (existingLines.isEmpty()) {
+            return false;
+        }
+
+        for (final String requiredLine : description.lines().map(String::trim).filter(line -> !line.isEmpty()).toList()) {
+            if (!existingLines.contains(requiredLine)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static void collectCommentLines(final Node candidate, final List<String> destination) {
+        final Node node = unwrap(candidate);
+        addComments(node.getBlockComments(), destination);
+        addComments(node.getInLineComments(), destination);
+        addComments(node.getEndComments(), destination);
+    }
+
+    private static void addComments(final List<CommentLine> comments, final List<String> destination) {
+        if (comments == null) {
+            return;
+        }
+        for (final CommentLine comment : comments) {
+            final String value = comment.getValue().trim();
+            if (!value.isEmpty()) {
+                destination.add(value);
+            }
+        }
+    }
+
+    private static Node unwrap(final Node node) {
+        Node current = node;
+        while (current instanceof AnchorNode anchor) {
+            current = anchor.getRealNode();
+        }
+        return current;
+    }
+
+    private static void appendComment(
+        final StringBuilder output,
+        final int indent,
+        final String description,
+        final String lineSeparator
+    ) {
+        final String prefix = " ".repeat(indent);
+        for (final String line : description.split("\\R", -1)) {
+            output.append(prefix).append('#');
+            if (!line.isBlank()) {
+                output.append(' ').append(line.strip());
+            }
+            output.append(lineSeparator);
+        }
+    }
+
+    private static List<String> splitLinesPreservingSeparators(final String text) {
+        final List<String> lines = new ArrayList<>();
+        int lineStart = 0;
+        for (int index = 0; index < text.length(); index++) {
+            final char character = text.charAt(index);
+            if (character == '\r') {
+                if (index + 1 < text.length() && text.charAt(index + 1) == '\n') {
+                    index++;
+                }
+                lines.add(text.substring(lineStart, index + 1));
+                lineStart = index + 1;
+            } else if (character == '\n') {
+                lines.add(text.substring(lineStart, index + 1));
+                lineStart = index + 1;
+            }
+        }
+        if (lineStart < text.length() || text.isEmpty()) {
+            lines.add(text.substring(lineStart));
+        }
+        return lines;
+    }
+
+    private static String detectLineSeparator(final String text) {
+        for (int index = 0; index < text.length(); index++) {
+            final char character = text.charAt(index);
+            if (character == '\r') {
+                return index + 1 < text.length() && text.charAt(index + 1) == '\n' ? "\r\n" : "\r";
+            }
+            if (character == '\n') {
+                return "\n";
+            }
+        }
+        return System.lineSeparator();
+    }
+
+    public record Result(String text, int documentedKeys) {
+    }
+
+    private record Insertion(int indent, String description) {
+    }
+
+    private static final class Counter {
+
+        private int value;
+    }
+}
