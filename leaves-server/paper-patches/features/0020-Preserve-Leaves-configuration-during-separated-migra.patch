index 0000000000000000000000000000000000000000..3674a2eec7e44c3b5ab06dac1a87847381d49ce2
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigCommentCatalog.java
@@ -0,0 +1,111 @@
+package org.leavesx.leavesx.config.migration;
+
+import io.papermc.paper.configuration.ConfigurationLoaders;
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.Map;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+/**
+ * Adds verified Leaves configuration descriptions without changing configuration values.
+ *
+ * <p>The catalog is intentionally keyed by the complete YAML path. Unknown keys are left untouched, while known
+ * Leaves 26.1.2 keys receive text derived from the official simplified-Chinese configuration reference. Keeping the
+ * catalog in code makes startup deterministic and avoids network access while the server is booting.</p>
+ */
+final class LeavesConfigCommentCatalog {
+
+    static final String DOCUMENTATION_COMMIT = "43404de621bb648ae7bc7557ed9fa5e0986ec3c7";
+    static final String DOCUMENTATION_URL = "https://docs.leavesmc.org/zh_Hans/leaves/reference/configuration";
+
+    private static final String DOCUMENTATION_RESOURCE =
+        "/leavesx/leaves-26.1.2-configuration-zh_Hans.yml.b64";
+
+    private static final Map<String, String> COMMENTS = loadOfficialComments();
+
+    static {
+        if (!COMMENTS.containsKey("settings.modify.fakeplayer.enable") || COMMENTS.size() < 100) {
+            throw new ExceptionInInitializerError("Bundled Leaves 26.1.2 documentation catalog is incomplete");
+        }
+    }
+
+    private LeavesConfigCommentCatalog() {
+    }
+
+    static Map<String, String> comments() {
+        return COMMENTS;
+    }
+
+    /**
+     * Reads the complete official catalog bundled with LeavesX.
+     *
+     * <p>The resource is base64 encoded only so its MPL-2.0 source document remains byte-for-byte auditable while
+     * avoiding YAML resource filtering. Missing or incomplete resources are rejected so migration can never emit
+     * partial or unverified documentation.</p>
+     */
+    private static Map<String, String> loadOfficialComments() {
+        try (InputStream encoded = LeavesConfigCommentCatalog.class.getResourceAsStream(DOCUMENTATION_RESOURCE)) {
+            if (encoded == null) {
+                throw new IllegalStateException("Missing Leaves documentation resource " + DOCUMENTATION_RESOURCE);
+            }
+            try (
+                InputStream decoded = Base64.getMimeDecoder().wrap(encoded);
+                Reader reader = new InputStreamReader(decoded, StandardCharsets.UTF_8);
+                BufferedReader bufferedReader = new BufferedReader(reader)
+            ) {
+                final YamlConfigurationLoader loader = ConfigurationLoaders.naturallySorted()
+                    .source(() -> bufferedReader)
+                    .build();
+                final ConfigurationNode documentation = loader.load();
+                final HashMap<String, String> comments = new HashMap<>(256);
+                collectOfficialDescriptions(documentation, "", comments);
+                if (!comments.isEmpty()) {
+                    return Map.copyOf(comments);
+                }
+            }
+        } catch (final IOException ex) {
+            throw new IllegalStateException("Unable to load the bundled Leaves documentation catalog", ex);
+        }
+        throw new IllegalStateException("Bundled Leaves documentation catalog did not contain any descriptions");
+    }
+
+    private static void collectOfficialDescriptions(
+        final ConfigurationNode node,
+        final String path,
+        final Map<String, String> comments
+    ) {
+        if (!path.isEmpty()) {
+            final String description = node.node("description").getString();
+            if (description != null && !description.isBlank()) {
+                comments.put(path, normalizeOfficialDescription(description));
+                return;
+            }
+        }
+        for (final Map.Entry<Object, ? extends ConfigurationNode> child : node.childrenMap().entrySet()) {
+            final String key = child.getKey().toString();
+            if (key.equals("default") || key.equals("description")) {
+                continue;
+            }
+            collectOfficialDescriptions(child.getValue(), path.isEmpty() ? key : path + '.' + key, comments);
+        }
+    }
+
+    private static String normalizeOfficialDescription(final String description) {
+        return description
+            .replaceAll("(?s)```.*?```", "")
+            .replaceAll("(?m)^\\s*:::[^\\n]*$", "")
+            .replaceAll("\\[([^]]+)]\\([^)]+\\)", "$1")
+            .replace("**", "")
+            .replace('`', '\'')
+            .replaceAll("(?m)^[ \\t]+", "")
+            .replaceAll("\\n{3,}", "\\n\\n")
+            .trim();
+    }
+}
