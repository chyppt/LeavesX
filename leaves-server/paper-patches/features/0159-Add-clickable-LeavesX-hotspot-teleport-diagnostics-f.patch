+    /** Adds an operator-only click action without loading a chunk or changing the diagnostic scan itself. */
+    static Component teleportablePosition(
+        final String text,
+        final NamedTextColor color,
+        final String world,
+        final int blockX,
+        final int blockY,
+        final int blockZ
+    ) {
+        final String command = "/minecraft:execute as @s in " + world + " run minecraft:tp @s "
+            + (blockX + 0.5D) + ' ' + blockY + ' ' + (blockZ + 0.5D);
+        return Component.text(text, color)
+            .hoverEvent(HoverEvent.showText(Component.text("点击传送到该位置（需要管理员命令权限）", NamedTextColor.GREEN)))
+            .clickEvent(ClickEvent.runCommand(command));
+    }
+
     private static String formatTps(final double[] tps) {
         return oneDecimal(Math.min(20.0D, tps[0])) + " / " + oneDecimal(Math.min(20.0D, tps[1])) + " / "
             + oneDecimal(Math.min(20.0D, tps[2]));
