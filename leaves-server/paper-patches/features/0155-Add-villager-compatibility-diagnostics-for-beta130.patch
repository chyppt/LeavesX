+    @Test
+    void villagerDiagnosticIsRegisteredAndCannotWriteBrainMemory() throws IOException, ReflectiveOperationException {
+        final Field subcommandsField = LeavesXCommand.class.getDeclaredField("SUBCOMMANDS");
