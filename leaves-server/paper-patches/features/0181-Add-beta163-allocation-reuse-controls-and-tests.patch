+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.Objects;
+import java.util.Random;
+import net.minecraft.server.level.TicketType;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Verifies the zero-allocation TicketType hash remains exactly compatible with Objects.hash. */
+@Normal
+class TicketTypeHashCodeHotPathTest {
+
+    @Test
+    void primitiveHashMatchesObjectsHashForDeterministicValues() {
+        final Random random = new Random(0x4C585469636B6574L);
+        for (int index = 0; index < 8_192; index++) {
+            final long timeout = random.nextLong();
+            final int flags = random.nextInt();
+            final TicketType<Object> type = new TicketType<>(timeout, flags);
+            assertEquals(Objects.hash(timeout, flags), type.hashCode(), "hash changed at case " + index);
+        }
+    }
+
+    @Test
+    void timeoutMutationUpdatesTheHashContract() {
+        final TicketType<Object> type = new TicketType<>(10L, 7);
+        assertEquals(Objects.hash(10L, 7), type.hashCode());
+        type.moonrise$setTimeout(20L);
+        assertEquals(Objects.hash(20L, 7), type.hashCode());
+    }
+
+    @Test
+    void hotHashMethodDoesNotAllocateOrBox() throws Exception {
+        final ClassNode owner = new ClassNode(Opcodes.ASM9);
+        new ClassReader(TicketType.class.getName()).accept(owner, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        final MethodNode hashCode = owner.methods.stream()
+            .filter(method -> method.name.equals("hashCode") && method.desc.equals("()I"))
+            .findFirst()
+            .orElseThrow();
+
+        assertEquals(
+            0L,
+            java.util.Arrays.stream(hashCode.instructions.toArray())
+                .filter(TypeInsnNode.class::isInstance)
+                .map(TypeInsnNode.class::cast)
+                .filter(instruction -> instruction.getOpcode() == Opcodes.NEW
+                    || instruction.getOpcode() == Opcodes.ANEWARRAY)
+                .count()
+        );
+        assertEquals(
+            0L,
+            java.util.Arrays.stream(hashCode.instructions.toArray())
+                .filter(MethodInsnNode.class::isInstance)
+                .map(MethodInsnNode.class::cast)
+                .filter(call -> call.owner.equals("java/util/Objects") || call.name.equals("valueOf"))
+                .count()
+        );
+    }
+}
