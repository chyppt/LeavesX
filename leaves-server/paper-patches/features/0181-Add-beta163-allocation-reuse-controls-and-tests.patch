diff --git a/src/test/java/net/minecraft/world/level/BlockTraversalVisitedSetReuseTest.java b/src/test/java/net/minecraft/world/level/BlockTraversalVisitedSetReuseTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..591b44058dad20aeac1dd0a1816efc8ef72bfc7d
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/BlockTraversalVisitedSetReuseTest.java
@@ -0,0 +1,157 @@
+package net.minecraft.world.level;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Differential coverage for the re-entry-safe moving-entity block traversal workspace. */
+@Normal
+class BlockTraversalVisitedSetReuseTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @AfterEach
+    void restoreDefaults() throws Exception {
+        publish(LeavesXConfig.safeDefaults());
+    }
+
+    @Test
+    void reusedAndAllocatingTraversalsMatchAcrossRandomMovement() throws Exception {
+        final Random random = new Random(0x426C6F636B4C5853L);
+        for (int scenario = 0; scenario < 256; scenario++) {
+            final Vec3 from = randomVector(random);
+            Vec3 to = randomVector(random);
+            if (from.distanceToSqr(to) < 1.0E-4D) {
+                to = to.add(0.25D, 0.5D, -0.75D);
+            }
+            final double width = 0.25D + random.nextDouble() * 3.75D;
+            final double height = 0.25D + random.nextDouble() * 3.75D;
+            final AABB target = AABB.ofSize(to, width, height, width);
+            final int stopAfter = 1 + random.nextInt(64);
+
+            publish(configuration(false, "fallback-" + scenario + ".yml"));
+            final TraversalResult fallback = traverse(from, to, target, stopAfter, false);
+            publish(configuration(true, "reused-" + scenario + ".yml"));
+            final TraversalResult reused = traverse(from, to, target, stopAfter, false);
+            assertEquals(fallback, reused, "traversal changed at scenario " + scenario);
+        }
+    }
+
+    @Test
+    void nestedTraversalCannotCorruptTheOuterWorkspace() throws Exception {
+        final Vec3 from = new Vec3(-4.5D, 63.0D, 2.25D);
+        final Vec3 to = new Vec3(7.75D, 68.5D, -5.0D);
+        final AABB target = AABB.ofSize(to, 1.8D, 2.4D, 1.8D);
+
+        publish(configuration(false, "nested-fallback.yml"));
+        final TraversalResult fallback = traverse(from, to, target, Integer.MAX_VALUE, true);
+        publish(configuration(true, "nested-reused.yml"));
+        final TraversalResult reused = traverse(from, to, target, Integer.MAX_VALUE, true);
+        assertEquals(fallback, reused);
+
+        // A call after nested re-entry also proves the pooled owner was released and cleared correctly.
+        assertEquals(
+            traverse(from, to, target, Integer.MAX_VALUE, false),
+            traverse(from, to, target, Integer.MAX_VALUE, false)
+        );
+    }
+
+    @Test
+    void version64ConfigurationGainsTheSwitchWithoutBackupFiles() throws Exception {
+        final Path path = this.temporaryDirectory.resolve("upgrade.yml");
+        Files.writeString(path, """
+            config-version: 64
+            performance:
+              entity-update:
+                block-traversal-visited-set-reuse: false
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        publish(config);
+        assertFalse(LeavesXRuntime.blockTraversalVisitedSetReuseOptimization());
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("block-traversal-visited-set-reuse: false"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("upgrade.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private TraversalResult traverse(
+        final Vec3 from,
+        final Vec3 to,
+        final AABB target,
+        final int stopAfter,
+        final boolean nested
+    ) {
+        final List<Visit> visits = new ArrayList<>();
+        final boolean[] nestedInvoked = {false};
+        final boolean completed = BlockGetter.forEachBlockIntersectedBetween(from, to, target, (position, iteration) -> {
+            visits.add(new Visit(position.asLong(), iteration));
+            if (nested && !nestedInvoked[0]) {
+                nestedInvoked[0] = true;
+                final List<Visit> nestedVisits = new ArrayList<>();
+                BlockGetter.forEachBlockIntersectedBetween(
+                    new Vec3(0.1D, 64.0D, 0.1D),
+                    new Vec3(3.5D, 65.25D, -2.0D),
+                    new AABB(3.1D, 64.8D, -2.4D, 3.9D, 66.6D, -1.6D),
+                    (nestedPosition, nestedIteration) -> {
+                        nestedVisits.add(new Visit(nestedPosition.asLong(), nestedIteration));
+                        return true;
+                    }
+                );
+                visits.addAll(nestedVisits);
+            }
+            return visits.size() < stopAfter;
+        });
+        return new TraversalResult(completed, List.copyOf(visits));
+    }
+
+    private LeavesXConfig configuration(final boolean enabled, final String name) throws Exception {
+        final Path path = this.temporaryDirectory.resolve(name);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-state-optimizations: true
+              entity-update:
+                block-traversal-visited-set-reuse: %s
+            """.formatted(enabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static Vec3 randomVector(final Random random) {
+        return new Vec3(
+            random.nextDouble(-16.0D, 16.0D),
+            random.nextDouble(48.0D, 80.0D),
+            random.nextDouble(-16.0D, 16.0D)
+        );
+    }
+
+    private static void publish(final LeavesXConfig config) throws Exception {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private record Visit(long position, int iteration) {
+    }
+
+    private record TraversalResult(boolean completed, List<Visit> visits) {
+    }
+}
