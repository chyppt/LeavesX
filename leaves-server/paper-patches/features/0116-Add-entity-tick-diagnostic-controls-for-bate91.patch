diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityTickDiagnosticStateHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityTickDiagnosticStateHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..5f36037cfd300dbb2f5de92b2aba5059c3b7bd1a
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityTickDiagnosticStateHotPathTest.java
@@ -0,0 +1,96 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies entity tick diagnostics keep nested ownership while avoiding the optimized release read. */
+@Normal
+class EntityTickDiagnosticStateHotPathTest {
+
+    @Test
+    void diagnosticOwnershipRemainsWithTheOuterEntity() throws ReflectiveOperationException {
+        final AtomicReference<Entity> current = currentEntityReference();
+        final Method claim = privateMethod("claimTickingEntityDiagnostic", Entity.class);
+        final Method release = privateMethod("releaseTickingEntityDiagnostic", boolean.class);
+        final Entity outer = mock(Entity.class);
+        final Entity nested = mock(Entity.class);
+
+        current.set(null);
+        try {
+            final boolean outerClaimed = (boolean)claim.invoke(null, outer);
+            final boolean nestedClaimed = (boolean)claim.invoke(null, nested);
+
+            assertTrue(outerClaimed);
+            assertFalse(nestedClaimed);
+            assertSame(outer, current.get());
+
+            release.invoke(null, nestedClaimed);
+            assertSame(outer, current.get());
+            release.invoke(null, outerClaimed);
+            assertNull(current.get());
+        } finally {
+            current.set(null);
+        }
+    }
+
+    @Test
+    void tickMethodKeepsOptimizedAndPaperDiagnosticPaths() throws IOException {
+        final List<MethodInsnNode> calls = invocations(methodNode("tickNonPassenger"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("entityTickDiagnosticStateOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("claimTickingEntityDiagnostic")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("releaseTickingEntityDiagnostic")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("java/util/concurrent/atomic/AtomicReference")
+            && call.name.equals("get")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("java/util/concurrent/atomic/AtomicReference")
+            && call.name.equals("lazySet")));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static AtomicReference<Entity> currentEntityReference() throws ReflectiveOperationException {
+        final Field field = ServerLevel.class.getDeclaredField("currentlyTickingEntity");
+        field.setAccessible(true);
+        return (AtomicReference<Entity>)field.get(null);
+    }
+
+    private static Method privateMethod(final String name, final Class<?> parameterType) throws ReflectiveOperationException {
+        final Method method = ServerLevel.class.getDeclaredMethod(name, parameterType);
+        method.setAccessible(true);
+        return method;
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static MethodNode methodNode(final String methodName) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(ServerLevel.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing ServerLevel#" + methodName));
+    }
+}
