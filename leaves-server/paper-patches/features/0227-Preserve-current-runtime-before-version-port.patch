+    public record RegionTickingSettings(
+        Mode mode,
+        int mergeRadiusChunks,
+        List<String> strictSerialWorlds,
+        int intentQueueSize,
+        int autoDegradeBarrierPercent,
+        int autoDegradeReplayThreshold,
+        int threads
+    ) {
+
+        /** Regionized ticking execution mode. */
+        public enum Mode {
+            /** Single-threaded world tick, identical to the pre-regionization pipeline. */
+            OFF,
+            /** Worlds tick in parallel; world interiors remain single-threaded. */
+            WORLDS,
+            /** Connected loaded-chunk components tick in parallel (experimental). */
+            REGIONS
+        }
+
+        public RegionTickingSettings {
+            if (mergeRadiusChunks < 0 || mergeRadiusChunks > 64) {
+                throw new IllegalArgumentException("regionized-ticking.merge-radius-chunks must be between 0 and 64");
+            }
+            if (strictSerialWorlds == null || strictSerialWorlds.size() > 32) {
+                throw new IllegalArgumentException(
+                    "regionized-ticking.strict-serial-worlds must contain at most 32 entries"
+                );
+            }
+            if (strictSerialWorlds != null) {
+                for (final String world : strictSerialWorlds) {
+                    if (world == null || world.length() > 256) {
+                        throw new IllegalArgumentException(
+                            "regionized-ticking.strict-serial-worlds entries must not exceed 256 characters"
+                        );
+                    }
+                }
+            }
+            if (intentQueueSize < 1_024 || intentQueueSize > 1_048_576) {
+                throw new IllegalArgumentException("regionized-ticking.intent-queue-size must be between 1024 and 1048576");
+            }
+            if (autoDegradeBarrierPercent < 0 || autoDegradeBarrierPercent > 100) {
+                throw new IllegalArgumentException(
+                    "regionized-ticking.auto-degrade-barrier-percent must be between 0 and 100"
+                );
+            }
+            if (autoDegradeReplayThreshold < 0 || autoDegradeReplayThreshold > 65_536) {
+                throw new IllegalArgumentException(
+                    "regionized-ticking.auto-degrade-replay-threshold must be between 0 and 65536"
+                );
+            }
+            if (threads < 0 || threads > 16) {
+                throw new IllegalArgumentException("regionized-ticking.threads must be between 0 and 16");
+            }
+            strictSerialWorlds = strictSerialWorlds == null ? List.of() : List.copyOf(strictSerialWorlds);
+        }
+
+        public static RegionTickingSettings safeDefaults() {
+            return new RegionTickingSettings(Mode.OFF, 8, List.of(), 65_536, 25, 64, 0);
+        }
