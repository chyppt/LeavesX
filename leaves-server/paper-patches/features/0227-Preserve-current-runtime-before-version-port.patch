diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/SimpleThreadUnsafeRandom.java b/src/main/java/ca/spottedleaf/moonrise/common/util/SimpleThreadUnsafeRandom.java
index 8d57b9c141..bea56d85b2 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/SimpleThreadUnsafeRandom.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/SimpleThreadUnsafeRandom.java
@@ -38,6 +38,24 @@ public final class SimpleThreadUnsafeRandom implements BitRandomSource {
         return (int)(this.advanceSeed() >>> (BITS - bits));
     }
 
+    @Override
+    public void consumeCount(final int count) {
+        // Compose affine LCG steps in O(log n). The next output is bit-identical to count calls to nextInt().
+        long multiplier = MULTIPLIER;
+        long increment = ADDEND;
+        long accumulatedMultiplier = 1L;
+        long accumulatedIncrement = 0L;
+        for (int remaining = count; remaining > 0; remaining >>>= 1) {
+            if ((remaining & 1) != 0) {
+                accumulatedMultiplier = (accumulatedMultiplier * multiplier) & MASK;
+                accumulatedIncrement = (accumulatedIncrement * multiplier + increment) & MASK;
+            }
+            increment = (increment * (multiplier + 1L)) & MASK;
+            multiplier = (multiplier * multiplier) & MASK;
+        }
+        this.value = (this.value * accumulatedMultiplier + accumulatedIncrement) & MASK;
+    }
+
     @Override
     public int nextInt() {
         final long seed = this.advanceSeed();
