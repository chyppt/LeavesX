+                case "off" -> LeavesXConfig.RegionTickingSettings.Mode.OFF;
+                case "worlds" -> LeavesXConfig.RegionTickingSettings.Mode.WORLDS;
+                case "regions" -> LeavesXConfig.RegionTickingSettings.Mode.REGIONS;
+                default -> throw invalidType(path, "one of off, worlds or regions", raw);
+            };
+        }
