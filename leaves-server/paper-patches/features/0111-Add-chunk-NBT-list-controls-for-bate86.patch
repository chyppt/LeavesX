diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkNbtSerializationHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkNbtSerializationHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ed2e0803d7bf3ec1549e8c32e818b173593d2f6f
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkNbtSerializationHotPathTest.java
@@ -0,0 +1,54 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.level.chunk.storage.SerializableChunkData;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies chunk NBT writes retain both pre-sized and vanilla list construction. */
+@Normal
+class ChunkNbtSerializationHotPathTest {
+
+    @Test
+    void writerKeepsOptimizedAndVanillaListPaths() throws IOException {
+        final ClassNode owner = classNode(SerializableChunkData.class);
+        final List<MethodInsnNode> writeCalls = invocations(method(owner, "write"));
+        final List<MethodInsnNode> factoryCalls = invocations(method(owner, "createListTag"));
+
+        assertTrue(writeCalls.stream().anyMatch(call -> call.name.equals("chunkNbtListCapacityOptimization")));
+        assertTrue(writeCalls.stream().filter(call -> call.name.equals("createListTag")).count() >= 3L);
+        assertTrue(factoryCalls.stream().anyMatch(call -> call.owner.equals("net/minecraft/nbt/ListTag")
+            && call.name.equals("<init>") && call.desc.equals("(Ljava/util/List;)V")));
+        assertTrue(factoryCalls.stream().anyMatch(call -> call.owner.equals("net/minecraft/nbt/ListTag")
+            && call.name.equals("<init>") && call.desc.equals("()V")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
