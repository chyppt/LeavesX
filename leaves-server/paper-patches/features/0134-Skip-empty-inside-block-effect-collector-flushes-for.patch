diff --git a/src/test/java/org/leavesx/leavesx/performance/InsideBlockEffectCollectorHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/InsideBlockEffectCollectorHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f0f6bcb5196cb6ac323a2f3016abcfb29e38692a
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/InsideBlockEffectCollectorHotPathTest.java
@@ -0,0 +1,175 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.world.entity.InsideBlockEffectApplier;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies the inside-block collector skips only provably empty ordered flushes. */
+@Normal
+class InsideBlockEffectCollectorHotPathTest {
+
+    private static final String COLLECTOR_INTERNAL_NAME =
+        InsideBlockEffectApplier.StepBasedCollector.class.getName().replace('.', '/');
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void dedicatedSwitchRespectsTheEntityStateMasterSwitch() throws Exception {
+        try {
+            publish(this.configuration(true, true, "enabled.yml"));
+            assertTrue(LeavesXRuntime.insideBlockEffectCollectorOptimization());
+
+            publish(this.configuration(true, false, "setting-disabled.yml"));
+            assertFalse(LeavesXRuntime.insideBlockEffectCollectorOptimization());
+
+            publish(this.configuration(false, true, "master-disabled.yml"));
+            assertFalse(LeavesXRuntime.insideBlockEffectCollectorOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void version39ConfigurationGainsTheDocumentedDefaultInPlace() throws IOException {
+        final Path path = this.tempDir.resolve("version-39.yml");
+        Files.writeString(path, """
+            config-version: 39
+            performance:
+              entity-state-optimizations: true
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        final String upgraded = Files.readString(path);
+
+        assertTrue(config.enabledFineGrainedOptimizationCount() > 0);
+        assertTrue(upgraded.contains("config-version: 40"));
+        assertTrue(upgraded.contains("inside-block-effect-collector: true"));
+        assertFalse(Files.exists(this.tempDir.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.tempDir.resolve("leavesx-migration-report.yml")));
+    }
+
+    @Test
+    void emptyFlushChecksPendingStateBeforeTraversingEffectTypes() throws IOException {
+        final MethodNode flushStep = method(classNode(InsideBlockEffectApplier.StepBasedCollector.class), "flushStep");
+        final AbstractInsnNode[] instructions = flushStep.instructions.toArray();
+        final int applyOrderRead = findField(instructions, Opcodes.GETSTATIC, "APPLY_ORDER");
+
+        assertTrue(findCallBefore(
+            instructions,
+            applyOrderRead,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "insideBlockEffectCollectorOptimization"
+        ));
+        assertTrue(findFieldBefore(instructions, applyOrderRead, Opcodes.GETFIELD, "leavesX$hasPendingEffects"));
+        assertTrue(
+            Arrays.stream(instructions, 0, applyOrderRead).anyMatch(instruction -> instruction.getOpcode() == Opcodes.RETURN),
+            "The optimized empty path must return before reading APPLY_ORDER"
+        );
+
+        for (final String methodName : new String[] {"apply", "runBefore", "runAfter"}) {
+            final MethodNode method = method(classNode(InsideBlockEffectApplier.StepBasedCollector.class), methodName);
+            assertTrue(
+                Arrays.stream(method.instructions.toArray())
+                    .filter(FieldInsnNode.class::isInstance)
+                    .map(FieldInsnNode.class::cast)
+                    .anyMatch(field -> field.getOpcode() == Opcodes.PUTFIELD
+                        && field.owner.equals(COLLECTOR_INTERNAL_NAME)
+                        && field.name.equals("leavesX$hasPendingEffects")),
+                methodName + " must mark the current step as non-empty"
+            );
+        }
+    }
+
+    private LeavesXConfig configuration(
+        final boolean masterEnabled,
+        final boolean settingEnabled,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-state-optimizations: %s
+              entity-update:
+                inside-block-effect-collector: %s
+            """.formatted(masterEnabled, settingEnabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode(final Class<?> type) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(type.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static int findField(final AbstractInsnNode[] instructions, final int opcode, final String name) {
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] instanceof FieldInsnNode field
+                && field.getOpcode() == opcode
+                && field.owner.equals(COLLECTOR_INTERNAL_NAME)
+                && field.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing field access " + COLLECTOR_INTERNAL_NAME + '#' + name);
+    }
+
+    private static boolean findFieldBefore(
+        final AbstractInsnNode[] instructions,
+        final int end,
+        final int opcode,
+        final String name
+    ) {
+        return Arrays.stream(instructions, 0, end)
+            .filter(FieldInsnNode.class::isInstance)
+            .map(FieldInsnNode.class::cast)
+            .anyMatch(field -> field.getOpcode() == opcode
+                && field.owner.equals(COLLECTOR_INTERNAL_NAME)
+                && field.name.equals(name));
+    }
+
+    private static boolean findCallBefore(
+        final AbstractInsnNode[] instructions,
+        final int end,
+        final String owner,
+        final String name
+    ) {
+        return Arrays.stream(instructions, 0, end)
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+}
