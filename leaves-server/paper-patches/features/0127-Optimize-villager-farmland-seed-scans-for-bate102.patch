diff --git a/src/test/java/org/leavesx/leavesx/performance/VillagerFarmlandSeedScanHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/VillagerFarmlandSeedScanHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f3b6ad60fb687da2e30a6a980d04a6c47db7e5fd
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/VillagerFarmlandSeedScanHotPathTest.java
@@ -0,0 +1,147 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.world.entity.ai.behavior.HarvestFarmland;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.JumpInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies farmer planting avoids only the redundant seed-presence scan. */
+@Normal
+class VillagerFarmlandSeedScanHotPathTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void dedicatedSwitchRespectsTheAiMasterSwitch() throws Exception {
+        try {
+            publish(this.configuration(true, true, "optimized.yml"));
+            assertTrue(LeavesXRuntime.villagerFarmlandSeedScanOptimization());
+
+            publish(this.configuration(true, false, "fallback.yml"));
+            assertFalse(LeavesXRuntime.villagerFarmlandSeedScanOptimization());
+
+            publish(this.configuration(false, true, "master-disabled.yml"));
+            assertFalse(LeavesXRuntime.villagerFarmlandSeedScanOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void optimizedBranchSkipsHasFarmSeedsButKeepsTheFallbackCall() throws IOException {
+        final MethodNode tick = method(classNode(), "tick");
+        final AbstractInsnNode[] instructions = tick.instructions.toArray();
+        final int switchCall = findCall(
+            instructions,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "villagerFarmlandSeedScanOptimization"
+        );
+        final int fallbackCall = findCall(
+            instructions,
+            "net/minecraft/world/entity/npc/villager/Villager",
+            "hasFarmSeeds"
+        );
+        final int inventoryCall = findCall(
+            instructions,
+            "net/minecraft/world/entity/npc/villager/Villager",
+            "getInventory"
+        );
+
+        assertTrue(switchCall < fallbackCall);
+        assertTrue(fallbackCall < inventoryCall);
+        assertEquals(1L, Arrays.stream(instructions)
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .filter(call -> call.owner.equals("net/minecraft/world/entity/npc/villager/Villager"))
+            .filter(call -> call.name.equals("hasFarmSeeds"))
+            .count());
+
+        final JumpInsnNode optimizedJump = nextJump(instructions, switchCall);
+        assertEquals(Opcodes.IFNE, optimizedJump.getOpcode());
+        final int optimizedTarget = indexOf(instructions, optimizedJump.label);
+        assertTrue(fallbackCall < optimizedTarget);
+        assertTrue(optimizedTarget <= inventoryCall);
+    }
+
+    private LeavesXConfig configuration(
+        final boolean aiOptimizations,
+        final boolean seedScanOptimization,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              ai-optimizations: %s
+              ai:
+                villager-farmland-seed-scan: %s
+            """.formatted(aiOptimizations, seedScanOptimization));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(HarvestFarmland.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static int findCall(final AbstractInsnNode[] instructions, final String owner, final String name) {
+        for (int index = 0; index < instructions.length; ++index) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing call " + owner + '#' + name);
+    }
+
+    private static JumpInsnNode nextJump(final AbstractInsnNode[] instructions, final int start) {
+        for (int index = start + 1; index < instructions.length; ++index) {
+            if (instructions[index] instanceof JumpInsnNode jump) {
+                return jump;
+            }
+        }
+        throw new AssertionError("Missing conditional jump after instruction " + start);
+    }
+
+    private static int indexOf(final AbstractInsnNode[] instructions, final AbstractInsnNode target) {
+        for (int index = 0; index < instructions.length; ++index) {
+            if (instructions[index] == target) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing jump target");
+    }
+}
