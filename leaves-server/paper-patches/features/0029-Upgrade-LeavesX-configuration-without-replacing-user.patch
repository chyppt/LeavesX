 public final class LeavesXConfigLoader {
@@ -40,7 +42,17 @@ public final class LeavesXConfigLoader {
             if (!Files.isRegularFile(normalized)) {
                 throw new LeavesXConfigException("LeavesX configuration is not a regular file: " + normalized);
             }
-            return fromNode(ConfigurationLoaders.naturallySortedWithoutHeader(normalized).load(), normalized);
+            final CommentedConfigurationNode node = ConfigurationLoaders.naturallySorted()
+                .headerMode(HeaderMode.PRESERVE)
+                .path(normalized)
+                .build()
+                .load();
+            final LeavesXConfig config = fromNode(node, normalized);
+            if (LeavesXConfigWriter.writeMissing(node, config)) {
+                save(normalized, node, readOriginalFormatting(normalized));
+                LOGGER.info("Added newly supported LeavesX settings to {} without replacing existing values", normalized);
+            }
+            return config;
         } catch (final LeavesXConfigException ex) {
             throw ex;
         } catch (final Exception ex) {
@@ -104,6 +116,67 @@ public final class LeavesXConfigLoader {
     }
 
     private static void save(final Path path, final LeavesXConfig config) throws IOException, ConfigurateException {
+        save(path, LeavesXConfigWriter.render(config, HEADER));
+    }
+
+    private static void save(final Path path, final CommentedConfigurationNode node, final OriginalFormatting formatting)
+        throws IOException, ConfigurateException {
+        // Configurate does not retain every header layout, BOM, or source line ending when serializing a loaded node.
+        // Prefixing the original preamble keeps user documentation stable while the structured tree gains new keys.
+        final String body = ConfigurationLoaders.naturallySorted()
+            .headerMode(HeaderMode.NONE)
+            .buildAndSaveString(node);
+        final String yaml = formatting.preamble() + normalizeLineEndings(body, formatting.lineSeparator());
+        save(path, YamlCommentInjector.inject(yaml, LeavesXConfigWriter.comments()).text());
+    }
+
+    private static OriginalFormatting readOriginalFormatting(final Path path) throws IOException {
+        final String content = Files.readString(path, java.nio.charset.StandardCharsets.UTF_8);
+        final String lineSeparator = detectLineSeparator(content);
+        int lineStart = 0;
+        if (!content.isEmpty() && content.charAt(0) == '\uFEFF') {
+            lineStart = 1;
+        }
+        int preambleEnd = lineStart;
+        while (lineStart < content.length()) {
+            int lineEnd = content.indexOf('\n', lineStart);
+            if (lineEnd < 0) {
+                lineEnd = content.length();
+            }
+            int contentEnd = lineEnd;
+            if (contentEnd > lineStart && content.charAt(contentEnd - 1) == '\r') {
+                contentEnd--;
+            }
+
+            final String line = content.substring(lineStart, contentEnd).stripLeading();
+            if (!line.isEmpty() && !line.startsWith("#")) {
+                break;
+            }
+            preambleEnd = lineEnd < content.length() ? lineEnd + 1 : lineEnd;
+            lineStart = preambleEnd;
+        }
+        final int bomLength = !content.isEmpty() && content.charAt(0) == '\uFEFF' ? 1 : 0;
+        return new OriginalFormatting(content.substring(0, Math.max(preambleEnd, bomLength)), lineSeparator);
+    }
+
+    private static String detectLineSeparator(final String content) {
+        for (int index = 0; index < content.length(); index++) {
+            final char character = content.charAt(index);
+            if (character == '\r') {
+                return index + 1 < content.length() && content.charAt(index + 1) == '\n' ? "\r\n" : "\r";
+            }
+            if (character == '\n') {
+                return "\n";
+            }
+        }
+        return System.lineSeparator();
+    }
+
+    private static String normalizeLineEndings(final String content, final String lineSeparator) {
+        return content.replace("\r\n", "\n").replace('\r', '\n').replace("\n", lineSeparator);
+    }
+
+    private static void save(final Path path, final String content) throws IOException {
         final Path parent = path.getParent();
         if (parent != null) {
             Files.createDirectories(parent);
@@ -111,7 +184,7 @@ public final class LeavesXConfigLoader {
         AtomicFiles.atomicWrite(path, temporary -> {
             Files.writeString(
                 temporary,
-                LeavesXConfigWriter.render(config, HEADER),
+                content,
                 java.nio.charset.StandardCharsets.UTF_8
             );
             try (FileChannel channel = FileChannel.open(temporary, StandardOpenOption.WRITE)) {
@@ -155,4 +228,7 @@ public final class LeavesXConfigLoader {
             path + " must be " + expected + ", but was " + (actual == null ? "null" : actual.getClass().getSimpleName())
         );
     }
+
+    private record OriginalFormatting(String preamble, String lineSeparator) {
+    }
 }
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
