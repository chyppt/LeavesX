+
+    /**
+     * Adds newly supported keys without replacing user values or unknown extensions.
+     *
+     * @return {@code true} when the document was upgraded
+     */
+    public static boolean writeMissing(final CommentedConfigurationNode node, final LeavesXConfig config) {
+        return writeSupportedKeys(node, config, true);
     }
 
     /** Returns the same path-keyed comments used for emitted {@code leavesx.yml} files. */
@@ -69,6 +52,77 @@ public final class LeavesXConfigWriter {
         return YamlCommentInjector.injectGenerated(yaml, header, COMMENTS).text();
     }
 
+    private static boolean writeSupportedKeys(
+        final CommentedConfigurationNode node,
+        final LeavesXConfig config,
+        final boolean missingOnly
+    ) {
+        boolean changed = false;
+        changed |= writeValue(node.node("config-version"), "config-version", config.configVersion(), missingOnly);
+        changed |= writeValue(
+            node.node("performance", "optimized-varint"),
+            "performance.optimized-varint",
+            config.optimizedVarInt(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("performance", "immutable-cache-optimizations"),
+            "performance.immutable-cache-optimizations",
+            config.immutableCacheOptimizations(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("performance", "resource-identifier-cache"),
+            "performance.resource-identifier-cache",
+            config.resourceIdentifierCache(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("performance", "skip-empty-events"),
+            "performance.skip-empty-events",
+            config.skipEmptyEvents(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("performance", "item-merge-optimizations"),
+            "performance.item-merge-optimizations",
+            config.itemMergeOptimizations(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("parallelism", "mob-spawning", "enabled"),
+            "parallelism.mob-spawning.enabled",
+            config.parallelMobSpawnCounting(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("parallelism", "mob-spawning", "workers"),
+            "parallelism.mob-spawning.workers",
+            config.mobSpawnCountingWorkers(),
+            missingOnly
+        );
+        changed |= writeValue(
+            node.node("parallelism", "mob-spawning", "minimum-entities"),
+            "parallelism.mob-spawning.minimum-entities",
+            config.mobSpawnCountingMinimumEntities(),
+            missingOnly
+        );
+        return changed;
+    }
+
+    private static boolean writeValue(
+        final CommentedConfigurationNode node,
+        final String path,
+        final Object value,
+        final boolean missingOnly
+    ) {
+        if (missingOnly && !node.virtual()) {
+            return false;
+        }
+        node.comment(COMMENTS.get(path)).raw(value);
+        return true;
+    }
+
     private static Map<String, String> createComments() {
         final Map<String, String> comments = new LinkedHashMap<>();
         comments.put("config-version", "LeavesX 配置文件版本，请不要手动修改。默认：1。");
diff --git a/src/test/java/org/leavesx/leavesx/config/LeavesXConfigLoaderTest.java b/src/test/java/org/leavesx/leavesx/config/LeavesXConfigLoaderTest.java
index 4275c35c71d27e847c8eb009c06919c07fafb5a7..0a21906ff9f39fc88c2c246aff7dd1363692a449 100644
--- a/src/test/java/org/leavesx/leavesx/config/LeavesXConfigLoaderTest.java
+++ b/src/test/java/org/leavesx/leavesx/config/LeavesXConfigLoaderTest.java
@@ -51,6 +51,48 @@ class LeavesXConfigLoaderTest {
         assertEquals(LeavesXConfig.safeDefaults(), LeavesXConfigLoader.load(path));
     }
 
+    @Test
+    void addsMissingSettingsWithoutReplacingExistingValuesOrExtensions() throws Exception {
+        final Path path = write("""
+            # User-managed LeavesX settings.
+            config-version: 1
+            performance:
+              optimized-varint: false
+            custom-extension:
+              retained: true
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        final String upgraded = Files.readString(path);
+        final org.spongepowered.configurate.ConfigurationNode reloaded =
+            io.papermc.paper.configuration.ConfigurationLoaders.naturallySortedWithoutHeader(path).load();
+
+        assertFalse(config.optimizedVarInt());
+        assertTrue(config.itemMergeOptimizations());
+        assertFalse(reloaded.node("performance", "optimized-varint").getBoolean());
+        assertTrue(reloaded.node("performance", "item-merge-optimizations").getBoolean());
+        assertTrue(reloaded.node("custom-extension", "retained").getBoolean());
+        assertTrue(upgraded.contains("# User-managed LeavesX settings."), upgraded);
+        assertTrue(upgraded.contains("# " + LeavesXConfigWriter.comments().get("performance.item-merge-optimizations")));
+    }
+
+    @Test
+    void preservesLeadingHeaderByteOrderMarkAndLineEndingsDuringUpgrade() throws IOException {
+        final Path path = write("\uFEFF# First user header line.\r\n"
+            + "# Second user header line.\r\n"
+            + "config-version: 1\r\n"
+            + "performance:\r\n"
+            + "  optimized-varint: false\r\n");
+
+        LeavesXConfigLoader.load(path);
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.startsWith("\uFEFF# First user header line.\r\n"), upgraded);
+        assertTrue(upgraded.contains("# Second user header line."), upgraded);
+        assertTrue(upgraded.contains("optimized-varint: false"), upgraded);
+        assertFalse(upgraded.replace("\r\n", "").contains("\n"), upgraded);
+    }
+
     @Test
     void loadsBehaviorEquivalentOptimizationSwitches() throws IOException {
         final Path path = write("""
