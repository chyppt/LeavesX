-            .raw(config.immutableCacheOptimizations());
-        node.node("performance", "resource-identifier-cache")
-            .comment(COMMENTS.get("performance.resource-identifier-cache"))
-            .raw(config.resourceIdentifierCache());
-        node.node("performance", "skip-empty-events")
-            .comment(COMMENTS.get("performance.skip-empty-events"))
-            .raw(config.skipEmptyEvents());
-        node.node("performance", "item-merge-optimizations")
-            .comment(COMMENTS.get("performance.item-merge-optimizations"))
-            .raw(config.itemMergeOptimizations());
-        node.node("parallelism", "mob-spawning", "enabled")
-            .comment(COMMENTS.get("parallelism.mob-spawning.enabled"))
-            .raw(config.parallelMobSpawnCounting());
-        node.node("parallelism", "mob-spawning", "workers")
