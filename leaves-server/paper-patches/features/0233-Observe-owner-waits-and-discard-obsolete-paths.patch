From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Date: Sun, 27 Sep 2026 18:15:00 +0800
Subject: [PATCH] Observe owner waits and discard obsolete paths

diff --git a/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java b/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
index be86809d..c77ca524 100644
--- a/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
+++ b/src/main/java/org/leavesx/leavesx/runtime/LeavesXAsyncRuntime.java
@@ -298,17 +298,23 @@ public final class LeavesXAsyncRuntime {
 
     /** Waits until all globally ordered work submitted before this call has completed. */
     public static void awaitOrdered(final Workload workload) {
-        submitOrdered(workload, () -> { }).join();
+        org.leavesx.leavesx.diagnostics.OwnerThreadWaits.measure(
+            org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.ORDERED_BARRIER,
+            () -> submitOrdered(workload, () -> { }).join());
     }
 
     /** Waits for work already submitted for one identity owner without blocking unrelated owners. */
     public static void awaitOwner(final Workload workload, final Object owner) {
-        submitOwnedOrRun(workload, owner, () -> { }).join();
+        org.leavesx.leavesx.diagnostics.OwnerThreadWaits.measure(
+            org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.ORDERED_BARRIER,
+            () -> submitOwnedOrRun(workload, owner, () -> { }).join());
     }
 
     /** Value-keyed counterpart used by persistent records that may recreate identifier objects between calls. */
     public static void awaitKey(final Workload workload, final Object key) {
-        submitKeyedOrRun(workload, key, () -> { }).join();
+        org.leavesx.leavesx.diagnostics.OwnerThreadWaits.measure(
+            org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.ORDERED_BARRIER,
+            () -> submitKeyedOrRun(workload, key, () -> { }).join());
     }
 
     public static boolean enabled(final Workload workload) {
@@ -708,6 +714,13 @@ public final class LeavesXAsyncRuntime {
          * task for the same owner, so shutdown is the only condition that uses the caller fallback.
          */
         private boolean reserveOwned() {
+            if (this.executor.isShutdown()) return false;
+            if (this.reserve()) return true;
+            return org.leavesx.leavesx.diagnostics.OwnerThreadWaits.measure(
+                org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.ADMISSION, this::waitForOwnedCapacity);
+        }
+
+        private boolean waitForOwnedCapacity() {
             boolean interrupted = false;
             try {
                 while (true) {

diff --git a/src/main/java/org/leavesx/leavesx/path/LeavesXAsyncPath.java b/src/main/java/org/leavesx/leavesx/path/LeavesXAsyncPath.java
index d61dd1c7..9d64a467 100644
--- a/src/main/java/org/leavesx/leavesx/path/LeavesXAsyncPath.java
+++ b/src/main/java/org/leavesx/leavesx/path/LeavesXAsyncPath.java
@@ -108,9 +108,19 @@ public final class LeavesXAsyncPath extends Path {
             if (Thread.currentThread() != this.owner) {
                 throw new IllegalStateException("A pending path may only be adopted on its requesting thread");
             }
+            // The owner can discard an obsolete request without waiting for detached work.
+            // Do not cancel the shared future: its producer owns snapshot lifetime and cleanup.
+            if (!this.currentRequest.getAsBoolean()) {
+                this.resolved = null;
+                this.adoption = null;
+                this.currentRequest = () -> false;
+                this.processed = true;
+                return;
+            }
             Throwable computationFailure = null;
             try {
-                this.resolved = this.future.join();
+                this.resolved = org.leavesx.leavesx.diagnostics.OwnerThreadWaits.join(
+                    org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.PATH_RESULT, this.future);
             } catch (final CompletionException | java.util.concurrent.CancellationException failure) {
                 computationFailure = failure;
                 if (this.adoption == null) LOGGER.error("LeavesX asynchronous path calculation failed; this path request will be discarded", failure);

