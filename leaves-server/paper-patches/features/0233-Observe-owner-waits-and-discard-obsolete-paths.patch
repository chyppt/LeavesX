         }
@@ -1475,6 +1483,7 @@ public final class LeavesXCommand extends Command {
         sender.sendMessage(Component.text("/leavesx safety - 区域化降级、重放与线程域违规计数", NamedTextColor.GRAY));
         sender.sendMessage(Component.text("/leavesx reload - 只重载 leavesx.yml，并提示需重启的配置", NamedTextColor.GRAY));
         sender.sendMessage(Component.text("/leavesx health | report - 查看健康检查或导出脱敏报告", NamedTextColor.GRAY));
+        sender.sendMessage(Component.text("/leavesx config check - 只读检查配置与重启差异", NamedTextColor.GRAY));
         sender.sendMessage(Component.text("/leavesx memory|network|threads|system|config - 对应详细状态", NamedTextColor.GRAY));
     }
 

