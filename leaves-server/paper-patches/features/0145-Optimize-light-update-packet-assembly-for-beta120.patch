diff --git a/src/test/java/org/leavesx/leavesx/performance/LightUpdatePacketAssemblyHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/LightUpdatePacketAssemblyHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d4a6ac1ae0a0b0fb1ded83c9f6ea06eec06ac5ab
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/LightUpdatePacketAssemblyHotPathTest.java
@@ -0,0 +1,243 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.clearInvocations;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import io.netty.buffer.Unpooled;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.BitSet;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.core.SectionPos;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.protocol.game.ClientboundLightUpdatePacketData;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.LightLayer;
+import net.minecraft.world.level.chunk.DataLayer;
+import net.minecraft.world.level.lighting.LayerLightEventListener;
+import net.minecraft.world.level.lighting.LevelLightEngine;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies optimized light packet assembly preserves masks, cloned layers, wire bytes, and the original branch. */
+@Normal
+class LightUpdatePacketAssemblyHotPathTest {
+
+    private static final int SECTION_COUNT = 6;
+    private static final int MIN_LIGHT_SECTION = -2;
+    private static final ChunkPos CHUNK_POS = new ChunkPos(17, -23);
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void optimizedAssemblyMatchesOriginalMasksUpdatesAndWireBytes() throws IOException {
+        final BitSet skyFilter = bitSet(0, 1, 2, 4, 5);
+        final BitSet blockFilter = bitSet(0, 2, 3, 4);
+
+        try {
+            publish(this.configuration(false));
+            final Fixture fallbackFixture = fixture();
+            final ClientboundLightUpdatePacketData fallback = new ClientboundLightUpdatePacketData(
+                CHUNK_POS,
+                fallbackFixture.engine(),
+                skyFilter,
+                blockFilter
+            );
+
+            publish(LeavesXConfig.safeDefaults());
+            final Fixture optimizedFixture = fixture();
+            final ClientboundLightUpdatePacketData optimized = new ClientboundLightUpdatePacketData(
+                CHUNK_POS,
+                optimizedFixture.engine(),
+                skyFilter,
+                blockFilter
+            );
+
+            assertEquals(fallback.getSkyYMask(), optimized.getSkyYMask());
+            assertEquals(fallback.getEmptySkyYMask(), optimized.getEmptySkyYMask());
+            assertEquals(fallback.getBlockYMask(), optimized.getBlockYMask());
+            assertEquals(fallback.getEmptyBlockYMask(), optimized.getEmptyBlockYMask());
+            assertUpdatesEqual(fallback.getSkyUpdates(), optimized.getSkyUpdates());
+            assertUpdatesEqual(fallback.getBlockUpdates(), optimized.getBlockUpdates());
+            assertClonedLayers(optimizedFixture, optimized);
+
+            final byte[] optimizedBytes = encode(optimized);
+            publish(this.configuration(false));
+            final byte[] fallbackBytes = encode(fallback);
+            assertArrayEquals(fallbackBytes, optimizedBytes);
+
+            publish(LeavesXConfig.safeDefaults());
+            assertArrayEquals(optimizedBytes, encode(fallback), "Packets built before reload must use the indexed writer");
+            publish(this.configuration(false));
+            assertArrayEquals(fallbackBytes, encode(optimized), "Packets built before reload must retain the original writer");
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void optimizedAssemblyCachesOnlyStableEngineLookups() throws IOException {
+        try {
+            publish(this.configuration(false));
+            final Fixture fallback = fixture();
+            new ClientboundLightUpdatePacketData(CHUNK_POS, fallback.engine(), null, null);
+            verify(fallback.engine(), times(SECTION_COUNT + 1)).getLightSectionCount();
+            verify(fallback.engine(), times(SECTION_COUNT * 2)).getMinLightSection();
+            verify(fallback.engine(), times(SECTION_COUNT)).getLayerListener(LightLayer.SKY);
+            verify(fallback.engine(), times(SECTION_COUNT)).getLayerListener(LightLayer.BLOCK);
+
+            publish(LeavesXConfig.safeDefaults());
+            final Fixture optimized = fixture();
+            new ClientboundLightUpdatePacketData(CHUNK_POS, optimized.engine(), null, null);
+            verify(optimized.engine(), times(1)).getLightSectionCount();
+            verify(optimized.engine(), times(1)).getMinLightSection();
+            verify(optimized.engine(), times(1)).getLayerListener(LightLayer.SKY);
+            verify(optimized.engine(), times(1)).getLayerListener(LightLayer.BLOCK);
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void version48ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-48.yml");
+        Files.writeString(path, """
+            config-version: 48
+            performance:
+              network:
+                light-update-packet-assembly: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.lightUpdatePacketAssemblyOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("light-update-packet-assembly: false"));
+        assertTrue(upgraded.contains("# 减少区块光照包的临时对象，关闭后使用原版组装。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private LeavesXConfig configuration(final boolean enabled) throws IOException {
+        final Path path = this.temporaryDirectory.resolve("light-packet-" + enabled + ".yml");
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              network:
+                light-update-packet-assembly: %s
+            """.formatted(enabled), StandardCharsets.UTF_8);
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static Fixture fixture() {
+        final LevelLightEngine engine = mock(LevelLightEngine.class);
+        final LayerLightEventListener skyListener = mock(LayerLightEventListener.class);
+        final LayerLightEventListener blockListener = mock(LayerLightEventListener.class);
+        final Map<Integer, DataLayer> skyLayers = Map.of(
+            -1, new DataLayer(),
+            0, dataLayer(0x11),
+            1, new DataLayer(7),
+            2, dataLayer(0x33)
+        );
+        final Map<Integer, DataLayer> blockLayers = Map.of(
+            -2, dataLayer(0x44),
+            0, new DataLayer(),
+            1, dataLayer(0x66),
+            2, new DataLayer(9)
+        );
+
+        when(engine.getLightSectionCount()).thenReturn(SECTION_COUNT);
+        when(engine.getMinLightSection()).thenReturn(MIN_LIGHT_SECTION);
+        when(engine.getLayerListener(LightLayer.SKY)).thenReturn(skyListener);
+        when(engine.getLayerListener(LightLayer.BLOCK)).thenReturn(blockListener);
+        when(skyListener.getDataLayerData(any(SectionPos.class)))
+            .thenAnswer(invocation -> skyLayers.get(invocation.<SectionPos>getArgument(0).getY()));
+        when(blockListener.getDataLayerData(any(SectionPos.class)))
+            .thenAnswer(invocation -> blockLayers.get(invocation.<SectionPos>getArgument(0).getY()));
+        clearInvocations(engine, skyListener, blockListener);
+        return new Fixture(engine, skyLayers, blockLayers);
+    }
+
+    private static DataLayer dataLayer(final int value) {
+        final byte[] data = new byte[DataLayer.SIZE];
+        Arrays.fill(data, (byte)value);
+        return new DataLayer(data);
+    }
+
+    private static BitSet bitSet(final int... indices) {
+        final BitSet bitSet = new BitSet();
+        for (final int index : indices) {
+            bitSet.set(index);
+        }
+        return bitSet;
+    }
+
+    private static void assertUpdatesEqual(final List<byte[]> expected, final List<byte[]> actual) {
+        assertEquals(expected.size(), actual.size());
+        for (int index = 0; index < expected.size(); index++) {
+            assertArrayEquals(expected.get(index), actual.get(index), "light update " + index);
+        }
+    }
+
+    private static void assertClonedLayers(
+        final Fixture fixture,
+        final ClientboundLightUpdatePacketData packet
+    ) {
+        assertNotSame(fixture.skyLayers().get(0).getData(), packet.getSkyUpdates().get(0));
+        assertNotSame(fixture.blockLayers().get(-2).getData(), packet.getBlockUpdates().get(0));
+    }
+
+    private static byte[] encode(final ClientboundLightUpdatePacketData packet) {
+        final FriendlyByteBuf output = new FriendlyByteBuf(Unpooled.buffer());
+        try {
+            packet.write(output);
+            final byte[] bytes = new byte[output.writerIndex()];
+            output.getBytes(0, bytes);
+            return bytes;
+        } finally {
+            output.release();
+        }
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+
+    private record Fixture(
+        LevelLightEngine engine,
+        Map<Integer, DataLayer> skyLayers,
+        Map<Integer, DataLayer> blockLayers
+    ) {
+    }
+}
