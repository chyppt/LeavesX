@@ -7,6 +7,7 @@ import static org.junit.jupiter.api.Assertions.assertTrue;
 
 import java.util.concurrent.CountDownLatch;
 import java.util.concurrent.TimeUnit;
+import java.util.concurrent.ThreadPoolExecutor;
 import java.util.concurrent.atomic.AtomicBoolean;
 import java.util.concurrent.atomic.AtomicInteger;
 import java.util.concurrent.atomic.AtomicIntegerArray;
@@ -123,7 +124,56 @@ class LeavesXComputeExecutorTest {
     void automaticWorkerSelectionLeavesHeadroomAndUsesLargeMachines() {
         assertEquals(1, LeavesXComputeExecutor.automaticWorkerCount(2));
         assertEquals(6, LeavesXComputeExecutor.automaticWorkerCount(8));
-        assertEquals(8, LeavesXComputeExecutor.automaticWorkerCount(32));
+        assertEquals(12, LeavesXComputeExecutor.automaticWorkerCount(32));
+    }
+
+    @Test
+    void keepsStartedWorkersWarmBetweenSparseLargeJobs() {
+        LeavesXComputeExecutor.configure(2);
+        assertFalse(LeavesXComputeExecutor.allowsCoreThreadTimeout());
+    }
+
+    @Test
+    void takesOnlyRejectedPartitionsOnTheCallingThreadDuringBackpressure() throws Exception {
+        LeavesXComputeExecutor.configure(2, 64);
+        final ThreadPoolExecutor executor = executor();
+        final CountDownLatch release = new CountDownLatch(1);
+        final CountDownLatch workersStarted = new CountDownLatch(2);
+        final Runnable blocker = () -> {
+            workersStarted.countDown();
+            try {
+                release.await();
+            } catch (final InterruptedException interruption) {
+                Thread.currentThread().interrupt();
+            }
+        };
+        executor.prestartAllCoreThreads();
+        executor.execute(blocker);
+        executor.execute(blocker);
+        assertTrue(workersStarted.await(2L, TimeUnit.SECONDS), "both compute workers must be occupied first");
+        for (int index = 0; index < 128; index++) {
+            executor.execute(blocker);
+        }
+        assertEquals(128, executor.getQueue().size(), "the synthetic workload must fill the bounded queue");
+
+        final AtomicIntegerArray counts = new AtomicIntegerArray(256);
+        assertTrue(LeavesXComputeExecutor.invokeRanges(256, 128, (taskIndex, start, end) -> {
+            for (int index = start; index < end; index++) {
+                counts.incrementAndGet(index);
+            }
+        }));
+
+        for (int index = 0; index < counts.length(); index++) {
+            assertEquals(1, counts.get(index), "backpressure must not duplicate index " + index);
+        }
+        assertTrue(LeavesXComputeExecutor.metrics().backpressureCallerRuns() > 0L);
+        release.countDown();
+    }
+
+    private static ThreadPoolExecutor executor() throws ReflectiveOperationException {
+        final var field = LeavesXComputeExecutor.class.getDeclaredField("executor");
+        field.setAccessible(true);
+        return (ThreadPoolExecutor) field.get(null);
     }
 
     @Test
