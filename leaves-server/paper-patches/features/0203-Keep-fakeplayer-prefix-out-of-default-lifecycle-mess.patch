     }
 
+    @Test
+    void defaultLifecycleMessagesExcludeTheDisplayOnlyPrefix() {
+        publishConfig("&a[假人]", "", "");
+
+        assertEquals(
+            Component.translatable("multiplayer.player.joined", Component.text("bot")).color(NamedTextColor.YELLOW),
+            LeavesXPlayerPresentation.defaultJoinMessage("bot")
+        );
+        assertEquals(
+            Component.translatable("multiplayer.player.left", Component.text("bot")).color(NamedTextColor.YELLOW),
+            LeavesXPlayerPresentation.defaultQuitMessage("bot")
+        );
+    }
+
