@@ -29,6 +30,18 @@ public final class LeavesXPlayerPresentation {
         return deserializeConfigured(prefix).append(Component.text(accountName));
     }
 
+    /** Builds the default fakeplayer join message from the account name, excluding the display-only prefix. */
+    public static Component defaultJoinMessage(final String accountName) {
+        return Component.translatable("multiplayer.player.joined", Component.text(accountName))
+            .color(NamedTextColor.YELLOW);
+    }
+
+    /** Builds the default fakeplayer quit message from the account name, excluding the display-only prefix. */
+    public static Component defaultQuitMessage(final String accountName) {
+        return Component.translatable("multiplayer.player.left", Component.text(accountName))
+            .color(NamedTextColor.YELLOW);
+    }
