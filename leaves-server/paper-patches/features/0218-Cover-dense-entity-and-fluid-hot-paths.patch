+    @Test
+    void denseEntityPushQueriesReuseTheReentrantResultBuffer() throws IOException {
+        final List<MethodInsnNode> calls = methodNodes(LivingEntity.class, "pushEntities").stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level")
+                && call.name.equals("leavesX$acquireEntityQueryBuffer")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level$LeavesXEntityQueryBuffer")
+                && call.name.equals("query")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level$LeavesXEntityQueryBuffer")
+                && call.name.equals("close")
+        ));
+        assertFalse(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level") && call.name.equals("getPushableEntities")
+        ));
+    }
+
