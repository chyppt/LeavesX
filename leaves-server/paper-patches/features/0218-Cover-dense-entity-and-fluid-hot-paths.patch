+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/chunk/PalettedContainer")
+                && call.name.equals("leavesX$getData")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/chunk/PalettedContainer")
+                && call.name.equals("leavesX$get")
+                && call.desc.contains("PalettedContainer$Data")
+        ));
+    }
