+
+    static void evaluateWorldRange(
+        final double[] entityBounds,
+        final byte[] activationTypes,
+        final double[] playerBounds,
+        final double[] activationUnions,
+        final double[] activationGroups,
+        final boolean[] intersections,
+        final int playerCount,
+        final int start,
+        final int end
+    ) {
         for (int entityIndex = start; entityIndex < end; entityIndex++) {
             final byte activationType = activationTypes[entityIndex];
             if (activationType == SKIP_ENTITY) {
@@ -159,16 +203,95 @@
             }
             final int entityOffset = entityIndex * AABB_COMPONENTS;
             final int boxIndex = activationType == DEFAULT_ACTIVATION_ENTITY ? 0 : activationType + 1;
+            if (activationUnions != null
+                && !intersects(activationUnions, boxIndex * AABB_COMPONENTS, entityBounds, entityOffset)) {
+                intersections[entityIndex] = false;
+                continue;
+            }
             boolean intersects = false;
-            for (int playerIndex = 0; playerIndex < playerCount; playerIndex++) {
-                final int activationOffset = (playerIndex * PLAYER_BOXES + boxIndex) * AABB_COMPONENTS;
-                if (intersects(playerBounds, activationOffset, entityBounds, entityOffset)) {
-                    intersects = true;
-                    break;
+            if (activationGroups == null) {
+                for (int playerIndex = 0; playerIndex < playerCount; playerIndex++) {
+                    final int activationOffset = (playerIndex * PLAYER_BOXES + boxIndex) * AABB_COMPONENTS;
+                    if (intersects(playerBounds, activationOffset, entityBounds, entityOffset)) {
+                        intersects = true;
+                        break;
+                    }
                 }
+            } else {
+                final int groupCount = divideCeil(playerCount, PREFILTER_GROUP_SIZE);
+                for (int group = 0; group < groupCount && !intersects; group++) {
+                    final int groupOffset = (group * PLAYER_BOXES + boxIndex) * AABB_COMPONENTS;
+                    if (!intersects(activationGroups, groupOffset, entityBounds, entityOffset)) continue;
+                    final int firstPlayer = group * PREFILTER_GROUP_SIZE;
+                    final int lastPlayer = Math.min(playerCount, firstPlayer + PREFILTER_GROUP_SIZE);
+                    for (int playerIndex = firstPlayer; playerIndex < lastPlayer; playerIndex++) {
+                        final int activationOffset = (playerIndex * PLAYER_BOXES + boxIndex) * AABB_COMPONENTS;
+                        if (intersects(playerBounds, activationOffset, entityBounds, entityOffset)) {
+                            intersects = true;
+                            break;
+                        }
+                    }
+                }
             }
             intersections[entityIndex] = intersects;
         }
+    }
+
+    /** 合并同类玩家激活框；实体不与并集相交时，可以确定它不与任何单个玩家相交。 */
+    static void snapshotActivationUnions(final double[] playerBounds, final double[] unions, final int playerCount) {
+        snapshotActivationUnions(playerBounds, 0, unions, 0, playerCount);
+    }
+
+    private static void snapshotActivationUnions(
+        final double[] playerBounds,
+        final int playerBase,
+        final double[] unions,
+        final int unionBase,
+        final int playerCount
+    ) {
+        for (int box = 0; box < PLAYER_BOXES; box++) {
+            final int firstOffset = playerBase + box * AABB_COMPONENTS;
+            final int unionOffset = unionBase + box * AABB_COMPONENTS;
+            for (int component = 0; component < AABB_COMPONENTS; component++) {
+                unions[unionOffset + component] = playerBounds[firstOffset + component];
+            }
+            for (int player = 1; player < playerCount; player++) {
+                final int playerOffset = playerBase + (player * PLAYER_BOXES + box) * AABB_COMPONENTS;
+                unions[unionOffset] = Math.min(unions[unionOffset], playerBounds[playerOffset]);
+                unions[unionOffset + 1] = Math.min(unions[unionOffset + 1], playerBounds[playerOffset + 1]);
+                unions[unionOffset + 2] = Math.min(unions[unionOffset + 2], playerBounds[playerOffset + 2]);
+                unions[unionOffset + 3] = Math.max(unions[unionOffset + 3], playerBounds[playerOffset + 3]);
+                unions[unionOffset + 4] = Math.max(unions[unionOffset + 4], playerBounds[playerOffset + 4]);
+                unions[unionOffset + 5] = Math.max(unions[unionOffset + 5], playerBounds[playerOffset + 5]);
+            }
+            // 异常扩展值不能让某个 NaN 玩家框阻断其他玩家的正常激活；放宽对应轴，仍逐玩家精确判断。
+            for (int axis = 0; axis < 3; axis++) {
+                if (Double.isNaN(unions[unionOffset + axis]) || Double.isNaN(unions[unionOffset + axis + 3])) {
+                    unions[unionOffset + axis] = Double.NEGATIVE_INFINITY;
+                    unions[unionOffset + axis + 3] = Double.POSITIVE_INFINITY;
+                }
+            }
+        }
+    }
+
+    /** 每四名玩家建立一个并集；玩家分散时避免大并集跨越未加载区域而失去筛选能力。 */
+    static void snapshotActivationGroups(final double[] playerBounds, final double[] groups, final int playerCount) {
+        final int groupCount = divideCeil(playerCount, PREFILTER_GROUP_SIZE);
+        for (int group = 0; group < groupCount; group++) {
+            final int firstPlayer = group * PREFILTER_GROUP_SIZE;
+            final int count = Math.min(PREFILTER_GROUP_SIZE, playerCount - firstPlayer);
+            snapshotActivationUnions(
+                playerBounds,
+                firstPlayer * PLAYER_BOXES * AABB_COMPONENTS,
+                groups,
+                group * PLAYER_BOXES * AABB_COMPONENTS,
+                count
+            );
+        }
+    }
+
+    private static int divideCeil(final int value, final int divisor) {
+        return value == 0 ? 0 : 1 + (value - 1) / divisor;
     }
 
     /**
@@ -487,6 +610,8 @@
         private boolean[] intersections = new boolean[0];
         private Entity[] entities = new Entity[0];
         private double[] playerBounds = new double[0];
+        private final double[] activationUnions = new double[PLAYER_BOXES * AABB_COMPONENTS];
+        private double[] activationGroups = new double[0];
         private int entityCount;
         private boolean inUse;
 
@@ -515,6 +640,15 @@
                     expandedCapacity(this.playerBounds.length, required)
                 );
             }
+            final int groupRequired = Math.multiplyExact(
+                Math.multiplyExact(divideCeil(playerCount, PREFILTER_GROUP_SIZE), PLAYER_BOXES), AABB_COMPONENTS
+            );
+            if (this.activationGroups.length < groupRequired) {
+                this.activationGroups = Arrays.copyOf(
+                    this.activationGroups,
+                    expandedCapacity(this.activationGroups.length, groupRequired)
+                );
+            }
         }
     }
 }
