diff --git a/src/test/java/org/leavesx/leavesx/performance/LongJumpCandidateBuildingTest.java b/src/test/java/org/leavesx/leavesx/performance/LongJumpCandidateBuildingTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..63f28399403772e8a42b6741423dd650e0a8d1bb
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/LongJumpCandidateBuildingTest.java
@@ -0,0 +1,118 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.google.common.collect.Lists;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.Collectors;
+import net.minecraft.core.BlockPos;
+import net.minecraft.util.Mth;
+import net.minecraft.world.entity.ai.behavior.LongJumpToRandomPos;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies long-jump candidates retain vanilla traversal order, positions and weights. */
+@Normal
+class LongJumpCandidateBuildingTest {
+
+    @Test
+    void directBuilderMatchesVanillaStreamForRepresentativeRanges() throws Exception {
+        final Method directBuilder = LongJumpToRandomPos.class.getDeclaredMethod(
+            "buildJumpCandidatesDirect",
+            BlockPos.class,
+            int.class,
+            int.class
+        );
+        directBuilder.setAccessible(true);
+
+        assertEquivalent(directBuilder, new BlockPos(0, 64, 0), 1, 1);
+        assertEquivalent(directBuilder, new BlockPos(-37, -20, 91), 2, 3);
+        assertEquivalent(directBuilder, new BlockPos(1_000, 200, -1_000), 0, 2);
+    }
+
+    @Test
+    void optimizedAndVanillaBuildersRemainSelectable() throws IOException {
+        final ClassNode behavior = classNode(LongJumpToRandomPos.class);
+        final List<MethodInsnNode> directCalls = invocations(method(behavior, "buildJumpCandidatesDirect"));
+        final List<MethodInsnNode> startCalls = behavior.methods.stream()
+            .filter(method -> method.name.equals("start"))
+            .flatMap(method -> invocations(method).stream())
+            .toList();
+
+        assertFalse(directCalls.stream().anyMatch(call -> call.name.equals("betweenClosedStream") || call.name.equals("collect")));
+        assertTrue(directCalls.stream().anyMatch(call -> call.name.equals("betweenClosed")));
+        assertTrue(directCalls.stream().anyMatch(call -> call.name.equals("immutable")));
+        assertTrue(directCalls.stream().anyMatch(call -> call.name.equals("add")));
+        assertTrue(startCalls.stream().anyMatch(call -> call.name.equals("longJumpCandidateOptimization")));
+        assertTrue(startCalls.stream().anyMatch(call -> call.name.equals("betweenClosedStream")));
+        assertTrue(startCalls.stream().anyMatch(call -> call.name.equals("collect")));
+    }
+
+    private static void assertEquivalent(
+        final Method directBuilder,
+        final BlockPos mobPos,
+        final int maxHeight,
+        final int maxWidth
+    ) throws Exception {
+        final List<LongJumpToRandomPos.PossibleJump> expected = vanillaCandidates(mobPos, maxHeight, maxWidth);
+        @SuppressWarnings("unchecked")
+        final List<LongJumpToRandomPos.PossibleJump> first =
+            (List<LongJumpToRandomPos.PossibleJump>)directBuilder.invoke(null, mobPos, maxHeight, maxWidth);
+        @SuppressWarnings("unchecked")
+        final List<LongJumpToRandomPos.PossibleJump> second =
+            (List<LongJumpToRandomPos.PossibleJump>)directBuilder.invoke(null, mobPos, maxHeight, maxWidth);
+
+        assertEquals(expected, first);
+        assertEquals(expected, second);
+        assertNotSame(first, second, "Each behavior start must retain vanilla's fresh-list ownership");
+    }
+
+    private static List<LongJumpToRandomPos.PossibleJump> vanillaCandidates(
+        final BlockPos mobPos,
+        final int maxHeight,
+        final int maxWidth
+    ) {
+        return BlockPos.betweenClosedStream(
+                mobPos.getX() - maxWidth,
+                mobPos.getY() - maxHeight,
+                mobPos.getZ() - maxWidth,
+                mobPos.getX() + maxWidth,
+                mobPos.getY() + maxHeight,
+                mobPos.getZ() + maxWidth
+            )
+            .filter(pos -> !pos.equals(mobPos))
+            .map(pos -> new LongJumpToRandomPos.PossibleJump(pos.immutable(), Mth.ceil(mobPos.distSqr(pos))))
+            .collect(Collectors.toCollection(Lists::newArrayList));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
