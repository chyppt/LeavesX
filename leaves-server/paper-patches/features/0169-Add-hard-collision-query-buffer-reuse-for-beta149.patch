         return entityQueryOptimizations && enabled(LeavesXOptimization.ENTITY_LOOKUP_VISIBILITY);
diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityCollisionHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityCollisionHotPathTest.java
index 5b5ccfa28a41cec78c07fdb76c6f871a8f6f2e06..1a8797a76b27ec92d6ce7e1a1c18f853bf3f4172 100644
--- a/src/test/java/org/leavesx/leavesx/performance/EntityCollisionHotPathTest.java
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityCollisionHotPathTest.java
@@ -104,6 +104,34 @@ class EntityCollisionHotPathTest {
         );
     }
 
+    @Test
+    void hardCollisionQueriesHaveAReentrantAllocationFreeInternalPath() throws IOException {
+        final List<MethodNode> methods = methodNodes(
+            ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.class,
+            "getEntityHardCollisions"
+        );
+        final MethodInsnNode[] calls = methods.stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertTrue(
+            Arrays.stream(calls).anyMatch(call ->
+                call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                    && call.name.equals("entityCollisionQueryBufferReuseOptimization")
+            ),
+            "hard-collision queries should be guarded by the LeavesX compatibility switch"
+        );
+        assertTrue(
+            Arrays.stream(calls).anyMatch(call ->
+                call.owner.equals("net/minecraft/world/level/Level")
+                    && call.name.equals("leavesX$acquireEntityQueryBuffer")
+            ),
+            "hard-collision queries should use the reentrancy-safe thread-local buffer"
+        );
+    }
+
     private static List<MethodNode> methodNodes(final Class<?> owner, final String methodName) throws IOException {
         final ClassNode classNode = new ClassNode(Opcodes.ASM9);
         new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
