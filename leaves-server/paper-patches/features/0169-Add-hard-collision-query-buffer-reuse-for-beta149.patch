+    /** Returns whether internal hard-collision entity queries may reuse a reentrant thread-local result buffer. */
+    public static boolean entityCollisionQueryBufferReuseOptimization() {
+        return entityQueryOptimizations && enabled(LeavesXOptimization.ENTITY_COLLISION_QUERY_BUFFER_REUSE);
+    }
+
     /** Returns whether Moonrise entity lookup may map chunk visibility without the generic enum helper. */
