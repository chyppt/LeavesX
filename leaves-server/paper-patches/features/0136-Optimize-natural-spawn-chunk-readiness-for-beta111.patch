+    @Test
+    void directWorldBorderChunkCheckMatchesChunkObjectCheck() {
+        final WorldBorder border = new WorldBorder();
+        border.setCenter(2.5D, -3.5D);
+        for (final double size : new double[] {1.0D, 32.0D, 65.0D, 128.0D}) {
+            border.setSize(size);
+            for (int chunkX = -10; chunkX <= 10; chunkX++) {
+                for (int chunkZ = -10; chunkZ <= 10; chunkZ++) {
+                    final boolean expected = border.isWithinBounds(new ChunkPos(chunkX, chunkZ));
+                    final boolean actual = border.isChunkWithinBounds(chunkX, chunkZ);
+                    if (expected != actual) {
+                        fail("World-border decision changed for chunk [" + chunkX + ", " + chunkZ + "] at size " + size);
+                    }
+                }
+            }
+        }
+    }
+
