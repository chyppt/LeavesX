@@ -128,6 +128,7 @@
     private static boolean naturalSpawnLocalCapAccountingOptimization = true;
     // Worker-owned light and chunk tasks read these masks. Volatile publication makes reload changes visible without
     // adding locks to any hot path.
+    private static volatile boolean parallelNoiseSampling = true;
     private static volatile long fineGrainedOptimizationMaskLow = LeavesXOptimization.allEnabledMaskLow();
     private static volatile long fineGrainedOptimizationMaskHigh = LeavesXOptimization.allEnabledMaskHigh();
     private static final int VILLAGER_FULL_COMPATIBILITY_CONTEXT = 1;
@@ -281,6 +282,7 @@
             && validated.optimizationEnabled(LeavesXOptimization.NATURAL_SPAWN_CHUNK_READINESS);
         naturalSpawnLocalCapAccountingOptimization = validated.mobSpawningOptimizations()
             && validated.optimizationEnabled(LeavesXOptimization.NATURAL_SPAWN_LOCAL_CAP_ACCOUNTING);
+        parallelNoiseSampling = validated.parallelNoiseSampling();
         fineGrainedOptimizationMaskLow = validated.fineGrainedOptimizationMaskLow();
         fineGrainedOptimizationMaskHigh = validated.fineGrainedOptimizationMaskHigh();
         configuration = validated;
@@ -1529,6 +1531,11 @@
         return mobSpawningOptimizations && enabled(LeavesXOptimization.NATURAL_SPAWN_STATE);
     }
 
+    /** Only detached noise samples may use the shared compute pool. */
+    public static boolean parallelNoiseSampling() {
+        return parallelNoiseSampling;
+    }
+
     private static boolean enabled(final LeavesXOptimization optimization) {
         return !villagerOptimizationContextActive()
             && optimization.enabledIn(fineGrainedOptimizationMaskLow, fineGrainedOptimizationMaskHigh);
