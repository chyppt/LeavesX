+    /** 以输出区间切分归并；二分确定左右游标，相等键始终优先取左边以保持稳定顺序。 */
+    private static void mergeOutputRange(
+        final int[] input, final int[] output, final long[] keys, final int size,
+        final int width, final int step, final int start, final int end
+    ) {
+        for (int from = start; from < end;) {
+            final int base = from / step * step;
+            final int middle = (int)Math.min(size, (long)base + width);
+            final int limit = (int)Math.min(size, (long)base + step);
+            final int to = Math.min(end, limit);
+            if (middle == limit || Long.compareUnsigned(keys[input[middle - 1]], keys[input[middle]]) <= 0) {
+                System.arraycopy(input, from, output, from, to - from);
+            } else {
+                final int rank = from - base;
+                int low = Math.max(0, rank - (limit - middle));
+                int high = Math.min(rank, middle - base);
+                while (low < high) {
+                    final int left = (low + high) >>> 1;
+                    final int right = rank - left;
+                    if (right > 0 && left < middle - base
+                        && Long.compareUnsigned(keys[input[middle + right - 1]], keys[input[base + left]]) >= 0) {
+                        low = left + 1;
+                    } else {
+                        high = left;
+                    }
+                }
+                int left = base + low;
+                int right = middle + rank - low;
+                for (int destination = from; destination < to; destination++) {
+                    if (left < middle && (right == limit
+                        || Long.compareUnsigned(keys[input[left]], keys[input[right]]) <= 0)) {
+                        output[destination] = input[left++];
+                    } else {
+                        output[destination] = input[right++];
+                    }
+                }
+            }
+            from = to;
+        }
+    }
