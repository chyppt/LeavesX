+    /** 已冻结的前缀可以提前计算；后续实时实体访问仍严格留在调用线程。 */
+    private static <T extends Entity> void sortEntitySnapshotPipeline(
+        final List<T> entities, final Workspace workspace, final int size,
+        final double originX, final double originY, final double originZ
+    ) {
+        workspace.ensureCoordinateCapacity(size);
+        // 以已经分配的直方图槽数为上限，热重载改变线程数也不会让片段越界。
+        final int rangeSize = Math.max(divideCeil(size, workspace.laneOffsets.length / RADIX_BUCKETS),
+            LeavesXSnapshotBatch.partitionSize(size, MIN_PIPELINE_ITEMS));
+        try (final LeavesXSnapshotBatch batch = new LeavesXSnapshotBatch(LeavesXComputeExecutor.Workload.AI_TARGET_SORT)) {
+            for (int start = 0, partition = 0; start < size; start += rangeSize, partition++) {
+                final int from = start;
+                final int to = (int)Math.min(size, (long)start + rangeSize);
+                final int offsetBase = partition * RADIX_BUCKETS;
+                for (int index = from; index < to; index++) {
+                    final Entity entity = entities.get(index);
+                    workspace.x[index] = entity.getX();
+                    workspace.y[index] = entity.getY();
+                    workspace.z[index] = entity.getZ();
+                }
+                batch.submit(to - from, () -> {
+                    computeDistanceKeysAndInitializeOrder(workspace, from, to, originX, originY, originZ);
+                    stableRadixRange(workspace.order, workspace.scratch, workspace.keys,
+                        from, to, workspace.laneOffsets, offsetBase);
+                });
+            }
+            if (!batch.finish()) {
+                // 必须重算全部距离键；失败片段可能只写了一部分键和索引。
+                computeDistanceKeysAndInitializeOrder(workspace, 0, size, originX, originY, originZ);
+                stableRadixRange(workspace.order, workspace.scratch, workspace.keys, 0, size, workspace.offsets, 0);
+                return;
+            }
+        }
+        // 尾片可能短于前面的片段，归并必须沿用实际片宽，不能由片数反推。
+        mergeSortedPartitions(workspace, size, rangeSize);
+    }
+
+    /** 最近索引查询与排序一样提前处理已冻结的片段，不把实时实体交给工作线程。 */
+    private static <T extends Entity> int findNearestSnapshotPipeline(
+        final List<T> entities, final Workspace workspace, final int size,
+        final double originX, final double originY, final double originZ
+    ) {
+        workspace.ensureCoordinateCapacity(size);
+        final int rangeSize = Math.max(divideCeil(size, workspace.nearestByPartition.length),
+            LeavesXSnapshotBatch.partitionSize(size, MIN_PIPELINE_ITEMS));
+        int partitions = 0;
+        try (final LeavesXSnapshotBatch batch = new LeavesXSnapshotBatch(LeavesXComputeExecutor.Workload.AI_TARGET_SELECT)) {
+            for (int start = 0; start < size; start += rangeSize) {
+                final int from = start;
+                final int to = (int)Math.min(size, (long)start + rangeSize);
+                final int partition = partitions++;
+                for (int index = from; index < to; index++) {
+                    final Entity entity = entities.get(index);
+                    workspace.x[index] = entity.getX();
+                    workspace.y[index] = entity.getY();
+                    workspace.z[index] = entity.getZ();
+                }
+                batch.submit(to - from, () -> workspace.nearestByPartition[partition]
+                    = computeDistanceKeysAndFindNearest(workspace, from, to, originX, originY, originZ));
+            }
+            if (!batch.finish()) {
+                return computeDistanceKeysAndFindNearest(workspace, 0, size, originX, originY, originZ);
+            }
+        }
+        return nearestPartitionWinner(workspace, partitions);
+    }
+
+    /** 按原片段顺序合并局部赢家；同距离只保留最早出现的实体。 */
+    private static int nearestPartitionWinner(final Workspace workspace, final int partitions) {
+        int nearest = -1;
+        for (int partition = 0; partition < partitions; partition++) {
+            final int candidate = workspace.nearestByPartition[partition];
+            if (candidate >= 0 && (nearest < 0
+                || Long.compareUnsigned(workspace.keys[candidate], workspace.keys[nearest]) < 0)) {
+                nearest = candidate;
+            }
+        }
+        return nearest;
     }
 
     /** 将独立排序的连续分片稳定归并。 */
