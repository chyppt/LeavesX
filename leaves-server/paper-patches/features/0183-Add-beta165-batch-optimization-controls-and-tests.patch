+    @Test
+    void serverChunkCacheBatchesPackedCallbacksBeforeTheMainThreadHandoff() throws IOException {
+        final ClassNode owner = classNode(ServerChunkCache.class);
+        assertTrue(owner.methods.stream().anyMatch(method -> method.name.equals("leavesX$enqueueLightUpdate")
+            && method.desc.equals("(Lnet/minecraft/world/level/LightLayer;J)V")));
+        assertTrue(owner.methods.stream().anyMatch(method -> method.name.equals("leavesX$drainLightUpdateBatch")
+            && method.desc.equals("()V")));
+
+        final ClassNode buffer = classNode("net.minecraft.server.level.ServerChunkCache$LeavesXLightUpdateBuffer");
+        assertTrue(buffer.fields.stream().anyMatch(field -> field.name.equals("sectionNodes")
+            && field.desc.equals("[J")));
+        assertTrue(buffer.fields.stream().anyMatch(field -> field.name.equals("skyLight")
+            && field.desc.equals("[Z")));
+    }
+
+    @Test
+    void primitiveBatchPreservesOrderAcrossGrowthAndCanBeReused() throws ReflectiveOperationException {
+        final Class<?> bufferClass = Class.forName(
+            "net.minecraft.server.level.ServerChunkCache$LeavesXLightUpdateBuffer"
+        );
+        final var constructor = bufferClass.getDeclaredConstructor();
+        constructor.setAccessible(true);
+        final Object buffer = constructor.newInstance();
+        final var add = bufferClass.getDeclaredMethod("add", boolean.class, long.class);
+        final var clear = bufferClass.getDeclaredMethod("clear");
+        final var empty = bufferClass.getDeclaredMethod("isEmpty");
+        final var sectionNodesField = bufferClass.getDeclaredField("sectionNodes");
+        final var skyLightField = bufferClass.getDeclaredField("skyLight");
+        final var sizeField = bufferClass.getDeclaredField("size");
+        for (final var member : java.util.List.of(add, clear, empty)) {
+            member.setAccessible(true);
+        }
+        for (final var field : java.util.List.of(sectionNodesField, skyLightField, sizeField)) {
+            field.setAccessible(true);
+        }
+
+        assertTrue((boolean)empty.invoke(buffer));
+        for (int index = 0; index < 1_500; ++index) {
+            add.invoke(buffer, (index & 1) == 0, 10_000L + index);
+        }
+
+        final long[] sectionNodes = (long[])sectionNodesField.get(buffer);
+        final boolean[] skyLight = (boolean[])skyLightField.get(buffer);
+        assertEquals(1_500, sizeField.getInt(buffer));
+        assertTrue(sectionNodes.length >= 1_500);
+        for (int index = 0; index < 1_500; ++index) {
+            assertEquals(10_000L + index, sectionNodes[index]);
+            assertEquals((index & 1) == 0, skyLight[index]);
+        }
+
+        clear.invoke(buffer);
+        assertTrue((boolean)empty.invoke(buffer));
+        assertEquals(0, sizeField.getInt(buffer));
+    }
+
     private static ClassNode classNode(final Class<?> owner) throws IOException {
         final ClassNode node = new ClassNode(Opcodes.ASM9);
         new ClassReader(owner.getName()).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
         return node;
     }
+
+    private static ClassNode classNode(final String binaryName) throws IOException {
+        final ClassNode node = new ClassNode(Opcodes.ASM9);
+        new ClassReader(binaryName).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return node;
+    }
