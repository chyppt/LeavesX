+    @Test
+    void upgradesVersion65WithConfigurableChunkAndLightBatching() throws Exception {
+        final Path path = write("""
+            # 用户配置。
+            config-version: 65
+            performance:
+              network:
+                light-update-notification-batching: false
+              chunk:
+                unload-stage-buffer-reuse: false
+            custom-extension:
+              retained: true
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        final String upgraded = Files.readString(path);
+        final org.spongepowered.configurate.ConfigurationNode node =
+            io.papermc.paper.configuration.ConfigurationLoaders.naturallySortedWithoutHeader(path).load();
+
+        assertEquals(66, node.node("config-version").getInt());
