index 0000000000000000000000000000000000000000..459a81187f542f7db75ec1dd314324552aa3762d
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkSchedulerBufferReuseHotPathTest.java
@@ -0,0 +1,64 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import java.io.IOException;
+import java.util.Arrays;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies tick-thread chunk scheduling retains only private, explicitly configurable scratch lists. */
+@Normal
+class ChunkSchedulerBufferReuseHotPathTest {
+
+    @Test
+    void managerOwnsSeparateScratchListsForEachLifecyclePhase() throws IOException {
+        final ClassNode owner = classNode(ChunkHolderManager.class);
+        for (final String fieldName : new String[] {
+            "leavesX$unloadStage1",
+            "leavesX$unloadStage2",
+            "leavesX$unloadStage3",
+            "leavesX$autosaveReschedule",
+            "leavesX$fullStatusChanges"
+        }) {
+            assertTrue(owner.fields.stream().anyMatch(field -> field.name.equals(fieldName)
+                && field.desc.equals("Ljava/util/ArrayList;")), fieldName);
+        }
+    }
+
+    @Test
+    void eachHotPathConsultsItsDedicatedRuntimeSwitch() throws IOException {
+        final ClassNode owner = classNode(ChunkHolderManager.class);
+        assertRuntimeSwitch(owner, "autoSave", "chunkAutosaveBufferReuseOptimization");
+        assertRuntimeSwitch(owner, "processUnloads", "chunkUnloadStageBufferReuseOptimization");
+        assertRuntimeSwitch(owner, "processPendingFullUpdate", "chunkStatusUpdateBufferReuseOptimization");
+    }
+
+    private static void assertRuntimeSwitch(
+        final ClassNode owner,
+        final String methodName,
+        final String runtimeMethod
+    ) {
+        final MethodNode method = owner.methods.stream()
+            .filter(candidate -> candidate.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing " + methodName));
+        assertTrue(Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                && call.name.equals(runtimeMethod)), runtimeMethod);
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode node = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return node;
+    }
+}
