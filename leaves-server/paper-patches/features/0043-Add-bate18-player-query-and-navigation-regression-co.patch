+++ b/src/test/java/org/leavesx/leavesx/performance/PathNavigationHotPathTest.java
@@ -0,0 +1,102 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.List;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.navigation.GroundPathNavigation;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.pathfinder.Node;
+import net.minecraft.world.level.pathfinder.Path;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class PathNavigationHotPathTest {
+
+    @Test
+    void followPathReadsTheNodeWithoutCreatingABlockPosition() {
+        final Mob mob = mock(Mob.class);
+        when(mob.getX()).thenReturn(8.5);
+        when(mob.getY()).thenReturn(64.0);
+        when(mob.getZ()).thenReturn(-3.5);
+        when(mob.getBbWidth()).thenReturn(0.6F);
+
+        final Node node = new Node(8, 64, -4);
+        final Path path = mock(Path.class);
+        when(path.getNextNode()).thenReturn(node);
+        doThrow(new AssertionError("The hot path must not allocate through getNextNodePos()"))
+            .when(path).getNextNodePos();
+
+        final TestNavigation navigation = new TestNavigation(mob, mock(Level.class));
+        navigation.follow(path);
+
+        verify(path).advance();
+        assertEquals(0.45F, navigation.getMaxDistanceToWaypoint(), 0.0001F);
+    }
+
+    @Test
+    void recomputeCheckMatchesTheOriginalMidpointCalculation() {
+        final Mob mob = mock(Mob.class);
+        when(mob.getX()).thenReturn(18.25);
+        when(mob.getY()).thenReturn(67.5);
+        when(mob.getZ()).thenReturn(-11.75);
+
+        final Node target = new Node(28, 72, -3);
+        final Path path = new Path(
+            List.of(new Node(20, 68, -10), new Node(24, 70, -7), target),
+            BlockPos.ZERO,
+            false
+        );
+        path.setNextNodeIndex(1);
+        final TestNavigation navigation = new TestNavigation(mob, mock(Level.class));
+        navigation.setPath(path);
+
+        final Vec3 middle = new Vec3(
+            (target.x + mob.getX()) / 2.0,
+            (target.y + mob.getY()) / 2.0,
+            (target.z + mob.getZ()) / 2.0
+        );
+        final double remainingNodes = path.getNodeCount() - path.getNextNodeIndex();
+        for (int x = 18; x <= 28; x++) {
+            for (int y = 66; y <= 74; y++) {
+                for (int z = -13; z <= -1; z++) {
+                    final BlockPos position = new BlockPos(x, y, z);
+                    assertEquals(position.closerToCenterThan(middle, remainingNodes), navigation.shouldRecomputePath(position));
+                }
+            }
+        }
+    }
+
+    private static final class TestNavigation extends GroundPathNavigation {
+
+        private TestNavigation(final Mob mob, final Level level) {
+            super(mob, level);
+        }
+
+        private void follow(final Path path) {
+            this.path = path;
+            this.followThePath();
+        }
+
+        private void setPath(final Path path) {
+            this.path = path;
+        }
+
+        @Override
+        protected Vec3 getTempMobPos() {
+            return new Vec3(this.mob.getX(), this.mob.getY(), this.mob.getZ());
+        }
+
+        @Override
+        protected void doStuckDetection(final Vec3 mobPos) {
+            // Stuck detection is independent from selecting and advancing the current node.
+        }
+    }
+}
