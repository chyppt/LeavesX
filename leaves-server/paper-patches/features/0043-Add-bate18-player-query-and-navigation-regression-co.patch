diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityGetterPlayerQueryTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityGetterPlayerQueryTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1ba54290d50a7b710c52250cc100e18b04df8674
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityGetterPlayerQueryTest.java
@@ -0,0 +1,168 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.anyDouble;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.doReturn;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.AbstractList;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Random;
+import java.util.function.Predicate;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.level.EntityGetter;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class EntityGetterPlayerQueryTest {
+
+    private static final int PLAYER_COUNT = 32;
+
+    @Test
+    void nearestPlayerUsesIndexedTraversalWithoutChangingSelection() {
+        final double[] distances = new double[PLAYER_COUNT];
+        final List<Player> players = createPlayers(distances);
+        final EntityGetter getter = getterWith(indexOnly(players));
+        final Random random = new Random(0x4C454156455358L);
+
+        for (int iteration = 0; iteration < 1_000; iteration++) {
+            final boolean[] accepted = new boolean[PLAYER_COUNT];
+            for (int index = 0; index < PLAYER_COUNT; index++) {
+                distances[index] = randomDistance(random);
+                accepted[index] = random.nextBoolean();
+            }
+
+            final double range = randomRange(random);
+            final Predicate<Entity> predicate = player -> accepted[players.indexOf(player)];
+            final Player expected = referenceNearest(players, distances, range, predicate);
+
+            assertSame(expected, getter.getNearestPlayer(12.5, 64.0, -7.25, range, predicate));
+        }
+    }
+
+    @Test
+    void nearestPlayerPreservesBoundaryTieAndNonFiniteSemantics() {
+        final double[] distances = {25.0, 25.0, Double.NaN, Double.POSITIVE_INFINITY};
+        final List<Player> players = createPlayers(distances);
+        final EntityGetter getter = getterWith(indexOnly(players));
+
+        assertNull(getter.getNearestPlayer(0.0, 0.0, 0.0, 5.0, null), "The range boundary is exclusive");
+        assertSame(players.getFirst(), getter.getNearestPlayer(0.0, 0.0, 0.0, 6.0, null), "Equal distances keep list order");
+        assertNull(getter.getNearestPlayer(0.0, 0.0, 0.0, Double.NaN, null));
+
+        distances[0] = Double.NaN;
+        assertSame(players.getFirst(), getter.getNearestPlayer(0.0, 0.0, 0.0, -1.0, null));
+    }
+
+    @Test
+    void nearestPlayerPreservesPredicateInvocationOrder() {
+        final double[] distances = {9.0, 4.0, 1.0};
+        final List<Player> players = createPlayers(distances);
+        final EntityGetter getter = getterWith(indexOnly(players));
+        final List<Player> visited = new ArrayList<>();
+
+        getter.getNearestPlayer(0.0, 0.0, 0.0, 16.0, entity -> {
+            visited.add((Player)entity);
+            return entity != players.get(1);
+        });
+
+        assertEquals(players, visited);
+    }
+
+    @Test
+    void nearbyAlivePlayerQueriesUseTheSameIndexedTraversal() {
+        final double[] distances = {16.0, 4.0};
+        final List<Player> players = createPlayers(distances);
+        when(players.get(0).isAlive()).thenReturn(false);
+        when(players.get(1).isAlive()).thenReturn(true);
+        players.get(1).affectsSpawning = true;
+        final EntityGetter getter = getterWith(indexOnly(players));
+
+        assertTrue(getter.hasNearbyAlivePlayer(0.0, 0.0, 0.0, 3.0));
+        assertTrue(getter.hasNearbyAlivePlayerThatAffectsSpawning(0.0, 0.0, 0.0, 3.0));
+    }
+
+    private static EntityGetter getterWith(final List<Player> players) {
+        final EntityGetter getter = mock(EntityGetter.class, CALLS_REAL_METHODS);
+        doReturn(players).when(getter).players();
+        return getter;
+    }
+
+    private static List<Player> createPlayers(final double[] distances) {
+        final List<Player> players = new ArrayList<>(distances.length);
+        for (int index = 0; index < distances.length; index++) {
+            final Player player = mock(Player.class);
+            final int distanceIndex = index;
+            when(player.distanceToSqr(anyDouble(), anyDouble(), anyDouble()))
+                .thenAnswer(invocation -> distances[distanceIndex]);
+            players.add(player);
+        }
+        return players;
+    }
+
+    private static List<Player> indexOnly(final List<Player> players) {
+        return new AbstractList<>() {
+            @Override
+            public Player get(final int index) {
+                return players.get(index);
+            }
+
+            @Override
+            public int size() {
+                return players.size();
+            }
+
+            @Override
+            public Iterator<Player> iterator() {
+                throw new AssertionError("LeavesX player queries must not allocate an iterator");
+            }
+        };
+    }
+
+    private static Player referenceNearest(
+        final List<Player> players,
+        final double[] distances,
+        final double range,
+        final Predicate<Entity> predicate
+    ) {
+        double best = -1.0;
+        Player result = null;
+        for (int index = 0; index < players.size(); index++) {
+            final Player player = players.get(index);
+            if (predicate == null || predicate.test(player)) {
+                final double distance = distances[index];
+                if ((range < 0.0 || distance < range * range) && (best == -1.0 || distance < best)) {
+                    best = distance;
+                    result = player;
+                }
+            }
+        }
+        return result;
+    }
+
+    private static double randomDistance(final Random random) {
+        return switch (random.nextInt(20)) {
+            case 0 -> Double.NaN;
+            case 1 -> Double.POSITIVE_INFINITY;
+            default -> random.nextDouble(0.0, 65_536.0);
+        };
+    }
+
+    private static double randomRange(final Random random) {
+        return switch (random.nextInt(20)) {
+            case 0 -> -1.0;
+            case 1 -> Double.NaN;
+            case 2 -> Double.POSITIVE_INFINITY;
+            default -> random.nextDouble(0.0, 256.0);
+        };
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/PathNavigationHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/PathNavigationHotPathTest.java
