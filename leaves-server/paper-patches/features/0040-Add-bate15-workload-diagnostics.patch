+    private static BlockEntitySnapshot collectBlockEntities(final List<World> worlds) {
+        final Map<Identifier, MutableBlockEntityCount> counts = new HashMap<>();
+        final List<BlockEntityHotspot> hotspots = new ArrayList<>();
+        int total = 0;
+        int ticking = 0;
+
+        for (final World world : worlds) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            final LongOpenHashSet tickingPositions = new LongOpenHashSet(level.blockEntityTickers.size());
+            for (final TickingBlockEntity ticker : level.blockEntityTickers) {
+                if (!ticker.isRemoved()) {
+                    tickingPositions.add(ticker.getPos().asLong());
+                }
+            }
+
+            for (final ChunkHolder holder : ca.spottedleaf.moonrise.common.PlatformHooks.get().getVisibleChunkHolders(level)) {
+                final LevelChunk chunk = holder.getTickingChunk();
+                if (chunk == null || chunk.blockEntities.isEmpty()) {
+                    continue;
+                }
+
+                int chunkTotal = 0;
+                int chunkTicking = 0;
+                for (final BlockEntity blockEntity : chunk.blockEntities.values()) {
+                    final Identifier type = BuiltInRegistries.BLOCK_ENTITY_TYPE.getKey(blockEntity.getType());
+                    final boolean isTicking = tickingPositions.contains(blockEntity.getBlockPos().asLong());
+                    final MutableBlockEntityCount count = counts.computeIfAbsent(type, ignored -> new MutableBlockEntityCount());
+                    count.total++;
+                    total++;
+                    chunkTotal++;
+                    if (isTicking) {
+                        count.ticking++;
+                        ticking++;
+                        chunkTicking++;
+                    }
+                }
+                hotspots.add(new BlockEntityHotspot(
+                    world.getKey().toString(),
+                    chunk.getPos().x(),
+                    chunk.getPos().z(),
+                    chunkTotal,
+                    chunkTicking
+                ));
+            }
+        }
+        return new BlockEntitySnapshot(counts, hotspots, total, ticking);
+    }
