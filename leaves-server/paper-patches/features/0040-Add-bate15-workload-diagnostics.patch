+    private static void sendBlockEntities(final CommandSender sender, final String[] args) {
+        final Selection selection = selectWorldsAndLimit(sender, args);
+        if (selection == null) {
+            return;
+        }
+
+        final BlockEntitySnapshot snapshot = collectBlockEntities(selection.worlds());
+        final List<Map.Entry<Identifier, MutableBlockEntityCount>> ordered = new ArrayList<>(snapshot.counts().entrySet());
+        ordered.sort(Comparator.<Map.Entry<Identifier, MutableBlockEntityCount>>comparingInt(entry -> entry.getValue().total)
+            .reversed().thenComparing(entry -> entry.getKey().toString()));
+
+        sendHeader(sender, "方块实体类型");
+        sender.sendMessage(Component.text(
+            "总数 " + snapshot.total() + "，更新 " + snapshot.ticking() + "，休眠 " + (snapshot.total() - snapshot.ticking()),
+            NamedTextColor.GRAY
+        ));
+        for (int index = 0; index < Math.min(selection.limit(), ordered.size()); index++) {
+            final Map.Entry<Identifier, MutableBlockEntityCount> entry = ordered.get(index);
+            final MutableBlockEntityCount count = entry.getValue();
+            sender.sendMessage(Component.text(
+                (index + 1) + ". " + entry.getKey() + "：" + count.total + "（更新 " + count.ticking + "）",
+                count.total >= 1_000 ? NamedTextColor.RED : count.total >= 250 ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+            ));
+        }
+    }
