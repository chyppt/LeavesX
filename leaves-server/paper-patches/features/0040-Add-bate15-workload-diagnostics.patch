+    private static void sendTickets(final CommandSender sender, final String[] args) {
+        final Selection selection = selectWorldsAndLimit(sender, args);
+        if (selection == null) {
+            return;
+        }
+
+        final Map<String, MutableTicketCount> counts = new HashMap<>();
+        final List<PluginTicketCount> pluginTickets = new ArrayList<>();
+        int sourceChunks = 0;
+        int ticketCount = 0;
+        for (final World world : selection.worlds()) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            final Long2ObjectMap<Collection<Ticket>> tickets = level.moonrise$getChunkTaskScheduler()
+                .chunkHolderManager.getTicketsCopy();
+            sourceChunks += tickets.size();
+
+            for (final Long2ObjectMap.Entry<Collection<Ticket>> entry : tickets.long2ObjectEntrySet()) {
+                final Set<String> typesAtChunk = new HashSet<>();
+                for (final Ticket ticket : entry.getValue()) {
+                    final String typeName = ticketTypeName(ticket.getType());
+                    final MutableTicketCount count = counts.computeIfAbsent(typeName, ignored -> new MutableTicketCount(ticket.getType()));
+                    count.tickets++;
+                    count.minimumLevel = Math.min(count.minimumLevel, ticket.getTicketLevel());
+                    count.maximumLevel = Math.max(count.maximumLevel, ticket.getTicketLevel());
+                    typesAtChunk.add(typeName);
+                    ticketCount++;
+                }
+                for (final String typeName : typesAtChunk) {
+                    counts.get(typeName).sourceChunks++;
+                }
+            }
+
+            for (final Map.Entry<Plugin, Collection<Chunk>> entry : world.getPluginChunkTickets().entrySet()) {
+                pluginTickets.add(new PluginTicketCount(
+                    world.getKey().toString(),
+                    entry.getKey().getName(),
+                    entry.getValue().size()
+                ));
+            }
+        }
+
+        final List<Map.Entry<String, MutableTicketCount>> ordered = new ArrayList<>(counts.entrySet());
+        ordered.sort(Comparator.<Map.Entry<String, MutableTicketCount>>comparingInt(entry -> entry.getValue().sourceChunks)
+            .reversed()
+            .thenComparing(Comparator.comparingInt((Map.Entry<String, MutableTicketCount> entry) -> entry.getValue().tickets).reversed())
+            .thenComparing(Map.Entry::getKey));
+        sendHeader(sender, "区块票据来源");
+        sender.sendMessage(Component.text("源区块 " + sourceChunks + "，票据 " + ticketCount, NamedTextColor.GRAY));
+        for (int index = 0; index < Math.min(selection.limit(), ordered.size()); index++) {
+            final Map.Entry<String, MutableTicketCount> entry = ordered.get(index);
+            final MutableTicketCount count = entry.getValue();
+            sender.sendMessage(Component.text(
+                (index + 1) + ". " + entry.getKey() + "：" + count.tickets + " 个票据 / " + count.sourceChunks
+                    + " 个源区块 / 等级 " + formatLevelRange(count.minimumLevel, count.maximumLevel) + ticketFlags(count.type),
+                count.sourceChunks >= 1_000 ? NamedTextColor.RED : count.sourceChunks >= 250 ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+            ));
+        }
+
+        pluginTickets.sort(Comparator.comparingInt(PluginTicketCount::chunks).reversed()
+            .thenComparing(PluginTicketCount::plugin).thenComparing(PluginTicketCount::world));
+        if (!pluginTickets.isEmpty()) {
+            sender.sendMessage(Component.text("插件强制区块：", NamedTextColor.GOLD));
+            for (int index = 0; index < Math.min(selection.limit(), pluginTickets.size()); index++) {
+                final PluginTicketCount entry = pluginTickets.get(index);
+                sender.sendMessage(Component.text(
+                    (index + 1) + ". " + entry.plugin() + " / " + entry.world() + "：" + entry.chunks(),
+                    entry.chunks() >= 250 ? NamedTextColor.RED : entry.chunks() >= 50 ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+                ));
+            }
+        }
+        sender.sendMessage(Component.text("说明：源票据会向周围传播，因此源区块数通常小于实际持有器数量。", NamedTextColor.GRAY));
+    }
