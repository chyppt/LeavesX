+    private static String formatLevelRange(final int minimum, final int maximum) {
+        return minimum == maximum ? Integer.toString(minimum) : minimum + "-" + maximum;
+    }
+
+    private static String ticketFlags(final TicketType<?> type) {
+        if (type.doesLoad() && type.doesSimulate()) {
+            return "（加载、模拟）";
+        }
+        if (type.doesSimulate()) {
+            return "（模拟）";
+        }
+        if (type.doesLoad()) {
+            return "（加载）";
+        }
+        return "";
+    }
+
+    private static String ticketTypeName(final TicketType<?> type) {
+        final Identifier registeredName = BuiltInRegistries.TICKET_TYPE.getKey(type);
+        if (registeredName != null) {
+            return registeredName.toString();
+        }
+        if (type == RegionizedPlayerChunkLoader.PLAYER_TICKET) {
+            return "chunk_system:player_ticket";
+        }
+        if (type == RegionizedPlayerChunkLoader.PLAYER_TICKET_DELAYED) {
+            return "chunk_system:player_ticket_delayed";
+        }
+        if (type == ChunkHolderManager.UNLOAD_COOLDOWN) {
+            return "chunk_system:unload_cooldown";
+        }
+        if (type == ChunkTaskScheduler.CHUNK_LOAD) {
+            return "chunk_system:chunk_load";
+        }
+        if (type == ChunkTaskScheduler.NON_FULL_CHUNK_LOAD) {
+            return "chunk_system:non_full_load";
+        }
+        if (type == ChunkTaskScheduler.ENTITY_LOAD) {
+            return "chunk_system:entity_load";
+        }
+        if (type == ChunkTaskScheduler.POI_LOAD) {
+            return "chunk_system:poi_load";
+        }
+        if (type == ChunkTaskScheduler.CHUNK_RELIGHT) {
+            return "starlight:chunk_relight";
+        }
+        if (type == StarLightInterface.CHUNK_WORK_TICKET) {
+            return "starlight:chunk_work_ticket";
+        }
+        return "internal#" + ((ChunkSystemTicketType<?>)(Object)type).moonrise$getId();
+    }
+
