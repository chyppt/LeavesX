                 BlockPos representativePosition = null;
                 for (final BlockEntity blockEntity : chunk.blockEntities.values()) {
                     final BlockPos blockPosition = blockEntity.getBlockPos();
-                    // A diagnostic command can race a ticker rebind during chunk unload. Such a transient entry has
-                    // no meaningful position and must not turn a read-only report into a server-thread exception.
