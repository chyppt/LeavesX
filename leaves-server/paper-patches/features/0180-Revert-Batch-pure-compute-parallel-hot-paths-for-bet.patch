-    private static final int AI_TARGET_SEARCH_PROFITABLE_FLOOR = 256;
-    private static final int AI_TARGET_SEARCH_MINIMUM_ITEMS_FLOOR = 128;
-    // AABB intersection is cheaper than AI distance sorting, so it retains a larger profitability floor. The
-    // primitive snapshot also provides a strict ownership boundary: workers never receive live entities or worlds.
-    private static final int ENTITY_ACTIVATION_PROFITABLE_FLOOR = 2_048;
-    private static final int ENTITY_ACTIVATION_MINIMUM_ITEMS_FLOOR = 512;
-    private static final int MOB_SPAWN_COUNTING_PROFITABLE_FLOOR = 2_048;
+    private static final int AI_TARGET_SEARCH_PROFITABLE_FLOOR = 512;
+    private static final int AI_TARGET_SEARCH_MINIMUM_ITEMS_FLOOR = 256;
+    // AABB intersection is much cheaper than AI distance sorting. Measurements on the target 9950X host show that
+    // worker dispatch becomes worthwhile only for unusually large per-player candidate batches.
+    private static final int ENTITY_ACTIVATION_PROFITABLE_FLOOR = 8_192;
+    private static final int ENTITY_ACTIVATION_MINIMUM_ITEMS_FLOOR = 1_024;
+    private static final int MOB_SPAWN_COUNTING_PROFITABLE_FLOOR = 65_536;
 
