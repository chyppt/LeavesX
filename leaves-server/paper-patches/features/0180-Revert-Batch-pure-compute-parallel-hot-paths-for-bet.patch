                     final boolean isTicking = tickingPositions.contains(blockPosition.asLong());
                     final MutableBlockEntityCount count = counts.computeIfAbsent(type, ignored -> new MutableBlockEntityCount());
@@ -525,18 +520,16 @@ public final class LeavesXCommand extends Command {
                         chunkTicking++;
                     }
                 }
-                if (representativePosition != null) {
-                    hotspots.add(new BlockEntityHotspot(
-                        world.getKey().toString(),
-                        chunk.getPos().x(),
-                        chunk.getPos().z(),
-                        representativePosition.getX(),
-                        representativePosition.getY(),
-                        representativePosition.getZ(),
-                        chunkTotal,
-                        chunkTicking
-                    ));
-                }
+                hotspots.add(new BlockEntityHotspot(
+                    world.getKey().toString(),
+                    chunk.getPos().x(),
+                    chunk.getPos().z(),
+                    representativePosition.getX(),
+                    representativePosition.getY(),
+                    representativePosition.getZ(),
+                    chunkTotal,
+                    chunkTicking
+                ));
             }
         }
         return new BlockEntitySnapshot(counts, hotspots, total, ticking);
