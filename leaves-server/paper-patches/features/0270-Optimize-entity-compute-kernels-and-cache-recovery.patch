+    /** 最近目标只归约分片赢家；不分配排序索引，也不为每个候选写回距离。 */
+    private static <T extends Entity> int findNearestReduced(
+        final List<T> entities, final Entity origin, final boolean parallel, final int threshold
+    ) {
+        final int size = entities.size();
+        final double originX = origin.getX();
+        final double originY = origin.getY();
+        final double originZ = origin.getZ();
+        final boolean eligible = parallel && LeavesXComputeExecutor.shouldAttempt(
+            LeavesXComputeExecutor.Workload.AI_TARGET_SELECT, size, threshold,
+            LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker());
+        if (!eligible) {
+            final SelectionWorkspace cached = SELECTION_WORKSPACE.get();
+            final int cacheLimit = LeavesXRuntime.asyncSettings().kernels().cacheMaxCandidates();
+            if (!cached.inUse && cached.x.length > cacheLimit && (cacheLimit == 0 || size <= cacheLimit)) {
+                SELECTION_WORKSPACE.remove();
+            }
+            int nearest = -1;
+            double best = 0.0;
+            for (int index = 0; index < size; index++) {
+                final Entity entity = entities.get(index);
+                final double distance = squaredDistance(originX, originY, originZ, entity.getX(), entity.getY(), entity.getZ());
+                if (nearest < 0 || Double.compare(distance, best) < 0) {
+                    nearest = index;
+                    best = distance;
+                }
+            }
+            return nearest;
+        }
+
+        final SelectionWorkspace cached = SELECTION_WORKSPACE.get();
+        final int cacheLimit = LeavesXRuntime.asyncSettings().kernels().cacheMaxCandidates();
+        if (!cached.inUse && cached.x.length > cacheLimit && size <= cacheLimit) {
+            SELECTION_WORKSPACE.remove();
+        }
+        final SelectionWorkspace workspace = cached.inUse ? new SelectionWorkspace() : SELECTION_WORKSPACE.get();
+        workspace.inUse = true;
+        try {
+            workspace.ensureCapacity(size);
+            final int completed;
+            if (size > MIN_PIPELINE_ITEMS && LeavesXRuntime.asyncSettings().aiSnapshotPipeline()) {
+                final int width = Math.max(divideCeil(size, 64), LeavesXSnapshotBatch.partitionSize(size, MIN_PIPELINE_ITEMS));
+                int partitions = 0;
+                try (var batch = new LeavesXSnapshotBatch(LeavesXComputeExecutor.Workload.AI_TARGET_SELECT)) {
+                    for (int from = 0; from < size; from += width) {
+                        final int start = from;
+                        final int end = (int)Math.min(size, (long)start + width);
+                        final int partition = partitions++;
+                        captureSelectionCoordinates(entities, workspace, start, end);
+                        batch.submit(end - start, () -> workspace.reduce(partition, start, end, originX, originY, originZ));
+                    }
+                    completed = batch.finish() ? partitions : 0;
+                }
+            } else {
+                captureSelectionCoordinates(entities, workspace, 0, size);
+                completed = LeavesXComputeExecutor.invokeRangesWithCount(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SELECT, size, threshold,
+                    LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker(),
+                    (partition, start, end) -> workspace.reduce(partition, start, end, originX, originY, originZ));
+            }
+            if (completed == 0) workspace.reduce(0, 0, size, originX, originY, originZ);
+            int nearest = -1;
+            double best = 0.0;
+            for (int partition = 0; partition < Math.max(1, completed); partition++) {
+                final int candidate = workspace.winners[partition];
+                final double distance = workspace.distances[partition];
+                if (candidate >= 0 && (nearest < 0 || Double.compare(distance, best) < 0)) {
+                    nearest = candidate;
+                    best = distance;
+                }
+            }
+            return nearest;
+        } finally {
