+        node.node("performance", "compute", "ai-nearest-reduction").set(true);
+        publish(node);
+        assertThrows(IllegalStateException.class, () -> StableDistanceSorter.findNearestIndex(failing, origin, true, 256));
+        assertEquals(stable.size() - 1, StableDistanceSorter.findNearestIndex(stable, origin, true, 256));
