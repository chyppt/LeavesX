+        final List<Entity> failing = new java.util.AbstractList<>() {
+            @Override public Entity get(final int index) {
+                final int read = reads.incrementAndGet();
+                if (index == stable.size() - 1 && read > stable.size() && fail.getAndSet(false)) {
+                    throw new IllegalStateException("injected snapshot failure");
+                }
+                return stable.get(index);
+            }
+            @Override public int size() { return stable.size(); }
+        };
