     /**
+     * 仅重排冻结的数值框，使四人并集靠近实际位置；玩家状态读取和激活结果提交顺序保持不变。
+     * 先稳定排序索引，再整块复制各类型框，不能只移动 maxBB 而错配其他类型范围。
+     */
+    static void spatiallyOrderPlayerBounds(final double[] bounds, final double[] scratch,
+                                           final int[] order, final int[] orderScratch, final int players) {
+        if (players < 16) return;
+        final int stride = PLAYER_BOXES * AABB_COMPONENTS;
+        boolean ordered = true;
+        double minX = Double.POSITIVE_INFINITY;
+        double maxX = Double.NEGATIVE_INFINITY;
+        double minZ = Double.POSITIVE_INFINITY;
+        double maxZ = Double.NEGATIVE_INFINITY;
+        for (int player = 0; player < players; player++) {
+            order[player] = player;
+            if (player > 0 && comparePlayerBounds(bounds, player - 1, player, stride) > 0) ordered = false;
+            minX = Math.min(minX, bounds[player * stride]);
+            maxX = Math.max(maxX, bounds[player * stride]);
+            minZ = Math.min(minZ, bounds[player * stride + 2]);
+            maxZ = Math.max(maxZ, bounds[player * stride + 2]);
+        }
+        if (ordered) return;
+        // 玩家都聚在一个激活框宽度以内时，重分组没有可观裁剪空间，保留原分组。
+        if (maxX - minX <= bounds[3] - bounds[0] && maxZ - minZ <= bounds[5] - bounds[2]) return;
+        int[] input = order;
+        int[] output = orderScratch;
+        for (int width = 1; width < players; width = width >= players - width ? players : width * 2) {
+            for (int start = 0; start < players;) {
+                final int middle = (int)Math.min(players, (long)start + width);
+                final int end = (int)Math.min(players, (long)middle + width);
+                int left = start;
+                int right = middle;
+                for (int destination = start; destination < end; destination++) {
+                    if (left < middle && (right == end
+                        || comparePlayerBounds(bounds, input[left], input[right], stride) <= 0)) {
+                        output[destination] = input[left++];
+                    } else output[destination] = input[right++];
+                }
+                start = end;
+            }
+            final int[] swap = input;
+            input = output;
+            output = swap;
+        }
+        for (int player = 0; player < players; player++) {
+            System.arraycopy(bounds, input[player] * stride, scratch, player * stride, stride);
+        }
+        System.arraycopy(scratch, 0, bounds, 0, players * stride);
+    }
+
+    private static int comparePlayerBounds(final double[] bounds, final int first, final int second, final int stride) {
+        final int byX = Double.compare(bounds[first * stride], bounds[second * stride]);
+        return byX != 0 ? byX : Double.compare(bounds[first * stride + 2], bounds[second * stride + 2]);
+    }
+
+    /**
      * Activates one player's candidate list when the batch is large enough to amortize a primitive snapshot.
      *
      * @return {@code true} when this method handled the list; {@code false} requests Paper's direct loop
@@ -656,7 +716,12 @@
