+package org.leavesx.leavesx.command;
+
+import io.papermc.paper.FeatureHooks;
+import it.unimi.dsi.fastutil.longs.Long2IntMap;
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+import java.lang.management.BufferPoolMXBean;
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryUsage;
+import java.lang.management.ThreadMXBean;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.minecraft.core.SectionPos;
+import net.minecraft.network.Connection;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.level.ChunkPos;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.NamespacedKey;
+import org.bukkit.World;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.entity.Player;
+import org.bukkit.util.StringUtil;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+/** Built-in, main-thread-safe performance diagnostics for LeavesX operators. */
+public final class LeavesXCommand extends Command {
+
+    private static final List<String> SUBCOMMANDS = List.of(
+        "status", "worlds", "entities", "hotspots", "memory", "network", "threads", "config", "help"
+    );
+
+    public LeavesXCommand(final String name) {
+        super(name);
+        this.description = "查看 LeavesX 服务器性能状态";
+        this.usageMessage = "/leavesx <status|worlds|entities|hotspots|memory|network|threads|config>";
+        this.setPermission("leavesx.command.performance");
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String commandLabel, final String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        final String subcommand = args.length == 0 ? "status" : args[0].toLowerCase(Locale.ROOT);
+        switch (subcommand) {
+            case "status" -> sendStatus(sender);
+            case "worlds" -> sendWorlds(sender);
+            case "entities" -> sendEntities(sender, args);
+            case "hotspots" -> sendHotspots(sender, args);
+            case "memory" -> sendMemory(sender);
+            case "network" -> sendNetwork(sender);
+            case "threads" -> sendThreads(sender);
+            case "config" -> sendConfig(sender);
+            case "help" -> sendHelp(sender);
+            default -> {
+                sender.sendMessage(Component.text("未知子命令：" + subcommand, NamedTextColor.RED));
+                sendHelp(sender);
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(
+        final CommandSender sender,
+        final String alias,
+        final String[] args,
+        final Location location
+    ) {
+        if (args.length == 1) {
+            return StringUtil.copyPartialMatches(args[0], SUBCOMMANDS, new ArrayList<>());
+        }
+        if ((args[0].equalsIgnoreCase("entities") || args[0].equalsIgnoreCase("hotspots")) && args.length == 2) {
+            final List<String> worlds = new ArrayList<>();
+            for (final World world : Bukkit.getWorlds()) {
+                worlds.add(world.getKey().toString());
+            }
+            return StringUtil.copyPartialMatches(args[1], worlds, new ArrayList<>());
+        }
+        return List.of();
+    }
+
+    private static void sendStatus(final CommandSender sender) {
+        final double[] tps = Bukkit.getTPS();
+        int chunks = 0;
+        long pendingUnloads = 0L;
+        int entities = 0;
+        for (final World world : Bukkit.getWorlds()) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            chunks += level.getChunkSource().getFullChunksCount();
+            pendingUnloads += level.moonrise$getChunkTaskScheduler().chunkHolderManager.leavesX$getPendingUnloadCount();
+            entities += level.getEntityCount();
+        }
+
+        final Runtime runtime = Runtime.getRuntime();
+        final long usedHeap = runtime.totalMemory() - runtime.freeMemory();
+        sendHeader(sender, "LeavesX 性能概览");
+        sender.sendMessage(line("TPS", formatTps(tps), tpsColor(tps[0])));
+        sender.sendMessage(line("MSPT", oneDecimal(Bukkit.getAverageTickTime()) + " ms", msptColor(Bukkit.getAverageTickTime())));
+        sender.sendMessage(line("区块", chunks + " 已加载 / " + pendingUnloads + " 待卸载", NamedTextColor.AQUA));
+        sender.sendMessage(line("实体", Integer.toString(entities), entityColor(entities)));
+        sender.sendMessage(line("内存", formatBytes(usedHeap) + " / " + formatBytes(runtime.maxMemory()), NamedTextColor.AQUA));
+        sender.sendMessage(Component.text("详细：/leavesx worlds | entities | hotspots | memory | network | threads", NamedTextColor.GRAY));
+    }
+
+    private static void sendWorlds(final CommandSender sender) {
+        sendHeader(sender, "世界负载");
+        for (final World world : Bukkit.getWorlds()) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            int tickingEntities = 0;
+            for (final net.minecraft.world.entity.Entity entity : FeatureHooks.getAllEntities(level)) {
+                if (level.isPositionEntityTicking(entity.blockPosition())) {
+                    tickingEntities++;
+                }
+            }
+            final long pendingUnloads = level.moonrise$getChunkTaskScheduler()
+                .chunkHolderManager.leavesX$getPendingUnloadCount();
+            sender.sendMessage(Component.text()
+                .append(Component.text(world.getKey().toString(), NamedTextColor.GOLD))
+                .append(Component.text(" 区块 " + level.getChunkSource().getFullChunksCount(), NamedTextColor.AQUA))
+                .append(Component.text(" / 持有器 " + level.getChunkSource().getLoadedChunksCount(), NamedTextColor.GRAY))
+                .append(Component.text(" / 待卸载 " + pendingUnloads, pendingUnloads == 0 ? NamedTextColor.GREEN : NamedTextColor.YELLOW))
+                .append(Component.text(" / 实体 " + level.getEntityCount() + "(" + tickingEntities + " 活跃)", NamedTextColor.AQUA))
+                .append(Component.text(" / 方块实体 " + world.getTileEntityCount() + "(" + world.getTickableTileEntityCount() + " 更新)", NamedTextColor.GRAY))
+                .build());
+        }
+    }
+
+    private static void sendEntities(final CommandSender sender, final String[] args) {
+        final Selection selection = selectWorldsAndLimit(sender, args);
+        if (selection == null) {
+            return;
+        }
+
+        final Map<Identifier, MutableEntityCount> counts = new HashMap<>();
+        int total = 0;
+        int ticking = 0;
+        for (final World world : selection.worlds()) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            for (final net.minecraft.world.entity.Entity entity : FeatureHooks.getAllEntities(level)) {
+                final boolean entityTicking = level.isPositionEntityTicking(entity.blockPosition());
+                final MutableEntityCount count = counts.computeIfAbsent(EntityType.getKey(entity.getType()), ignored -> new MutableEntityCount());
+                count.total++;
+                total++;
+                if (entityTicking) {
+                    count.ticking++;
+                    ticking++;
+                }
+            }
+        }
+
+        final List<Map.Entry<Identifier, MutableEntityCount>> ordered = new ArrayList<>(counts.entrySet());
+        ordered.sort(Comparator.<Map.Entry<Identifier, MutableEntityCount>>comparingInt(entry -> entry.getValue().total)
+            .reversed().thenComparing(entry -> entry.getKey().toString()));
+        sendHeader(sender, "实体类型");
+        sender.sendMessage(Component.text("总数 " + total + "，活跃 " + ticking + "，非活跃 " + (total - ticking), NamedTextColor.GRAY));
+        for (int index = 0; index < Math.min(selection.limit(), ordered.size()); index++) {
+            final Map.Entry<Identifier, MutableEntityCount> entry = ordered.get(index);
+            final MutableEntityCount count = entry.getValue();
+            sender.sendMessage(Component.text(
+                (index + 1) + ". " + entry.getKey() + "：" + count.total + "（活跃 " + count.ticking + "）",
+                count.total >= 1_000 ? NamedTextColor.RED : count.total >= 250 ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+            ));
+        }
+    }
+
+    private static void sendHotspots(final CommandSender sender, final String[] args) {
+        final Selection selection = selectWorldsAndLimit(sender, args);
+        if (selection == null) {
+            return;
+        }
+
+        final List<EntityHotspot> hotspots = new ArrayList<>();
+        for (final World world : selection.worlds()) {
+            final ServerLevel level = ((CraftWorld)world).getHandle();
+            final Long2IntOpenHashMap totals = new Long2IntOpenHashMap();
+            final Long2IntOpenHashMap ticking = new Long2IntOpenHashMap();
+            for (final net.minecraft.world.entity.Entity entity : FeatureHooks.getAllEntities(level)) {
+                final long chunkKey = ChunkPos.pack(
+                    SectionPos.blockToSectionCoord(entity.getBlockX()),
+                    SectionPos.blockToSectionCoord(entity.getBlockZ())
+                );
+                totals.addTo(chunkKey, 1);
+                if (level.isPositionEntityTicking(entity.blockPosition())) {
+                    ticking.addTo(chunkKey, 1);
+                }
+            }
+            for (final Long2IntMap.Entry entry : totals.long2IntEntrySet()) {
+                hotspots.add(new EntityHotspot(
+                    world.getKey().toString(),
+                    ChunkPos.getX(entry.getLongKey()),
+                    ChunkPos.getZ(entry.getLongKey()),
+                    entry.getIntValue(),
+                    ticking.get(entry.getLongKey())
+                ));
+            }
+        }
+
+        hotspots.sort(Comparator.comparingInt(EntityHotspot::total).reversed()
+            .thenComparing(EntityHotspot::world).thenComparingInt(EntityHotspot::chunkX).thenComparingInt(EntityHotspot::chunkZ));
+        sendHeader(sender, "实体密集区块");
+        for (int index = 0; index < Math.min(selection.limit(), hotspots.size()); index++) {
+            final EntityHotspot hotspot = hotspots.get(index);
+            sender.sendMessage(Component.text(
+                (index + 1) + ". " + hotspot.world() + " 区块[" + hotspot.chunkX() + ", " + hotspot.chunkZ()
+                    + "] 方块中心[" + ((hotspot.chunkX() << 4) + 8) + ", " + ((hotspot.chunkZ() << 4) + 8)
+                    + "]：" + hotspot.total() + "（活跃 " + hotspot.ticking() + "）",
+                hotspot.total() >= 250 ? NamedTextColor.RED : hotspot.total() >= 100 ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+            ));
+        }
+        if (hotspots.isEmpty()) {
+            sender.sendMessage(Component.text("没有找到实体。", NamedTextColor.GRAY));
+        }
+    }
+
+    private static void sendMemory(final CommandSender sender) {
+        final MemoryUsage heap = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
+        final MemoryUsage nonHeap = ManagementFactory.getMemoryMXBean().getNonHeapMemoryUsage();
+        long directUsed = 0L;
+        long directCapacity = 0L;
+        long mappedUsed = 0L;
+        for (final BufferPoolMXBean pool : ManagementFactory.getPlatformMXBeans(BufferPoolMXBean.class)) {
+            if (pool.getName().equals("direct")) {
+                directUsed = pool.getMemoryUsed();
+                directCapacity = pool.getTotalCapacity();
+            } else if (pool.getName().equals("mapped")) {
+                mappedUsed = pool.getMemoryUsed();
+            }
+        }
+        long collections = 0L;
+        long collectionTime = 0L;
+        for (final GarbageCollectorMXBean collector : ManagementFactory.getGarbageCollectorMXBeans()) {
+            collections += Math.max(0L, collector.getCollectionCount());
+            collectionTime += Math.max(0L, collector.getCollectionTime());
+        }
+
+        sendHeader(sender, "内存状态");
+        sender.sendMessage(line("堆内存", formatUsage(heap), NamedTextColor.AQUA));
+        sender.sendMessage(line("非堆内存", formatUsage(nonHeap), NamedTextColor.AQUA));
+        sender.sendMessage(line("直接缓冲区", formatBytes(directUsed) + " / " + formatBytes(directCapacity), NamedTextColor.AQUA));
+        sender.sendMessage(line("映射文件", formatBytes(mappedUsed), NamedTextColor.AQUA));
+        sender.sendMessage(line("GC", collections + " 次 / " + collectionTime + " ms", NamedTextColor.GRAY));
+    }
+
+    private static void sendNetwork(final CommandSender sender) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        final List<Connection> connections = server.getConnection().getConnections();
+        double inboundPackets = 0.0D;
+        double outboundPackets = 0.0D;
+        int pendingActions = 0;
+        int nonWritable = 0;
+        int connectionCount;
+        synchronized (connections) {
+            connectionCount = connections.size();
+            for (final Connection connection : connections) {
+                inboundPackets += connection.getAverageReceivedPackets();
+                outboundPackets += connection.getAverageSentPackets();
+                pendingActions += connection.leavesX$getPendingActionCount();
+                if (connection.channel != null && !connection.channel.isWritable()) {
+                    nonWritable++;
+                }
+            }
+        }
+
+        int totalPing = 0;
+        int maximumPing = 0;
+        for (final Player player : Bukkit.getOnlinePlayers()) {
+            final int ping = Math.max(0, player.getPing());
+            totalPing += ping;
+            maximumPing = Math.max(maximumPing, ping);
+        }
+        final int playerCount = Bukkit.getOnlinePlayers().size();
+        final int averagePing = playerCount == 0 ? 0 : totalPing / playerCount;
+        sendHeader(sender, "网络状态");
+        sender.sendMessage(line("连接", connectionCount + "（玩家 " + playerCount + "）", NamedTextColor.AQUA));
+        sender.sendMessage(line("数据包/秒", "接收 " + oneDecimal(inboundPackets) + " / 发送 " + oneDecimal(outboundPackets), NamedTextColor.AQUA));
+        sender.sendMessage(line("延迟", "平均 " + averagePing + " ms / 最大 " + maximumPing + " ms", maximumPing >= 200 ? NamedTextColor.RED : NamedTextColor.GREEN));
+        sender.sendMessage(line("发送队列", pendingActions + " 待处理 / " + nonWritable + " 不可写连接", nonWritable == 0 ? NamedTextColor.GREEN : NamedTextColor.YELLOW));
+    }
+
+    private static void sendThreads(final CommandSender sender) {
+        final LeavesXComputeExecutor.Metrics metrics = LeavesXComputeExecutor.metrics();
+        final ThreadMXBean threads = ManagementFactory.getThreadMXBean();
+        sendHeader(sender, "线程状态");
+        sender.sendMessage(line(
+            "LeavesX 计算线程",
+            metrics.activeWorkers() + " 活跃 / " + metrics.workers() + " 总数 / " + metrics.queuedTasks() + " 排队",
+            metrics.queuedTasks() == 0 ? NamedTextColor.GREEN : NamedTextColor.YELLOW
+        ));
+        sender.sendMessage(line(
+            "并行调用",
+            metrics.parallelInvocations() + " 成功 / " + metrics.synchronousFallbacks() + " 主线程回退 / "
+                + metrics.failedInvocations() + " 失败",
+            metrics.failedInvocations() == 0 ? NamedTextColor.AQUA : NamedTextColor.RED
+        ));
+        sender.sendMessage(line(
+            "JVM 线程",
+            threads.getThreadCount() + " 当前 / " + threads.getPeakThreadCount() + " 峰值 / " + threads.getDaemonThreadCount() + " 守护",
+            NamedTextColor.GRAY
+        ));
+    }
+
+    private static void sendConfig(final CommandSender sender) {
+        final LeavesXConfig config = LeavesXRuntime.configuration();
+        sendHeader(sender, "LeavesX 配置状态");
+        sender.sendMessage(line("AI/寻路", onOff(config.aiOptimizations()) + " / " + onOff(config.pathfindingOptimizations()), NamedTextColor.AQUA));
+        sender.sendMessage(line("动物空闲降频", onOff(config.animalIdleGoalThrottling()) + "，倍数 " + config.animalIdleGoalIntervalMultiplier(), config.animalIdleGoalThrottling() ? NamedTextColor.YELLOW : NamedTextColor.GREEN));
+        sender.sendMessage(line("刷怪并行", onOff(config.parallelMobSpawnCounting()) + "，阈值 " + config.mobSpawnCountingMinimumEntities(), NamedTextColor.AQUA));
+        sender.sendMessage(line("目标距离并行", onOff(config.parallelAiTargetSearch()) + "，阈值 " + config.aiTargetSearchMinimumCandidates(), NamedTextColor.AQUA));
+        sender.sendMessage(line("区块卸载", onOff(config.adaptiveChunkUnloading()) + "，预算 " + config.chunkUnloadMinimumPerTick() + '-' + config.chunkUnloadMaximumPerTick(), NamedTextColor.AQUA));
+        sender.sendMessage(line("网络 flush 合并", onOff(config.networkFlushConsolidation()), NamedTextColor.AQUA));
+    }
+
+    private static void sendHelp(final CommandSender sender) {
+        sendHeader(sender, "命令帮助");
+        sender.sendMessage(Component.text("/leavesx status - TPS、MSPT、区块、实体和内存总览", NamedTextColor.GRAY));
+        sender.sendMessage(Component.text("/leavesx worlds - 各世界区块、卸载队列、实体和方块实体", NamedTextColor.GRAY));
+        sender.sendMessage(Component.text("/leavesx entities [世界] [数量] - 实体类型排行", NamedTextColor.GRAY));
+        sender.sendMessage(Component.text("/leavesx hotspots [世界] [数量] - 实体密集区块坐标", NamedTextColor.GRAY));
+        sender.sendMessage(Component.text("/leavesx memory|network|threads|config - 对应详细状态", NamedTextColor.GRAY));
+    }
+
+    private static Selection selectWorldsAndLimit(final CommandSender sender, final String[] args) {
+        final List<World> worlds;
+        if (args.length >= 2 && !isInteger(args[1]) && !args[1].equalsIgnoreCase("all")) {
+            final World world = findWorld(args[1]);
+            if (world == null) {
+                sender.sendMessage(Component.text("找不到世界：" + args[1], NamedTextColor.RED));
+                return null;
+            }
+            worlds = List.of(world);
+        } else {
+            worlds = Bukkit.getWorlds();
+        }
+
+        int limit = LeavesXRuntime.diagnosticsDefaultResultLimit();
+        final String limitArgument = args.length >= 3 ? args[2] : args.length >= 2 && isInteger(args[1]) ? args[1] : null;
+        if (limitArgument != null) {
+            try {
+                limit = Math.clamp(Integer.parseInt(limitArgument), 1, 50);
+            } catch (final NumberFormatException ignored) {
+                sender.sendMessage(Component.text("数量必须是 1 到 50 的整数。", NamedTextColor.RED));
+                return null;
+            }
+        }
+        return new Selection(worlds, limit);
+    }
+
+    private static World findWorld(final String input) {
+        final NamespacedKey key = NamespacedKey.fromString(input);
+        final World byKey = key == null ? null : Bukkit.getWorld(key);
+        return byKey == null ? Bukkit.getWorld(input) : byKey;
+    }
+
+    private static boolean isInteger(final String value) {
+        if (value.isEmpty()) {
+            return false;
+        }
+        int index = value.charAt(0) == '-' ? 1 : 0;
+        if (index == value.length()) {
+            return false;
+        }
+        for (; index < value.length(); index++) {
+            if (!Character.isDigit(value.charAt(index))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static void sendHeader(final CommandSender sender, final String title) {
+        sender.sendMessage(Component.text("----- " + title + " -----", NamedTextColor.GOLD));
+    }
+
+    private static Component line(final String label, final String value, final NamedTextColor valueColor) {
+        return Component.text().append(Component.text(label + "：", NamedTextColor.GRAY))
+            .append(Component.text(value, valueColor)).build();
+    }
+
+    private static String formatTps(final double[] tps) {
+        return oneDecimal(Math.min(20.0D, tps[0])) + " / " + oneDecimal(Math.min(20.0D, tps[1])) + " / "
+            + oneDecimal(Math.min(20.0D, tps[2]));
+    }
+
+    private static String formatUsage(final MemoryUsage usage) {
+        return formatBytes(usage.getUsed()) + " / " + formatBytes(usage.getCommitted()) + " / " + formatBytes(usage.getMax());
+    }
+
+    private static String formatBytes(final long bytes) {
+        if (bytes < 0L) {
+            return "未知";
+        }
+        final double gibibytes = bytes / 1_073_741_824.0D;
+        if (gibibytes >= 1.0D) {
+            return oneDecimal(gibibytes) + " GiB";
+        }
+        return oneDecimal(bytes / 1_048_576.0D) + " MiB";
+    }
+
+    private static String oneDecimal(final double value) {
+        return String.format(Locale.ROOT, "%.1f", value);
+    }
+
+    private static String onOff(final boolean enabled) {
+        return enabled ? "开启" : "关闭";
+    }
+
+    private static NamedTextColor tpsColor(final double tps) {
+        return tps >= 18.0D ? NamedTextColor.GREEN : tps >= 15.0D ? NamedTextColor.YELLOW : NamedTextColor.RED;
+    }
+
+    private static NamedTextColor msptColor(final double mspt) {
+        return mspt < 40.0D ? NamedTextColor.GREEN : mspt < 50.0D ? NamedTextColor.YELLOW : NamedTextColor.RED;
+    }
+
+    private static NamedTextColor entityColor(final int entities) {
+        return entities < 2_000 ? NamedTextColor.GREEN : entities < 5_000 ? NamedTextColor.YELLOW : NamedTextColor.RED;
+    }
+
+    private static final class MutableEntityCount {
+
+        private int total;
+        private int ticking;
+    }
+
+    private record Selection(List<World> worlds, int limit) {
+    }
+
+    private record EntityHotspot(String world, int chunkX, int chunkZ, int total, int ticking) {
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
index 86b281a1782d04ffda9d415cd7e39b0f8f56a8be..58c892d3f0d0590ee02f708550baa04133293419 100644
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
@@ -3,20 +3,27 @@ package org.leavesx.leavesx.config;
 /**
  * Immutable LeavesX runtime configuration.
  *
