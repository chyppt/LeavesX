@@ -0,0 +1,33 @@
+package org.leavesx.leavesx.performance;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import net.minecraft.world.level.pathfinder.Node;
+
+/** Reconstructs a path node chain in linear time while preserving the vanilla start-to-target order. */
+public final class PathNodeListBuilder {
+
+    private PathNodeListBuilder() {
+    }
+
+    /**
+     * Copies the {@link Node#cameFrom} chain into a mutable list ordered from the path start to {@code closest}.
+     *
+     * @param closest final node selected by the path finder
+     * @return mutable node list in vanilla order
+     */
+    public static List<Node> build(final Node closest) {
+        int nodeCount = 0;
+        for (Node node = closest; node != null; node = node.cameFrom) {
+            nodeCount++;
+        }
+
+        final List<Node> nodes = new ArrayList<>(nodeCount);
+        for (Node node = closest; node != null; node = node.cameFrom) {
+            nodes.add(node);
+        }
+        Collections.reverse(nodes);
+        return nodes;
+    }
+}
