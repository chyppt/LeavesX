+    public static int scaleInterval(final int vanillaInterval, final int multiplier) {
+        if (vanillaInterval <= 0 || multiplier <= 1) {
+            return vanillaInterval;
+        }
+        return (int)Math.min(Integer.MAX_VALUE, (long)vanillaInterval * multiplier);
+    }
+
+    /** Returns the equivalent lower activation chance for random look goals. */
+    public static float scaleChance(final float vanillaChance, final int multiplier) {
+        return multiplier <= 1 ? vanillaChance : vanillaChance / multiplier;
+    }
+}
