+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import java.util.List;
+import net.minecraft.world.level.pathfinder.Node;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class PathNodeListBuilderTest {
+
+    @Test
+    void preservesStartToTargetOrderForLongChains() {
+        final Node start = new Node(0, 64, 0);
+        Node closest = start;
+        for (int index = 1; index < 1_000; index++) {
+            final Node next = new Node(index, 64, index / 2);
+            next.cameFrom = closest;
+            closest = next;
+        }
+
+        final List<Node> nodes = PathNodeListBuilder.build(closest);
+
+        assertEquals(1_000, nodes.size());
+        assertSame(start, nodes.getFirst());
+        assertSame(closest, nodes.getLast());
+        for (int index = 1; index < nodes.size(); index++) {
+            assertSame(nodes.get(index - 1), nodes.get(index).cameFrom);
+        }
+    }
+}
