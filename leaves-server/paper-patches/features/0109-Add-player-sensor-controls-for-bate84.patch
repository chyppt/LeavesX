diff --git a/src/test/java/org/leavesx/leavesx/performance/PlayerSensorHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/PlayerSensorHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..b4423542e4783b3f8612064c5877f3c099dc189c
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/PlayerSensorHotPathTest.java
@@ -0,0 +1,52 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ai.sensing.PlayerSensor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies player sensing keeps allocation-light loops and the vanilla stream fallback. */
+@Normal
+class PlayerSensorHotPathTest {
+
+    @Test
+    void sensorKeepsDirectAndVanillaPaths() throws IOException {
+        final List<MethodInsnNode> calls = invocations(method(classNode(PlayerSensor.class), "doTick"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("playerSensorOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValue")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("sort")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("stream")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("collect")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("toList")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
