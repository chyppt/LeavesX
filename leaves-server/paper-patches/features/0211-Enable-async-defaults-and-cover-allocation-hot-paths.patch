@@ -0,0 +1,66 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.entity.BeaconBlockEntity;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Locks the beacon scan optimization to allocation-free mutable position traversal. */
+@Normal
+class BeaconScanAllocationHotPathTest {
+
+    @Test
+    void beamAndBaseScansReuseOneMutablePosition() throws IOException {
+        final ClassNode owner = new ClassNode();
+        new ClassReader(BeaconBlockEntity.class.getName()).accept(owner, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+
+        assertTrue(owner.fields.stream().map(FieldNode.class::cast).anyMatch(field ->
+            field.name.equals("leavesX$scanPosition")
+                && field.desc.equals("Lnet/minecraft/core/BlockPos$MutableBlockPos;")
+        ));
+        assertNoBlockPosAllocation(method(owner, "tick"));
+        assertNoBlockPosAllocation(method(owner, "updateBase"));
+        assertNoArrayListAllocation(method(owner, "tick"));
+        assertTrue(callsMutableSetter(method(owner, "tick")));
+        assertTrue(callsMutableSetter(method(owner, "updateBase")));
+    }
+
+    private static void assertNoArrayListAllocation(final MethodNode method) {
+        assertFalse(java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0), false
+        ).filter(TypeInsnNode.class::isInstance).map(TypeInsnNode.class::cast).anyMatch(instruction ->
+            instruction.getOpcode() == Opcodes.NEW && instruction.desc.equals("java/util/ArrayList")
+        ));
+    }
+
+    private static void assertNoBlockPosAllocation(final MethodNode method) {
+        assertFalse(method.instructions.iterator().hasNext() && java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0), false
+        ).filter(TypeInsnNode.class::isInstance).map(TypeInsnNode.class::cast).anyMatch(instruction ->
+            instruction.getOpcode() == Opcodes.NEW && instruction.desc.equals("net/minecraft/core/BlockPos")
+        ));
+    }
+
+    private static boolean callsMutableSetter(final MethodNode method) {
+        return java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0), false
+        ).filter(MethodInsnNode.class::isInstance).map(MethodInsnNode.class::cast).anyMatch(call ->
+            call.owner.equals("net/minecraft/core/BlockPos$MutableBlockPos") && call.name.equals("set")
+        );
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream().filter(method -> method.name.equals(name)).findFirst().orElseThrow();
+    }
+}
