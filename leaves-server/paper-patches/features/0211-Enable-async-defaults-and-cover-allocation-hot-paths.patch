@@ -0,0 +1,52 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import net.minecraft.server.level.ChunkMap;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Guards the allocation-free steady-state layout of asynchronous entity tracking snapshots. */
+@Normal
+class EntityTrackerSnapshotReuseHotPathTest {
+
+    @Test
+    void trackerReusesOneFlattenedSnapshot() throws IOException, ClassNotFoundException {
+        final ClassNode chunkMap = classNode(ChunkMap.class);
+        final ClassNode trackedEntity = classNode(ChunkMap.TrackedEntity.class);
+        final ClassNode snapshot = classNode(Class.forName("net.minecraft.server.level.ChunkMap$LeavesXTrackerSnapshot"));
+
+        assertTrue(chunkMap.fields.stream().anyMatch(field -> field.name.equals("leavesX$trackerSnapshots")));
+        assertTrue(trackedEntity.fields.stream().anyMatch(field -> field.name.equals("leavesX$trackerSnapshot")));
+        assertTrue(snapshot.fields.stream().anyMatch(field ->
+            field.name.equals("playerData") && field.desc.equals("[D")
+        ));
+        assertFalse(snapshot.fields.stream().anyMatch(field ->
+            field.name.equals("playerX") || field.name.equals("playerY") || field.name.equals("playerZ")
+        ));
+
+        final MethodNode create = trackedEntity.methods.stream()
+            .filter(method -> method.name.equals("leavesX$createTrackerSnapshot"))
+            .findFirst()
+            .orElseThrow();
+        assertFalse(java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(create.instructions.iterator(), 0), false
+        ).filter(TypeInsnNode.class::isInstance).map(TypeInsnNode.class::cast).anyMatch(instruction ->
+            instruction.getOpcode() == Opcodes.NEW
+                && instruction.desc.equals("net/minecraft/server/level/ChunkMap$LeavesXTrackerSnapshot")
+        ));
+    }
+
+    private static ClassNode classNode(final Class<?> type) throws IOException {
+        final ClassNode node = new ClassNode();
+        new ClassReader(type.getName()).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return node;
+    }
+}
