diff --git a/src/test/java/org/leavesx/leavesx/command/LeavesXCommandSafetyTest.java b/src/test/java/org/leavesx/leavesx/command/LeavesXCommandSafetyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..9a6d7c3b57e28d9d38a400f0f93c2431082e348a
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/command/LeavesXCommandSafetyTest.java
@@ -0,0 +1,79 @@
+package org.leavesx.leavesx.command;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.JumpInsnNode;
+import org.objectweb.asm.tree.LdcInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Locks down operator-facing diagnostic safety fixes. */
+@Normal
+class LeavesXCommandSafetyTest {
+
+    private static final String REMOVED_SAMPLING_MESSAGE = "完整诊断分 12 个 Tick 采样，避免命令本身造成长 Tick。";
+
+    @Test
+    void allReportNoLongerPrintsTheSamplingImplementationMessage() throws IOException {
+        final ClassNode report = classNode(LeavesXCommand.class.getName() + "$AllReport");
+
+        assertFalse(report.methods.stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(LdcInsnNode.class::isInstance)
+            .map(LdcInsnNode.class::cast)
+            .anyMatch(constant -> REMOVED_SAMPLING_MESSAGE.equals(constant.cst)));
+    }
+
+    @Test
+    void blockEntityDiagnosticsGuardNullableTickerPositions() throws IOException {
+        final MethodNode collect = method(classNode(LeavesXCommand.class.getName()), "collectBlockEntities");
+        final AbstractInsnNode[] instructions = collect.instructions.toArray();
+        final int positionRead = findCall(instructions, "net/minecraft/world/level/block/entity/TickingBlockEntity", "getPos");
+        final int packedPosition = findCallAfter(instructions, positionRead, "net/minecraft/core/BlockPos", "asLong");
+
+        assertTrue(Arrays.stream(instructions, positionRead + 1, packedPosition)
+            .filter(JumpInsnNode.class::isInstance)
+            .map(JumpInsnNode.class::cast)
+            .anyMatch(jump -> jump.getOpcode() == Opcodes.IFNULL || jump.getOpcode() == Opcodes.IFNONNULL));
+    }
+
+    private static ClassNode classNode(final String className) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static int findCall(final AbstractInsnNode[] instructions, final String owner, final String name) {
+        return findCallAfter(instructions, -1, owner, name);
+    }
+
+    private static int findCallAfter(
+        final AbstractInsnNode[] instructions,
+        final int start,
+        final String owner,
+        final String name
+    ) {
+        for (int index = start + 1; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing call " + owner + '#' + name);
+    }
+}
