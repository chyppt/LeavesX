+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.entity.BlockEntityType;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies the block-entity type cache retains an exact original-query fallback. */
+@Normal
+class BlockEntityTypeValidationHotPathTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void dedicatedSwitchRespectsTheBlockEntityMasterSwitch() throws Exception {
+        try {
+            publish(this.configuration(true, true, "enabled.yml"));
+            assertTrue(LeavesXRuntime.blockEntityTypeValidationOptimization());
+
+            publish(this.configuration(true, false, "setting-disabled.yml"));
+            assertFalse(LeavesXRuntime.blockEntityTypeValidationOptimization());
+
+            publish(this.configuration(false, true, "master-disabled.yml"));
+            assertFalse(LeavesXRuntime.blockEntityTypeValidationOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void version38ConfigurationGainsTheDocumentedDefaultInPlace() throws IOException {
+        final Path path = this.tempDir.resolve("version-38.yml");
+        Files.writeString(path, """
+            config-version: 38
+            performance:
+              block-entity-optimizations: true
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        final String upgraded = Files.readString(path);
+
+        assertTrue(config.enabledFineGrainedOptimizationCount() > 0);
+        assertTrue(upgraded.contains("config-version: 39"));
+        assertTrue(upgraded.contains("type-validation: true"));
+        assertFalse(Files.exists(this.tempDir.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.tempDir.resolve("leavesx-migration-report.yml")));
+    }
+
+    @Test
+    void validationBytecodeKeepsIdentityAndExactFallbackPaths() throws IOException {
+        final ClassNode blockEntityType = classNode(BlockEntityType.class);
+        final MethodNode constructor = method(blockEntityType, "<init>");
+        final MethodNode isValid = method(blockEntityType, "isValid");
+
+        assertTrue(hasCall(
+            isValid,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "blockEntityTypeValidationOptimization"
+        ));
+        assertTrue(hasCall(isValid, "java/util/Set", "contains"), "Duplicate mappings must retain the exact Set fallback");
+        assertTrue(hasField(isValid, Block.class, "leavesX$blockEntityType"));
+        assertTrue(hasField(isValid, Block.class, "leavesX$multipleBlockEntityTypes"));
+        assertTrue(hasField(constructor, Block.class, "leavesX$blockEntityType"));
+        assertTrue(hasField(constructor, Block.class, "leavesX$multipleBlockEntityTypes"));
+    }
+
+    private LeavesXConfig configuration(
+        final boolean masterEnabled,
+        final boolean settingEnabled,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              block-entity-optimizations: %s
+              block-entity:
+                type-validation: %s
+            """.formatted(masterEnabled, settingEnabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode(final Class<?> type) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(type.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static boolean hasCall(final MethodNode method, final String owner, final String name) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+
+    private static boolean hasField(final MethodNode method, final Class<?> owner, final String name) {
+        final String internalOwner = owner.getName().replace('.', '/');
+        return Arrays.stream(method.instructions.toArray())
+            .filter(FieldInsnNode.class::isInstance)
+            .map(FieldInsnNode.class::cast)
+            .anyMatch(field -> field.owner.equals(internalOwner) && field.name.equals(name));
+    }
+}
