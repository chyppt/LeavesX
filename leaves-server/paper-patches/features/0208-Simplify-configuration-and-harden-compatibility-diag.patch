+++ b/src/test/java/org/leavesx/leavesx/performance/LithiumLowRiskHotPathTest.java
@@ -0,0 +1,84 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import net.minecraft.core.AxisCycle;
+import net.minecraft.core.Direction;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.phys.AABB;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Differential coverage for behavior-equivalent Lithium hot-path ports. */
+@Normal
+class LithiumLowRiskHotPathTest {
+
+    @Test
+    void axisCyclesPreserveTheThreeVanillaMappings() {
+        assertSame(Direction.Axis.Y, AxisCycle.FORWARD.cycle(Direction.Axis.X));
+        assertSame(Direction.Axis.Z, AxisCycle.FORWARD.cycle(Direction.Axis.Y));
+        assertSame(Direction.Axis.X, AxisCycle.FORWARD.cycle(Direction.Axis.Z));
+        assertSame(Direction.Axis.Z, AxisCycle.BACKWARD.cycle(Direction.Axis.X));
+        assertSame(Direction.Axis.X, AxisCycle.BACKWARD.cycle(Direction.Axis.Y));
+        assertSame(Direction.Axis.Y, AxisCycle.BACKWARD.cycle(Direction.Axis.Z));
+    }
+
+    @Test
+    void aabbAxisSelectionPreservesAllComponents() {
+        final AABB bounds = new AABB(-7.5D, -2.0D, 3.25D, 11.0D, 13.5D, 19.75D);
+
+        assertEquals(-7.5D, bounds.min(Direction.Axis.X));
+        assertEquals(-2.0D, bounds.min(Direction.Axis.Y));
+        assertEquals(3.25D, bounds.min(Direction.Axis.Z));
+        assertEquals(11.0D, bounds.max(Direction.Axis.X));
+        assertEquals(13.5D, bounds.max(Direction.Axis.Y));
+        assertEquals(19.75D, bounds.max(Direction.Axis.Z));
+    }
+
+    @Test
+    void directDirectionSelectionConsumesTheSameRandomSequence() {
+        final RandomSource expectedRandom = RandomSource.create(0x5EEDL);
+        final RandomSource actualRandom = RandomSource.create(0x5EEDL);
+        final Direction[] directions = Direction.values();
+        for (int sample = 0; sample < 4_096; sample++) {
+            assertSame(
+                directions[expectedRandom.nextInt(directions.length)],
+                Direction.getRandom(actualRandom)
+            );
+        }
+    }
+
+    @Test
+    void idleEntityStateGuardsRemainControlledByTheExistingMasterSwitch() throws IOException {
+        assertCallsRuntimeSwitch("updateSwingTime");
+        assertCallsRuntimeSwitch("updateFallFlying");
+    }
+
+    private static void assertCallsRuntimeSwitch(final String methodName) throws IOException {
+        final ClassNode owner = new ClassNode();
+        new ClassReader(LivingEntity.class.getName()).accept(owner, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        final MethodNode method = owner.methods.stream()
+            .filter(candidate -> candidate.name.equals(methodName))
+            .findFirst()
+            .orElseThrow();
+        assertTrue(
+            method.instructions.iterator().hasNext()
+                && java.util.stream.StreamSupport.stream(
+                    java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0),
+                    false
+                ).filter(MethodInsnNode.class::isInstance)
+                    .map(MethodInsnNode.class::cast)
+                    .anyMatch(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                        && call.name.startsWith("lithiumIdle")),
+            () -> methodName + " must keep the Lithium early return behind its dedicated switch"
+        );
+    }
+}
