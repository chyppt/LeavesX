+    /**
+     * Removes generated implementation-detail switches and shortens the redundant async paths introduced in v74.
+     * Explicit {@code false} fine-grained overrides remain valid and are deliberately preserved.
+     */
+    private static boolean migrateSimplifiedSettings(
+        final CommentedConfigurationNode node,
+        final int sourceVersion
+    ) {
+        if (sourceVersion >= SIMPLIFIED_CONFIG_VERSION) {
+            return false;
+        }
+
+        boolean changed = false;
+        changed |= moveNode(node, path("async", "async-chunk-send"), path("async", "chunk-send"));
+        changed |= moveNode(
+            node,
+            path("async", "async-mob-spawning", "enabled"),
+            path("async", "mob-spawning")
+        );
+        changed |= moveNode(node, path("async", "async-pathfinding"), path("async", "pathfinding"));
+        changed |= moveNode(node, path("async", "async-playerdata-save"), path("async", "playerdata-save"));
+        changed |= moveNode(node, path("async", "async-entity-tracker"), path("async", "entity-tracker"));
+
+        for (final LeavesXOptimization optimization : LeavesXOptimization.cachedValues()) {
+            final Object[] optimizationPath = optimization.nodePath();
+            final CommentedConfigurationNode setting = node.node(optimizationPath);
+            if (Boolean.TRUE.equals(setting.rawScalar())) {
+                setting.raw(null);
+                pruneEmptyParents(node, optimizationPath);
+                changed = true;
+            }
+        }
+        return changed;
+    }
+
+    private static boolean moveNode(
+        final CommentedConfigurationNode root,
+        final Object[] oldPath,
+        final Object[] newPath
+    ) {
+        final CommentedConfigurationNode source = root.node(oldPath);
+        if (source.virtual()) {
+            return false;
+        }
+        final CommentedConfigurationNode destination = root.node(newPath);
+        if (destination.virtual()) {
+            destination.from(source);
+        }
+        source.raw(null);
+        pruneEmptyParents(root, oldPath);
+        return true;
+    }
+
+    private static void pruneEmptyParents(final CommentedConfigurationNode root, final Object[] path) {
+        for (int depth = path.length - 1; depth > 0; depth--) {
+            final CommentedConfigurationNode parent = root.node(java.util.Arrays.copyOf(path, depth));
+            if (!parent.isMap() || !parent.childrenMap().isEmpty()) {
+                return;
+            }
+            parent.raw(null);
+        }
+    }
+
+    private static Object[] path(final Object... elements) {
+        return elements;
+    }
+
     private static boolean readBoolean(final ConfigurationNode node, final String path, final boolean defaultValue) {
         if (node.virtual()) {
             return defaultValue;
