From: LeavesX Build <build@leavesx.local>
Date: Mon, 17 Aug 2026 01:33:48 +0800
Subject: [PATCH] Add any-type adult sensor regression coverage for bate81


diff --git a/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java
index b80e3e4ab02423c1f295dcb67188c23ec47d947f..73bdee8bfbe577240b0653a76354bb7a77a0f9e6 100644
--- a/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java
+++ b/src/test/java/org/leavesx/leavesx/performance/AdultSensorHotPathTest.java
@@ -6,6 +6,7 @@ import java.io.IOException;
 import java.util.Arrays;
 import java.util.List;
 import net.minecraft.world.entity.ai.sensing.AdultSensor;
+import net.minecraft.world.entity.ai.sensing.AdultSensorAnyType;
 import org.bukkit.support.environment.Normal;
 import org.junit.jupiter.api.Test;
 import org.objectweb.asm.ClassReader;
@@ -26,7 +27,7 @@ class AdultSensorHotPathTest {
 
         assertTrue(calls.stream().anyMatch(call -> call.name.equals("adultSensorOptimization")));
         assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValue")));
-        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$findClosestOrNull")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("setNearestVisibleAdultDirect")));
         assertTrue(calls.stream().anyMatch(call -> call.name.equals("getMemory")));
         assertTrue(adultSensor.methods.stream()
             .filter(method -> method.name.startsWith("lambda$doTick"))
@@ -34,6 +35,16 @@ class AdultSensorHotPathTest {
             .anyMatch(call -> call.name.equals("setNearestVisibleAdult")));
     }
 
+    @Test
+    void anyTypeSensorOverridesBothDirectAndVanillaSelection() throws IOException {
+        final ClassNode anyTypeSensor = classNode(AdultSensorAnyType.class);
+
+        assertTrue(invocations(method(anyTypeSensor, "setNearestVisibleAdultDirect")).stream()
+            .anyMatch(call -> call.name.equals("leavesX$findClosestOrNull")));
+        assertTrue(invocations(method(anyTypeSensor, "setNearestVisibleAdult")).stream()
+            .anyMatch(call -> call.name.equals("findClosest")));
+    }
+
     private static List<MethodInsnNode> invocations(final MethodNode method) {
         return Arrays.stream(method.instructions.toArray())
             .filter(MethodInsnNode.class::isInstance)
