diff --git a/src/test/java/org/leavesx/leavesx/performance/ProtocolIntegerEncodingTest.java b/src/test/java/org/leavesx/leavesx/performance/ProtocolIntegerEncodingTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..89f56cc3f0a818191fe848892a18ae96745bd612
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ProtocolIntegerEncodingTest.java
@@ -0,0 +1,105 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.util.Random;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class ProtocolIntegerEncodingTest {
+
+    @Test
+    void preservesVarIntBytesAtEveryLengthBoundary() {
+        final int[] values = {
+            0, 1, 0x7F, 0x80, 0x3FFF, 0x4000, 0x1FFFFF, 0x200000, 0x0FFFFFFF,
+            0x10000000, -1, Integer.MIN_VALUE, Integer.MAX_VALUE
+        };
+
+        for (final int value : values) {
+            assertArrayEquals(legacyVarInt(value), optimizedVarInt(value), "VarInt value " + value);
+        }
+    }
+
+    @Test
+    void preservesVarLongBytesAtEveryLengthBoundary() {
+        final long[] values = {
+            0L, 1L, 0x7FL, 0x80L, 0x3FFFL, 0x4000L, 0x1FFFFFL, 0x200000L,
+            0xFFFFFFFL, 0x10000000L, 0x7FFFFFFFFL, 0x3FFFFFFFFFFL, 0x1FFFFFFFFFFFFL,
+            0xFFFFFFFFFFFFFFL, 0x7FFFFFFFFFFFFFFFL, -1L, Long.MIN_VALUE, Long.MAX_VALUE
+        };
+
+        for (final long value : values) {
+            assertArrayEquals(legacyVarLong(value), optimizedVarLong(value), "VarLong value " + value);
+            assertEquals(legacyVarLong(value).length, ProtocolIntegerEncoding.getVarLongByteSize(value));
+        }
+    }
+
+    @Test
+    void preservesBytesForFixedRandomSamples() {
+        final Random random = new Random(0x4C58504F534954L);
+        for (int i = 0; i < 100_000; ++i) {
+            final int intValue = random.nextInt();
+            final long longValue = random.nextLong();
+            assertArrayEquals(legacyVarInt(intValue), optimizedVarInt(intValue));
+            assertArrayEquals(legacyVarLong(longValue), optimizedVarLong(longValue));
+        }
+    }
+
+    private static byte[] optimizedVarInt(final int value) {
+        final ByteBuf buffer = Unpooled.buffer(5);
+        try {
+            ProtocolIntegerEncoding.writeVarInt(buffer, value);
+            return readBytes(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static byte[] optimizedVarLong(final long value) {
+        final ByteBuf buffer = Unpooled.buffer(10);
+        try {
+            ProtocolIntegerEncoding.writeVarLong(buffer, value);
+            return readBytes(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static byte[] legacyVarInt(int value) {
+        final ByteBuf buffer = Unpooled.buffer(5);
+        try {
+            while ((value & -128) != 0) {
+                buffer.writeByte(value & 127 | 128);
+                value >>>= 7;
+            }
+            buffer.writeByte(value);
+            return readBytes(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static byte[] legacyVarLong(long value) {
+        final ByteBuf buffer = Unpooled.buffer(10);
+        try {
+            while ((value & -128L) != 0L) {
+                buffer.writeByte((int) value & 127 | 128);
+                value >>>= 7;
+            }
+            buffer.writeByte((int) value);
+            return readBytes(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static byte[] readBytes(final ByteBuf buffer) {
+        final byte[] bytes = new byte[buffer.readableBytes()];
+        buffer.readBytes(bytes);
+        return bytes;
+    }
+}
