     }
 }
diff --git a/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java b/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
new file mode 100644
index 0000000000000000000000000000000000000000..04159565b584bb626c5e6e6d4e4ec36df57d0700
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
@@ -0,0 +1,156 @@
+package org.leavesx.leavesx.performance;
+
+import io.netty.buffer.ByteBuf;
+
+/**
+ * Behavior-equivalent fixed-width encoders for Minecraft protocol integers.
+ *
+ * <p>The implementation is adapted from the Leaf 26.2 Gale/Velocity patches licensed under GPL-3.0-only. It emits
+ * the same little-grouped 7-bit byte stream as the vanilla loops while reducing branches and individual Netty write
+ * calls for multi-byte values. This class owns no mutable state and is safe for every network event loop.</p>
+ */
+public final class ProtocolIntegerEncoding {
+
+    private static final int[] VARLONG_EXACT_BYTE_LENGTHS = createVarLongByteLengths();
+
+    private ProtocolIntegerEncoding() {
+    }
+
+    /**
+     * Returns the exact encoded size of a VarLong.
+     *
+     * @param value value to encode
+     * @return encoded byte count in the range 1 through 10
+     */
+    public static int getVarLongByteSize(final long value) {
+        return VARLONG_EXACT_BYTE_LENGTHS[Long.numberOfLeadingZeros(value)];
+    }
+
+    /**
+     * Writes one VarInt using at most two fixed-width buffer operations.
+     *
+     * @param output destination buffer
+     * @param value value to encode
+     * @return {@code output}
+     */
+    public static ByteBuf writeVarInt(final ByteBuf output, final int value) {
+        if ((value & 0xFFFFFF80) == 0) {
+            output.writeByte(value);
+        } else if ((value & 0xFFFFC000) == 0) {
+            final int encoded = (value & 0x7F) << 8
+                | (value >>> 7)
+                | 0x00008000;
+            output.writeShort(encoded);
+        } else if ((value & 0xFFE00000) == 0) {
+            final int encoded = (value & 0x7F) << 16
+                | (value & 0x3F80) << 1
+                | (value >>> 14)
+                | 0x00808000;
+            output.writeMedium(encoded);
+        } else if ((value & 0xF0000000) == 0) {
+            final int encoded = (value & 0x7F) << 24
+                | (value & 0x3F80) << 9
+                | (value & 0x1FC000) >> 6
+                | (value >>> 21)
+                | 0x80808000;
+            output.writeInt(encoded);
+        } else {
+            final int encoded = (value & 0x7F) << 24
+                | (value & 0x3F80) << 9
+                | (value & 0x1FC000) >> 6
+                | ((value >>> 21) & 0x7F)
+                | 0x80808080;
+            output.writeInt(encoded);
+            output.writeByte(value >>> 28);
+        }
+        return output;
+    }
+
+    /**
+     * Writes one VarLong using fixed-width buffer operations.
+     *
+     * @param output destination buffer
+     * @param value value to encode
+     * @return {@code output}
+     */
+    public static ByteBuf writeVarLong(final ByteBuf output, final long value) {
+        if ((value & 0xFFFFFFFFFFFFFF80L) == 0L) {
+            output.writeByte((int) value);
+        } else if (value < 0L) {
+            writeTenByteVarLong(output, value);
+        } else if ((value & 0xFFFFFFFFFFFFC000L) == 0L) {
+            final int least7Bits = (int) value;
+            output.writeShort((least7Bits & 0x7F) << 8 | (least7Bits >>> 7) | 0x00008000);
+        } else if ((value & 0xFFFFFFFFFFE00000L) == 0L) {
+            final int least7Bits = (int) value;
+            output.writeMedium(
+                (least7Bits & 0x7F) << 16
+                    | (least7Bits & 0x3F80) << 1
+                    | (least7Bits >>> 14)
+                    | 0x00808000
+            );
+        } else if ((value & 0xFFFFFFFFF0000000L) == 0L) {
+            final int least7Bits = (int) value;
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808000));
+        } else if ((value & 0xFFFFFFF800000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeByte((int) (value >>> 28));
+        } else if ((value & 0xFFFFFC0000000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final int second7Bits = (int) (value >>> 28);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeShort((second7Bits & 0x7F) << 8 | (second7Bits >>> 7) | 0x00008000);
+        } else if ((value & 0xFFFE000000000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final int second7Bits = (int) (value >>> 28);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeMedium(
+                (second7Bits & 0x7F) << 16
+                    | (second7Bits & 0x3F80) << 1
+                    | (second7Bits >>> 14)
+                    | 0x00808000
+            );
+        } else if ((value & 0xFF00000000000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final int second7Bits = (int) (value >>> 28);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeInt(encodeFourGroups(second7Bits, 0x80808000));
+        } else {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final long remaining = value >>> 28;
+            final int second7Bits = (int) (remaining & 0xFFFFFFFL);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeInt(encodeFourGroups(second7Bits, 0x80808080));
+            output.writeByte((int) (remaining >>> 28));
+        }
+        return output;
+    }
+
+    private static void writeTenByteVarLong(final ByteBuf output, final long value) {
+        final int least7Bits = (int) (value & 0xFFFFFFFL);
+        final long remaining = value >>> 28;
+        final int second7Bits = (int) (remaining & 0xFFFFFFFL);
+        final int third7Bits = (int) (remaining >>> 28);
+        output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+        output.writeInt(encodeFourGroups(second7Bits, 0x80808080));
+        output.writeShort((third7Bits & 0x7F) << 8 | (third7Bits >>> 7) | 0x00008000);
+    }
+
+    private static int encodeFourGroups(final int value, final int continuationMask) {
+        return (value & 0x7F) << 24
+            | (value & 0x3F80) << 9
+            | (value & 0x1FC000) >> 6
+            | ((value >>> 21) & 0x7F)
+            | continuationMask;
+    }
+
+    private static int[] createVarLongByteLengths() {
+        final int[] lengths = new int[65];
+        for (int leadingZeros = 0; leadingZeros < 64; ++leadingZeros) {
+            lengths[leadingZeros] = (int) Math.ceil((63.0 - (leadingZeros - 1)) / 7.0);
+        }
+        lengths[64] = 1;
+        return lengths;
+    }
+}
