 import io.papermc.paper.entity.activation.ActivationRange;
 import java.io.IOException;
@@ -13,6 +14,7 @@ import org.objectweb.asm.Opcodes;
 import org.objectweb.asm.tree.ClassNode;
 import org.objectweb.asm.tree.MethodInsnNode;
 import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
 
 @Normal
 class ActivationRangeHotPathTest {
@@ -61,6 +63,35 @@ class ActivationRangeHotPathTest {
         );
     }
 
+    @Test
+    void activationQueryBufferReservesAStableDenseScanCapacity() throws IOException {
+        final ClassNode buffer = classNode(net.minecraft.world.level.Level.LeavesXEntityQueryBuffer.class);
+        final MethodNode constructor = buffer.methods.stream()
+            .filter(method -> method.name.equals("<init>"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing entity query buffer constructor"));
+        assertTrue(
+            Arrays.stream(constructor.instructions.toArray())
+                .filter(TypeInsnNode.class::isInstance)
+                .map(TypeInsnNode.class::cast)
+                .anyMatch(instruction -> instruction.desc.equals("java/util/ArrayList")),
+            "The reusable query buffer must keep an owned ArrayList"
+        );
+        assertTrue(
+            Arrays.stream(constructor.instructions.toArray())
+                .anyMatch(instruction -> instruction.getOpcode() == Opcodes.BIPUSH
+                    || instruction.getOpcode() == Opcodes.SIPUSH
+                    || instruction.getOpcode() == Opcodes.LDC),
+            "The query buffer should pass an explicit baseline capacity"
+        );
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
     private static MethodNode methodNode(final Class<?> owner, final String methodName) throws IOException {
         final ClassNode classNode = new ClassNode(Opcodes.ASM9);
         new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
diff --git a/src/test/java/org/leavesx/leavesx/performance/LightUpdateCallbackHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/LightUpdateCallbackHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7aaa1191830c6bad63de99ad99b6819bfcc61973
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/LightUpdateCallbackHotPathTest.java
@@ -0,0 +1,56 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import ca.spottedleaf.moonrise.patches.starlight.light.StarLightEngine;
+import java.io.IOException;
+import net.minecraft.server.level.ServerChunkCache;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies light-worker callbacks keep section coordinates primitive until the main-thread handoff. */
+@Normal
+class LightUpdateCallbackHotPathTest {
+
+    private static final String OBJECT_CALLBACK = "(Lnet/minecraft/world/level/LightLayer;Lnet/minecraft/core/SectionPos;)V";
+    private static final String PACKED_CALLBACK = "(Lnet/minecraft/world/level/LightLayer;J)V";
+
+    @Test
+    void starlightUsesPackedCallbacksForBothVisibleUpdateLoops() throws IOException {
+        final ClassNode owner = classNode(StarLightEngine.class);
+        for (final MethodNode method : owner.methods) {
+            if (!method.name.equals("updateVisible") && !method.name.equals("blocksChangedInChunk")) {
+                continue;
+            }
+            final var callbacks = java.util.Arrays.stream(method.instructions.toArray())
+                .filter(MethodInsnNode.class::isInstance)
+                .map(MethodInsnNode.class::cast)
+                .filter(call -> call.name.equals("onLightUpdate"))
+                .toList();
+            if (callbacks.isEmpty()) {
+                continue;
+            }
+            assertTrue(callbacks.stream().anyMatch(call -> call.desc.equals(PACKED_CALLBACK)));
+            assertFalse(callbacks.stream().anyMatch(call -> call.desc.equals(OBJECT_CALLBACK)));
+        }
+    }
+
+    @Test
+    void serverChunkCacheExposesPackedLightCallback() throws IOException {
+        final ClassNode owner = classNode(ServerChunkCache.class);
+        assertTrue(owner.methods.stream().anyMatch(method -> method.name.equals("onLightUpdate")
+            && method.desc.equals(PACKED_CALLBACK)));
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode node = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return node;
+    }
+}
