diff --git a/src/test/java/org/leavesx/leavesx/performance/ExperienceOrbMergeParameterHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ExperienceOrbMergeParameterHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f4dc0d565a0390c1df071b3acee0a1c04f6174df
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ExperienceOrbMergeParameterHotPathTest.java
@@ -0,0 +1,112 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ExperienceOrb;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies experience-orb merge parameter caching preserves the matching predicate. */
+@Normal
+class ExperienceOrbMergeParameterHotPathTest {
+
+    private static final String CACHED_MATCH_DESCRIPTOR = "(Lnet/minecraft/world/entity/ExperienceOrb;III)Z";
+    private static final String FALLBACK_MATCH_DESCRIPTOR = "(Lnet/minecraft/world/entity/ExperienceOrb;II)Z";
+
+    @Test
+    void cachedPredicatePreservesGroupValueAndRemovalChecks() throws ReflectiveOperationException {
+        assertTrue(matches(140, 7, false, 100, 7, 40));
+        assertTrue(matches(60, 7, false, 100, 7, 40));
+        assertFalse(matches(141, 7, false, 100, 7, 40));
+        assertFalse(matches(140, 8, false, 100, 7, 40));
+        assertFalse(matches(140, 7, true, 100, 7, 40));
+        assertTrue(matches(101, 7, false, 100, 7, 1));
+    }
+
+    @Test
+    void cachedCandidatePredicateDoesNotReadGlobalConfiguration() throws IOException {
+        final MethodNode cached = method(classNode(), "canMerge", CACHED_MATCH_DESCRIPTOR);
+        final MethodNode fallback = method(classNode(), "canMerge", FALLBACK_MATCH_DESCRIPTOR);
+
+        assertFalse(invocations(cached).stream().anyMatch(call -> call.owner.equals(
+            "io/papermc/paper/configuration/GlobalConfiguration"
+        )));
+        assertTrue(invocations(fallback).stream().anyMatch(call -> call.owner.equals(
+            "io/papermc/paper/configuration/GlobalConfiguration"
+        )));
+    }
+
+    @Test
+    void bothMergeEntryPointsKeepTheIndependentRuntimeSwitch() throws IOException {
+        final ClassNode owner = classNode();
+        assertTrue(callsRuntimeSwitch(method(owner, "scanForMerges")));
+        assertTrue(callsRuntimeSwitch(method(owner, "tryMergeToExisting")));
+    }
+
+    private static boolean matches(
+        final int orbId,
+        final int orbValue,
+        final boolean removed,
+        final int referenceId,
+        final int referenceValue,
+        final int groupsPerArea
+    ) throws ReflectiveOperationException {
+        final ExperienceOrb orb = mock(ExperienceOrb.class);
+        when(orb.getId()).thenReturn(orbId);
+        when(orb.getValue()).thenReturn(orbValue);
+        when(orb.isRemoved()).thenReturn(removed);
+        final Method method = ExperienceOrb.class.getDeclaredMethod(
+            "canMerge",
+            ExperienceOrb.class,
+            int.class,
+            int.class,
+            int.class
+        );
+        method.setAccessible(true);
+        return (boolean)method.invoke(null, orb, referenceId, referenceValue, groupsPerArea);
+    }
+
+    private static boolean callsRuntimeSwitch(final MethodNode method) {
+        return invocations(method).stream().anyMatch(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+            && call.name.equals("experienceOrbMergeParametersOptimization"));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(ExperienceOrb.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name + descriptor));
+    }
+}
