+    /** Upgrades only the former generated default; all operator-selected thresholds remain untouched. */
+    private static boolean migrateLegacyAiParallelDefault(
+        final CommentedConfigurationNode node,
+        final int sourceVersion
+    ) {
+        if (sourceVersion >= AI_PARALLEL_DEFAULT_MIGRATION_VERSION) {
+            return false;
+        }
+        final CommentedConfigurationNode threshold = node.node(
+            "parallelism", "ai-target-search", "minimum-candidates"
+        );
+        final Object raw = threshold.rawScalar();
+        if (!(raw instanceof Byte || raw instanceof Short || raw instanceof Integer || raw instanceof Long)
+            || ((Number) raw).longValue() != LEGACY_AI_PARALLEL_DEFAULT) {
+            return false;
+        }
+        threshold.raw(AI_PARALLEL_DEFAULT);
+        return true;
+    }
