+    @Test
+    void migratesOnlyTheOldDefaultAiParallelThreshold() throws Exception {
+        final Path path = write("""
+            config-version: 58
+            parallelism:
+              ai-target-search:
+                minimum-candidates: 256
+            """);
+
+        final LeavesXConfig migrated = LeavesXConfigLoader.load(path);
