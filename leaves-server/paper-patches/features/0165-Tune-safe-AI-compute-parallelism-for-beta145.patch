+    private static Entity threadConfinedEntityAt(
+        final double x,
+        final double y,
+        final double z,
+        final Thread callingThread,
+        final AtomicBoolean offThreadGetter
+    ) {
+        final Entity entity = mock(Entity.class);
+        when(entity.getX()).thenAnswer(ignored -> coordinateOnCallingThread(x, callingThread, offThreadGetter));
+        when(entity.getY()).thenAnswer(ignored -> coordinateOnCallingThread(y, callingThread, offThreadGetter));
+        when(entity.getZ()).thenAnswer(ignored -> coordinateOnCallingThread(z, callingThread, offThreadGetter));
+        return entity;
+    }
+
+    private static double coordinateOnCallingThread(
+        final double coordinate,
+        final Thread callingThread,
+        final AtomicBoolean offThreadGetter
+    ) {
+        if (Thread.currentThread() != callingThread) {
+            offThreadGetter.set(true);
+        }
+        return coordinate;
+    }
+
+    private static LeavesXComputeExecutor.WorkloadMetrics workload(final LeavesXComputeExecutor.Workload workload) {
+        return LeavesXComputeExecutor.metrics().workloads().stream()
+            .filter(metrics -> metrics.workload() == workload)
+            .findFirst()
+            .orElseThrow();
+    }
