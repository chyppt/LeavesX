+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import net.minecraft.world.entity.ai.goal.TemptGoal;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Ensures TemptGoal rejects distant players before inspecting their held items. */
+@Normal
+class TemptGoalDistanceGateHotPathTest {
+
+    @Test
+    void distancePrecedesTargetingConditionEvaluation() throws IOException {
+        final ClassNode owner = new ClassNode();
+        new ClassReader(TemptGoal.class.getName()).accept(owner, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        final MethodNode method = owner.methods.stream()
+            .filter(candidate -> candidate.name.equals("leavesX$findNearestTemptingPlayer"))
+            .findFirst()
+            .orElseThrow();
+
+        int distanceCall = -1;
+        int targetingCall = -1;
+        int index = 0;
+        for (final var instruction : method.instructions) {
+            if (instruction instanceof MethodInsnNode call) {
+                if (call.name.equals("distanceToSqr")) {
+                    distanceCall = index;
+                } else if (call.owner.equals("net/minecraft/world/entity/ai/targeting/TargetingConditions")
+                    && call.name.equals("test")) {
+                    targetingCall = index;
+                }
+            }
+            index++;
+        }
+
+        assertTrue(distanceCall >= 0 && targetingCall > distanceCall);
+    }
+}
