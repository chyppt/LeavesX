+    private static FineGrainedOptimizationMasks readFineGrainedOptimizationMasks(final ConfigurationNode node) {
+        long enabledMaskLow = 0L;
+        long enabledMaskHigh = 0L;
+        for (final LeavesXOptimization optimization : LeavesXOptimization.cachedValues()) {
+            if (readBoolean(node.node(optimization.nodePath()), optimization.path(), true)) {
+                if (optimization.wordIndex() == 0) {
+                    enabledMaskLow |= optimization.mask();
+                } else {
+                    enabledMaskHigh |= optimization.mask();
+                }
+            }
+        }
+        return new FineGrainedOptimizationMasks(enabledMaskLow, enabledMaskHigh);
+    }
