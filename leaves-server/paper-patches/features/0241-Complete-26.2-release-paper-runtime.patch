+            false,
+            false,
+            true,
+            false,
+            false,
+            false,
+            "[假人]",
+            List.of(),
+            false,
+            false,
+            true,
+            4,
+            false,
+            true,
+            true,
+            "[",
+            "]",
+            "",
+            "",
+            "",
+            AsyncSettings.safeDefaults(),
+            ExtensionSettings.defaults(),
+            RegionTickingSettings.safeDefaults()
+        );
+    }
+
+    /** Grouped switches for integrations that do not need individual numeric tuning. */
+    public record ExtensionSettings(
+        boolean lithiumEnabled, boolean containerCopyReuse, boolean secureSeed,
+        boolean virtualChat, boolean isolateChunkPacking, boolean fasterRandom,
+        boolean cacheBiome, boolean cacheBiomeSpawning, boolean cacheBiomeAdvancements,
+        boolean optimizePlayerMovement, boolean optimizedPoweredRails, boolean optimizeRandomTick,
+        boolean virtualBukkitScheduler, boolean asyncAiCandidates, boolean asyncPlayerCompression,
+        boolean parallelMobCollisions, boolean asyncWaterPathfinding,
+        boolean poiAsyncSerialization, boolean poiCompetitorScanNoLoad,
+        boolean sensorListReuse, boolean recipeIndex,
+        boolean jeiRecipeSync, boolean jeiRecipeTransfer
+    ) {
+        public static ExtensionSettings defaults() {
+            return new ExtensionSettings(true, true, false, false, true, false, true, true, true, true, false, true, false,
+                true, true, false, false, false, false, true, true, false, false);
+        }
+    }
+
+    /** Startup-only asynchronous execution settings. */
+    public record AsyncSettings(
+        boolean chunkSendEnabled,
+        int chunkSendQueueSize,
+        boolean mobSpawningEnabled,
+        boolean pathfindingEnabled,
+        int pathfindingThreads,
+        int pathfindingQueueSize,
+        int pathfindingKeepaliveSeconds,
+        boolean playerDataSaveEnabled,
+        int playerDataSaveQueueSize,
+        boolean entityTrackerEnabled,
+        int entityTrackerThreads,
+        int entityTrackerQueueSize
+    ) {
+
+        public AsyncSettings {
+            validateThreadCount(pathfindingThreads, "async.pathfinding.threads");
+            validateThreadCount(entityTrackerThreads, "async.entity-tracker.threads");
+            validateQueueSize(chunkSendQueueSize, "async.chunk-send.queue-size");
+            validateQueueSize(pathfindingQueueSize, "async.pathfinding.queue-size");
+            validateQueueSize(playerDataSaveQueueSize, "async.playerdata-save.queue-size");
+            validateQueueSize(entityTrackerQueueSize, "async.entity-tracker.queue-size");
+            if (pathfindingKeepaliveSeconds < 1 || pathfindingKeepaliveSeconds > 600) {
+                throw new IllegalArgumentException(
+                    "async.pathfinding.keepalive-seconds must be between 1 and 600"
+                );
+            }
+        }
+
+        public static AsyncSettings safeDefaults() {
+            return new AsyncSettings(
+                false,
+                256,
+                true,
+                true,
+                0,
+                1_024,
+                60,
+                true,
+                1_024,
+                true,
+                0,
+                1_024
+            );
+        }
+
+        private static void validateThreadCount(final int value, final String path) {
+            if (value < 0 || value > 16) {
+                throw new IllegalArgumentException(path + " must be between 0 and 16");
+            }
+        }
+
+        private static void validateQueueSize(final int value, final String path) {
+            if (value < 64 || value > 65_536) {
+                throw new IllegalArgumentException(path + " must be between 64 and 65536");
+            }
+        }
+    }
+
+    /**
+     * Regionized ticking pipeline settings. Every mode except {@code off} is experimental; {@code off}
+     * keeps the single-threaded world tick that predates regionization and is the permanent fallback.
+     */
+    public record RegionTickingSettings(
+        Mode mode,
+        int mergeRadiusChunks,
+        List<String> strictSerialWorlds,
+        int intentQueueSize,
+        int autoDegradeBarrierPercent,
+        int autoDegradeReplayThreshold,
+        int threads
+    ) {
+
+        /** Regionized ticking execution mode. */
+        public enum Mode {
+            /** Single-threaded world tick, identical to the pre-regionization pipeline. */
+            OFF,
+            /** Worlds tick in parallel; world interiors remain single-threaded. */
+            WORLDS,
+            /** Connected loaded-chunk components tick in parallel (experimental). */
+            REGIONS
+        }
+
+        public RegionTickingSettings {
+            if (mergeRadiusChunks < 0 || mergeRadiusChunks > 64) {
+                throw new IllegalArgumentException("regionized-ticking.merge-radius-chunks must be between 0 and 64");
+            }
+            if (strictSerialWorlds == null || strictSerialWorlds.size() > 32) {
+                throw new IllegalArgumentException(
+                    "regionized-ticking.strict-serial-worlds must contain at most 32 entries"
+                );
+            }
+            if (strictSerialWorlds != null) {
+                for (final String world : strictSerialWorlds) {
+                    if (world == null || world.length() > 256) {
+                        throw new IllegalArgumentException(
+                            "regionized-ticking.strict-serial-worlds entries must not exceed 256 characters"
+                        );
+                    }
+                }
+            }
+            if (intentQueueSize < 1_024 || intentQueueSize > 1_048_576) {
+                throw new IllegalArgumentException("regionized-ticking.intent-queue-size must be between 1024 and 1048576");
+            }
+            if (autoDegradeBarrierPercent < 0 || autoDegradeBarrierPercent > 100) {
+                throw new IllegalArgumentException(
+                    "regionized-ticking.auto-degrade-barrier-percent must be between 0 and 100"
+                );
+            }
+            if (autoDegradeReplayThreshold < 0 || autoDegradeReplayThreshold > 65_536) {
+                throw new IllegalArgumentException(
+                    "regionized-ticking.auto-degrade-replay-threshold must be between 0 and 65536"
+                );
+            }
+            if (threads < 0 || threads > 16) {
+                throw new IllegalArgumentException("regionized-ticking.threads must be between 0 and 16");
+            }
+            strictSerialWorlds = strictSerialWorlds == null ? List.of() : List.copyOf(strictSerialWorlds);
+        }
+
+        public static RegionTickingSettings safeDefaults() {
+            return new RegionTickingSettings(Mode.OFF, 8, List.of(), 65_536, 25, 64, 0);
+        }
+    }
+
+    private static String requireBoundedText(final String value, final String path, final int maximumLength) {
+        if (value == null) {
+            throw new IllegalArgumentException(path + " must not be null");
+        }
+        if (value.length() > maximumLength) {
+            throw new IllegalArgumentException(path + " must not exceed " + maximumLength + " characters");
+        }
+        return value;
+    }
+
+    private static List<String> normalizeForbiddenNameFragments(final List<String> values) {
+        if (values == null) {
+            throw new IllegalArgumentException("fakeplayer.forbidden-name-contains must not be null");
+        }
+        if (values.size() > 64) {
+            throw new IllegalArgumentException("fakeplayer.forbidden-name-contains must contain at most 64 entries");
+        }
+        final List<String> normalized = new ArrayList<>(values.size());
+        for (final String value : values) {
+            if (value == null) {
+                throw new IllegalArgumentException("fakeplayer.forbidden-name-contains must not contain null entries");
+            }
+            final String fragment = value.trim().toLowerCase(Locale.ROOT);
+            if (fragment.length() > 64) {
+                throw new IllegalArgumentException(
+                    "fakeplayer.forbidden-name-contains entries must not exceed 64 characters"
+                );
+            }
+            if (!fragment.isEmpty() && !normalized.contains(fragment)) {
+                normalized.add(fragment);
+            }
+        }
+        return List.copyOf(normalized);
+    }
+
+    /** Returns whether one independently configurable optimization is enabled. */
+    boolean optimizationEnabled(final LeavesXOptimization optimization) {
+        return optimization.enabledIn(this.fineGrainedOptimizationMaskLow, this.fineGrainedOptimizationMaskHigh);
+    }
+
+    /** Returns the number of enabled fine-grained optimization switches. */
+    public int enabledFineGrainedOptimizationCount() {
+        return Long.bitCount(this.fineGrainedOptimizationMaskLow) + Long.bitCount(this.fineGrainedOptimizationMaskHigh);
+    }
+
+    /** Returns the number of supported fine-grained optimization switches. */
+    public static int fineGrainedOptimizationCount() {
+        return LeavesXOptimization.count();
+    }
+}
