+    /** Upgrades only the former generated default; all operator-selected thresholds remain untouched. */
+    private static boolean migrateLegacyAiParallelDefault(
+        final CommentedConfigurationNode node,
+        final int sourceVersion
+    ) {
+        if (sourceVersion >= AI_PARALLEL_DEFAULT_MIGRATION_VERSION) {
+            return false;
+        }
+        final CommentedConfigurationNode threshold = node.node(
+            "parallelism", "ai-target-search", "minimum-candidates"
+        );
+        final Object raw = threshold.rawScalar();
+        if (!(raw instanceof Byte || raw instanceof Short || raw instanceof Integer || raw instanceof Long)
+            || ((Number) raw).longValue() != LEGACY_AI_PARALLEL_DEFAULT) {
+            return false;
+        }
+        threshold.raw(AI_PARALLEL_DEFAULT);
+        return true;
+    }
+
+    /** Upgrades only values that were generated by the previous conservative parallelism defaults. */
+    private static boolean migrateLegacyParallelDefaults(
+        final CommentedConfigurationNode node,
+        final int sourceVersion
+    ) {
+        if (sourceVersion >= PARALLEL_THRESHOLD_MIGRATION_VERSION) {
+            return false;
+        }
+        boolean changed = false;
+        // Version 63 was the beta161 default set. Older versions used a different set, so migrate each known
+        // generated value while leaving operator-selected thresholds untouched.
+        if (sourceVersion == 63) {
+            changed |= migrateDefault(node.node("parallelism", "ai-target-search", "minimum-candidates"), 512, AI_PARALLEL_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "ai-target-search", "minimum-items-per-worker"), 256, AI_PARALLEL_ITEMS_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "entity-activation", "minimum-entities"), 8_192, ENTITY_ACTIVATION_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "entity-activation", "minimum-items-per-worker"), 1_024, ENTITY_ACTIVATION_ITEMS_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "mob-spawning", "minimum-entities"), 65_536, MOB_SPAWN_DEFAULT);
+        } else {
+            changed |= migrateDefault(node.node("parallelism", "ai-target-search", "minimum-candidates"), 2_048, AI_PARALLEL_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "ai-target-search", "minimum-items-per-worker"), 1_024, AI_PARALLEL_ITEMS_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "entity-activation", "minimum-entities"), 65_536, ENTITY_ACTIVATION_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "entity-activation", "minimum-items-per-worker"), 8_192, ENTITY_ACTIVATION_ITEMS_DEFAULT);
+            changed |= migrateDefault(node.node("parallelism", "mob-spawning", "minimum-entities"), 524_288, MOB_SPAWN_DEFAULT);
+        }
+        return changed;
+    }
+
+    private static boolean migrateDefault(
+        final CommentedConfigurationNode node,
+        final int legacyValue,
+        final int currentValue
+    ) {
+        final Object raw = node.rawScalar();
+        if ((raw instanceof Byte || raw instanceof Short || raw instanceof Integer || raw instanceof Long)
+            && ((Number)raw).intValue() == legacyValue) {
+            node.raw(currentValue);
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * Removes generated implementation-detail switches and shortens the redundant async paths introduced in v74.
+     * Explicit {@code false} fine-grained overrides remain valid and are deliberately preserved.
+     */
+    private static boolean migrateSimplifiedSettings(
+        final CommentedConfigurationNode node,
+        final int sourceVersion
+    ) {
+        if (sourceVersion >= SIMPLIFIED_CONFIG_VERSION) {
+            return false;
+        }
+
+        boolean changed = false;
+        changed |= moveNode(node, path("async", "async-chunk-send"), path("async", "chunk-send"));
+        changed |= moveNode(
+            node,
+            path("async", "async-mob-spawning", "enabled"),
+            path("async", "mob-spawning")
+        );
+        changed |= moveNode(node, path("async", "async-pathfinding"), path("async", "pathfinding"));
+        changed |= moveNode(node, path("async", "async-playerdata-save"), path("async", "playerdata-save"));
+        changed |= moveNode(node, path("async", "async-entity-tracker"), path("async", "entity-tracker"));
+
+        for (final LeavesXOptimization optimization : LeavesXOptimization.cachedValues()) {
+            final Object[] optimizationPath = optimization.nodePath();
+            final CommentedConfigurationNode setting = node.node(optimizationPath);
+            if (Boolean.TRUE.equals(setting.rawScalar())) {
+                setting.raw(null);
+                pruneEmptyParents(node, optimizationPath);
+                changed = true;
+            }
+        }
+        return changed;
+    }
+
+    private static boolean moveNode(
+        final CommentedConfigurationNode root,
+        final Object[] oldPath,
+        final Object[] newPath
+    ) {
+        final CommentedConfigurationNode source = root.node(oldPath);
+        if (source.virtual()) {
+            return false;
+        }
+        final CommentedConfigurationNode destination = root.node(newPath);
+        if (destination.virtual()) {
+            destination.from(source);
+        }
+        source.raw(null);
+        pruneEmptyParents(root, oldPath);
+        return true;
+    }
+
+    private static void pruneEmptyParents(final CommentedConfigurationNode root, final Object[] path) {
+        for (int depth = path.length - 1; depth > 0; depth--) {
+            final CommentedConfigurationNode parent = root.node(java.util.Arrays.copyOf(path, depth));
+            if (!parent.isMap() || !parent.childrenMap().isEmpty()) {
+                return;
+            }
+            parent.raw(null);
+        }
+    }
+
+    private static Object[] path(final Object... elements) {
+        return elements;
+    }
+
+    private static boolean readBoolean(final ConfigurationNode node, final String path, final boolean defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof Boolean value) {
+            return value;
+        }
+        throw invalidType(path, "a boolean", raw);
+    }
+
+    private static String readString(final ConfigurationNode node, final String path, final String defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof String value) {
+            return value;
+        }
+        throw invalidType(path, "a string", raw);
+    }
+
+    private static LeavesXConfig.RegionTickingSettings.Mode readMode(final ConfigurationNode node, final String path) {
+        if (node.virtual()) {
+            return LeavesXConfig.RegionTickingSettings.Mode.OFF;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof String value) {
+            return switch (value.toLowerCase(java.util.Locale.ROOT)) {
+                case "off" -> LeavesXConfig.RegionTickingSettings.Mode.OFF;
+                case "worlds" -> LeavesXConfig.RegionTickingSettings.Mode.WORLDS;
+                case "regions" -> LeavesXConfig.RegionTickingSettings.Mode.REGIONS;
+                default -> throw invalidType(path, "one of off, worlds or regions", raw);
+            };
+        }
+        throw invalidType(path, "one of off, worlds or regions", raw);
+    }
+
+    /** Reads the canonical lifecycle message and accepts two layouts emitted by older development builds. */
+    private static String readLifecycleMessage(final ConfigurationNode root, final String key) {
+        final ConfigurationNode canonical = root.node("messages", key);
+        if (!canonical.virtual()) {
+            return readString(canonical, "messages." + key, "");
+        }
+        final ConfigurationNode legacyParallelism = root.node("parallelism", key);
+        if (!legacyParallelism.virtual()) {
+            return readString(legacyParallelism, "parallelism." + key, "");
+        }
+        return readString(root.node(key), key, "");
+    }
+
+    private static java.util.List<String> readStringList(
+        final ConfigurationNode node,
+        final String path,
+        final java.util.List<String> defaultValue
+    ) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        if (!node.isList()) {
+            throw invalidType(path, "a list of strings", node.raw());
+        }
+        final java.util.ArrayList<String> values = new java.util.ArrayList<>();
+        for (final ConfigurationNode child : node.childrenList()) {
+            final Object raw = child.rawScalar();
+            if (!(raw instanceof String value)) {
+                throw invalidType(path, "a list of strings", raw);
+            }
+            values.add(value);
+        }
+        return java.util.List.copyOf(values);
+    }
+
+    private static IllegalArgumentException invalidType(
+        final String path,
+        final String expected,
+        final Object actual
+    ) {
+        return new IllegalArgumentException(
+            path + " must be " + expected + ", but was " + (actual == null ? "null" : actual.getClass().getSimpleName())
+        );
+    }
+
+    private record OriginalFormatting(String preamble, String lineSeparator) {
+    }
+
+    private record FineGrainedOptimizationMasks(long low, long high) {
+    }
+}
