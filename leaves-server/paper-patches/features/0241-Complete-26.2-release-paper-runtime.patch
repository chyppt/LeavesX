+@Normal
+class EntityCollisionHotPathTest {
+
+    @Test
+    void timingSensitiveSingleBoxShortcutIsRemoved() {
+        assertThrows(NoSuchMethodException.class, () -> AABB.class.getMethod("collidedAlongVector", Vec3.class, AABB.class));
+    }
+
+    @Test
+    void insideBlockCollisionUsesPaperListTraversal() throws IOException {
+        final MethodInsnNode[] insideBlockCalls = methodNodes(Entity.class, "checkInsideBlocks").stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+        assertTrue(
+            Arrays.stream(insideBlockCalls).anyMatch(call ->
+                call.owner.equals("net/minecraft/world/phys/shapes/VoxelShape") && call.name.equals("toAabbs")
+            ),
+            "Inside-block checks must retain Paper's complete AABB-list materialization"
+        );
+
+        final MethodInsnNode[] fluidCalls = methodNodes(Entity.class, "collidedWithFluid").stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+        assertTrue(
+            Arrays.stream(fluidCalls).anyMatch(call ->
+                call.owner.equals("java/util/List") && call.name.equals("of")
+            ),
+            "Fluid checks must retain Paper's one-element list path"
+        );
+        assertTrue(Arrays.stream(fluidCalls).anyMatch(call ->
+            call.name.equals("collidedWithShapeMovingFrom") && call.desc.contains("Ljava/util/List;")));
+    }
+
+    @Test
+    void entityMovementDoesNotSkipZeroOrNegligibleUpdates() throws IOException {
+        final ClassNode entity = classNode(Entity.class);
+        assertFalse(entity.fields.stream().anyMatch(field -> field.name.equals("boundingBoxChanged")));
+
+        final boolean readsMovementSkipSetting = methodNodes(Entity.class, "move").stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(FieldInsnNode.class::isInstance)
+            .map(FieldInsnNode.class::cast)
+            .anyMatch(field -> field.name.equals("skipEntityMoveIfMovementIsZero")
+                || field.name.equals("skipNegligiblePlanarMovementMultiplication"));
+        assertFalse(readsMovementSkipSetting, "Entity.move must always execute Paper's movement pipeline");
+    }
+
+    @Test
+    void blockTraversalUsesReentrantVisitedSetReuseSwitch() throws IOException {
+        final ClassNode blockGetter = classNode(net.minecraft.world.level.BlockGetter.class);
+        final MethodNode traversal = blockGetter.methods.stream()
+            .filter(method -> method.name.equals("forEachBlockIntersectedBetween"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing block traversal method"));
+        assertTrue(
+            Arrays.stream(traversal.instructions.toArray())
+                .filter(MethodInsnNode.class::isInstance)
+                .map(MethodInsnNode.class::cast)
+                .anyMatch(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                    && call.name.equals("blockTraversalVisitedSetReuseOptimization"))
+        );
+        assertTrue(
+            Arrays.stream(traversal.instructions.toArray())
+                .filter(FieldInsnNode.class::isInstance)
+                .map(FieldInsnNode.class::cast)
+                .anyMatch(field -> field.name.equals("LEAVESX_BLOCK_TRAVERSAL_WORKSPACE"))
+        );
+    }
+
+    @Test
+    void denseEntityPushQueriesReuseTheReentrantResultBuffer() throws IOException {
+        final List<MethodInsnNode> calls = methodNodes(LivingEntity.class, "pushEntities").stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level")
+                && call.name.equals("leavesX$acquireEntityQueryBuffer")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level$LeavesXEntityQueryBuffer")
+                && call.name.equals("query")
+                && call.desc.endsWith("I)Ljava/util/List;")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level$LeavesXEntityQueryBuffer")
+                && call.name.equals("query")
+                && !call.desc.endsWith("I)Ljava/util/List;")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level$LeavesXEntityQueryBuffer")
+                && call.name.equals("close")
+        ));
+        assertFalse(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level") && call.name.equals("getPushableEntities")
+        ));
+    }
+
+    @Test
+    void blockCollisionLoopSnapshotsPaletteDataOncePerSection() throws IOException {
+        final List<MethodInsnNode> calls = methodNodes(CollisionUtil.class, "getCollisionsForBlocksOrWorldBorder").stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/chunk/PalettedContainer")
+                && call.name.equals("leavesX$getData")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/chunk/PalettedContainer")
+                && call.name.equals("leavesX$get")
+                && call.desc.contains("PalettedContainer$Data")
+        ));
+    }
+
+    private static List<MethodNode> methodNodes(final Class<?> owner, final String methodName) throws IOException {
+        final ClassNode classNode = classNode(owner);
+        final List<MethodNode> methods = classNode.methods.stream()
+            .filter(method -> method.name.equals(methodName) || method.name.startsWith("lambda$" + methodName + '$'))
+            .toList();
+        assertFalse(methods.isEmpty(), "Missing method " + owner.getName() + '#' + methodName);
+        return methods;
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+}
