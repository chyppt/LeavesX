+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Random;
+import java.util.concurrent.atomic.AtomicBoolean;
+import net.minecraft.world.entity.Entity;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+@Normal
+class StableDistanceSorterTest {
+
+    @AfterEach
+    void shutdownExecutor() {
+        LeavesXComputeExecutor.shutdown();
+    }
+
+    @Test
+    void matchesStableComparatorOrderSynchronouslyAndInParallel() {
+        final Random random = new Random(0x4C656176657358L);
+        final int size = 1_027;
+        final double[] x = new double[size];
+        final double[] y = new double[size];
+        final double[] z = new double[size];
+        for (int index = 0; index < size; index++) {
+            // Repeated integer coordinates exercise stable ordering for equal distances.
+            x[index] = random.nextInt(41) - 20;
+            y[index] = random.nextInt(17) - 8;
+            z[index] = random.nextInt(41) - 20;
+        }
+
+        final int[] expected = referenceOrder(x, y, z, 3.5, -2.25, 7.75);
+        assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 3.5, -2.25, 7.75, false, 64));
+
+        LeavesXComputeExecutor.configure(4);
+        assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 3.5, -2.25, 7.75, true, 64));
+    }
+
+    @Test
+    void matchesStableOrderWhenAdaptivePartitionUsesFewerLanes() {
+        final Random random = new Random(0x506172746974696fL);
+        final int size = 191;
+        final double[] x = new double[size];
+        final double[] y = new double[size];
+        final double[] z = new double[size];
+        for (int index = 0; index < size; index++) {
+            x[index] = random.nextInt(257) - 128;
+            y[index] = random.nextInt(65) - 32;
+            z[index] = random.nextInt(257) - 128;
+        }
+
+        final int[] expected = referenceOrder(x, y, z, -17.5, 4.25, 31.75);
+        LeavesXComputeExecutor.configure(8, 64);
+
+        assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, -17.5, 4.25, 31.75, true, 1));
+    }
+
+    @Test
+    void preservesStableOrderAcrossParallelRadixMergeBoundaries() {
+        final Random random = new Random(0x42657461313339L);
+        LeavesXComputeExecutor.configure(4, 16);
+
+        // These sizes cross radix partition and merge-width boundaries. Repeated coordinates make equal-distance
+        // ordering observable, while the fixed seed keeps the regression deterministic.
+        for (final int size : new int[] {64, 65, 127, 128, 129, 191, 255, 256, 257, 511, 512, 513, 1_027, 2_049}) {
+            final double[] x = new double[size];
+            final double[] y = new double[size];
+            final double[] z = new double[size];
+            for (int index = 0; index < size; index++) {
