+    private static ClassNode classNode(final String className) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode classNode, final String name) {
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow();
+    }
+
+    private static MethodNode method(final ClassNode classNode, final String name, final String descriptor) {
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(name) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow();
+    }
+}
