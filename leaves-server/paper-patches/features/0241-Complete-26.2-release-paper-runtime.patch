+package org.leavesx.leavesx.version;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoMoreInteractions;
+import static org.mockito.Mockito.when;
+
+import com.destroystokyo.paper.PaperVersionFetcher;
+import io.papermc.paper.ServerBuildInfo;
+import java.lang.reflect.Method;
+import java.util.OptionalInt;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.leavesmc.leaves.util.LeavesVersionFetcher;
+
+/** Verifies that custom LeavesX builds never query upstream Paper or Leaves release services. */
+@Normal
+class LeavesVersionFetcherTest {
+
+    @Test
+    void leavesXBuildUsesLocalVersionInformation() throws ReflectiveOperationException {
+        final ServerBuildInfo build = mock();
+        when(build.brandName()).thenReturn("LeavesX");
+        when(build.minecraftVersionId()).thenReturn("26.1.2");
+        when(build.buildNumber()).thenReturn(OptionalInt.of(24));
+        final Method method = LeavesVersionFetcher.class.getDeclaredMethod("getUpdateStatusMessage", ServerBuildInfo.class);
+        method.setAccessible(true);
+
+        final Component message = (Component)method.invoke(null, build);
+
+        assertEquals(
+            Component.text("You are running LeavesX build 24 for Minecraft 26.1.2", NamedTextColor.GREEN),
+            message
+        );
+        verify(build).brandName();
+        verify(build).minecraftVersionId();
+        verify(build).buildNumber();
+        verifyNoMoreInteractions(build);
+    }
+
+    @Test
+    void leavesXBuildSkipsPaperStartupUpdateLookup() throws ReflectiveOperationException {
+        final ServerBuildInfo build = mock();
+        when(build.brandName()).thenReturn("LeavesX");
+
+        assertFalse((boolean)paperStartupUpdateMethod().invoke(null, build));
+
+        verify(build).brandName();
+        verifyNoMoreInteractions(build);
+    }
+
+    @Test
+    void upstreamBuildKeepsPaperStartupUpdateLookup() throws ReflectiveOperationException {
+        final ServerBuildInfo build = mock();
+        when(build.brandName()).thenReturn("Paper");
+
+        assertTrue((boolean)paperStartupUpdateMethod().invoke(null, build));
+
+        verify(build).brandName();
+        verifyNoMoreInteractions(build);
+    }
+
+    private static Method paperStartupUpdateMethod() throws NoSuchMethodException {
+        final Method method = PaperVersionFetcher.class.getDeclaredMethod("shouldCheckPaperUpdates", ServerBuildInfo.class);
+        method.setAccessible(true);
+        return method;
+    }
+}
