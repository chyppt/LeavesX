+package org.leavesx.leavesx.config;
+
+import java.io.File;
+import java.nio.file.Path;
+import joptsimple.OptionSet;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Initializes the immutable LeavesX runtime configuration before world creation. */
+public final class LeavesXConfigBootstrap {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXConfigBootstrap.class);
+    private static volatile Path configuredPath;
+    // Startup-only options must be compared with the running pools, not the previous reload's requested values.
+    private static volatile LeavesXConfig startupConfiguration;
+
+    private LeavesXConfigBootstrap() {
+    }
+
+    /** Validates the configured file without publishing, migrating or writing it. */
+    public static ReloadResult checkConfiguration() {
+        final Path path = configuredPath;
+        if (path == null) throw new LeavesXConfigException("LeavesX configuration path is not initialized");
+        final LeavesXConfig requested = LeavesXConfigInspection.read(path);
+        return new ReloadResult(requested, restartRequiredChanges(startupConfiguration, requested));
+    }
+
+    public static Path configurationPath() {
+        return configuredPath;
+    }
+
+    /**
+     * Loads the configured file and publishes it to the runtime.
+     *
+     * @param options parsed server command-line options
+     */
+    public static void load(final OptionSet options) {
+        final Path path = ((File) options.valueOf("leavesx-settings")).toPath().toAbsolutePath().normalize();
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        org.leavesx.leavesx.worldgen.SecureFeatureSeed.configureNewWorlds(config.extensions().secureSeed());
+        org.leavesx.leavesx.random.LeavesXRandomSources.configure(config.extensions().fasterRandom());
+        org.leavesx.leavesx.runtime.LeavesXComputeExecutor.configure(
+            config.computeWorkers(),
+            config.minimumItemsPerWorker(),
+            config.prestartWorkers()
+        );
+        org.leavesx.leavesx.runtime.LeavesXAsyncRuntime.configure(config.asyncSettings(), config.extensions().isolateChunkPacking());
+        org.leavesx.leavesx.runtime.LeavesXRegionTicking.configure(config.regionTickingSettings());
+        org.leavesx.leavesx.runtime.LeavesXWorldTicker.configure(config.regionTickingSettings().threads());
+        org.leavesx.leavesx.runtime.LeavesXEventGate.setEnabled(config.regionTickingSettings().mode() == LeavesXConfig.RegionTickingSettings.Mode.WORLDS);
+        LeavesXRuntime.publish(config);
+        org.leavesx.leavesx.diagnostics.LeavesXGcDiagnostics.initialize();
+        if (config.diagnosticsCommandEnabled()) {
+            org.leavesx.leavesx.diagnostics.LeavesXSystemDiagnostics.initialize();
+        }
+        configuredPath = path;
+        startupConfiguration = config;
+        if (config.extensions().poiAsyncSerialization() || config.extensions().poiCompetitorScanNoLoad()) {
+            LOGGER.warn("LeavesX POI async serialization and non-loading villager job-site scans are disabled in this build to preserve POI data and vanilla villager behavior; the existing settings are retained for migration.");
+        }
+        if (config.asyncSettings().chunkSendEnabled()) {
+            LOGGER.info("LeavesX async chunk send is enabled: workers encode detached sections; live chunk capture, light and block entities retain their original thread ownership. Packets use Paper's existing send queue.");
+        }
+        logConfiguration(config);
+    }
+
+    /**
+     * Validates and publishes the current {@code leavesx.yml} without restarting the server.
+     *
+     * <p>The immutable runtime snapshot is replaced only after parsing and validation succeed. The compute pool is
+     * rebuilt only when its own settings changed, preserving metrics during ordinary configuration reloads.</p>
+     *
+     * @return newly published configuration
+     */
+    public static synchronized LeavesXConfig reload() {
+        return reloadWithStatus().configuration();
+    }
+
+    /** Reloads LeavesX and reports settings that are intentionally startup-only. */
+    public static synchronized ReloadResult reloadWithStatus() {
+        final Path path = configuredPath;
+        if (path == null) {
+            throw new LeavesXConfigException("LeavesX configuration path is not initialized");
+        }
+
+        final LeavesXConfig previous = LeavesXRuntime.configuration();
+        final LeavesXConfig next = LeavesXConfigLoader.load(path);
+        if (previous.computeWorkers() != next.computeWorkers()
+            || previous.minimumItemsPerWorker() != next.minimumItemsPerWorker()
+            || previous.prestartWorkers() != next.prestartWorkers()) {
+            org.leavesx.leavesx.runtime.LeavesXComputeExecutor.configure(
+                next.computeWorkers(),
+                next.minimumItemsPerWorker(),
+                next.prestartWorkers()
+            );
+        }
+        LeavesXRuntime.publish(next);
+        org.leavesmc.leaves.command.bot.PlayerCommand.syncRegistration();
+        final net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+        if (server != null && server.getBotList() != null) {
+            server.getBotList().refreshLeavesXPresentation();
+        }
+        LOGGER.info("Reloaded LeavesX configuration from {}", path);
+        return new ReloadResult(next, restartRequiredChanges(startupConfiguration, next));
+    }
+
+    static java.util.List<String> restartRequiredChanges(
+        final LeavesXConfig previous,
+        final LeavesXConfig next
+    ) {
+        final java.util.ArrayList<String> changed = new java.util.ArrayList<>();
+        if (previous.diagnosticsCommandEnabled() != next.diagnosticsCommandEnabled()) {
+            changed.add("diagnostics.command-enabled");
+        }
+        if (previous.startupResidentBots() != next.startupResidentBots()
+            || previous.startupResidentBotsPerTick() != next.startupResidentBotsPerTick()) {
+            changed.add("fakeplayer.startup-restore");
+        }
+        if (previous.startupAiStaggering() != next.startupAiStaggering()
+            || previous.startupAiWarmupTicks() != next.startupAiWarmupTicks()
+            || previous.startupAiEntitiesPerTick() != next.startupAiEntitiesPerTick()) {
+            changed.add("performance.startup.ai");
+        }
+        if (previous.showRootAdminWarning() != next.showRootAdminWarning()) {
+            changed.add("console-messages.show-root-admin-warning");
+        }
+        if (previous.showOfflineModeWarning() != next.showOfflineModeWarning()) {
+            changed.add("console-messages.show-offline-mode-warning");
+        }
+        if (previous.showCollisionConversionWarning() != next.showCollisionConversionWarning()) {
+            changed.add("console-messages.show-collision-conversion-warning");
+        }
+        if (!previous.asyncSettings().equals(next.asyncSettings())) {
+            changed.add("async");
+        }
+        if (previous.extensions().secureSeed() != next.extensions().secureSeed()) {
+            changed.add("features.secure-seed（仅新建世界）");
+        }
+        if (previous.extensions().virtualChat() != next.extensions().virtualChat()) {
+            changed.add("performance.use-virtual-thread.async-chat-executor");
+        }
+        if (previous.extensions().virtualBukkitScheduler() != next.extensions().virtualBukkitScheduler()) {
+            changed.add("performance.use-virtual-thread.bukkit-async-scheduler");
+        }
+        if (previous.extensions().fasterRandom() != next.extensions().fasterRandom()) {
+            changed.add("performance.faster-random-generator.enabled");
+        }
+        if (previous.extensions().isolateChunkPacking() != next.extensions().isolateChunkPacking()) {
+            changed.add("async.isolate-chunk-packing");
+        }
+        if (!previous.regionTickingSettings().equals(next.regionTickingSettings())) {
+            changed.add("regionized-ticking");
+        }
+        return java.util.List.copyOf(changed);
+    }
+
+    public record ReloadResult(LeavesXConfig configuration, java.util.List<String> restartRequiredChanges) {
+
+        public boolean restartRequired() {
+            return !this.restartRequiredChanges.isEmpty();
+        }
+    }
+
+    private static void logConfiguration(final LeavesXConfig config) {
+        LOGGER.info("LeavesX compatibility baseline: Leaves/Paper with standard Bukkit plugin loading semantics");
+        LOGGER.info(
+            "LeavesX behavior-equivalent optimizations: VarInt {}, network flush {}, immutable caches {}, identifiers {}, empty events {}, entity state {}, entity queries {}, AI {}, villager compatibility {}, villager profession {}, long jump {}, ram selection {}, pathfinding {}, mob spawning {}, item merge {}, block entity hot paths {}, block entity removal {}, spawn range {}",
+            config.optimizedVarInt(),
+            config.networkFlushConsolidation(),
+            config.immutableCacheOptimizations(),
+            config.resourceIdentifierCache(),
+            config.skipEmptyEvents(),
+            config.entityStateOptimizations(),
+            config.entityQueryOptimizations(),
+            config.aiOptimizations(),
+            config.villagerCompatibilityMode(),
+            LeavesXRuntime.villagerProfessionAssignmentOptimization(),
+            LeavesXRuntime.longJumpCandidateOptimization(),
+            LeavesXRuntime.ramPositionSelectionOptimization(),
+            config.pathfindingOptimizations(),
+            config.mobSpawningOptimizations(),
+            config.itemMergeOptimizations(),
+            config.blockEntityOptimizations(),
+            config.blockEntityTickerRemovalOptimization(),
+            config.chunkSpawnRangeOptimization()
+        );
+        LOGGER.info(
+            "LeavesX compute pool: {} workers, prestart {}, minimum {} items per worker; natural-spawn counting {} from {} entities (configured {})",
+            org.leavesx.leavesx.runtime.LeavesXComputeExecutor.workerCount(),
+            config.prestartWorkers(),
+            config.minimumItemsPerWorker(),
+            config.parallelMobSpawnCounting() ? "enabled" : "disabled",
+            LeavesXRuntime.effectiveMobSpawnCountingMinimumEntities(),
+            config.mobSpawnCountingMinimumEntities()
+        );
+        final LeavesXConfig.AsyncSettings async = config.asyncSettings();
+        LOGGER.info(
+            "LeavesX async subsystems: chunk send {}, mob spawning {}, pathfinding requested {} (water snapshots require opt-in; other searches stay on main thread), player data save {}, entity tracker {}",
+            LeavesXRuntime.asyncChunkSend(),
+            async.mobSpawningEnabled(),
+            async.pathfindingEnabled(),
+            async.playerDataSaveEnabled(),
+            async.entityTrackerEnabled()
+        );
+        LOGGER.info(
+            "LeavesX AI target-distance workers: {}, parallel from {} candidates (configured {}), minimum {} items per lane (configured {})",
+            config.parallelAiTargetSearch() ? "enabled" : "disabled",
+            LeavesXRuntime.aiTargetSearchMinimumCandidates(),
+            config.aiTargetSearchMinimumCandidates(),
+            LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker(),
+            config.aiTargetSearchMinimumItemsPerWorker()
+        );
+        LOGGER.info(
+            "LeavesX entity-activation workers: {}, parallel from {} candidates (configured {}), minimum {} items per lane (configured {})",
+            config.parallelEntityActivation() ? "enabled" : "disabled",
+            LeavesXRuntime.entityActivationMinimumEntities(),
+            config.entityActivationMinimumEntities(),
+            LeavesXRuntime.entityActivationMinimumItemsPerWorker(),
+            config.entityActivationMinimumItemsPerWorker()
+        );
+        LOGGER.info(
+            "LeavesX animal idle-goal throttling: {}, interval multiplier {} (disabled by default because it changes idle behavior)",
+            config.animalIdleGoalThrottling() ? "enabled" : "disabled",
+            config.animalIdleGoalIntervalMultiplier()
+        );
+        LOGGER.info(
+            "LeavesX dense-monster AI throttling: {}, radius {}, threshold {}, density check {} ticks, full goal selection {} ticks",
+            config.denseMonsterAiThrottling() ? "enabled" : "disabled",
+            config.denseMonsterAiNearbyRadius(),
+            config.denseMonsterAiMinimumEntities(),
+            config.denseMonsterAiCheckIntervalTicks(),
+            config.denseMonsterAiGoalIntervalTicks()
+        );
+        LOGGER.info(
+            "LeavesX adaptive chunk unloading: {}, backlog threshold {}, budget {}-{} chunks/tick",
+            config.adaptiveChunkUnloading() ? "enabled" : "disabled",
+            config.chunkUnloadBacklogThreshold(),
+            config.chunkUnloadMinimumPerTick(),
+            config.chunkUnloadMaximumPerTick()
+        );
+        LOGGER.info(
+            "LeavesX spectator no-chunk-loading: {} (requires spectators_generate_chunks=false)",
+            config.spectatorNoChunkLoading() ? "enabled" : "disabled"
+        );
+        LOGGER.info(
+            "LeavesX startup resident-bot restore: {}, up to {} bot(s) per tick",
+            config.startupResidentBots() ? "enabled" : "disabled",
+            config.startupResidentBotsPerTick()
+        );
+        LOGGER.info(
+            "LeavesX startup AI staggering: {}, {} tick warmup, {} mob(s) per tick",
+            config.startupAiStaggering() ? "enabled" : "disabled",
+            config.startupAiWarmupTicks(),
+            config.startupAiEntitiesPerTick()
+        );
+        LOGGER.info(
+            "LeavesX diagnostics: {} second rolling window, retain synchronous plugin tasks from {} ms",
+            config.diagnosticsRollingWindowSeconds(),
+            config.diagnosticsSlowPluginTaskMillis()
+        );
+        LOGGER.info(
+            "LeavesX fine-grained optimization switches: {}/{} enabled",
+            config.enabledFineGrainedOptimizationCount(),
+            LeavesXConfig.fineGrainedOptimizationCount()
+        );
+    }
+}
