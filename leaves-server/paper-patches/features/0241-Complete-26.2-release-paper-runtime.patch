+    private static String ticketFlags(final TicketType<?> type) {
+        if (type.doesLoad() && type.doesSimulate()) {
+            return "（加载、模拟）";
+        }
+        if (type.doesSimulate()) {
+            return "（模拟）";
+        }
+        if (type.doesLoad()) {
+            return "（加载）";
+        }
+        return "";
+    }
+
+    private static String ticketTypeName(final TicketType<?> type) {
+        final Identifier registeredName = BuiltInRegistries.TICKET_TYPE.getKey(type);
+        if (registeredName != null) {
+            return registeredName.toString();
+        }
+        if (type == RegionizedPlayerChunkLoader.PLAYER_TICKET) {
+            return "chunk_system:player_ticket";
+        }
+        if (type == RegionizedPlayerChunkLoader.PLAYER_TICKET_DELAYED) {
+            return "chunk_system:player_ticket_delayed";
+        }
+        if (type == ChunkHolderManager.UNLOAD_COOLDOWN) {
+            return "chunk_system:unload_cooldown";
+        }
+        if (type == ChunkTaskScheduler.CHUNK_LOAD) {
+            return "chunk_system:chunk_load";
+        }
+        if (type == ChunkTaskScheduler.NON_FULL_CHUNK_LOAD) {
+            return "chunk_system:non_full_load";
+        }
+        if (type == ChunkTaskScheduler.ENTITY_LOAD) {
+            return "chunk_system:entity_load";
+        }
+        if (type == ChunkTaskScheduler.POI_LOAD) {
+            return "chunk_system:poi_load";
+        }
+        if (type == ChunkTaskScheduler.CHUNK_RELIGHT) {
+            return "starlight:chunk_relight";
+        }
+        if (type == StarLightInterface.CHUNK_WORK_TICKET) {
+            return "starlight:chunk_work_ticket";
+        }
+        return "internal#" + ((ChunkSystemTicketType<?>)(Object)type).moonrise$getId();
+    }
+
+    private static NamedTextColor tpsColor(final double tps) {
+        return tps >= 18.0D ? NamedTextColor.GREEN : tps >= 15.0D ? NamedTextColor.YELLOW : NamedTextColor.RED;
+    }
+
+    private static NamedTextColor msptColor(final double mspt) {
+        return mspt < 40.0D ? NamedTextColor.GREEN : mspt < 50.0D ? NamedTextColor.YELLOW : NamedTextColor.RED;
+    }
+
+    private static NamedTextColor entityColor(final int entities) {
+        return entities < 2_000 ? NamedTextColor.GREEN : entities < 5_000 ? NamedTextColor.YELLOW : NamedTextColor.RED;
+    }
+
+    private static NamedTextColor memoryPressureColor(final long total, final long free) {
+        if (total <= 0L || free < 0L) {
+            return NamedTextColor.GRAY;
+        }
+        final double usedRatio = (double)(total - free) / (double)total;
+        return usedRatio >= 0.9D ? NamedTextColor.RED : usedRatio >= 0.8D ? NamedTextColor.YELLOW : NamedTextColor.GREEN;
+    }
+
+    private static NamedTextColor stallColor(final LeavesXTickDiagnostics.StallType type) {
+        return switch (type) {
+            case GARBAGE_COLLECTION -> NamedTextColor.RED;
+            case COMPUTE -> NamedTextColor.RED;
+            case WAIT_OR_SCHEDULING, JVM_OR_HOST_PAUSE -> NamedTextColor.YELLOW;
+            case MIXED -> NamedTextColor.GOLD;
+            case UNKNOWN -> NamedTextColor.GRAY;
+        };
+    }
+
+    private static final class MutableEntityCount {
+
+        private int total;
+        private int ticking;
+    }
+
+    private static final class MutableBlockEntityCount {
+
+        private int total;
+        private int ticking;
+    }
+
+    private static final class MutableTicketCount {
+
+        private final TicketType<?> type;
+        private int tickets;
+        private int sourceChunks;
+        private int minimumLevel = Integer.MAX_VALUE;
+        private int maximumLevel = Integer.MIN_VALUE;
+
+        private MutableTicketCount(final TicketType<?> type) {
+            this.type = type;
+        }
+    }
+
+    /** Runs one bounded diagnostic section per tick so console rendering cannot create a long tick. */
+    private static final class AllReport {
+
+        private final CommandSender sender;
+        private final Selection selection;
+        private final AllReportTiming timing = new AllReportTiming(System.nanoTime());
+        private EntitySnapshot entities;
+        private BlockEntitySnapshot blockEntities;
+
+        private AllReport(final CommandSender sender, final Selection selection) {
+            this.sender = sender;
+            this.selection = selection;
+        }
+
+        private void start() {
+            this.runStage("世界与状态", () -> {
+                this.entities = collectEntities(this.selection.worlds());
+                sendStatus(this.sender);
+                sendWorlds(this.sender, this.selection.worlds(), this.entities);
+                sendActivity(this.sender, this.selection.worlds());
+            }, this::sendEntityDetails);
+        }
+
+        private void sendEntityDetails() {
+            this.runStage("实体明细", () -> {
+                sendEntities(this.sender, this.selection, this.entities);
+                sendHotspots(this.sender, this.selection, this.entities);
+                this.entities = null;
+            }, this::sendVillagerDetails);
+        }
+
+        private void sendVillagerDetails() {
+            this.runStage(
+                "村民诊断",
+                () -> LeavesXVillagerDiagnostics.send(this.sender, this.selection.worlds(), this.selection.limit()),
+                this::sendBlockEntityDetails
+            );
+        }
+
+        private void sendBlockEntityDetails() {
+            this.runStage("方块实体统计", () -> {
+                this.blockEntities = collectBlockEntities(this.selection.worlds());
+                sendBlockEntities(this.sender, this.selection, this.blockEntities);
+            }, this::sendBlockEntityHotspots);
+        }
+
+        private void sendBlockEntityHotspots() {
+            this.runStage("方块实体热点", () -> {
+                sendBlockHotspots(this.sender, this.selection, this.blockEntities);
+                this.blockEntities = null;
+            }, this::sendTickets);
+        }
+
+        private void sendTickets() {
+            this.runStage("区块票据", () -> LeavesXCommand.sendTickets(this.sender, this.selection), this::sendPlugins);
+        }
+
+        private void sendPlugins() {
+            this.runStage("插件任务", () -> LeavesXCommand.sendPlugins(this.sender), this::sendMemory);
+        }
+
+        private void sendMemory() {
+            this.runStage("内存", () -> LeavesXCommand.sendMemory(this.sender), this::sendNetwork);
+        }
+
+        private void sendNetwork() {
+            this.runStage("网络", () -> LeavesXCommand.sendNetwork(this.sender), this::sendThreads);
+        }
+
+        private void sendThreads() {
+            this.runStage("线程", () -> LeavesXCommand.sendThreads(this.sender), this::sendSystem);
+        }
+
+        private void sendSystem() {
+            this.runStage("系统", () -> LeavesXCommand.sendSystem(this.sender), this::sendStalls);
+        }
+
+        private void sendStalls() {
+            this.runStage(
+                "慢 Tick",
+                () -> LeavesXCommand.sendStalls(this.sender, Math.min(5, this.selection.limit())),
+                this::finish
+            );
+        }
+
+        private void finish() {
+            final long stageStartedAt = System.nanoTime();
+            sendConfig(this.sender);
+            this.timing.finishStage("配置", stageStartedAt);
+
+            final double activeMilliseconds = this.timing.activeNanos / 1_000_000.0D;
+            final double maximumStageMilliseconds = this.timing.maximumStageNanos / 1_000_000.0D;
+            final double wallMilliseconds = (System.nanoTime() - this.timing.startedAtNanos) / 1_000_000.0D;
+            this.sender.sendMessage(line(
+                "诊断计算耗时",
+                oneDecimal(activeMilliseconds) + " ms / 最慢阶段 " + this.timing.maximumStageName + ' '
+                    + oneDecimal(maximumStageMilliseconds)
+                    + " ms / 总跨度 " + oneDecimal(wallMilliseconds) + " ms",
+                msptColor(maximumStageMilliseconds)
+            ));
+        }
+
+        private void runStage(final String stageName, final Runnable work, final Runnable nextStage) {
+            final long stageStartedAt = System.nanoTime();
+            work.run();
+            this.timing.finishStage(stageName, stageStartedAt);
+            MinecraftServer.getServer().scheduleOnMain(nextStage);
+        }
+    }
+
+    private static final class AllReportTiming {
+
+        private final long startedAtNanos;
+        private long activeNanos;
+        private long maximumStageNanos;
+        private String maximumStageName = "未知";
+
+        private AllReportTiming(final long startedAtNanos) {
+            this.startedAtNanos = startedAtNanos;
+        }
+
+        private void finishStage(final String stageName, final long stageStartedAtNanos) {
+            final long elapsedNanos = Math.max(0L, System.nanoTime() - stageStartedAtNanos);
+            this.activeNanos += elapsedNanos;
+            if (elapsedNanos > this.maximumStageNanos) {
+                this.maximumStageNanos = elapsedNanos;
+                this.maximumStageName = stageName;
+            }
+        }
+    }
+
+    private record Selection(List<World> worlds, int limit) {
+    }
+
+    private record EntityHotspot(
+        String world,
+        int chunkX,
+        int chunkZ,
+        int blockX,
+        int blockY,
+        int blockZ,
+        int total,
+        int ticking
+    ) {
+    }
+
+    private record EntitySnapshot(
+        Map<Identifier, MutableEntityCount> counts,
+        Map<String, Integer> tickingByWorld,
+        List<EntityHotspot> hotspots,
+        int total,
+        int ticking
+    ) {
+    }
+
+    private record BlockEntitySnapshot(
+        Map<Identifier, MutableBlockEntityCount> counts,
+        List<BlockEntityHotspot> hotspots,
+        int total,
+        int ticking
+    ) {
+    }
+
+    private record BlockEntityHotspot(
+        String world,
+        int chunkX,
+        int chunkZ,
+        int blockX,
+        int blockY,
+        int blockZ,
+        int total,
+        int ticking
+    ) {
+    }
+
+    private record PluginTicketCount(String world, String plugin, int chunks) {
+    }
+}
