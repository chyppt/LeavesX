+++ b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
@@ -0,0 +1,657 @@
+package org.leavesx.leavesx.performance;
+
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.Entity;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+/**
+ * Stably orders immutable distance keys without exposing live entities to worker threads.
+ *
+ * <p>The tick thread snapshots every live coordinate into private primitive storage. Workers may then calculate
+ * squared-distance keys and run radix passes without touching entity or world state, after which the tick thread
+ * applies the stable permutation to the original list. Reused workspaces remove per-sensor snapshot, merge-buffer,
+ * and boxed-index allocation churn.</p>
+ */
+public final class StableDistanceSorter {
+
+    /** Below this size the vanilla TimSort path is consistently competitive and avoids workspace setup. */
+    public static final int MINIMUM_OPTIMIZED_ENTITY_COUNT = 64;
+    private static final int RADIX_BUCKETS = 256;
+    /** Avoids dispatching a worker task for the final one or two merge pairs. */
+    private static final int MIN_PARALLEL_MERGE_PAIRS = 4;
+    private static final int INITIAL_WORKSPACE_CAPACITY = 64;
+    private static final ThreadLocal<Workspace> WORKSPACE = ThreadLocal.withInitial(() -> new Workspace(true));
+
+    private StableDistanceSorter() {
+    }
+
+    /**
+     * Sorts entities by squared distance while preserving the original order of equal-distance entries.
+     *
+     * <p>All entity coordinates are read exactly once on the calling thread. Worker threads only receive private
+     * coordinate, key and index arrays, so Bukkit/Paper thread-affinity rules remain unchanged.</p>
+     */
+    public static <T extends Entity> void sortEntitiesByDistance(
+        final List<T> entities,
+        final Entity origin,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        final int size = entities.size();
+        if (size < 2) {
+            return;
+        }
+
+        final Workspace workspace = acquireWorkspace(size);
+        try {
+            final double originX = origin.getX();
+            final double originY = origin.getY();
+            final double originZ = origin.getZ();
+            // Admit medium snapshots when the compute pool is idle. The snapshot keeps all live-entity reads on the
+            // caller, while the executor decides whether enough idle workers exist to amortize dispatch overhead.
+            final boolean parallelEligible = parallel
+                && LeavesXComputeExecutor.shouldAttempt(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                    size,
+                    parallelThreshold
+                );
+            if (parallelEligible) {
+                snapshotEntityCoordinates(entities, workspace, size);
+                sortCoordinateSnapshot(workspace, size, originX, originY, originZ, true, parallelThreshold);
+            } else {
+                snapshotEntityDistanceKeys(entities, workspace, size, originX, originY, originZ);
+                sortPreparedKeys(workspace, size, parallelEligible, parallelThreshold);
+            }
+            applyPermutation(entities, workspace.order, size);
+        } finally {
+            releaseWorkspace(workspace);
+        }
+    }
+
+    /**
+     * Finds the first nearest entity in a list whose coordinates were snapshotted on the calling thread.
+     *
+     * <p>The caller must perform all eligibility, visibility, event, and world checks before invoking this method.
+     * Workers compare only sortable primitive distance keys. Returning an index instead of an entity keeps the live
+     * object entirely on the tick thread and preserves vanilla's first-entry tie rule.</p>
+     *
+     * @return the original list index, or {@code -1} when the list is empty
+     */
+    public static <T extends Entity> int findNearestIndex(
+        final List<T> entities,
+        final Entity origin,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        final int size = entities.size();
+        if (size == 0) {
+            return -1;
+        }
+
+        final Workspace workspace = acquireWorkspace(size);
+        try {
+            final double originX = origin.getX();
+            final double originY = origin.getY();
+            final double originZ = origin.getZ();
+            final boolean useCoordinateSnapshot = parallel
+                && LeavesXComputeExecutor.shouldAttempt(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SELECT,
+                    size,
+                    parallelThreshold
+                );
+            if (useCoordinateSnapshot) {
+                snapshotEntityCoordinates(entities, workspace, size);
+            } else {
+                snapshotEntityDistanceKeys(entities, workspace, size, originX, originY, originZ);
+            }
+
+            // Do not enter the shared scheduler for a small list. The coordinate snapshot is intentionally only
+            // enabled at the configured threshold; calling the executor and immediately falling back would still
+            // pay atomic counters on every ordinary AI sensor query.
+            final int completedPartitions = useCoordinateSnapshot
+                ? LeavesXComputeExecutor.invokeRangesWithCount(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SELECT,
+                    size,
+                    parallelThreshold,
+                    LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker(),
+                    (taskIndex, start, end) -> workspace.nearestByPartition[taskIndex] = computeDistanceKeysAndFindNearest(
+                        workspace,
+                        start,
+                        end,
+                        originX,
+                        originY,
+                        originZ
+                    )
+                )
+                : 0;
+            if (completedPartitions == 0) {
+                return useCoordinateSnapshot
+                    ? computeDistanceKeysAndFindNearest(workspace, 0, size, originX, originY, originZ)
+                    : nearestInRange(workspace.keys, 0, size);
+            }
+
+            int nearest = -1;
+            for (int partition = 0; partition < completedPartitions; partition++) {
+                final int candidate = workspace.nearestByPartition[partition];
+                if (candidate < 0) {
+                    continue;
+                }
+                if (nearest < 0 || Long.compareUnsigned(workspace.keys[candidate], workspace.keys[nearest]) < 0) {
+                    nearest = candidate;
+                }
+            }
+            return nearest;
+        } finally {
+            releaseWorkspace(workspace);
+        }
+    }
+
+    /**
+     * Produces a stable index order for coordinate snapshots.
+     *
+     * <p>This compatibility entry point is retained for focused verification. Runtime AI sensors use
+     * {@link #sortEntitiesByDistance(List, Entity, boolean, int)} to avoid allocating coordinate snapshots.</p>
+     */
+    public static int[] sort(
+        final double[] x,
+        final double[] y,
+        final double[] z,
+        final double originX,
+        final double originY,
+        final double originZ,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        requireMatchingLengths(x, y, z);
+        final int size = x.length;
+        if (size == 0) {
+            return new int[0];
+        }
+
+        final Workspace workspace = acquireWorkspace(size);
+        try {
+            // Copy the compatibility entry point's mutable arrays before workers can observe them. Runtime entity
+            // sorting writes the same private workspace directly while reading live coordinates on the tick thread.
+            workspace.ensureCoordinateCapacity(size);
+            System.arraycopy(x, 0, workspace.x, 0, size);
+            System.arraycopy(y, 0, workspace.y, 0, size);
+            System.arraycopy(z, 0, workspace.z, 0, size);
+            final boolean parallelEligible = parallel
+                && LeavesXComputeExecutor.shouldAttempt(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                    size,
+                    parallelThreshold
+                );
+            sortCoordinateSnapshot(workspace, size, originX, originY, originZ, parallelEligible, parallelThreshold);
+            return Arrays.copyOf(workspace.order, size);
+        } finally {
+            releaseWorkspace(workspace);
+        }
+    }
+
+    /** Sorts keys that were calculated on the tick thread for a small or explicitly synchronous entity list. */
+    private static void sortPreparedKeys(
+        final Workspace workspace,
+        final int size,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        final boolean parallelEligible = parallel && size >= parallelThreshold;
+        final int completedPartitions = parallelEligible
+            ? LeavesXComputeExecutor.invokeRangesWithCount(
+                LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                size,
+                parallelThreshold,
+                LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker(),
+                (taskIndex, start, end) -> stableRadixRange(
+                    workspace.order,
+                    workspace.scratch,
+                    workspace.keys,
+                    start,
+                    end,
+                    workspace.laneOffsets,
+                    taskIndex * RADIX_BUCKETS
+                )
+            )
+            : 0;
+
+        if (completedPartitions == 0) {
+            if (parallelEligible) {
+                // A failed parallel attempt may have changed one or more ranges before fallback was requested.
+                initializeOrder(workspace.order, size);
+            }
+            stableRadixRange(workspace.order, workspace.scratch, workspace.keys, 0, size, workspace.offsets, 0);
+            return;
+        }
+
+        mergeSortedPartitions(workspace, size, completedPartitions);
+    }
+
+    /**
+     * Computes immutable distance keys and sorts each disjoint range in the same worker invocation.
+     *
+     * <p>Fusing these stages moves all distance arithmetic off the tick thread without adding another dispatch or
+     * exposing live entities to workers. A failed invocation recomputes every key from the private snapshot before
+     * taking the synchronous path, so partially completed ranges can never leak into the result.</p>
+     */
+    private static void sortCoordinateSnapshot(
+        final Workspace workspace,
+        final int size,
+        final double originX,
+        final double originY,
+        final double originZ,
+        final boolean parallelEligible,
+        final int parallelThreshold
+    ) {
+        // The caller performs the admission probe once before taking the coordinate snapshot. The executor still
+        // owns the final backpressure decision, so a busy pool safely returns zero and the caller recomputes here.
+        final int completedPartitions = parallelEligible
+            ? LeavesXComputeExecutor.invokeRangesWithCount(
+                LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                size,
+                parallelThreshold,
+                LeavesXRuntime.aiTargetSearchMinimumItemsPerWorker(),
+                (taskIndex, start, end) -> {
+                    computeDistanceKeysAndInitializeOrder(
+                        workspace,
+                        start,
+                        end,
+                        originX,
+                        originY,
+                        originZ
+                    );
+                    stableRadixRange(
+                        workspace.order,
+                        workspace.scratch,
+                        workspace.keys,
+                        start,
+                        end,
+                        workspace.laneOffsets,
+                        taskIndex * RADIX_BUCKETS
+                    );
+                }
+            )
+            : 0;
+
+        if (completedPartitions == 0) {
+            computeDistanceKeysAndInitializeOrder(workspace, 0, size, originX, originY, originZ);
+            stableRadixRange(workspace.order, workspace.scratch, workspace.keys, 0, size, workspace.offsets, 0);
+            return;
+        }
+
+        mergeSortedPartitions(workspace, size, completedPartitions);
+    }
+
+    /** Completes the stable merge tree after independently sorted contiguous ranges. */
+    private static void mergeSortedPartitions(
+        final Workspace workspace,
+        final int size,
+        final int completedPartitions
+    ) {
+        final int rangeSize = divideCeil(size, completedPartitions);
+        for (int width = rangeSize; width < size; width = nextMergeWidth(width, size)) {
+            final int step = width >= size - width ? size : width << 1;
+            final int pairCount = divideCeil(size, step);
+            if (pairCount >= MIN_PARALLEL_MERGE_PAIRS) {
+                final int mergeWidth = width;
+                final int mergeStep = step;
+                final int mergedPartitions = LeavesXComputeExecutor.invokeRangesWithCount(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_MERGE,
+                    pairCount,
+                    2,
+                    1,
+                    (taskIndex, startPair, endPair) -> mergePairs(
+                        workspace.order,
+                        workspace.scratch,
+                        workspace.keys,
+                        size,
+                        mergeWidth,
+                        mergeStep,
+                        startPair,
+                        endPair
+                    )
+                );
+                if (mergedPartitions == 0) {
+                    // A failed merge can leave individual disjoint ranges completed. Rebuild from identity so the
+                    // fallback never consumes a mixture of pre-merge and post-merge ranges.
+                    initializeOrder(workspace.order, size);
+                    stableRadixRange(workspace.order, workspace.scratch, workspace.keys, 0, size, workspace.offsets, 0);
+                    return;
+                }
+            } else {
+                mergePairs(workspace.order, workspace.scratch, workspace.keys, size, width, step, 0, pairCount);
+            }
+        }
+    }
+
+    /** Captures every live coordinate on the calling tick thread before any worker is scheduled. */
+    private static <T extends Entity> void snapshotEntityCoordinates(
+        final List<T> entities,
+        final Workspace workspace,
+        final int size
+    ) {
+        workspace.ensureCoordinateCapacity(size);
+        final double[] x = workspace.x;
+        final double[] y = workspace.y;
+        final double[] z = workspace.z;
+        for (int index = 0; index < size; index++) {
+            final Entity entity = entities.get(index);
+            x[index] = entity.getX();
+            y[index] = entity.getY();
+            z[index] = entity.getZ();
+        }
+    }
+
+    /** Keeps small synchronous lists on the allocation-free single-pass path. */
+    private static <T extends Entity> void snapshotEntityDistanceKeys(
+        final List<T> entities,
+        final Workspace workspace,
+        final int size,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        final long[] keys = workspace.keys;
+        final int[] order = workspace.order;
+        for (int index = 0; index < size; index++) {
+            final Entity entity = entities.get(index);
+            keys[index] = sortableDistanceKey(
+                squaredDistance(originX, originY, originZ, entity.getX(), entity.getY(), entity.getZ())
+            );
+            order[index] = index;
+        }
+    }
+
+    /** Calculates one primitive snapshot range and initializes the matching stable identity order. */
+    private static void computeDistanceKeysAndInitializeOrder(
+        final Workspace workspace,
+        final int start,
+        final int end,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        final double[] x = workspace.x;
+        final double[] y = workspace.y;
+        final double[] z = workspace.z;
+        final long[] keys = workspace.keys;
+        final int[] order = workspace.order;
+        for (int index = start; index < end; index++) {
+            keys[index] = sortableDistanceKey(
+                squaredDistance(originX, originY, originZ, x[index], y[index], z[index])
+            );
+            order[index] = index;
+        }
+    }
+
+    /** Calculates keys and returns the first nearest index inside one disjoint primitive snapshot range. */
+    private static int computeDistanceKeysAndFindNearest(
+        final Workspace workspace,
+        final int start,
+        final int end,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        int nearest = -1;
+        final double[] x = workspace.x;
+        final double[] y = workspace.y;
+        final double[] z = workspace.z;
+        final long[] keys = workspace.keys;
+        for (int index = start; index < end; index++) {
+            final long key = sortableDistanceKey(
+                squaredDistance(originX, originY, originZ, x[index], y[index], z[index])
+            );
+            keys[index] = key;
+            if (nearest < 0 || Long.compareUnsigned(key, keys[nearest]) < 0) {
+                nearest = index;
+            }
+        }
+        return nearest;
+    }
+
+    /** Merges independent ordered range pairs; callers may safely assign disjoint pair indexes to workers. */
+    private static void mergePairs(
+        final int[] order,
+        final int[] scratch,
+        final long[] keys,
+        final int size,
+        final int width,
+        final int step,
+        final int startPair,
+        final int endPair
+    ) {
+        for (int pair = startPair; pair < endPair; pair++) {
+            final int start = pair * step;
+            final int middle = start + width;
+            if (middle >= size) {
+                continue;
+            }
+            mergeByKey(order, scratch, keys, start, middle, Math.min(size, start + step));
+        }
+    }
+
+    private static void stableRadixRange(
+        int[] order,
+        int[] scratch,
+        final long[] keys,
+        final int start,
+        final int end,
+        final int[] offsets,
+        final int offsetBase
+    ) {
+        final int bucketBase = offsetBase;
+        for (int shift = 0; shift < Long.SIZE; shift += Byte.SIZE) {
+            Arrays.fill(offsets, bucketBase, bucketBase + RADIX_BUCKETS, 0);
+            for (int index = start; index < end; index++) {
+                offsets[bucketBase + bucket(keys[order[index]], shift)]++;
+            }
+
+            int next = start;
+            for (int bucket = 0; bucket < RADIX_BUCKETS; bucket++) {
+                final int offsetIndex = bucketBase + bucket;
+                final int count = offsets[offsetIndex];
+                offsets[offsetIndex] = next;
+                next += count;
+            }
+            for (int index = start; index < end; index++) {
+                final int value = order[index];
+                final int offsetIndex = bucketBase + bucket(keys[value], shift);
+                scratch[offsets[offsetIndex]++] = value;
+            }
+
+            final int[] swap = order;
+            order = scratch;
+            scratch = swap;
+        }
+    }
+
+    private static void mergeByKey(
+        final int[] order,
+        final int[] scratch,
+        final long[] keys,
+        final int start,
+        final int middle,
+        final int end
+    ) {
+        if (Long.compareUnsigned(keys[order[middle - 1]], keys[order[middle]]) <= 0) {
+            return;
+        }
+
+        int left = start;
+        int right = middle;
+        int output = start;
+        while (left < middle && right < end) {
+            if (Long.compareUnsigned(keys[order[left]], keys[order[right]]) <= 0) {
+                scratch[output++] = order[left++];
+            } else {
+                scratch[output++] = order[right++];
+            }
+        }
+        while (left < middle) {
+            scratch[output++] = order[left++];
+        }
+        while (right < end) {
+            scratch[output++] = order[right++];
+        }
+        System.arraycopy(scratch, start, order, start, end - start);
+    }
+
+    /** Applies destination-to-source indices in place and restores the index array to identity for reuse. */
+    private static <T> void applyPermutation(final List<T> values, final int[] order, final int size) {
+        for (int start = 0; start < size; start++) {
+            if (order[start] == start) {
+                continue;
+            }
+
+            final T displaced = values.get(start);
+            int destination = start;
+            while (true) {
+                final int source = order[destination];
+                order[destination] = destination;
+                if (source == start) {
+                    values.set(destination, displaced);
+                    break;
+                }
+                values.set(destination, values.get(source));
+                destination = source;
+            }
+        }
+    }
+
+    private static void initializeOrder(final int[] order, final int size) {
+        for (int index = 0; index < size; index++) {
+            order[index] = index;
+        }
+    }
+
+    /** Returns the first index with the smallest sortable key in one disjoint primitive range. */
+    private static int nearestInRange(final long[] keys, final int start, final int end) {
+        int nearest = -1;
+        for (int index = start; index < end; index++) {
+            if (nearest < 0 || Long.compareUnsigned(keys[index], keys[nearest]) < 0) {
+                nearest = index;
+            }
+        }
+        return nearest;
+    }
+
+    private static int bucket(final long key, final int shift) {
+        return (int)(key >>> shift) & 0xFF;
+    }
+
+    private static long sortableDistanceKey(final double distance) {
+        final long bits = Double.doubleToLongBits(distance);
+        return bits < 0L ? ~bits : bits ^ Long.MIN_VALUE;
+    }
+
+    private static double squaredDistance(
+        final double originX,
+        final double originY,
+        final double originZ,
+        final double x,
+        final double y,
+        final double z
+    ) {
+        final double deltaX = originX - x;
+        final double deltaY = originY - y;
+        final double deltaZ = originZ - z;
+        return deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ;
+    }
+
+    private static void requireMatchingLengths(final double[] x, final double[] y, final double[] z) {
+        if (x.length != y.length || x.length != z.length) {
+            throw new IllegalArgumentException("Coordinate arrays must have matching lengths");
+        }
+    }
+
+    private static Workspace acquireWorkspace(final int size) {
+        final Workspace cached = WORKSPACE.get();
+        final Workspace workspace;
+        if (cached.inUse) {
+            // Sensor re-entry is not expected, but a private temporary workspace keeps that case behaviorally safe.
+            workspace = new Workspace(false);
+        } else {
+            cached.inUse = true;
+            workspace = cached;
+        }
+        // The scheduler may use two deterministic ranges per physical lane. Reserve one private histogram slice for
+        // every possible range so workers never contend for offsets or write outside the workspace.
+        workspace.ensureCapacity(size, LeavesXComputeExecutor.computePartitionCapacity());
+        return workspace;
+    }
+
+    private static void releaseWorkspace(final Workspace workspace) {
+        if (workspace.pooled) {
+            workspace.inUse = false;
+        }
+    }
+
+    private static int divideCeil(final int dividend, final int divisor) {
+        return dividend == 0 ? 0 : 1 + (dividend - 1) / divisor;
+    }
+
+    private static int nextMergeWidth(final int width, final int length) {
+        return width >= length - width ? length : width << 1;
+    }
+
+    private static int expandedCapacity(final int current, final int required) {
+        int capacity = Math.max(INITIAL_WORKSPACE_CAPACITY, current);
+        while (capacity < required) {
+            final int expanded = capacity + (capacity >>> 1);
+            if (expanded <= capacity) {
+                return required;
+            }
+            capacity = expanded;
+        }
+        return capacity;
+    }
+
+    private static final class Workspace {
+
+        private final boolean pooled;
+        private final int[] offsets = new int[RADIX_BUCKETS];
+        private double[] x = new double[0];
+        private double[] y = new double[0];
+        private double[] z = new double[0];
+        private long[] keys = new long[0];
+        private int[] order = new int[0];
+        private int[] scratch = new int[0];
+        private int[] laneOffsets = new int[0];
+        private int[] nearestByPartition = new int[0];
+        private boolean inUse;
+
+        private Workspace(final boolean pooled) {
+            this.pooled = pooled;
+        }
+
+        private void ensureCapacity(final int size, final int lanes) {
+            if (this.order.length < size) {
+                final int capacity = expandedCapacity(this.order.length, size);
+                this.keys = Arrays.copyOf(this.keys, capacity);
+                this.order = Arrays.copyOf(this.order, capacity);
+                this.scratch = Arrays.copyOf(this.scratch, capacity);
+            }
+            final int requiredLaneOffsets = Math.max(1, lanes) * RADIX_BUCKETS;
+            if (this.laneOffsets.length < requiredLaneOffsets) {
+                this.laneOffsets = new int[requiredLaneOffsets];
+            }
+            if (this.nearestByPartition.length < Math.max(1, lanes)) {
+                this.nearestByPartition = new int[Math.max(1, lanes)];
+            }
+        }
+
+        /** Allocates coordinate storage only for a genuinely parallel snapshot, keeping small AI scans compact. */
+        private void ensureCoordinateCapacity(final int size) {
+            if (this.x.length >= size) {
+                return;
+            }
+            final int capacity = expandedCapacity(this.x.length, size);
+            this.x = Arrays.copyOf(this.x, capacity);
+            this.y = Arrays.copyOf(this.y, capacity);
+            this.z = Arrays.copyOf(this.z, capacity);
+        }
+    }
+}
