+            for (final net.minecraft.world.entity.Entity entity : FeatureHooks.getAllEntities(level)) {
+                final BlockPos blockPosition = entity.blockPosition();
+                final boolean entityTicking = level.isPositionEntityTicking(blockPosition);
+                final MutableEntityCount count = counts.computeIfAbsent(
+                    EntityType.getKey(entity.getType()),
+                    ignored -> new MutableEntityCount()
+                );
+                final long chunkKey = ChunkPos.pack(
+                    SectionPos.blockToSectionCoord(blockPosition.getX()),
+                    SectionPos.blockToSectionCoord(blockPosition.getZ())
+                );
+                count.total++;
+                chunkTotals.addTo(chunkKey, 1);
+                chunkRepresentativePositions.putIfAbsent(chunkKey, blockPosition.asLong());
+                total++;
+                if (entityTicking) {
+                    count.ticking++;
+                    chunkTicking.addTo(chunkKey, 1);
+                    worldTicking++;
+                    tickingTotal++;
+                }
+            }
+            tickingByWorld.put(world.getKey().toString(), worldTicking);
+            for (final Long2IntMap.Entry entry : chunkTotals.long2IntEntrySet()) {
+                final long representativePosition = chunkRepresentativePositions.get(entry.getLongKey());
+                hotspots.add(new EntityHotspot(
+                    world.getKey().toString(),
+                    ChunkPos.getX(entry.getLongKey()),
+                    ChunkPos.getZ(entry.getLongKey()),
+                    BlockPos.getX(representativePosition),
+                    BlockPos.getY(representativePosition),
+                    BlockPos.getZ(representativePosition),
+                    entry.getIntValue(),
+                    chunkTicking.get(entry.getLongKey())
+                ));
+            }
+        }
+        return new EntitySnapshot(counts, tickingByWorld, hotspots, total, tickingTotal);
+    }
