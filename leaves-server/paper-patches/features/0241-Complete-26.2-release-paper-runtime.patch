+
+@Normal
+class LeavesConfigMigratorTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void returnsNoSourceWithoutCreatingFiles() {
+        final Path source = this.temporaryDirectory.resolve("leaves.yml");
+        final Path target = this.temporaryDirectory.resolve("leavesx.yml");
+
+        final LeavesConfigMigrationResult result = migrator().migrate(source, target);
+
+        assertEquals(MigrationStatus.NO_SOURCE, result.status());
+        assertFalse(Files.exists(target));
+    }
+
+    @Test
+    void documentsLeavesAndCreatesOnlyTheSeparatedLeavesXFile() throws Exception {
+        final Path source = writeSource("""
+            config-version: 6
+            settings:
+              modify:
+                fakeplayer:
+                  enable: false
+              future-plugin-key:
+                value: 42
+            unknown-top-level:
+              retained: true
+            """);
+        final ConfigurationNode originalValues = load(source);
+        final Path target = this.temporaryDirectory.resolve("leavesx.yml");
+
+        final LeavesConfigMigrationResult result = migrator().migrate(source, target);
+        final ConfigurationNode documentedLeaves = load(source);
+        final ConfigurationNode leavesX = load(target);
+
+        assertEquals(MigrationStatus.MIGRATED, result.status());
+        assertEquals(originalValues.raw(), documentedLeaves.raw());
+        assertTrue(result.documentedKeys() >= 2);
+        assertFalse(leavesX.hasChild("settings"));
+        assertEquals(LeavesConfigMigrator.LEAVESX_CONFIG_VERSION, leavesX.node("config-version").getInt());
+        assertTrue(leavesX.node("diagnostics", "command-enabled").getBoolean());
+        assertEquals(0, leavesX.node("parallelism", "workers").getInt());
+        assertFalse(leavesX.hasChild("parallelism", "mob-spawning", "workers"));
+
+        final String leavesXText = Files.readString(target);
+        for (final Map.Entry<String, String> comment : LeavesXConfigWriter.comments().entrySet()) {
+            final ConfigurationNode setting = leavesX.node((Object[])comment.getKey().split("\\."));
+            if (!setting.isMap()) assertTrue(comment.getValue().contains("默认："), comment.getKey());
+            assertFalse(comment.getValue().contains("\n"), comment.getKey());
+            if (!setting.virtual()) {
+                assertTrue(leavesXText.contains("# " + comment.getValue()), comment.getKey());
+            }
+        }
+        try (var files = Files.list(this.temporaryDirectory)) {
+            assertEquals(
+                java.util.Set.of("leaves.yml", "leavesx.yml"),
+                files.map(path -> path.getFileName().toString()).collect(java.util.stream.Collectors.toSet())
+            );
+        }
+    }
+
+    @Test
+    void preservesHeaderCommentsUnknownKeysAndCrLfFormatting() throws Exception {
+        final String original = "# User header\r\n"
+            + "config-version: 6 # Keep version\r\n"
+            + "settings:\r\n"
+            + "  modify:\r\n"
+            + "    fakeplayer:\r\n"
+            + "      # Keep disabled\r\n"
+            + "      enable: false # Keep inline\r\n"
+            + "  extension:\r\n"
+            + "    value: \"0012\"\r\n";
+        final Path source = writeSource(original);
+
+        migrator().migrate(source, this.temporaryDirectory.resolve("leavesx.yml"));
+
+        final String documented = Files.readString(source);
+        assertTrue(documented.startsWith("# User header\r\n"));
+        assertTrue(documented.contains("# Keep disabled\r\n"));
+        assertTrue(documented.contains("enable: false # Keep inline\r\n"));
+        assertTrue(documented.contains("value: \"0012\"\r\n"));
+        assertFalse(documented.replace("\r\n", "").contains("\n"));
+    }
+
+    @Test
+    void repeatedMigrationDoesNotOverwriteEitherConfiguration() throws Exception {
+        final Path source = writeSource("config-version: 6\nsettings:\n  custom: true\n");
+        final Path target = this.temporaryDirectory.resolve("leavesx.yml");
+        final LeavesConfigMigrationResult first = migrator().migrate(source, target);
+        final String sourceAfterFirstRun = Files.readString(source);
+        final String targetAfterFirstRun = Files.readString(target);
+
+        Files.writeString(source, sourceAfterFirstRun.replace("custom: true", "custom: false"));
+        final LeavesConfigMigrationResult second = migrator().migrate(source, target);
+
+        assertEquals(MigrationStatus.MIGRATED, first.status());
+        assertEquals(MigrationStatus.ALREADY_MIGRATED, second.status());
+        assertTrue(Files.readString(source).contains("custom: false"));
+        assertEquals(targetAfterFirstRun, Files.readString(target));
+    }
+
+    @Test
+    void rejectsDamagedYamlWithoutPartialOutputs() throws IOException {
+        final Path source = writeSource("settings: [broken\n");
+        final Path target = this.temporaryDirectory.resolve("leavesx.yml");
+
+        assertThrows(LeavesConfigMigrationException.class, () -> migrator().migrate(source, target));
+
+        assertTrue(Files.exists(source));
+        assertFalse(Files.exists(target));
+    }
+
+    @Test
+    void existingTargetIsKeptAsUserOwnedConfiguration() throws IOException {
+        final Path source = writeSource("config-version: 6\nsettings:\n  custom: true\n");
+        final String originalSource = Files.readString(source);
+        final Path target = this.temporaryDirectory.resolve("leavesx.yml");
+        final String existing = "config-version: 1\nperformance:\n  optimized-varint: false\n";
+        Files.writeString(target, existing, StandardCharsets.UTF_8);
+
+        final LeavesConfigMigrationResult result = migrator().migrate(source, target);
+
+        assertEquals(MigrationStatus.ALREADY_MIGRATED, result.status());
+        assertEquals(originalSource, Files.readString(source));
+        assertEquals(existing, Files.readString(target));
+    }
+
+    @Test
+    void removesTheNewTargetWhenTheLeavesWriteFails() throws IOException {
+        final Path source = writeSource("config-version: 6\nsettings:\n  custom: true\n");
+        final String originalSource = Files.readString(source);
+        final Path target = this.temporaryDirectory.resolve("leavesx.yml");
+
+        assertThrows(
+            LeavesConfigMigrationException.class,
+            () -> new LeavesConfigMigrator(new FailingOutput(2)).migrate(source, target)
+        );
+
+        assertEquals(originalSource, Files.readString(source));
+        assertFalse(Files.exists(target));
+    }
+
+    @Test
+    void simplifiesOfficialCommentsToSingleReadableLines() {
+        final Map<String, String> comments = LeavesConfigCommentCatalog.comments();
+        assertTrue(comments.values().stream().noneMatch(comment -> comment.contains("\n")));
+        assertEquals(
+            "是否恢复 1.21 前的方块实体保留行为。此功能风险较高，请谨慎开启。",
+            comments.get("settings.modify.minecraft-old.old-block-remove-behaviour")
+        );
+    }
+
+    @Test
+    void bundlesPinnedOfficialDocumentationLicenseAndNotice() throws Exception {
+        final byte[] encodedDocumentation = readResource("/leavesx/leaves-26.1.2-configuration-zh_Hans.yml.b64");
+        final byte[] documentation = Base64.getMimeDecoder().decode(encodedDocumentation);
+        assertEquals(37_262, documentation.length);
+        assertEquals("a07fbbaed6a6e36ae428250728d7dc016ff34a14d9bd17875ffe446a327b0c10", sha256(documentation));
+
+        final byte[] license = readResource("/META-INF/licenses/leaves-documentation-MPL-2.0.txt");
+        assertEquals(16_725, license.length);
+        assertEquals("1f256ecad192880510e84ad60474eab7589218784b9a50bc7ceee34c2b91f1d5", sha256(license));
+        assertTrue(new String(license, StandardCharsets.UTF_8).startsWith("Mozilla Public License Version 2.0"));
+    }
+
+    private LeavesConfigMigrator migrator() {
+        return new LeavesConfigMigrator();
+    }
+
+    private Path writeSource(final String content) throws IOException {
+        final Path source = this.temporaryDirectory.resolve("leaves.yml");
+        Files.writeString(source, content, StandardCharsets.UTF_8);
+        return source;
+    }
+
+    private static ConfigurationNode load(final Path path) throws Exception {
+        return ConfigurationLoaders.naturallySortedWithoutHeader(path).load();
+    }
+
+    private static byte[] readResource(final String path) throws IOException {
+        try (InputStream input = LeavesConfigMigratorTest.class.getResourceAsStream(path)) {
+            assertNotNull(input, "Missing test resource " + path);
+            return input.readAllBytes();
+        }
+    }
+
+    private static String sha256(final byte[] content) throws Exception {
+        return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(content));
+    }
+
+    private static final class FailingOutput implements MigrationOutput {
+
+        private final int failingWrite;
+        private int writes;
+
+        private FailingOutput(final int failingWrite) {
+            this.failingWrite = failingWrite;
+        }
+
+        @Override
+        public void saveText(final Path target, final String content) throws IOException {
+            if (++this.writes == this.failingWrite) {
+                throw new IOException("Injected migration write failure");
+            }
+            AtomicMigrationOutput.INSTANCE.saveText(target, content);
+        }
+
+        @Override
+        public void deleteIfExists(final Path path) throws IOException {
+            AtomicMigrationOutput.INSTANCE.deleteIfExists(path);
+        }
+    }
+}
