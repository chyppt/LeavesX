+    @Test
+    void normalizesDirectWorkerConfigurationToSafeBounds() {
+        assertEquals(1, LeavesXComputeExecutor.normalizeWorkerCount(-4, 0));
+        assertEquals(24, LeavesXComputeExecutor.normalizeWorkerCount(0, 24));
