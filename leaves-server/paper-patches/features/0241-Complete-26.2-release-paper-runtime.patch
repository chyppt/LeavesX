+            throw new AssertionError("a single useful partition must stay synchronous");
+        }));
+
+        final LeavesXComputeExecutor.Metrics metrics = LeavesXComputeExecutor.metrics();
+        assertEquals(1, metrics.synchronousFallbacks());
+        assertEquals(0, metrics.belowFeatureThresholdFallbacks());
+        assertEquals(1, metrics.insufficientPartitionFallbacks());
+        assertEquals(0, metrics.unavailableParallelismFallbacks());
+    }
+
+    @Test
+    void preSnapshotThresholdRejectionsRemainVisibleToDiagnostics() {
