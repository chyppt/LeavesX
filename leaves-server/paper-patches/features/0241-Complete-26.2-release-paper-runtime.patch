+++ b/src/test/java/org/leavesx/leavesx/performance/LightUpdateCallbackHotPathTest.java
@@ -0,0 +1,126 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import ca.spottedleaf.moonrise.patches.starlight.light.StarLightEngine;
+import java.io.IOException;
+import net.minecraft.server.level.ServerChunkCache;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies light-worker callbacks keep section coordinates primitive until the main-thread handoff. */
+@Normal
+class LightUpdateCallbackHotPathTest {
+
+    private static final String OBJECT_CALLBACK = "(Lnet/minecraft/world/level/LightLayer;Lnet/minecraft/core/SectionPos;)V";
+    private static final String PACKED_CALLBACK = "(Lnet/minecraft/world/level/LightLayer;J)V";
+
+    @Test
+    void starlightUsesPackedCallbacksForBothVisibleUpdateLoops() throws IOException {
+        final ClassNode owner = classNode(StarLightEngine.class);
+        for (final MethodNode method : owner.methods) {
+            if (!method.name.equals("updateVisible") && !method.name.equals("blocksChangedInChunk")) {
+                continue;
+            }
+            final var callbacks = java.util.Arrays.stream(method.instructions.toArray())
+                .filter(MethodInsnNode.class::isInstance)
+                .map(MethodInsnNode.class::cast)
+                .filter(call -> call.name.equals("onLightUpdate"))
+                .toList();
+            if (callbacks.isEmpty()) {
+                continue;
+            }
+            assertTrue(callbacks.stream().anyMatch(call -> call.desc.equals(PACKED_CALLBACK)));
+            assertFalse(callbacks.stream().anyMatch(call -> call.desc.equals(OBJECT_CALLBACK)));
+        }
+    }
+
+    @Test
+    void serverChunkCacheExposesPackedLightCallback() throws IOException {
+        final ClassNode owner = classNode(ServerChunkCache.class);
+        assertTrue(owner.methods.stream().anyMatch(method -> method.name.equals("onLightUpdate")
+            && method.desc.equals(PACKED_CALLBACK)));
+    }
+
+    @Test
+    void serverChunkCacheBatchesPackedCallbacksBeforeTheMainThreadHandoff() throws IOException {
+        final ClassNode owner = classNode(ServerChunkCache.class);
+        assertTrue(owner.methods.stream().anyMatch(method -> method.name.equals("leavesX$enqueueLightUpdate")
+            && method.desc.equals("(Lnet/minecraft/world/level/LightLayer;J)V")));
+        assertTrue(owner.methods.stream().anyMatch(method -> method.name.equals("leavesX$drainLightUpdateBatch")
+            && method.desc.equals("()V")));
+
+        final ClassNode buffer = classNode("net.minecraft.server.level.ServerChunkCache$LeavesXLightUpdateBuffer");
+        assertTrue(buffer.fields.stream().anyMatch(field -> field.name.equals("sectionNodes")
+            && field.desc.equals("[J")));
+        assertTrue(buffer.fields.stream().anyMatch(field -> field.name.equals("skyLight")
+            && field.desc.equals("[Z")));
+    }
+
+    @Test
+    void primitiveBatchPreservesOrderAcrossGrowthAndCanBeReused() throws ReflectiveOperationException {
+        final Class<?> bufferClass = Class.forName(
+            "net.minecraft.server.level.ServerChunkCache$LeavesXLightUpdateBuffer"
+        );
+        final var constructor = bufferClass.getDeclaredConstructor();
+        constructor.setAccessible(true);
+        final Object buffer = constructor.newInstance();
+        final var add = bufferClass.getDeclaredMethod("add", boolean.class, long.class);
+        final var clear = bufferClass.getDeclaredMethod("clear");
+        final var empty = bufferClass.getDeclaredMethod("isEmpty");
+        final var sectionNodesField = bufferClass.getDeclaredField("sectionNodes");
+        final var skyLightField = bufferClass.getDeclaredField("skyLight");
+        final var seenSkySectionsField = bufferClass.getDeclaredField("seenSkySections");
+        final var seenBlockSectionsField = bufferClass.getDeclaredField("seenBlockSections");
+        final var sizeField = bufferClass.getDeclaredField("size");
+        for (final var member : java.util.List.of(add, clear, empty)) {
+            member.setAccessible(true);
+        }
+        for (final var field : java.util.List.of(
+            sectionNodesField, skyLightField, seenSkySectionsField, seenBlockSectionsField, sizeField
+        )) {
+            field.setAccessible(true);
+        }
+
+        assertTrue((boolean)empty.invoke(buffer));
+        for (int index = 0; index < 1_500; ++index) {
+            add.invoke(buffer, (index & 1) == 0, 10_000L + index);
+        }
+        add.invoke(buffer, true, 10_000L);
+        add.invoke(buffer, false, 10_001L);
+
+        final long[] sectionNodes = (long[])sectionNodesField.get(buffer);
+        final boolean[] skyLight = (boolean[])skyLightField.get(buffer);
+        assertEquals(1_500, sizeField.getInt(buffer));
+        assertEquals(750, ((it.unimi.dsi.fastutil.longs.LongOpenHashSet)seenSkySectionsField.get(buffer)).size());
+        assertEquals(750, ((it.unimi.dsi.fastutil.longs.LongOpenHashSet)seenBlockSectionsField.get(buffer)).size());
+        assertTrue(sectionNodes.length >= 1_500);
+        for (int index = 0; index < 1_500; ++index) {
+            assertEquals(10_000L + index, sectionNodes[index]);
+            assertEquals((index & 1) == 0, skyLight[index]);
+        }
+
+        clear.invoke(buffer);
+        assertTrue((boolean)empty.invoke(buffer));
+        assertEquals(0, sizeField.getInt(buffer));
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode node = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return node;
+    }
+
+    private static ClassNode classNode(final String binaryName) throws IOException {
+        final ClassNode node = new ClassNode(Opcodes.ASM9);
+        new ClassReader(binaryName).accept(node, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return node;
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/LightUpdatePacketAssemblyHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/LightUpdatePacketAssemblyHotPathTest.java
