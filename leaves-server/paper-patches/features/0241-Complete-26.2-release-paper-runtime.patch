--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/command/LeavesXCommandSafetyTest.java
@@ -0,0 +1,156 @@
+package org.leavesx.leavesx.command;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.util.Arrays;
+import java.util.List;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.JumpInsnNode;
+import org.objectweb.asm.tree.LdcInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Locks down operator-facing diagnostic safety fixes. */
+@Normal
+class LeavesXCommandSafetyTest {
+
+    private static final String REMOVED_SAMPLING_MESSAGE = "完整诊断分 12 个 Tick 采样，避免命令本身造成长 Tick。";
+
+    @Test
+    void allReportNoLongerPrintsTheSamplingImplementationMessage() throws IOException {
+        final ClassNode report = classNode(LeavesXCommand.class.getName() + "$AllReport");
+
+        assertFalse(report.methods.stream()
+            .flatMap(method -> Arrays.stream(method.instructions.toArray()))
+            .filter(LdcInsnNode.class::isInstance)
+            .map(LdcInsnNode.class::cast)
+            .anyMatch(constant -> REMOVED_SAMPLING_MESSAGE.equals(constant.cst)));
+    }
+
+    @Test
+    void blockEntityDiagnosticsGuardNullableTickerPositions() throws IOException {
+        final MethodNode collect = method(classNode(LeavesXCommand.class.getName()), "collectBlockEntities");
+        final AbstractInsnNode[] instructions = collect.instructions.toArray();
+        final int positionRead = findCall(instructions, "net/minecraft/world/level/block/entity/TickingBlockEntity", "getPos");
+        final int packedPosition = findCallAfter(instructions, positionRead, "net/minecraft/core/BlockPos", "asLong");
+
+        assertTrue(Arrays.stream(instructions, positionRead + 1, packedPosition)
+            .filter(JumpInsnNode.class::isInstance)
+            .map(JumpInsnNode.class::cast)
+            .anyMatch(jump -> jump.getOpcode() == Opcodes.IFNULL || jump.getOpcode() == Opcodes.IFNONNULL));
+    }
+
+    @Test
+    void villagerDiagnosticIsRegisteredAndCannotWriteBrainMemory() throws IOException, ReflectiveOperationException {
+        final Field subcommandsField = LeavesXCommand.class.getDeclaredField("SUBCOMMANDS");
+        subcommandsField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        final List<String> subcommands = (List<String>)subcommandsField.get(null);
+        assertTrue(subcommands.contains("villagers"));
+        assertTrue(subcommands.contains("parallel"));
+        assertTrue(subcommands.contains("reload"));
+
+        final MethodNode snapshot = method(classNode(LeavesXVillagerDiagnostics.class.getName()), "snapshot");
+        assertFalse(Arrays.stream(snapshot.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals("net/minecraft/world/entity/ai/Brain")
+                && (call.name.startsWith("setMemory") || call.name.equals("eraseMemory"))));
+        assertFalse(Arrays.stream(snapshot.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals("net/minecraft/world/entity/ai/Brain")
+                && call.name.equals("getMemory")));
+    }
+
+    @Test
+    void guiCollectsOneSharedTooltipSnapshot() throws IOException {
+        final MethodNode populate = method(classNode(LeavesXDiagnosticsGui.class.getName()), "populate");
+        final long snapshotCalls = Arrays.stream(populate.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .filter(call -> call.owner.equals("org/leavesx/leavesx/command/LeavesXCommand")
+                && call.name.equals("collectGuiLore"))
+            .count();
+
+        assertEquals(1L, snapshotCalls, "every tooltip must reuse one bounded GUI snapshot");
+    }
+
+    @Test
+    void hotspotLocationsExposeAWorldAwareTeleportAction() {
+        final Component component = LeavesXCommand.teleportablePosition(
+            "位置",
+            NamedTextColor.GOLD,
+            "minecraft:the_nether",
+            -5,
+            64,
+            -8
+        );
+
+        final ClickEvent clickEvent = component.clickEvent();
+        assertNotNull(clickEvent);
+        assertEquals(ClickEvent.Action.RUN_COMMAND, clickEvent.action());
+        assertEquals(
+            "/minecraft:execute as @s in minecraft:the_nether run minecraft:tp @s -4.5 64 -7.5",
+            ((ClickEvent.Payload.Text) clickEvent.payload()).value()
+        );
+        assertNotNull(component.hoverEvent());
+    }
+
+    @Test
+    void configReportReadsTheActualTechnicalAndPistonDuplicationFlags() throws IOException {
+        final MethodNode sendConfig = method(classNode(LeavesXCommand.class.getName()), "sendConfig");
+        final List<FieldInsnNode> fields = Arrays.stream(sendConfig.instructions.toArray())
+            .filter(FieldInsnNode.class::isInstance)
+            .map(FieldInsnNode.class::cast)
+            .toList();
+
+        assertTrue(fields.stream().anyMatch(field -> field.name.equals("mcTechnicalMode")));
+        assertTrue(fields.stream().anyMatch(field -> field.name.equals("allowPistonDuplication")));
+    }
+
+    private static ClassNode classNode(final String className) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static int findCall(final AbstractInsnNode[] instructions, final String owner, final String name) {
+        return findCallAfter(instructions, -1, owner, name);
+    }
+
+    private static int findCallAfter(
+        final AbstractInsnNode[] instructions,
+        final int start,
+        final String owner,
+        final String name
+    ) {
+        for (int index = start + 1; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing call " + owner + '#' + name);
+    }
+}
