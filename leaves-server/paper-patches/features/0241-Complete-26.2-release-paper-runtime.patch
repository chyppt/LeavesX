+
+    @Test
+    void supportsCoarseWorkloadsWithSmallIndependentTaskCounts() {
+        LeavesXComputeExecutor.configure(4, 64);
+        final AtomicIntegerArray counts = new AtomicIntegerArray(4);
+
+        final int partitions = LeavesXComputeExecutor.invokeRangesWithCount(
