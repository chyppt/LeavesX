+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer;
+import java.util.List;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.leavesx.leavesx.presentation.LeavesXPlayerPresentation;
+
+/** Verifies fakeplayer presentation accepts MiniMessage and legacy color syntax. */
+@Normal
+final class LeavesXPlayerPresentationTest {
+
+    private static final LegacyComponentSerializer LEGACY = LegacyComponentSerializer.legacySection();
+
+    @AfterEach
+    void restoreDefaults() {
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+    }
+
+    @Test
+    void parsesAmpersandAndSectionSignColorsInDisplayPrefix() {
+        publishConfig("&a[假人]", "", "");
+        assertEquals("\u00A7a[假人]bot", LEGACY.serialize(LeavesXPlayerPresentation.fakeplayerDisplayName("bot")));
+
+        publishConfig("\u00A7b[假人]", "", "");
+        assertEquals("\u00A7b[假人]bot", LEGACY.serialize(LeavesXPlayerPresentation.fakeplayerDisplayName("bot")));
+    }
+
+    @Test
+    void parsesLegacyColorsAlongsideConfiguredPlaceholders() {
+        publishConfig("[假人]", "&6<name> &7joined as <display_name>", "\u00A7c<display_name> left");
+        final Component displayName = LeavesXPlayerPresentation.fakeplayerDisplayName("bot");
+
+        assertEquals("\u00A76bot \u00A77joined as [假人]bot", LEGACY.serialize(
+            LeavesXPlayerPresentation.joinMessage("bot", displayName, Component.text("default"))
+        ));
+        assertEquals("\u00A7c[假人]bot left", LEGACY.serialize(
+            LeavesXPlayerPresentation.quitMessage("bot", displayName, Component.text("default"))
+        ));
+    }
+
+    @Test
+    void keepsMiniMessageCompatibility() {
+        publishConfig("<gray>[假人]</gray>", "<gold><name></gold>", "");
+        final Component displayName = LeavesXPlayerPresentation.fakeplayerDisplayName("bot");
+
+        assertEquals("\u00A77[假人]bot", LEGACY.serialize(displayName));
+        assertEquals("\u00A76bot", LEGACY.serialize(
+            LeavesXPlayerPresentation.joinMessage("bot", displayName, Component.text("default"))
+        ));
+    }
+
+    @Test
+    void exposesExplicitPlayerPlaceholderAndPercentAlias() {
+        publishConfig("", "玩家=<player> / 旧变量=<name> / 百分号=%player_name%", "");
+
+        assertEquals("玩家=Alice / 旧变量=Alice / 百分号=Alice", LEGACY.serialize(
+            LeavesXPlayerPresentation.joinMessage("Alice", Component.text("Alice"), Component.text("default"))
+        ));
+    }
+
+    @Test
+    void defaultLifecycleMessagesExcludeTheDisplayOnlyPrefix() {
+        publishConfig("&a[假人]", "", "");
+
+        assertEquals(
+            Component.translatable("multiplayer.player.joined", Component.text("bot")).color(NamedTextColor.YELLOW),
+            LeavesXPlayerPresentation.defaultJoinMessage("bot")
+        );
+        assertEquals(
+            Component.translatable("multiplayer.player.left", Component.text("bot")).color(NamedTextColor.YELLOW),
+            LeavesXPlayerPresentation.defaultQuitMessage("bot")
+        );
+    }
+
+    @Test
+    void appendsOptionalRoleAfterPrefixWithoutChangingAccountName() {
+        publishConfig("&a[假人]", "", "");
+        LeavesXRuntime.publish(new LeavesXConfig(
+            LeavesXConfig.CURRENT_CONFIG_VERSION,
+            true, 10, 60, 2,
+            true, true, true, true, true, true, true, true,
+            true, true, true, true, true, false, 2, false, 8, 32, 20, 4,
+            true, 256, 128, true, 2_048, 512, true, 0, 64, true, 2_048,
+            true, true, true, true, true, 1_000, 100, 500,
+            LeavesXOptimization.allEnabledMaskLow(), LeavesXOptimization.allEnabledMaskHigh(),
+            true, false, false, 1, true, 40, 16,
+            false, false, false, true, false, false, false, "&a[假人]", List.of(),
+            true, false, true, 4, false, true, true, "[", "]", "", "", "",
+            LeavesXConfig.AsyncSettings.safeDefaults(), LeavesXConfig.ExtensionSettings.defaults(), LeavesXConfig.RegionTickingSettings.safeDefaults()
+        ));
+        assertEquals("\u00A7a[假人][\u00A7b建筑]\u00A7abot", LEGACY.serialize(
+            LeavesXPlayerPresentation.fakeplayerDisplayName("bot", "&b建筑")
+        ));
+    }
+
+    private static void publishConfig(final String prefix, final String join, final String quit) {
+        final java.nio.file.Path path;
+        try {
+            path = java.nio.file.Files.createTempFile("leavesx-presentation-", ".yml");
+            java.nio.file.Files.writeString(path, """
+                config-version: 72
+                fakeplayer:
+                  display-prefix: '%s'
+                messages:
+                  join: '%s'
+                  quit: '%s'
+                """.formatted(prefix, join, quit));
+            LeavesXRuntime.publish(LeavesXConfigLoader.load(path));
+            java.nio.file.Files.deleteIfExists(path);
+        } catch (java.io.IOException exception) {
+            throw new AssertionError("Unable to create temporary LeavesX presentation config", exception);
+        }
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/config/LeavesXReleaseCompatibilityTest.java b/src/test/java/org/leavesx/leavesx/config/LeavesXReleaseCompatibilityTest.java
