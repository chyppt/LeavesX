--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/PoiSearchCapacityTest.java
@@ -0,0 +1,152 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class PoiSearchCapacityTest {
+
+    @Test
+    void includesEverySectionInsideTheVisitedBox() {
+        assertEquals(1_176, PoiSearchCapacity.forBounds(-3, -4, -3, 3, 19, 3));
+    }
+
+    @Test
+    void avoidsRehashingAStandardVillagerPoiSearch() {
+        final int expectedSections = PoiSearchCapacity.forBounds(-3, -4, -3, 3, 19, 3);
+        final RehashCountingSet visited = new RehashCountingSet(expectedSections);
+
+        for (int section = 0; section < expectedSections; section++) {
+            visited.add(section);
+        }
+
+        assertEquals(0, visited.rehashCount);
+    }
+
+    @Test
+    void keepsSmallAndInvalidBoundsAtTheFastutilMinimum() {
+        assertEquals(16, PoiSearchCapacity.forBounds(0, 0, 0, 0, 0, 0));
+        assertEquals(16, PoiSearchCapacity.forBounds(1, 0, 0, 0, 0, 0));
+    }
+
+    @Test
+    void capsLargeSearchesToAvoidExcessiveUpfrontAllocation() {
+        assertEquals(2_048, PoiSearchCapacity.forBounds(Integer.MIN_VALUE, -64, -64, Integer.MAX_VALUE, 64, 64));
+    }
+
+    @Test
+    void testsInclusiveBoundsWithoutPackingCoordinates() {
+        assertTrue(PoiSearchCapacity.contains(-3, -4, -3, -3, -4, -3, 3, 19, 3));
+        assertTrue(PoiSearchCapacity.contains(3, 19, 3, -3, -4, -3, 3, 19, 3));
+        assertFalse(PoiSearchCapacity.contains(4, 0, 0, -3, -4, -3, 3, 19, 3));
+        assertFalse(PoiSearchCapacity.contains(0, -5, 0, -3, -4, -3, 3, 19, 3));
+    }
+
+    @Test
+    void boundedTraversalPreservesReferenceInBoundsOrder() {
+        assertTraversalEquivalent(new Bounds(-3, -4, -3, 3, 19, 3), new SectionPosition(0, 4, 0));
+        assertTraversalEquivalent(new Bounds(10, 2, -8, 14, 7, -2), new SectionPosition(11, 6, -7));
+        assertTraversalEquivalent(new Bounds(5, 5, 5, 5, 5, 5), new SectionPosition(5, 5, 5));
+    }
+
+    private static void assertTraversalEquivalent(final Bounds bounds, final SectionPosition center) {
+        final TraversalResult reference = traverse(bounds, center, false);
+        final TraversalResult bounded = traverse(bounds, center, true);
+
+        assertEquals(reference.inBoundsOrder, bounded.inBoundsOrder);
+        assertEquals(bounds.volume(), bounded.seenCount);
+        assertTrue(bounded.seenCount < reference.seenCount);
+    }
+
+    private static TraversalResult traverse(final Bounds bounds, final SectionPosition center, final boolean boundedNeighbours) {
+        final ArrayDeque<SectionPosition> queue = new ArrayDeque<>();
+        final Set<SectionPosition> seen = new HashSet<>();
+        final List<SectionPosition> inBoundsOrder = new ArrayList<>();
+        seen.add(center);
+        queue.add(center);
+
+        while (!queue.isEmpty()) {
+            final SectionPosition current = queue.removeFirst();
+            if (!bounds.contains(current)) {
+                continue;
+            }
+            inBoundsOrder.add(current);
+
+            for (int dz = -1; dz <= 1; dz++) {
+                for (int dx = -1; dx <= 1; dx++) {
+                    for (int dy = -1; dy <= 1; dy++) {
+                        if ((dx & 1) + (dy & 1) + (dz & 1) != 1) {
+                            continue;
+                        }
+                        final SectionPosition neighbour = new SectionPosition(
+                            current.x + dx,
+                            current.y + dy,
+                            current.z + dz
+                        );
+                        if (boundedNeighbours && !bounds.contains(neighbour)) {
+                            continue;
+                        }
+                        if (seen.add(neighbour)) {
+                            queue.addLast(neighbour);
+                        }
+                    }
+                }
+            }
+        }
+        return new TraversalResult(List.copyOf(inBoundsOrder), seen.size());
+    }
+
+    private record Bounds(int lowerX, int lowerY, int lowerZ, int upperX, int upperY, int upperZ) {
+
+        private boolean contains(final SectionPosition position) {
+            return PoiSearchCapacity.contains(
+                position.x,
+                position.y,
+                position.z,
+                this.lowerX,
+                this.lowerY,
+                this.lowerZ,
+                this.upperX,
+                this.upperY,
+                this.upperZ
+            );
+        }
+
+        private int volume() {
+            return (this.upperX - this.lowerX + 1)
+                * (this.upperY - this.lowerY + 1)
+                * (this.upperZ - this.lowerZ + 1);
+        }
+    }
+
+    private record SectionPosition(int x, int y, int z) {
+    }
+
+    private record TraversalResult(List<SectionPosition> inBoundsOrder, int seenCount) {
+    }
+
+    private static final class RehashCountingSet extends LongOpenHashSet {
+
+        private int rehashCount;
+
+        private RehashCountingSet(final int expected) {
+            super(expected);
+        }
+
+        @Override
+        protected void rehash(final int newSize) {
+            this.rehashCount++;
+            super.rehash(newSize);
+        }
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/PoiVisitedSectionSetTest.java b/src/test/java/org/leavesx/leavesx/performance/PoiVisitedSectionSetTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/PoiVisitedSectionSetTest.java
@@ -0,0 +1,157 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class PoiVisitedSectionSetTest {
+
+    @Test
+    void usesNineteenWordsForAStandardVillagerSearch() {
+        final PoiVisitedSectionSet visited = PoiVisitedSectionSet.create(-3, -4, -3, 3, 19, 3, true, true);
+
+        assertTrue(visited.usesBitSet());
+        assertEquals(19, visited.allocatedWordCount());
+    }
+
+    @Test
+    void reportsOnlyTheFirstMarkAcrossNegativeCoordinates() {
+        final PoiVisitedSectionSet visited = PoiVisitedSectionSet.create(-3, -4, -3, 3, 19, 3, true, true);
+
+        assertTrue(visited.mark(-3, -4, -3));
+        assertFalse(visited.mark(-3, -4, -3));
+        assertTrue(visited.mark(3, 19, 3));
+        assertFalse(visited.mark(3, 19, 3));
+    }
+
+    @Test
+    void fallsBackForDisabledUnboundedAndOversizedSearches() {
+        assertFalse(PoiVisitedSectionSet.create(-3, -4, -3, 3, 19, 3, true, false).usesBitSet());
+        assertFalse(PoiVisitedSectionSet.create(-3, -4, -3, 3, 19, 3, false, true).usesBitSet());
+        assertFalse(PoiVisitedSectionSet.create(-1_024, 0, -1_024, 1_024, 255, 1_024, true, true).usesBitSet());
+    }
+
+    @Test
+    void compactTraversalPreservesReferenceOrder() {
+        assertTraversalEquivalent(new Bounds(-3, -4, -3, 3, 19, 3), new SectionPosition(0, 4, 0));
+        assertTraversalEquivalent(new Bounds(10, 2, -8, 14, 7, -2), new SectionPosition(11, 6, -7));
+        assertTraversalEquivalent(new Bounds(5, 5, 5, 5, 5, 5), new SectionPosition(5, 5, 5));
+    }
+
+    private static void assertTraversalEquivalent(final Bounds bounds, final SectionPosition center) {
+        final List<SectionPosition> reference = referenceTraversal(bounds, center);
+        final List<SectionPosition> compact = compactTraversal(bounds, center);
+
+        assertEquals(reference, compact);
+        assertEquals(bounds.volume(), compact.size());
+    }
+
+    private static List<SectionPosition> referenceTraversal(final Bounds bounds, final SectionPosition center) {
+        final ArrayDeque<SectionPosition> queue = new ArrayDeque<>();
+        final Set<SectionPosition> seen = new HashSet<>();
+        final List<SectionPosition> order = new ArrayList<>();
+        seen.add(center);
+        queue.add(center);
+
+        while (!queue.isEmpty()) {
+            final SectionPosition current = queue.removeFirst();
+            order.add(current);
+            for (int dz = -1; dz <= 1; dz++) {
+                for (int dx = -1; dx <= 1; dx++) {
+                    for (int dy = -1; dy <= 1; dy++) {
+                        if ((dx & 1) + (dy & 1) + (dz & 1) != 1) {
+                            continue;
+                        }
+                        final SectionPosition neighbour = new SectionPosition(
+                            current.x + dx,
+                            current.y + dy,
+                            current.z + dz
+                        );
+                        if (bounds.contains(neighbour) && seen.add(neighbour)) {
+                            queue.addLast(neighbour);
+                        }
+                    }
+                }
+            }
+        }
+        return List.copyOf(order);
+    }
+
+    private static List<SectionPosition> compactTraversal(final Bounds bounds, final SectionPosition center) {
+        final PoiVisitedSectionSet seen = PoiVisitedSectionSet.create(
+            bounds.lowerX,
+            bounds.lowerY,
+            bounds.lowerZ,
+            bounds.upperX,
+            bounds.upperY,
+            bounds.upperZ,
+            true,
+            true
+        );
+        final ArrayDeque<SectionPosition> queue = new ArrayDeque<>();
+        final List<SectionPosition> order = new ArrayList<>();
+        seen.mark(center.x, center.y, center.z);
+        queue.add(center);
+
+        while (!queue.isEmpty()) {
+            final SectionPosition current = queue.removeFirst();
+            order.add(current);
+            enqueue(bounds, seen, queue, current.x, current.y, current.z - 1);
+            enqueue(bounds, seen, queue, current.x - 1, current.y, current.z);
+            enqueue(bounds, seen, queue, current.x, current.y - 1, current.z);
+            enqueue(bounds, seen, queue, current.x, current.y + 1, current.z);
+            enqueue(bounds, seen, queue, current.x + 1, current.y, current.z);
+            enqueue(bounds, seen, queue, current.x, current.y, current.z + 1);
+        }
+        return List.copyOf(order);
+    }
+
+    private static void enqueue(
+        final Bounds bounds,
+        final PoiVisitedSectionSet seen,
+        final ArrayDeque<SectionPosition> queue,
+        final int x,
+        final int y,
+        final int z
+    ) {
+        final SectionPosition position = new SectionPosition(x, y, z);
+        if (bounds.contains(position) && seen.mark(x, y, z)) {
+            queue.addLast(position);
+        }
+    }
+
+    private record Bounds(int lowerX, int lowerY, int lowerZ, int upperX, int upperY, int upperZ) {
+
+        private boolean contains(final SectionPosition position) {
+            return PoiSearchCapacity.contains(
+                position.x,
+                position.y,
+                position.z,
+                this.lowerX,
+                this.lowerY,
+                this.lowerZ,
+                this.upperX,
+                this.upperY,
+                this.upperZ
+            );
+        }
+
+        private int volume() {
+            return (this.upperX - this.lowerX + 1)
+                * (this.upperY - this.lowerY + 1)
+                * (this.upperZ - this.lowerZ + 1);
+        }
+    }
+
+    private record SectionPosition(int x, int y, int z) {
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/PressurePlateEntityScanHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/PressurePlateEntityScanHotPathTest.java
