+@Normal
+public class LeavesXComputeExecutorTest {
+
+    @AfterEach
+    void shutdownExecutor() {
+        LeavesXComputeExecutor.shutdown();
+    }
+
+    @Test
+    void processesEveryIndexExactlyOnce() {
+        LeavesXComputeExecutor.configure(4);
+        final AtomicIntegerArray counts = new AtomicIntegerArray(1024);
+
+        final boolean parallel = LeavesXComputeExecutor.invokeRanges(1024, 128, (taskIndex, start, end) -> {
+            for (int index = start; index < end; index++) {
+                counts.incrementAndGet(index);
+            }
+        });
+
+        assertTrue(parallel);
+        final int[] actual = new int[1024];
+        final int[] expected = new int[1024];
+        for (int index = 0; index < actual.length; index++) {
+            actual[index] = counts.get(index);
+            expected[index] = 1;
+        }
+        assertArrayEquals(expected, actual);
+    }
+
+    @Test
+    void skipsEmptyRangesBeforeTouchingTheExecutor() {
+        LeavesXComputeExecutor.configure(4);
+        assertEquals(
+            0,
+            LeavesXComputeExecutor.invokeRangesWithCount(
+                LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                0,
+                1,
+                1,
+                (taskIndex, start, end) -> { throw new AssertionError("empty input must not invoke a callback"); }
+            )
+        );
+        assertEquals(0L, LeavesXComputeExecutor.metrics().invocations());
+        assertThrows(
+            NullPointerException.class,
+            () -> LeavesXComputeExecutor.invokeRangesWithCount(
+                LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+                1,
+                1,
+                1,
+                null
+            )
+        );
+    }
+
+    @Test
+    void claimsUnevenOverflowRangesWithoutDuplicatingWork() {
+        LeavesXComputeExecutor.configure(4, 64);
+        final int size = 4_097;
+        final AtomicIntegerArray counts = new AtomicIntegerArray(size);
+
+        final boolean parallel = LeavesXComputeExecutor.invokeRanges(size, 64, (taskIndex, start, end) -> {
+            for (int index = start; index < end; index++) {
+                counts.incrementAndGet(index);
+            }
+        });
+
+        assertTrue(parallel);
+        for (int index = 0; index < size; index++) {
+            assertEquals(1, counts.get(index), "index " + index + " must be claimed exactly once");
+        }
+        final LeavesXComputeExecutor.Metrics metrics = LeavesXComputeExecutor.metrics();
+        assertEquals(size, metrics.callerItems() + metrics.workerItems());
+        assertEquals(
+            LeavesXComputeExecutor.partitionCountFor(size, LeavesXComputeExecutor.computeLaneCount(), 64),
+            metrics.callerRanges() + metrics.workerRanges()
+        );
+    }
+
+    @Test
+    void requestsSynchronousFallbackForSmallInputs() {
+        LeavesXComputeExecutor.configure(4);
+        assertFalse(LeavesXComputeExecutor.invokeRanges(LeavesXComputeExecutor.Workload.AI_TARGET_SORT, 127, 128, (taskIndex, start, end) -> {
+            throw new AssertionError("small input must not be submitted");
+        }));
+
+        final LeavesXComputeExecutor.Metrics metrics = LeavesXComputeExecutor.metrics();
+        assertEquals(1, metrics.synchronousFallbacks());
+        assertEquals(1, metrics.belowFeatureThresholdFallbacks());
+        assertEquals(0, metrics.insufficientPartitionFallbacks());
+        assertEquals(0, metrics.unavailableParallelismFallbacks());
+        final LeavesXComputeExecutor.WorkloadMetrics ai = metrics.workloads().stream()
+            .filter(workload -> workload.workload() == LeavesXComputeExecutor.Workload.AI_TARGET_SORT)
+            .findFirst()
+            .orElseThrow();
+        assertEquals(1, ai.invocations());
+        assertEquals(0, ai.parallelInvocations());
+        assertEquals(1, ai.belowFeatureThresholdFallbacks());
+    }
