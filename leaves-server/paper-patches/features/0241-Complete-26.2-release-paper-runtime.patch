+package org.leavesx.leavesx.performance;
+
+/** Calculates the optional passive-animal idle-goal delay without touching entity or world state. */
+public final class AnimalIdleGoalPolicy {
+
+    private AnimalIdleGoalPolicy() {
+    }
+
+    /** Returns a saturated interval multiplication for random stroll goals. */
+    public static int scaleInterval(final int vanillaInterval, final int multiplier) {
+        if (vanillaInterval <= 0 || multiplier <= 1) {
+            return vanillaInterval;
+        }
+        return (int)Math.min(Integer.MAX_VALUE, (long)vanillaInterval * multiplier);
+    }
+
+    /** Returns the equivalent lower activation chance for random look goals. */
+    public static float scaleChance(final float vanillaChance, final int multiplier) {
+        return multiplier <= 1 ? vanillaChance : vanillaChance / multiplier;
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java b/src/main/java/org/leavesx/leavesx/performance/ChunkUnloadBudget.java
