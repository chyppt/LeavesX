+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.ai.Brain;
+import net.minecraft.world.entity.ai.sensing.PlayerSensor;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.player.Player;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies player sensing keeps allocation-light loops and the vanilla stream fallback. */
+@Normal
+class PlayerSensorHotPathTest {
+
+    @Test
+    void sensorKeepsDirectAndVanillaPaths() throws IOException {
+        final List<MethodInsnNode> calls = invocations(method(classNode(PlayerSensor.class), "doTick"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("playerSensorOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValueIfRegistered")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("sortNearbyPlayers")));
+        assertFalse(calls.stream().anyMatch(call -> call.name.equals("leavesX$getMemoryValue")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("stream")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("collect")));
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("toList")));
+    }
+
+    @Test
+    void smallPlayerSortMatchesStableVanillaDistanceOrder() throws ReflectiveOperationException {
+        final LivingEntity body = mock(LivingEntity.class);
+        final Player farther = playerAtDistance(body, 9.0D);
+        final Player equalFirst = playerAtDistance(body, 1.0D);
+        final Player nearest = playerAtDistance(body, 0.0D);
+        final Player equalSecond = playerAtDistance(body, 1.0D);
+        final List<Player> players = new ArrayList<>(List.of(farther, equalFirst, nearest, equalSecond));
+
+        final Method sorter = PlayerSensor.class.getDeclaredMethod("sortNearbyPlayers", List.class, LivingEntity.class);
+        sorter.setAccessible(true);
+        sorter.invoke(null, players, body);
+
+        assertEquals(List.of(nearest, equalFirst, equalSecond, farther), players);
+    }
+
+    @Test
+    void optionalAttackTargetLookupDoesNotRequireTheMemoryToBeRegistered() throws IOException {
+        final List<MethodInsnNode> calls = invocations(method(classNode(Brain.class), "leavesX$getMemoryValueIfRegistered"));
+
+        assertTrue(calls.stream().anyMatch(call -> call.name.equals("getMemorySlotIfPresent")));
+        assertFalse(calls.stream().anyMatch(call -> call.name.equals("getMemorySlot")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+
+    private static Player playerAtDistance(final LivingEntity body, final double distance) {
+        final Player player = mock(Player.class);
+        when(body.distanceToSqr(player)).thenReturn(distance);
+        return player;
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/PoiSearchCapacityTest.java b/src/test/java/org/leavesx/leavesx/performance/PoiSearchCapacityTest.java
