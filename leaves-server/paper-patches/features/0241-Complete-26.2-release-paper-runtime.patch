+        assertEquals(
+            512,
+            migratedNode.node("parallelism", "entity-activation", "minimum-items-per-worker").getInt()
+        );
+        assertEquals(4_096, migratedNode.node("parallelism", "ai-target-search", "minimum-candidates").getInt());
+        assertTrue(Files.readString(path).startsWith("# 用户配置。"));
