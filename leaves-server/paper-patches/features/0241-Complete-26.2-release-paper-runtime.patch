+
+    @Test
+    void startupAiBudgetExplicitlyExemptsVillagers() throws IOException {
+        final MethodNode serverAiStep = method(classNode("net.minecraft.world.entity.Mob"), "serverAiStep");
+        final String villagerOwner = Villager.class.getName().replace('.', '/');
+        final String runtimeOwner = LeavesXRuntime.class.getName().replace('.', '/');
+
+        assertTrue(Arrays.stream(serverAiStep.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .anyMatch(instruction -> instruction.getOpcode() == Opcodes.INSTANCEOF && instruction.desc.equals(villagerOwner)));
+        assertTrue(Arrays.stream(serverAiStep.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(runtimeOwner)
+                && call.name.equals("allowStartupAiStep")
