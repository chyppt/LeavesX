--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/LeavesXReleaseCompatibilityTest.java
@@ -0,0 +1,136 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Modifier;
+import java.net.URISyntaxException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.stream.Stream;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/** Release guards for the Paper-compatible LeavesX runtime and configuration contract. */
+@Normal
+class LeavesXReleaseCompatibilityTest {
+
+    private static final byte[] FORBIDDEN_FOLIA_API = "io/papermc/paper/threadedregions".getBytes(StandardCharsets.US_ASCII);
+
+    @Test
+    void fineGrainedSwitchesRemainUniqueAndFitThePrimitiveMasks() {
+        final LeavesXOptimization[] optimizations = LeavesXOptimization.cachedValues();
+        final Set<String> paths = new HashSet<>(optimizations.length);
+        final Set<String> maskSlots = new HashSet<>(optimizations.length);
+        long combinedMaskLow = 0L;
+        long combinedMaskHigh = 0L;
+
+        assertTrue(optimizations.length <= Long.SIZE * 2, "Extend the mask representation before adding a 129th switch");
+        for (final LeavesXOptimization optimization : optimizations) {
+            assertTrue(paths.add(optimization.path()), "Duplicate LeavesX path: " + optimization.path());
+            assertTrue(
+                maskSlots.add(optimization.wordIndex() + ":" + optimization.mask()),
+                "Duplicate LeavesX mask: " + optimization.path()
+            );
+            assertEquals(optimization.ordinal() / Long.SIZE, optimization.wordIndex(), optimization.path());
+            assertEquals(1L << (optimization.ordinal() % Long.SIZE), optimization.mask(), optimization.path());
+            assertNotNull(LeavesXConfigWriter.comments().get(optimization.path()), optimization.path());
+            if (optimization.wordIndex() == 0) {
+                combinedMaskLow |= optimization.mask();
+            } else {
+                combinedMaskHigh |= optimization.mask();
+            }
+        }
+
+        assertEquals(LeavesXOptimization.allEnabledMaskLow(), combinedMaskLow);
+        assertEquals(LeavesXOptimization.allEnabledMaskHigh(), combinedMaskHigh);
+        assertEquals(optimizations.length, LeavesXConfig.fineGrainedOptimizationCount());
+    }
+
+    @Test
+    void safeDefaultsKeepBehaviorChangingOptionsDisabled() {
+        final LeavesXConfig defaults = LeavesXConfig.safeDefaults();
+
+        assertFalse(defaults.animalIdleGoalThrottling());
+        assertFalse(defaults.startupResidentBots());
+        assertEquals(1, defaults.startupResidentBotsPerTick());
+        assertTrue(defaults.startupAiStaggering());
+        assertEquals(40, defaults.startupAiWarmupTicks());
+        assertEquals(16, defaults.startupAiEntitiesPerTick());
+        assertFalse(defaults.denseMonsterAiThrottling());
+        assertEquals(8, defaults.denseMonsterAiNearbyRadius());
+        assertEquals(32, defaults.denseMonsterAiMinimumEntities());
+        assertEquals(20, defaults.denseMonsterAiCheckIntervalTicks());
+        assertEquals(4, defaults.denseMonsterAiGoalIntervalTicks());
+        assertEquals(LeavesXConfig.fineGrainedOptimizationCount(), defaults.enabledFineGrainedOptimizationCount());
+        assertTrue(defaults.entityStateOptimizations());
+        assertTrue(defaults.entityQueryOptimizations());
+        assertTrue(defaults.aiOptimizations());
+        assertTrue(defaults.pathfindingOptimizations());
+        assertTrue(defaults.mobSpawningOptimizations());
+        assertTrue(defaults.parallelEntityActivation());
+        assertEquals(2_048, defaults.entityActivationMinimumEntities());
+        assertEquals(512, defaults.entityActivationMinimumItemsPerWorker());
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.LIGHT_UPDATE_NOTIFICATION_BATCHING));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.CHUNK_UNLOAD_STAGE_BUFFER_REUSE));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.CHUNK_AUTOSAVE_BUFFER_REUSE));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.CHUNK_STATUS_UPDATE_BUFFER_REUSE));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.CHUNK_UNLOAD_SECTION_SNAPSHOT_CACHE));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.HOPPER_SLOT_STATE_CACHE));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.HOPPER_DIRECT_SLOT_SCANS));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.HOPPER_ITEM_ENTITY_QUERY_BUFFER));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.CONTAINER_OPENER_SEARCH_BOX_CACHE));
+        assertTrue(defaults.optimizationEnabled(LeavesXOptimization.CONTAINER_USER_LIST_SCAN));
+    }
+
+    @Test
+    void workerVisibleOptimizationMasksUseVolatilePublication() throws ReflectiveOperationException {
+        for (final String fieldName : new String[] {
+            "fineGrainedOptimizationMaskLow",
+            "fineGrainedOptimizationMaskHigh"
+        }) {
+            assertTrue(
+                Modifier.isVolatile(LeavesXRuntime.class.getDeclaredField(fieldName).getModifiers()),
+                fieldName
+            );
+        }
+    }
+
+    @Test
+    void generatedCommentsStaySingleLineAndOperatorReadable() {
+        for (final var entry : LeavesXConfigWriter.comments().entrySet()) {
+            final String comment = entry.getValue();
+            assertFalse(comment.contains("\n") || comment.contains("\r"), entry.getKey());
+            assertFalse(comment.contains("nn"), entry.getKey());
+            assertTrue(comment.length() <= 80, entry.getKey() + " comment is too long");
+        }
+    }
+
+    @Test
+    void leavesXRuntimeDoesNotLinkAgainstFoliaApi() throws IOException, URISyntaxException {
+        final Path classesRoot = Path.of(LeavesXRuntime.class.getProtectionDomain().getCodeSource().getLocation().toURI());
+        final Path leavesXClasses = classesRoot.resolve("org").resolve("leavesx").resolve("leavesx");
+        assertTrue(Files.isDirectory(leavesXClasses), leavesXClasses.toString());
+
+        try (Stream<Path> files = Files.walk(leavesXClasses)) {
+            files.filter(path -> path.getFileName().toString().endsWith(".class"))
+                .forEach(LeavesXReleaseCompatibilityTest::assertNoFoliaApiReference);
+        }
+    }
+
+    private static void assertNoFoliaApiReference(final Path classFile) {
+        try {
+            final String bytecode = new String(Files.readAllBytes(classFile), StandardCharsets.ISO_8859_1);
+            final String forbidden = new String(FORBIDDEN_FOLIA_API, StandardCharsets.US_ASCII);
+            assertFalse(bytecode.contains(forbidden), classFile.toString());
+        } catch (final IOException ex) {
+            throw new AssertionError("Unable to inspect " + classFile, ex);
+        }
+    }
+}
