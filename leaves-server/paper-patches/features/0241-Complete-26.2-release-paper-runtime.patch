+    private static void checkConfiguration(final CommandSender sender) {
+        try {
+            final var result = org.leavesx.leavesx.config.LeavesXConfigBootstrap.checkConfiguration();
+            sendHeader(sender, "LeavesX 配置检查");
+            sender.sendMessage(Component.text("YAML 和配置值有效；本次检查未写入文件，也未重载运行时。", NamedTextColor.GREEN));
+            final var unknownKeys = org.leavesx.leavesx.config.LeavesXConfigInspection.unknownKeys(
+                org.leavesx.leavesx.config.LeavesXConfigBootstrap.configurationPath());
+            if (unknownKeys.isEmpty()) {
+                sender.sendMessage(Component.text("未发现未知配置项。", NamedTextColor.GRAY));
+            } else {
+                sender.sendMessage(Component.text("未知配置项（最多显示 32 项）：" + String.join("、", unknownKeys), NamedTextColor.YELLOW));
+            }
+            if (result.restartRequiredChanges().isEmpty()) {
+                sender.sendMessage(Component.text("未发现需要重启的配置变化。", NamedTextColor.GRAY));
+            } else {
+                sender.sendMessage(Component.text("以下项目需要重启后生效：" + String.join("、", result.restartRequiredChanges()), NamedTextColor.YELLOW));
+            }
+            if (result.configuration().asyncSettings().chunkSendEnabled()) {
+                sender.sendMessage(Component.text("提示：异步区块发送仅编码区块节副本；反矿透保持原路径，发包和事件顺序不变。", NamedTextColor.YELLOW));
+            }
+            for (final String warning : org.leavesx.leavesx.config.LeavesXConfigInspection.compatibilityWarnings(result.configuration())) {
+                sender.sendMessage(Component.text("提示：" + warning, NamedTextColor.YELLOW));
+            }
+            if (result.configuration().asyncSettings().mobSpawningEnabled()) {
+                for (final World world : Bukkit.getWorlds()) {
+                    if (!((CraftWorld) world).getHandle().paperConfig().entities.spawning.perPlayerMobSpawns) {
+                        sender.sendMessage(Component.text(world.getKey()
+                            + "：Paper per-player-mob-spawns 未开启，请检查异步刷怪前置条件。", NamedTextColor.YELLOW));
+                    }
+                }
+            }
+        } catch (final RuntimeException exception) {
+            sender.sendMessage(Component.text("配置检查失败：" + exception.getMessage(), NamedTextColor.RED));
+        }
+    }
