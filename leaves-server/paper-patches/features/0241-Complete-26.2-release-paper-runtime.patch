+
+    @Test
+    void acceptsACompleteNonEvenPartition() {
+        LeavesXComputeExecutor.configure(6, 16);
+        final AtomicIntegerArray counts = new AtomicIntegerArray(35);
+
+        final boolean parallel = LeavesXComputeExecutor.invokeRanges(35, 1, (taskIndex, start, end) -> {
+            for (int index = start; index < end; index++) {
+                counts.incrementAndGet(index);
+            }
