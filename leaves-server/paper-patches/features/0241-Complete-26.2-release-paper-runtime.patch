@@ -0,0 +1,33 @@
+package org.leavesx.leavesx.performance;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import net.minecraft.world.level.pathfinder.Node;
+
+/** Reconstructs a path node chain in linear time while preserving the vanilla start-to-target order. */
+public final class PathNodeListBuilder {
+
+    private PathNodeListBuilder() {
+    }
+
+    /**
+     * Copies the {@link Node#cameFrom} chain into a mutable list ordered from the path start to {@code closest}.
+     *
+     * @param closest final node selected by the path finder
+     * @return mutable node list in vanilla order
+     */
+    public static List<Node> build(final Node closest) {
+        int nodeCount = 0;
+        for (Node node = closest; node != null; node = node.cameFrom) {
+            nodeCount++;
+        }
+
+        final List<Node> nodes = new ArrayList<>(nodeCount);
+        for (Node node = closest; node != null; node = node.cameFrom) {
+            nodes.add(node);
+        }
+        Collections.reverse(nodes);
+        return nodes;
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/performance/PoiSearchCapacity.java b/src/main/java/org/leavesx/leavesx/performance/PoiSearchCapacity.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/PoiSearchCapacity.java
@@ -0,0 +1,80 @@
+package org.leavesx.leavesx.performance;
+
+/**
+ * Sizes the visited-section set used by the deterministic POI breadth-first search.
+ *
+ * <p>With bounded neighbour traversal enabled, the search inserts at most every section inside its inclusive bounds.
+ * Pre-sizing for that upper bound avoids repeated hash-table growth during villager bed and job-site searches. The
+ * result is capped so unusually large or heavily distance-pruned searches do not reserve excessive memory up front.</p>
+ */
+public final class PoiSearchCapacity {
+
+    private static final int MINIMUM_EXPECTED_SECTIONS = 16;
+    private static final int MAXIMUM_EXPECTED_SECTIONS = 2_048;
+
+    private PoiSearchCapacity() {
+    }
+
+    /**
+     * Returns a bounded expected element count for an inclusive three-dimensional section box.
+     *
+     * @param lowerX inclusive lower section x
+     * @param lowerY inclusive lower section y
+     * @param lowerZ inclusive lower section z
+     * @param upperX inclusive upper section x
+     * @param upperY inclusive upper section y
+     * @param upperZ inclusive upper section z
+     * @return expected visited-section count suitable for a hash-set constructor
+     */
+    public static int forBounds(
+        final int lowerX,
+        final int lowerY,
+        final int lowerZ,
+        final int upperX,
+        final int upperY,
+        final int upperZ
+    ) {
+        final long width = inclusiveLength(lowerX, upperX);
+        final long height = inclusiveLength(lowerY, upperY);
+        final long depth = inclusiveLength(lowerZ, upperZ);
+        if (width == 0L || height == 0L || depth == 0L) {
+            return MINIMUM_EXPECTED_SECTIONS;
+        }
+
+        final long volume = saturatedMultiply(saturatedMultiply(width, height), depth);
+        return (int)Math.clamp(volume, MINIMUM_EXPECTED_SECTIONS, MAXIMUM_EXPECTED_SECTIONS);
+    }
+
+    /**
+     * Tests whether a section coordinate is inside an inclusive three-dimensional section box.
+     *
+     * @return {@code true} when all three coordinates are within their corresponding bounds
+     */
+    public static boolean contains(
+        final int x,
+        final int y,
+        final int z,
+        final int lowerX,
+        final int lowerY,
+        final int lowerZ,
+        final int upperX,
+        final int upperY,
+        final int upperZ
+    ) {
+        return x >= lowerX && x <= upperX
+            && y >= lowerY && y <= upperY
+            && z >= lowerZ && z <= upperZ;
+    }
+
+    private static long inclusiveLength(final int lower, final int upper) {
+        return upper < lower ? 0L : (long)upper - (long)lower + 1L;
+    }
+
+    private static long saturatedMultiply(final long left, final long right) {
+        if (left == 0L || right == 0L) {
+            return 0L;
+        }
+        return left > Long.MAX_VALUE / right ? Long.MAX_VALUE : left * right;
+    }
+
+}
diff --git a/src/main/java/org/leavesx/leavesx/performance/PoiVisitedSectionSet.java b/src/main/java/org/leavesx/leavesx/performance/PoiVisitedSectionSet.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/PoiVisitedSectionSet.java
@@ -0,0 +1,143 @@
+package org.leavesx.leavesx.performance;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+
+/**
+ * Tracks sections visited by one deterministic POI breadth-first search.
+ *
+ * <p>Bounded searches use one bit per possible section when the search box is reasonably sized. Unbounded or
+ * unusually large searches retain the existing hash-set representation so memory use stays bounded and the
+ * compatibility fallback remains available.</p>
+ */
+public final class PoiVisitedSectionSet {
+
+    private static final long MAXIMUM_BITSET_SECTIONS = 1L << 20;
+
+    private final int minimumX;
+    private final int minimumY;
+    private final int minimumZ;
+    private final int sizeX;
+    private final int sizeY;
+    private final long[] visitedBits;
+    private final LongOpenHashSet fallback;
+
+    private PoiVisitedSectionSet(
+        final int minimumX,
+        final int minimumY,
+        final int minimumZ,
+        final int sizeX,
+        final int sizeY,
+        final long sectionCount
+    ) {
+        this.minimumX = minimumX;
+        this.minimumY = minimumY;
+        this.minimumZ = minimumZ;
+        this.sizeX = sizeX;
+        this.sizeY = sizeY;
+        this.visitedBits = new long[(int)((sectionCount + Long.SIZE - 1L) >>> 6)];
+        this.fallback = null;
+    }
+
+    private PoiVisitedSectionSet(final int expectedSections) {
+        this.minimumX = 0;
+        this.minimumY = 0;
+        this.minimumZ = 0;
+        this.sizeX = 0;
+        this.sizeY = 0;
+        this.visitedBits = null;
+        this.fallback = expectedSections > 0 ? new LongOpenHashSet(expectedSections) : new LongOpenHashSet();
+    }
+
+    /**
+     * Creates the smallest safe representation for an inclusive section box.
+     *
+     * @param boundedTraversal whether callers reject out-of-bounds neighbours before marking them
+     * @param preferBitSet whether the compact representation is enabled
+     * @return a tracker preserving the original packed-coordinate fallback
+     */
+    public static PoiVisitedSectionSet create(
+        final int lowerX,
+        final int lowerY,
+        final int lowerZ,
+        final int upperX,
+        final int upperY,
+        final int upperZ,
+        final boolean boundedTraversal,
+        final boolean preferBitSet
+    ) {
+        if (boundedTraversal && preferBitSet) {
+            final long sizeX = inclusiveLength(lowerX, upperX);
+            final long sizeY = inclusiveLength(lowerY, upperY);
+            final long sizeZ = inclusiveLength(lowerZ, upperZ);
+            final long sectionCount = boundedVolume(sizeX, sizeY, sizeZ);
+            if (sectionCount > 0L) {
+                return new PoiVisitedSectionSet(
+                    lowerX,
+                    lowerY,
+                    lowerZ,
+                    (int)sizeX,
+                    (int)sizeY,
+                    sectionCount
+                );
+            }
+        }
+
+        final int expectedSections = boundedTraversal
+            ? PoiSearchCapacity.forBounds(lowerX, lowerY, lowerZ, upperX, upperY, upperZ)
+            : 0;
+        return new PoiVisitedSectionSet(expectedSections);
+    }
+
+    /**
+     * Marks one section and reports whether it had not been visited before.
+     *
+     * <p>Bit-set callers must only pass coordinates inside the bounds supplied to {@link #create}; POI traversal
+     * checks those bounds before every neighbour insertion.</p>
+     *
+     * @return {@code true} only for the first mark of a section
+     */
+    public boolean mark(final int x, final int y, final int z) {
+        if (this.visitedBits == null) {
+            return this.fallback.add(CoordinateUtils.getChunkSectionKey(x, y, z));
+        }
+
+        final long[] bits = this.visitedBits;
+        final int localX = x - this.minimumX;
+        final int localY = y - this.minimumY;
+        final int localZ = z - this.minimumZ;
+        final int index = ((localZ * this.sizeX + localX) * this.sizeY) + localY;
+        final int wordIndex = index >>> 6;
+        final long mask = 1L << (index & 63);
+        final long previous = bits[wordIndex];
+        if ((previous & mask) != 0L) {
+            return false;
+        }
+        bits[wordIndex] = previous | mask;
+        return true;
+    }
+
+    boolean usesBitSet() {
+        return this.visitedBits != null;
+    }
+
+    int allocatedWordCount() {
+        return this.visitedBits == null ? 0 : this.visitedBits.length;
+    }
+
+    private static long inclusiveLength(final int lower, final int upper) {
+        return upper < lower ? 0L : (long)upper - (long)lower + 1L;
+    }
+
+    private static long boundedVolume(final long sizeX, final long sizeY, final long sizeZ) {
+        if (sizeX == 0L || sizeY == 0L || sizeZ == 0L
+            || sizeX > Integer.MAX_VALUE || sizeY > Integer.MAX_VALUE || sizeZ > Integer.MAX_VALUE) {
+            return 0L;
+        }
+        if (sizeX > MAXIMUM_BITSET_SECTIONS / sizeY) {
+            return 0L;
+        }
+        final long area = sizeX * sizeY;
+        return area > MAXIMUM_BITSET_SECTIONS / sizeZ ? 0L : area * sizeZ;
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java b/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/ProtocolIntegerEncoding.java
@@ -0,0 +1,171 @@
+package org.leavesx.leavesx.performance;
+
+import io.netty.buffer.ByteBuf;
+
+/**
+ * Behavior-equivalent fixed-width encoders for Minecraft protocol integers.
+ *
+ * <p>The implementation is adapted from the Leaf 26.2 Gale/Velocity patches licensed under GPL-3.0-only. It emits
+ * the same little-grouped 7-bit byte stream as the vanilla loops while reducing branches and individual Netty write
+ * calls for multi-byte values. This class owns no mutable state and is safe for every network event loop.</p>
+ */
+public final class ProtocolIntegerEncoding {
+
+    private static final int[] VARLONG_EXACT_BYTE_LENGTHS = createVarLongByteLengths();
+    private static final int[] VARINT_EXACT_BYTE_LENGTHS = createVarIntByteLengths();
+
+    private ProtocolIntegerEncoding() {
+    }
+
+    /**
+     * Returns the exact encoded size of a VarLong.
+     *
+     * @param value value to encode
+     * @return encoded byte count in the range 1 through 10
+     */
+    public static int getVarLongByteSize(final long value) {
+        return VARLONG_EXACT_BYTE_LENGTHS[Long.numberOfLeadingZeros(value)];
+    }
+
+    /** Returns the exact encoded size of a VarInt. */
+    public static int getVarIntByteSize(final int value) {
+        return VARINT_EXACT_BYTE_LENGTHS[Integer.numberOfLeadingZeros(value)];
+    }
+
+    /**
+     * Writes one VarInt using at most two fixed-width buffer operations.
+     *
+     * @param output destination buffer
+     * @param value value to encode
+     * @return {@code output}
+     */
+    public static ByteBuf writeVarInt(final ByteBuf output, final int value) {
+        if ((value & 0xFFFFFF80) == 0) {
+            output.writeByte(value);
+        } else if ((value & 0xFFFFC000) == 0) {
+            final int encoded = (value & 0x7F) << 8
+                | (value >>> 7)
+                | 0x00008000;
+            output.writeShort(encoded);
+        } else if ((value & 0xFFE00000) == 0) {
+            final int encoded = (value & 0x7F) << 16
+                | (value & 0x3F80) << 1
+                | (value >>> 14)
+                | 0x00808000;
+            output.writeMedium(encoded);
+        } else if ((value & 0xF0000000) == 0) {
+            final int encoded = (value & 0x7F) << 24
+                | (value & 0x3F80) << 9
+                | (value & 0x1FC000) >> 6
+                | (value >>> 21)
+                | 0x80808000;
+            output.writeInt(encoded);
+        } else {
+            final int encoded = (value & 0x7F) << 24
+                | (value & 0x3F80) << 9
+                | (value & 0x1FC000) >> 6
+                | ((value >>> 21) & 0x7F)
+                | 0x80808080;
+            output.writeInt(encoded);
+            output.writeByte(value >>> 28);
+        }
+        return output;
+    }
+
+    /**
+     * Writes one VarLong using fixed-width buffer operations.
+     *
+     * @param output destination buffer
+     * @param value value to encode
+     * @return {@code output}
+     */
+    public static ByteBuf writeVarLong(final ByteBuf output, final long value) {
+        if ((value & 0xFFFFFFFFFFFFFF80L) == 0L) {
+            output.writeByte((int) value);
+        } else if (value < 0L) {
+            writeTenByteVarLong(output, value);
+        } else if ((value & 0xFFFFFFFFFFFFC000L) == 0L) {
+            final int least7Bits = (int) value;
+            output.writeShort((least7Bits & 0x7F) << 8 | (least7Bits >>> 7) | 0x00008000);
+        } else if ((value & 0xFFFFFFFFFFE00000L) == 0L) {
+            final int least7Bits = (int) value;
+            output.writeMedium(
+                (least7Bits & 0x7F) << 16
+                    | (least7Bits & 0x3F80) << 1
+                    | (least7Bits >>> 14)
+                    | 0x00808000
+            );
+        } else if ((value & 0xFFFFFFFFF0000000L) == 0L) {
+            final int least7Bits = (int) value;
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808000));
+        } else if ((value & 0xFFFFFFF800000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeByte((int) (value >>> 28));
+        } else if ((value & 0xFFFFFC0000000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final int second7Bits = (int) (value >>> 28);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeShort((second7Bits & 0x7F) << 8 | (second7Bits >>> 7) | 0x00008000);
+        } else if ((value & 0xFFFE000000000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final int second7Bits = (int) (value >>> 28);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeMedium(
+                (second7Bits & 0x7F) << 16
+                    | (second7Bits & 0x3F80) << 1
+                    | (second7Bits >>> 14)
+                    | 0x00808000
+            );
+        } else if ((value & 0xFF00000000000000L) == 0L) {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final int second7Bits = (int) (value >>> 28);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeInt(encodeFourGroups(second7Bits, 0x80808000));
+        } else {
+            final int least7Bits = (int) (value & 0xFFFFFFFL);
+            final long remaining = value >>> 28;
+            final int second7Bits = (int) (remaining & 0xFFFFFFFL);
+            output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+            output.writeInt(encodeFourGroups(second7Bits, 0x80808080));
+            output.writeByte((int) (remaining >>> 28));
+        }
+        return output;
+    }
+
+    private static void writeTenByteVarLong(final ByteBuf output, final long value) {
+        final int least7Bits = (int) (value & 0xFFFFFFFL);
+        final long remaining = value >>> 28;
+        final int second7Bits = (int) (remaining & 0xFFFFFFFL);
+        final int third7Bits = (int) (remaining >>> 28);
+        output.writeInt(encodeFourGroups(least7Bits, 0x80808080));
+        output.writeInt(encodeFourGroups(second7Bits, 0x80808080));
+        output.writeShort((third7Bits & 0x7F) << 8 | (third7Bits >>> 7) | 0x00008000);
+    }
+
+    private static int encodeFourGroups(final int value, final int continuationMask) {
+        return (value & 0x7F) << 24
+            | (value & 0x3F80) << 9
+            | (value & 0x1FC000) >> 6
+            | ((value >>> 21) & 0x7F)
+            | continuationMask;
+    }
+
+    private static int[] createVarLongByteLengths() {
+        final int[] lengths = new int[65];
+        for (int leadingZeros = 0; leadingZeros < 64; ++leadingZeros) {
+            lengths[leadingZeros] = (int) Math.ceil((63.0 - (leadingZeros - 1)) / 7.0);
+        }
+        lengths[64] = 1;
+        return lengths;
+    }
+
+    private static int[] createVarIntByteLengths() {
+        final int[] lengths = new int[33];
+        for (int leadingZeros = 0; leadingZeros < 32; ++leadingZeros) {
+            lengths[leadingZeros] = (int)Math.ceil((31.0 - (leadingZeros - 1)) / 7.0);
+        }
+        lengths[32] = 1;
+        return lengths;
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/performance/SortedIndexListCompactor.java b/src/main/java/org/leavesx/leavesx/performance/SortedIndexListCompactor.java
