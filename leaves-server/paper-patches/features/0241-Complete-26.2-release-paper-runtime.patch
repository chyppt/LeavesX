+    @Test
+    void compatibilityModeKeepsInactiveVillagerBrainTicksAvailable() throws IOException {
+        final MethodNode inactiveTick = method(classNode(Villager.class.getName()), "inactiveTick");
+        final String runtimeOwner = LeavesXRuntime.class.getName().replace('.', '/');
+        final List<String> runtimeCalls = Arrays.stream(inactiveTick.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .filter(call -> call.owner.equals(runtimeOwner))
+            .map(call -> call.name)
+            .toList();
+
+        assertTrue(Arrays.stream(inactiveTick.instructions.toArray())
+            .filter(FieldInsnNode.class::isInstance)
+            .map(FieldInsnNode.class::cast)
+            .anyMatch(field -> field.owner.equals("org/spigotmc/SpigotWorldConfig")
+                && field.name.equals("tickInactiveVillagers")));
+        assertTrue(runtimeCalls.contains("enterVillagerCompatibilityContext"));
+        assertTrue(runtimeCalls.contains("exitVillagerCompatibilityContext"));
+        assertTrue(runtimeCalls.stream().allMatch(call -> call.equals("enterVillagerCompatibilityContext")
+            || call.equals("exitVillagerCompatibilityContext")
+            || call.equals("shouldRunFullInactiveVillagerAi")));
+        assertTrue(runtimeCalls.contains("shouldRunFullInactiveVillagerAi"));
