diff --git a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXChunkDiagnostics.java b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXChunkDiagnostics.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXChunkDiagnostics.java
@@ -0,0 +1,195 @@
+package org.leavesx.leavesx.diagnostics;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.LongAdder;
+import net.minecraft.server.level.TicketType;
+
+/** Stores bounded per-world chunk lifecycle counters for operator diagnostics. */
+public final class LeavesXChunkDiagnostics {
+
+    private static final int MAX_SAMPLES = 301;
+
+    private LeavesXChunkDiagnostics() {
+    }
+
+    /** Per-world counters owned by one chunk holder manager. */
+    public static final class WorldMetrics {
+
+        private final String worldName;
+        private final LongAdder chunkLoads = new LongAdder();
+        private final LongAdder chunkUnloads = new LongAdder();
+        private final LongAdder ticketAdds = new LongAdder();
+        private final LongAdder ticketRemoves = new LongAdder();
+        private final ConcurrentHashMap<TicketType<?>, MutableTicketChurn> ticketChurn = new ConcurrentHashMap<>();
+        private final ArrayDeque<Sample> samples = new ArrayDeque<>(MAX_SAMPLES);
+
+        public WorldMetrics(final String worldName) {
+            this.worldName = worldName;
+        }
+
+        public String worldName() {
+            return this.worldName;
+        }
+
+        public void recordChunkLoad() {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.chunkLoads.increment();
+        }
+
+        public void recordChunkUnload() {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.chunkUnloads.increment();
+        }
+
+        public void recordTicketAdded(final TicketType<?> type) {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.ticketAdds.increment();
+            this.ticketChurn.computeIfAbsent(type, ignored -> new MutableTicketChurn()).adds.increment();
+        }
+
+        public void recordTicketRemoved(final TicketType<?> type) {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.ticketRemoves.increment();
+            this.ticketChurn.computeIfAbsent(type, ignored -> new MutableTicketChurn()).removes.increment();
+        }
+
+        /** Captures one O(1) world sample; the tick loop calls this at most once per second. */
+        public synchronized void sample(
+            final long capturedNanos,
+            final int loadedChunks,
+            final int holders,
+            final long pendingUnloads
+        ) {
+            final Sample previous = this.samples.peekLast();
+            if (previous != null && capturedNanos <= previous.capturedNanos()) {
+                return;
+            }
+            if (this.samples.size() == MAX_SAMPLES) {
+                this.samples.removeFirst();
+            }
+            this.samples.addLast(new Sample(
+                capturedNanos,
+                loadedChunks,
+                holders,
+                pendingUnloads,
+                this.chunkLoads.sum(),
+                this.chunkUnloads.sum(),
+                this.ticketAdds.sum(),
+                this.ticketRemoves.sum()
+            ));
+        }
+
+        /** Returns deltas between the newest sample and the sample nearest the requested cutoff. */
+        public synchronized Activity activity(final int windowSeconds) {
+            final Sample latest = this.samples.peekLast();
+            if (latest == null) {
+                return Activity.empty(this.worldName);
+            }
+            final long cutoff = latest.capturedNanos() - TimeUnit.SECONDS.toNanos(Math.max(1, windowSeconds));
+            Sample baseline = this.samples.peekFirst();
+            for (final Sample sample : this.samples) {
+                if (sample.capturedNanos() > cutoff) {
+                    break;
+                }
+                baseline = sample;
+            }
+            final long elapsedNanos = Math.max(0L, latest.capturedNanos() - baseline.capturedNanos());
+            return new Activity(
+                this.worldName,
+                elapsedNanos,
+                latest.loadedChunks(),
+                latest.holders(),
+                latest.pendingUnloads(),
+                latest.loadedChunks() - baseline.loadedChunks(),
+                latest.holders() - baseline.holders(),
+                latest.pendingUnloads() - baseline.pendingUnloads(),
+                latest.chunkLoads() - baseline.chunkLoads(),
+                latest.chunkUnloads() - baseline.chunkUnloads(),
+                latest.ticketAdds() - baseline.ticketAdds(),
+                latest.ticketRemoves() - baseline.ticketRemoves()
+            );
+        }
+
+        /** Returns the busiest ticket types since this world was created. */
+        public List<TicketChurn> ticketChurn(final int requestedLimit) {
+            final List<TicketChurn> result = new ArrayList<>(this.ticketChurn.size());
+            for (final var entry : this.ticketChurn.entrySet()) {
+                final long adds = entry.getValue().adds.sum();
+                final long removes = entry.getValue().removes.sum();
+                result.add(new TicketChurn(entry.getKey(), adds, removes));
+            }
+            result.sort(Comparator.comparingLong(TicketChurn::operations).reversed());
+            return List.copyOf(result.subList(0, Math.min(Math.max(0, requestedLimit), result.size())));
+        }
+    }
+
+    private static final class MutableTicketChurn {
+
+        private final LongAdder adds = new LongAdder();
+        private final LongAdder removes = new LongAdder();
+    }
+
+    private record Sample(
+        long capturedNanos,
+        int loadedChunks,
+        int holders,
+        long pendingUnloads,
+        long chunkLoads,
+        long chunkUnloads,
+        long ticketAdds,
+        long ticketRemoves
+    ) {
+    }
+
+    public record Activity(
+        String worldName,
+        long elapsedNanos,
+        int loadedChunks,
+        int holders,
+        long pendingUnloads,
+        long loadedChunkDelta,
+        long holderDelta,
+        long pendingUnloadDelta,
+        long completedLoads,
+        long completedUnloads,
+        long ticketAdds,
+        long ticketRemoves
+    ) {
+
+        private static Activity empty(final String worldName) {
+            return new Activity(worldName, 0L, 0, 0, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L);
+        }
+
+        public double elapsedSeconds() {
+            return this.elapsedNanos / 1_000_000_000.0D;
+        }
+
+        public double loadsPerSecond() {
+            return this.elapsedNanos == 0L ? 0.0D : this.completedLoads * 1_000_000_000.0D / this.elapsedNanos;
+        }
+
+        public double unloadsPerSecond() {
+            return this.elapsedNanos == 0L ? 0.0D : this.completedUnloads * 1_000_000_000.0D / this.elapsedNanos;
+        }
+    }
+
+    public record TicketChurn(TicketType<?> type, long adds, long removes) {
+
+        public long operations() {
+            return this.adds + this.removes;
+        }
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXGcDiagnostics.java b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXGcDiagnostics.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXGcDiagnostics.java
@@ -0,0 +1,310 @@
+package org.leavesx.leavesx.diagnostics;
+
+import com.sun.management.GarbageCollectionNotificationInfo;
+import com.sun.management.GcInfo;
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryPoolMXBean;
+import java.lang.management.MemoryType;
+import java.lang.management.MemoryUsage;
+import java.util.ArrayDeque;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import javax.management.Notification;
+import javax.management.NotificationEmitter;
+import javax.management.openmbean.CompositeData;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Collects event-driven GC pauses without polling management beans from the tick loop. */
+public final class LeavesXGcDiagnostics {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXGcDiagnostics.class);
+    private static final int MAX_EVENTS = 256;
+    private static final List<GarbageCollectorMXBean> COLLECTORS = List.copyOf(ManagementFactory.getGarbageCollectorMXBeans());
+    private static final Set<String> HEAP_POOL_NAMES = heapPoolNames();
+    private static final long JVM_NANO_ORIGIN = System.nanoTime()
+        - TimeUnit.MILLISECONDS.toNanos(ManagementFactory.getRuntimeMXBean().getUptime());
+    private static final Recorder RECORDER = new Recorder(MAX_EVENTS);
+    private static final AtomicBoolean INITIALIZED = new AtomicBoolean();
+    private static volatile int registeredCollectors;
+
+    private LeavesXGcDiagnostics() {
+    }
+
+    /** Registers HotSpot GC notification listeners once during server bootstrap. */
+    public static void initialize() {
+        if (!INITIALIZED.compareAndSet(false, true)) {
+            return;
+        }
+
+        int registered = 0;
+        for (final GarbageCollectorMXBean collector : COLLECTORS) {
+            if (!(collector instanceof NotificationEmitter emitter)) {
+                continue;
+            }
+            try {
+                emitter.addNotificationListener(LeavesXGcDiagnostics::onNotification, null, null);
+                registered++;
+            } catch (final RuntimeException ex) {
+                LOGGER.warn("Unable to register LeavesX GC diagnostics for {}", collector.getName(), ex);
+            }
+        }
+        registeredCollectors = registered;
+        LOGGER.info("LeavesX GC diagnostics registered for {} of {} collectors", registered, COLLECTORS.size());
+    }
+
+    /** Returns lifetime collector counters plus activity inside the requested rolling window. */
+    public static Snapshot snapshot(final int windowSeconds) {
+        initialize();
+        long lifetimeCollections = 0L;
+        long lifetimePauseMillis = 0L;
+        for (final GarbageCollectorMXBean collector : COLLECTORS) {
+            lifetimeCollections += Math.max(0L, collector.getCollectionCount());
+            lifetimePauseMillis += Math.max(0L, collector.getCollectionTime());
+        }
+        return RECORDER.snapshot(
+            System.nanoTime(),
+            TimeUnit.SECONDS.toNanos(Math.max(1, windowSeconds)),
+            lifetimeCollections,
+            lifetimePauseMillis,
+            registeredCollectors,
+            COLLECTORS.size()
+        );
+    }
+
+    /** Returns the GC stop-the-world time overlapping a completed server tick. */
+    public static long pauseOverlapping(final long tickStartedNanos, final long tickEndedNanos) {
+        return RECORDER.pauseOverlapping(tickStartedNanos, tickEndedNanos);
+    }
+
+    private static void onNotification(final Notification notification, final Object ignored) {
+        if (!GarbageCollectionNotificationInfo.GARBAGE_COLLECTION_NOTIFICATION.equals(notification.getType())) {
+            return;
+        }
+        final Object userData = notification.getUserData();
+        if (!(userData instanceof CompositeData data)) {
+            return;
+        }
+
+        final GarbageCollectionNotificationInfo information = GarbageCollectionNotificationInfo.from(data);
+        final GcInfo gc = information.getGcInfo();
+        final long startedNanos = JVM_NANO_ORIGIN + TimeUnit.MILLISECONDS.toNanos(gc.getStartTime());
+        final long endedNanos = JVM_NANO_ORIGIN + TimeUnit.MILLISECONDS.toNanos(gc.getEndTime());
+        final long beforeUsed = heapUsed(gc.getMemoryUsageBeforeGc());
+        final long afterUsed = heapUsed(gc.getMemoryUsageAfterGc());
+        RECORDER.record(new RawPause(
+            System.nanoTime(),
+            startedNanos,
+            Math.max(startedNanos, endedNanos),
+            information.getGcName(),
+            information.getGcAction(),
+            information.getGcCause(),
+            beforeUsed,
+            afterUsed
+        ));
+    }
+
+    private static long heapUsed(final Map<String, MemoryUsage> pools) {
+        long used = 0L;
+        for (final Map.Entry<String, MemoryUsage> entry : pools.entrySet()) {
+            if (HEAP_POOL_NAMES.contains(entry.getKey())) {
+                used += Math.max(0L, entry.getValue().getUsed());
+            }
+        }
+        return used;
+    }
+
+    private static Set<String> heapPoolNames() {
+        final Set<String> names = new HashSet<>();
+        for (final MemoryPoolMXBean pool : ManagementFactory.getMemoryPoolMXBeans()) {
+            if (pool.getType() == MemoryType.HEAP) {
+                names.add(pool.getName());
+            }
+        }
+        return Set.copyOf(names);
+    }
+
+    static long estimateAllocatedBytes(final long previousAfterUsed, final long currentBeforeUsed) {
+        if (previousAfterUsed < 0L || currentBeforeUsed <= previousAfterUsed) {
+            return 0L;
+        }
+        return currentBeforeUsed - previousAfterUsed;
+    }
+
+    static boolean isStopTheWorldDuration(final String collector, final String action) {
+        final String description = (collector + ' ' + action).toLowerCase(Locale.ROOT);
+        return description.contains("pause") || (!description.contains("concurrent") && !description.contains("cycle"));
+    }
+
+    static final class Recorder {
+
+        private final int capacity;
+        private final ArrayDeque<GcPause> events;
+        private long previousAfterUsed = -1L;
+        private long newestEvictedObservation = Long.MIN_VALUE;
+
+        Recorder(final int capacity) {
+            if (capacity < 1) {
+                throw new IllegalArgumentException("capacity must be positive");
+            }
+            this.capacity = capacity;
+            this.events = new ArrayDeque<>(capacity);
+        }
+
+        synchronized void record(final RawPause pause) {
+            final long durationNanos = Math.max(0L, pause.endedNanos() - pause.startedNanos());
+            final long reclaimedBytes = Math.max(0L, pause.beforeUsed() - pause.afterUsed());
+            final long allocatedBytes = estimateAllocatedBytes(this.previousAfterUsed, pause.beforeUsed());
+            this.previousAfterUsed = pause.afterUsed();
+            if (this.events.size() == this.capacity) {
+                // GC notification threads can arrive out of timestamp order; retain the latest lost observation.
+                this.newestEvictedObservation = Math.max(
+                    this.newestEvictedObservation, this.events.removeFirst().observedNanos()
+                );
+            }
+            this.events.addLast(new GcPause(
+                pause.observedNanos(),
+                pause.startedNanos(),
+                pause.endedNanos(),
+                durationNanos,
+                pause.collector(),
+                pause.action(),
+                pause.cause(),
+                isStopTheWorldDuration(pause.collector(), pause.action()),
+                pause.beforeUsed(),
+                pause.afterUsed(),
+                reclaimedBytes,
+                allocatedBytes
+            ));
+        }
+
+        synchronized Snapshot snapshot(
+            final long nowNanos,
+            final long windowNanos,
+            final long lifetimeCollections,
+            final long lifetimePauseMillis,
+            final int registeredCollectorCount,
+            final int collectorCount
+        ) {
+            final long cutoff = nowNanos - windowNanos;
+            long pauseNanos = 0L;
+            long concurrentNanos = 0L;
+            long reclaimedBytes = 0L;
+            long estimatedAllocatedBytes = 0L;
+            long maximumPauseNanos = 0L;
+            int collections = 0;
+            int pauseCollections = 0;
+            GcPause lastEvent = null;
+            for (final GcPause event : this.events) {
+                if (event.observedNanos() < cutoff) {
+                    continue;
+                }
+                lastEvent = event;
+                collections++;
+                if (event.stopTheWorld()) {
+                    pauseCollections++;
+                    pauseNanos += event.durationNanos();
+                    maximumPauseNanos = Math.max(maximumPauseNanos, event.durationNanos());
+                } else {
+                    concurrentNanos += event.durationNanos();
+                }
+                reclaimedBytes += event.reclaimedBytes();
+                estimatedAllocatedBytes += event.estimatedAllocatedBytes();
+            }
+            return new Snapshot(
+                lifetimeCollections,
+                lifetimePauseMillis,
+                registeredCollectorCount,
+                collectorCount,
+                windowNanos,
+                collections,
+                pauseCollections,
+                pauseNanos,
+                maximumPauseNanos,
+                concurrentNanos,
+                reclaimedBytes,
+                estimatedAllocatedBytes,
+                this.newestEvictedObservation >= cutoff,
+                lastEvent
+            );
+        }
+
+        synchronized long pauseOverlapping(final long startedNanos, final long endedNanos) {
+            if (endedNanos <= startedNanos) {
+                return 0L;
+            }
+            long overlap = 0L;
+            for (final var iterator = this.events.descendingIterator(); iterator.hasNext();) {
+                final GcPause event = iterator.next();
+                if (event.endedNanos() <= startedNanos) {
+                    break;
+                }
+                if (!event.stopTheWorld()) {
+                    continue;
+                }
+                final long overlapStart = Math.max(startedNanos, event.startedNanos());
+                final long overlapEnd = Math.min(endedNanos, event.endedNanos());
+                if (overlapEnd > overlapStart) {
+                    overlap += overlapEnd - overlapStart;
+                }
+            }
+            return overlap;
+        }
+    }
+
+    static record RawPause(
+        long observedNanos,
+        long startedNanos,
+        long endedNanos,
+        String collector,
+        String action,
+        String cause,
+        long beforeUsed,
+        long afterUsed
+    ) {
+    }
+
+    public record GcPause(
+        long observedNanos,
+        long startedNanos,
+        long endedNanos,
+        long durationNanos,
+        String collector,
+        String action,
+        String cause,
+        boolean stopTheWorld,
+        long beforeUsed,
+        long afterUsed,
+        long reclaimedBytes,
+        long estimatedAllocatedBytes
+    ) {
+    }
+
+    public record Snapshot(
+        long lifetimeCollections,
+        long lifetimePauseMillis,
+        int registeredCollectors,
+        int collectors,
+        long windowNanos,
+        int windowCollections,
+        int windowPauseCollections,
+        long windowPauseNanos,
+        long maximumPauseNanos,
+        long concurrentGcNanos,
+        long reclaimedBytes,
+        long estimatedAllocatedBytes,
+        boolean windowTruncated,
+        GcPause lastPause
+    ) {
+
+        public boolean notificationsAvailable() {
+            return this.registeredCollectors > 0;
+        }
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXPluginTaskDiagnostics.java b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXPluginTaskDiagnostics.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXPluginTaskDiagnostics.java
@@ -0,0 +1,189 @@
+package org.leavesx.leavesx.diagnostics;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.bukkit.plugin.Plugin;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Retains only slow synchronous Bukkit tasks, preserving scheduler behavior and ordering. */
+public final class LeavesXPluginTaskDiagnostics {
+
+    private static final long DISABLED_MARKER = Long.MIN_VALUE;
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXPluginTaskDiagnostics.class);
+    private static final Recorder RECORDER = new Recorder(512);
+    private static final AtomicBoolean FAILURE_REPORTED = new AtomicBoolean();
+
+    private LeavesXPluginTaskDiagnostics() {
+    }
+
+    /** Starts a task timer when diagnostics are enabled. */
+    public static long beginTask() {
+        return org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()
+            ? System.nanoTime()
+            : DISABLED_MARKER;
+    }
+
+    /** Completes a task timer and retains it only when it crossed the configured threshold. */
+    public static void endTask(
+        final long startedNanos,
+        final Plugin plugin,
+        final int taskId,
+        final Class<?> taskClass,
+        final long serverTick
+    ) {
+        if (startedNanos == DISABLED_MARKER) {
+            return;
+        }
+        try {
+            final long observedNanos = System.nanoTime();
+            final long durationNanos = Math.max(0L, observedNanos - startedNanos);
+            if (durationNanos < org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsSlowPluginTaskNanos()) {
+                return;
+            }
+            RECORDER.record(new TaskRecord(
+                observedNanos,
+                serverTick,
+                plugin == null ? "unknown" : plugin.getName(),
+                taskId,
+                taskClass == null ? "unknown" : taskClass.getName(),
+                durationNanos
+            ));
+        } catch (final RuntimeException ex) {
+            // Diagnostics must never change whether a Bukkit task succeeds or fails.
+            if (FAILURE_REPORTED.compareAndSet(false, true)) {
+                LOGGER.warn("LeavesX stopped recording one synchronous plugin task", ex);
+            }
+        }
+    }
+
+    /** Aggregates retained tasks over the configured rolling window. */
+    public static Snapshot snapshot(final int windowSeconds, final int limit) {
+        return RECORDER.snapshot(
+            System.nanoTime(),
+            TimeUnit.SECONDS.toNanos(Math.max(1, windowSeconds)),
+            Math.max(1, limit)
+        );
+    }
+
+    static final class Recorder {
+
+        private final int capacity;
+        private final ArrayDeque<TaskRecord> records;
+
+        Recorder(final int capacity) {
+            if (capacity < 1) {
+                throw new IllegalArgumentException("capacity must be positive");
+            }
+            this.capacity = capacity;
+            this.records = new ArrayDeque<>(capacity);
+        }
+
+        synchronized void record(final TaskRecord record) {
+            if (this.records.size() == this.capacity) {
+                this.records.removeFirst();
+            }
+            this.records.addLast(record);
+        }
+
+        synchronized Snapshot snapshot(final long nowNanos, final long windowNanos, final int limit) {
+            final long cutoff = nowNanos - windowNanos;
+            final Map<String, MutablePluginSummary> summaries = new HashMap<>();
+            TaskRecord slowest = null;
+            int retainedTasks = 0;
+            long retainedNanos = 0L;
+            for (final TaskRecord record : this.records) {
+                if (record.observedNanos() < cutoff) {
+                    continue;
+                }
+                retainedTasks++;
+                retainedNanos += record.durationNanos();
+                if (slowest == null || record.durationNanos() > slowest.durationNanos()) {
+                    slowest = record;
+                }
+                summaries.computeIfAbsent(record.plugin(), MutablePluginSummary::new).add(record);
+            }
+
+            final List<PluginSummary> ordered = new ArrayList<>(summaries.size());
+            for (final MutablePluginSummary summary : summaries.values()) {
+                ordered.add(summary.snapshot());
+            }
+            ordered.sort(Comparator.comparingLong(PluginSummary::totalNanos).reversed()
+                .thenComparing(Comparator.comparingLong(PluginSummary::maximumNanos).reversed())
+                .thenComparing(PluginSummary::plugin));
+            return new Snapshot(
+                windowNanos,
+                retainedTasks,
+                retainedNanos,
+                slowest,
+                List.copyOf(ordered.subList(0, Math.min(limit, ordered.size())))
+            );
+        }
+    }
+
+    private static final class MutablePluginSummary {
+
+        private final String plugin;
+        private int invocations;
+        private long totalNanos;
+        private long maximumNanos;
+        private String slowestTaskClass = "unknown";
+
+        private MutablePluginSummary(final String plugin) {
+            this.plugin = plugin;
+        }
+
+        private void add(final TaskRecord record) {
+            this.invocations++;
+            this.totalNanos += record.durationNanos();
+            if (record.durationNanos() > this.maximumNanos) {
+                this.maximumNanos = record.durationNanos();
+                this.slowestTaskClass = record.taskClass();
+            }
+        }
+
+        private PluginSummary snapshot() {
+            return new PluginSummary(
+                this.plugin,
+                this.invocations,
+                this.totalNanos,
+                this.maximumNanos,
+                this.slowestTaskClass
+            );
+        }
+    }
+
+    public record TaskRecord(
+        long observedNanos,
+        long serverTick,
+        String plugin,
+        int taskId,
+        String taskClass,
+        long durationNanos
+    ) {
+    }
+
+    public record PluginSummary(
+        String plugin,
+        int invocations,
+        long totalNanos,
+        long maximumNanos,
+        String slowestTaskClass
+    ) {
+    }
+
+    public record Snapshot(
+        long windowNanos,
+        int retainedTasks,
+        long retainedNanos,
+        TaskRecord slowestTask,
+        List<PluginSummary> plugins
+    ) {
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXSystemDiagnostics.java b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXSystemDiagnostics.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXSystemDiagnostics.java
@@ -0,0 +1,329 @@
+package org.leavesx.leavesx.diagnostics;
+
+import java.io.IOException;
+import java.lang.management.ManagementFactory;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.Executor;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.SynchronousQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.LongSupplier;
+import java.util.function.Supplier;
+
+/** Reads bounded JVM, operating-system, and Linux cgroup diagnostics on operator request. */
+public final class LeavesXSystemDiagnostics {
+
+    private static final long CACHE_MAX_AGE_NANOS = TimeUnit.SECONDS.toNanos(5L);
+    private static final Path PROC_STATUS = Path.of("/proc/self/status");
+    private static final Path CPU_MAX = Path.of("/sys/fs/cgroup/cpu.max");
+    private static final Path CPU_STAT = Path.of("/sys/fs/cgroup/cpu.stat");
+    private static final Path CPUSET_EFFECTIVE = Path.of("/sys/fs/cgroup/cpuset.cpus.effective");
+    private static final Path MEMORY_CURRENT = Path.of("/sys/fs/cgroup/memory.current");
+    private static final Path MEMORY_MAX = Path.of("/sys/fs/cgroup/memory.max");
+    private static final long MAX_DIAGNOSTIC_FILE_BYTES = 64L * 1024L;
+    private static final ThreadPoolExecutor REFRESH_EXECUTOR = createRefreshExecutor();
+    private static final AsyncCache CACHE = new AsyncCache(
+        CACHE_MAX_AGE_NANOS,
+        REFRESH_EXECUTOR,
+        System::nanoTime,
+        LeavesXSystemDiagnostics::captureNow
+    );
+
+    private LeavesXSystemDiagnostics() {
+    }
+
+    /** Starts the first potentially blocking operating-system sample away from the server thread. */
+    public static void initialize() {
+        CACHE.refresh();
+    }
+
+    /**
+     * Returns the latest immutable system sample and schedules a refresh when it is stale.
+     *
+     * <p>Windows performance counters can block for more than one tick. This method therefore never calls them on
+     * the command or server thread; an expired value remains usable while one bounded background refresh runs.</p>
+     */
+    public static Reading snapshot() {
+        return CACHE.read();
+    }
+
+    /** Captures a point-in-time system snapshot on the dedicated diagnostics worker. */
+    private static Snapshot captureNow() {
+        final java.lang.management.OperatingSystemMXBean baseBean = ManagementFactory.getOperatingSystemMXBean();
+        long physicalTotal = -1L;
+        long physicalFree = -1L;
+        long swapTotal = -1L;
+        long swapFree = -1L;
+        double processCpuLoad = -1.0D;
+        double systemCpuLoad = -1.0D;
+        if (baseBean instanceof com.sun.management.OperatingSystemMXBean bean) {
+            physicalTotal = bean.getTotalMemorySize();
+            physicalFree = bean.getFreeMemorySize();
+            swapTotal = bean.getTotalSwapSpaceSize();
+            swapFree = bean.getFreeSwapSpaceSize();
+            processCpuLoad = bean.getProcessCpuLoad();
+            systemCpuLoad = bean.getCpuLoad();
+        }
+
+        final Map<String, Long> cpuStat = readLongMap(CPU_STAT);
+        return new Snapshot(
+            Runtime.getRuntime().availableProcessors(),
+            readStatusValue("Cpus_allowed_list"),
+            readFirstLine(CPUSET_EFFECTIVE),
+            parseCpuQuota(readFirstLine(CPU_MAX)),
+            cpuStat.getOrDefault("nr_periods", -1L),
+            cpuStat.getOrDefault("nr_throttled", -1L),
+            cpuStat.getOrDefault("throttled_usec", -1L),
+            physicalTotal,
+            physicalFree,
+            swapTotal,
+            swapFree,
+            readLongValue(MEMORY_CURRENT),
+            readLimitValue(MEMORY_MAX),
+            processCpuLoad,
+            systemCpuLoad
+        );
+    }
+
+    private static ThreadPoolExecutor createRefreshExecutor() {
+        final ThreadPoolExecutor executor = new ThreadPoolExecutor(
+            0,
+            1,
+            30L,
+            TimeUnit.SECONDS,
+            new SynchronousQueue<>(),
+            task -> {
+                final Thread thread = new Thread(task, "LeavesX System Diagnostics");
+                thread.setDaemon(true);
+                return thread;
+            }
+        );
+        executor.allowCoreThreadTimeOut(true);
+        return executor;
+    }
+
+    static CpuQuota parseCpuQuota(final String raw) {
+        if (raw == null || raw.isBlank()) {
+            return CpuQuota.unknown();
+        }
+        final String[] parts = raw.trim().split("\\s+");
+        if (parts.length < 2) {
+            return CpuQuota.unknown();
+        }
+        try {
+            final long periodMicros = Long.parseLong(parts[1]);
+            if (periodMicros <= 0L) {
+                return CpuQuota.unknown();
+            }
+            if (parts[0].equals("max")) {
+                return new CpuQuota(true, -1L, periodMicros, -1.0D);
+            }
+            final long quotaMicros = Long.parseLong(parts[0]);
+            if (quotaMicros <= 0L) {
+                return CpuQuota.unknown();
+            }
+            return new CpuQuota(false, quotaMicros, periodMicros, (double)quotaMicros / (double)periodMicros);
+        } catch (final NumberFormatException ignored) {
+            return CpuQuota.unknown();
+        }
+    }
+
+    private static String readStatusValue(final String key) {
+        for (final String line : readSmallLines(PROC_STATUS)) {
+            final int separator = line.indexOf(':');
+            if (separator > 0 && line.substring(0, separator).equals(key)) {
+                return line.substring(separator + 1).trim();
+            }
+        }
+        return null;
+    }
+
+    private static Map<String, Long> readLongMap(final Path path) {
+        final Map<String, Long> values = new HashMap<>();
+        for (final String line : readSmallLines(path)) {
+            final String[] parts = line.trim().split("\\s+");
+            if (parts.length != 2) {
+                continue;
+            }
+            try {
+                values.put(parts[0].toLowerCase(Locale.ROOT), Long.parseLong(parts[1]));
+            } catch (final NumberFormatException ignored) {
+                // Ignore unknown future cgroup counters while retaining supported fields.
+            }
+        }
+        return values;
+    }
+
+    private static long readLongValue(final Path path) {
+        final String value = readFirstLine(path);
+        if (value == null) {
+            return -1L;
+        }
+        try {
+            return Long.parseLong(value.trim());
+        } catch (final NumberFormatException ignored) {
+            return -1L;
+        }
+    }
+
+    private static long readLimitValue(final Path path) {
+        final String value = readFirstLine(path);
+        if (value == null) {
+            return -1L;
+        }
+        if (value.equals("max")) {
+            return Long.MAX_VALUE;
+        }
+        try {
+            return Long.parseLong(value.trim());
+        } catch (final NumberFormatException ignored) {
+            return -1L;
+        }
+    }
+
+    private static String readFirstLine(final Path path) {
+        final List<String> lines = readSmallLines(path);
+        return lines.isEmpty() ? null : lines.getFirst().trim();
+    }
+
+    private static List<String> readSmallLines(final Path path) {
+        try {
+            if (!Files.isRegularFile(path) || Files.size(path) > MAX_DIAGNOSTIC_FILE_BYTES) {
+                return List.of();
+            }
+            return Files.readAllLines(path, StandardCharsets.UTF_8);
+        } catch (final IOException | SecurityException ignored) {
+            return List.of();
+        }
+    }
+
+    public record Snapshot(
+        int jvmProcessors,
+        String allowedCpuList,
+        String effectiveCpuSet,
+        CpuQuota cpuQuota,
+        long cpuPeriods,
+        long throttledPeriods,
+        long throttledMicros,
+        long physicalTotal,
+        long physicalFree,
+        long swapTotal,
+        long swapFree,
+        long cgroupMemoryCurrent,
+        long cgroupMemoryMaximum,
+        double processCpuLoad,
+        double systemCpuLoad
+    ) {
+    }
+
+    /** Immutable cache view returned to the command path. */
+    public record Reading(Snapshot snapshot, long ageMillis, boolean available, boolean refreshing) {
+    }
+
+    public record CpuQuota(boolean unlimited, long quotaMicros, long periodMicros, double processors) {
+
+        private static CpuQuota unknown() {
+            return new CpuQuota(false, -1L, -1L, -1.0D);
+        }
+
+        public boolean known() {
+            return this.unlimited || this.processors >= 0.0D;
+        }
+    }
+
+    /** Small injectable cache used to verify that slow system calls never run on the reader thread. */
+    static final class AsyncCache {
+
+        private final long maximumAgeNanos;
+        private final Executor executor;
+        private final LongSupplier nanoTime;
+        private final Supplier<Snapshot> capture;
+        private final AtomicReference<CachedSnapshot> latest = new AtomicReference<>();
+        private final AtomicBoolean refreshPending = new AtomicBoolean();
+
+        AsyncCache(
+            final long maximumAgeNanos,
+            final Executor executor,
+            final LongSupplier nanoTime,
+            final Supplier<Snapshot> capture
+        ) {
+            this.maximumAgeNanos = maximumAgeNanos;
+            this.executor = executor;
+            this.nanoTime = nanoTime;
+            this.capture = capture;
+        }
+
+        Reading read() {
+            final long now = this.nanoTime.getAsLong();
+            final CachedSnapshot cached = this.latest.get();
+            if (cached == null || elapsedNanos(now, cached.capturedAtNanos()) >= this.maximumAgeNanos) {
+                this.refresh();
+            }
+
+            if (cached == null) {
+                return new Reading(unknownSnapshot(), -1L, false, this.refreshPending.get());
+            }
+            return new Reading(
+                cached.snapshot(),
+                TimeUnit.NANOSECONDS.toMillis(elapsedNanos(now, cached.capturedAtNanos())),
+                true,
+                this.refreshPending.get()
+            );
+        }
+
+        void refresh() {
+            if (!this.refreshPending.compareAndSet(false, true)) {
+                return;
+            }
+            try {
+                this.executor.execute(this::capture);
+            } catch (final RejectedExecutionException ignored) {
+                this.refreshPending.set(false);
+            }
+        }
+
+        private void capture() {
+            try {
+                this.latest.set(new CachedSnapshot(this.capture.get(), this.nanoTime.getAsLong()));
+            } finally {
+                this.refreshPending.set(false);
+            }
+        }
+    }
+
+    private static long elapsedNanos(final long now, final long then) {
+        return Math.max(0L, now - then);
+    }
+
+    private static Snapshot unknownSnapshot() {
+        return new Snapshot(
+            Runtime.getRuntime().availableProcessors(),
+            null,
+            null,
+            CpuQuota.unknown(),
+            -1L,
+            -1L,
+            -1L,
+            -1L,
+            -1L,
+            -1L,
+            -1L,
+            -1L,
+            -1L,
+            -1.0D,
+            -1.0D
+        );
+    }
+
+    private record CachedSnapshot(Snapshot snapshot, long capturedAtNanos) {
+    }
+}
