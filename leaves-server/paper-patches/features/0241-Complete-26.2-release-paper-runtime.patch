+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.papermc.paper.entity.activation.ActivationRange;
+import java.io.IOException;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.InvokeDynamicInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Guards the per-tick activation candidate filter used before spatial query result allocation. */
+@Normal
+class ActivationCandidateDeduplicationHotPathTest {
+
+    @Test
+    void activationQueryFiltersEntitiesAlreadyVisitedThisTick() throws IOException {
+        final ClassNode owner = new ClassNode();
+        new ClassReader(ActivationRange.class.getName()).accept(owner, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        final MethodNode activate = owner.methods.stream()
+            .filter(method -> method.name.equals("activateEntities"))
+            .findFirst()
+            .orElseThrow();
+
+        assertTrue(java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(activate.instructions.iterator(), 0), false
+        ).anyMatch(instruction -> instruction instanceof InvokeDynamicInsnNode dynamic
+            && dynamic.desc.endsWith("Ljava/util/function/Predicate;")));
+
+        final MethodNode filter = owner.methods.stream()
+            .filter(method -> method.name.startsWith("lambda$activateEntities"))
+            .filter(method -> java.util.stream.StreamSupport.stream(
+                java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0), false
+            ).anyMatch(instruction -> instruction instanceof FieldInsnNode field
+                && field.getOpcode() == Opcodes.GETFIELD && field.name.equals("activatedTick")))
+            .findFirst()
+            .orElseThrow();
+        assertFalse(filter.instructions.size() == 0);
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/performance/ActivationRangeHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ActivationRangeHotPathTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ActivationRangeHotPathTest.java
@@ -0,0 +1,103 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.papermc.paper.entity.activation.ActivationRange;
+import java.io.IOException;
+import java.util.Arrays;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+@Normal
+class ActivationRangeHotPathTest {
+
+    @Test
+    void activationLoopReusesPlayerBoundsAndEntityQueryStorage() throws IOException {
+        final MethodNode method = methodNode(ActivationRange.class, "activateEntities");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertEquals(
+            1L,
+            Arrays.stream(calls).filter(call -> call.name.equals("getBoundingBox")).count(),
+            "Each player bounding box should be read once and reused for all activation ranges"
+        );
+        assertFalse(
+            Arrays.stream(calls).anyMatch(call -> call.name.equals("iterator")),
+            "The per-tick activation scan should use the stable indexed entity and player lists"
+        );
+        assertEquals(
+            1L,
+            Arrays.stream(calls).filter(call -> call.owner.equals(
+                "io/papermc/paper/entity/activation/ActivationRangeSnapshot"
+            ) && call.name.equals("activateEntities")).count(),
+            "Large candidate batches should have one explicit snapshot boundary"
+        );
+        assertEquals(
+            1L,
+            Arrays.stream(calls).filter(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+                && call.name.equals("entityActivationQueryBufferReuseOptimization")).count(),
+            "Entity activation must consult its dedicated runtime switch once per world tick"
+        );
+        assertEquals(
+            1L,
+            Arrays.stream(calls).filter(call -> call.owner.equals("net/minecraft/world/level/Level")
+                && call.name.equals("leavesX$acquireEntityQueryBuffer")).count(),
+            "Entity activation should reuse one re-entry-safe query buffer for every player scan"
+        );
+        assertEquals(
+            1L,
+            Arrays.stream(calls).filter(call -> call.owner.equals("net/minecraft/world/level/Level")
+                && call.name.equals("getEntities")).count(),
+            "Disabling buffer reuse must retain Paper's original allocating entity query"
+        );
+    }
+
+    @Test
+    void activationQueryBufferReservesAStableDenseScanCapacity() throws IOException {
+        final ClassNode buffer = classNode(net.minecraft.world.level.Level.LeavesXEntityQueryBuffer.class);
+        final MethodNode constructor = buffer.methods.stream()
+            .filter(method -> method.name.equals("<init>"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing entity query buffer constructor"));
+        assertTrue(
+            Arrays.stream(constructor.instructions.toArray())
+                .filter(TypeInsnNode.class::isInstance)
+                .map(TypeInsnNode.class::cast)
+                .anyMatch(instruction -> instruction.desc.equals("java/util/ArrayList")),
+            "The reusable query buffer must keep an owned ArrayList"
+        );
+        assertTrue(
+            Arrays.stream(constructor.instructions.toArray())
+                .anyMatch(instruction -> instruction.getOpcode() == Opcodes.BIPUSH
+                    || instruction.getOpcode() == Opcodes.SIPUSH
+                    || instruction.getOpcode() == Opcodes.LDC),
+            "The query buffer should pass an explicit baseline capacity"
+        );
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode methodNode(final Class<?> owner, final String methodName) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(methodName))
