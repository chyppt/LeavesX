--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
@@ -0,0 +1,893 @@
+package org.leavesx.leavesx.config;
+
+import io.papermc.paper.util.AtomicFiles;
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.regex.Pattern;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.loader.HeaderMode;
+
+/** Loads and validates the LeavesX global configuration at bootstrap. */
+public final class LeavesXConfigLoader {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXConfigLoader.class);
+    private static final int AI_PARALLEL_DEFAULT_MIGRATION_VERSION = 59;
+    private static final int LEGACY_AI_PARALLEL_DEFAULT = 256;
+    private static final int AI_PARALLEL_DEFAULT = 256;
+    private static final int AI_PARALLEL_ITEMS_DEFAULT = 128;
+    private static final int ENTITY_ACTIVATION_DEFAULT = 2_048;
+    private static final int ENTITY_ACTIVATION_ITEMS_DEFAULT = 512;
+    private static final int MOB_SPAWN_DEFAULT = 2_048;
+    private static final int PARALLEL_THRESHOLD_MIGRATION_VERSION = 64;
+    private static final int SIMPLIFIED_CONFIG_VERSION = 75;
+    private static final String HEADER = "LeavesX 配置。默认设置保持 Paper、Bukkit 和原版行为。";
+    // Schema-owned version comments may be replaced; all other leading user comments stay untouched.
+    private static final Pattern GENERATED_CONFIG_VERSION_COMMENT = Pattern.compile(
+        "(?m)^[\\t ]*#[\\t ]*配置版本，请勿修改。默认：\\d+。[\\t ]*(?:\\r\\n|\\r|\\n|$)"
+    );
+
+    private LeavesXConfigLoader() {
+    }
+
+    /**
+     * Loads a configuration, creating a documented safe default atomically when absent.
+     *
+     * @param path target configuration path
+     * @return immutable runtime snapshot
+     * @throws LeavesXConfigException when YAML is invalid or a value violates the runtime contract
+     */
+    public static LeavesXConfig load(final Path path) {
+        final Path normalized = path.toAbsolutePath().normalize();
+        try {
+            if (Files.notExists(normalized)) {
+                final LeavesXConfig defaults = LeavesXConfig.safeDefaults();
+                save(normalized, defaults);
+                LOGGER.info("Created LeavesX configuration at {} using behavior-compatible defaults", normalized);
+                return defaults;
+            }
+            if (!Files.isRegularFile(normalized)) {
+                throw new LeavesXConfigException("LeavesX configuration is not a regular file: " + normalized);
+            }
+            final CommentedConfigurationNode node = LeavesXConfigWriter.orderedLoader()
+                .headerMode(HeaderMode.PRESERVE)
+                .path(normalized)
+                .build()
+                .load();
+            LeavesXConfig config = fromNode(node, normalized);
+            final int sourceVersion = node.node("config-version").getInt(LeavesXConfig.CURRENT_CONFIG_VERSION);
+            boolean changed = LeavesXConfigPaths.migrate(node);
+            changed |= migrateLegacyAiParallelDefault(node, sourceVersion);
+            changed |= migrateLegacyParallelDefaults(node, sourceVersion);
+            changed |= migrateSimplifiedSettings(node, sourceVersion);
+            if (changed) {
+                config = fromNode(node, normalized);
+            }
+            if (sourceVersion < LeavesXConfig.CURRENT_CONFIG_VERSION) {
+                node.node("config-version").raw(LeavesXConfig.CURRENT_CONFIG_VERSION);
+                LeavesXConfigWriter.refreshKnownComments(node);
+                changed = true;
+            }
+            changed |= LeavesXConfigWriter.writeMissing(node, config);
+            if (changed) {
+                save(normalized, node, readOriginalFormatting(normalized));
+                LOGGER.info("Upgraded LeavesX settings in {} without creating backup or report files", normalized);
+            }
+            return config;
+        } catch (final LeavesXConfigException ex) {
+            throw ex;
+        } catch (final Exception ex) {
+            throw new LeavesXConfigException("Unable to load LeavesX configuration: " + normalized, ex);
+        }
+    }
