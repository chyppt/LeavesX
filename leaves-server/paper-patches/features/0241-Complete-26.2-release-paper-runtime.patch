+    @Test
+    void publicContainerUserQueryStillReturnsAnIndependentList() throws IOException {
+        final MethodNode publicQuery = method(classNode(ContainerOpenersCounter.class), "getEntitiesWithContainerOpen");
+
+        assertTrue(invocations(publicQuery).stream().anyMatch(call -> call.name.equals("getEntities")));
+        assertTrue(hasInvocation(
+            publicQuery,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "containerOpenerSearchBoxCacheOptimization"
+        ));
+        assertTrue(hasInvocation(
+            publicQuery,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "containerUserListScanOptimization"
+        ));
+        assertTrue(hasInvocation(publicQuery, "java/util/stream/Stream", "collect"));
+    }
+
+    @Test
+    void stablePositionAndRangeReuseTheExactSearchGeometry() throws ReflectiveOperationException {
+        final ContainerOpenersCounter counter = new ContainerOpenersCounter() {
+            @Override
+            protected void onOpen(final Level level, final BlockPos pos, final BlockState state) {
+            }
+
+            @Override
+            protected void onClose(final Level level, final BlockPos pos, final BlockState state) {
+            }
+
+            @Override
+            protected void openerCountChanged(
+                final Level level,
+                final BlockPos pos,
+                final BlockState state,
+                final int previous,
+                final int current
+            ) {
+            }
+
+            @Override
+            public boolean isOwnContainer(final Player player) {
+                return false;
+            }
+        };
+        final Method getSearchBox = ContainerOpenersCounter.class.getDeclaredMethod(
+            "leavesXGetSearchBox",
+            BlockPos.class,
+            double.class
+        );
+        getSearchBox.setAccessible(true);
+        final BlockPos position = new BlockPos(12, 64, -8);
+
+        final AABB first = (AABB)getSearchBox.invoke(counter, position, 8.0D);
+        final AABB repeated = (AABB)getSearchBox.invoke(counter, position, 8.0D);
+        final AABB wider = (AABB)getSearchBox.invoke(counter, position, 12.0D);
+
+        assertSame(first, repeated);
+        assertEquals(new AABB(position).inflate(8.0D), first);
+        assertNotSame(first, wider);
+        assertEquals(new AABB(position).inflate(12.0D), wider);
+    }
