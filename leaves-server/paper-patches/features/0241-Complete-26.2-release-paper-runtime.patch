+        final ClassNode spawnState = classNode(NaturalSpawner.SpawnState.class);
+        final MethodNode afterSpawn = method(spawnState, "afterSpawn");
+        assertTrue(calls(afterSpawn, "org/leavesx/leavesx/config/LeavesXRuntime", "naturalSpawnLocalCapAccountingOptimization"));
+        assertTrue(calls(afterSpawn, "net/minecraft/world/level/LocalMobCapCalculator", "addMob", "(JLnet/minecraft/world/entity/MobCategory;)V"));
+        assertTrue(calls(afterSpawn, "net/minecraft/world/level/ChunkPos", "containing"), "Disabled path must retain ChunkPos accounting");
+    }
+
+    private LeavesXConfig configuration(
+        final boolean masterEnabled,
+        final boolean settingEnabled,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
