+
+    @Test
+    void limitsLaneCountWhenEachWorkerWouldReceiveTooLittleWork() {
+        assertEquals(1, LeavesXComputeExecutor.taskCountFor(127, 8, 64));
+        assertEquals(2, LeavesXComputeExecutor.taskCountFor(128, 8, 64));
+        assertEquals(2, LeavesXComputeExecutor.taskCountFor(191, 8, 64));
+        assertEquals(3, LeavesXComputeExecutor.taskCountFor(192, 8, 64));
