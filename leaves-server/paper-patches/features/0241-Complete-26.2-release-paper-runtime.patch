+    }
+
+    /** Builds the default fakeplayer join message from the account name, excluding the display-only prefix. */
+    public static Component defaultJoinMessage(final String accountName) {
+        return Component.translatable("multiplayer.player.joined", Component.text(accountName))
+            .color(NamedTextColor.YELLOW);
+    }
+
+    /** Builds the default fakeplayer quit message from the account name, excluding the display-only prefix. */
+    public static Component defaultQuitMessage(final String accountName) {
+        return Component.translatable("multiplayer.player.left", Component.text(accountName))
+            .color(NamedTextColor.YELLOW);
+    }
+
+    /** Returns the configured join message, or the event's Paper default when no template is configured. */
+    public static Component joinMessage(
+        final String accountName,
+        final Component displayName,
+        final Component paperDefault
+    ) {
+        return render(LeavesXRuntime.joinMessage(), accountName, displayName, paperDefault);
+    }
+
+    /** Returns the configured quit message, or the event's Paper default when no template is configured. */
+    public static Component quitMessage(
+        final String accountName,
+        final Component displayName,
+        final Component paperDefault
+    ) {
+        return render(LeavesXRuntime.quitMessage(), accountName, displayName, paperDefault);
+    }
+
+    /** Adds the configured core prefix to a message emitted by a LeavesX command or lifecycle hook. */
+    public static Component withCorePrefix(final Component message) {
+        final String prefix = LeavesXRuntime.coreMessagePrefix();
+        return prefix.isEmpty() ? message : deserializeConfigured(prefix).append(message);
+    }
+
+    private static Component render(
+        final String template,
+        final String accountName,
+        final Component displayName,
+        final Component paperDefault
+    ) {
+        if (template.isEmpty()) {
+            return paperDefault;
+        }
+        return deserializeConfigured(
+            normalizePlayerPlaceholders(template),
+            Placeholder.unparsed("name", accountName),
+            // <player> is the explicit public placeholder; <name> remains for compatibility with earlier builds.
+            Placeholder.unparsed("player", accountName),
+            Placeholder.component("display_name", displayName)
+        );
+    }
+
+    /** Accepts the percent form commonly used in server configuration files. */
+    private static String normalizePlayerPlaceholders(final String template) {
+        return template
+            .replace("%player%", "<player>")
+            .replace("%player_name%", "<player>");
+    }
+
+    /**
+     * Parses both the documented MiniMessage syntax and legacy Minecraft color codes.
+     *
+     * <p>Legacy codes are translated before MiniMessage parsing so a template can safely combine
+     * {@code &a}/{@code \u00A7a} formatting with {@code <name>} and {@code <display_name>} placeholders.
+     * Unknown ampersands and section signs remain ordinary text.</p>
+     */
+    private static Component deserializeConfigured(
+        final String input,
+        final TagResolver... resolvers
+    ) {
+        return MINI_MESSAGE.deserialize(legacyCodesToMiniMessage(input), resolvers);
+    }
+
+    private static String legacyCodesToMiniMessage(final String input) {
+        final StringBuilder result = new StringBuilder(input.length());
+        for (int index = 0; index < input.length(); index++) {
+            final char marker = input.charAt(index);
+            if (marker != '&' && marker != SECTION_SIGN) {
+                result.append(marker);
+                continue;
+            }
+
+            // Support the common &#RRGGBB form in addition to the standard legacy palette.
+            if (index + 7 < input.length() && input.charAt(index + 1) == '#') {
+                final String hex = input.substring(index + 2, index + 8);
+                if (isHexColor(hex)) {
+                    result.append("<").append('#').append(hex).append('>');
+                    index += 7;
+                    continue;
+                }
+            }
+
+            if (index + 1 >= input.length()) {
+                result.append(marker);
+                continue;
+            }
+
+            final String tag = legacyTag(input.charAt(index + 1));
+            if (tag == null) {
+                result.append(marker);
+                continue;
+            }
+            result.append('<').append(tag).append('>');
+            index++;
+        }
+        return result.toString();
+    }
+
+    private static boolean isHexColor(final String value) {
+        for (int index = 0; index < value.length(); index++) {
+            final char character = value.charAt(index);
+            if (!(character >= '0' && character <= '9')
+                && !(character >= 'a' && character <= 'f')
+                && !(character >= 'A' && character <= 'F')) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static String legacyTag(final char code) {
+        return switch (Character.toLowerCase(code)) {
+            case '0' -> "black";
+            case '1' -> "dark_blue";
+            case '2' -> "dark_green";
+            case '3' -> "dark_aqua";
+            case '4' -> "dark_red";
+            case '5' -> "dark_purple";
+            case '6' -> "gold";
+            case '7' -> "gray";
+            case '8' -> "dark_gray";
+            case '9' -> "blue";
+            case 'a' -> "green";
+            case 'b' -> "aqua";
+            case 'c' -> "red";
+            case 'd' -> "light_purple";
+            case 'e' -> "yellow";
+            case 'f' -> "white";
+            case 'k' -> "obfuscated";
+            case 'l' -> "bold";
+            case 'm' -> "strikethrough";
+            case 'n' -> "underlined";
+            case 'o' -> "italic";
+            case 'r' -> "reset";
+            default -> null;
+        };
+    }
+}
