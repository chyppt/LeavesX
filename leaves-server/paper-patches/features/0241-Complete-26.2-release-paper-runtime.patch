+    @Test
+    void readsEveryEntityCoordinateOnlyOnTheCallingThread() {
+        final Thread callingThread = Thread.currentThread();
+        final AtomicBoolean offThreadGetter = new AtomicBoolean();
+        final List<Entity> entities = new ArrayList<>(2_048);
+        final double[] x = new double[2_048];
+        final double[] y = new double[2_048];
+        final double[] z = new double[2_048];
+        for (int index = 0; index < 2_048; index++) {
+            x[index] = index & 63;
+            y[index] = (index >>> 6) & 15;
+            z[index] = index >>> 10;
+            entities.add(threadConfinedEntityAt(x[index], y[index], z[index], callingThread, offThreadGetter));
+        }
+        final Entity origin = threadConfinedEntityAt(0.0D, 0.0D, 0.0D, callingThread, offThreadGetter);
+        final Entity[] originalOrder = entities.toArray(Entity[]::new);
+        final int[] expectedOrder = referenceOrder(x, y, z, 0.0D, 0.0D, 0.0D);
+
+        LeavesXComputeExecutor.configure(4, 4_096);
+        StableDistanceSorter.sortEntitiesByDistance(entities, origin, true, 2_048);
+        for (int index = 0; index < expectedOrder.length; index++) {
+            assertSame(originalOrder[expectedOrder[index]], entities.get(index));
+        }
+        assertEquals(0, StableDistanceSorter.findNearestIndex(entities, origin, true, 2_048));
+
+        assertFalse(offThreadGetter.get(), "workers must receive primitive snapshots, never live entities");
+        assertEquals(1L, workload(LeavesXComputeExecutor.Workload.AI_TARGET_SORT).parallelInvocations());
+        assertEquals(1L, workload(LeavesXComputeExecutor.Workload.AI_TARGET_SELECT).parallelInvocations());
+    }
+
+    private static Entity entityAt(final double x, final double y, final double z) {
+        final Entity entity = mock(Entity.class);
+        when(entity.getX()).thenReturn(x);
+        when(entity.getY()).thenReturn(y);
+        when(entity.getZ()).thenReturn(z);
+        return entity;
+    }
+
+    private static Entity threadConfinedEntityAt(
+        final double x,
+        final double y,
+        final double z,
+        final Thread callingThread,
+        final AtomicBoolean offThreadGetter
+    ) {
+        final Entity entity = mock(Entity.class);
+        when(entity.getX()).thenAnswer(ignored -> coordinateOnCallingThread(x, callingThread, offThreadGetter));
+        when(entity.getY()).thenAnswer(ignored -> coordinateOnCallingThread(y, callingThread, offThreadGetter));
+        when(entity.getZ()).thenAnswer(ignored -> coordinateOnCallingThread(z, callingThread, offThreadGetter));
+        return entity;
+    }
+
+    private static double coordinateOnCallingThread(
+        final double coordinate,
+        final Thread callingThread,
+        final AtomicBoolean offThreadGetter
+    ) {
+        if (Thread.currentThread() != callingThread) {
+            offThreadGetter.set(true);
+        }
+        return coordinate;
+    }
+
+    private static LeavesXComputeExecutor.WorkloadMetrics workload(final LeavesXComputeExecutor.Workload workload) {
+        return LeavesXComputeExecutor.metrics().workloads().stream()
+            .filter(metrics -> metrics.workload() == workload)
+            .findFirst()
+            .orElseThrow();
+    }
+
+    private static int[] referenceOrder(
+        final double[] x,
+        final double[] y,
+        final double[] z,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        final Integer[] indices = new Integer[x.length];
+        final double[] distances = new double[x.length];
+        for (int index = 0; index < x.length; index++) {
+            indices[index] = index;
+            final double deltaX = originX - x[index];
+            final double deltaY = originY - y[index];
+            final double deltaZ = originZ - z[index];
+            distances[index] = deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ;
+        }
+        Arrays.sort(indices, Comparator.comparingDouble(index -> distances[index]));
+        return Arrays.stream(indices).mapToInt(Integer::intValue).toArray();
+    }
+}
