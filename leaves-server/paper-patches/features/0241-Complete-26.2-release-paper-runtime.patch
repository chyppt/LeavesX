+
+    @Test
+    void villagerBrainTickAlwaysUsesSafetyContext() throws IOException {
+        final MethodNode customServerAiStep = method(
+            classNode(Villager.class.getName()),
+            "customServerAiStep",
+            "(Lnet/minecraft/server/level/ServerLevel;Z)V"
+        );
+        final String runtimeOwner = LeavesXRuntime.class.getName().replace('.', '/');
+        final List<String> runtimeCalls = Arrays.stream(customServerAiStep.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
