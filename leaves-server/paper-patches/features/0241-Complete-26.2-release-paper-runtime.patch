--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrator.java
@@ -0,0 +1,168 @@
+package org.leavesx.leavesx.config.migration;
+
+import io.papermc.paper.configuration.ConfigurationLoaders;
+import java.io.IOException;
+import java.io.StringReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigWriter;
+import org.leavesx.leavesx.config.YamlCommentInjector;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+/** Documents Leaves settings and creates a separate LeavesX file without persistent migration artifacts. */
+public final class LeavesConfigMigrator {
+
+    public static final int LEAVESX_CONFIG_VERSION = LeavesXConfig.CURRENT_CONFIG_VERSION;
+    public static final int LEAVES_26_1_2_CONFIG_VERSION = 6;
+    public static final String DEFAULT_SOURCE_FILE_NAME = "leaves.yml";
+    public static final String DEFAULT_TARGET_FILE_NAME = "leavesx.yml";
+
+    private static final String LEAVESX_HEADER = "LeavesX 配置。Leaves 原配置仍保存在 leaves.yml。";
+
+    private final MigrationOutput output;
+
+    public LeavesConfigMigrator() {
+        this(AtomicMigrationOutput.INSTANCE);
+    }
+
+    LeavesConfigMigrator(final MigrationOutput output) {
+        this.output = Objects.requireNonNull(output, "output");
+    }
+
+    /**
+     * Documents {@code source} and creates {@code target} without changing values or leaving backup/report files.
+     *
+     * @throws LeavesConfigMigrationException when YAML is invalid or an output cannot be written atomically
+     */
+    public LeavesConfigMigrationResult migrate(final Path source, final Path target) {
+        final Path absoluteSource = source.toAbsolutePath().normalize();
+        final Path absoluteTarget = target.toAbsolutePath().normalize();
+
+        if (Files.notExists(absoluteSource)) {
+            return new LeavesConfigMigrationResult(
+                MigrationStatus.NO_SOURCE, absoluteSource, absoluteTarget, 0, 0, 0, List.of()
+            );
+        }
+        if (!Files.isRegularFile(absoluteSource)) {
+            throw new LeavesConfigMigrationException("Leaves configuration is not a regular file: " + absoluteSource);
+        }
+        if (absoluteSource.equals(absoluteTarget)) {
+            throw new LeavesConfigMigrationException("Leaves and LeavesX configuration paths must be different");
+        }
+
+        try {
+            final CommentedConfigurationNode sourceNode = loadRequiredMap(
+                absoluteSource, "Leaves source configuration"
+            );
+            final int sourceVersion = sourceNode.node("config-version").getInt(0);
+            final int topLevelKeys = sourceNode.childrenMap().size();
+            final List<String> warnings = buildWarnings(sourceVersion);
+
+            if (Files.exists(absoluteTarget)) {
+                if (!Files.isRegularFile(absoluteTarget)) {
+                    throw new LeavesConfigMigrationException(
+                        "LeavesX configuration is not a regular file: " + absoluteTarget
+                    );
+                }
+                return new LeavesConfigMigrationResult(
+                    MigrationStatus.ALREADY_MIGRATED,
+                    absoluteSource,
+                    absoluteTarget,
+                    sourceVersion,
+                    topLevelKeys,
+                    0,
+                    warnings
+                );
+            }
+
+            final String sourceText = Files.readString(absoluteSource, StandardCharsets.UTF_8);
+            final YamlCommentInjector.Result documentedLeaves = YamlCommentInjector.inject(
+                sourceText, LeavesConfigCommentCatalog.comments()
+            );
+            verifyValuesUnchanged(sourceNode, documentedLeaves.text(), absoluteSource);
+            final String leavesXText = LeavesXConfigWriter.render(LeavesXConfig.safeDefaults(), LEAVESX_HEADER);
+
+            final Path targetParent = absoluteTarget.getParent();
+            if (targetParent != null) {
+                Files.createDirectories(targetParent);
+            }
+            try {
+                // Publishing the new file first keeps leaves.yml untouched if target creation fails.
+                this.output.saveText(absoluteTarget, leavesXText);
+                this.output.saveText(absoluteSource, documentedLeaves.text());
+            } catch (final IOException ex) {
+                deleteCreatedTarget(absoluteTarget, ex);
+                throw ex;
+            }
+
+            return new LeavesConfigMigrationResult(
+                MigrationStatus.MIGRATED,
+                absoluteSource,
+                absoluteTarget,
+                sourceVersion,
+                topLevelKeys,
+                documentedLeaves.documentedKeys(),
+                warnings
+            );
+        } catch (final LeavesConfigMigrationException ex) {
+            throw ex;
+        } catch (final Exception ex) {
+            throw new LeavesConfigMigrationException("Failed to migrate Leaves configuration " + absoluteSource, ex);
+        }
+    }
+
+    private static CommentedConfigurationNode loadRequiredMap(final Path path, final String description)
+        throws ConfigurateException {
+        final ConfigurationNode loaded = ConfigurationLoaders.naturallySortedWithoutHeader(path).load();
+        if (loaded.virtual() || !loaded.isMap()) {
+            throw new LeavesConfigMigrationException(description + " must contain a YAML mapping: " + path);
+        }
+        final CommentedConfigurationNode copy = CommentedConfigurationNode.root(loaded.options());
+        copy.from(loaded);
+        return copy;
+    }
+
+    private static void verifyValuesUnchanged(
+        final ConfigurationNode original,
+        final String documentedText,
+        final Path source
+    ) throws ConfigurateException {
+        final YamlConfigurationLoader loader = ConfigurationLoaders.naturallySorted()
+            .source(() -> new java.io.BufferedReader(new StringReader(documentedText)))
+            .build();
+        final ConfigurationNode documented = loader.load();
+        if (!Objects.equals(original.raw(), documented.raw())) {
+            throw new LeavesConfigMigrationException(
+                "Adding Leaves documentation would change configuration values: " + source
+            );
+        }
+    }
+
+    private static List<String> buildWarnings(final int sourceVersion) {
+        final List<String> warnings = new ArrayList<>();
+        if (sourceVersion == 0) {
+            warnings.add("The Leaves config has no config-version; values were preserved without schema conversion.");
+        } else if (sourceVersion > LEAVES_26_1_2_CONFIG_VERSION) {
+            warnings.add("The Leaves config is newer than the tested 26.1.2 schema; values were not converted.");
+        } else if (sourceVersion < LEAVES_26_1_2_CONFIG_VERSION) {
+            warnings.add("The Leaves config is older than the tested 26.1.2 schema; values were not converted.");
+        }
+        return List.copyOf(warnings);
+    }
+
+    private void deleteCreatedTarget(final Path target, final Exception parent) {
+        try {
+            this.output.deleteIfExists(target);
+        } catch (final IOException cleanupFailure) {
+            parent.addSuppressed(cleanupFailure);
+        }
+    }
+}
