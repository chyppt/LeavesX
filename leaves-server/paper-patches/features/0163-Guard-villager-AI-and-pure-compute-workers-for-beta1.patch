@@ -536,7 +574,28 @@ public final class LeavesXRuntime {
 
     /** Returns whether pure target-distance snapshots may use LeavesX compute workers. */
     public static boolean parallelAiTargetSearch() {
-        return parallelAiTargetSearch && !villagerCompatibilityContextActive();
+        return parallelAiTargetSearch && !villagerOptimizationContextActive();
+    }
+
+    /**
+     * Returns whether a pure primitive AI calculation may use workers outside a villager compatibility tick.
+     *
+     * <p>This deliberately does not enable entity queries, visibility checks, Brain access, Bukkit events, or path
+     * navigation. It only permits code that snapshots all entity coordinates on the tick thread and applies its result
+     * on that same thread. The explicit context guard below keeps villager ticks on the unmodified vanilla path.</p>
+     */
+    public static boolean parallelAiPureComputation() {
+        return parallelAiTargetSearch
+            && aiOptimizations
+            && !villagerOptimizationContextActive()
+            && enabledForPureComputation(LeavesXOptimization.NEAREST_ENTITY_DISTANCE_SORT);
+    }
+
+    /** Returns whether stable distance ordering itself is safe to use for a primitive snapshot. */
+    public static boolean nearestEntityDistanceSortPureComputation() {
+        return aiOptimizations
+            && !villagerOptimizationContextActive()
+            && enabledForPureComputation(LeavesXOptimization.NEAREST_ENTITY_DISTANCE_SORT);
     }
 
     /** Returns the benchmark-clamped threshold below which synchronous stable radix sorting is faster. */
@@ -935,7 +994,16 @@ public final class LeavesXRuntime {
     }
 
     private static boolean enabled(final LeavesXOptimization optimization) {
-        return !villagerCompatibilityContextActive()
+        return !villagerOptimizationContextActive()
             && optimization.enabledIn(fineGrainedOptimizationMaskLow, fineGrainedOptimizationMaskHigh);
     }
+
+    /**
+     * Checks a behavior-equivalent primitive optimization without crossing the villager compatibility guard.
+     *
+     * <p>Only callers with an explicit snapshot/commit boundary may use this helper.</p>
+     */
+    private static boolean enabledForPureComputation(final LeavesXOptimization optimization) {
+        return optimization.enabledIn(fineGrainedOptimizationMaskLow, fineGrainedOptimizationMaskHigh);
+    }
 }
diff --git a/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
index 7eb3d5ec98531855ebcb98ec6a04b5559355334c..ad9320b84daf5ec31234ee111057ccc78d7372f9 100644
--- a/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
+++ b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
@@ -62,6 +62,78 @@ public final class StableDistanceSorter {
         }
     }
 
+    /**
+     * Finds the first nearest entity in a list whose coordinates were snapshotted on the calling thread.
+     *
+     * <p>The caller must perform all eligibility, visibility, event, and world checks before invoking this method.
+     * Workers compare only sortable primitive distance keys. Returning an index instead of an entity keeps the live
+     * object entirely on the tick thread and preserves vanilla's first-entry tie rule.</p>
+     *
+     * @return the original list index, or {@code -1} when the list is empty
+     */
+    public static <T extends Entity> int findNearestIndex(
+        final List<T> entities,
+        final Entity origin,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        final int size = entities.size();
+        if (size == 0) {
+            return -1;
+        }
+
+        final Workspace workspace = acquireWorkspace(size);
+        try {
+            final double originX = origin.getX();
+            final double originY = origin.getY();
+            final double originZ = origin.getZ();
+            for (int index = 0; index < size; index++) {
+                final Entity entity = entities.get(index);
+                workspace.keys[index] = sortableDistanceKey(
+                    squaredDistance(originX, originY, originZ, entity.getX(), entity.getY(), entity.getZ())
+                );
+            }
+
+            final boolean parallelEligible = parallel && size >= parallelThreshold;
+            final int completedPartitions = parallelEligible
+                ? LeavesXComputeExecutor.invokeRangesWithCount(
+                    LeavesXComputeExecutor.Workload.AI_TARGET_SELECT,
+                    size,
+                    parallelThreshold,
+                    (taskIndex, start, end) -> workspace.nearestByPartition[taskIndex] = nearestInRange(
+                        workspace.keys,
+                        start,
+                        end
+                    )
+                )
+                : 0;
+            if (completedPartitions == 0) {
+                return nearestInRange(workspace.keys, 0, size);
+            }
+
+            final int rangeSize = divideCeil(size, completedPartitions);
+            int nearest = -1;
+            for (int partition = 0; partition < completedPartitions; partition++) {
+                final int candidate = workspace.nearestByPartition[partition];
+                if (candidate < 0) {
+                    continue;
+                }
+                if (nearest < 0 || Long.compareUnsigned(workspace.keys[candidate], workspace.keys[nearest]) < 0) {
+                    nearest = candidate;
+                }
+            }
+            // rangeSize is intentionally computed from the exact completed partition count. Keeping this local
+            // calculation documents the contiguous partition contract and prevents future callers from deriving it
+            // from the configured worker count when adaptive backpressure reduces the lane count.
+            if (rangeSize <= 0) {
+                return -1;
+            }
+            return nearest;
+        } finally {
+            releaseWorkspace(workspace);
+        }
+    }
+
     /**
      * Produces a stable index order for coordinate snapshots.
      *
@@ -282,6 +354,17 @@ public final class StableDistanceSorter {
         }
     }
 
+    /** Returns the first index with the smallest sortable key in one disjoint primitive range. */
+    private static int nearestInRange(final long[] keys, final int start, final int end) {
+        int nearest = -1;
+        for (int index = start; index < end; index++) {
+            if (nearest < 0 || Long.compareUnsigned(keys[index], keys[nearest]) < 0) {
+                nearest = index;
+            }
+        }
+        return nearest;
+    }
+
     private static int bucket(final long key, final int shift) {
         return (int)(key >>> shift) & 0xFF;
     }
@@ -359,6 +442,7 @@ public final class StableDistanceSorter {
         private int[] order = new int[0];
         private int[] scratch = new int[0];
         private int[] laneOffsets = new int[0];
+        private int[] nearestByPartition = new int[0];
         private boolean inUse;
 
         private Workspace(final boolean pooled) {
@@ -376,6 +460,9 @@ public final class StableDistanceSorter {
             if (this.laneOffsets.length < requiredLaneOffsets) {
                 this.laneOffsets = new int[requiredLaneOffsets];
             }
+            if (this.nearestByPartition.length < Math.max(1, lanes)) {
+                this.nearestByPartition = new int[Math.max(1, lanes)];
+            }
         }
     }
 }
