+    private static final int VILLAGER_FULL_COMPATIBILITY_CONTEXT = 1;
+    private static final int VILLAGER_BRAIN_SAFETY_CONTEXT = 1 << 1;
+    private static final ThreadLocal<Integer> VILLAGER_OPTIMIZATION_CONTEXT = ThreadLocal.withInitial(() -> 0);
 
