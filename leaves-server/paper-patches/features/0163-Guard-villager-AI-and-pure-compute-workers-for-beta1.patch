     /** Enters the per-thread vanilla compatibility context used while a villager is ticking. */
     public static boolean enterVillagerCompatibilityContext() {
-        final boolean previous = villagerCompatibilityContextActive();
-        if (villagerCompatibilityMode) {
-            VILLAGER_COMPATIBILITY_CONTEXT.set(true);
+        final int context = VILLAGER_OPTIMIZATION_CONTEXT.get();
+        final boolean previous = (context & VILLAGER_FULL_COMPATIBILITY_CONTEXT) != 0;
+        if (villagerCompatibilityMode && !previous) {
+            VILLAGER_OPTIMIZATION_CONTEXT.set(context | VILLAGER_FULL_COMPATIBILITY_CONTEXT);
         }
         return previous;
     }
 
     /** Restores the previous per-thread optimization context after a villager tick. */
     public static void exitVillagerCompatibilityContext(final boolean previous) {
-        if (previous) {
-            VILLAGER_COMPATIBILITY_CONTEXT.set(true);
-        } else {
-            VILLAGER_COMPATIBILITY_CONTEXT.remove();
+        restoreVillagerContextBit(VILLAGER_FULL_COMPATIBILITY_CONTEXT, previous);
+    }
+
+    /**
+     * Enters the mandatory vanilla-safety context around a villager Brain tick.
+     *
+     * <p>This narrower guard is independent of the optional full-tick compatibility setting. It protects hostile
+     * sensing, panic memories, behavior scheduling and iron-golem decisions even when an older configuration has
+     * explicitly disabled full villager compatibility.</p>
+     */
+    public static boolean enterVillagerBrainSafetyContext() {
+        final int context = VILLAGER_OPTIMIZATION_CONTEXT.get();
+        final boolean previous = (context & VILLAGER_BRAIN_SAFETY_CONTEXT) != 0;
+        if (!previous) {
+            VILLAGER_OPTIMIZATION_CONTEXT.set(context | VILLAGER_BRAIN_SAFETY_CONTEXT);
+        }
+        return previous;
+    }
+
+    /** Restores the Brain safety context after the authoritative tick-thread calculation completes. */
+    public static void exitVillagerBrainSafetyContext(final boolean previous) {
+        restoreVillagerContextBit(VILLAGER_BRAIN_SAFETY_CONTEXT, previous);
+    }
+
+    private static void restoreVillagerContextBit(final int bit, final boolean enabled) {
+        final int context = VILLAGER_OPTIMIZATION_CONTEXT.get();
+        final int restored = enabled ? context | bit : context & ~bit;
+        if (restored == 0) {
+            VILLAGER_OPTIMIZATION_CONTEXT.remove();
+        } else if (restored != context) {
+            VILLAGER_OPTIMIZATION_CONTEXT.set(restored);
         }
     }
 
-    private static boolean villagerCompatibilityContextActive() {
-        return VILLAGER_COMPATIBILITY_CONTEXT.get();
+    private static boolean villagerOptimizationContextActive() {
+        return VILLAGER_OPTIMIZATION_CONTEXT.get() != 0;
     }
 
