From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Subject: [PATCH] Add tripwire hook duplication setting

diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
@@ -289,2 +289,3 @@
     public record ExtensionSettings(
+        boolean tripwireHookDuplication,
         boolean lithiumEnabled, boolean containerCopyReuse, boolean secureSeed,
@@ -301,3 +302,3 @@
         public static ExtensionSettings defaults() {
-            return new ExtensionSettings(true, true, false, false, true, false, true, true, true, true, false, true, false,
+            return new ExtensionSettings(false, true, true, false, false, true, false, true, true, true, true, false, true, false,
                 true, true, false, false, false, false, true, true, false, false, true, true, true, false);
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigLoader.java
@@ -495,2 +495,3 @@
                 new LeavesXConfig.ExtensionSettings(
+                    readBoolean(node.node("features", "tripwire-hook-duplication"), "features.tripwire-hook-duplication", false),
                     readBoolean(node.node("performance", "lithium", "enabled"), "performance.lithium.enabled", true),
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
@@ -113,2 +113,3 @@
         changed |= writeValue(node.node("features", "just-enough-items", "recipe-sync"), "features.just-enough-items.recipe-sync", config.extensions().jeiRecipeSync(), missingOnly);
+        changed |= writeValue(node.node("features", "tripwire-hook-duplication"), "features.tripwire-hook-duplication", config.extensions().tripwireHookDuplication(), missingOnly);
         changed |= writeValue(node.node("features", "just-enough-items", "recipe-transfer"), "features.just-enough-items.recipe-transfer", config.extensions().jeiRecipeTransfer(), missingOnly);
@@ -566,2 +567,3 @@
         comments.put("features.named-cce-shulker-boxes", "铁砧命名为“更新抑制器”的潜影盒可触发 CCE 更新抑制。默认：false。");
+        comments.put("features.tripwire-hook-duplication", "恢复旧版绊线钩复制，允许更新中已拆除的钩子被重新放回；供刷绊线钩机使用，可重载。默认：false。");
         comments.put("features.quick-open-shulker-boxes", "主手或副手拿潜影盒右键空气时直接打开。默认：false。");
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java b/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXRuntime.java
@@ -514,4 +514,9 @@
     public static boolean networkBufferOptimizations() {
         return configuration.extensions().networkBufferOptimizations();
     }
+
+    /** 仅恢复绊线钩更新中的旧版回填行为，不修改全局红石或刷线开关。 */
+    public static boolean tripwireHookDuplication() {
+        return configuration.extensions().tripwireHookDuplication();
+    }
 
