diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityQueryShortCircuitTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityQueryShortCircuitTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a45f90555173675ee9123c6a484a29d5fc6d1657
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityQueryShortCircuitTest.java
@@ -0,0 +1,149 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.monster.warden.WardenSpawnTracker;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.ButtonBlock;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies existence-only entity queries stop after their first deterministic match. */
+@Normal
+class EntityQueryShortCircuitTest {
+
+    @Test
+    void levelUsesAReentrancySafeThreadLocalBufferForFirstMatchQueries() throws IOException {
+        final ClassNode level = classNode(Level.class);
+        final String bufferName = level.name + "$LeavesXFirstEntityQueryBuffer";
+        final FieldNode threadLocal = field(level, "LEAVESX_FIRST_ENTITY_QUERY_BUFFER");
+        assertEquals("Ljava/lang/ThreadLocal;", threadLocal.desc);
+
+        final MethodNode first = method(
+            level,
+            "leavesX$getFirstEntityOfClass",
+            "(Ljava/lang/Class;Lnet/minecraft/world/phys/AABB;Ljava/util/function/Predicate;)Lnet/minecraft/world/entity/Entity;"
+        );
+        assertTrue(hasInvocation(first, "java/lang/ThreadLocal", "get"));
+        assertTrue(hasInvocation(first, bufferName, "acquire"));
+        assertTrue(hasInvocation(first, bufferName, "release"));
+        final List<MethodInsnNode> boundedQueries = invocations(first).stream()
+            .filter(call -> call.owner.equals("ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup"))
+            .filter(call -> call.name.equals("getEntities") && call.desc.endsWith("I)V"))
+            .toList();
+        assertEquals(2, boundedQueries.size(), "Both the shared and nested paths must use the limited lookup");
+        assertTrue(
+            boundedQueries.stream().allMatch(call -> call.getPrevious().getOpcode() == Opcodes.ICONST_1),
+            "Every first-match query must pass maxCount=1"
+        );
+
+        final ClassNode buffer = classNode(bufferName.replace('/', '.'));
+        assertEquals("Ljava/util/List;", field(buffer, "results").desc);
+        assertEquals("Z", field(buffer, "inUse").desc);
+    }
+
+    @Test
+    void nestedUseDeclinesTheSharedBufferUntilTheOuterQueryReleasesIt()
+        throws NoSuchMethodException, InvocationTargetException, InstantiationException, IllegalAccessException {
+        final Class<?> bufferClass = Arrays.stream(Level.class.getDeclaredClasses())
+            .filter(type -> type.getSimpleName().equals("LeavesXFirstEntityQueryBuffer"))
+            .findFirst()
+            .orElseThrow();
+        final Constructor<?> constructor = bufferClass.getDeclaredConstructor();
+        constructor.setAccessible(true);
+        final Object buffer = constructor.newInstance();
+        final Method acquire = bufferClass.getDeclaredMethod("acquire");
+        final Method release = bufferClass.getDeclaredMethod("release");
+        acquire.setAccessible(true);
+        release.setAccessible(true);
+
+        assertTrue((boolean)acquire.invoke(buffer));
+        assertFalse((boolean)acquire.invoke(buffer), "Nested queries must use their one-off fallback list");
+        release.invoke(buffer);
+        assertTrue((boolean)acquire.invoke(buffer));
+        release.invoke(buffer);
+    }
+
+    @Test
+    void woodenButtonAvoidsStreamAllocationAndUsesTheShortCircuitQuery() throws IOException {
+        final MethodNode checkPressed = method(classNode(ButtonBlock.class), "checkPressed");
+        final List<MethodInsnNode> calls = invocations(checkPressed);
+
+        assertFalse(calls.stream().anyMatch(call -> call.owner.equals("java/util/stream/Stream") && call.name.equals("findFirst")));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime") && call.name.equals("entityQueryOptimizations")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/world/level/Level") && call.name.equals("leavesX$getFirstEntityOfClass")
+        ));
+    }
+
+    @Test
+    void wardenExistenceCheckUsesTheSameBoundedQuery() throws IOException {
+        final MethodNode check = method(classNode(WardenSpawnTracker.class), "hasNearbyWarden");
+        final List<MethodInsnNode> calls = invocations(check);
+
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime") && call.name.equals("entityQueryOptimizations")
+        ));
+        assertTrue(calls.stream().anyMatch(call ->
+            call.owner.equals("net/minecraft/server/level/ServerLevel") && call.name.equals("leavesX$hasEntityOfClass")
+        ));
+    }
+
+    private static FieldNode field(final ClassNode owner, final String name) {
+        return owner.fields.stream()
+            .filter(field -> field.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing field " + owner.name + '#' + name));
+    }
+
+    private static boolean hasInvocation(final MethodNode method, final String owner, final String name) {
+        return invocations(method).stream().anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        return classNode(owner.getName());
+    }
+
+    private static ClassNode classNode(final String className) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName + descriptor));
+    }
+}
