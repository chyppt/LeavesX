+    /** Upgrades only values that were generated by the previous conservative parallelism defaults. */
+    private static boolean migrateLegacyParallelDefaults(
+        final CommentedConfigurationNode node,
+        final int sourceVersion
+    ) {
+        if (sourceVersion >= PARALLEL_THRESHOLD_MIGRATION_VERSION) {
+            return false;
+        }
+        boolean changed = false;
+        changed |= migrateDefault(node.node("parallelism", "ai-target-search", "minimum-candidates"), 2_048, AI_PARALLEL_DEFAULT);
+        changed |= migrateDefault(node.node("parallelism", "ai-target-search", "minimum-items-per-worker"), 1_024, AI_PARALLEL_ITEMS_DEFAULT);
+        changed |= migrateDefault(node.node("parallelism", "entity-activation", "minimum-entities"), 65_536, ENTITY_ACTIVATION_DEFAULT);
+        changed |= migrateDefault(node.node("parallelism", "entity-activation", "minimum-items-per-worker"), 8_192, ENTITY_ACTIVATION_ITEMS_DEFAULT);
+        changed |= migrateDefault(node.node("parallelism", "mob-spawning", "minimum-entities"), 524_288, MOB_SPAWN_DEFAULT);
+        return changed;
+    }
+
+    private static boolean migrateDefault(
+        final CommentedConfigurationNode node,
+        final int legacyValue,
+        final int currentValue
+    ) {
+        final Object raw = node.rawScalar();
+        if ((raw instanceof Byte || raw instanceof Short || raw instanceof Integer || raw instanceof Long)
+            && ((Number)raw).intValue() == legacyValue) {
+            node.raw(currentValue);
+            return true;
+        }
+        return false;
+    }
+
     private static boolean readBoolean(final ConfigurationNode node, final String path, final boolean defaultValue) {
         if (node.virtual()) {
             return defaultValue;
