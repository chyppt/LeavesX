+    @Test
+    void mediumDenseBatchUsesTheAdaptiveParallelThreshold() {
+        final int size = 512;
+        final double[] x = new double[size];
+        final double[] y = new double[size];
+        final double[] z = new double[size];
+        for (int index = 0; index < size; index++) {
+            x[index] = index & 31;
+            y[index] = (index >>> 5) & 15;
+            z[index] = index >>> 9;
+        }
+
+        LeavesXComputeExecutor.configure(4, 64);
+        StableDistanceSorter.sort(x, y, z, 0.0D, 0.0D, 0.0D, true, 512);
+
+        final LeavesXComputeExecutor.WorkloadMetrics ai = workload(LeavesXComputeExecutor.Workload.AI_TARGET_SORT);
+        assertEquals(1L, ai.parallelInvocations());
+        assertEquals(512L, ai.totalItems());
+    }
+
     @Test
     void keepsSmallCandidateSetsSynchronousAndReportsTheReason() {
         LeavesXComputeExecutor.configure(4, 64);
