     /**
      * Minimum candidate count at which a primitive AI computation can amortize worker dispatch.
      *
-     * <p>9950X measurements show that 128-256 candidates are several times slower when dispatched, while 2048
-     * candidates become profitable with 1024-item partitions. Keeping both floors here prevents configuration from
-     * turning ordinary per-mob scans into a scheduling regression.</p>
+     * <p>The adaptive beta158 baseline starts at 512 candidates with 256-item partitions. This keeps ordinary small
+     * scans synchronous while allowing dense farms to use more than the server thread.</p>
      */
-    private static final int AI_TARGET_SEARCH_PROFITABLE_FLOOR = 2_048;
-    private static final int AI_TARGET_SEARCH_MINIMUM_ITEMS_FLOOR = 1_024;
+    private static final int AI_TARGET_SEARCH_PROFITABLE_FLOOR = 512;
+    private static final int AI_TARGET_SEARCH_MINIMUM_ITEMS_FLOOR = 256;
     // AABB intersection is much cheaper than AI distance sorting. Measurements on the target 9950X host show that
     // worker dispatch becomes worthwhile only for unusually large per-player candidate batches.
-    private static final int ENTITY_ACTIVATION_PROFITABLE_FLOOR = 65_536;
-    private static final int ENTITY_ACTIVATION_MINIMUM_ITEMS_FLOOR = 8_192;
-    private static final int MOB_SPAWN_COUNTING_PROFITABLE_FLOOR = 524_288;
+    private static final int ENTITY_ACTIVATION_PROFITABLE_FLOOR = 8_192;
+    private static final int ENTITY_ACTIVATION_MINIMUM_ITEMS_FLOOR = 1_024;
+    private static final int MOB_SPAWN_COUNTING_PROFITABLE_FLOOR = 65_536;
 
     private static volatile LeavesXConfig configuration = LeavesXConfig.safeDefaults();
     private static volatile boolean diagnosticsCommandEnabled = true;
