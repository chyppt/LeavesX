diff --git a/src/test/java/org/bukkit/craftbukkit/entity/LeavesXBukkitEntityTypeCacheTest.java b/src/test/java/org/bukkit/craftbukkit/entity/LeavesXBukkitEntityTypeCacheTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e8d5546f0298e41060c73f04128dd2206bfa18eb
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/entity/LeavesXBukkitEntityTypeCacheTest.java
@@ -0,0 +1,124 @@
+package org.bukkit.craftbukkit.entity;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.concurrent.ConcurrentMap;
+import org.bukkit.entity.EntityType;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies cached Minecraft-to-Bukkit entity type conversion preserves registry results. */
+@AllFeatures
+class LeavesXBukkitEntityTypeCacheTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void cachedAndFallbackMappingsReturnTheSameBukkitTypes() throws Exception {
+        try {
+            publish(this.configuration(true, "cached.yml"));
+            final EntityType cachedZombie = CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.ZOMBIE);
+            final EntityType cachedVillager = CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.VILLAGER);
+
+            publish(this.configuration(false, "fallback.yml"));
+            assertEquals(cachedZombie, CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.ZOMBIE));
+            assertEquals(cachedVillager, CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.VILLAGER));
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+            cache().clear();
+        }
+    }
+
+    @Test
+    void disabledSwitchLeavesTheConversionCacheEmpty() throws Exception {
+        final ConcurrentMap<?, ?> cache = cache();
+        try {
+            cache.clear();
+            publish(this.configuration(true, "enabled.yml"));
+            CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.ZOMBIE);
+            CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.ZOMBIE);
+            assertEquals(1, cache.size());
+
+            cache.clear();
+            publish(this.configuration(false, "disabled.yml"));
+            CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.ZOMBIE);
+            CraftEntityType.minecraftToBukkit(net.minecraft.world.entity.EntityType.ZOMBIE);
+            assertTrue(cache.isEmpty());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+            cache.clear();
+        }
+    }
+
+    @Test
+    void conversionKeepsCacheAndRegistryFallbackPaths() throws IOException {
+        final MethodNode method = method(classNode(), "minecraftToBukkit");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertEquals(1L, countCall(calls, "org/leavesx/leavesx/config/LeavesXRuntime", "bukkitEntityTypeCacheOptimization"));
+        assertEquals(1L, countCall(calls, "java/util/concurrent/ConcurrentMap", "get"));
+        assertEquals(1L, countCall(calls, "java/util/concurrent/ConcurrentMap", "putIfAbsent"));
+        assertEquals(1L, countCall(calls, "org/bukkit/craftbukkit/CraftRegistry", "getMinecraftRegistry"));
+    }
+
+    private LeavesXConfig configuration(final boolean enabled, final String fileName) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-mapping:
+                bukkit-type-cache: %s
+            """.formatted(enabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static ConcurrentMap<net.minecraft.world.entity.EntityType<?>, EntityType> cache() throws ReflectiveOperationException {
+        final Field field = CraftEntityType.class.getDeclaredField("MINECRAFT_TO_BUKKIT_CACHE");
+        field.setAccessible(true);
+        return (ConcurrentMap<net.minecraft.world.entity.EntityType<?>, EntityType>)field.get(null);
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(CraftEntityType.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static long countCall(final MethodInsnNode[] calls, final String owner, final String name) {
+        return Arrays.stream(calls).filter(call -> call.owner.equals(owner) && call.name.equals(name)).count();
+    }
+}
