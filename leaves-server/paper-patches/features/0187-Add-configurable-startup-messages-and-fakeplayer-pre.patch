+    @Test
+    void loadsConsoleAndFakeplayerPresentationSettings() throws IOException {
+        final Path path = write("""
+            config-version: 69
+            console-messages:
+              show-root-admin-warning: true
+              show-offline-mode-warning: true
+              show-collision-conversion-warning: true
+            fakeplayer:
+              clean-invalid-resident-bots: false
+              display-prefix: '<gray>[假人]</gray>'
+            messages:
+              join: '<name> -> <display_name>'
+              quit: '<display_name> left'
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        assertTrue(config.showRootAdminWarning());
+        assertTrue(config.showOfflineModeWarning());
+        assertTrue(config.showCollisionConversionWarning());
+        assertFalse(config.cleanInvalidResidentBots());
+        assertEquals("<gray>[假人]</gray>", config.fakeplayerDisplayPrefix());
+
+        try {
+            LeavesXRuntime.publish(config);
+            final Component displayName = LeavesXPlayerPresentation.fakeplayerDisplayName("bot_1");
+            final PlainTextComponentSerializer plain = PlainTextComponentSerializer.plainText();
+            assertEquals("[假人]bot_1", plain.serialize(displayName));
+            assertEquals(
+                "bot_1 -> [假人]bot_1",
+                plain.serialize(LeavesXPlayerPresentation.joinMessage("bot_1", displayName, Component.text("default")))
+            );
+            assertEquals(
+                "[假人]bot_1 left",
+                plain.serialize(LeavesXPlayerPresentation.quitMessage("bot_1", displayName, Component.text("default")))
+            );
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
