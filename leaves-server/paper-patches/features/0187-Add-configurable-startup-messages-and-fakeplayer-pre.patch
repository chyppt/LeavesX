+    private static String readString(final ConfigurationNode node, final String path, final String defaultValue) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        final Object raw = node.rawScalar();
+        if (raw instanceof String value) {
+            return value;
+        }
+        throw invalidType(path, "a string", raw);
+    }
