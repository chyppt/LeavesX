+package org.leavesx.leavesx.presentation;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.minimessage.MiniMessage;
+import net.kyori.adventure.text.minimessage.tag.resolver.Placeholder;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Builds configured player-facing names and lifecycle messages without changing account identity. */
+public final class LeavesXPlayerPresentation {
+
+    private static final MiniMessage MINI_MESSAGE = MiniMessage.miniMessage();
+
+    private LeavesXPlayerPresentation() {
+    }
+
+    /**
+     * Creates the display identity used by fakeplayers in Bukkit display-name APIs and the vanilla player list.
+     *
+     * @param accountName unchanged game-profile name
+     * @return configured prefix followed by the literal account name
+     */
+    public static Component fakeplayerDisplayName(final String accountName) {
+        final String prefix = LeavesXRuntime.fakeplayerDisplayPrefix();
+        if (prefix.isEmpty()) {
+            return Component.text(accountName);
+        }
+        return MINI_MESSAGE.deserialize(prefix).append(Component.text(accountName));
+    }
+
+    /** Returns the configured join message, or the event's Paper default when no template is configured. */
+    public static Component joinMessage(
+        final String accountName,
+        final Component displayName,
+        final Component paperDefault
+    ) {
+        return render(LeavesXRuntime.joinMessage(), accountName, displayName, paperDefault);
+    }
+
+    /** Returns the configured quit message, or the event's Paper default when no template is configured. */
+    public static Component quitMessage(
+        final String accountName,
+        final Component displayName,
+        final Component paperDefault
+    ) {
+        return render(LeavesXRuntime.quitMessage(), accountName, displayName, paperDefault);
+    }
+
+    private static Component render(
+        final String template,
+        final String accountName,
+        final Component displayName,
+        final Component paperDefault
+    ) {
+        if (template.isEmpty()) {
+            return paperDefault;
+        }
+        return MINI_MESSAGE.deserialize(
+            template,
+            Placeholder.unparsed("name", accountName),
+            Placeholder.component("display_name", displayName)
+        );
+    }
+}
