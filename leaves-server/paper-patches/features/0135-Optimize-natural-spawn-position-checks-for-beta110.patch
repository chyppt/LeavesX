diff --git a/src/test/java/net/minecraft/world/level/NaturalSpawnPositionHotPathTest.java b/src/test/java/net/minecraft/world/level/NaturalSpawnPositionHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..977b76bd435dc1064515643105d9858c528acea2
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/NaturalSpawnPositionHotPathTest.java
@@ -0,0 +1,193 @@
+package net.minecraft.world.level;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Verifies natural-spawn position checks avoid allocations without changing Paper's decisions. */
+@Normal
+public class NaturalSpawnPositionHotPathTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void scalarSpawnPointCheckMatchesVanillaAtEveryBoundary() {
+        final BlockPos[] spawnPoints = {
+            new BlockPos(0, 64, 0),
+            new BlockPos(-17, -64, 31),
+            new BlockPos(Integer.MIN_VALUE + 64, 320, Integer.MAX_VALUE - 64)
+        };
+
+        for (final BlockPos spawnPoint : spawnPoints) {
+            for (int offsetX = -25; offsetX <= 25; offsetX++) {
+                for (int offsetY = -25; offsetY <= 25; offsetY++) {
+                    for (int offsetZ = -25; offsetZ <= 25; offsetZ++) {
+                        final int candidateX = spawnPoint.getX() + offsetX;
+                        final int candidateY = spawnPoint.getY() + offsetY;
+                        final int candidateZ = spawnPoint.getZ() + offsetZ;
+                        final boolean expected = spawnPoint.closerToCenterThan(
+                            new Vec3(candidateX + 0.5D, candidateY, candidateZ + 0.5D),
+                            24.0D
+                        );
+                        final boolean actual = NaturalSpawner.leavesX$isWithinSpawnPointExclusionRadius(
+                            spawnPoint,
+                            candidateX,
+                            candidateY,
+                            candidateZ
+                        );
+                        if (expected != actual) {
+                            fail("Spawn-point distance changed at " + spawnPoint + " with offset ["
+                                + offsetX + ", " + offsetY + ", " + offsetZ + ']');
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void directChunkCheckMatchesChunkPosContainingAcrossNegativeBoundaries() {
+        final int[] coordinates = {
+            -65, -64, -63, -33, -32, -31, -17, -16, -15, -1, 0, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65
+        };
+
+        for (int chunkX = -5; chunkX <= 5; chunkX++) {
+            for (int chunkZ = -5; chunkZ <= 5; chunkZ++) {
+                final ChunkPos chunkPos = new ChunkPos(chunkX, chunkZ);
+                for (final int candidateX : coordinates) {
+                    for (final int candidateZ : coordinates) {
+                        final boolean expected = ChunkPos.containing(new BlockPos(candidateX, 0, candidateZ)).equals(chunkPos);
+                        final boolean actual = NaturalSpawner.leavesX$isInChunk(candidateX, candidateZ, chunkPos);
+                        if (expected != actual) {
+                            fail("Chunk comparison changed for block [" + candidateX + ", " + candidateZ
+                                + "] and chunk " + chunkPos);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void dedicatedSwitchRespectsTheMobSpawningMasterSwitch() throws Exception {
+        try {
+            publish(this.configuration(true, true, "enabled.yml"));
+            assertTrue(LeavesXRuntime.naturalSpawnPositionChecksOptimization());
+
+            publish(this.configuration(true, false, "setting-disabled.yml"));
+            assertFalse(LeavesXRuntime.naturalSpawnPositionChecksOptimization());
+
+            publish(this.configuration(false, true, "master-disabled.yml"));
+            assertFalse(LeavesXRuntime.naturalSpawnPositionChecksOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void version40ConfigurationGainsTheDocumentedDefaultInPlace() throws IOException {
+        final Path path = this.tempDir.resolve("version-40.yml");
+        Files.writeString(path, """
+            config-version: 40
+            performance:
+              mob-spawning-optimizations: true
+            """);
+
+        LeavesXConfigLoader.load(path);
+        final String upgraded = Files.readString(path);
+
+        assertTrue(upgraded.contains("config-version: 41"));
+        assertTrue(upgraded.contains("spawn-position-distance-checks: true"));
+        assertFalse(Files.exists(this.tempDir.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.tempDir.resolve("leavesx-migration-report.yml")));
+    }
+
+    @Test
+    void optimizedHelpersAvoidTemporaryPositionObjectsAndKeepPaperFallback() throws IOException {
+        final ClassNode spawner = classNode(NaturalSpawner.class);
+        final MethodNode spawnDistance = method(spawner, "leavesX$isWithinSpawnPointExclusionRadius");
+        final MethodNode sameChunk = method(spawner, "leavesX$isInChunk");
+        final MethodNode decision = method(spawner, "isRightDistanceToPlayerAndSpawnPoint");
+
+        assertFalse(allocates(spawnDistance, "net/minecraft/world/phys/Vec3"));
+        assertTrue(calls(spawnDistance, "net/minecraft/core/BlockPos", "distToCenterSqr"));
+        assertFalse(allocates(sameChunk, "net/minecraft/world/level/ChunkPos"));
+        assertFalse(calls(sameChunk, "net/minecraft/world/level/ChunkPos", "containing"));
+
+        assertTrue(calls(decision, "org/leavesx/leavesx/config/LeavesXRuntime", "naturalSpawnPositionChecksOptimization"));
+        assertTrue(calls(decision, "net/minecraft/world/level/NaturalSpawner", "leavesX$isWithinSpawnPointExclusionRadius"));
+        assertTrue(calls(decision, "net/minecraft/world/level/NaturalSpawner", "leavesX$isInChunk"));
+        assertTrue(allocates(decision, "net/minecraft/world/phys/Vec3"), "Disabled path must retain Paper's Vec3 flow");
+        assertTrue(calls(decision, "net/minecraft/world/level/ChunkPos", "containing"), "Disabled path must retain Paper's chunk flow");
+    }
+
+    private LeavesXConfig configuration(
+        final boolean masterEnabled,
+        final boolean settingEnabled,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              mob-spawning-optimizations: %s
+              mob-spawning:
+                spawn-position-distance-checks: %s
+            """.formatted(masterEnabled, settingEnabled));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static boolean allocates(final MethodNode method, final String internalName) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .anyMatch(instruction -> instruction.getOpcode() == Opcodes.NEW && instruction.desc.equals(internalName));
+    }
+
+    private static boolean calls(final MethodNode method, final String owner, final String name) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+
+    private static ClassNode classNode(final Class<?> type) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(type.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+}
