diff --git a/src/test/java/org/leavesx/leavesx/performance/StableDistanceSorterTest.java b/src/test/java/org/leavesx/leavesx/performance/StableDistanceSorterTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1ee17a6144cc9c68d29c6e459667e7f7708e538d
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/StableDistanceSorterTest.java
@@ -0,0 +1,82 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.Random;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+@Normal
+class StableDistanceSorterTest {
+
+    @AfterEach
+    void shutdownExecutor() {
+        LeavesXComputeExecutor.shutdown();
+    }
+
+    @Test
+    void matchesStableComparatorOrderSynchronouslyAndInParallel() {
+        final Random random = new Random(0x4C656176657358L);
+        final int size = 1_027;
+        final double[] x = new double[size];
+        final double[] y = new double[size];
+        final double[] z = new double[size];
+        for (int index = 0; index < size; index++) {
+            // Repeated integer coordinates exercise stable ordering for equal distances.
+            x[index] = random.nextInt(41) - 20;
+            y[index] = random.nextInt(17) - 8;
+            z[index] = random.nextInt(41) - 20;
+        }
+
+        final int[] expected = referenceOrder(x, y, z, 3.5, -2.25, 7.75);
+        assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 3.5, -2.25, 7.75, false, 64));
+
+        LeavesXComputeExecutor.configure(4);
+        assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 3.5, -2.25, 7.75, true, 64));
+    }
+
+    @Test
+    void keepsSpecialDoubleOrderingEquivalentToJavaComparator() {
+        final double[] x = {Double.NaN, Double.POSITIVE_INFINITY, -0.0, 0.0, 1.0, -1.0};
+        final double[] y = new double[x.length];
+        final double[] z = new double[x.length];
+        final int[] expected = referenceOrder(x, y, z, 0.0, 0.0, 0.0);
+
+        LeavesXComputeExecutor.configure(3);
+        assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 0.0, 0.0, 0.0, true, 1));
+    }
+
+    @Test
+    void rejectsMismatchedCoordinateArrays() {
+        assertThrows(
+            IllegalArgumentException.class,
+            () -> StableDistanceSorter.sort(new double[1], new double[2], new double[1], 0.0, 0.0, 0.0, false, 64)
+        );
+    }
+
+    private static int[] referenceOrder(
+        final double[] x,
+        final double[] y,
+        final double[] z,
+        final double originX,
+        final double originY,
+        final double originZ
+    ) {
+        final Integer[] indices = new Integer[x.length];
+        final double[] distances = new double[x.length];
+        for (int index = 0; index < x.length; index++) {
+            indices[index] = index;
+            final double deltaX = originX - x[index];
+            final double deltaY = originY - y[index];
+            final double deltaZ = originZ - z[index];
+            distances[index] = deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ;
+        }
+        Arrays.sort(indices, Comparator.comparingDouble(index -> distances[index]));
+        return Arrays.stream(indices).mapToInt(Integer::intValue).toArray();
+    }
+}
