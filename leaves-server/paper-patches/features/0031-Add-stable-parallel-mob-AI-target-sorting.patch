+    @Test
+    void acceptsACompleteNonEvenPartition() {
+        LeavesXComputeExecutor.configure(6);
+        final AtomicIntegerArray counts = new AtomicIntegerArray(10);
+
+        final boolean parallel = LeavesXComputeExecutor.invokeRanges(10, 1, (taskIndex, start, end) -> {
+            for (int index = start; index < end; index++) {
+                counts.incrementAndGet(index);
+            }
+        });
+
+        assertTrue(parallel);
+        for (int index = 0; index < counts.length(); index++) {
+            assertTrue(counts.get(index) == 1, "index " + index + " must be processed exactly once");
+        }
+    }
+
