index 0000000000000000000000000000000000000000..1d5b5458429e61560f01bfdbfcf52edcff2bb79b
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/StableDistanceSorter.java
@@ -0,0 +1,192 @@
+package org.leavesx.leavesx.performance;
+
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+/**
+ * Produces a stable index order for immutable coordinate snapshots.
+ *
+ * <p>Worker threads only receive primitive arrays. Entity and world objects remain on the tick thread, which applies
+ * the returned order after all computation has completed.</p>
+ */
+public final class StableDistanceSorter {
+
+    private static final int INSERTION_SORT_THRESHOLD = 24;
+
+    private StableDistanceSorter() {
+    }
+
+    /**
+     * Sorts snapshot indices by squared distance while preserving the input order of equal-distance entries.
+     *
+     * @param x snapshotted x coordinates
+     * @param y snapshotted y coordinates
+     * @param z snapshotted z coordinates
+     * @param originX origin x coordinate
+     * @param originY origin y coordinate
+     * @param originZ origin z coordinate
+     * @param parallel whether eligible inputs may use LeavesX compute workers
+     * @param parallelThreshold minimum snapshot size for worker use
+     * @return indices in the same order as a stable {@code Comparator.comparingDouble} sort
+     */
+    public static int[] sort(
+        final double[] x,
+        final double[] y,
+        final double[] z,
+        final double originX,
+        final double originY,
+        final double originZ,
+        final boolean parallel,
+        final int parallelThreshold
+    ) {
+        requireMatchingLengths(x, y, z);
+        final int size = x.length;
+        final int[] order = new int[size];
+        if (size == 0) {
+            return order;
+        }
+
+        final double[] distances = new double[size];
+        final int[] scratch = new int[size];
+        final int workerLimit = Math.min(LeavesXComputeExecutor.workerCount(), size);
+        final int rangeSize = divideCeil(size, Math.max(1, workerLimit));
+        final boolean completedInParallel = parallel && LeavesXComputeExecutor.invokeRanges(
+            size,
+            parallelThreshold,
+            (taskIndex, start, end) -> {
+                computeDistancesAndInitializeOrder(x, y, z, originX, originY, originZ, distances, order, start, end);
+                stableSortRange(order, scratch, distances, start, end);
+            }
+        );
+
+        if (!completedInParallel) {
+            computeDistancesAndInitializeOrder(x, y, z, originX, originY, originZ, distances, order, 0, size);
+            stableSortRange(order, scratch, distances, 0, size);
+            return order;
+        }
+
+        // Each worker sorted one contiguous range. Merging on the tick thread is deterministic and keeps equal
+        // distances in their original entity-query order.
+        for (int width = rangeSize; width < size; width = nextMergeWidth(width, size)) {
+            final int step = width >= size - width ? size : width << 1;
+            for (int start = 0; start < size - width; start += step) {
+                final int middle = start + width;
+                final int end = Math.min(size, start + step);
+                merge(order, scratch, distances, start, middle, end);
+            }
+        }
+        return order;
+    }
+
+    private static void requireMatchingLengths(final double[] x, final double[] y, final double[] z) {
+        if (x.length != y.length || x.length != z.length) {
+            throw new IllegalArgumentException("Coordinate arrays must have matching lengths");
+        }
+    }
+
+    private static void computeDistancesAndInitializeOrder(
+        final double[] x,
+        final double[] y,
+        final double[] z,
+        final double originX,
+        final double originY,
+        final double originZ,
+        final double[] distances,
+        final int[] order,
+        final int start,
+        final int end
+    ) {
+        for (int index = start; index < end; index++) {
+            final double deltaX = originX - x[index];
+            final double deltaY = originY - y[index];
+            final double deltaZ = originZ - z[index];
+            distances[index] = deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ;
+            order[index] = index;
+        }
+    }
+
+    private static void stableSortRange(
+        final int[] order,
+        final int[] scratch,
+        final double[] distances,
+        final int start,
+        final int end
+    ) {
+        final int length = end - start;
+        if (length < 2) {
+            return;
+        }
+        if (length <= INSERTION_SORT_THRESHOLD) {
+            insertionSort(order, distances, start, end);
+            return;
+        }
+
+        for (int width = 1; width < length; width = nextMergeWidth(width, length)) {
+            final int step = width >= length - width ? length : width << 1;
+            for (int left = start; left < end - width; left += step) {
+                final int middle = left + width;
+                final int right = Math.min(end, left + step);
+                merge(order, scratch, distances, left, middle, right);
+            }
+        }
+    }
+
+    private static void insertionSort(
+        final int[] order,
+        final double[] distances,
+        final int start,
+        final int end
+    ) {
+        for (int index = start + 1; index < end; index++) {
+            final int candidate = order[index];
+            int insertion = index;
+            while (insertion > start && compare(candidate, order[insertion - 1], distances) < 0) {
+                order[insertion] = order[insertion - 1];
+                insertion--;
+            }
+            order[insertion] = candidate;
+        }
+    }
+
+    private static void merge(
+        final int[] order,
+        final int[] scratch,
+        final double[] distances,
+        final int start,
+        final int middle,
+        final int end
+    ) {
+        if (compare(order[middle - 1], order[middle], distances) <= 0) {
+            return;
+        }
+
+        int left = start;
+        int right = middle;
+        int output = start;
+        while (left < middle && right < end) {
+            if (compare(order[left], order[right], distances) <= 0) {
+                scratch[output++] = order[left++];
+            } else {
+                scratch[output++] = order[right++];
+            }
+        }
+        while (left < middle) {
+            scratch[output++] = order[left++];
+        }
+        while (right < end) {
+            scratch[output++] = order[right++];
+        }
+        System.arraycopy(scratch, start, order, start, end - start);
+    }
+
+    private static int compare(final int left, final int right, final double[] distances) {
+        return Double.compare(distances[left], distances[right]);
+    }
+
+    private static int divideCeil(final int dividend, final int divisor) {
+        return (dividend + divisor - 1) / divisor;
+    }
+
+    private static int nextMergeWidth(final int width, final int length) {
+        return width >= length - width ? length : width << 1;
+    }
+}
