             final int taskIndex,
             final int startInclusive,
@@ -654,7 +789,17 @@ public final class LeavesXComputeExecutor {
 
         @Override
         public void run() {
-            this.invocation.runWorker(this.taskIndex, this.startInclusive, this.endExclusive);
+            final boolean previous = COMPUTE_WORKER_CONTEXT.get();
+            COMPUTE_WORKER_CONTEXT.set(true);
+            try {
+                this.invocation.runWorker(this.taskIndex, this.startInclusive, this.endExclusive);
+            } finally {
+                if (previous) {
+                    COMPUTE_WORKER_CONTEXT.set(true);
+                } else {
+                    COMPUTE_WORKER_CONTEXT.remove();
+                }
+            }
         }
 
