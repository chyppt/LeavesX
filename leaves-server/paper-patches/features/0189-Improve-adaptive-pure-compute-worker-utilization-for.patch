+    @Test
+    void adaptivelyDispatchesAnIdleMediumAiBatch() {
+        LeavesXComputeExecutor.configure(4, 64);
+        final AtomicIntegerArray counts = new AtomicIntegerArray(192);
+
+        final int partitions = LeavesXComputeExecutor.invokeRangesWithCount(
+            LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+            counts.length(),
+            256,
+            128,
+            (taskIndex, start, end) -> {
+                for (int index = start; index < end; index++) {
+                    counts.incrementAndGet(index);
+                }
+            }
+        );
+
+        assertTrue(partitions > 1, "an idle pool should admit a medium pure-AI batch");
+        for (int index = 0; index < counts.length(); index++) {
+            assertEquals(1, counts.get(index), "adaptive dispatch must process index " + index + " exactly once");
+        }
+        final LeavesXComputeExecutor.WorkloadMetrics metrics = LeavesXComputeExecutor.metrics().workloads().stream()
+            .filter(workload -> workload.workload() == LeavesXComputeExecutor.Workload.AI_TARGET_SORT)
+            .findFirst()
+            .orElseThrow();
+        assertEquals(1L, metrics.parallelInvocations());
+        assertTrue(metrics.workerItems() > 0L, "the adaptive batch must actually execute work off-thread");
+    }
+
+    @Test
+    void nestedWorkerInvocationsDoNotDeadlockTheSharedPool() throws Exception {
+        LeavesXComputeExecutor.configure(2, 16);
+        final ExecutorService caller = Executors.newSingleThreadExecutor();
+        final Future<Boolean> result = caller.submit(() -> LeavesXComputeExecutor.invokeRanges(
+            LeavesXComputeExecutor.Workload.AI_TARGET_SORT,
+            256,
+            1,
+            (taskIndex, start, end) -> {
+                if (Thread.currentThread().getName().startsWith("LeavesX Compute Worker")) {
+                    final int nestedPartitions = LeavesXComputeExecutor.invokeRangesWithCount(
+                        LeavesXComputeExecutor.Workload.AI_TARGET_SELECT,
+                        64,
+                        1,
+                        16,
+                        (nestedTask, nestedStart, nestedEnd) -> { }
+                    );
+                    if (nestedPartitions <= 0) {
+                        throw new AssertionError("nested pure computation must complete inline on a worker");
+                    }
+                }
+            }
+        ));
+
+        boolean completed = false;
+        try {
+            completed = result.get(2L, TimeUnit.SECONDS);
+        } catch (final TimeoutException timeout) {
+            // The assertion below reports the deadlock while finally shutting down the synthetic pool.
+        } finally {
+            LeavesXComputeExecutor.shutdown();
+            caller.shutdownNow();
+        }
+        assertTrue(completed, "a worker must not wait for work queued behind itself");
+    }
+
