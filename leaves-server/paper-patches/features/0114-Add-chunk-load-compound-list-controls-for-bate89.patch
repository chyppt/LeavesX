diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkLoadCompoundListHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkLoadCompoundListHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..0a3bcf24eb1830a6a297701497bc316751554b44
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkLoadCompoundListHotPathTest.java
@@ -0,0 +1,54 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.level.chunk.storage.SerializableChunkData;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies chunk loading retains direct compound-list reads and the vanilla stream fallback. */
+@Normal
+class ChunkLoadCompoundListHotPathTest {
+
+    @Test
+    void parserKeepsOptimizedAndVanillaCompoundListPaths() throws IOException {
+        final ClassNode owner = classNode(SerializableChunkData.class);
+        final List<MethodInsnNode> parseCalls = invocations(method(owner, "parse"));
+        final List<MethodInsnNode> helperCalls = invocations(method(owner, "readCompoundList"));
+
+        assertTrue(parseCalls.stream().anyMatch(call -> call.name.equals("chunkLoadCompoundListsOptimization")));
+        assertTrue(parseCalls.stream().filter(call -> call.name.equals("readCompoundList")).count() >= 2L);
+        assertTrue(helperCalls.stream().anyMatch(call -> call.name.equals("builderWithExpectedSize")));
+        assertTrue(helperCalls.stream().anyMatch(call -> call.name.equals("stream")));
+        assertTrue(helperCalls.stream().anyMatch(call -> call.name.equals("flatMap")));
+        assertTrue(helperCalls.stream().anyMatch(call -> call.name.equals("toList")));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+}
