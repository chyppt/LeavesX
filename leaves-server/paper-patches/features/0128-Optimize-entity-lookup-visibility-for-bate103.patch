diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityLookupVisibilityHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityLookupVisibilityHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..aa67cc271c5ffd940e84da8757c797eb279f455b
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityLookupVisibilityHotPathTest.java
@@ -0,0 +1,140 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.doReturn;
+import static org.mockito.Mockito.mock;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity;
+import ca.spottedleaf.moonrise.patches.chunk_system.level.entity.EntityLookup;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.server.level.FullChunkStatus;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.entity.Visibility;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies direct Moonrise visibility mapping preserves every Paper entity state. */
+@Normal
+class EntityLookupVisibilityHotPathTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedAndFallbackMappingsMatchForEveryChunkStatus() throws Exception {
+        final Entity entity = mock(Entity.class, CALLS_REAL_METHODS);
+        final ChunkSystemEntity chunkSystemEntity = (ChunkSystemEntity)entity;
+
+        try {
+            for (final FullChunkStatus status : new FullChunkStatus[] {
+                null,
+                FullChunkStatus.INACCESSIBLE,
+                FullChunkStatus.FULL,
+                FullChunkStatus.BLOCK_TICKING,
+                FullChunkStatus.ENTITY_TICKING
+            }) {
+                chunkSystemEntity.moonrise$setChunkStatus(status);
+                publish(this.configuration(true, true, "optimized-" + String.valueOf(status) + ".yml"));
+                final Visibility optimized = EntityLookup.getEntityStatus(entity);
+                publish(this.configuration(true, false, "fallback-" + String.valueOf(status) + ".yml"));
+                final Visibility fallback = EntityLookup.getEntityStatus(entity);
+
+                assertEquals(fallback, optimized, String.valueOf(status));
+            }
+
+            doReturn(true).when(entity).isAlwaysTicking();
+            chunkSystemEntity.moonrise$setChunkStatus(null);
+            publish(this.configuration(true, true, "always-optimized.yml"));
+            assertEquals(Visibility.TICKING, EntityLookup.getEntityStatus(entity));
+            publish(this.configuration(true, false, "always-fallback.yml"));
+            assertEquals(Visibility.TICKING, EntityLookup.getEntityStatus(entity));
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void dedicatedSwitchRespectsTheEntityQueryMasterSwitch() throws Exception {
+        try {
+            publish(this.configuration(true, true, "enabled.yml"));
+            assertTrue(LeavesXRuntime.entityLookupVisibilityOptimization());
+
+            publish(this.configuration(true, false, "disabled.yml"));
+            assertFalse(LeavesXRuntime.entityLookupVisibilityOptimization());
+
+            publish(this.configuration(false, true, "master-disabled.yml"));
+            assertFalse(LeavesXRuntime.entityLookupVisibilityOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void optimizedMaskKeepsAlwaysTickingAndPaperFallbackChecks() throws IOException {
+        final MethodNode method = method(classNode(), "maskNonAccessible");
+        final MethodInsnNode[] calls = Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toArray(MethodInsnNode[]::new);
+
+        assertEquals(1L, countCall(calls, "org/leavesx/leavesx/config/LeavesXRuntime", "entityLookupVisibilityOptimization"));
+        assertEquals(1L, countCall(calls, "net/minecraft/world/entity/Entity", "isAlwaysTicking"));
+        assertEquals(1L, countCall(calls, "ca/spottedleaf/moonrise/patches/chunk_system/entity/ChunkSystemEntity", "moonrise$getChunkStatus"));
+        assertEquals(1L, countCall(calls, "ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup", "getEntityStatus"));
+    }
+
+    private LeavesXConfig configuration(
+        final boolean entityQueryOptimizations,
+        final boolean visibilityOptimization,
+        final String fileName
+    ) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-query-optimizations: %s
+              entity-queries:
+                entity-lookup-visibility: %s
+            """.formatted(entityQueryOptimizations, visibilityOptimization));
+        return LeavesXConfigLoader.load(path);
+    }
+
+    private static void publish(final LeavesXConfig config) throws ReflectiveOperationException {
+        final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+        method.setAccessible(true);
+        method.invoke(null, config);
+    }
+
+    private static ClassNode classNode() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(EntityLookup.class.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name));
+    }
+
+    private static long countCall(final MethodInsnNode[] calls, final String owner, final String name) {
+        return Arrays.stream(calls).filter(call -> call.owner.equals(owner) && call.name.equals(name)).count();
+    }
+}
