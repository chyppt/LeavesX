new file mode 100644
index 0000000000000000000000000000000000000000..600efb2a81f84a716fa8acf2c9952d9166149d44
--- /dev/null
+++ b/src/main/java/io/papermc/paper/entity/activation/ActivationRangeSnapshot.java
@@ -0,0 +1,231 @@
+package io.papermc.paper.entity.activation;
+
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Marker;
+import net.minecraft.world.phys.AABB;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+
+/**
+ * Evaluates unusually large entity-activation batches without exposing live entities to compute workers.
+ *
+ * <p>The server thread snapshots immutable AABB components and activation-type ordinals. Workers only compare those
+ * primitive arrays, then the server thread commits {@link Entity#activatedTick} in the original list order. Small
+ * batches stay on Paper's single-pass path because dispatch and snapshot costs exceed the six scalar comparisons.</p>
+ */
+final class ActivationRangeSnapshot {
+
+    private static final int AABB_COMPONENTS = 6;
+    private static final int MINIMUM_CAPACITY = 64;
+    static final byte SKIP_ENTITY = -1;
+    static final byte ALWAYS_ACTIVATE = -2;
+    private static final ActivationType[] ACTIVATION_TYPES = ActivationType.values();
+    private static final ThreadLocal<Workspace> WORKSPACE = ThreadLocal.withInitial(() -> new Workspace(true));
+
+    private ActivationRangeSnapshot() {
+    }
+
+    /**
+     * Activates one player's candidate list when the batch is large enough to amortize a primitive snapshot.
+     *
+     * @return {@code true} when this method handled the list; {@code false} requests Paper's direct loop
+     */
+    static boolean activateEntities(
+        final List<Entity> entities,
+        final boolean tickMarkers,
+        final long currentTick
+    ) {
+        final int size = entities.size();
+        final int minimumCandidates = LeavesXRuntime.entityActivationMinimumEntities();
+        if (!LeavesXRuntime.parallelEntityActivation()
+            || size < minimumCandidates
+            || LeavesXComputeExecutor.computeLaneCount() <= 1) {
+            return false;
+        }
+
+        final Workspace workspace = acquireWorkspace(size);
+        try {
+            snapshotActivationBounds(workspace.activationBounds);
+            snapshotEntityBounds(entities, workspace, tickMarkers, currentTick, size);
+            evaluateSnapshot(
+                workspace.entityBounds,
+                workspace.activationTypes,
+                workspace.activationBounds,
+                workspace.intersections,
+                size,
+                minimumCandidates,
+                LeavesXRuntime.entityActivationMinimumItemsPerWorker()
+            );
+            commitActivations(entities, workspace.intersections, tickMarkers, currentTick, size);
+            return true;
+        } finally {
+            releaseWorkspace(workspace);
+        }
+    }
+
+    /** Runs disjoint primitive ranges and replaces every partial result if a worker fails. */
+    static int evaluateSnapshot(
+        final double[] entityBounds,
+        final byte[] activationTypes,
+        final double[] activationBounds,
+        final boolean[] intersections,
+        final int size,
+        final int minimumCandidates,
+        final int minimumItemsPerWorker
+    ) {
+        final int completedPartitions = LeavesXComputeExecutor.invokeRangesWithCount(
+            LeavesXComputeExecutor.Workload.ENTITY_ACTIVATION,
+            size,
+            minimumCandidates,
+            minimumItemsPerWorker,
+            (taskIndex, start, end) -> evaluateRange(
+                entityBounds,
+                activationTypes,
+                activationBounds,
+                intersections,
+                start,
+                end
+            )
+        );
+        if (completedPartitions == 0) {
+            // A failed range may have written part of the output. Recompute the complete immutable snapshot so no
+            // mixture of successful and failed partitions can affect the main-thread commit.
+            evaluateRange(entityBounds, activationTypes, activationBounds, intersections, 0, size);
+        }
+        return completedPartitions;
+    }
+
+    /** Compares one disjoint range using the same strict inequalities as {@link AABB#intersects(AABB)}. */
+    static void evaluateRange(
+        final double[] entityBounds,
+        final byte[] activationTypes,
+        final double[] activationBounds,
+        final boolean[] intersections,
+        final int start,
+        final int end
+    ) {
+        for (int index = start; index < end; index++) {
+            final byte activationType = activationTypes[index];
+            if (activationType < 0) {
+                intersections[index] = activationType == ALWAYS_ACTIVATE;
+                continue;
+            }
+            final int entityOffset = index * AABB_COMPONENTS;
+            final int activationOffset = activationType * AABB_COMPONENTS;
+            intersections[index] = activationBounds[activationOffset] < entityBounds[entityOffset + 3]
+                && activationBounds[activationOffset + 3] > entityBounds[entityOffset]
+                && activationBounds[activationOffset + 1] < entityBounds[entityOffset + 4]
+                && activationBounds[activationOffset + 4] > entityBounds[entityOffset + 1]
+                && activationBounds[activationOffset + 2] < entityBounds[entityOffset + 5]
+                && activationBounds[activationOffset + 5] > entityBounds[entityOffset + 2];
+        }
+    }
+
+    private static void snapshotActivationBounds(final double[] destination) {
+        for (int typeIndex = 0; typeIndex < ACTIVATION_TYPES.length; typeIndex++) {
+            writeBounds(destination, typeIndex * AABB_COMPONENTS, ACTIVATION_TYPES[typeIndex].boundingBox);
+        }
+    }
+
+    private static void snapshotEntityBounds(
+        final List<Entity> entities,
+        final Workspace workspace,
+        final boolean tickMarkers,
+        final long currentTick,
+        final int size
+    ) {
+        for (int index = 0; index < size; index++) {
+            final Entity entity = entities.get(index);
+            if ((!tickMarkers && entity instanceof Marker) || currentTick <= entity.activatedTick) {
+                workspace.activationTypes[index] = SKIP_ENTITY;
+                continue;
+            }
+            if (entity.defaultActivationState) {
+                workspace.activationTypes[index] = ALWAYS_ACTIVATE;
+                continue;
+            }
+            workspace.activationTypes[index] = (byte)entity.activationType.ordinal();
+            writeBounds(workspace.entityBounds, index * AABB_COMPONENTS, entity.getBoundingBox());
+        }
+    }
+
+    private static void writeBounds(final double[] destination, final int offset, final AABB bounds) {
+        destination[offset] = bounds.minX;
+        destination[offset + 1] = bounds.minY;
+        destination[offset + 2] = bounds.minZ;
+        destination[offset + 3] = bounds.maxX;
+        destination[offset + 4] = bounds.maxY;
+        destination[offset + 5] = bounds.maxZ;
+    }
+
+    private static void commitActivations(
+        final List<Entity> entities,
+        final boolean[] intersections,
+        final boolean tickMarkers,
+        final long currentTick,
+        final int size
+    ) {
+        for (int index = 0; index < size; index++) {
+            if (intersections[index]) {
+                final Entity entity = entities.get(index);
+                // No live entity state is observed by a worker. Rechecking the tick guards the commit if this helper
+                // is ever called from a re-entrant server-thread path in the future.
+                if (currentTick <= entity.activatedTick || (!tickMarkers && entity instanceof Marker)) {
+                    continue;
+                }
+                entity.activatedTick = currentTick;
+            }
+        }
+    }
+
+    private static Workspace acquireWorkspace(final int size) {
+        final Workspace cached = WORKSPACE.get();
+        final Workspace workspace;
+        if (cached.inUse) {
+            // World ticks are normally non-reentrant. A private workspace still makes unexpected re-entry safe.
+            workspace = new Workspace(false);
+        } else {
+            cached.inUse = true;
+            workspace = cached;
+        }
+        workspace.ensureCapacity(size);
+        return workspace;
+    }
+
+    private static void releaseWorkspace(final Workspace workspace) {
+        if (workspace.pooled) {
+            workspace.inUse = false;
+        }
+    }
+
+    private static int expandedCapacity(final int current, final int required) {
+        final int grown = current + (current >>> 1) + 1;
+        return Math.max(required, Math.max(MINIMUM_CAPACITY, grown));
+    }
+
+    private static final class Workspace {
+
+        private final boolean pooled;
+        private final double[] activationBounds = new double[ACTIVATION_TYPES.length * AABB_COMPONENTS];
+        private double[] entityBounds = new double[0];
+        private byte[] activationTypes = new byte[0];
+        private boolean[] intersections = new boolean[0];
+        private boolean inUse;
+
+        private Workspace(final boolean pooled) {
+            this.pooled = pooled;
+        }
+
+        private void ensureCapacity(final int size) {
+            if (this.activationTypes.length >= size) {
+                return;
+            }
+            final int capacity = expandedCapacity(this.activationTypes.length, size);
+            this.entityBounds = Arrays.copyOf(this.entityBounds, Math.multiplyExact(capacity, AABB_COMPONENTS));
+            this.activationTypes = Arrays.copyOf(this.activationTypes, capacity);
+            this.intersections = Arrays.copyOf(this.intersections, capacity);
+        }
+    }
+}
