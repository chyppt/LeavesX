+package io.papermc.paper.entity.activation;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.Random;
+import net.minecraft.world.phys.AABB;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+@Normal
+public class ActivationRangeSnapshotTest {
+
+    private static final int AABB_COMPONENTS = 6;
+
+    @AfterEach
+    void shutdownExecutor() {
+        LeavesXComputeExecutor.shutdown();
+    }
+
+    @Test
+    void parallelIntersectionMatchesPaperForEveryActivationTypeAndBoundary() {
+        final int randomCases = 8_192;
+        final int size = randomCases + 6;
+        final double[] entityBounds = new double[size * AABB_COMPONENTS];
+        final byte[] activationTypes = new byte[size];
+        final double[] activationBounds = activationBounds();
+        final Random random = new Random(0x4163746976617465L);
+        for (int index = 0; index < randomCases; index++) {
+            final double minX = random.nextDouble(-128.0D, 128.0D);
+            final double minY = random.nextDouble(-64.0D, 64.0D);
+            final double minZ = random.nextDouble(-128.0D, 128.0D);
+            writeBounds(
+                entityBounds,
+                index,
+                minX,
+                minY,
+                minZ,
+                minX + random.nextDouble(0.01D, 8.0D),
+                minY + random.nextDouble(0.01D, 8.0D),
+                minZ + random.nextDouble(0.01D, 8.0D)
+            );
+            activationTypes[index] = (byte)(index % ActivationType.values().length);
+        }
+
+        // Touching faces and a zero-width box exercise Paper's strict (<, >) boundary semantics.
+        writeBounds(entityBounds, randomCases, 16.0D, -2.0D, -2.0D, 18.0D, 2.0D, 2.0D);
+        writeBounds(entityBounds, randomCases + 1, -18.0D, -2.0D, -2.0D, -16.0D, 2.0D, 2.0D);
+        writeBounds(entityBounds, randomCases + 2, -1.0D, 16.0D, -1.0D, 1.0D, 18.0D, 1.0D);
+        writeBounds(entityBounds, randomCases + 3, 0.0D, 0.0D, 0.0D, 0.0D, 0.0D, 0.0D);
+        activationTypes[randomCases + 4] = ActivationRangeSnapshot.SKIP_ENTITY;
+        activationTypes[randomCases + 5] = ActivationRangeSnapshot.ALWAYS_ACTIVATE;
+
+        final boolean[] expected = referenceIntersections(entityBounds, activationTypes, activationBounds, size);
+        final boolean[] actual = new boolean[size];
+        LeavesXComputeExecutor.configure(4, 16);
+
+        final int partitions = ActivationRangeSnapshot.evaluateSnapshot(
+            entityBounds,
+            activationTypes,
+            activationBounds,
+            actual,
+            size,
+            1,
+            1_024
+        );
+
+        assertArrayEquals(expected, actual);
+        assertEquals(5, partitions, "four workers plus the calling thread should process this deterministic batch");
+        final LeavesXComputeExecutor.WorkloadMetrics metrics = workload();
+        assertEquals(1L, metrics.parallelInvocations());
+        assertEquals(size, metrics.totalItems());
+    }
+
+    @Test
+    void synchronousFallbackRecomputesTheCompleteSnapshot() {
+        final int size = 256;
+        final double[] entityBounds = new double[size * AABB_COMPONENTS];
+        final byte[] activationTypes = new byte[size];
+        final double[] activationBounds = activationBounds();
+        final boolean[] actual = new boolean[size];
+        for (int index = 0; index < size; index++) {
+            writeBounds(entityBounds, index, -1.0D, -1.0D, -1.0D, 1.0D, 1.0D, 1.0D);
+            activationTypes[index] = (byte)(index % ActivationType.values().length);
+            actual[index] = (index & 1) == 0;
+        }
+
+        LeavesXComputeExecutor.configure(4, 64);
+        final int partitions = ActivationRangeSnapshot.evaluateSnapshot(
+            entityBounds,
+            activationTypes,
+            activationBounds,
+            actual,
+            size,
+            1_024,
+            64
+        );
+
+        assertEquals(0, partitions);
+        assertArrayEquals(referenceIntersections(entityBounds, activationTypes, activationBounds, size), actual);
+        assertEquals(1L, workload().belowFeatureThresholdFallbacks());
+    }
+
+    @Test
+    void workerRangeCannotReachLiveEntityOrWorldState() throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(ActivationRangeSnapshot.class.getName()).accept(
+            classNode,
+            ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES
+        );
+        final MethodNode method = classNode.methods.stream()
+            .filter(candidate -> candidate.name.equals("evaluateRange"))
+            .findFirst()
+            .orElseThrow();
+
+        assertEquals("([D[B[D[ZII)V", method.desc, "worker input must remain primitive arrays and indexes");
+        assertFalse(
+            Arrays.stream(method.instructions.toArray())
+                .filter(MethodInsnNode.class::isInstance)
+                .map(MethodInsnNode.class::cast)
+                .anyMatch(call -> call.owner.startsWith("net/minecraft/world/")),
+            "worker range must not call entity or world methods"
+        );
+        assertFalse(
+            Arrays.stream(method.instructions.toArray())
+                .filter(FieldInsnNode.class::isInstance)
+                .map(FieldInsnNode.class::cast)
+                .anyMatch(field -> field.owner.startsWith("net/minecraft/world/")),
+            "worker range must not read entity or world fields"
+        );
+    }
+
+    private static double[] activationBounds() {
+        final double[] bounds = new double[ActivationType.values().length * AABB_COMPONENTS];
+        for (int typeIndex = 0; typeIndex < ActivationType.values().length; typeIndex++) {
+            final double radius = 16.0D + typeIndex * 4.0D;
+            writeBounds(bounds, typeIndex, -radius, -32.0D, -radius, radius, 32.0D, radius);
+        }
+        return bounds;
+    }
+
+    private static boolean[] referenceIntersections(
+        final double[] entityBounds,
+        final byte[] activationTypes,
+        final double[] activationBounds,
+        final int size
+    ) {
+        final boolean[] expected = new boolean[size];
+        for (int index = 0; index < size; index++) {
+            final byte activationType = activationTypes[index];
+            if (activationType < 0) {
+                expected[index] = activationType == ActivationRangeSnapshot.ALWAYS_ACTIVATE;
+                continue;
+            }
+            final int entityOffset = index * AABB_COMPONENTS;
+            final int activationOffset = activationType * AABB_COMPONENTS;
+            final AABB activationBox = boxAt(activationBounds, activationOffset);
+            expected[index] = activationBox.intersects(boxAt(entityBounds, entityOffset));
+        }
+        return expected;
+    }
+
+    private static AABB boxAt(final double[] bounds, final int offset) {
+        return new AABB(
+            bounds[offset],
+            bounds[offset + 1],
+            bounds[offset + 2],
+            bounds[offset + 3],
+            bounds[offset + 4],
+            bounds[offset + 5]
+        );
+    }
+
+    private static void writeBounds(
+        final double[] destination,
+        final int index,
+        final double minX,
+        final double minY,
+        final double minZ,
+        final double maxX,
+        final double maxY,
+        final double maxZ
+    ) {
+        final int offset = index * AABB_COMPONENTS;
+        destination[offset] = minX;
+        destination[offset + 1] = minY;
+        destination[offset + 2] = minZ;
+        destination[offset + 3] = maxX;
+        destination[offset + 4] = maxY;
+        destination[offset + 5] = maxZ;
+    }
+
+    private static LeavesXComputeExecutor.WorkloadMetrics workload() {
+        return LeavesXComputeExecutor.metrics().workloads().stream()
+            .filter(metrics -> metrics.workload() == LeavesXComputeExecutor.Workload.ENTITY_ACTIVATION)
+            .findFirst()
+            .orElseThrow();
+    }
+}
