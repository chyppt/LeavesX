     /** Value-keyed counterpart used by persistent records that may recreate identifier objects between calls. */
     public static void awaitKey(final Workload workload, final Object key) {
-        org.leavesx.leavesx.diagnostics.OwnerThreadWaits.measure(
-            org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.ORDERED_BARRIER,
-            () -> submitKeyedOrRun(workload, key, () -> { }).join());
+        awaitLane(workload, new ValueKey(key));
+    }
+
+    /**
+     * Captures the lane tail without consuming executor capacity or adding a synthetic task.
+     *
+     * <p>A synthetic barrier can wait behind unrelated work when the shared queue is full. A
+     * lane tail is a linearizable snapshot: work appended afterwards is intentionally outside
+     * this barrier.</p>
+     */
+    private static void awaitLane(final Workload workload, final LaneKey ownerKey) {
+        Objects.requireNonNull(workload, "workload");
+        final ExecutorState state = executors.get(workload);
+        if (state == null) {
+            return;
+        }
+        final AtomicReference<CompletableFuture<Void>> captured = new AtomicReference<>();
+        // Capture under the same map operation as append/removal. Reading a detached lane
+        // could miss a replacement lane installed by a concurrent submission.
+        state.ownedLanes.computeIfPresent(ownerKey, (ignored, lane) -> {
+            synchronized (lane) {
+                captured.set(lane.tail);
+            }
+            return lane;
+        });
+        final CompletableFuture<Void> tail = captured.get();
+        if (tail != null && !tail.isDone()) {
+            final long started = System.nanoTime();
+            try {
+                org.leavesx.leavesx.diagnostics.OwnerThreadWaits.join(
+                    org.leavesx.leavesx.diagnostics.OwnerThreadWaits.Site.ORDERED_BARRIER, tail);
+            } finally {
+                state.barrierWaitTiming.record(System.nanoTime() - started);
+            }
+        }
     }
 
     public static boolean enabled(final Workload workload) {
