diff --git a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
index 85910345c0619e4b60326293f933346429d68add..4f1cb63ce8b9403fbb22af4e6e9aff28e4691dc0 100644
--- a/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
+++ b/src/test/java/org/leavesx/leavesx/runtime/LeavesXComputeExecutorTest.java
@@ -128,9 +128,18 @@ class LeavesXComputeExecutorTest {
     }
 
     @Test
-    void keepsStartedWorkersWarmBetweenSparseLargeJobs() {
-        LeavesXComputeExecutor.configure(2);
+    void prestartsConfiguredWorkersAndKeepsThemWarmBetweenSparseLargeJobs() throws ReflectiveOperationException {
+        LeavesXComputeExecutor.configure(2, 64, true);
         assertFalse(LeavesXComputeExecutor.allowsCoreThreadTimeout());
+        assertTrue(LeavesXComputeExecutor.prestartWorkers());
+        assertEquals(2, executor().getPoolSize());
+    }
+
+    @Test
+    void canDisableWorkerPrestartForSmallHosts() throws ReflectiveOperationException {
+        LeavesXComputeExecutor.configure(2, 64, false);
+        assertFalse(LeavesXComputeExecutor.prestartWorkers());
+        assertEquals(0, executor().getPoolSize());
     }
 
     @Test
