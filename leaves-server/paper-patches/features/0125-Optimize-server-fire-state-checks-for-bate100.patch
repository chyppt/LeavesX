diff --git a/src/test/java/org/leavesx/leavesx/config/EntityFireStateOptimizationTest.java b/src/test/java/org/leavesx/leavesx/config/EntityFireStateOptimizationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..3f25a7740342e8a5b6e4ace8c4409e70166dcfa9
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/EntityFireStateOptimizationTest.java
@@ -0,0 +1,110 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.doReturn;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/** Verifies server fire-state short-circuiting while preserving the client and Paper paths. */
+@Normal
+class EntityFireStateOptimizationTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void optimizedServerPathSkipsImmunityForZeroFireTicks() throws Exception {
+        final Entity entity = this.entity(false, false, false, 0);
+        try {
+            LeavesXRuntime.publish(this.configuration(true, "optimized.yml"));
+            assertFalse(entity.isOnFire());
+            verify(entity, never()).fireImmune();
+            verify(entity, never()).getSharedFlag(anyInt());
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void optimizedServerPathStillChecksImmunityWhenBurning() throws Exception {
+        final Entity vulnerable = this.entity(false, false, false, 20);
+        final Entity immune = this.entity(false, true, false, 20);
+        try {
+            LeavesXRuntime.publish(this.configuration(true, "burning.yml"));
+            assertTrue(vulnerable.isOnFire());
+            assertFalse(immune.isOnFire());
+            verify(vulnerable).fireImmune();
+            verify(immune).fireImmune();
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void disabledOptimizationKeepsThePaperEvaluationPath() throws Exception {
+        final Entity entity = this.entity(false, false, false, 0);
+        try {
+            LeavesXRuntime.publish(this.configuration(false, "fallback.yml"));
+            assertFalse(entity.isOnFire());
+            verify(entity).fireImmune();
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void clientSharedFireFlagKeepsItsOriginalMeaning() throws Exception {
+        final Entity entity = this.entity(true, false, true, 0);
+        try {
+            LeavesXRuntime.publish(this.configuration(true, "client.yml"));
+            assertTrue(entity.isOnFire());
+            verify(entity).fireImmune();
+            verify(entity).getSharedFlag(anyInt());
+        } finally {
+            LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    private Entity entity(
+        final boolean clientSide,
+        final boolean fireImmune,
+        final boolean sharedFireFlag,
+        final int remainingFireTicks
+    ) throws ReflectiveOperationException {
+        final Entity entity = mock(Entity.class, CALLS_REAL_METHODS);
+        final Level level = mock(Level.class);
+        doReturn(level).when(entity).level();
+        doReturn(clientSide).when(level).isClientSide();
+        doReturn(fireImmune).when(entity).fireImmune();
+        doReturn(sharedFireFlag).when(entity).getSharedFlag(anyInt());
+        final Field field = Entity.class.getDeclaredField("remainingFireTicks");
+        field.setAccessible(true);
+        field.setInt(entity, remainingFireTicks);
+        return entity;
+    }
+
+    private LeavesXConfig configuration(final boolean optimized, final String fileName) throws IOException {
+        final Path path = this.tempDir.resolve(fileName);
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              entity-update:
+                server-fire-state: %s
+            """.formatted(optimized));
+        return LeavesXConfigLoader.load(path);
+    }
+}
