                 sender.sendMessage(line("  借用空闲计算线程", LeavesXAsyncRuntime.borrowedTaskCount(workload) + " 次", NamedTextColor.DARK_GRAY));
             }
+            if (workload == LeavesXAsyncRuntime.Workload.ENTITY_TRACKER) {
+                sender.sendMessage(line(
+                    "  提交前单实体重算",
+                    "输入变化 " + org.leavesx.leavesx.performance.EntityTrackingRangeBatch.snapshotRecomputations()
+                        + " 次 / 插件改动列表 " + org.leavesx.leavesx.performance.EntityTrackingRangeBatch.slotRecomputations() + " 次",
+                    NamedTextColor.DARK_GRAY
+                ));
+            }
             final var admissionWait = LeavesXAsyncRuntime.recentAdmissionWaitTiming(workload);
             if (admissionWait.samples() > 0L) {
                 sender.sendMessage(line(
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfig.java
