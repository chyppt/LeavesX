diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
index d6a7fb754c..24483a7b12 100644
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigWriter.java
@@ -212,6 +212,7 @@ public final class LeavesXConfigWriter {
         changed |= writeValue(node.node("parallelism", "scheduling", "low-priority-queue-limit"), "parallelism.scheduling.low-priority-queue-limit", scheduling.lowPriorityQueueLimit(), missingOnly);
         changed |= writeValue(node.node("async", "shared-compute-workers"), "async.shared-compute-workers", async.sharedComputeWorkers(), missingOnly);
         changed |= writeValue(node.node("async", "entity-tracker", "comparison-sharding"), "async.entity-tracker.comparison-sharding", async.trackerComparisonSharding(), missingOnly);
+        changed |= writeValue(node.node("async", "entity-tracker", "event-listeners"), "async.entity-tracker.event-listeners", async.trackerEventListeners(), missingOnly);
         changed |= writeValue(node.node("async", "chunk-send", "enabled"), "async.chunk-send.enabled", async.chunkSendEnabled(), missingOnly);
         changed |= writeValue(node.node("async", "chunk-send", "queue-size"), "async.chunk-send.queue-size", async.chunkSendQueueSize(), missingOnly);
         changed |= writeValue(node.node("async", "mob-spawning"), "async.mob-spawning", async.mobSpawningEnabled(), missingOnly);
@@ -630,6 +631,7 @@ public final class LeavesXConfigWriter {
         comments.put("async.shared-compute-workers", "寻路快照和 AI 候选可借用空闲计算线程；繁忙时使用原异步池或主线程完整回退，修改需重启。默认：true。");
         comments.put("async.low-load-workers", "已有并行计算在单实体或小任务时也尝试工作线程；会增加调度与等待开销，关闭后恢复按工作量派发，修改需重启。默认：true。");
         comments.put("async.entity-tracker.comparison-sharding", "按实体与玩家的比较次数分配追踪计算；关闭后使用原来的实体分片，修改需重启。默认：true。");
+        comments.put("async.entity-tracker.event-listeners", "插件监听实体追踪或玩家速度事件时仍并行计算距离；事件、发包和追踪变更按原实体顺序在主线程执行，输入被事件改动时只重算当前实体。关闭后有监听器就使用 Paper 原循环，可重载。默认：true。");
         comments.put("async.playerdata-save.enabled", "是否异步保存玩家数据；采集玩家状态仍在主线程，同一玩家按顺序保存。默认：true。");
         comments.put("async.playerdata-save.queue-size", "玩家数据写入最多排队任务数；队列满时等待空位，不会让新存档越过旧存档。默认：1024。");
         comments.put("async.entity-tracker.enabled", "是否并行计算实体追踪变化；发包、事件和追踪关系提交仍在主线程。默认：true。");
