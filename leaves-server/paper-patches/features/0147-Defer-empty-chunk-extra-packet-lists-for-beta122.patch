diff --git a/src/test/java/org/leavesx/leavesx/performance/ChunkExtraPacketListHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ChunkExtraPacketListHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c6f019b57cc63bafa54044bf794b2e95de9dd7e6
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ChunkExtraPacketListHotPathTest.java
@@ -0,0 +1,125 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies ordinary chunk packets avoid a list allocation without changing oversized-block-entity packet order. */
+@Normal
+class ChunkExtraPacketListHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void optimizedEmptyListsReuseTheSharedEmptyListAndAllocateOnFirstAppend() throws ReflectiveOperationException {
+        final List<Packet<?>> first = createExtraPacketList(true);
+        final List<Packet<?>> second = createExtraPacketList(true);
+        final Packet<?> firstPacket = mock(Packet.class);
+        final Packet<?> secondPacket = mock(Packet.class);
+
+        final List<Packet<?>> appended = appendExtraPacket(first, firstPacket);
+        final List<Packet<?>> appendedAgain = appendExtraPacket(appended, secondPacket);
+
+        assertSame(first, second);
+        assertTrue(first.isEmpty());
+        assertInstanceOf(ArrayList.class, appended);
+        assertNotSame(first, appended);
+        assertSame(appended, appendedAgain);
+        assertEquals(List.of(firstPacket, secondPacket), appendedAgain);
+    }
+
+    @Test
+    void fallbackCreatesIndependentMutableListsAndAppendsInPlace() throws ReflectiveOperationException {
+        final List<Packet<?>> first = createExtraPacketList(false);
+        final List<Packet<?>> second = createExtraPacketList(false);
+        final Packet<?> packet = mock(Packet.class);
+
+        final List<Packet<?>> appended = appendExtraPacket(first, packet);
+
+        assertInstanceOf(ArrayList.class, first);
+        assertNotSame(first, second);
+        assertSame(first, appended);
+        assertEquals(List.of(packet), appended);
+    }
+
+    @Test
+    void version50ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-50.yml");
+        Files.writeString(path, """
+            config-version: 50
+            performance:
+              network:
+                lazy-chunk-extra-packets: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.lazyChunkExtraPacketsOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("lazy-chunk-extra-packets: false"));
+        assertTrue(upgraded.contains("# 区块没有额外方块实体包时不创建空列表，关闭后始终创建。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Packet<?>> createExtraPacketList(final boolean lazy) throws ReflectiveOperationException {
+        final Method method = ClientboundLevelChunkPacketData.class.getDeclaredMethod(
+            "leavesX$createExtraPacketList",
+            boolean.class
+        );
+        method.setAccessible(true);
+        return (List<Packet<?>>)method.invoke(null, lazy);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Packet<?>> appendExtraPacket(
+        final List<Packet<?>> packets,
+        final Packet<?> packet
+    ) throws ReflectiveOperationException {
+        final Method method = ClientboundLevelChunkPacketData.class.getDeclaredMethod(
+            "leavesX$appendExtraPacket",
+            List.class,
+            Packet.class
+        );
+        method.setAccessible(true);
+        return (List<Packet<?>>)method.invoke(null, packets, packet);
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+}
