+    @Test
+    void tickerGateUsesCachedChunkKeyAndKeepsTheOriginalFallback() throws IOException {
+        final ClassNode tickerContract = classNode(TickingBlockEntity.class.getName());
+        final ClassNode level = classNode(Level.class.getName());
+        final MethodNode gate = method(level, "shouldTickBlockEntityFilterNull");
+
+        method(tickerContract, "leavesX$getChunkKey");
+        assertTrue(hasCall(gate, LeavesXRuntime.class, "blockEntityOptimizations"));
+        assertTrue(hasCall(gate, TickingBlockEntity.class, "leavesX$getChunkKey"));
+        assertTrue(hasCall(gate, Level.class, "shouldTickBlocksAt", "(J)Z"));
+        assertTrue(hasCall(gate, Level.class, "shouldTickBlocksAt", "(Lnet/minecraft/core/BlockPos;)Z"));
+    }
+
+    @Test
+    void boundTickerCachesProfilerAndValidationMetadataWithFallbacks() throws IOException {
+        final ClassNode boundTicker = classNode(LevelChunk.class.getName() + "$BoundTickingBlockEntity");
+        final MethodNode tick = method(boundTicker, "tick");
+
+        assertTrue(hasCall(tick, LeavesXRuntime.class, "blockEntityOptimizations"));
+        assertTrue(hasCall(tick, BlockEntityType.class, "isValid"));
+        assertTrue(hasCall(tick, "net/minecraft/util/profiling/ProfilerFiller", "push", "(Ljava/lang/String;)V"));
+        assertTrue(hasCall(tick, "net/minecraft/util/profiling/ProfilerFiller", "push", "(Ljava/util/function/Supplier;)V"));
+    }
+
     private static ClassNode classNode(final String className) throws IOException {
         final ClassNode classNode = new ClassNode(Opcodes.ASM9);
         new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
@@ -46,6 +78,27 @@ class BlockEntityTickerHotPathTest {
             .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
     }
 
+    private static boolean hasField(final ClassNode owner, final String name, final String descriptor) {
+        return owner.fields.stream().anyMatch(field -> field.name.equals(name) && field.desc.equals(descriptor));
+    }
+
+    private static boolean hasCall(final MethodNode method, final Class<?> owner, final String methodName) {
+        return hasCall(method, owner.getName().replace('.', '/'), methodName, null);
+    }
+
+    private static boolean hasCall(final MethodNode method, final Class<?> owner, final String methodName, final String descriptor) {
+        return hasCall(method, owner.getName().replace('.', '/'), methodName, descriptor);
+    }
+
+    private static boolean hasCall(final MethodNode method, final String owner, final String methodName, final String descriptor) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(owner)
+                && call.name.equals(methodName)
+                && (descriptor == null || call.desc.equals(descriptor)));
+    }
+
