+    private static java.util.List<String> readStringList(
+        final ConfigurationNode node,
+        final String path,
+        final java.util.List<String> defaultValue
+    ) {
+        if (node.virtual()) {
+            return defaultValue;
+        }
+        if (!node.isList()) {
+            throw invalidType(path, "a list of strings", node.raw());
+        }
+        final java.util.ArrayList<String> values = new java.util.ArrayList<>();
+        for (final ConfigurationNode child : node.childrenList()) {
+            final Object raw = child.rawScalar();
+            if (!(raw instanceof String value)) {
+                throw invalidType(path, "a list of strings", raw);
+            }
+            values.add(value);
+        }
+        return java.util.List.copyOf(values);
+    }
