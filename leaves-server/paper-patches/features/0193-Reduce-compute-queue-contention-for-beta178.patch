+    private static List<String> normalizeForbiddenNameFragments(final List<String> values) {
+        if (values == null) {
+            throw new IllegalArgumentException("fakeplayer.forbidden-name-contains must not be null");
+        }
+        if (values.size() > 64) {
+            throw new IllegalArgumentException("fakeplayer.forbidden-name-contains must contain at most 64 entries");
+        }
+        final List<String> normalized = new ArrayList<>(values.size());
+        for (final String value : values) {
+            if (value == null) {
+                throw new IllegalArgumentException("fakeplayer.forbidden-name-contains must not contain null entries");
+            }
+            final String fragment = value.trim().toLowerCase(Locale.ROOT);
+            if (fragment.length() > 64) {
+                throw new IllegalArgumentException(
+                    "fakeplayer.forbidden-name-contains entries must not exceed 64 characters"
+                );
+            }
+            if (!fragment.isEmpty() && !normalized.contains(fragment)) {
+                normalized.add(fragment);
+            }
+        }
+        return List.copyOf(normalized);
+    }
+
     /** Returns whether one independently configurable optimization is enabled. */
