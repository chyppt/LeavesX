diff --git a/src/test/java/org/leavesx/leavesx/performance/LightLayerSnapshotCopyHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/LightLayerSnapshotCopyHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..9b9f068a280aeca996e1080a7c870d1bb2bc9156
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/LightLayerSnapshotCopyHotPathTest.java
@@ -0,0 +1,91 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import net.minecraft.world.level.chunk.DataLayer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies light-layer snapshots remain detached and preserve the compact source representation. */
+@Normal
+class LightLayerSnapshotCopyHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void copiesMaterializedLayerIntoAnIndependentArray() {
+        final byte[] source = new byte[DataLayer.SIZE];
+        Arrays.fill(source, (byte)0x5A);
+        final DataLayer layer = new DataLayer(source);
+
+        final byte[] snapshot = layer.leavesX$copyData();
+
+        assertArrayEquals(source, snapshot);
+        assertNotSame(source, snapshot);
+        snapshot[0] = 0;
+        assertEquals((byte)0x5A, source[0]);
+    }
+
+    @Test
+    void copiesHomogeneousLayerWithoutMaterializingTheSource() {
+        final DataLayer layer = new DataLayer(9);
+
+        final byte[] snapshot = layer.leavesX$copyData();
+        final byte[] expected = new byte[DataLayer.SIZE];
+        Arrays.fill(expected, (byte)0x99);
+
+        assertTrue(layer.isDefinitelyHomogenous());
+        assertArrayEquals(expected, snapshot);
+    }
+
+    @Test
+    void version49ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-49.yml");
+        Files.writeString(path, """
+            config-version: 49
+            performance:
+              network:
+                light-layer-snapshot-copy: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.lightLayerSnapshotCopyOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("light-layer-snapshot-copy: false"));
+        assertTrue(upgraded.contains("# 复制区块光照数据时不创建临时对象，关闭后使用原版复制。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+}
