diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityLifecycleEventHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityLifecycleEventHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..934604da3bbe60596ec35833fb7883c8d895bb0d
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityLifecycleEventHotPathTest.java
@@ -0,0 +1,89 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.google.common.collect.Lists;
+import java.io.IOException;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies allocation guards on entity tracking lifecycle callbacks. */
+@Normal
+class EntityLifecycleEventHotPathTest {
+
+    private static final String ENTITY_CALLBACK_DESCRIPTOR = "(Lnet/minecraft/world/entity/Entity;)V";
+
+    @Test
+    void lifecycleEventsRetainPluginPathsBehindTheConfiguredEmptyListenerGuard() throws IOException {
+        final ClassNode callbacks = classNode(ServerLevel.class.getName() + "$EntityCallbacks");
+        final MethodNode trackingStart = method(callbacks, "onTrackingStart", ENTITY_CALLBACK_DESCRIPTOR);
+        final MethodNode trackingEnd = method(callbacks, "onTrackingEnd", ENTITY_CALLBACK_DESCRIPTOR);
+
+        assertTrue(hasCall(trackingStart, LeavesXRuntime.class, "entityLifecycleEventOptimization"));
+        assertTrue(hasCall(trackingStart, "com/destroystokyo/paper/event/entity/EntityAddToWorldEvent", "getHandlerList"));
+        assertTrue(hasConstructor(trackingStart, "com/destroystokyo/paper/event/entity/EntityAddToWorldEvent"));
+
+        assertTrue(hasCall(trackingEnd, LeavesXRuntime.class, "entityLifecycleEventOptimization"));
+        assertTrue(hasCall(trackingEnd, "com/destroystokyo/paper/event/entity/EntityRemoveFromWorldEvent", "getHandlerList"));
+        assertTrue(hasConstructor(trackingEnd, "com/destroystokyo/paper/event/entity/EntityRemoveFromWorldEvent"));
+    }
+
+    @Test
+    void emptyInventoryViewerListsAreCheckedBeforeCopying() throws IOException {
+        final MethodNode trackingEnd = method(
+            classNode(ServerLevel.class.getName() + "$EntityCallbacks"),
+            "onTrackingEnd",
+            ENTITY_CALLBACK_DESCRIPTOR
+        );
+        final int emptyCheck = firstCallIndex(trackingEnd, List.class.getName().replace('.', '/'), "isEmpty");
+        final int defensiveCopy = firstCallIndex(trackingEnd, Lists.class.getName().replace('.', '/'), "newArrayList");
+
+        assertTrue(emptyCheck >= 0, "Entity unload must check whether inventory viewers are empty");
+        assertTrue(defensiveCopy > emptyCheck, "The defensive copy must be allocated only after the empty check");
+    }
+
+    private static ClassNode classNode(final String className) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(className).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName + descriptor));
+    }
+
+    private static boolean hasCall(final MethodNode method, final Class<?> owner, final String methodName) {
+        return hasCall(method, owner.getName().replace('.', '/'), methodName);
+    }
+
+    private static boolean hasCall(final MethodNode method, final String owner, final String methodName) {
+        return firstCallIndex(method, owner, methodName) >= 0;
+    }
+
+    private static boolean hasConstructor(final MethodNode method, final String owner) {
+        return hasCall(method, owner, "<init>");
+    }
+
+    private static int firstCallIndex(final MethodNode method, final String owner, final String methodName) {
+        final org.objectweb.asm.tree.AbstractInsnNode[] instructions = method.instructions.toArray();
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call
+                && call.owner.equals(owner)
+                && call.name.equals(methodName)) {
+                return index;
+            }
+        }
+        return -1;
+    }
+}
