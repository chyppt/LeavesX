         assertNoArrayListAllocation(method(owner, "tick"));
         assertTrue(callsMutableSetter(method(owner, "tick")));
         assertTrue(callsMutableSetter(method(owner, "updateBase")));
+        final MethodNode applyEffects = method(owner, "applyEffects");
+        assertTrue(calls(applyEffects, "net/minecraft/world/level/Level", "leavesX$acquireEntityQueryBuffer"));
+        assertTrue(calls(applyEffects, "net/minecraft/world/level/Level$LeavesXEntityQueryBuffer", "close"));
+        assertFalse(applyEffects.tryCatchBlocks.isEmpty());
+    }
+
+    private static boolean calls(final MethodNode method, final String owner, final String name) {
+        return java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0), false
+        ).filter(MethodInsnNode.class::isInstance).map(MethodInsnNode.class::cast).anyMatch(call ->
+            call.owner.equals(owner) && call.name.equals(name)
+        );
     }
 
