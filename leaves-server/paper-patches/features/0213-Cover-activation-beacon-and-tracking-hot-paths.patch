--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ActivationCandidateDeduplicationHotPathTest.java
@@ -0,0 +1,45 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.papermc.paper.entity.activation.ActivationRange;
+import java.io.IOException;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.InvokeDynamicInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Guards the per-tick activation candidate filter used before spatial query result allocation. */
+@Normal
+class ActivationCandidateDeduplicationHotPathTest {
+
+    @Test
+    void activationQueryFiltersEntitiesAlreadyVisitedThisTick() throws IOException {
+        final ClassNode owner = new ClassNode();
+        new ClassReader(ActivationRange.class.getName()).accept(owner, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        final MethodNode activate = owner.methods.stream()
+            .filter(method -> method.name.equals("activateEntities"))
+            .findFirst()
+            .orElseThrow();
+
+        assertTrue(java.util.stream.StreamSupport.stream(
+            java.util.Spliterators.spliteratorUnknownSize(activate.instructions.iterator(), 0), false
+        ).anyMatch(instruction -> instruction instanceof InvokeDynamicInsnNode dynamic
+            && dynamic.desc.endsWith("Ljava/util/function/Predicate;")));
+
+        final MethodNode filter = owner.methods.stream()
+            .filter(method -> method.name.startsWith("lambda$activateEntities"))
+            .filter(method -> java.util.stream.StreamSupport.stream(
+                java.util.Spliterators.spliteratorUnknownSize(method.instructions.iterator(), 0), false
+            ).anyMatch(instruction -> instruction instanceof FieldInsnNode field
+                && field.getOpcode() == Opcodes.GETFIELD && field.name.equals("activatedTick")))
+            .findFirst()
+            .orElseThrow();
+        assertFalse(filter.instructions.size() == 0);
+    }
+}
