+package io.papermc.paper;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import net.kyori.adventure.key.Key;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/** Verifies that LeavesX branding does not break Paper or Leaves compatibility checks. */
+@Normal
+public final class ServerBuildInfoCompatibilityTest {
+
+    private static final Key LEAVESX = Key.key("leavesx", "leavesx");
+
+    @Test
+    void acceptsPaperLeavesAndLeavesXBrandsWithoutClaimingFoliaCompatibility() {
+        assertTrue(ServerBuildInfoImpl.isCompatibleBrand(LEAVESX, ServerBuildInfo.BRAND_PAPER_ID));
+        assertTrue(ServerBuildInfoImpl.isCompatibleBrand(LEAVESX, Key.key("leavesmc", "leaves")));
+        assertTrue(ServerBuildInfoImpl.isCompatibleBrand(LEAVESX, LEAVESX));
+        assertFalse(ServerBuildInfoImpl.isCompatibleBrand(LEAVESX, Key.key("papermc", "folia")));
+    }
+}
