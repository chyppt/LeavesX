new file mode 100644
index 0000000000000000000000000000000000000000..6efe5da662299e84981a519963651b701c924aae
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/StartupAiBudgetTest.java
@@ -0,0 +1,57 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.HashSet;
+import java.util.Set;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+/** Regression coverage for bounded and fair startup AI scheduling. */
+@Normal
+class StartupAiBudgetTest {
+
+    @Test
+    void neverExceedsPerTickLimitAndRotatesAcrossEntityPositions() {
+        final StartupAiBudget budget = new StartupAiBudget();
+        final Set<Integer> admittedPositions = new HashSet<>();
+        final int entityCount = 4_096;
+        final int limit = 16;
+
+        budget.reset(limit);
+        for (long tick = 1; tick <= 40; tick++) {
+            int admittedThisTick = 0;
+            for (int entityIndex = 0; entityIndex < entityCount; entityIndex++) {
+                if (budget.allow(tick, limit)) {
+                    admittedThisTick++;
+                    admittedPositions.add(entityIndex);
+                }
+            }
+            assertEquals(limit, admittedThisTick, "tick " + tick);
+        }
+
+        assertTrue(admittedPositions.size() >= 600, "startup slots should not stay on the first entities");
+    }
+
+    @Test
+    void adaptsAfterEntityCountDrops() {
+        final StartupAiBudget budget = new StartupAiBudget();
+        budget.reset(16);
+
+        for (int entityIndex = 0; entityIndex < 4_096; entityIndex++) {
+            budget.allow(1, 16);
+        }
+        for (int entityIndex = 0; entityIndex < 10; entityIndex++) {
+            budget.allow(2, 16);
+        }
+
+        int admitted = 0;
+        for (int entityIndex = 0; entityIndex < 10; entityIndex++) {
+            if (budget.allow(3, 16)) {
+                admitted++;
+            }
+        }
+        assertEquals(10, admitted);
+    }
+}
