+    private static ItemStack actionItem(
+        final Material material,
+        final String name,
+        final String description,
+        final Overview overview
+    ) {
+        // Inventory lore is rendered by the client as the item tooltip. Keep the current snapshot here so operators
+        // can inspect the important values by hovering, without running a command or mutating server state.
+        return item(
+            material,
+            name,
+            NamedTextColor.AQUA,
+            List.of(
+                description,
+                "TPS " + oneDecimal(overview.tps()) + " / MSPT " + oneDecimal(overview.mspt()),
