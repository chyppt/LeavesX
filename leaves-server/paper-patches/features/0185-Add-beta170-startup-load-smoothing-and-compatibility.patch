diff --git a/src/main/java/org/leavesx/leavesx/config/StartupAiBudget.java b/src/main/java/org/leavesx/leavesx/config/StartupAiBudget.java
new file mode 100644
index 0000000000000000000000000000000000000000..f3e04a3edbd47bc2e638ea6c6ab0e89e8817b9e3
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/StartupAiBudget.java
@@ -0,0 +1,66 @@
+package org.leavesx.leavesx.config;
+
+/**
+ * Bounded, rotating budget for expensive mob AI during the first server ticks.
+ *
+ * <p>The entity tick list has a stable traversal order. A simple counter would therefore always admit the same first
+ * mobs. This budget estimates the traversal size from the previous tick and rotates the admitted residue class, so
+ * work is spread across both ticks and entity positions while retaining a strict per-tick upper bound.</p>
+ */
+final class StartupAiBudget {
+
+    private long tick = Long.MIN_VALUE;
+    private int calls;
+    private int accepted;
+    private int estimatedCalls = 64;
+    private int stride = 4;
+    private int offset;
+
+    /** Resets all startup-only state after bootstrap or configuration reload. */
+    synchronized void reset(final int limit) {
+        this.tick = Long.MIN_VALUE;
+        this.calls = 0;
+        this.accepted = 0;
+        this.estimatedCalls = Math.max(limit, limit * 4);
+        this.stride = strideFor(this.estimatedCalls, limit);
+        this.offset = 0;
+    }
+
+    /**
+     * Claims one full-AI slot for the current entity traversal position.
+     *
+     * @param currentTick current global server tick
+     * @param limit strict maximum number of admitted mobs in one tick
+     * @return whether the caller may execute its expensive AI phases
+     */
+    synchronized boolean allow(final long currentTick, final int limit) {
+        if (this.tick != currentTick) {
+            this.advanceTick(currentTick, limit);
+        }
+
+        final int callIndex = this.calls++;
+        if (this.accepted >= limit || Math.floorMod(callIndex - this.offset, this.stride) != 0) {
+            return false;
+        }
+        this.accepted++;
+        return true;
+    }
+
+    private void advanceTick(final long currentTick, final int limit) {
+        if (this.tick != Long.MIN_VALUE) {
+            this.estimatedCalls = Math.max(1, this.calls);
+            this.stride = strideFor(this.estimatedCalls, limit);
+            this.offset++;
+            if (this.offset >= this.stride) {
+                this.offset = 0;
+            }
+        }
+        this.tick = currentTick;
+        this.calls = 0;
+        this.accepted = 0;
+    }
+
+    private static int strideFor(final int estimatedCalls, final int limit) {
+        return Math.max(1, (estimatedCalls + limit - 1) / limit);
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/performance/DenseMonsterAiPolicy.java b/src/main/java/org/leavesx/leavesx/performance/DenseMonsterAiPolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..517deddecb433197eba80817e69c096c682c9710
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/performance/DenseMonsterAiPolicy.java
@@ -0,0 +1,26 @@
+package org.leavesx.leavesx.performance;
+
+/**
+ * Pure scheduling helpers for the optional dense-monster AI policy.
+ *
+ * <p>The policy only decides when the normal full goal-selection pass may run. It never changes a goal's state or
+ * removes an entity, which keeps the world mutation and Bukkit event paths on the server thread.</p>
+ */
+public final class DenseMonsterAiPolicy {
+
+    private DenseMonsterAiPolicy() {
+    }
+
+    /**
+     * Returns whether a full goal-selection pass is due for this entity on the current tick.
+     *
+     * <p>Mixing the entity id into the phase spreads scans across ticks instead of waking every dense-farm mob at
+     * once. Non-positive ids are handled with floor modulus so the result is deterministic for test entities too.</p>
+     */
+    public static boolean fullGoalSelectionDue(final long tick, final int entityId, final int intervalTicks) {
+        if (intervalTicks <= 1) {
+            return true;
+        }
+        return Math.floorMod(tick + entityId, intervalTicks) == 0;
+    }
+}
