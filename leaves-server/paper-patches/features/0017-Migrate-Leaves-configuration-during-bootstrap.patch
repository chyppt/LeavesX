diff --git a/src/main/java/org/leavesx/leavesx/config/migration/AtomicMigrationOutput.java b/src/main/java/org/leavesx/leavesx/config/migration/AtomicMigrationOutput.java
new file mode 100644
index 0000000000000000000000000000000000000000..be671837420f597cd45b8fd20012f9caeb4e0614
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/AtomicMigrationOutput.java
@@ -0,0 +1,55 @@
+package org.leavesx.leavesx.config.migration;
+
+import io.papermc.paper.configuration.ConfigurationLoaders;
+import io.papermc.paper.util.AtomicFiles;
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.loader.HeaderMode;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+final class AtomicMigrationOutput implements MigrationOutput {
+
+    static final AtomicMigrationOutput INSTANCE = new AtomicMigrationOutput();
+
+    private AtomicMigrationOutput() {
+    }
+
+    @Override
+    public void copyBackup(final Path source, final Path backup) throws IOException {
+        Files.copy(source, backup, StandardCopyOption.COPY_ATTRIBUTES);
+        try (FileChannel channel = FileChannel.open(backup, StandardOpenOption.WRITE)) {
+            channel.force(true);
+        } catch (final IOException ex) {
+            Files.deleteIfExists(backup);
+            throw ex;
+        }
+    }
+
+    @Override
+    public void saveYaml(
+        final Path target,
+        final ConfigurationNode node,
+        final boolean includeHeader
+    ) throws IOException {
+        AtomicFiles.atomicWrite(target, temporary -> {
+            final YamlConfigurationLoader loader = ConfigurationLoaders.naturallySorted()
+                .headerMode(includeHeader ? HeaderMode.PRESET : HeaderMode.NONE)
+                .path(temporary)
+                .build();
+            loader.save(node);
+            try (FileChannel channel = FileChannel.open(temporary, StandardOpenOption.WRITE)) {
+                channel.force(true);
+            }
+        });
+    }
+
+    @Override
+    public void deleteIfExists(final Path path) throws IOException {
+        Files.deleteIfExists(path);
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationBootstrap.java b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationBootstrap.java
new file mode 100644
index 0000000000000000000000000000000000000000..77d16f6dfa4850b18275ffa2a36ae852880ca8b0
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationBootstrap.java
@@ -0,0 +1,36 @@
+package org.leavesx.leavesx.config.migration;
+
+import java.io.File;
+import java.nio.file.Path;
+import joptsimple.OptionSet;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Runs configuration migration before Minecraft initializes worlds or plugins.
+ */
+public final class LeavesConfigMigrationBootstrap {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesConfigMigrationBootstrap.class);
+
+    private LeavesConfigMigrationBootstrap() {
+    }
+
+    public static void migrate(final OptionSet options) {
+        final Path source = ((File) options.valueOf("leaves-settings")).toPath();
+        final Path target = ((File) options.valueOf("leavesx-settings")).toPath();
+        final LeavesConfigMigrationResult result = new LeavesConfigMigrator().migrate(source, target);
+
+        switch (result.status()) {
+            case NO_SOURCE -> LOGGER.info("No Leaves configuration found at {}; migration is not required", result.source());
+            case ALREADY_MIGRATED -> LOGGER.info("Leaves configuration migration is already current at {}", result.target());
+            case MIGRATED -> {
+                LOGGER.info(
+                    "Migrated Leaves configuration version {} to {} (backup: {}, report: {})",
+                    result.sourceConfigVersion(), result.target(), result.backup(), result.report()
+                );
+                result.warnings().forEach(warning -> LOGGER.warn("Leaves config migration: {}", warning));
+            }
+        }
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationException.java b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationException.java
