+package org.leavesx.leavesx.config.migration;
+
+/**
+ * Stops server bootstrap when a Leaves configuration cannot be migrated without risking data loss.
+ */
+public final class LeavesConfigMigrationException extends RuntimeException {
+
+    public LeavesConfigMigrationException(final String message) {
+        super(message);
+    }
+
+    public LeavesConfigMigrationException(final String message, final Throwable cause) {
+        super(message, cause);
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationResult.java b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationResult.java
new file mode 100644
index 0000000000000000000000000000000000000000..5215f4bd10b0fdf4f07e3bf417b4f77b072ea61b
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrationResult.java
@@ -0,0 +1,24 @@
+package org.leavesx.leavesx.config.migration;
+
+import java.nio.file.Path;
+import java.util.List;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Immutable migration result used by startup logging and tests.
+ */
+public record LeavesConfigMigrationResult(
+    MigrationStatus status,
+    Path source,
+    Path target,
+    @Nullable Path backup,
+    @Nullable Path report,
+    int sourceConfigVersion,
+    int preservedTopLevelKeys,
+    List<String> warnings
+) {
+
+    public LeavesConfigMigrationResult {
+        warnings = List.copyOf(warnings);
+    }
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrator.java b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrator.java
new file mode 100644
index 0000000000000000000000000000000000000000..0b7c94c766113919ba4674430db478f4e460b57a
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/LeavesConfigMigrator.java
@@ -0,0 +1,272 @@
+package org.leavesx.leavesx.config.migration;
+
+import io.papermc.paper.configuration.ConfigurationLoaders;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+
+/**
+ * Imports a Leaves {@code leaves.yml} into LeavesX without modifying the source file.
+ *
+ * <p>The complete Leaves tree is retained, including unknown keys. Future Leaves feature ports can therefore consume
+ * their original {@code settings.*} paths. Output is published only after parsing, hashing and serialization succeed.</p>
+ */
+public final class LeavesConfigMigrator {
+
+    public static final int LEAVESX_CONFIG_VERSION = 1;
+    public static final int LEAVES_26_1_2_CONFIG_VERSION = 6;
+    public static final String DEFAULT_SOURCE_FILE_NAME = "leaves.yml";
+    public static final String DEFAULT_TARGET_FILE_NAME = "leavesx.yml";
+    public static final String DEFAULT_REPORT_FILE_NAME = "leavesx-migration-report.yml";
+
+    private static final String MIGRATION_ID = "leaves-26.1.2-to-leavesx-26.1.2-v1";
+    private static final String CONFIG_HEADER = "LeavesX configuration. Leaves settings are preserved for compatibility.";
+    private static final DateTimeFormatter BACKUP_TIMESTAMP = DateTimeFormatter
+        .ofPattern("uuuuMMdd-HHmmss-SSS")
+        .withZone(ZoneOffset.UTC);
+
+    private final Clock clock;
+    private final MigrationOutput output;
+
+    public LeavesConfigMigrator() {
+        this(Clock.systemUTC(), AtomicMigrationOutput.INSTANCE);
+    }
+
+    LeavesConfigMigrator(final Clock clock, final MigrationOutput output) {
+        this.clock = Objects.requireNonNull(clock, "clock");
+        this.output = Objects.requireNonNull(output, "output");
+    }
+
+    /**
+     * Migrates {@code source} to {@code target}, preserving the source and producing a durable backup and report.
+     *
+     * @throws LeavesConfigMigrationException when the source is invalid or output cannot be safely published
+     */
+    public LeavesConfigMigrationResult migrate(final Path source, final Path target) {
+        final Path absoluteSource = source.toAbsolutePath().normalize();
+        final Path absoluteTarget = target.toAbsolutePath().normalize();
+        final Path report = absoluteTarget.resolveSibling(DEFAULT_REPORT_FILE_NAME);
+
+        if (Files.notExists(absoluteSource)) {
+            return new LeavesConfigMigrationResult(
+                MigrationStatus.NO_SOURCE, absoluteSource, absoluteTarget, null, null, 0, 0, List.of()
+            );
+        }
+        if (!Files.isRegularFile(absoluteSource)) {
+            throw new LeavesConfigMigrationException("Leaves configuration is not a regular file: " + absoluteSource);
+        }
+
+        try {
+            final String sourceHash = sha256(absoluteSource);
+            final ConfigurationNode sourceNode = loadRequiredMap(absoluteSource, "Leaves source configuration");
+            final int sourceVersion = sourceNode.node("config-version").getInt(0);
+
+            if (Files.exists(absoluteTarget)) {
+                final ConfigurationNode existingTarget = loadRequiredMap(absoluteTarget, "LeavesX target configuration");
+                if (isSameMigration(existingTarget, absoluteSource, sourceHash)) {
+                    return new LeavesConfigMigrationResult(
+                        MigrationStatus.ALREADY_MIGRATED,
+                        absoluteSource,
+                        absoluteTarget,
+                        null,
+                        Files.exists(report) ? report : null,
+                        sourceVersion,
+                        sourceNode.childrenMap().size(),
+                        List.of()
+                    );
+                }
+                throw new LeavesConfigMigrationException(
+                    "LeavesX target already exists and was not generated from the current Leaves configuration: " + absoluteTarget
+                );
+            }
+
+            final Instant migratedAt = this.clock.instant();
+            final Path backup = nextBackupPath(absoluteSource, migratedAt);
+            final List<String> warnings = buildWarnings(sourceVersion);
+            final CommentedConfigurationNode migratedNode = createMigratedNode(
+                sourceNode, absoluteSource, sourceHash, migratedAt, warnings
+            );
+            final CommentedConfigurationNode reportNode = createReportNode(
+                absoluteSource,
+                absoluteTarget,
+                backup,
+                sourceHash,
+                sourceVersion,
+                sourceNode.childrenMap(),
+                migratedAt,
+                warnings
+            );
+
+            final Path targetParent = absoluteTarget.getParent();
+            if (targetParent != null) {
+                Files.createDirectories(targetParent);
+            }
+            this.output.copyBackup(absoluteSource, backup);
+            try {
+                this.output.saveYaml(absoluteTarget, migratedNode, true);
+                this.output.saveYaml(report, reportNode, false);
+            } catch (final IOException ex) {
+                deleteCreatedOutput(report, ex);
+                deleteCreatedOutput(absoluteTarget, ex);
+                deleteCreatedOutput(backup, ex);
+                throw ex;
+            }
+
+            return new LeavesConfigMigrationResult(
+                MigrationStatus.MIGRATED,
+                absoluteSource,
+                absoluteTarget,
+                backup,
+                report,
+                sourceVersion,
+                sourceNode.childrenMap().size(),
+                warnings
+            );
+        } catch (final LeavesConfigMigrationException ex) {
+            throw ex;
+        } catch (final Exception ex) {
+            throw new LeavesConfigMigrationException("Failed to migrate Leaves configuration " + absoluteSource, ex);
+        }
+    }
+
+    private static ConfigurationNode loadRequiredMap(final Path path, final String description) throws ConfigurateException {
+        final ConfigurationNode node = ConfigurationLoaders.naturallySortedWithoutHeader(path).load();
+        if (node.virtual() || !node.isMap()) {
+            throw new LeavesConfigMigrationException(description + " must contain a YAML mapping: " + path);
+        }
+        return node;
+    }
+
+    private static boolean isSameMigration(final ConfigurationNode target, final Path source, final String sourceHash) {
+        return target.node("migration", "id").getString("").equals(MIGRATION_ID)
+            && target.node("migration", "source-sha256").getString("").equals(sourceHash)
+            && target.node("migration", "source-file").getString("").equals(source.toString())
+            && target.node("config-version").getInt(0) == LEAVESX_CONFIG_VERSION;
+    }
+
+    private static CommentedConfigurationNode createMigratedNode(
+        final ConfigurationNode sourceNode,
+        final Path source,
+        final String sourceHash,
+        final Instant migratedAt,
+        final List<String> warnings
+    ) {
+        final CommentedConfigurationNode target = CommentedConfigurationNode.root(
+            sourceNode.options().header(CONFIG_HEADER)
+        );
+        target.from(sourceNode);
+
+        final int sourceConfigVersion = sourceNode.node("config-version").getInt(0);
+        final ConfigurationNode migration = target.node("migration");
+        target.node("config-version").raw(LEAVESX_CONFIG_VERSION);
+        target.node("threading", "mode").raw("legacy-compatible");
+        migration.node("id").raw(MIGRATION_ID);
+        migration.node("source-type").raw("Leaves");
+        migration.node("source-file").raw(source.toString());
+        migration.node("source-config-version").raw(sourceConfigVersion);
+        migration.node("source-sha256").raw(sourceHash);
+        migration.node("migrated-at").raw(migratedAt.toString());
+        migration.node("warnings").raw(warnings);
+        return target;
+    }
+
+    private static CommentedConfigurationNode createReportNode(
+        final Path source,
+        final Path target,
+        final Path backup,
+        final String sourceHash,
+        final int sourceVersion,
+        final Map<Object, ? extends ConfigurationNode> topLevelKeys,
+        final Instant migratedAt,
+        final List<String> warnings
+    ) {
+        final CommentedConfigurationNode report = CommentedConfigurationNode.root();
+        report.node("report-version").raw(1);
+        report.node("status").raw("migrated");
+        report.node("migration-id").raw(MIGRATION_ID);
+        report.node("migrated-at").raw(migratedAt.toString());
+        report.node("source", "file").raw(source.toString());
+        report.node("source", "backup").raw(backup.toString());
+        report.node("source", "config-version").raw(sourceVersion);
+        report.node("source", "sha256").raw(sourceHash);
+        report.node("target", "file").raw(target.toString());
+        report.node("target", "config-version").raw(LEAVESX_CONFIG_VERSION);
+        report.node("preservation", "strategy").raw("copy-complete-tree");
+        report.node("preservation", "unknown-keys").raw("preserved");
+        report.node("preservation", "top-level-keys").raw(
+            topLevelKeys.keySet().stream().map(Object::toString).sorted().toList()
+        );
+        report.node("warnings").raw(warnings);
+        return report;
+    }
+
+    private static List<String> buildWarnings(final int sourceVersion) {
+        final List<String> warnings = new ArrayList<>();
+        if (sourceVersion == 0) {
+            warnings.add("The Leaves config has no config-version; all values were preserved without schema validation.");
+        } else if (sourceVersion > LEAVES_26_1_2_CONFIG_VERSION) {
+            warnings.add(
+                "The Leaves config version " + sourceVersion + " is newer than the tested 26.1.2 schema version "
+                    + LEAVES_26_1_2_CONFIG_VERSION + "; all values were preserved without destructive conversion."
+            );
+        } else if (sourceVersion < LEAVES_26_1_2_CONFIG_VERSION) {
+            warnings.add(
+                "The Leaves config version " + sourceVersion + " is older than the tested 26.1.2 schema version "
+                    + LEAVES_26_1_2_CONFIG_VERSION + "; legacy paths were preserved for feature-level migration."
+            );
+        }
+        warnings.add("Leaves feature settings are preserved but only become active as their LeavesX features are ported.");
+        return List.copyOf(warnings);
+    }
+
+    private static Path nextBackupPath(final Path source, final Instant migratedAt) {
+        final String timestamp = BACKUP_TIMESTAMP.format(migratedAt);
+        final String baseName = source.getFileName() + ".leavesx-backup-" + timestamp;
+        Path candidate = source.resolveSibling(baseName);
+        int suffix = 1;
+        while (Files.exists(candidate)) {
+            candidate = source.resolveSibling(baseName + "-" + suffix++);
+        }
+        return candidate;
+    }
+
+    private static String sha256(final Path source) throws IOException {
+        final MessageDigest digest;
+        try {
+            digest = MessageDigest.getInstance("SHA-256");
+        } catch (final NoSuchAlgorithmException ex) {
+            throw new IllegalStateException("The Java runtime does not provide SHA-256", ex);
+        }
+
+        try (var input = Files.newInputStream(source)) {
+            final byte[] buffer = new byte[16 * 1024];
+            int read;
+            while ((read = input.read(buffer)) >= 0) {
+                digest.update(buffer, 0, read);
+            }
+        }
+        return HexFormat.of().formatHex(digest.digest());
+    }
+
+    private void deleteCreatedOutput(final Path path, final Exception parent) {
+        try {
+            this.output.deleteIfExists(path);
+        } catch (final IOException cleanupFailure) {
+            parent.addSuppressed(cleanupFailure);
+        }
+    }
+}
