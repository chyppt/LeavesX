@@ -0,0 +1,17 @@
+package org.leavesx.leavesx.config.migration;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import org.spongepowered.configurate.ConfigurationNode;
+
+/**
+ * Filesystem boundary for migration output. Tests replace it to verify transactional rollback.
+ */
+interface MigrationOutput {
+
+    void copyBackup(Path source, Path backup) throws IOException;
+
+    void saveYaml(Path target, ConfigurationNode node, boolean includeHeader) throws IOException;
+
+    void deleteIfExists(Path path) throws IOException;
+}
diff --git a/src/main/java/org/leavesx/leavesx/config/migration/MigrationStatus.java b/src/main/java/org/leavesx/leavesx/config/migration/MigrationStatus.java
new file mode 100644
index 0000000000000000000000000000000000000000..d40f290b1aa7b96d7d090046f5536d4d91ef33b1
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/config/migration/MigrationStatus.java
@@ -0,0 +1,10 @@
+package org.leavesx.leavesx.config.migration;
+
+/**
+ * Describes the externally visible result of a Leaves-to-LeavesX configuration migration.
+ */
+public enum MigrationStatus {
+    NO_SOURCE,
+    MIGRATED,
+    ALREADY_MIGRATED
+}
