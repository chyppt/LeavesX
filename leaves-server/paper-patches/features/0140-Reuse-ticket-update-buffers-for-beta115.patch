diff --git a/src/test/java/org/leavesx/leavesx/performance/TicketUpdateBufferReuseTest.java b/src/test/java/org/leavesx/leavesx/performance/TicketUpdateBufferReuseTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2c9e2cc589091cf97947938c8b40f03985a6f2e0
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/TicketUpdateBufferReuseTest.java
@@ -0,0 +1,149 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.List;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+
+/** Verifies ticket propagation can reuse temporary lists without changing Paper's fallback path. */
+@Normal
+class TicketUpdateBufferReuseTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void processTicketUpdatesKeepsReusableAndFallbackPaths() throws IOException {
+        final ClassNode manager = classNode(ChunkHolderManager.class);
+        final MethodNode regionalUpdates = method(manager, "processTicketUpdates", "(II)Z");
+        final MethodNode globalUpdates = method(manager, "processTicketUpdates", "()Z");
+        final MethodNode acquireBuffers = method(
+            manager,
+            "leavesX$acquireTicketUpdateBuffers",
+            "()Lca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager$LeavesXTicketUpdateBuffers;"
+        );
+
+        assertTrue(calls(
+            acquireBuffers,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "ticketUpdateBufferReuseOptimization"
+        ));
+        assertTrue(calls(acquireBuffers, "java/lang/ThreadLocal", "get"));
+        assertReusableAndFallbackPath(manager, regionalUpdates);
+        assertReusableAndFallbackPath(manager, globalUpdates);
+    }
+
+    @Test
+    void reusableBuffersRejectReentryAndClearBeforeReuse() throws ReflectiveOperationException {
+        final Class<?> buffersType = Arrays.stream(ChunkHolderManager.class.getDeclaredClasses())
+            .filter(type -> type.getSimpleName().equals("LeavesXTicketUpdateBuffers"))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing LeavesX ticket update buffers"));
+        final var constructor = buffersType.getDeclaredConstructor();
+        final Method tryAcquire = buffersType.getDeclaredMethod("tryAcquire");
+        final Method release = buffersType.getDeclaredMethod("release");
+        final var scheduledTasksField = buffersType.getDeclaredField("scheduledTasks");
+        final var changedFullStatusField = buffersType.getDeclaredField("changedFullStatus");
+        constructor.setAccessible(true);
+        tryAcquire.setAccessible(true);
+        release.setAccessible(true);
+        scheduledTasksField.setAccessible(true);
+        changedFullStatusField.setAccessible(true);
+
+        final Object buffers = constructor.newInstance();
+        @SuppressWarnings("unchecked")
+        final List<Object> scheduledTasks = (List<Object>)scheduledTasksField.get(buffers);
+        @SuppressWarnings("unchecked")
+        final List<Object> changedFullStatus = (List<Object>)changedFullStatusField.get(buffers);
+
+        assertTrue((boolean)tryAcquire.invoke(buffers));
+        assertFalse((boolean)tryAcquire.invoke(buffers), "Same-thread reentry must use fresh Paper lists");
+        scheduledTasks.add(null);
+        changedFullStatus.add(null);
+        release.invoke(buffers);
+
+        assertTrue(scheduledTasks.isEmpty());
+        assertTrue(changedFullStatus.isEmpty());
+        assertTrue((boolean)tryAcquire.invoke(buffers), "Released buffers must be reusable");
+        release.invoke(buffers);
+    }
+
+    @Test
+    void version44ConfigurationMigratesTheDocumentedSwitchInPlace() throws Exception {
+        final Path path = this.temporaryDirectory.resolve("leavesx.yml");
+        Files.writeString(path, """
+            config-version: 44
+            performance:
+              chunk:
+                ticket-update-buffer-reuse: false
+            """);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        final Method runtimeSwitch = Class.forName("org.leavesx.leavesx.config.LeavesXRuntime")
+            .getMethod("ticketUpdateBufferReuseOptimization");
+        final Method publish = runtimeSwitch.getDeclaringClass().getDeclaredMethod("publish", LeavesXConfig.class);
+        publish.setAccessible(true);
+        publish.invoke(null, configuration);
+        try {
+            assertFalse((boolean)runtimeSwitch.invoke(null));
+        } finally {
+            publish.invoke(null, LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: 45"));
+        assertTrue(upgraded.contains("ticket-update-buffer-reuse: false"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private static ClassNode classNode(final Class<?> type) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(type.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String name, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(name) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + name + descriptor));
+    }
+
+    private static void assertReusableAndFallbackPath(final ClassNode owner, final MethodNode method) {
+        assertTrue(calls(method, owner.name, "leavesX$acquireTicketUpdateBuffers"));
+        assertTrue(calls(method, owner.name + "$LeavesXTicketUpdateBuffers", "release"));
+        assertTrue(allocates(method, "java/util/ArrayList"), "Paper fallback must retain fresh lists");
+    }
+
+    private static boolean calls(final MethodNode method, final String owner, final String name) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+
+    private static boolean allocates(final MethodNode method, final String type) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(TypeInsnNode.class::isInstance)
+            .map(TypeInsnNode.class::cast)
+            .anyMatch(instruction -> instruction.getOpcode() == Opcodes.NEW && instruction.desc.equals(type));
+    }
+}
