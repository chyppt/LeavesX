Date: Sun, 16 Aug 2026 19:09:44 +0800
Subject: [PATCH] Add detector rail query regression coverage for bate49


diff --git a/src/test/java/org/leavesx/leavesx/performance/DetectorRailEntityQueryHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/DetectorRailEntityQueryHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d7e6333efb3e29b05b15bc881b3a4bffd6fddbd2
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/DetectorRailEntityQueryHotPathTest.java
@@ -0,0 +1,85 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.world.level.block.DetectorRailBlock;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies detector rails stop entity searches after the first ordered minecart match. */
+@Normal
+class DetectorRailEntityQueryHotPathTest {
+
+    private static final String FIRST_MINECART_DESC =
+        "(Lnet/minecraft/world/level/Level;Lnet/minecraft/world/phys/AABB;Ljava/lang/Class;Ljava/util/function/Predicate;)Lnet/minecraft/world/entity/vehicle/minecart/AbstractMinecart;";
+
+    @Test
+    void firstMinecartHelperKeepsTheConfigurableFullQueryFallback() throws IOException {
+        final ClassNode detectorRail = classNode(DetectorRailBlock.class);
+        final MethodNode helper = method(detectorRail, "getFirstInteractingMinecartOfType", FIRST_MINECART_DESC);
+
+        assertTrue(hasInvocation(helper, "org/leavesx/leavesx/config/LeavesXRuntime", "entityQueryOptimizations"));
+        assertTrue(hasInvocation(helper, "net/minecraft/world/level/Level", "leavesX$getFirstEntityOfClass"));
+        assertTrue(hasInvocation(helper, "net/minecraft/world/level/Level", "getEntitiesOfClass"));
+        assertTrue(hasInvocation(helper, "java/util/List", "isEmpty"));
+        assertTrue(hasInvocation(helper, "java/util/List", "getFirst"));
+    }
+
+    @Test
+    void pressedCheckStillFiresTheBinaryRedstoneEvent() throws IOException {
+        final MethodNode checkPressed = method(classNode(DetectorRailBlock.class), "checkPressed");
+
+        assertTrue(invocations(checkPressed).stream().anyMatch(call -> call.name.equals("getFirstInteractingMinecartOfType")));
+        assertTrue(hasInvocation(checkPressed, "org/bukkit/craftbukkit/event/CraftEventFactory", "callBinaryRedstoneChange"));
+    }
+
+    @Test
+    void analogSignalReusesOneSearchBoxForBothOrderedLookups() throws IOException {
+        final MethodNode analogSignal = method(classNode(DetectorRailBlock.class), "getAnalogOutputSignal");
+        final List<MethodInsnNode> calls = invocations(analogSignal);
+
+        assertEquals(1L, calls.stream().filter(call -> call.name.equals("getSearchBB")).count());
+        assertEquals(2L, calls.stream().filter(call -> call.name.equals("getFirstInteractingMinecartOfType")).count());
+        assertTrue(calls.stream().noneMatch(call -> call.name.equals("getEntitiesOfClass")));
+    }
+
+    private static boolean hasInvocation(final MethodNode method, final String owner, final String name) {
+        return invocations(method).stream().anyMatch(call -> call.owner.equals(owner) && call.name.equals(name));
+    }
+
+    private static List<MethodInsnNode> invocations(final MethodNode method) {
+        return Arrays.stream(method.instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static ClassNode classNode(final Class<?> owner) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode;
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName));
+    }
+
+    private static MethodNode method(final ClassNode owner, final String methodName, final String descriptor) {
+        return owner.methods.stream()
+            .filter(method -> method.name.equals(methodName) && method.desc.equals(descriptor))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.name + '#' + methodName + descriptor));
+    }
+}
