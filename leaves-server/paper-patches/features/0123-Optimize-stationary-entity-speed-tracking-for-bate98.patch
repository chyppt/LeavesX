diff --git a/src/test/java/org/leavesx/leavesx/performance/EntitySpeedTrackingHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntitySpeedTrackingHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..b9e306b279f22b42aecbe51c3bac4e49c2dbda6d
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntitySpeedTrackingHotPathTest.java
@@ -0,0 +1,128 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+
+/** Verifies allocation-free stationary entity speed tracking without changing movement arithmetic. */
+@Normal
+class EntitySpeedTrackingHotPathTest {
+
+    @Test
+    void stationaryOptimizationReusesTheCanonicalZeroVector() throws ReflectiveOperationException {
+        final Vec3 position = new Vec3(12.25, -0.0, -48.5);
+
+        final Vec3 optimized = calculate(position, new Vec3(12.25, -0.0, -48.5), true);
+        final Vec3 fallback = calculate(position, new Vec3(12.25, -0.0, -48.5), false);
+
+        assertSame(Vec3.ZERO, optimized);
+        assertEquals(Vec3.ZERO, fallback);
+        assertNotSame(Vec3.ZERO, fallback);
+    }
+
+    @Test
+    void movingEntitiesKeepTheExactOriginalSubtraction() throws ReflectiveOperationException {
+        final List<Vec3> previousPositions = List.of(
+            Vec3.ZERO,
+            new Vec3(-30_000_000.0, -64.0, 30_000_000.0),
+            new Vec3(0.125, 255.875, -0.5)
+        );
+        final List<Vec3> currentPositions = List.of(
+            new Vec3(0.25, -0.5, 1.0),
+            new Vec3(-29_999_999.75, -63.5, 29_999_999.0),
+            new Vec3(-0.375, 256.0, 0.75)
+        );
+
+        for (int index = 0; index < previousPositions.size(); ++index) {
+            final Vec3 previous = previousPositions.get(index);
+            final Vec3 current = currentPositions.get(index);
+            final Vec3 expected = current.subtract(previous);
+            assertExactVector(expected, calculate(current, previous, true));
+            assertExactVector(expected, calculate(current, previous, false));
+        }
+    }
+
+    @Test
+    void computeSpeedReadsPositionOnceAndKeepsTheRuntimeFallback() throws IOException {
+        final List<Invocation> calls = invocations(Entity.class, "computeSpeed");
+
+        assertEquals(1L, calls.stream().filter(call -> call.owner().equals("net/minecraft/world/entity/Entity")
+            && call.name().equals("position")).count());
+        assertTrue(calls.stream().anyMatch(call -> call.owner().equals("org/leavesx/leavesx/config/LeavesXRuntime")
+            && call.name().equals("stationaryEntitySpeedOptimization")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner().equals("net/minecraft/world/entity/Entity")
+            && call.name().equals("leavesX$calculateKnownSpeed")));
+    }
+
+    private static Vec3 calculate(final Vec3 current, final Vec3 previous, final boolean optimized)
+        throws ReflectiveOperationException {
+        final Method method = Entity.class.getDeclaredMethod(
+            "leavesX$calculateKnownSpeed",
+            Vec3.class,
+            Vec3.class,
+            boolean.class
+        );
+        method.setAccessible(true);
+        return (Vec3)method.invoke(null, current, previous, optimized);
+    }
+
+    private static void assertExactVector(final Vec3 expected, final Vec3 actual) {
+        assertEquals(Double.doubleToLongBits(expected.x), Double.doubleToLongBits(actual.x));
+        assertEquals(Double.doubleToLongBits(expected.y), Double.doubleToLongBits(actual.y));
+        assertEquals(Double.doubleToLongBits(expected.z), Double.doubleToLongBits(actual.z));
+    }
+
+    private static List<Invocation> invocations(final Class<?> owner, final String methodName) throws IOException {
+        final List<Invocation> calls = new ArrayList<>();
+        final boolean[] found = {false};
+        new ClassReader(owner.getName()).accept(
+            new ClassVisitor(Opcodes.ASM9) {
+                @Override
+                public MethodVisitor visitMethod(
+                    final int access,
+                    final String name,
+                    final String descriptor,
+                    final String signature,
+                    final String[] exceptions
+                ) {
+                    if (!name.equals(methodName)) {
+                        return null;
+                    }
+                    found[0] = true;
+                    return new MethodVisitor(Opcodes.ASM9) {
+                        @Override
+                        public void visitMethodInsn(
+                            final int opcode,
+                            final String calledOwner,
+                            final String calledName,
+                            final String calledDescriptor,
+                            final boolean isInterface
+                        ) {
+                            calls.add(new Invocation(calledOwner, calledName));
+                        }
+                    };
+                }
+            },
+            ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES
+        );
+        assertTrue(found[0], () -> "Missing method " + owner.getName() + '#' + methodName);
+        return calls;
+    }
+
+    private record Invocation(String owner, String name) {
+    }
+}
