index 0000000000000000000000000000000000000000..a5b615c5c79a8e5abc22cbd0c1f1f92bfb7114bb
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXGcDiagnostics.java
@@ -0,0 +1,304 @@
+package org.leavesx.leavesx.diagnostics;
+
+import com.sun.management.GarbageCollectionNotificationInfo;
+import com.sun.management.GcInfo;
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryPoolMXBean;
+import java.lang.management.MemoryType;
+import java.lang.management.MemoryUsage;
+import java.util.ArrayDeque;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import javax.management.Notification;
+import javax.management.NotificationEmitter;
+import javax.management.openmbean.CompositeData;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Collects event-driven GC pauses without polling management beans from the tick loop. */
+public final class LeavesXGcDiagnostics {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXGcDiagnostics.class);
+    private static final int MAX_EVENTS = 256;
+    private static final List<GarbageCollectorMXBean> COLLECTORS = List.copyOf(ManagementFactory.getGarbageCollectorMXBeans());
+    private static final Set<String> HEAP_POOL_NAMES = heapPoolNames();
+    private static final long JVM_NANO_ORIGIN = System.nanoTime()
+        - TimeUnit.MILLISECONDS.toNanos(ManagementFactory.getRuntimeMXBean().getUptime());
+    private static final Recorder RECORDER = new Recorder(MAX_EVENTS);
+    private static final AtomicBoolean INITIALIZED = new AtomicBoolean();
+    private static volatile int registeredCollectors;
+
+    private LeavesXGcDiagnostics() {
+    }
+
+    /** Registers HotSpot GC notification listeners once during server bootstrap. */
+    public static void initialize() {
+        if (!INITIALIZED.compareAndSet(false, true)) {
+            return;
+        }
+
+        int registered = 0;
+        for (final GarbageCollectorMXBean collector : COLLECTORS) {
+            if (!(collector instanceof NotificationEmitter emitter)) {
+                continue;
+            }
+            try {
+                emitter.addNotificationListener(LeavesXGcDiagnostics::onNotification, null, null);
+                registered++;
+            } catch (final RuntimeException ex) {
+                LOGGER.warn("Unable to register LeavesX GC diagnostics for {}", collector.getName(), ex);
+            }
+        }
+        registeredCollectors = registered;
+        LOGGER.info("LeavesX GC diagnostics registered for {} of {} collectors", registered, COLLECTORS.size());
+    }
+
+    /** Returns lifetime collector counters plus activity inside the requested rolling window. */
+    public static Snapshot snapshot(final int windowSeconds) {
+        initialize();
+        long lifetimeCollections = 0L;
+        long lifetimePauseMillis = 0L;
+        for (final GarbageCollectorMXBean collector : COLLECTORS) {
+            lifetimeCollections += Math.max(0L, collector.getCollectionCount());
+            lifetimePauseMillis += Math.max(0L, collector.getCollectionTime());
+        }
+        return RECORDER.snapshot(
+            System.nanoTime(),
+            TimeUnit.SECONDS.toNanos(Math.max(1, windowSeconds)),
+            lifetimeCollections,
+            lifetimePauseMillis,
+            registeredCollectors,
+            COLLECTORS.size()
+        );
+    }
+
+    /** Returns the GC stop-the-world time overlapping a completed server tick. */
+    public static long pauseOverlapping(final long tickStartedNanos, final long tickEndedNanos) {
+        return RECORDER.pauseOverlapping(tickStartedNanos, tickEndedNanos);
+    }
+
+    private static void onNotification(final Notification notification, final Object ignored) {
+        if (!GarbageCollectionNotificationInfo.GARBAGE_COLLECTION_NOTIFICATION.equals(notification.getType())) {
+            return;
+        }
+        final Object userData = notification.getUserData();
+        if (!(userData instanceof CompositeData data)) {
+            return;
+        }
+
+        final GarbageCollectionNotificationInfo information = GarbageCollectionNotificationInfo.from(data);
+        final GcInfo gc = information.getGcInfo();
+        final long startedNanos = JVM_NANO_ORIGIN + TimeUnit.MILLISECONDS.toNanos(gc.getStartTime());
+        final long endedNanos = JVM_NANO_ORIGIN + TimeUnit.MILLISECONDS.toNanos(gc.getEndTime());
+        final long beforeUsed = heapUsed(gc.getMemoryUsageBeforeGc());
+        final long afterUsed = heapUsed(gc.getMemoryUsageAfterGc());
+        RECORDER.record(new RawPause(
+            System.nanoTime(),
+            startedNanos,
+            Math.max(startedNanos, endedNanos),
+            information.getGcName(),
+            information.getGcAction(),
+            information.getGcCause(),
+            beforeUsed,
+            afterUsed
+        ));
+    }
+
+    private static long heapUsed(final Map<String, MemoryUsage> pools) {
+        long used = 0L;
+        for (final Map.Entry<String, MemoryUsage> entry : pools.entrySet()) {
+            if (HEAP_POOL_NAMES.contains(entry.getKey())) {
+                used += Math.max(0L, entry.getValue().getUsed());
+            }
+        }
+        return used;
+    }
+
+    private static Set<String> heapPoolNames() {
+        final Set<String> names = new HashSet<>();
+        for (final MemoryPoolMXBean pool : ManagementFactory.getMemoryPoolMXBeans()) {
+            if (pool.getType() == MemoryType.HEAP) {
+                names.add(pool.getName());
+            }
+        }
+        return Set.copyOf(names);
+    }
+
+    static long estimateAllocatedBytes(final long previousAfterUsed, final long currentBeforeUsed) {
+        if (previousAfterUsed < 0L || currentBeforeUsed <= previousAfterUsed) {
+            return 0L;
+        }
+        return currentBeforeUsed - previousAfterUsed;
+    }
+
+    static boolean isStopTheWorldDuration(final String collector, final String action) {
+        final String description = (collector + ' ' + action).toLowerCase(Locale.ROOT);
+        return description.contains("pause") || (!description.contains("concurrent") && !description.contains("cycle"));
+    }
+
+    static final class Recorder {
+
+        private final int capacity;
+        private final ArrayDeque<GcPause> events;
+        private long previousAfterUsed = -1L;
+
+        Recorder(final int capacity) {
+            if (capacity < 1) {
+                throw new IllegalArgumentException("capacity must be positive");
+            }
+            this.capacity = capacity;
+            this.events = new ArrayDeque<>(capacity);
+        }
+
+        synchronized void record(final RawPause pause) {
+            final long durationNanos = Math.max(0L, pause.endedNanos() - pause.startedNanos());
+            final long reclaimedBytes = Math.max(0L, pause.beforeUsed() - pause.afterUsed());
+            final long allocatedBytes = estimateAllocatedBytes(this.previousAfterUsed, pause.beforeUsed());
+            this.previousAfterUsed = pause.afterUsed();
+            if (this.events.size() == this.capacity) {
+                this.events.removeFirst();
+            }
+            this.events.addLast(new GcPause(
+                pause.observedNanos(),
+                pause.startedNanos(),
+                pause.endedNanos(),
+                durationNanos,
+                pause.collector(),
+                pause.action(),
+                pause.cause(),
+                isStopTheWorldDuration(pause.collector(), pause.action()),
+                pause.beforeUsed(),
+                pause.afterUsed(),
+                reclaimedBytes,
+                allocatedBytes
+            ));
+        }
+
+        synchronized Snapshot snapshot(
+            final long nowNanos,
+            final long windowNanos,
+            final long lifetimeCollections,
+            final long lifetimePauseMillis,
+            final int registeredCollectorCount,
+            final int collectorCount
+        ) {
+            final long cutoff = nowNanos - windowNanos;
+            long pauseNanos = 0L;
+            long concurrentNanos = 0L;
+            long reclaimedBytes = 0L;
+            long estimatedAllocatedBytes = 0L;
+            long maximumPauseNanos = 0L;
+            int collections = 0;
+            int pauseCollections = 0;
+            GcPause lastEvent = null;
+            for (final GcPause event : this.events) {
+                if (event.observedNanos() < cutoff) {
+                    continue;
+                }
+                lastEvent = event;
+                collections++;
+                if (event.stopTheWorld()) {
+                    pauseCollections++;
+                    pauseNanos += event.durationNanos();
+                    maximumPauseNanos = Math.max(maximumPauseNanos, event.durationNanos());
+                } else {
+                    concurrentNanos += event.durationNanos();
+                }
+                reclaimedBytes += event.reclaimedBytes();
+                estimatedAllocatedBytes += event.estimatedAllocatedBytes();
+            }
+            return new Snapshot(
+                lifetimeCollections,
+                lifetimePauseMillis,
+                registeredCollectorCount,
+                collectorCount,
+                windowNanos,
+                collections,
+                pauseCollections,
+                pauseNanos,
+                maximumPauseNanos,
+                concurrentNanos,
+                reclaimedBytes,
+                estimatedAllocatedBytes,
+                lastEvent
+            );
+        }
+
+        synchronized long pauseOverlapping(final long startedNanos, final long endedNanos) {
+            if (endedNanos <= startedNanos) {
+                return 0L;
+            }
+            long overlap = 0L;
+            for (final var iterator = this.events.descendingIterator(); iterator.hasNext();) {
+                final GcPause event = iterator.next();
+                if (event.endedNanos() <= startedNanos) {
+                    break;
+                }
+                if (!event.stopTheWorld()) {
+                    continue;
+                }
+                final long overlapStart = Math.max(startedNanos, event.startedNanos());
+                final long overlapEnd = Math.min(endedNanos, event.endedNanos());
+                if (overlapEnd > overlapStart) {
+                    overlap += overlapEnd - overlapStart;
+                }
+            }
+            return overlap;
+        }
+    }
+
+    static record RawPause(
+        long observedNanos,
+        long startedNanos,
+        long endedNanos,
+        String collector,
+        String action,
+        String cause,
+        long beforeUsed,
+        long afterUsed
+    ) {
+    }
+
+    public record GcPause(
+        long observedNanos,
+        long startedNanos,
+        long endedNanos,
+        long durationNanos,
+        String collector,
+        String action,
+        String cause,
+        boolean stopTheWorld,
+        long beforeUsed,
+        long afterUsed,
+        long reclaimedBytes,
+        long estimatedAllocatedBytes
+    ) {
+    }
+
+    public record Snapshot(
+        long lifetimeCollections,
+        long lifetimePauseMillis,
+        int registeredCollectors,
+        int collectors,
+        long windowNanos,
+        int windowCollections,
+        int windowPauseCollections,
+        long windowPauseNanos,
+        long maximumPauseNanos,
+        long concurrentGcNanos,
+        long reclaimedBytes,
+        long estimatedAllocatedBytes,
+        GcPause lastPause
+    ) {
+
+        public boolean notificationsAvailable() {
+            return this.registeredCollectors > 0;
+        }
+    }
+}
