new file mode 100644
index 0000000000000000000000000000000000000000..98c09827b202dd93951cf3fc0a51603c657b5313
--- /dev/null
+++ b/src/main/java/org/leavesx/leavesx/diagnostics/LeavesXChunkDiagnostics.java
@@ -0,0 +1,195 @@
+package org.leavesx.leavesx.diagnostics;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.LongAdder;
+import net.minecraft.server.level.TicketType;
+
+/** Stores bounded per-world chunk lifecycle counters for operator diagnostics. */
+public final class LeavesXChunkDiagnostics {
+
+    private static final int MAX_SAMPLES = 301;
+
+    private LeavesXChunkDiagnostics() {
+    }
+
+    /** Per-world counters owned by one chunk holder manager. */
+    public static final class WorldMetrics {
+
+        private final String worldName;
+        private final LongAdder chunkLoads = new LongAdder();
+        private final LongAdder chunkUnloads = new LongAdder();
+        private final LongAdder ticketAdds = new LongAdder();
+        private final LongAdder ticketRemoves = new LongAdder();
+        private final ConcurrentHashMap<TicketType<?>, MutableTicketChurn> ticketChurn = new ConcurrentHashMap<>();
+        private final ArrayDeque<Sample> samples = new ArrayDeque<>(MAX_SAMPLES);
+
+        public WorldMetrics(final String worldName) {
+            this.worldName = worldName;
+        }
+
+        public String worldName() {
+            return this.worldName;
+        }
+
+        public void recordChunkLoad() {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.chunkLoads.increment();
+        }
+
+        public void recordChunkUnload() {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.chunkUnloads.increment();
+        }
+
+        public void recordTicketAdded(final TicketType<?> type) {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.ticketAdds.increment();
+            this.ticketChurn.computeIfAbsent(type, ignored -> new MutableTicketChurn()).adds.increment();
+        }
+
+        public void recordTicketRemoved(final TicketType<?> type) {
+            if (!org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()) {
+                return;
+            }
+            this.ticketRemoves.increment();
+            this.ticketChurn.computeIfAbsent(type, ignored -> new MutableTicketChurn()).removes.increment();
+        }
+
+        /** Captures one O(1) world sample; the tick loop calls this at most once per second. */
+        public synchronized void sample(
+            final long capturedNanos,
+            final int loadedChunks,
+            final int holders,
+            final long pendingUnloads
+        ) {
+            final Sample previous = this.samples.peekLast();
+            if (previous != null && capturedNanos <= previous.capturedNanos()) {
+                return;
+            }
+            if (this.samples.size() == MAX_SAMPLES) {
+                this.samples.removeFirst();
+            }
+            this.samples.addLast(new Sample(
+                capturedNanos,
+                loadedChunks,
+                holders,
+                pendingUnloads,
+                this.chunkLoads.sum(),
+                this.chunkUnloads.sum(),
+                this.ticketAdds.sum(),
+                this.ticketRemoves.sum()
+            ));
+        }
+
+        /** Returns deltas between the newest sample and the sample nearest the requested cutoff. */
+        public synchronized Activity activity(final int windowSeconds) {
+            final Sample latest = this.samples.peekLast();
+            if (latest == null) {
+                return Activity.empty(this.worldName);
+            }
+            final long cutoff = latest.capturedNanos() - TimeUnit.SECONDS.toNanos(Math.max(1, windowSeconds));
+            Sample baseline = this.samples.peekFirst();
+            for (final Sample sample : this.samples) {
+                if (sample.capturedNanos() > cutoff) {
+                    break;
+                }
+                baseline = sample;
+            }
+            final long elapsedNanos = Math.max(0L, latest.capturedNanos() - baseline.capturedNanos());
+            return new Activity(
+                this.worldName,
+                elapsedNanos,
+                latest.loadedChunks(),
+                latest.holders(),
+                latest.pendingUnloads(),
+                latest.loadedChunks() - baseline.loadedChunks(),
+                latest.holders() - baseline.holders(),
+                latest.pendingUnloads() - baseline.pendingUnloads(),
+                latest.chunkLoads() - baseline.chunkLoads(),
+                latest.chunkUnloads() - baseline.chunkUnloads(),
+                latest.ticketAdds() - baseline.ticketAdds(),
+                latest.ticketRemoves() - baseline.ticketRemoves()
+            );
+        }
+
+        /** Returns the busiest ticket types since this world was created. */
+        public List<TicketChurn> ticketChurn(final int requestedLimit) {
+            final List<TicketChurn> result = new ArrayList<>(this.ticketChurn.size());
+            for (final var entry : this.ticketChurn.entrySet()) {
+                final long adds = entry.getValue().adds.sum();
+                final long removes = entry.getValue().removes.sum();
+                result.add(new TicketChurn(entry.getKey(), adds, removes));
+            }
+            result.sort(Comparator.comparingLong(TicketChurn::operations).reversed());
+            return List.copyOf(result.subList(0, Math.min(Math.max(0, requestedLimit), result.size())));
+        }
+    }
+
+    private static final class MutableTicketChurn {
+
+        private final LongAdder adds = new LongAdder();
+        private final LongAdder removes = new LongAdder();
+    }
+
+    private record Sample(
+        long capturedNanos,
+        int loadedChunks,
+        int holders,
+        long pendingUnloads,
+        long chunkLoads,
+        long chunkUnloads,
+        long ticketAdds,
+        long ticketRemoves
+    ) {
+    }
+
+    public record Activity(
+        String worldName,
+        long elapsedNanos,
+        int loadedChunks,
+        int holders,
+        long pendingUnloads,
+        long loadedChunkDelta,
+        long holderDelta,
+        long pendingUnloadDelta,
+        long completedLoads,
+        long completedUnloads,
+        long ticketAdds,
+        long ticketRemoves
+    ) {
+
+        private static Activity empty(final String worldName) {
+            return new Activity(worldName, 0L, 0, 0, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L);
+        }
+
+        public double elapsedSeconds() {
+            return this.elapsedNanos / 1_000_000_000.0D;
+        }
+
+        public double loadsPerSecond() {
+            return this.elapsedNanos == 0L ? 0.0D : this.completedLoads * 1_000_000_000.0D / this.elapsedNanos;
+        }
+
+        public double unloadsPerSecond() {
+            return this.elapsedNanos == 0L ? 0.0D : this.completedUnloads * 1_000_000_000.0D / this.elapsedNanos;
+        }
+    }
+
+    public record TicketChurn(TicketType<?> type, long adds, long removes) {
+
+        public long operations() {
+            return this.adds + this.removes;
+        }
+    }
+}
