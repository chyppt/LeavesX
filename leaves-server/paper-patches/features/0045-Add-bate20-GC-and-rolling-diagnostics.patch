@@ -0,0 +1,39 @@
+package org.leavesx.leavesx.diagnostics;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class LeavesXPluginTaskDiagnosticsTest {
+
+    @Test
+    void aggregatesSlowTasksByPluginAndKeepsTheSlowestClass() {
+        final LeavesXPluginTaskDiagnostics.Recorder recorder = new LeavesXPluginTaskDiagnostics.Recorder(8);
+        recorder.record(new LeavesXPluginTaskDiagnostics.TaskRecord(10L, 1L, "A", 1, "Fast", 2L));
+        recorder.record(new LeavesXPluginTaskDiagnostics.TaskRecord(20L, 2L, "B", 2, "Other", 4L));
+        recorder.record(new LeavesXPluginTaskDiagnostics.TaskRecord(30L, 3L, "A", 3, "Slow", 8L));
+
+        final LeavesXPluginTaskDiagnostics.Snapshot snapshot = recorder.snapshot(40L, 40L, 10);
+
+        assertEquals(3, snapshot.retainedTasks());
+        assertEquals("A", snapshot.plugins().getFirst().plugin());
+        assertEquals(10L, snapshot.plugins().getFirst().totalNanos());
+        assertEquals("Slow", snapshot.plugins().getFirst().slowestTaskClass());
+        assertEquals(8L, snapshot.slowestTask().durationNanos());
+    }
+
+    @Test
+    void appliesWindowAndCapacityBounds() {
+        final LeavesXPluginTaskDiagnostics.Recorder recorder = new LeavesXPluginTaskDiagnostics.Recorder(2);
+        recorder.record(new LeavesXPluginTaskDiagnostics.TaskRecord(10L, 1L, "A", 1, "Old", 2L));
+        recorder.record(new LeavesXPluginTaskDiagnostics.TaskRecord(20L, 2L, "B", 2, "Middle", 3L));
+        recorder.record(new LeavesXPluginTaskDiagnostics.TaskRecord(30L, 3L, "C", 3, "New", 4L));
+
+        final LeavesXPluginTaskDiagnostics.Snapshot snapshot = recorder.snapshot(35L, 10L, 10);
+
+        assertEquals(1, snapshot.retainedTasks());
+        assertEquals("C", snapshot.plugins().getFirst().plugin());
+    }
+}
