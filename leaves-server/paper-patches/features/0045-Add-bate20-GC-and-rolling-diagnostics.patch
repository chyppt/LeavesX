@@ -0,0 +1,189 @@
+package org.leavesx.leavesx.diagnostics;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.bukkit.plugin.Plugin;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Retains only slow synchronous Bukkit tasks, preserving scheduler behavior and ordering. */
+public final class LeavesXPluginTaskDiagnostics {
+
+    private static final long DISABLED_MARKER = Long.MIN_VALUE;
+    private static final Logger LOGGER = LoggerFactory.getLogger(LeavesXPluginTaskDiagnostics.class);
+    private static final Recorder RECORDER = new Recorder(512);
+    private static final AtomicBoolean FAILURE_REPORTED = new AtomicBoolean();
+
+    private LeavesXPluginTaskDiagnostics() {
+    }
+
+    /** Starts a task timer when diagnostics are enabled. */
+    public static long beginTask() {
+        return org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsCommandEnabled()
+            ? System.nanoTime()
+            : DISABLED_MARKER;
+    }
+
+    /** Completes a task timer and retains it only when it crossed the configured threshold. */
+    public static void endTask(
+        final long startedNanos,
+        final Plugin plugin,
+        final int taskId,
+        final Class<?> taskClass,
+        final long serverTick
+    ) {
+        if (startedNanos == DISABLED_MARKER) {
+            return;
+        }
+        try {
+            final long observedNanos = System.nanoTime();
+            final long durationNanos = Math.max(0L, observedNanos - startedNanos);
+            if (durationNanos < org.leavesx.leavesx.config.LeavesXRuntime.diagnosticsSlowPluginTaskNanos()) {
+                return;
+            }
+            RECORDER.record(new TaskRecord(
+                observedNanos,
+                serverTick,
+                plugin == null ? "unknown" : plugin.getName(),
+                taskId,
+                taskClass == null ? "unknown" : taskClass.getName(),
+                durationNanos
+            ));
+        } catch (final RuntimeException ex) {
+            // Diagnostics must never change whether a Bukkit task succeeds or fails.
+            if (FAILURE_REPORTED.compareAndSet(false, true)) {
+                LOGGER.warn("LeavesX stopped recording one synchronous plugin task", ex);
+            }
+        }
+    }
+
+    /** Aggregates retained tasks over the configured rolling window. */
+    public static Snapshot snapshot(final int windowSeconds, final int limit) {
+        return RECORDER.snapshot(
+            System.nanoTime(),
+            TimeUnit.SECONDS.toNanos(Math.max(1, windowSeconds)),
+            Math.max(1, limit)
+        );
+    }
+
+    static final class Recorder {
+
+        private final int capacity;
+        private final ArrayDeque<TaskRecord> records;
+
+        Recorder(final int capacity) {
+            if (capacity < 1) {
+                throw new IllegalArgumentException("capacity must be positive");
+            }
+            this.capacity = capacity;
+            this.records = new ArrayDeque<>(capacity);
+        }
+
+        synchronized void record(final TaskRecord record) {
+            if (this.records.size() == this.capacity) {
+                this.records.removeFirst();
+            }
+            this.records.addLast(record);
+        }
+
+        synchronized Snapshot snapshot(final long nowNanos, final long windowNanos, final int limit) {
+            final long cutoff = nowNanos - windowNanos;
+            final Map<String, MutablePluginSummary> summaries = new HashMap<>();
+            TaskRecord slowest = null;
+            int retainedTasks = 0;
+            long retainedNanos = 0L;
+            for (final TaskRecord record : this.records) {
+                if (record.observedNanos() < cutoff) {
+                    continue;
+                }
+                retainedTasks++;
+                retainedNanos += record.durationNanos();
+                if (slowest == null || record.durationNanos() > slowest.durationNanos()) {
+                    slowest = record;
+                }
+                summaries.computeIfAbsent(record.plugin(), MutablePluginSummary::new).add(record);
+            }
+
+            final List<PluginSummary> ordered = new ArrayList<>(summaries.size());
+            for (final MutablePluginSummary summary : summaries.values()) {
+                ordered.add(summary.snapshot());
+            }
+            ordered.sort(Comparator.comparingLong(PluginSummary::totalNanos).reversed()
+                .thenComparing(Comparator.comparingLong(PluginSummary::maximumNanos).reversed())
+                .thenComparing(PluginSummary::plugin));
+            return new Snapshot(
+                windowNanos,
+                retainedTasks,
+                retainedNanos,
+                slowest,
+                List.copyOf(ordered.subList(0, Math.min(limit, ordered.size())))
+            );
+        }
+    }
+
+    private static final class MutablePluginSummary {
+
+        private final String plugin;
+        private int invocations;
+        private long totalNanos;
+        private long maximumNanos;
+        private String slowestTaskClass = "unknown";
+
+        private MutablePluginSummary(final String plugin) {
+            this.plugin = plugin;
+        }
+
+        private void add(final TaskRecord record) {
+            this.invocations++;
+            this.totalNanos += record.durationNanos();
+            if (record.durationNanos() > this.maximumNanos) {
+                this.maximumNanos = record.durationNanos();
+                this.slowestTaskClass = record.taskClass();
+            }
+        }
+
+        private PluginSummary snapshot() {
+            return new PluginSummary(
+                this.plugin,
+                this.invocations,
+                this.totalNanos,
+                this.maximumNanos,
+                this.slowestTaskClass
+            );
+        }
+    }
+
+    public record TaskRecord(
+        long observedNanos,
+        long serverTick,
+        String plugin,
+        int taskId,
+        String taskClass,
+        long durationNanos
+    ) {
+    }
+
+    public record PluginSummary(
+        String plugin,
+        int invocations,
+        long totalNanos,
+        long maximumNanos,
+        String slowestTaskClass
+    ) {
+    }
+
+    public record Snapshot(
+        long windowNanos,
+        int retainedTasks,
+        long retainedNanos,
+        TaskRecord slowestTask,
+        List<PluginSummary> plugins
+    ) {
+    }
+}
