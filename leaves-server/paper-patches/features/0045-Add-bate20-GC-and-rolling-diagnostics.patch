new file mode 100644
index 0000000000000000000000000000000000000000..d37ae44c4603a71903819d9674d38d5c16ce53dc
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/diagnostics/LeavesXGcDiagnosticsTest.java
@@ -0,0 +1,68 @@
+package org.leavesx.leavesx.diagnostics;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.concurrent.TimeUnit;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+@Normal
+class LeavesXGcDiagnosticsTest {
+
+    @Test
+    void estimatesAllocationOnlyFromPositiveHeapGrowth() {
+        assertEquals(300L, LeavesXGcDiagnostics.estimateAllocatedBytes(700L, 1_000L));
+        assertEquals(0L, LeavesXGcDiagnostics.estimateAllocatedBytes(1_000L, 700L));
+        assertEquals(0L, LeavesXGcDiagnostics.estimateAllocatedBytes(-1L, 700L));
+    }
+
+    @Test
+    void doesNotTreatConcurrentCollectorCyclesAsStopTheWorldPauses() {
+        assertFalse(LeavesXGcDiagnostics.isStopTheWorldDuration("ZGC Cycles", "end of GC cycle"));
+        assertTrue(LeavesXGcDiagnostics.isStopTheWorldDuration("ZGC Pauses", "end of GC pause"));
+        assertTrue(LeavesXGcDiagnostics.isStopTheWorldDuration("G1 Young Generation", "end of minor GC"));
+    }
+
+    @Test
+    void aggregatesWindowAndTickOverlapWithoutDoubleCounting() {
+        final LeavesXGcDiagnostics.Recorder recorder = new LeavesXGcDiagnostics.Recorder(4);
+        recorder.record(new LeavesXGcDiagnostics.RawPause(100L, 20L, 40L, "young", "end", "test", 1_000L, 600L));
+        recorder.record(new LeavesXGcDiagnostics.RawPause(200L, 80L, 110L, "young", "end", "test", 1_200L, 700L));
+
+        final LeavesXGcDiagnostics.Snapshot snapshot = recorder.snapshot(
+            250L,
+            200L,
+            10L,
+            50L,
+            1,
+            1
+        );
+
+        assertEquals(2, snapshot.windowCollections());
+        assertEquals(50L, snapshot.windowPauseNanos());
+        assertEquals(900L, snapshot.reclaimedBytes());
+        assertEquals(600L, snapshot.estimatedAllocatedBytes());
+        assertEquals(20L, recorder.pauseOverlapping(30L, 90L));
+        assertEquals(0L, recorder.pauseOverlapping(120L, 150L));
+    }
+
+    @Test
+    void evictsOldestPauseWhenCapacityIsReached() {
+        final LeavesXGcDiagnostics.Recorder recorder = new LeavesXGcDiagnostics.Recorder(1);
+        recorder.record(new LeavesXGcDiagnostics.RawPause(10L, 10L, 20L, "old", "end", "test", 10L, 5L));
+        recorder.record(new LeavesXGcDiagnostics.RawPause(30L, 30L, 50L, "old", "end", "test", 15L, 5L));
+
+        final LeavesXGcDiagnostics.Snapshot snapshot = recorder.snapshot(
+            60L,
+            TimeUnit.SECONDS.toNanos(1L),
+            2L,
+            30L,
+            1,
+            1
+        );
+        assertEquals(1, snapshot.windowCollections());
+        assertEquals(20L, snapshot.windowPauseNanos());
+    }
+}
diff --git a/src/test/java/org/leavesx/leavesx/diagnostics/LeavesXPluginTaskDiagnosticsTest.java b/src/test/java/org/leavesx/leavesx/diagnostics/LeavesXPluginTaskDiagnosticsTest.java
