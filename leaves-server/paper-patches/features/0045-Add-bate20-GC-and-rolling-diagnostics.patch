+    @Test
+    void calculatesChunkAndTicketDeltasAcrossRollingSamples() {
+        final LeavesXChunkDiagnostics.WorldMetrics metrics = new LeavesXChunkDiagnostics.WorldMetrics("test:world");
+        metrics.sample(0L, 100, 300, 20L);
+        for (int index = 0; index < 30; index++) {
+            metrics.recordChunkLoad();
+            metrics.recordTicketAdded(TicketType.UNKNOWN);
+        }
+        for (int index = 0; index < 10; index++) {
+            metrics.recordChunkUnload();
+            metrics.recordTicketRemoved(TicketType.UNKNOWN);
+        }
+        metrics.sample(TimeUnit.SECONDS.toNanos(10L), 120, 340, 5L);
+
+        final LeavesXChunkDiagnostics.Activity activity = metrics.activity(60);
+        assertEquals(20L, activity.loadedChunkDelta());
+        assertEquals(40L, activity.holderDelta());
+        assertEquals(-15L, activity.pendingUnloadDelta());
+        assertEquals(30L, activity.completedLoads());
+        assertEquals(10L, activity.completedUnloads());
+        assertEquals(3.0D, activity.loadsPerSecond());
+        assertEquals(1.0D, activity.unloadsPerSecond());
+        assertEquals(40L, metrics.ticketChurn(1).getFirst().operations());
+    }
+
+    @Test
+    void usesTheSampleNearestTheWindowCutoff() {
+        final LeavesXChunkDiagnostics.WorldMetrics metrics = new LeavesXChunkDiagnostics.WorldMetrics("test:world");
+        metrics.sample(0L, 100, 100, 0L);
+        metrics.recordChunkLoad();
+        metrics.sample(TimeUnit.SECONDS.toNanos(30L), 101, 101, 0L);
+        metrics.recordChunkLoad();
+        metrics.sample(TimeUnit.SECONDS.toNanos(90L), 102, 102, 0L);
+
+        final LeavesXChunkDiagnostics.Activity activity = metrics.activity(60);
+        assertEquals(1L, activity.completedLoads());
+        assertEquals(1L, activity.loadedChunkDelta());
+        assertEquals(60.0D, activity.elapsedSeconds());
+    }
+}
