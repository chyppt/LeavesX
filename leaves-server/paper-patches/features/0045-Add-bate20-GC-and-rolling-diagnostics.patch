+                    + activity.completedUnloads() + "（" + oneDecimal(activity.unloadsPerSecond()) + "/秒）",
+                activity.loadsPerSecond() > activity.unloadsPerSecond() ? NamedTextColor.YELLOW : NamedTextColor.AQUA
+            ));
+            sender.sendMessage(Component.text(
+                "   当前区块 " + activity.loadedChunks() + " / 持有器 " + activity.holders() + " / 待卸载 "
+                    + activity.pendingUnloads() + "；窗口变化 " + signed(activity.loadedChunkDelta()) + " / "
+                    + signed(activity.holderDelta()) + " / " + signed(activity.pendingUnloadDelta()),
+                NamedTextColor.GRAY
+            ));
+            sender.sendMessage(Component.text(
+                "   票据操作 +" + activity.ticketAdds() + " / -" + activity.ticketRemoves(),
+                activity.ticketAdds() > activity.ticketRemoves() ? NamedTextColor.YELLOW : NamedTextColor.GRAY
+            ));
         }
     }
 
