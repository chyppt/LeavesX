+    private static String formatPhases(final List<LeavesXTickDiagnostics.PhaseDuration> phases, final int limit) {
+        final StringBuilder builder = new StringBuilder();
+        for (int index = 0; index < Math.min(limit, phases.size()); index++) {
+            if (index > 0) {
+                builder.append(" / ");
+            }
+            final LeavesXTickDiagnostics.PhaseDuration phase = phases.get(index);
+            builder.append(phase.phase().displayName())
+                .append(' ')
+                .append(oneDecimal(phase.durationNanos() / 1_000_000.0D))
+                .append(" ms");
+        }
+        return builder.toString();
+    }
+
+    private static String simpleClassName(final String className) {
+        final int separator = Math.max(className.lastIndexOf('.'), className.lastIndexOf('$'));
+        return separator < 0 || separator + 1 >= className.length() ? className : className.substring(separator + 1);
+    }
+
+    private static String signed(final long value) {
+        return value > 0L ? "+" + value : Long.toString(value);
+    }
