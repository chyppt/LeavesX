diff --git a/src/test/java/org/leavesx/leavesx/performance/UniversalAngerAlertHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/UniversalAngerAlertHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c744ba4d688695b9c5f7238eef59822948410ac6
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/UniversalAngerAlertHotPathTest.java
@@ -0,0 +1,89 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.inOrder;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.goal.target.ResetUniversalAngerTargetGoal;
+import net.minecraft.world.entity.monster.zombie.ZombifiedPiglin;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.mockito.InOrder;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies universal-anger notification preserves list order and excludes the source mob. */
+@Normal
+class UniversalAngerAlertHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void optimizedAlertVisitsOtherMobsInOriginalOrder() throws ReflectiveOperationException {
+        final ZombifiedPiglin source = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin first = mock(ZombifiedPiglin.class);
+        final ZombifiedPiglin second = mock(ZombifiedPiglin.class);
+
+        final Method method = ResetUniversalAngerTargetGoal.class.getDeclaredMethod(
+            "leavesX$alertNearbyMobs",
+            Mob.class,
+            List.class
+        );
+        method.setAccessible(true);
+        method.invoke(null, source, List.of(first, source, second));
+
+        final InOrder order = inOrder(first, second);
+        order.verify(first).forgetCurrentTargetAndRefreshUniversalAnger();
+        order.verify(second).forgetCurrentTargetAndRefreshUniversalAnger();
+        verify(source, never()).forgetCurrentTargetAndRefreshUniversalAnger();
+    }
+
+    @Test
+    void version52ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-52.yml");
+        Files.writeString(path, """
+            config-version: 52
+            performance:
+              ai:
+                universal-anger-alerts: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.universalAngerAlertOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("universal-anger-alerts: false"));
+        assertTrue(upgraded.contains("# 群体仇恨刷新直接遍历附近生物，关闭后使用原版流。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+}
