@@ -0,0 +1,41 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+/** Locks timing-sensitive TNT, piston and villager paths to their Paper implementations. */
+@Normal
+class TechnicalMechanicsCompatibilityTest {
+
+    @AfterEach
+    void restoreDefaults() {
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+    }
+
+    @Test
+    void enabledConfigurationCannotReenableSensitiveOptimizations() {
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+
+        assertTrue(LeavesXRuntime.strictTechnicalMechanicsCompatibility());
+        assertFalse(LeavesXRuntime.parallelEntityActivation());
+        assertFalse(LeavesXRuntime.entityActivationQueryBufferReuseOptimization());
+        assertFalse(LeavesXRuntime.pressurePlateEntityScansOptimization());
+        assertFalse(LeavesXRuntime.tripWireEntityScansOptimization());
+        assertFalse(LeavesXRuntime.detectorRailEntityQueriesOptimization());
+        assertFalse(LeavesXRuntime.blockEntityTickerRemovalOptimization());
+        assertFalse(LeavesXRuntime.blockEntityTypeValidationOptimization());
+        assertFalse(LeavesXRuntime.minecartMotionDistanceOptimization());
+        assertFalse(LeavesXRuntime.goalSelectorOptimization());
+        assertFalse(LeavesXRuntime.brainBehaviorSchedulingOptimization());
+        assertFalse(LeavesXRuntime.sensingCacheOptimization());
+        assertFalse(LeavesXRuntime.villagerHostileSensorOptimization());
+        assertFalse(LeavesXRuntime.villagerGolemAgreementOptimization());
+        assertFalse(LeavesXRuntime.targetingRangeChecksOptimization());
+        assertFalse(LeavesXRuntime.nearestEntityDistanceSortOptimization());
+        assertFalse(LeavesXRuntime.visibleEntityTargetCacheOptimization());
+    }
+}
