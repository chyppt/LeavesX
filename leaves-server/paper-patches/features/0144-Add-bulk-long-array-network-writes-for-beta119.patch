diff --git a/src/test/java/org/leavesx/leavesx/performance/BulkLongArrayWriteHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/BulkLongArrayWriteHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f43ddbff8c06f40b66bd97d09e3eb69a5677253a
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/BulkLongArrayWriteHotPathTest.java
@@ -0,0 +1,226 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.spy;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.PooledByteBufAllocator;
+import io.netty.buffer.Unpooled;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.function.IntFunction;
+import net.minecraft.network.FriendlyByteBuf;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies bulk long-array writes preserve protocol bytes and all public fallback paths. */
+@Normal
+class BulkLongArrayWriteHotPathTest {
+
+    private static final long[] VALUES = createValues(37);
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void optimizedInstanceWritesMatchStaticProtocolEncoding() {
+        publish(LeavesXConfig.safeDefaults());
+        for (final BufferCase bufferCase : bufferCases()) {
+            assertArrayEquals(
+                encodeStatic(bufferCase.factory(), true),
+                encodeInstance(bufferCase.factory(), true),
+                bufferCase.name() + " length-prefixed bytes"
+            );
+            assertArrayEquals(
+                encodeStatic(bufferCase.factory(), false),
+                encodeInstance(bufferCase.factory(), false),
+                bufferCase.name() + " fixed-size bytes"
+            );
+        }
+    }
+
+    @Test
+    void runtimeSwitchAndStaticApiRetainElementWrites() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("leavesx.yml");
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              network:
+                bulk-long-array-writes: false
+            """, StandardCharsets.UTF_8);
+
+        try {
+            final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+            publish(configuration);
+            assertFalse(LeavesXRuntime.bulkLongArrayWritesOptimization());
+            final String upgraded = Files.readString(path);
+            assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+            assertTrue(upgraded.contains("bulk-long-array-writes: false"));
+            assertTrue(upgraded.contains("# 批量写入网络 long 数组，关闭后逐个写入。默认：true。"));
+            assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+            assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+            verifyElementWrites(true, VALUES.length);
+
+            publish(LeavesXConfig.safeDefaults());
+            verifyElementWrites(false, 0);
+            verifyStaticElementWrites();
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+    }
+
+    @Test
+    void insufficientMaximumCapacityPreservesPartialWriteState() {
+        publish(LeavesXConfig.safeDefaults());
+        assertPartialWriteMatches(false, 16);
+        assertPartialWriteMatches(true, 17);
+    }
+
+    private static byte[] encodeInstance(final IntFunction<ByteBuf> factory, final boolean lengthPrefixed) {
+        final FriendlyByteBuf output = new FriendlyByteBuf(factory.apply(VALUES.length * Long.BYTES + 8));
+        try {
+            output.writeByte(0x12);
+            if (lengthPrefixed) {
+                output.writeLongArray(VALUES);
+            } else {
+                output.writeFixedSizeLongArray(VALUES);
+            }
+            return bytes(output);
+        } finally {
+            output.release();
+        }
+    }
+
+    private static byte[] encodeStatic(final IntFunction<ByteBuf> factory, final boolean lengthPrefixed) {
+        final ByteBuf output = factory.apply(VALUES.length * Long.BYTES + 8);
+        try {
+            output.writeByte(0x12);
+            if (lengthPrefixed) {
+                FriendlyByteBuf.writeLongArray(output, VALUES);
+            } else {
+                FriendlyByteBuf.writeFixedSizeLongArray(output, VALUES);
+            }
+            return bytes(output);
+        } finally {
+            output.release();
+        }
+    }
+
+    private static void verifyElementWrites(final boolean expectWrites, final int expectedCount) {
+        final ByteBuf delegate = Unpooled.buffer(VALUES.length * Long.BYTES);
+        final ByteBuf source = spy(delegate);
+        final FriendlyByteBuf output = new FriendlyByteBuf(source);
+        try {
+            output.writeFixedSizeLongArray(VALUES);
+            if (expectWrites) {
+                verify(source, times(expectedCount)).writeLong(anyLong());
+            } else {
+                verify(source, never()).writeLong(anyLong());
+            }
+        } finally {
+            output.release();
+        }
+    }
+
+    private static void verifyStaticElementWrites() {
+        final ByteBuf source = spy(Unpooled.buffer(VALUES.length * Long.BYTES));
+        try {
+            FriendlyByteBuf.writeFixedSizeLongArray(source, VALUES);
+            verify(source, times(VALUES.length)).writeLong(anyLong());
+        } finally {
+            source.release();
+        }
+    }
+
+    private static void assertPartialWriteMatches(final boolean lengthPrefixed, final int capacity) {
+        final ByteBuf expected = Unpooled.buffer(capacity, capacity);
+        final FriendlyByteBuf optimized = new FriendlyByteBuf(Unpooled.buffer(capacity, capacity));
+        try {
+            assertThrows(IndexOutOfBoundsException.class, () -> write(expected, lengthPrefixed));
+            assertThrows(IndexOutOfBoundsException.class, () -> write(optimized, lengthPrefixed));
+            assertEquals(expected.writerIndex(), optimized.writerIndex());
+            assertArrayEquals(bytes(expected), bytes(optimized));
+        } finally {
+            expected.release();
+            optimized.release();
+        }
+    }
+
+    private static void write(final ByteBuf output, final boolean lengthPrefixed) {
+        if (lengthPrefixed) {
+            FriendlyByteBuf.writeLongArray(output, new long[] {1L, 2L, 3L});
+        } else {
+            FriendlyByteBuf.writeFixedSizeLongArray(output, new long[] {1L, 2L, 3L});
+        }
+    }
+
+    private static void write(final FriendlyByteBuf output, final boolean lengthPrefixed) {
+        if (lengthPrefixed) {
+            output.writeLongArray(new long[] {1L, 2L, 3L});
+        } else {
+            output.writeFixedSizeLongArray(new long[] {1L, 2L, 3L});
+        }
+    }
+
+    private static byte[] bytes(final ByteBuf output) {
+        final byte[] bytes = new byte[output.writerIndex()];
+        output.getBytes(0, bytes);
+        return bytes;
+    }
+
+    private static long[] createValues(final int length) {
+        final long[] values = new long[length];
+        long state = 0x9E3779B97F4A7C15L;
+        for (int index = 0; index < length; index++) {
+            state ^= state << 13;
+            state ^= state >>> 7;
+            state ^= state << 17;
+            values[index] = state;
+        }
+        return values;
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+
+    @SuppressWarnings("deprecation")
+    private static List<BufferCase> bufferCases() {
+        return List.of(
+            new BufferCase("heap", maximum -> Unpooled.buffer(1, maximum)),
+            new BufferCase("direct", maximum -> Unpooled.directBuffer(1, maximum)),
+            new BufferCase("pooled heap", maximum -> PooledByteBufAllocator.DEFAULT.heapBuffer(1, maximum)),
+            new BufferCase("pooled direct", maximum -> PooledByteBufAllocator.DEFAULT.directBuffer(1, maximum)),
+            new BufferCase(
+                "little-endian heap",
+                maximum -> Unpooled.buffer(1, maximum).order(ByteOrder.LITTLE_ENDIAN)
+            )
+        );
+    }
+
+    private record BufferCase(String name, IntFunction<ByteBuf> factory) {
+    }
+}
