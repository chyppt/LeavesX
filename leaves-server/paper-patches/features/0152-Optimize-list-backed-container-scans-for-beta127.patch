diff --git a/src/test/java/org/leavesx/leavesx/performance/ListBackedContainerScanHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/ListBackedContainerScanHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..24a7cf44f82775fc346a79e8e0d6645142ad4a36
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/ListBackedContainerScanHotPathTest.java
@@ -0,0 +1,100 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import net.minecraft.core.NonNullList;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.block.entity.ListBackedContainer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.leavesx.leavesx.config.LeavesXConfig;
+import org.leavesx.leavesx.config.LeavesXConfigLoader;
+import org.leavesx.leavesx.config.LeavesXRuntime;
+
+/** Verifies list-backed container scans preserve occupied-slot counts, short-circuiting, and configuration fallback. */
+@Normal
+class ListBackedContainerScanHotPathTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @Test
+    void directScansPreserveCountAndEmptySemantics() throws ReflectiveOperationException {
+        final ItemStack empty = mock(ItemStack.class);
+        final ItemStack occupied = mock(ItemStack.class);
+        when(empty.isEmpty()).thenReturn(true);
+        when(occupied.isEmpty()).thenReturn(false);
+
+        final NonNullList<ItemStack> items = NonNullList.create();
+        items.add(empty);
+        items.add(occupied);
+        items.add(empty);
+
+        assertEquals(1, invokeCount(items));
+        assertFalse(invokeIsEmpty(items));
+
+        final NonNullList<ItemStack> emptyItems = NonNullList.create();
+        emptyItems.add(empty);
+        emptyItems.add(empty);
+        assertEquals(0, invokeCount(emptyItems));
+        assertTrue(invokeIsEmpty(emptyItems));
+    }
+
+    @Test
+    void version55ConfigurationGainsTheDocumentedSwitchWithoutBackupFiles() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("version-55.yml");
+        Files.writeString(path, """
+            config-version: 55
+            performance:
+              block-entity:
+                list-backed-container-scans: false
+            """, StandardCharsets.UTF_8);
+
+        final LeavesXConfig configuration = LeavesXConfigLoader.load(path);
+        try {
+            publish(configuration);
+            assertFalse(LeavesXRuntime.listBackedContainerScansOptimization());
+        } finally {
+            publish(LeavesXConfig.safeDefaults());
+        }
+
+        final String upgraded = Files.readString(path);
+        assertTrue(upgraded.contains("config-version: " + LeavesXConfig.CURRENT_CONFIG_VERSION));
+        assertTrue(upgraded.contains("list-backed-container-scans: false"));
+        assertTrue(upgraded.contains("# 方块容器直接扫描物品槽位，关闭后使用原版流。默认：true。"));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx.yml.bak")));
+        assertFalse(Files.exists(this.temporaryDirectory.resolve("leavesx-migration-report.yml")));
+    }
+
+    private static int invokeCount(final NonNullList<ItemStack> items) throws ReflectiveOperationException {
+        final Method method = ListBackedContainer.class.getDeclaredMethod("leavesX$countItems", NonNullList.class);
+        method.setAccessible(true);
+        return (int)method.invoke(null, items);
+    }
+
+    private static boolean invokeIsEmpty(final NonNullList<ItemStack> items) throws ReflectiveOperationException {
+        final Method method = ListBackedContainer.class.getDeclaredMethod("leavesX$itemsAreEmpty", NonNullList.class);
+        method.setAccessible(true);
+        return (boolean)method.invoke(null, items);
+    }
+
+    private static void publish(final LeavesXConfig config) {
+        try {
+            final Method method = LeavesXRuntime.class.getDeclaredMethod("publish", LeavesXConfig.class);
+            method.setAccessible(true);
+            method.invoke(null, config);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError("Unable to publish LeavesX test configuration", exception);
+        }
+    }
+}
