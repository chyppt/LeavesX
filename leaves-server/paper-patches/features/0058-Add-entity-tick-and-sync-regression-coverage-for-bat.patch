From: LeavesX Build <build@leavesx.local>
Date: Sun, 16 Aug 2026 10:27:52 +0800
Subject: [PATCH] Add entity tick and sync regression coverage for bate33


diff --git a/src/test/java/org/leavesx/leavesx/performance/EntityTickAndSyncHotPathTest.java b/src/test/java/org/leavesx/leavesx/performance/EntityTickAndSyncHotPathTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..482e1e2febb4ddfb0508706b1a4cea5800bc955a
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/performance/EntityTickAndSyncHotPathTest.java
@@ -0,0 +1,184 @@
+package org.leavesx.leavesx.performance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.util.Arrays;
+import java.util.List;
+import net.minecraft.network.syncher.EntityDataAccessor;
+import net.minecraft.network.syncher.EntityDataSerializers;
+import net.minecraft.network.syncher.SyncedDataHolder;
+import net.minecraft.network.syncher.SynchedEntityData;
+import net.minecraft.world.entity.LivingEntity;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.JumpInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+/** Verifies allocation reductions in entity ticking and synchronized metadata packing. */
+@Normal
+class EntityTickAndSyncHotPathTest {
+
+    @Test
+    void packDirtyPreservesIdOrderAndClearsDirtyState() {
+        final TestDataHolder holder = new TestDataHolder();
+        final SynchedEntityData data = holder.createData();
+        data.markDirty(TestDataHolder.THIRD);
+        data.markDirty(TestDataHolder.FIRST);
+
+        final List<SynchedEntityData.DataValue<?>> packed = data.packDirty();
+
+        assertNotNull(packed);
+        assertEquals(
+            List.of(TestDataHolder.FIRST.id(), TestDataHolder.THIRD.id()),
+            packed.stream().map(SynchedEntityData.DataValue::id).toList()
+        );
+        assertFalse(data.isDirty());
+        assertFalse(data.getItem(TestDataHolder.FIRST).isDirty());
+        assertFalse(data.getItem(TestDataHolder.THIRD).isDirty());
+        assertNull(data.packDirty());
+    }
+
+    @Test
+    void dirtyCountTracksDistinctItemsAndResetsAfterPacking() throws ReflectiveOperationException {
+        final TestDataHolder holder = new TestDataHolder();
+        final SynchedEntityData data = holder.createData();
+        final Field dirtyCount = SynchedEntityData.class.getDeclaredField("dirtyCount");
+        dirtyCount.setAccessible(true);
+
+        data.markDirty(TestDataHolder.SECOND);
+        data.markDirty(TestDataHolder.SECOND);
+        data.set(TestDataHolder.THIRD, 30, true);
+
+        assertEquals(2, dirtyCount.getInt(data));
+        data.packDirty();
+        assertEquals(0, dirtyCount.getInt(data));
+    }
+
+    @Test
+    void packDirtyKeepsOptimizedAndVanillaAllocationPaths() throws IOException {
+        final List<MethodInsnNode> calls = methodCalls(SynchedEntityData.class, "packDirty");
+
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("org/leavesx/leavesx/config/LeavesXRuntime")
+            && call.name.equals("entityStateOptimizations")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("java/util/ArrayList")
+            && call.name.equals("<init>") && call.desc.equals("(I)V")));
+        assertTrue(calls.stream().anyMatch(call -> call.owner.equals("java/util/ArrayList")
+            && call.name.equals("<init>") && call.desc.equals("()V")));
+    }
+
+    @Test
+    void emptyEffectGuardStillReachesPendingBukkitEffectProcessing() throws IOException {
+        final AbstractInsnNode[] instructions = methodNode(LivingEntity.class, "tickEffects").instructions.toArray();
+        final int runtimeCheck = invocationIndex(
+            instructions,
+            "org/leavesx/leavesx/config/LeavesXRuntime",
+            "entityStateOptimizations"
+        );
+        final int emptyCheck = invocationIndex(instructions, "java/util/Map", "isEmpty");
+        final int iteratorCreation = invocationIndex(instructions, "java/util/Map", "keySet");
+        final int pendingEffects = fieldIndex(instructions, "net/minecraft/world/entity/LivingEntity", "effectsToProcess");
+        final JumpInsnNode emptyJump = nextJump(instructions, emptyCheck);
+        final int emptyTarget = instructionIndex(instructions, emptyJump.label);
+
+        assertTrue(runtimeCheck < emptyCheck);
+        assertTrue(emptyCheck < iteratorCreation);
+        assertTrue(iteratorCreation < pendingEffects);
+        assertTrue(emptyTarget > iteratorCreation, "Empty effects must skip the active-effect iterator");
+        assertTrue(emptyTarget <= pendingEffects, "Empty effects must still process queued Bukkit changes");
+    }
+
+    private static List<MethodInsnNode> methodCalls(final Class<?> owner, final String methodName) throws IOException {
+        return Arrays.stream(methodNode(owner, methodName).instructions.toArray())
+            .filter(MethodInsnNode.class::isInstance)
+            .map(MethodInsnNode.class::cast)
+            .toList();
+    }
+
+    private static MethodNode methodNode(final Class<?> owner, final String methodName) throws IOException {
+        final ClassNode classNode = new ClassNode(Opcodes.ASM9);
+        new ClassReader(owner.getName()).accept(classNode, ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return classNode.methods.stream()
+            .filter(method -> method.name.equals(methodName))
+            .findFirst()
+            .orElseThrow(() -> new AssertionError("Missing method " + owner.getName() + '#' + methodName));
+    }
+
+    private static int invocationIndex(final AbstractInsnNode[] instructions, final String owner, final String name) {
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] instanceof MethodInsnNode call && call.owner.equals(owner) && call.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing invocation " + owner + '#' + name);
+    }
+
+    private static int fieldIndex(final AbstractInsnNode[] instructions, final String owner, final String name) {
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] instanceof FieldInsnNode field && field.owner.equals(owner) && field.name.equals(name)) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing field access " + owner + '#' + name);
+    }
+
+    private static JumpInsnNode nextJump(final AbstractInsnNode[] instructions, final int startIndex) {
+        for (int index = startIndex + 1; index < instructions.length; index++) {
+            if (instructions[index] instanceof JumpInsnNode jump) {
+                return jump;
+            }
+        }
+        throw new AssertionError("Missing branch after instruction " + startIndex);
+    }
+
+    private static int instructionIndex(final AbstractInsnNode[] instructions, final AbstractInsnNode target) {
+        for (int index = 0; index < instructions.length; index++) {
+            if (instructions[index] == target) {
+                return index;
+            }
+        }
+        throw new AssertionError("Missing branch target");
+    }
+
+    private static final class TestDataHolder implements SyncedDataHolder {
+        private static final EntityDataAccessor<Integer> FIRST = SynchedEntityData.defineId(
+            TestDataHolder.class,
+            EntityDataSerializers.INT
+        );
+        private static final EntityDataAccessor<Integer> SECOND = SynchedEntityData.defineId(
+            TestDataHolder.class,
+            EntityDataSerializers.INT
+        );
+        private static final EntityDataAccessor<Integer> THIRD = SynchedEntityData.defineId(
+            TestDataHolder.class,
+            EntityDataSerializers.INT
+        );
+
+        private SynchedEntityData createData() {
+            return new SynchedEntityData.Builder(this)
+                .define(FIRST, 1)
+                .define(SECOND, 2)
+                .define(THIRD, 3)
+                .build();
+        }
+
+        @Override
+        public void onSyncedDataUpdated(final EntityDataAccessor<?> accessor) {
+        }
+
+        @Override
+        public void onSyncedDataUpdated(final List<SynchedEntityData.DataValue<?>> updatedItems) {
+        }
+    }
+}
