From 6c62ca18729a32364e09fdde198c55b58fc1e57b Mon Sep 17 00:00:00 2001
From: chyppt <pptwxo@163.com>
Date: Wed, 30 Sep 2026 00:30:16 +0800
Subject: [PATCH] Report detached chunk encoding failures

---
 .../leavesx/command/LeavesXCommand.java       | 20 ++++++++++++++++++-
 .../config/LeavesXConfigBootstrap.java        |  2 +-
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/main/java/org/leavesx/leavesx/command/LeavesXCommand.java b/src/main/java/org/leavesx/leavesx/command/LeavesXCommand.java
index f9ecd88e9d..c955af4c17 100644
--- a/src/main/java/org/leavesx/leavesx/command/LeavesXCommand.java
+++ b/src/main/java/org/leavesx/leavesx/command/LeavesXCommand.java
@@ -64,6 +64,7 @@ import org.leavesx.leavesx.diagnostics.LeavesXGcDiagnostics;
 import org.leavesx.leavesx.diagnostics.LeavesXPluginTaskDiagnostics;
 import org.leavesx.leavesx.diagnostics.LeavesXSystemDiagnostics;
 import org.leavesx.leavesx.diagnostics.LeavesXTickDiagnostics;
+import org.leavesx.leavesx.network.LeavesXNetworkMetrics;
 import org.leavesx.leavesx.runtime.LeavesXAsyncRuntime;
 import org.leavesx.leavesx.runtime.LeavesXComputeExecutor;
 
@@ -751,10 +752,13 @@ public final class LeavesXCommand extends Command {
                 }
             }
         }
+        final LeavesXNetworkMetrics.Snapshot chunkEncoding = LeavesXNetworkMetrics.snapshot();
         return List.of(
             "连接 " + connectionCount + " / 玩家 " + Bukkit.getOnlinePlayers().size(),
             "包/秒 收 " + oneDecimal(inboundPackets) + " / 发 " + oneDecimal(outboundPackets),
-            "发送待处理 " + pendingActions + " / 不可写 " + nonWritable
+            "发送待处理 " + pendingActions + " / 不可写 " + nonWritable,
+            "区块节累计 请求 " + chunkEncoding.submitted() + " / 发布 " + chunkEncoding.completed()
+                + " / 失败重算 " + chunkEncoding.fallback() + " / 永久失败 " + chunkEncoding.failed()
         );
     }
 
@@ -946,11 +950,25 @@ public final class LeavesXCommand extends Command {
         }
         final int playerCount = Bukkit.getOnlinePlayers().size();
         final int averagePing = playerCount == 0 ? 0 : totalPing / playerCount;
+        final LeavesXNetworkMetrics.Snapshot chunkEncoding = LeavesXNetworkMetrics.snapshot();
+        final LeavesXAsyncRuntime.Metrics chunkWorkers = LeavesXAsyncRuntime.metrics(LeavesXAsyncRuntime.Workload.CHUNK_SEND);
         sendHeader(sender, "网络状态");
         sender.sendMessage(line("连接", connectionCount + "（玩家 " + playerCount + "）", NamedTextColor.AQUA));
         sender.sendMessage(line("数据包/秒", "接收 " + oneDecimal(inboundPackets) + " / 发送 " + oneDecimal(outboundPackets), NamedTextColor.AQUA));
         sender.sendMessage(line("延迟", "平均 " + averagePing + " ms / 最大 " + maximumPing + " ms", maximumPing >= 200 ? NamedTextColor.RED : NamedTextColor.GREEN));
         sender.sendMessage(line("发送队列", pendingActions + " 待处理 / " + nonWritable + " 不可写连接", nonWritable == 0 ? NamedTextColor.GREEN : NamedTextColor.YELLOW));
+        sender.sendMessage(line(
+            "区块节编码",
+            "累计请求 " + chunkEncoding.submitted() + " / 编码发布 " + chunkEncoding.completed()
+                + " / 失败重算 " + chunkEncoding.fallback() + " / 永久失败 " + chunkEncoding.failed(),
+            chunkEncoding.failed() == 0L ? NamedTextColor.GREEN : NamedTextColor.RED
+        ));
+        sender.sendMessage(line(
+            "编码工作池",
+            chunkWorkers.activeThreads() + " 活跃 / " + chunkWorkers.queuedTasks() + " 排队 / "
+                + chunkWorkers.callerRuns() + " 同步回退 / " + chunkWorkers.rejectedTasks() + " 拒绝",
+            chunkWorkers.rejectedTasks() == 0L ? NamedTextColor.GREEN : NamedTextColor.YELLOW
+        ));
     }
 
     private static void sendPlugins(final CommandSender sender) {
diff --git a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java
index 14dfae74bb..a8c73723de 100644
--- a/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java
+++ b/src/main/java/org/leavesx/leavesx/config/LeavesXConfigBootstrap.java
@@ -59,7 +59,7 @@ public final class LeavesXConfigBootstrap {
             LOGGER.warn("LeavesX POI async serialization and non-loading villager job-site scans are disabled in this build to preserve POI data and vanilla villager behavior; the existing settings are retained for migration.");
         }
         if (config.asyncSettings().chunkSendEnabled()) {
-            LOGGER.warn("LeavesX async chunk send is disabled in this build because packet construction still reads live chunk, light and block-entity state; the setting is retained for migration.");
+            LOGGER.info("LeavesX async chunk send is enabled: workers encode detached sections; live chunk capture, light and block entities retain their original thread ownership. Packets use Paper's existing send queue.");
         }
         logConfiguration(config);
     }
