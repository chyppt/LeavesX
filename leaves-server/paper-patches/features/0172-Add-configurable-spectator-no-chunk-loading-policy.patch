diff --git a/src/test/java/org/leavesx/leavesx/chunk/SpectatorChunkLoadingPolicyTest.java b/src/test/java/org/leavesx/leavesx/chunk/SpectatorChunkLoadingPolicyTest.java
index c3544ad01aa72f7faaa9e6abb121d4582d754dde..526871b0a9c5c776160afec0915a8e70577c3baf 100644
--- a/src/test/java/org/leavesx/leavesx/chunk/SpectatorChunkLoadingPolicyTest.java
+++ b/src/test/java/org/leavesx/leavesx/chunk/SpectatorChunkLoadingPolicyTest.java
@@ -32,6 +32,18 @@ class SpectatorChunkLoadingPolicyTest {
         assertFalse(shouldObserveLoadedChunks(true, false, true));
     }
 
+    @Test
+    void optionalNoChunkLoadingPolicySuppressesTheReadOnlyObserverOnlyWhenEnabled() throws ReflectiveOperationException {
+        assertFalse(canPlayerLoadChunks(true, false, false, false));
+        assertTrue(shouldObserveLoadedChunks(true, false, false, false));
+        assertFalse(canPlayerLoadChunks(true, false, false, true));
+        assertFalse(shouldObserveLoadedChunks(true, false, false, true));
+        assertTrue(canPlayerLoadChunks(true, true, false, true));
+        assertFalse(shouldObserveLoadedChunks(true, true, false, true));
+        assertTrue(canPlayerLoadChunks(false, false, false, true));
+        assertFalse(shouldObserveLoadedChunks(false, false, false, true));
+    }
+
     @Test
     void loaderLifecycleReevaluatesThePolicy() throws IOException {
         final ClassNode loader = classNode(RegionizedPlayerChunkLoader.class);
@@ -100,6 +112,40 @@ class SpectatorChunkLoadingPolicyTest {
         return (boolean)policy.invoke(null, spectator, spectatorsGenerateChunks, explicitlySuppressChunkLoading);
     }
 
+    private static boolean canPlayerLoadChunks(
+        final boolean spectator,
+        final boolean spectatorsGenerateChunks,
+        final boolean explicitlySuppressChunkLoading,
+        final boolean spectatorNoChunkLoading
+    ) throws ReflectiveOperationException {
+        final Method policy = RegionizedPlayerChunkLoader.class.getDeclaredMethod(
+            "canPlayerLoadChunks",
+            boolean.class,
+            boolean.class,
+            boolean.class,
+            boolean.class
+        );
+        policy.setAccessible(true);
+        return (boolean)policy.invoke(null, spectator, spectatorsGenerateChunks, explicitlySuppressChunkLoading, spectatorNoChunkLoading);
+    }
+
+    private static boolean shouldObserveLoadedChunks(
+        final boolean spectator,
+        final boolean spectatorsGenerateChunks,
+        final boolean explicitlySuppressChunkLoading,
+        final boolean spectatorNoChunkLoading
+    ) throws ReflectiveOperationException {
+        final Method policy = RegionizedPlayerChunkLoader.class.getDeclaredMethod(
+            "shouldObserveLoadedChunks",
+            boolean.class,
+            boolean.class,
+            boolean.class,
+            boolean.class
+        );
+        policy.setAccessible(true);
+        return (boolean)policy.invoke(null, spectator, spectatorsGenerateChunks, explicitlySuppressChunkLoading, spectatorNoChunkLoading);
+    }
+
     private static boolean hasPolicyCall(final MethodNode method) {
         final String owner = RegionizedPlayerChunkLoader.class.getName().replace('.', '/');
         return Arrays.stream(method.instructions.toArray())
diff --git a/src/test/java/org/leavesx/leavesx/config/SpectatorNoChunkLoadingConfigTest.java b/src/test/java/org/leavesx/leavesx/config/SpectatorNoChunkLoadingConfigTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..4ac3b0ef13c454d9e6390e8b08bf8a024fdb365c
--- /dev/null
+++ b/src/test/java/org/leavesx/leavesx/config/SpectatorNoChunkLoadingConfigTest.java
@@ -0,0 +1,47 @@
+package org.leavesx.leavesx.config;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/** Verifies the spectator no-chunk-loading option is explicit and disabled by default. */
+@Normal
+class SpectatorNoChunkLoadingConfigTest {
+
+    @TempDir
+    Path temporaryDirectory;
+
+    @AfterEach
+    void restoreDefaults() {
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+    }
+
+    @Test
+    void safeDefaultsKeepPaperObserverSemantics() {
+        assertFalse(LeavesXConfig.safeDefaults().spectatorNoChunkLoading());
+        LeavesXRuntime.publish(LeavesXConfig.safeDefaults());
+        assertFalse(LeavesXRuntime.spectatorNoChunkLoading());
+    }
+
+    @Test
+    void optionCanBeEnabledWithoutChangingTheGamerule() throws IOException {
+        final Path path = this.temporaryDirectory.resolve("leavesx.yml");
+        Files.writeString(path, """
+            config-version: 1
+            performance:
+              spectator-no-chunk-loading: true
+            """);
+
+        final LeavesXConfig config = LeavesXConfigLoader.load(path);
+        assertTrue(config.spectatorNoChunkLoading());
+        LeavesXRuntime.publish(config);
+        assertTrue(LeavesXRuntime.spectatorNoChunkLoading());
+    }
+}
