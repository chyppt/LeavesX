+    @Test
+    void preservesIdentityWhenEveryDistanceKeyIsEqual() {
+        LeavesXComputeExecutor.configure(4, 64);
+        for (final double coordinate : new double[] {0.0, 1.0, Double.POSITIVE_INFINITY, Double.NaN}) {
+            final double[] x = new double[257];
+            Arrays.fill(x, coordinate);
+            final double[] zeros = new double[x.length];
+            final int[] expected = referenceOrder(x, zeros, zeros, 0.0, 0.0, 0.0);
+            assertArrayEquals(expected, StableDistanceSorter.sort(x, zeros, zeros, 0.0, 0.0, 0.0, false, 256));
+            assertArrayEquals(expected, StableDistanceSorter.sort(x, zeros, zeros, 0.0, 0.0, 0.0, true, 256));
+        }
+    }
+
+    @Test
+    void preservesStableOrderWithDifferentNumbersOfVaryingRadixDigits() {
+        LeavesXComputeExecutor.configure(4, 64);
+        final Random random = new Random(0x5261646978446967L);
+        final double[] scales = {0.0, 1.0, 1.0E-150, 1.0E150, 1.0E155};
+        for (final int size : new int[] {2, 63, 128, 257, 513, 2_049}) {
+            final double[] x = new double[size];
+            final double[] y = new double[size];
+            final double[] z = new double[size];
+            for (int round = 0; round < 8; round++) {
+                for (int index = 0; index < size; index++) {
+                    final double scale = scales[round % scales.length];
+                    x[index] = (random.nextInt(33) - 16 + (round < 5 ? 0.0 : random.nextDouble())) * scale;
+                    y[index] = (random.nextInt(9) - 4) * scale;
+                    z[index] = (random.nextInt(33) - 16) * scale;
+                }
+                final int[] expected = referenceOrder(x, y, z, 0.0, 0.0, 0.0);
+                assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 0.0, 0.0, 0.0, false, 256));
+                assertArrayEquals(expected, StableDistanceSorter.sort(x, y, z, 0.0, 0.0, 0.0, true, 256));
+            }
+        }
+    }
