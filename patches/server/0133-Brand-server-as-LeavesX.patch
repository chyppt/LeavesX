-    private static final String BRAND_PAPER_NAME = "Leaves"; // Leaves - Paper -> Leaves
+    private static final String BRAND_PAPER_NAME = "LeavesX"; // LeavesX - Paper -> Leaves
 
     private static final String BUILD_DEV = "DEV";
 
